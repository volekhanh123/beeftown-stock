# Bí mật của máy chủ đơn. may-chu.sh chép file này thành /etc/beeftown/may-chu-don.env (chỉ root và dịch vụ đọc được)
# và tự điền MAT_KHAU_QUAY, KHOA_SUC_KHOE ngẫu nhiên. Sửa trên máy chủ:   sudo nano /etc/beeftown/may-chu-don.env
# rồi chạy lại dịch vụ:   sudo systemctl restart may-chu-don
# File trên máy chủ KHÔNG BAO GIỜ chép vào repo hay gửi qua chat. Bảng đầy đủ: may-chu-don/README.md, "Biến môi trường".
#
# Không đặt ở đây: DIA_CHI_NGHE, TIN_PROXY, CONG, THU_MUC_DU_LIEU (cố định trong may-chu-don.service), KHONG_HTTPS
# (chỉ cho laptop thử bằng http).

# Mật khẩu màn hình quầy (ít nhất 8 ký tự). Đổi thì báo lại người đứng quầy.
MAT_KHAU_QUAY=

# Khóa cho đường /suc-khoe (đèn sức khỏe trong /noi-bo đọc bằng khóa này — đợt 4).
KHOA_SUC_KHOE=

# Tài khoản nhận chuyển khoản — đặt đủ cả bốn dòng, hoặc để trống cả bốn (chưa nhận trả trước).
# Bỏ dấu # đầu dòng khi đã có tài khoản VietinBank doanh nghiệp của Công ty TNHH SLK Group.
#NGAN_HANG_BIN=970415
#TEN_NGAN_HANG=VietinBank
#SO_TAI_KHOAN=
#TEN_TAI_KHOAN=CONG TY TNHH SLK GROUP

# Secret Key HMAC-SHA256 của webhook SePay (SePay → Webhooks → Bảo mật). Chỉ đặt khi đã có bốn dòng tài khoản.
#SEPAY_KHOA_KY=

# Chỉ để thử chuyển khoản thật số nhỏ khi bảng giá còn là giá thử. Bỏ đi trước khi mở bán.
#CHO_TRA_GIA_THU=1

# Tin ZNS báo khách (README, "Cài ZNS"): đặt đủ bốn dòng đầu, hoặc để trống cả bốn (chưa gửi tin Zalo).
# App Zalo RIÊNG cho máy chủ đơn (đừng dùng App của website — hai bên làm mới cùng một token sẽ làm chết của nhau).
#ZALO_APP_ID=
#ZALO_SECRET_KEY=""
#ZNS_MAU_DA_NHAN=
#ZNS_MAU_DANG_GIAO=
# "thu": chỉ quản trị viên của OA nhận (mặc định). Thử xong mới đổi thành "that".
#ZALO_CHE_DO=thu
# Refresh token Zalo mới: dán vào đây rồi chạy lại dịch vụ. Máy chủ dùng một lần, lưu mã hóa trong sổ đơn và tự làm
# mới từ đó; dòng này để nguyên cũng được (cùng token không bị dùng lại). Chỉ dán lại khi nhật ký báo token bị từ chối.
#ZALO_REFRESH_TOKEN_MOI=
