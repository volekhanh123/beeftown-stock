---
/**
 * CÔNG TẮC NỘI DUNG — màn hình quan trọng nhất của giao diện nội bộ
 *
 * Mỗi dữ kiện công khai là một ô. Bật là thêm vào trang, tắt là gỡ khỏi
 * trang, không cần deploy lại và không cần ai sửa code.
 *
 * HAI ĐIỀU CỐ Ý
 *
 * 1. Mỗi ô là một FORM RIÊNG. Không có nút "Lưu tất cả". Một nút lưu chung
 *    nghĩa là một lần mất sóng làm hỏng mười dữ kiện thay vì một, và nghĩa là
 *    người dùng phải nhớ mình vừa sửa những gì. Ở đây mỗi lần bấm là một việc
 *    trọn vẹn, và câu trả lời nói rõ việc nào vừa xảy ra.
 *
 * 2. Ô nào cũng hiện GIÁ TRỊ ĐANG SỐNG ngay bên trên, nguyên văn như khách
 *    đang đọc. Đây là thứ thay cho nút "Xem trước": với một dòng chữ thì
 *    chính dòng chữ đó là bản xem trước trung thực nhất.
 *
 * Không có JavaScript. Mọi thứ chạy bằng form POST — nên nó hoạt động trên
 * điện thoại cũ, mạng yếu, và cả khi trình duyệt chặn script.
 *
 * Lưu được thì chuyển hướng 303 về chính trang này (lib/gui-noi-bo.ts): F5 không
 * công bố lại lần nữa — mỗi lần công bố là một phiên bản mới trong lịch sử và một
 * lượt máy dịch.
 */
import NoiBo from '../../layouts/NoiBo.astro';
import {
  docBangCongTac, ghiCongTac, giaTriHienTai, motaGiaTri, NHOM,
  type HangCongTac,
} from '../../lib/cong-tac';
import { moTaO } from '../../lib/ban-dich';
import { dichNB, nnCua } from '../../lib/ngon-ngu-noi-bo';
import { dichCau, moTaKhoa } from '../../lib/cau-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, docBaoNoiBo, docFormNoiBo, type BaoNoiBo } from '../../lib/gui-noi-bo';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const nn = nnCua(Astro);
const t = dichNB(nn, {
  tieuDe:      { vi: 'Nội dung', en: 'Content' },
  h1:          { vi: 'Công tắc nội dung', en: 'Content switches' },
  dan1:        { vi: 'Mỗi ô là một dữ kiện trên trang công khai. Bấm ', en: 'Each card is one fact on the public site. Tap ' },
  congBo:      { vi: 'Công bố', en: 'Publish' },
  dan2:        { vi: ' là khách thấy ngay; bấm ', en: ' and guests see it straight away; tap ' },
  goKhoiTrang: { vi: 'Gỡ khỏi trang', en: 'Remove from site' },
  dan3:        { vi: ' là biến mất ngay. Không cần ai deploy lại.', en: ' and it disappears straight away. Nobody needs to redeploy.' },
  khongKhoa:   { vi: (k: string) => `Không có khóa tên "${k}".`, en: (k: string) => `There is no key named "${k}".` },
  khongDoc:    { vi: 'Không đọc được bảng công tắc.', en: 'Could not read the switch table.' },
  moTrang1:    { vi: 'Mở ', en: 'Open the ' },
  trangCK:     { vi: 'trang công khai', en: 'public site' },
  moTrang2:    { vi: ' để xem lại.', en: ' to check.' },
  vaiTro1:     { vi: 'Vai trò ', en: 'The role ' },
  vaiTro2:     { vi: ' soạn được bản nháp nhưng không tự công bố được. Bản nháp KHÔNG hiện trên trang; quản lý hoặc chủ nhà hàng sẽ là người bấm công bố.',
                 en: ' can write drafts but cannot publish. Drafts do NOT show on the site; a manager or the owner will press Publish.' },
  conThieu:    { vi: (n: number) => `Còn ${n} dữ kiện bắt buộc chưa công bố.`, en: (n: number) => `${n} required facts are not published yet.` },
  batBuoc:     { vi: 'Bắt buộc', en: 'Required' },
  chuNhaHang:  { vi: 'Chủ nhà hàng', en: 'Owner' },
  dangTrenTrang: { vi: 'Đang trên trang', en: 'Live on the site' },
  chuaCongBo:  { vi: 'Chưa công bố', en: 'Not published' },
  trong:       { vi: 'Chưa có gì trên trang — khách không thấy dòng nào cho mục này.', en: 'Nothing on the site yet — guests see no line for this item.' },
  chiChu:      { vi: 'Chỉ chủ nhà hàng đổi được dữ kiện này.', en: 'Only the owner can change this fact.' },
  trangThai:   { vi: 'Trạng thái', en: 'Status' },
  bat:         { vi: 'Bật — hiện trên trang', en: 'On — shown on the site' },
  tat:         { vi: 'Tắt — ẩn khỏi trang', en: 'Off — hidden from the site' },
  ngay:        { vi: 'Ngày', en: 'Date' },
  so:          { vi: 'Số', en: 'Number' },
  maAnh:       { vi: 'Mã ảnh trong bảng ', en: 'Photo ID in the ' },
  maAnh2:      { vi: '', en: ' table' },
  maAnhPhu:    { vi: 'Tải ảnh lên Supabase Storage trước, rồi dán mã dòng vào đây. Màn hình chọn ảnh chưa làm.',
                 en: 'Upload the photo to Supabase Storage first, then paste the row ID here. The photo picker is not built yet.' },
  duongDan:    { vi: 'Đường dẫn (bắt đầu bằng https://)', en: 'Link (starting with https://)' },
  sdt:         { vi: 'Số điện thoại', en: 'Phone number' },
  noiDungVi:   { vi: 'Nội dung tiếng Việt', en: 'Vietnamese text' },
  banEn:       { vi: 'Bản tiếng Anh', en: 'English version' },
  banKo:       { vi: 'Bản tiếng Hàn', en: 'Korean version' },
  dichPhu:     { vi: 'Để nguyên thì máy tự dịch khi câu tiếng Việt đổi. Sửa tay thì bản của bạn được giữ; xóa trắng là nhờ máy dịch lại.',
                 en: 'Leave it and the machine translates whenever the Vietnamese changes. Edit it and your version is kept; clear it to have the machine translate again.' },
  chuaDichKo:  { vi: 'Chưa có bản dịch — trang tiếng Hàn đang hiện bản tiếng Anh. Bấm Công bố để máy dịch.',
                 en: 'No translation yet — the Korean page shows the English version. Tap Publish to translate.' },
  chuaDichEn:  { vi: 'Chưa có bản dịch — trang tiếng Anh đang hiện bản tiếng Việt. Bấm Công bố để máy dịch.',
                 en: 'No translation yet — the English page shows the Vietnamese version. Tap Publish to translate.' },
  viSao:       { vi: 'Vì sao đổi', en: 'Why the change' },
  viSaoPhu:    { vi: 'Đọc lại sau sáu tháng vẫn phải hiểu. Có thể để trống.', en: 'Must still make sense six months from now. Can be left empty.' },
  luuNhap:     { vi: 'Lưu nháp', en: 'Save draft' },
});

let bao: BaoNoiBo | null = docBaoNoiBo(Astro.cookies, Astro.url.pathname);

if (Astro.request.method === 'POST') {
  const form = await docFormNoiBo(Astro.request);
  if (!form) {
    bao = { ok: false, cau: CAU_DOC_FORM_HONG[nn] };
  } else {
    const khoa = String(form.get('khoa') ?? '');
    try {
      const bang = await docBangCongTac(client);
      const hang = bang.find(h => h.khoa === khoa);
      bao = hang
        ? await ghiCongTac(client, hang, form, nn)
        : { ok: false, cau: t.khongKhoa(khoa) };
    } catch (e) {
      bao = { ok: false, cau: e instanceof Error ? dichCau(nn, e.message) : t.khongDoc };
    }
    if (bao.ok) return chuyenHuongNoiBo(Astro, bao);
  }
}

let bang: HangCongTac[] = [];
let loiDoc: string | null = null;
try {
  bang = await docBangCongTac(client);
} catch (e) {
  loiDoc = e instanceof Error ? dichCau(nn, e.message) : t.khongDoc;
}

// Nhóm theo cụm, giữ thứ tự sổ đăng ký.
const thuTuNhom = ['trang_thai', 'lien_he', 'lich', 'chia_se', 'khoi', 'mua_thit'];
const theoNhom = thuTuNhom
  .map(n => ({ ma: n, hang: bang.filter(h => h.nhom === n) }))
  .filter(g => g.hang.length > 0);
// Nhóm lạ (ai đó thêm khóa với nhom mới) vẫn phải hiện ra, không được rơi mất.
for (const h of bang) {
  if (!thuTuNhom.includes(h.nhom) && !theoNhom.some(g => g.ma === h.nhom)) {
    theoNhom.push({ ma: h.nhom, hang: bang.filter(x => x.nhom === h.nhom) });
  }
}

const conThieu = bang.filter(h => h.bat_buoc && !h.dang_song);
const duocCongBo = ['chu_so_huu', 'quan_ly'].includes(nhanSu.vai_tro);
---
<NoiBo tieuDe={t.tieuDe} nhanSu={nhanSu}>
  <h1>{t.h1}</h1>
  <p class="nb-dan">
    {t.dan1}<strong>{t.congBo}</strong>{t.dan2}<strong>{t.goKhoiTrang}</strong>{t.dan3}
  </p>

  {bao && (
    <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`}>
      <p>{bao.cau}</p>
      {bao.ok && <p>{t.moTrang1}<a href="/" target="_blank" rel="noopener">{t.trangCK}</a>{t.moTrang2}</p>}
    </div>
  )}

  {loiDoc && <div class="nb-bao loi"><p>{loiDoc}</p></div>}

  {!duocCongBo && (
    <div class="nb-bao luu-y">
      <p>{t.vaiTro1}<strong>{nhanSu.vai_tro}</strong>{t.vaiTro2}</p>
    </div>
  )}

  {conThieu.length > 0 && (
    <div class="nb-bao luu-y">
      <p><strong>{t.conThieu(conThieu.length)}</strong></p>
      <p>{conThieu.map(h => moTaKhoa(nn, h.khoa, h.mo_ta)).join(' · ')}</p>
    </div>
  )}

  {theoNhom.map(g => (
    <section>
      <h2>{NHOM[g.ma]?.ten[nn] ?? g.ma}</h2>
      {NHOM[g.ma]?.dan && <p class="nb-dan">{NHOM[g.ma].dan[nn]}</p>}

      {g.hang.map(h => {
        const hien = motaGiaTri(h, nn);
        const sanCo = giaTriHienTai(h);
        const khoaCua = h.chi_chu_so_huu && nhanSu.vai_tro !== 'chu_so_huu';
        return (
          <form method="POST" class="nb-the">
            <input type="hidden" name="khoa" value={h.khoa} />

            <div class="nb-cong-tac">
              <div class="nb-cong-tac-chu">
                <strong>
                  {moTaKhoa(nn, h.khoa, h.mo_ta)}
                  {h.bat_buoc && <span class="nb-nhan thong-tin" style="margin-left:.5rem">{t.batBuoc}</span>}
                  {h.chi_chu_so_huu && <span class="nb-nhan thong-tin" style="margin-left:.5rem">{t.chuNhaHang}</span>}
                </strong>
                <p><code>{h.khoa}</code></p>
              </div>
              <span class={`nb-nhan ${h.dang_song ? 'song' : 'tat'}`}>
                {h.dang_song ? t.dangTrenTrang : t.chuaCongBo}
              </span>
            </div>

            <p class={`nb-gia-tri ${hien ? '' : 'trong'}`}>
              {hien ?? t.trong}
            </p>

            {khoaCua ? (
              <p class="nb-dan" style="margin:.75rem 0 0;font-size:.85rem">
                {t.chiChu}
              </p>
            ) : (
              <>
                {h.kieu === 'bool' ? (
                  <label class="nb-o" style="margin-top:.85rem">
                    <span>{t.trangThai}</span>
                    <select name="gia_tri">
                      <option value="bat" selected={sanCo === 'bat'}>{t.bat}</option>
                      <option value="tat" selected={sanCo !== 'bat'}>{t.tat}</option>
                    </select>
                  </label>
                ) : h.kieu === 'ngay' ? (
                  <label class="nb-o" style="margin-top:.85rem">
                    <span>{t.ngay}</span>
                    <input type="date" name="gia_tri" value={sanCo} />
                  </label>
                ) : h.kieu === 'so' ? (
                  <label class="nb-o" style="margin-top:.85rem">
                    <span>{t.so}</span>
                    <input type="text" name="gia_tri" value={sanCo} inputmode="numeric" />
                  </label>
                ) : h.kieu === 'tep' ? (
                  <label class="nb-o" style="margin-top:.85rem">
                    <span>{t.maAnh}<code>tep_anh</code>{t.maAnh2}</span>
                    <small>{t.maAnhPhu}</small>
                    <input type="text" name="gia_tri" value={sanCo} autocapitalize="off" spellcheck="false" />
                  </label>
                ) : (
                  <>
                    <label class="nb-o" style="margin-top:.85rem">
                      <span>{h.kieu === 'url' ? t.duongDan
                            : h.kieu === 'sdt' ? t.sdt : t.noiDungVi}</span>
                      {h.kieu === 'van_ban'
                        ? <textarea name="gia_tri" rows="3">{sanCo}</textarea>
                        : <input
                            type="text" name="gia_tri" value={sanCo}
                            inputmode={h.kieu === 'sdt' ? 'tel' : h.kieu === 'url' ? 'url' : undefined}
                            autocapitalize="off" spellcheck="false"
                          />}
                    </label>
                    {h.kieu === 'van_ban' && ([['en', t.banEn], ['ko', t.banKo]] as const).map(([l, nhan]) => {
                      const chu = l === 'en' ? h.gia_tri_text_en : h.gia_tri_text_ko;
                      const tt = moTaO(h.ban_dich?.gia_tri_text?.[l], false, nn);
                      return (
                        <label class="nb-o">
                          <span>{nhan}</span>
                          <small>{t.dichPhu}</small>
                          <textarea name={`gia_tri_${l}`} rows="3" lang={l}>{chu ?? ''}</textarea>
                          {/* Chữ lúc mở màn hình — lib/cong-tac.ts so với nó để biết ô nào được sửa tay. */}
                          <input type="hidden" name={`goc_gia_tri_${l}`} value={chu ?? ''} />
                          {tt
                            ? <small class={`nb-dich ${tt.lop}`}>{tt.chu}</small>
                            : h.dang_song && !chu && (
                                <small class="nb-dich cho">{l === 'ko' ? t.chuaDichKo : t.chuaDichEn}</small>
                              )}
                        </label>
                      );
                    })}
                  </>
                )}

                <label class="nb-o">
                  <span>{t.viSao}</span>
                  <small>{t.viSaoPhu}</small>
                  <input type="text" name="ly_do" autocapitalize="sentences" />
                </label>

                <div class="nb-dong-nut">
                  {duocCongBo && (
                    <button type="submit" name="viec" value="cong_bo" class="nb-nut">
                      {t.congBo}
                    </button>
                  )}
                  <button type="submit" name="viec" value="nhap" class="nb-nut phu">
                    {t.luuNhap}
                  </button>
                  {h.dang_song && duocCongBo && (
                    <button type="submit" name="viec" value="go" class="nb-nut phu">
                      {t.goKhoiTrang}
                    </button>
                  )}
                </div>
              </>
            )}
          </form>
        );
      })}
    </section>
  ))}
</NoiBo>
