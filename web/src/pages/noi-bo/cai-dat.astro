---
/**
 * CÀI ĐẶT — đặt bàn (bật / tắt, giờ mở cửa), bàn ăn, dọn dữ liệu
 *
 * Gọn 26/10/2026: chỉ còn thứ cần để nhận đặt bàn. Lý do và những ô đã bỏ: đầu lib/cai-dat.ts.
 *
 * Form đặt bàn dựng lên khi: có chi nhánh, có giờ mở cửa, và "Nhận đặt bàn" đang bật. Cả ba ở
 * màn này. Bàn ăn không bắt buộc — chưa có bàn nào thì mọi khung giờ trong giờ mở cửa đều nhận
 * yêu cầu (0100), nhân viên gọi lại xác nhận từng cái.
 */
import NoiBo from '../../layouts/NoiBo.astro';
import {
  docChiNhanh, luuChiNhanh, docCongTacDatBan, datNhanDatBan, docBanAn, themNhieuBan, themMotBan,
  doiTrangThaiBan, xoaBan, chayViecDon, VIEC_DON,
  type ChiNhanh, type CongTacDatBan, type BanAn, type KetQua,
} from '../../lib/cai-dat';
import { dichNB, nnCua } from '../../lib/ngon-ngu-noi-bo';
import { dichCau } from '../../lib/cau-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, docBaoNoiBo, docFormNoiBo } from '../../lib/gui-noi-bo';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const laChu = nhanSu.vai_tro === 'chu_so_huu';
const nn = nnCua(Astro);
const t = dichNB(nn, {
  tieuDe:       { vi: 'Cài đặt', en: 'Settings' },
  h1:           { vi: 'Cài đặt nhà hàng', en: 'Restaurant settings' },
  chuaCN:       { vi: 'Chưa có chi nhánh nào. Tạo chi nhánh trước.', en: 'There is no branch yet. Create one first.' },
  viecSai:      { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
  khongLam:     { vi: 'Không thực hiện được.', en: 'Could not do that.' },
  khongDoc:     { vi: 'Không đọc được cài đặt.', en: 'Could not read the settings.' },
  datBan:       { vi: 'Đặt bàn', en: 'Bookings' },
  nhanDatBan:   { vi: 'Nhận đặt bàn trên web', en: 'Take bookings online' },
  dangBat:      { vi: 'Đang bật', en: 'On' },
  dangTat:      { vi: 'Đang tắt', en: 'Off' },
  batPhu:       { vi: 'Khách gửi yêu cầu ở trang Hỏi bàn, nhân viên gọi lại xác nhận.',
                  en: 'Guests send a request on the Ask for a table page; staff call back to confirm.' },
  tatNut:       { vi: 'Tắt nhận đặt bàn', en: 'Stop taking bookings' },
  batNut:       { vi: 'Bật nhận đặt bàn', en: 'Start taking bookings' },
  chiChuBat:    { vi: 'Chỉ chủ nhà hàng bật, tắt được việc này.', en: 'Only the owner can turn this on or off.' },
  gioMo:        { vi: 'Giờ mở cửa', en: 'Opening hours' },
  gioMoPhu:     { vi: 'Khung giờ đặt bàn sinh từ mấy ô này. Lưu là lên trang ngay.',
                  en: 'Booking time slots are generated from these fields. Saving puts them on the site right away.' },
  gioChuaLen:   { vi: 'Giờ mở cửa chưa hiện trên trang. Bấm Lưu giờ mở cửa để đưa lên.',
                  en: 'The opening hours are not on the site yet. Press Save opening hours to put them up.' },
  chiChuGio:    { vi: 'Chỉ chủ nhà hàng sửa được giờ mở cửa.', en: 'Only the owner can change the opening hours.' },
  trua:         { vi: 'Trưa', en: 'Lunch' },
  toi:          { vi: 'Tối', en: 'Dinner' },
  chuaCoCN1:    { vi: 'Chưa có chi nhánh nào.', en: 'No branch yet.' },
  chuaCoCN2:    { vi: ' Tạo xong nhớ đặt ', en: ' Once created, remember to set ' },
  trong:        { vi: ' trong ', en: ' in ' },
  chuaCoCN3:    { vi: ' bằng đúng mã bên dưới, nếu không trang đặt bàn sẽ không tìm thấy chi nhánh.',
                  en: ' to exactly the code below, otherwise the booking page will not find the branch.' },
  maCN:         { vi: 'Mã chi nhánh', en: 'Branch code' },
  maCNPhu1:     { vi: 'Chữ thường, không dấu. Phải khớp ', en: 'Lowercase, no accents. Must match ' },
  tenCN:        { vi: 'Tên chi nhánh', en: 'Branch name' },
  truaMo:       { vi: 'Trưa mở', en: 'Lunch opens' },
  truaDong:     { vi: 'Trưa đóng', en: 'Lunch closes' },
  toiMo:        { vi: 'Tối mở', en: 'Dinner opens' },
  toiDong:      { vi: 'Tối đóng', en: 'Dinner closes' },
  luuGio:       { vi: 'Lưu giờ mở cửa', en: 'Save opening hours' },
  taoCN:        { vi: 'Tạo chi nhánh', en: 'Create branch' },
  banAn:        { vi: 'Bàn ăn — không bắt buộc', en: 'Tables — optional' },
  banPhu:       { vi: 'Chưa nhập bàn thì web nhận mọi yêu cầu trong giờ mở cửa. Nhập bàn thì web tự báo hết bàn khi một khung giờ đã kín.',
                  en: 'With no tables entered, the site takes every request during opening hours. Once tables are entered, the site says a time slot is full when it is.' },
  chuaBan:      { vi: 'Chưa nhập bàn nào.', en: 'No tables entered.' },
  soBan:        { vi: (n: number) => `${n} bàn`, en: (n: number) => `${n} tables` },
  dangDung:     { vi: ' đang dùng · ', en: ' in use · ' },
  soCho:        { vi: (n: number) => ` ${n} chỗ`, en: (n: number) => ` ${n} seats` },
  banNgung:     { vi: (n: number) => ` · ${n} bàn đã ngừng dùng`, en: (n: number) => ` · ${n} tables out of use` },
  themNhieu:    { vi: 'Thêm nhiều bàn một lượt', en: 'Add many tables at once' },
  tienTo:       { vi: 'Tên bắt đầu bằng', en: 'Name starts with' },
  tuSo:         { vi: 'Từ số', en: 'From number' },
  denSo:        { vi: 'Đến số', en: 'To number' },
  moiBan:       { vi: 'Mỗi bàn mấy chỗ', en: 'Seats per table' },
  themLoat:     { vi: 'Thêm loạt bàn', en: 'Add tables' },
  themMot:      { vi: 'Thêm một bàn lẻ', en: 'Add a single table' },
  tenBan:       { vi: 'Tên bàn', en: 'Table name' },
  tenBanVD:     { vi: 'Bàn góc', en: 'Corner table' },
  soChoO:       { vi: 'Số chỗ', en: 'Seats' },
  themBan:      { vi: 'Thêm bàn', en: 'Add table' },
  choCua:       { vi: (n: number) => `${n} chỗ`, en: (n: number) => `${n} seats` },
  rieng:        { vi: ' · riêng', en: ' · private' },
  ngungDung:    { vi: 'Ngừng dùng', en: 'Take out of use' },
  dungLai:      { vi: 'Dùng lại', en: 'Use again' },
  xoa:          { vi: 'Xóa', en: 'Delete' },
  ngungPhu:     { vi: 'Ngừng dùng giữ lịch sử đặt bàn của bàn đó. Xóa chỉ dùng cho bàn gõ nhầm.',
                  en: 'Taking a table out of use keeps its booking history. Delete is only for a table entered by mistake.' },
  donDL:        { vi: 'Dọn dữ liệu', en: 'Data clean-up' },
  donPhu:       { vi: 'Không chạy tự động — người bấm. Đèn "Dọn dữ liệu cá nhân" ở trang Tổng quan báo khi tới lúc bấm.',
                  en: 'Not automatic — a person presses it. The "Personal data clean-up" light on the Overview page says when it is time.' },
  chiChuChay:   { vi: 'Chỉ chủ nhà hàng chạy được việc này.', en: 'Only the owner can run this job.' },
  chayNgay:     { vi: 'Chạy ngay', en: 'Run now' },
});

// Lưu được thì chuyển hướng 303 về chính trang này (lib/gui-noi-bo.ts): F5 không thêm
// bàn lần nữa, không chạy lại việc dọn dữ liệu. Không lưu được thì dựng lại trang ngay.
let bao: KetQua | null = docBaoNoiBo(Astro.cookies, Astro.url.pathname);

if (Astro.request.method === 'POST') {
  const form = await docFormNoiBo(Astro.request);
  if (!form) bao = { ok: false, cau: CAU_DOC_FORM_HONG[nn] };

  if (form) {
    const viec = String(form.get('viec') ?? '');
    try {
      const cn = await docChiNhanh(client);
      if (viec === 'chi_nhanh')        bao = await luuChiNhanh(client, form, cn, nn);
      else if (viec === 'nhan_dat_ban') bao = await datNhanDatBan(client, form, nn);
      else if (viec === 'don')         bao = await chayViecDon(client, String(form.get('ham')), nn, laChu);
      else if (!cn)                    bao = { ok: false, cau: t.chuaCN };
      else if (viec === 'them_nhieu')  bao = await themNhieuBan(client, form, cn.id, nn);
      else if (viec === 'them_mot')    bao = await themMotBan(client, form, cn.id, nn);
      else if (viec === 'ngung')       bao = await doiTrangThaiBan(client, String(form.get('id')), false, nn);
      else if (viec === 'dung_lai')    bao = await doiTrangThaiBan(client, String(form.get('id')), true, nn);
      else if (viec === 'xoa')         bao = await xoaBan(client, String(form.get('id')), nn);
      else                             bao = { ok: false, cau: t.viecSai };
    } catch (e) {
      bao = { ok: false, cau: e instanceof Error ? dichCau(nn, e.message) : t.khongLam };
    }
    if (bao.ok) return chuyenHuongNoiBo(Astro, bao);
  }
}

let chiNhanh: ChiNhanh | null = null;
let congTac: CongTacDatBan | null = null;
let ban: BanAn[] = [];
let loiDoc: string | null = null;
try {
  chiNhanh = await docChiNhanh(client);
  congTac = await docCongTacDatBan(client);
  if (chiNhanh) ban = await docBanAn(client, chiNhanh.id);
} catch (e) {
  loiDoc = e instanceof Error ? dichCau(nn, e.message) : t.khongDoc;
}

// Đọc lỗi thì KHÔNG dựng form nào của đặt bàn: chiNhanh null vì đọc hỏng sẽ hiện form "Tạo chi nhánh"
// với giờ mặc định, và bấm nó là ghi đè giờ thật của chi nhánh đang có.
const docDu = loiDoc === null;
const dangDung = ban.filter(b => b.dang_dung);
const tongCho = dangDung.reduce((n, b) => n + b.so_cho, 0);

const hhmm = (t: string | undefined) => (t ?? '').slice(0, 5);
---
<NoiBo tieuDe={t.tieuDe} nhanSu={nhanSu}>
  <h1>{t.h1}</h1>

  {bao && (
    <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`}><p>{bao.cau}</p></div>
  )}
  {loiDoc && <div class="nb-bao loi"><p>{loiDoc}</p></div>}

  {/* ---------------------------------------------------------------- */}
  {docDu && <h2>{t.datBan}</h2>}

  {docDu && chiNhanh && congTac && (
    <div class="nb-the">
      <div class="nb-cong-tac">
        <div class="nb-cong-tac-chu">
          <strong>{t.nhanDatBan}</strong>
          <p>{t.batPhu}</p>
        </div>
        <span class={`nb-nhan ${congTac.nhanDatBan ? 'song' : 'tat'}`}>
          {congTac.nhanDatBan ? t.dangBat : t.dangTat}
        </span>
      </div>
      {laChu ? (
        <form method="POST" style="margin-top:.85rem">
          <input type="hidden" name="viec" value="nhan_dat_ban" />
          <input type="hidden" name="bat" value={congTac.nhanDatBan ? 'khong' : 'co'} />
          <button type="submit" class={`nb-nut ${congTac.nhanDatBan ? 'phu' : ''}`}>
            {congTac.nhanDatBan ? t.tatNut : t.batNut}
          </button>
        </form>
      ) : (
        <p class="nb-dan" style="margin:.75rem 0 0;font-size:.85rem">{t.chiChuBat}</p>
      )}
    </div>
  )}

  {!docDu ? null : !laChu ? (
    <div class="nb-the">
      <strong>{t.gioMo}</strong>
      {chiNhanh && (
        <p style="margin:.35rem 0 0">
          {t.trua} {hhmm(chiNhanh.trua_bat_dau)}–{hhmm(chiNhanh.trua_ket_thuc)} · {t.toi} {hhmm(chiNhanh.toi_bat_dau)}–{hhmm(chiNhanh.toi_ket_thuc)}
        </p>
      )}
      <p class="nb-dan" style="margin:.75rem 0 0;font-size:.85rem">{t.chiChuGio}</p>
    </div>
  ) : (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="chi_nhanh" />
      <strong>{t.gioMo}</strong>
      <p class="nb-dan" style="font-size:.85rem;margin:.35rem 0 1rem">{t.gioMoPhu}</p>

      {chiNhanh && !congTac?.gioDaLen && (
        <div class="nb-bao luu-y" style="margin-bottom:1rem"><p style="margin:0">{t.gioChuaLen}</p></div>
      )}

      {!chiNhanh && (
        <>
          <div class="nb-bao luu-y" style="margin-bottom:1.25rem">
            <p style="margin:0"><strong>{t.chuaCoCN1}</strong>{t.chuaCoCN2}<code>PUBLIC_CHI_NHANH</code>{t.trong}<code>web/.env</code>{t.chuaCoCN3}</p>
          </div>
          <label class="nb-o">
            <span>{t.maCN}</span>
            <small>{t.maCNPhu1}<code>PUBLIC_CHI_NHANH</code>{t.trong}<code>web/.env</code>.</small>
            <input type="text" name="ma" required value="q1"
                   autocapitalize="off" spellcheck="false" pattern="[a-z0-9-]{1,20}" />
          </label>
          <label class="nb-o">
            <span>{t.tenCN}</span>
            <input type="text" name="ten" required value={'Beeftown Quận 1'} />
          </label>
        </>
      )}

      <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))">
        <label class="nb-o"><span>{t.truaMo}</span>
          <input type="time" name="trua_bat_dau" required value={hhmm(chiNhanh?.trua_bat_dau) || '11:00'} /></label>
        <label class="nb-o"><span>{t.truaDong}</span>
          <input type="time" name="trua_ket_thuc" required value={hhmm(chiNhanh?.trua_ket_thuc) || '14:00'} /></label>
        <label class="nb-o"><span>{t.toiMo}</span>
          <input type="time" name="toi_bat_dau" required value={hhmm(chiNhanh?.toi_bat_dau) || '17:00'} /></label>
        <label class="nb-o"><span>{t.toiDong}</span>
          <input type="time" name="toi_ket_thuc" required value={hhmm(chiNhanh?.toi_ket_thuc) || '23:00'} /></label>
      </div>

      <button type="submit" class="nb-nut" style="width:100%">
        {chiNhanh ? t.luuGio : t.taoCN}
      </button>
    </form>
  )}

  {/* ---------------------------------------------------------------- */}
  {docDu && chiNhanh && (
    <details class="nb-the">
      <summary style="cursor:pointer;font-weight:600">{t.banAn}</summary>
      <p class="nb-dan" style="font-size:.85rem;margin:.75rem 0">{t.banPhu}</p>
      <p class="nb-dan" style="font-size:.85rem">
        {dangDung.length === 0
          ? <strong>{t.chuaBan}</strong>
          : <><strong>{t.soBan(dangDung.length)}</strong>{t.dangDung}<strong>{t.soCho(tongCho)}</strong></>}
        {ban.length - dangDung.length > 0 && <>{t.banNgung(ban.length - dangDung.length)}</>}
      </p>

      <h3 style="font-size:1rem;margin:1.5rem 0 .5rem">{t.themNhieu}</h3>
      <form method="POST">
        <input type="hidden" name="viec" value="them_nhieu" />
        <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(7rem,1fr))">
          <label class="nb-o"><span>{t.tienTo}</span>
            <input type="text" name="tien_to" value="B" maxlength="6" autocapitalize="characters" /></label>
          <label class="nb-o"><span>{t.tuSo}</span>
            <input type="text" name="tu" value="1" inputmode="numeric" /></label>
          <label class="nb-o"><span>{t.denSo}</span>
            <input type="text" name="den" value="10" inputmode="numeric" /></label>
          <label class="nb-o"><span>{t.moiBan}</span>
            <input type="text" name="so_cho" value="4" inputmode="numeric" /></label>
        </div>
        <button type="submit" class="nb-nut phu" style="width:100%">{t.themLoat}</button>
      </form>

      <h3 style="font-size:1rem;margin:1.5rem 0 .5rem">{t.themMot}</h3>
      <form method="POST">
        <input type="hidden" name="viec" value="them_mot" />
        <div style="display:grid;gap:.75rem;grid-template-columns:1fr 1fr">
          <label class="nb-o"><span>{t.tenBan}</span>
            <input type="text" name="ten" required placeholder={t.tenBanVD} /></label>
          <label class="nb-o"><span>{t.soChoO}</span>
            <input type="text" name="so_cho" value="4" inputmode="numeric" /></label>
        </div>
        <button type="submit" class="nb-nut phu" style="width:100%">{t.themBan}</button>
      </form>

      {ban.length > 0 && (
        <>
          <div class="nb-luoi-ban" style="margin-top:1.25rem">
            {ban.map(b => (
              <div class={`nb-o-ban ${b.dang_dung ? '' : 'tat'}`}>
                <strong>{b.ten}</strong>
                <span>{t.choCua(b.so_cho)}{b.la_phong_rieng ? t.rieng : ''}</span>
                <form method="POST" class="nb-ban-nut">
                  <input type="hidden" name="id" value={b.id} />
                  {b.dang_dung
                    ? <button type="submit" name="viec" value="ngung" class="nb-nut-nho-sang">{t.ngungDung}</button>
                    : <button type="submit" name="viec" value="dung_lai" class="nb-nut-nho-sang">{t.dungLai}</button>}
                  <button type="submit" name="viec" value="xoa" class="nb-nut-nho-sang xoa">{t.xoa}</button>
                </form>
              </div>
            ))}
          </div>
          <p class="nb-dan" style="font-size:.85rem;margin:1rem 0 0">{t.ngungPhu}</p>
        </>
      )}
    </details>
  )}

  {/* ---------------------------------------------------------------- */}
  <h2>{t.donDL}</h2>
  <p class="nb-dan">{t.donPhu}</p>

  {VIEC_DON.map(v => (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="don" />
      <input type="hidden" name="ham" value={v.ham} />
      <div class="nb-cong-tac">
        <div class="nb-cong-tac-chu">
          <strong>{v.ten[nn]}</strong>
          <p>{v.giai_thich[nn]}</p>
        </div>
      </div>
      {v.chi_chu_so_huu && !laChu ? (
        <p class="nb-dan" style="margin:.75rem 0 0;font-size:.85rem">{t.chiChuChay}</p>
      ) : (
        <button type="submit" class="nb-nut phu" style="margin-top:.85rem">{t.chayNgay}</button>
      )}
    </form>
  ))}
</NoiBo>

<style>
  .nb-luoi-ban {
    display: grid; gap: .6rem;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  }
  .nb-o-ban {
    border: 1px solid var(--vach); border-radius: 8px; padding: .7rem;
    display: flex; flex-direction: column; gap: .15rem;
  }
  /* Bàn ngừng dùng: nét đứt #767676, nền trong (kiểu "tắt") — không làm mờ: chữ phụ #555 mờ 50 % trên trắng chỉ còn
     khoảng 2,2 : 1. Nút "Dùng lại" nói trạng thái bằng chữ. */
  .nb-o-ban.tat { background: transparent; border: 1.5px dashed var(--vien-o); }
  .nb-o-ban strong { font-size: .95rem; }
  .nb-o-ban span { font-size: .8rem; color: var(--muc-nhat); }
  .nb-ban-nut { display: flex; gap: .35rem; margin-top: .5rem; }
  .nb-nut-nho-sang {
    font: inherit; font-size: .75rem; font-weight: 600;
    background: var(--nb-the); color: var(--than);
    border: 1px solid var(--vien-o); border-radius: 6px;
    padding: .4rem .5rem; cursor: pointer; min-height: 36px; flex: 1;
  }
  .nb-nut-nho-sang:hover { background: var(--kem-dam); }
  .nb-nut-nho-sang.xoa { color: var(--do); }
</style>
