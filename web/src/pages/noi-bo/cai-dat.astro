---
/**
 * CÀI ĐẶT — chi nhánh, bàn ăn, dọn dữ liệu
 *
 * Ba việc trước đây chỉ làm được bằng SQL. Xem lý do ở đầu lib/cai-dat.ts.
 *
 * Màn này là chỗ mở khóa form đặt bàn: form chỉ dựng lên khi CÓ chi nhánh,
 * CÓ giờ phục vụ, CÓ bàn trong ban_an, và công tắc form_dat_ban_dang_mo bật.
 * Ba điều kiện đầu nằm ở đây; điều kiện cuối ở màn Nội dung.
 */
import NoiBo from '../../layouts/NoiBo.astro';
import {
  docChiNhanh, luuChiNhanh, docBanAn, themNhieuBan, themMotBan,
  doiTrangThaiBan, xoaBan, chayViecDon, VIEC_DON,
  type ChiNhanh, type BanAn, type KetQua,
} from '../../lib/cai-dat';
import { dichNB, nnCua } from '../../lib/ngon-ngu-noi-bo';
import { dichCau } from '../../lib/cau-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, docBaoNoiBo, docFormNoiBo } from '../../lib/gui-noi-bo';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const laChu = nhanSu.vai_tro === 'chu_so_huu';
const nn = nnCua(Astro);
const t = dichNB(nn, {
  tieuDe:       { vi: 'Cài đặt', en: 'Settings' },
  h1:           { vi: 'Cài đặt nhà hàng', en: 'Restaurant settings' },
  dan1:         { vi: 'Chi nhánh, giờ phục vụ và bàn ăn. Đây là chỗ ', en: 'Branch, opening hours and tables. This is where you ' },
  dan2:         { vi: 'mở khóa form đặt bàn', en: 'unlock the booking form' },
  dan3:         { vi: ' — form chỉ dựng lên khi có đủ giờ và có bàn thật.', en: ' — it only appears once the hours are set and real tables exist.' },
  chuaCN:       { vi: 'Chưa có chi nhánh nào. Tạo chi nhánh trước.', en: 'There is no branch yet. Create one first.' },
  viecSai:      { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
  khongLam:     { vi: 'Không thực hiện được.', en: 'Could not do that.' },
  khongDoc:     { vi: 'Không đọc được cài đặt.', en: 'Could not read the settings.' },
  chiNhanh:     { vi: 'Chi nhánh', en: 'Branch' },
  chiChu:       { vi: 'Chỉ chủ nhà hàng sửa được chi nhánh và giờ phục vụ.', en: 'Only the owner can change the branch and opening hours.' },
  hienTai:      { vi: ' Hiện tại: ', en: ' Currently: ' },
  trua:         { vi: 'trưa', en: 'lunch' },
  toi:          { vi: 'tối', en: 'dinner' },
  chuaCoCN1:    { vi: 'Chưa có chi nhánh nào.', en: 'No branch yet.' },
  chuaCoCN2:    { vi: ' Tạo xong nhớ đặt ', en: ' Once created, remember to set ' },
  trong:        { vi: ' trong ', en: ' in ' },
  chuaCoCN3:    { vi: ' bằng đúng mã bên dưới, nếu không trang đặt bàn sẽ không tìm thấy chi nhánh.',
                  en: ' to exactly the code below, otherwise the booking page will not find the branch.' },
  maCN:         { vi: 'Mã chi nhánh', en: 'Branch code' },
  maCNPhu1:     { vi: 'Chữ thường, không dấu. Phải khớp ', en: 'Lowercase, no accents. Must match ' },
  tenCN:        { vi: 'Tên chi nhánh', en: 'Branch name' },
  khuVuc:       { vi: 'Khu vực', en: 'Area' },
  khuVucPhu:    { vi: 'Tên khu, dùng trong nội bộ. Không hiện trên trang công khai.', en: 'Area name, for internal use. Not shown on the public site.' },
  diaChi:       { vi: 'Địa chỉ', en: 'Address' },
  diaChiPhu1:   { vi: 'Ô này KHÔNG đưa địa chỉ lên trang công khai. Địa chỉ khách nhìn thấy là khóa ',
                  en: 'This field does NOT put the address on the public site. The address guests see is the key ' },
  diaChiPhu2:   { vi: ' ở màn ', en: ' on the ' },
  noiDung:      { vi: 'Nội dung', en: 'Content' },
  diaChiPhu3:   { vi: ' — hai chỗ tách nhau để địa chỉ chỉ lên trang khi có người bấm công bố.',
                  en: ' screen — the two are separate so the address only goes live when someone presses Publish.' },
  dtNoiBo:      { vi: 'Điện thoại nội bộ', en: 'Internal phone' },
  dtNoiBoPhu1:  { vi: 'Cũng không lên trang. Hotline công khai là khóa ', en: 'Also not on the site. The public hotline is the key ' },
  dtNoiBoPhu2:  { vi: ' ở màn Nội dung.', en: ' on the Content screen.' },
  gioPV:        { vi: 'Giờ phục vụ', en: 'Opening hours' },
  gioPVPhu1:    { vi: 'Khung giờ đặt bàn được sinh ra từ mấy ô này. Sửa ở đây ', en: 'Booking time slots are generated from these fields. Changing them here ' },
  gioPVPhu2:    { vi: 'chưa đưa giờ lên trang', en: 'does not put the hours on the site yet' },
  gioPVPhu3:    { vi: ' — còn phải bật công tắc ', en: ' — you also need to turn on the switch ' },
  gioToi1:      { vi: 'Giờ tối đang là ', en: 'Dinner currently starts at ' },
  gioToi2:      { vi: ' — đó là giá trị mặc định của database, không phải giờ đã chốt. Roster vận hành ghi ca tối bắt đầu ',
                  en: ' — that is the database default, not a confirmed time. The operations roster says the evening shift starts at ' },
  gioToi3:      { vi: '. Kiểm lại trước khi công bố.', en: '. Check it before publishing.' },
  truaMo:       { vi: 'Trưa mở', en: 'Lunch opens' },
  truaDong:     { vi: 'Trưa đóng', en: 'Lunch closes' },
  toiMo:        { vi: 'Tối mở', en: 'Dinner opens' },
  toiDong:      { vi: 'Tối đóng', en: 'Dinner closes' },
  cachNhau:     { vi: 'Cách nhau (phút)', en: 'Interval (minutes)' },
  cachNhauPhu:  { vi: 'Khoảng cách giữa hai khung giờ.', en: 'Gap between two time slots.' },
  motLuot:      { vi: 'Một lượt ngồi (phút)', en: 'One seating (minutes)' },
  motLuotPhu:   { vi: 'Bàn bị chiếm bao lâu.', en: 'How long a table is taken.' },
  giuBan:       { vi: 'Giữ bàn (phút)', en: 'Hold table (minutes)' },
  giuBanPhu:    { vi: 'Chờ khách trễ bao lâu.', en: 'How long to wait for late guests.' },
  luuCN:        { vi: 'Lưu chi nhánh', en: 'Save branch' },
  taoCN:        { vi: 'Tạo chi nhánh', en: 'Create branch' },
  banAn:        { vi: 'Bàn ăn', en: 'Tables' },
  chuaBan1:     { vi: 'Chưa có bàn nào đang dùng.', en: 'No tables in use yet.' },
  chuaBan2:     { vi: ' Bảng bàn trống thì mọi khung giờ đều tính là hết chỗ — và form đặt bàn sẽ báo ',
                  en: ' With an empty table list every time slot counts as full — and the booking form would tell every guest ' },
  hetBan:       { vi: ' "hết bàn"', en: ' "fully booked"' },
  chuaBan3:     { vi: ' với mọi khách, một câu nói sai về một nhà hàng chưa mở. Trang ',
                  en: ', which is untrue for a restaurant that has not opened. The ' },
  chuaBan4:     { vi: ' có chốt chặn nên nó nói "chưa mở đặt bàn" thay vì báo hết bàn, nhưng bàn vẫn phải nhập.',
                  en: ' page has a guard, so it says "bookings not open yet" instead of "fully booked", but the tables still have to be entered.' },
  soBan:        { vi: (n: number) => `${n} bàn`, en: (n: number) => `${n} tables` },
  dangDung:     { vi: ' đang dùng · ', en: ' in use · ' },
  soCho:        { vi: (n: number) => ` ${n} chỗ`, en: (n: number) => ` ${n} seats` },
  phongRieng:   { vi: (n: number) => ` ${n} phòng riêng ·`, en: (n: number) => ` ${n} private rooms ·` },
  banNgung:     { vi: (n: number) => ` ${n} bàn đã ngừng dùng`, en: (n: number) => ` ${n} tables out of use` },
  khongNgung:   { vi: ' không có bàn nào ngừng dùng', en: ' no tables out of use' },
  themNhieu:    { vi: 'Thêm nhiều bàn một lượt', en: 'Add many tables at once' },
  themNhieuPhu: { vi: 'Nhà hàng có hai, ba chục bàn. Nhập từng cái là bấm ba chục lần cho một việc máy làm được.',
                  en: 'The restaurant has twenty or thirty tables. Entering them one by one means thirty clicks for a job the machine can do.' },
  tienTo:       { vi: 'Tên bắt đầu bằng', en: 'Name starts with' },
  tuSo:         { vi: 'Từ số', en: 'From number' },
  denSo:        { vi: 'Đến số', en: 'To number' },
  moiBan:       { vi: 'Mỗi bàn mấy chỗ', en: 'Seats per table' },
  laPhong:      { vi: 'Đây là phòng riêng', en: 'This is a private room' },
  themLoat:     { vi: 'Thêm loạt bàn', en: 'Add tables' },
  themMot:      { vi: 'Thêm một bàn lẻ', en: 'Add a single table' },
  tenBan:       { vi: 'Tên bàn', en: 'Table name' },
  tenBanVD:     { vi: 'Phòng riêng 1', en: 'Private room 1' },
  soChoO:       { vi: 'Số chỗ', en: 'Seats' },
  themBan:      { vi: 'Thêm bàn', en: 'Add table' },
  dsBan:        { vi: 'Danh sách bàn', en: 'Table list' },
  choCua:       { vi: (n: number) => `${n} chỗ`, en: (n: number) => `${n} seats` },
  rieng:        { vi: ' · riêng', en: ' · private' },
  ngungDung:    { vi: 'Ngừng dùng', en: 'Take out of use' },
  dungLai:      { vi: 'Dùng lại', en: 'Use again' },
  xoa:          { vi: 'Xóa', en: 'Delete' },
  ngungPhu1:    { vi: 'Ngừng dùng', en: 'Take out of use' },
  ngungPhu2:    { vi: ' giữ lại lịch sử đặt bàn của bàn đó — dùng khi bàn hỏng hoặc dẹp tạm. ',
                  en: ' keeps that table\'s booking history — use it when a table is broken or put away for a while. ' },
  ngungPhu3:    { vi: 'Xóa', en: 'Delete' },
  ngungPhu4:    { vi: ' chỉ nên dùng cho bàn vừa gõ nhầm lúc cài đặt.', en: ' is only for a table entered by mistake during setup.' },
  donDL:        { vi: 'Dọn dữ liệu', en: 'Data clean-up' },
  donPhu1:      { vi: 'Ba việc này ', en: 'These three jobs ' },
  donPhu2:      { vi: 'cố ý không chạy tự động', en: 'deliberately do not run automatically' },
  donPhu3:      { vi: ' — một công việc chạy ngầm âm thầm hủy dữ liệu cá nhân thì nên do người bấm. Đèn "Dọn dữ liệu cá nhân" ở trang Tổng quan đổi màu khi tới lúc bấm: vàng là nên bấm trong tuần này, đỏ là hồ sơ đã quá hạn lưu hơn 7 ngày.',
                  en: ' — a background job that silently destroys personal data should be started by a person. The "Personal data clean-up" light on the Overview page changes colour when it is time to press: yellow means press this week, red means applications have been past their retention period for over 7 days.' },
  chiChuChay:   { vi: 'Chỉ chủ nhà hàng chạy được việc này.', en: 'Only the owner can run this job.' },
  chayNgay:     { vi: 'Chạy ngay', en: 'Run now' },
  supabase:     { vi: 'Vẫn phải làm trong Supabase', en: 'Still done in Supabase' },
  supabase1:    { vi: 'Còn đúng hai việc không có nút ở đây, và cả hai đều có lý do:', en: 'Exactly two jobs have no button here, both for a reason:' },
  taoTK:        { vi: 'Tạo tài khoản nhân sự mới', en: 'Create a new staff account' },
  taoTK1:       { vi: ' — phải đi qua Supabase Auth (Authentication → Users), rồi nối ', en: ' — it has to go through Supabase Auth (Authentication → Users), then link ' },
  taoTK2:       { vi: ' vào một dòng trong bảng ', en: ' to a row in the ' },
  taoTK3:       { vi: '. Một trang web tự tạo được tài khoản đăng nhập cho chính nó là một trang web tự cấp quyền cho chính nó.',
                  en: ' table. A website that can create its own login accounts is a website that grants itself access.' },
  taiAnh:       { vi: 'Tải ảnh lên', en: 'Upload photos' },
  taiAnh1:      { vi: ' — làm trong Storage. Màn chọn ảnh chưa dựng.', en: ' — done in Storage. The photo picker is not built yet.' },
});

// Lưu được thì chuyển hướng 303 về chính trang này (lib/gui-noi-bo.ts): F5 không thêm
// bàn lần nữa, không chạy lại việc dọn dữ liệu. Không lưu được thì dựng lại trang ngay.
let bao: KetQua | null = docBaoNoiBo(Astro.cookies, Astro.url.pathname);

if (Astro.request.method === 'POST') {
  const form = await docFormNoiBo(Astro.request);
  if (!form) bao = { ok: false, cau: CAU_DOC_FORM_HONG[nn] };

  if (form) {
    const viec = String(form.get('viec') ?? '');
    try {
      const cn = await docChiNhanh(client);
      if (viec === 'chi_nhanh')        bao = await luuChiNhanh(client, form, cn, nn);
      else if (!cn)                    bao = { ok: false, cau: t.chuaCN };
      else if (viec === 'them_nhieu')  bao = await themNhieuBan(client, form, cn.id, nn);
      else if (viec === 'them_mot')    bao = await themMotBan(client, form, cn.id, nn);
      else if (viec === 'ngung')       bao = await doiTrangThaiBan(client, String(form.get('id')), false, nn);
      else if (viec === 'dung_lai')    bao = await doiTrangThaiBan(client, String(form.get('id')), true, nn);
      else if (viec === 'xoa')         bao = await xoaBan(client, String(form.get('id')), nn);
      else if (viec === 'don')         bao = await chayViecDon(client, String(form.get('ham')), nn, laChu);
      else                             bao = { ok: false, cau: t.viecSai };
    } catch (e) {
      bao = { ok: false, cau: e instanceof Error ? dichCau(nn, e.message) : t.khongLam };
    }
    if (bao.ok) return chuyenHuongNoiBo(Astro, bao);
  }
}

let chiNhanh: ChiNhanh | null = null;
let ban: BanAn[] = [];
let loiDoc: string | null = null;
try {
  chiNhanh = await docChiNhanh(client);
  if (chiNhanh) ban = await docBanAn(client, chiNhanh.id);
} catch (e) {
  loiDoc = e instanceof Error ? dichCau(nn, e.message) : t.khongDoc;
}

const dangDung = ban.filter(b => b.dang_dung);
const tongCho = dangDung.reduce((n, b) => n + b.so_cho, 0);

// Mặc định của 0001 là 17:00, nhưng roster vận hành ghi ca tối bắt đầu 16:00.
const gioToiDangNgo = chiNhanh?.toi_bat_dau?.slice(0, 5) === '17:00';

const hhmm = (t: string | undefined) => (t ?? '').slice(0, 5);
---
<NoiBo tieuDe={t.tieuDe} nhanSu={nhanSu}>
  <h1>{t.h1}</h1>
  <p class="nb-dan">
    {t.dan1}<strong>{t.dan2}</strong>{t.dan3}
  </p>

  {bao && (
    <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`}><p>{bao.cau}</p></div>
  )}
  {loiDoc && <div class="nb-bao loi"><p>{loiDoc}</p></div>}

  {/* ---------------------------------------------------------------- */}
  <h2>{t.chiNhanh}</h2>

  {!laChu ? (
    <div class="nb-the">
      <p style="margin:0">
        {t.chiChu}
        {chiNhanh && <>{t.hienTai}<strong>{chiNhanh.ten}</strong> ({chiNhanh.ma}),
          {' '}{t.trua} {hhmm(chiNhanh.trua_bat_dau)}–{hhmm(chiNhanh.trua_ket_thuc)},
          {' '}{t.toi} {hhmm(chiNhanh.toi_bat_dau)}–{hhmm(chiNhanh.toi_ket_thuc)}.</>}
      </p>
    </div>
  ) : (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="chi_nhanh" />

      {!chiNhanh && (
        <div class="nb-bao luu-y" style="margin-bottom:1.25rem">
          <p style="margin:0"><strong>{t.chuaCoCN1}</strong>{t.chuaCoCN2}<code>PUBLIC_CHI_NHANH</code>{t.trong}<code>web/.env</code>{t.chuaCoCN3}</p>
        </div>
      )}

      <label class="nb-o">
        <span>{t.maCN}</span>
        <small>{t.maCNPhu1}<code>PUBLIC_CHI_NHANH</code>{t.trong}<code>web/.env</code>.</small>
        <input type="text" name="ma" required value={chiNhanh?.ma ?? 'q1'}
               autocapitalize="off" spellcheck="false" pattern="[a-z0-9-]{1,20}" />
      </label>

      <label class="nb-o">
        <span>{t.tenCN}</span>
        <input type="text" name="ten" required value={chiNhanh?.ten ?? 'Beeftown Quận 1'} />
      </label>

      <label class="nb-o">
        <span>{t.khuVuc}</span>
        <small>{t.khuVucPhu}</small>
        <input type="text" name="khu_vuc" value={chiNhanh?.khu_vuc ?? ''} />
      </label>

      <label class="nb-o">
        <span>{t.diaChi}</span>
        <small>
          {t.diaChiPhu1}<code>dia_chi_hien_thi</code>{t.diaChiPhu2}<a href="/noi-bo/noi-dung">{t.noiDung}</a>{t.diaChiPhu3}
        </small>
        <input type="text" name="dia_chi" value={chiNhanh?.dia_chi ?? ''} />
      </label>

      <label class="nb-o">
        <span>{t.dtNoiBo}</span>
        <small>{t.dtNoiBoPhu1}<code>hotline</code>{t.dtNoiBoPhu2}</small>
        <input type="tel" name="dien_thoai" value={chiNhanh?.dien_thoai ?? ''} inputmode="tel" />
      </label>

      <h3 style="font-size:1rem;margin:1.5rem 0 .5rem">{t.gioPV}</h3>
      <p class="nb-dan" style="font-size:.85rem;margin-bottom:1rem">
        {t.gioPVPhu1}<strong>{t.gioPVPhu2}</strong>{t.gioPVPhu3}<a href="/noi-bo/noi-dung"><code>gio_phuc_vu_da_chot</code></a>.
      </p>

      {gioToiDangNgo && (
        <div class="nb-bao luu-y" style="margin-bottom:1rem">
          <p style="margin:0">
            {t.gioToi1}<strong>17:00</strong>{t.gioToi2}<strong>16:00</strong>{t.gioToi3}
          </p>
        </div>
      )}

      <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))">
        <label class="nb-o"><span>{t.truaMo}</span>
          <input type="time" name="trua_bat_dau" required value={hhmm(chiNhanh?.trua_bat_dau) || '11:00'} /></label>
        <label class="nb-o"><span>{t.truaDong}</span>
          <input type="time" name="trua_ket_thuc" required value={hhmm(chiNhanh?.trua_ket_thuc) || '14:00'} /></label>
        <label class="nb-o"><span>{t.toiMo}</span>
          <input type="time" name="toi_bat_dau" required value={hhmm(chiNhanh?.toi_bat_dau) || '16:00'} /></label>
        <label class="nb-o"><span>{t.toiDong}</span>
          <input type="time" name="toi_ket_thuc" required value={hhmm(chiNhanh?.toi_ket_thuc) || '22:00'} /></label>
      </div>

      <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))">
        <label class="nb-o"><span>{t.cachNhau}</span>
          <small>{t.cachNhauPhu}</small>
          <input type="text" name="buoc_khung_gio_phut" inputmode="numeric"
                 value={String(chiNhanh?.buoc_khung_gio_phut ?? 30)} /></label>
        <label class="nb-o"><span>{t.motLuot}</span>
          <small>{t.motLuotPhu}</small>
          <input type="text" name="thoi_luong_bua_phut" inputmode="numeric"
                 value={String(chiNhanh?.thoi_luong_bua_phut ?? 120)} /></label>
        <label class="nb-o"><span>{t.giuBan}</span>
          <small>{t.giuBanPhu}</small>
          <input type="text" name="giu_ban_phut" inputmode="numeric"
                 value={String(chiNhanh?.giu_ban_phut ?? 15)} /></label>
      </div>

      <button type="submit" class="nb-nut" style="width:100%">
        {chiNhanh ? t.luuCN : t.taoCN}
      </button>
    </form>
  )}

  {/* ---------------------------------------------------------------- */}
  {chiNhanh && (
    <>
      <h2>{t.banAn}</h2>

      {dangDung.length === 0 ? (
        <div class="nb-bao luu-y">
          <p style="margin:0">
            <strong>{t.chuaBan1}</strong>{t.chuaBan2}<em>{t.hetBan}</em>{t.chuaBan3}<code>/dat-ban</code>{t.chuaBan4}
          </p>
        </div>
      ) : (
        <p class="nb-dan">
          <strong>{t.soBan(dangDung.length)}</strong>{t.dangDung}
          <strong>{t.soCho(tongCho)}</strong> ·
          {dangDung.filter(b => b.la_phong_rieng).length > 0 &&
            <>{t.phongRieng(dangDung.filter(b => b.la_phong_rieng).length)}</>}
          {ban.length - dangDung.length > 0
            ? <>{t.banNgung(ban.length - dangDung.length)}</>
            : <>{t.khongNgung}</>}
        </p>
      )}

      <div class="nb-the">
        <h3 style="font-size:1rem;margin-top:0">{t.themNhieu}</h3>
        <p class="nb-dan" style="font-size:.85rem">{t.themNhieuPhu}</p>
        <form method="POST">
          <input type="hidden" name="viec" value="them_nhieu" />
          <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(7rem,1fr))">
            <label class="nb-o"><span>{t.tienTo}</span>
              <input type="text" name="tien_to" value="B" maxlength="6" autocapitalize="characters" /></label>
            <label class="nb-o"><span>{t.tuSo}</span>
              <input type="text" name="tu" value="1" inputmode="numeric" /></label>
            <label class="nb-o"><span>{t.denSo}</span>
              <input type="text" name="den" value="10" inputmode="numeric" /></label>
            <label class="nb-o"><span>{t.moiBan}</span>
              <input type="text" name="so_cho" value="4" inputmode="numeric" /></label>
          </div>
          <label class="nb-o-chon-cd">
            <input type="checkbox" name="la_phong_rieng" value="co" />
            <span>{t.laPhong}</span>
          </label>
          <button type="submit" class="nb-nut" style="width:100%">{t.themLoat}</button>
        </form>
      </div>

      <details class="nb-the">
        <summary style="cursor:pointer;font-weight:600">{t.themMot}</summary>
        <form method="POST" style="margin-top:1rem">
          <input type="hidden" name="viec" value="them_mot" />
          <div style="display:grid;gap:.75rem;grid-template-columns:1fr 1fr">
            <label class="nb-o"><span>{t.tenBan}</span>
              <input type="text" name="ten" required placeholder={t.tenBanVD} /></label>
            <label class="nb-o"><span>{t.soChoO}</span>
              <input type="text" name="so_cho" value="4" inputmode="numeric" /></label>
          </div>
          <label class="nb-o-chon-cd">
            <input type="checkbox" name="la_phong_rieng" value="co" />
            <span>{t.laPhong}</span>
          </label>
          <button type="submit" class="nb-nut phu" style="width:100%">{t.themBan}</button>
        </form>
      </details>

      {ban.length > 0 && (
        <div class="nb-the">
          <h3 style="font-size:1rem;margin-top:0">{t.dsBan}</h3>
          <div class="nb-luoi-ban">
            {ban.map(b => (
              <div class={`nb-o-ban ${b.dang_dung ? '' : 'tat'}`}>
                <strong>{b.ten}</strong>
                <span>{t.choCua(b.so_cho)}{b.la_phong_rieng ? t.rieng : ''}</span>
                <form method="POST" class="nb-ban-nut">
                  <input type="hidden" name="id" value={b.id} />
                  {b.dang_dung
                    ? <button type="submit" name="viec" value="ngung" class="nb-nut-nho-sang">{t.ngungDung}</button>
                    : <button type="submit" name="viec" value="dung_lai" class="nb-nut-nho-sang">{t.dungLai}</button>}
                  <button type="submit" name="viec" value="xoa" class="nb-nut-nho-sang xoa">{t.xoa}</button>
                </form>
              </div>
            ))}
          </div>
          <p class="nb-dan" style="font-size:.85rem;margin:1rem 0 0">
            <strong>{t.ngungPhu1}</strong>{t.ngungPhu2}<strong>{t.ngungPhu3}</strong>{t.ngungPhu4}
          </p>
        </div>
      )}
    </>
  )}

  {/* ---------------------------------------------------------------- */}
  <h2>{t.donDL}</h2>
  <p class="nb-dan">
    {t.donPhu1}<strong>{t.donPhu2}</strong>{t.donPhu3}
  </p>

  {VIEC_DON.map(v => (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="don" />
      <input type="hidden" name="ham" value={v.ham} />
      <div class="nb-cong-tac">
        <div class="nb-cong-tac-chu">
          <strong>{v.ten[nn]}</strong>
          <p>{v.giai_thich[nn]}</p>
          <p><code>{v.ham}()</code></p>
        </div>
      </div>
      {v.chi_chu_so_huu && !laChu ? (
        <p class="nb-dan" style="margin:.75rem 0 0;font-size:.85rem">{t.chiChuChay}</p>
      ) : (
        <button type="submit" class="nb-nut phu" style="margin-top:.85rem">{t.chayNgay}</button>
      )}
    </form>
  ))}

  {/* ---------------------------------------------------------------- */}
  <h2>{t.supabase}</h2>
  <div class="nb-the">
    <p style="margin-top:0">{t.supabase1}</p>
    <ul style="margin:0;padding-left:1.2rem;font-size:.92rem;line-height:1.8">
      <li>
        <strong>{t.taoTK}</strong>{t.taoTK1}<code>auth_uid</code>{t.taoTK2}<code>nhan_su</code>{t.taoTK3}
      </li>
      <li>
        <strong>{t.taiAnh}</strong>{t.taiAnh1}
      </li>
    </ul>
  </div>
</NoiBo>

