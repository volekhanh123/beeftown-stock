---
/**
 * SỬA MỘT SẢN PHẨM BÁN LẺ
 *
 * Tên, mô tả, cách dùng (bản tiếng Anh và tiếng Hàn máy dịch, sửa tay được), bảo quản, trạng thái, kênh,
 * cách bán; thịt theo cân: mặt hàng kho, giá mỗi kg (ĐÚNG ô gia_ban_kg của Kho → Mặt hàng — đổi cho mọi chi
 * nhánh, Beeftown Cân gửi xuống cân), cách làm gói, các gói online; kim chi theo hộp: các cỡ hộp. Quyền do
 * database quyết định — xem đầu lib/ban-le-noi-bo.ts.
 *
 * BA FORM TÁCH NHAU: sửa (nút Lưu là nút submit đầu tiên — một cú Enter trong ô chữ chỉ lưu), dịch ngay,
 * xác nhận giá (chỉ chủ, ngoài fieldset của form sửa, gửi kèm đúng những giá trang đang hiện).
 *
 * GHI ĐƯỢC THÌ CHUYỂN HƯỚNG 303 về chính trang này (lib/gui-noi-bo.ts): F5 không lưu lại bản cũ. Không ghi
 * được thì dựng lại trang ngay với đúng chữ đã gõ — nhưng mọi ô ẩn phiên bản (phien_ban, gia_ban_kg_cu,
 * goc_…, …_cu) LUÔN lấy từ lần đọc mới, không bao giờ từ chữ đã gõ: lấy từ chữ đã gõ thì lần lưu sau vấp
 * lại đúng lỗi cũ mãi. Ô dịch và ô giá mỗi kg người dùng KHÔNG sửa thì hiện giá trị mới đọc (máy dịch hay
 * người ở Kho vừa đổi), để lần lưu sau không lặng lẽ ghi đè bằng chữ cũ.
 *
 * Lưu xong thì dịch nền đúng sản phẩm này (chayNen) — lib/ban-dich.ts không cần đổi gì: nó đọc v_viec_dich
 * theo bảng, và 0099 đã nối ban_le_san_pham vào đó.
 */
import NoiBo from '../../../layouts/NoiBo.astro';
import {
  docSanPham, docMatHangChon, docCaiDat, luuSanPham, chotGia, chonChiNhanhBanLe, dongGoiDaGo, cauLoiDoc, cauCanhBao, giaGoi,
  cungChu, canhBaoDauTrang, dongGiaDeChot, tenKieu,
  VAI_XEM_BAN_LE, VAI_SUA_BAN_LE, VAI_CHOT_GIA, KIEU_SAN_PHAM, CANH_BAO_BAN_LE, TEN_LOAI_BAN_LE,
  TEN_BAO_QUAN, TRANG_THAI_BAN_LE, NGUON_GOI, O_DICH_BAN_LE, SO_GOI_TOI_DA,
  type SanPhamBanLe, type MatHangBanLe, type ChiNhanhBanLe, type GoiBanLe, type KetQuaLuu, type DongGoiDaGo,
} from '../../../lib/ban-le-noi-bo';
import { dichBu, chayNen, oDangCho, moTaO, cauTomTat } from '../../../lib/ban-dich';
import { dichNB, nnCua } from '../../../lib/ngon-ngu-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, docBaoNoiBo, docFormNoiBo } from '../../../lib/gui-noi-bo';
import { dinhDangKg, dinhDangTien, dinhDangThoiDiem, docTien, duoc, TEN_LOAI_MAT_HANG_NB } from '../../../lib/kho/chung';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const nn = nnCua(Astro);
// Vai kho không đọc được menu (RLS): về /noi-bo, trang đó đưa họ sang kho.
if (!(VAI_XEM_BAN_LE as readonly string[]).includes(nhanSu.vai_tro)) return Astro.redirect('/noi-bo', 302);

const t = dichNB(nn, {
  tieuDe:      { vi: 'Sản phẩm bán lẻ', en: 'Retail product' },
  tatCa:       { vi: '← Menu bán lẻ', en: '← Retail menu' },
  khongThay:   { vi: 'Không thấy sản phẩm này, hoặc tài khoản của bạn không xem được.', en: 'This product was not found, or your account cannot view it.' },
  viecSai:     { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
  dangDich:    { vi: (cau: string) => `${cau} Bản tiếng Anh và tiếng Hàn đang được dịch — tải lại trang sau ít giây để xem.`,
                 en: (cau: string) => `${cau} The English and Korean versions are being translated — reload in a few seconds to see them.` },
  chiDoc:      { vi: 'Chỉ chủ và quản lý sửa được menu bán lẻ, kể cả mô tả.', en: 'Only the owner and managers can edit the retail menu, including descriptions.' },
  ma:          { vi: 'Mã', en: 'Code' },
  loai:        { vi: 'Loại', en: 'Type' },
  oQuay:       { vi: 'Ở quầy', en: 'At the counter' },
  tonKg:       { vi: (kg: string) => `${kg} kg`, en: (kg: string) => `${kg} kg` },
  tonHop:      { vi: (n: number) => `${n} hộp`, en: (n: number) => `${n} boxes` },
  chuaTru:     { vi: '(theo sổ kho — quầy chưa trừ theo FABi)', en: '(from the stock books — the counter is not deducted from FABi yet)' },
  thieuGia:    { vi: 'Thiếu giá', en: 'No price' },
  giaThuNhan:  { vi: 'Giá thử', en: 'Trial price' },
  daChotNhan:  { vi: 'Đã chốt giá', en: 'Price confirmed' },
  // Cho khách xem
  khachXem:    { vi: 'Cho khách xem', en: 'What customers see' },
  tenSp:       { vi: 'Tên sản phẩm', en: 'Product name (in Vietnamese)' },
  moTa:        { vi: 'Mô tả ngắn', en: 'Short description (in Vietnamese)' },
  cachDung:    { vi: 'Cách dùng, cách nướng', en: 'How to use or grill (in Vietnamese)' },
  cachDungHop: { vi: 'Cách dùng, bảo quản', en: 'How to use and store (in Vietnamese)' },
