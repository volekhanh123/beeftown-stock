---
/**
 * KHO — VIỆC CẦN LÀM
 *
 * Chỉ những thứ PHẢI làm, mỗi dòng một nút làm ngay: việc của mình bị trả về,
 * hàng hết hạn phải hủy, hàng sắp hết hạn, quầy sắp hết, quầy chưa đếm, chứng
 * từ chờ duyệt (nếu có quyền duyệt), nợ đến hạn (kế toán). Dòng "để biết" nằm
 * ở trang Thông báo.
 *
 * NV quầy chỉ thấy việc ở quầy — database đã lọc (0030).
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import DongSuKien from '../../../components/kho/DongSuKien.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import { docThongBao } from '../../../lib/kho/thong-bao.ts';
import { cauSuKien, laViec, type SuKien } from '../../../lib/kho/viec.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;

let suKien: SuKien[] = [];
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  const r = await docThongBao(k.client, k.chiNhanh.id, 300, k.nn);
  suKien = r.suKien.filter(laViec);
  loiDoc = r.loi ?? loiDoc;
}
// Cũ nhất lên trước: việc tồn lâu nhất làm trước.
const ngay = suKien.filter(e => cauSuKien(e).muc === 'do').sort((a, b) => a.luc.localeCompare(b.luc));
const som = suKien.filter(e => cauSuKien(e).muc === 'vang').sort((a, b) => a.luc.localeCompare(b.luc));
const t = dichNB(k.nn, {
  tieuDe: { vi: 'Việc cần làm', en: 'To-do' },
  khongCo: { vi: 'Không có việc gì đang chờ. Tốt lắm!', en: 'Nothing is waiting. Well done!' },
  lamNgay: { vi: 'Làm ngay', en: 'Do now' },
  nenLamSom: { vi: 'Nên làm sớm', en: 'Do soon' },
});
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="viec-can-lam">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {ngay.length + som.length === 0 ? (
    <p class="nb-rong">{t.khongCo}</p>
  ) : (
    <>
      {ngay.length > 0 && (
        <>
          <h2>{t.lamNgay} · {ngay.length}</h2>
          <ul class="kho-sk-ds">{ngay.map(e => <DongSuKien e={e} />)}</ul>
        </>
      )}
      {som.length > 0 && (
        <>
          <h2>{t.nenLamSom} · {som.length}</h2>
          <ul class="kho-sk-ds">{som.map(e => <DongSuKien e={e} />)}</ul>
        </>
      )}
    </>
  )}
</Kho>
