---
/**
 * KHO — THÔNG BÁO (chuông)
 *
 * Giống trung tâm thông báo của iPOS: ba thẻ Vận hành / Nhắc nhở / Hệ thống.
 * Mở trang này = đã đọc mọi thứ tới lúc này; dòng mới vẫn có chấm đen ở biểu
 * tượng và chữ "mới" cho lần xem này để biết dòng nào vừa tới.
 *
 * Sự kiện không lưu thành bảng — database suy ra từ chứng từ (0030), câu chữ ở
 * lib/kho/viec.ts. Từ 22/10/2026: chỉ NGAY_CHUONG (7) ngày gần nhất, sự kiện cùng loại từ 3 cái trở
 * lên gom một dòng (gomSuKien) — số đỏ trên chuông đếm đúng số dòng có tin chưa đọc (migration 0092).
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import DongSuKien from '../../../components/kho/DongSuKien.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import { docThongBao, daXemThongBao } from '../../../lib/kho/thong-bao.ts';
import { TEN_NHOM_NB, NGAY_CHUONG, gomSuKien, type NhomSuKien, type SuKien } from '../../../lib/kho/viec.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;

const NHOM: NhomSuKien[] = ['van_hanh', 'nhac_nho', 'he_thong'];
const chon = NHOM.includes(Astro.url.searchParams.get('nhom') as NhomSuKien)
  ? Astro.url.searchParams.get('nhom') as NhomSuKien : null;

let suKien: SuKien[] = [];
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  // 300 = tối đa của kho_thong_bao; số chuông (0092 chua_doc) đếm đúng 300 sự kiện mới nhất này.
  const r = await docThongBao(k.client, k.chiNhanh.id, 300, k.nn);
  // Cùng mốc với database (0092): luc trong NGAY_CHUONG ngày tới bây giờ.
  const tu = Date.now() - NGAY_CHUONG * 86400000;
  suKien = r.suKien.filter(e => { const t = new Date(e.luc).getTime(); return t >= tu && t <= Date.now(); });
  loiDoc = r.loi ?? loiDoc;
  if (!r.loi) {
    await daXemThongBao(k.client, k.chiNhanh.id);
    if (k.viec) k.viec.chua_doc = 0;   // chuông trên đầu trang hết số đỏ ngay lần này
  }
}
// Mới nhất lên trước. Số trên thẻ là số dòng (đã gom), như số trên chuông.
const gom = (ds: SuKien[]) => gomSuKien(ds, k.nn).sort((a, b) => b.moiNhat.localeCompare(a.moiNhat));
const dem = (n: NhomSuKien) => gom(suKien.filter(e => e.nhom === n)).length;
const tatCa = gom(suKien);
const hien = chon ? gom(suKien.filter(e => e.nhom === chon)) : tatCa;
const t = dichNB(k.nn, {
  tieuDe: { vi: 'Thông báo', en: 'Notifications' },
  loc: { vi: 'Lọc thông báo', en: 'Filter notifications' },
  tatCa: { vi: 'Tất cả', en: 'All' },
  khongCo: { vi: `Không có thông báo nào trong ${NGAY_CHUONG} ngày qua.`, en: `No notifications in the last ${NGAY_CHUONG} days.` },
});
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="thong-bao">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  <nav class="kho-the-chon" aria-label={t.loc}>
    <a href="/noi-bo/kho/thong-bao" aria-current={chon === null ? 'page' : undefined}>{t.tatCa} · {tatCa.length}</a>
    {NHOM.map(n => (
      <a href={`/noi-bo/kho/thong-bao?nhom=${n}`} aria-current={chon === n ? 'page' : undefined}>{TEN_NHOM_NB[n][k.nn]} · {dem(n)}</a>
    ))}
  </nav>

  {hien.length === 0 ? (
    <p class="nb-rong">{t.khongCo}</p>
  ) : (
    <ul class="kho-sk-ds">
      {hien.map(d => <DongSuKien d={d} hienChuaDoc moc="moi" />)}
    </ul>
  )}
</Kho>
