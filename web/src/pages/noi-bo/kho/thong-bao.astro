---
/**
 * KHO — THÔNG BÁO (chuông)
 *
 * Giống trung tâm thông báo của iPOS: ba thẻ Vận hành / Nhắc nhở / Hệ thống.
 * Mở trang này = đã đọc mọi thứ tới lúc này; dòng mới vẫn được tô nền cho lần
 * xem này để biết dòng nào vừa tới.
 *
 * Sự kiện không lưu thành bảng — database suy ra từ chứng từ (0030), câu chữ ở
 * lib/kho/viec.ts. 30 ngày gần nhất.
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import DongSuKien from '../../../components/kho/DongSuKien.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import { docThongBao, daXemThongBao } from '../../../lib/kho/thong-bao.ts';
import { TEN_NHOM, type NhomSuKien, type SuKien } from '../../../lib/kho/viec.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;

const NHOM: NhomSuKien[] = ['van_hanh', 'nhac_nho', 'he_thong'];
const chon = NHOM.includes(Astro.url.searchParams.get('nhom') as NhomSuKien)
  ? Astro.url.searchParams.get('nhom') as NhomSuKien : null;

let suKien: SuKien[] = [];
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  const r = await docThongBao(k.client, k.chiNhanh.id, 200);
  suKien = r.suKien;
  loiDoc = r.loi ?? loiDoc;
  if (!r.loi) {
    await daXemThongBao(k.client, k.chiNhanh.id);
    if (k.viec) k.viec.chua_doc = 0;   // chuông trên đầu trang hết số đỏ ngay lần này
  }
}
const dem = (n: NhomSuKien) => suKien.filter(e => e.nhom === n).length;
const hien = chon ? suKien.filter(e => e.nhom === chon) : suKien;
---
<Kho k={k} tieuDe="Thông báo" huongDan="thong-bao">
  <h1>Thông báo</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  <nav class="kho-the-chon" aria-label="Lọc thông báo">
    <a href="/noi-bo/kho/thong-bao" aria-current={chon === null ? 'page' : undefined}>Tất cả · {suKien.length}</a>
    {NHOM.map(n => (
      <a href={`/noi-bo/kho/thong-bao?nhom=${n}`} aria-current={chon === n ? 'page' : undefined}>{TEN_NHOM[n]} · {dem(n)}</a>
    ))}
  </nav>

  {hien.length === 0 ? (
    <p class="nb-rong">Không có thông báo nào trong 30 ngày qua.</p>
  ) : (
    <ul class="kho-sk-ds">
      {hien.map(e => <DongSuKien e={e} hienChuaDoc />)}
    </ul>
  )}
</Kho>
