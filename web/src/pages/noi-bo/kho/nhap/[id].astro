  ]);
  if (!moi) {
    const doc = await docPhieuNhap(k.client, idThamSo);
    if (doc) { phieu = doc.phieu; dongDb = doc.dong; maLo = doc.maLo; }
  }
} catch (e) {
  loiDoc = cauLoiKho(e, t.khongDoc);
}

if (!moi && !phieu && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/nhap', kqHai(false, { vi: 'Không tìm thấy phiếu nhập này.', en: 'This goods receipt was not found.' }));
}
// Nợ đầu kỳ (ND-, 0035) không có hàng, không có trang phiếu nhập: xem ở Công nợ.
if (phieu && (phieu.loai as string) === 'no_dau') {
  return Astro.redirect(phieu.nha_cung_cap_id ? `/noi-bo/kho/cong-no/${phieu.nha_cung_cap_id}#p-${phieu.id}` : '/noi-bo/kho/cong-no/no-dau', 302);
}

const loai: 'mua' | 'ton_dau' = phieu?.loai
  ?? (Astro.url.searchParams.get('loai') === 'ton_dau' ? 'ton_dau' : 'mua');
const laNguoiTao = !!phieu?.nguoi_tao && phieu.nguoi_tao === k.nhanSu.id;
const conNhap = phieu?.trang_thai === 'nhap' || phieu?.trang_thai === 'tu_choi';
const coTheSoan = k.duoc('nhap') && (moi || conNhap);
// ?soan=1: người duyệt (có quyền nhap) muốn sửa cả dòng hàng, số kg.
const muonSoan = Astro.url.searchParams.get('soan') === '1';
// Điền giá: phiếu chờ duyệt; hoặc nháp / bị trả mà người xem không phải
// người lập (kế toán không lập phiếu; quản lý mở phiếu thủ kho gửi).
const dienGiaDuoc = !!phieu && k.duoc('duyet_nhap')
  && (phieu.trang_thai === 'cho_duyet' || (conNhap && !(coTheSoan && (laNguoiTao || muonSoan))));
const soanDuoc = coTheSoan && !dienGiaDuoc;

// ---------------------------------------------------------------------------
// Xử lý lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
let dauForm: DauForm | null = null;
let dongForm: DongForm[] | null = null;
// Khi chưa lưu được: giữ ma_gui cũ và các ảnh form này đã tải lên.
let maGuiGiu: string | null = null;
let anhDaTai: string[] = [];
let anhGiuForm: string[] | null = null;
// Điền giá chưa lưu được: hiện lại đúng chữ đã gõ.
let giaForm: DienGiaForm | null = null;

const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = kqHai(false, {
    vi: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.',
    en: 'Could not read what was sent — the connection may have dropped. Please send again.',
  });
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  const ve = (id: string, kq: KetQua, them = '') =>
    chuyenHuong(Astro, `/noi-bo/kho/nhap/${id}${them || (muonSoan ? '?soan=1' : '')}`, kq);

  if (['luu', 'them_dong', 'gui'].includes(viec)) {
    if (!soanDuoc) {
      bao = kqHai(false, {
        vi: 'Phiếu không còn sửa được (đã gửi duyệt, đã duyệt hoặc đã hủy).',
        en: 'This receipt can no longer be edited (sent for approval, approved or cancelled).',
      });
    } else {
      const kq = await luuPhieuNhap(k.client, cn.id, form, {
        id: phieu?.id ?? null,
        phienBan: phieu ? Number(form.get('phien_ban')) : null,
        loai,
        anhCu: phieu?.anh ?? [],
        dinhNghiaPhieu: dnPhieu,
        dinhNghiaLo: dnLo,
        truongThemCu: { phieu: phieu?.truong_them, dong: dongDb.map(d => d.truong_them) },
      });
      if (!kq.ok || !kq.id) {
        bao = kq;
        dauForm = kq.dau ?? null;
        dongForm = kq.dong ?? null;
        maGuiGiu = kq.maGui ?? null;
        anhDaTai = kq.anhDaTai ?? [];
        anhGiuForm = kq.anhGiu ?? null;
      } else if (viec === 'gui') {
        const gui = await guiDuyet(k.client, kq.id, kq.phienBan ?? null);
        return ve(kq.id, gui.ok ? gui : kqHai(false, {
          vi: `Đã lưu nháp nhưng CHƯA gửi duyệt được: ${gui.cau}`,
          en: `Draft saved but NOT sent for approval: ${enCua(gui)}`,
        }));
      } else if (viec === 'them_dong') {
        // Số dòng đã lưu + 3 dòng trống ở cuối.
        const them = Math.min((kq.soDong ?? 0) + 3, 60);
        return ve(kq.id, kqHai(true, {
          vi: `${kq.cau} Thêm dòng ở cuối phiếu.`,
          en: `${enCua(kq)} Add lines at the end of the receipt.`,
        }), `?dong=${them}${muonSoan ? '&soan=1' : ''}`);
      } else {
        return ve(kq.id, kq);
      }
    }
  } else if (phieu && (viec === 'luu_gia' || viec === 'duyet')) {
    // Điền giá — "Duyệt" = lưu giá đang gõ rồi duyệt ngay, một lần bấm.
    if (!dienGiaDuoc && viec === 'duyet' && phieu.trang_thai === 'da_duyet') {
      // Bấm "Duyệt" hai lần (mạng chậm): lần đầu đã duyệt xong — không báo lỗi giả.
      return chuyenHuong(Astro, '/noi-bo/kho/duyet', kqHai(true, {
        vi: `Phiếu ${phieu.so_phieu} đã được duyệt trước đó.`,
        en: `Receipt ${phieu.so_phieu} was already approved.`,
      }));
    } else if (!dienGiaDuoc) {
      bao = kqHai(false, {
        vi: 'Phiếu không còn điền giá được (đã duyệt hoặc đã hủy), hoặc tài khoản không được duyệt phiếu nhập.',
        en: 'Prices can no longer be filled in on this receipt (approved or cancelled), or your account cannot approve goods receipts.',
      });
    } else {
      const docGia = docFormDienGia(form, dongDb, phieu.loai);
      const luu = await dienGiaPhieu(k.client, phieu.id, Number(form.get('phien_ban')), docGia);
      if (!luu.ok) {
        bao = luu;
        giaForm = docGia.giaTri;
      } else if (viec === 'luu_gia') {
        return ve(phieu.id, luu);
      } else {
        const kq = await duyetPhieu(k.client, phieu.id);
        // Duyệt xong: về trang Duyệt — còn phiếu nào chờ thì hiện ở đó.
        if (kq.ok) return chuyenHuong(Astro, '/noi-bo/kho/duyet', kq);
        return ve(phieu.id, kqHai(false, {
          vi: `Đã lưu giá nhưng CHƯA duyệt được: ${kq.cau}`,
          en: `Prices saved but NOT approved: ${enCua(kq)}`,
        }));
      }
    }
  } else if (phieu) {
    let kq: KetQua;
    const lyDo = String(form.get('ly_do') ?? '').trim();
    if (viec === 'rut') {
      kq = laNguoiTao ? await rutPhieu(k.client, phieu.id)
        : kqHai(false, {
          vi: 'Chỉ người lập phiếu mới rút về được. Người duyệt muốn trả lại thì bấm "Từ chối" và ghi lý do.',
          en: 'Only the person who made the receipt can take it back. To send it back as the approver, press "Reject" and give a reason.',
        });
    } else if (viec === 'tu_choi') kq = await tuChoiPhieu(k.client, phieu.id, lyDo);
    else if (viec === 'huy') kq = await huyPhieu(k.client, phieu.id, lyDo || null);
    else kq = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
    // Từ chối xong: về trang Duyệt — còn phiếu nào chờ thì hiện ở đó.
    if (kq.ok && viec === 'tu_choi') return chuyenHuong(Astro, '/noi-bo/kho/duyet', kq);
    return ve(phieu.id, kq);
  } else {
    bao = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const dau: DauForm = dauForm ?? (phieu ? dauTuPhieu(phieu) : {
  nha_cung_cap_id: '',
  vi_tri_id: loai === 'ton_dau'
    ? (viTri.find(v => v.loai === 'quay' && v.dang_dung)?.id ?? '')
    : (caiDat?.vi_tri_nhan_hang_id ?? viTri.find(v => v.loai === 'kho' && v.dang_dung)?.id ?? ''),
  ngay_nhap: homNayVn(), so_hoa_don: '', ngay_hoa_don: '', han_thanh_toan: '',
  tien_thue: '', chi_phi_khac: '', ghi_chu: '', truong_them: {},
});
const soDongMuon = Math.min(Math.max(Number(Astro.url.searchParams.get('dong') ?? 0) || 0, 0), 60);
const dongCo: DongForm[] = dongForm ?? dongTuPhieu(dongDb);
// Phiếu mới: 2 dòng trống (trang ngắn trên điện thoại). Đã có dòng: thêm 1.
// Cần nhiều hơn thì "Lưu + thêm dòng".
const soTrong = Math.max(dongCo.length === 0 ? 2 : 1, soDongMuon - dongCo.length);
const dongHien: DongForm[] = soanDuoc ? [...dongCo, ...Array.from({ length: soTrong }, dongTrong)] : dongCo;

// Chưa lưu được thì dùng lại ma_gui cũ: ảnh đã tải nằm trong thư mục của mã đó.
const maGuiForm = maGuiGiu ?? crypto.randomUUID();
const tenMh = new Map(matHang.map(m => [m.id, m]));
const viTriNhan = viTri.filter(v => v.loai !== 'cho_huy' && v.loai !== 'dang_chuyen' && (v.dang_dung || v.id === dau.vi_tri_id));
const nccChon = ncc.filter(n => n.dang_dung || n.id === dau.nha_cung_cap_id);
const ten = phieu ? await tenNhanSu(k.client, [phieu.nguoi_tao, phieu.nguoi_gui, phieu.nguoi_duyet, phieu.nguoi_huy]) : new Map();
// Ảnh trên form soạn: ảnh cũ của phiếu + ảnh vừa tải lên nhưng phiếu chưa lưu được.
const anhForm: string[] = [...(phieu?.anh ?? []), ...anhDaTai.filter(a => !phieu?.anh.includes(a))];
const giuAnh = (a: string) => (anhGiuForm ? anhGiuForm.includes(a) : true);
const soAnhGiu = anhForm.filter(giuAnh).length;
const anhLink = await linkAnh(k.client, anhForm);
const nhanTrangThai = (tt: string): [string, string] => {
  const [nhan, lop] = trangThaiKho(tt, nn);
  return [nhan, lop || 'tat'];
};
const [nhanTT, lopTT] = phieu ? nhanTrangThai(phieu.trang_thai) : [t.moi, 'nhap'];

const congNo = phieu && phieu.loai === 'mua' && phieu.trang_thai === 'da_duyet' ? await docCongNoMotPhieu(k.client, phieu.id) : null;
const tienHang = dongDb.reduce((s, d) => s + d.thanh_tien, 0);
const tongTien = phieu ? tienHang + phieu.tien_thue + phieu.chi_phi_khac : 0;
const giaVon = phieu && (dienGiaDuoc || phieu.trang_thai === 'cho_duyet') ? xemTruocGiaVon(dongDb, phieu.chi_phi_khac, phieu.tien_thue, caiDat) : [];
const tieuDe = moi ? (loai === 'ton_dau' ? t.tdTonDau : t.tdLap) : t.tdPhieu(phieu?.so_phieu ?? '');
const choToiDuyet = dienGiaDuoc && phieu?.trang_thai === 'cho_duyet';

// Điền giá: so với lần nhập trước (theo giá ĐÃ LƯU) và ngưỡng cảnh báo.
let soSanh = new Map<string, SoSanhGia>();
let nguongGia = 5;
if (dienGiaDuoc && phieu) {
  try {
    [soSanh, nguongGia] = await Promise.all([docSoSanhGia(k.client, phieu.id), docNguongGiaMua(k.client, cn.id)]);
  } catch {
    // Không so được giá thì vẫn điền giá, duyệt được — chỉ mất chip so sánh.
  }
}
const gf: DienGiaForm | null = dienGiaDuoc && phieu ? (giaForm ?? dienGiaTuPhieu(phieu, dongDb)) : null;
const canhBaoGia = cauCanhBaoGia(soSanh.values(), nguongGia, nn);
// Thành tiền tạm tính theo chữ đang ở ô đơn giá (không JavaScript: bấm Lưu giá để tính lại).
const thanhTienTam = (d: DongPhieuNhap) => {
  const g = docTien(gf?.gia[d.id]);
  return g !== null && !Number.isNaN(g) ? Math.round(g * d.so_kg) : null;
};
const tienHangTam = dongDb.reduce((s, d) => s + (thanhTienTam(d) ?? 0), 0);
const tienThem = (v: string | undefined) => { const n = docTien(v); return n !== null && !Number.isNaN(n) ? n : 0; };
const tongTam = tienHangTam + (loai === 'mua' ? tienThem(gf?.tien_thue) + tienThem(gf?.chi_phi_khac) : 0);
const soDongThieuGia = dongDb.filter(d => !thanhTienTam(d)).length;
const tien = (x: number | null | undefined) => dinhDangTien(x, nn);
const kgs = (x: number | null | undefined) => dinhDangKg(x, nn);

// Link quay lại: từ trang Duyệt (?tu=duyet) hoặc đang có phiếu chờ mình duyệt
// thì về trang Duyệt — không mất hàng đợi.
const [linkVe, chuVe] = Astro.url.searchParams.get('tu') === 'duyet' || choToiDuyet
  ? ['/noi-bo/kho/duyet', t.veDuyet]
  : ['/noi-bo/kho/nhap', t.veDs];
const huongDan = 'duyet-nhap';
---
<Kho k={k} tieuDe={tieuDe} huongDan={huongDan}>
  <h1>{tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  {phieu && (
    <>
      <InDau tieuDe={phieu.loai === 'ton_dau' ? t.inTonDau : t.inNhapKho}
        soPhieu={phieu.so_phieu} chiNhanh={k.chiNhanh?.ten} />
      <NutIn />
    </>
  )}

  {phieu && (
    <p class="nb-dan">
      <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
      {phieu.loai === 'ton_dau' && <>{t.tonDau}</>} · {t.lapBoi} {ten.get(phieu.nguoi_tao ?? '') ?? '—'} {t.luc} {dinhDangThoiDiem(phieu.created_at)}
      {phieu.gui_luc && <> · {t.guiDuyetLuc} {dinhDangThoiDiem(phieu.gui_luc)}</>}
      {phieu.duyet_luc && phieu.trang_thai !== 'nhap' && <> · {phieu.trang_thai === 'tu_choi' ? t.tuChoiBoi : t.duyetBoi} {ten.get(phieu.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(phieu.duyet_luc)}</>}
      {phieu.huy_luc && <> · {t.huyBoi} {ten.get(phieu.nguoi_huy ?? '') ?? '—'} {dinhDangThoiDiem(phieu.huy_luc)}</>}
    </p>
  )}
  {phieu?.ly_do && (phieu.trang_thai === 'tu_choi' || phieu.trang_thai === 'da_huy') && (
    <div class="nb-bao luu-y"><p><strong>{phieu.trang_thai === 'tu_choi' ? t.lyDoTuChoi : t.lyDoHuy}:</strong> {phieu.ly_do}</p></div>
  )}

  {soanDuoc ? (
    // =====================================================================
    // CHẾ ĐỘ SOẠN
    // =====================================================================
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="ma_gui" value={maGuiForm} />
      {phieu && <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />}
      <input type="hidden" name="so_dong" value={String(dongHien.length)} />

      <div class="nb-the">
        <div class="nb-o">
          <span>{loai === 'mua' ? t.anhMua : t.anhTuyY}</span>
          {soAnhGiu > 0 ? (
            <small><strong>{t.daCoAnh(soAnhGiu)}</strong> {t.khongChupLai}</small>
          ) : (
            <small>{t.chupNgay}</small>
          )}
          {anhForm.length > 0 && (
            <div class="kho-anh">
              {anhForm.map(a => (
                <label>
                  {anhLink.get(a)
                    ? <a href={anhLink.get(a)} target="_blank" rel="noopener">{a.endsWith('.pdf')
                        ? <span style="display:flex;height:100%;align-items:center;justify-content:center;font-weight:700">PDF</span>
                        : <img src={anhLink.get(a)} alt={t.anhChungTu} loading="lazy" />}</a>
                    : <span>{a.split('/').pop()}</span>}
                  <span style="display:flex;align-items:center;gap:.4rem;min-height:48px;font-size:.9rem">
                    <input type="checkbox" name="anh_giu" value={a} checked={giuAnh(a)}
                      style="width:22px;height:22px;min-height:0;padding:0;margin:0;accent-color:var(--do)" /> {t.giu}
                  </span>
                  {anhDaTai.includes(a) && <input type="hidden" name="anh_da_tai" value={a} />}
                </label>
              ))}
            </div>
          )}
          <input type="file" name="anh" accept="image/*,application/pdf" multiple
            aria-label={soAnhGiu > 0 ? t.themAnh : t.chupHoacChon} />
        </div>

        {loai === 'mua' ? (
          <label class="nb-o">
            <span>{t.nccBatBuoc}</span>
            {nccChon.length === 0 && <small>{t.chuaCoNcc} {k.duoc('ncc') ? <a href="/noi-bo/kho/cai-dat/nha-cung-cap">{t.themNcc}</a> : t.nhoQuanLy}</small>}
            <select name="nha_cung_cap_id">
              <option value="">{t.chonNcc}</option>
              {nccChon.map(n => <option value={n.id} selected={n.id === dau.nha_cung_cap_id}>{n.ten}{n.so_ngay_no ? t.noNgay(n.so_ngay_no) : ''}</option>)}
            </select>
          </label>
        ) : (
          <p class="nb-dan" style="font-size:.88rem">
            {t.tdSoan1} <strong>{t.tdSoan2}</strong> {t.tdSoan3} <strong>{t.tdSoan4}</strong> {t.tdSoan5}
          </p>
        )}

        <div class="kho-luoi">
          <label class="nb-o">
            <span>{t.nhanVao}</span>
            <select name="vi_tri_id">
              {viTriNhan.map(v => <option value={v.id} selected={v.id === dau.vi_tri_id}>{v.ten}</option>)}
            </select>
          </label>
          <label class="nb-o">
            <span>{t.ngayNhap}</span>
            <input type="date" name="ngay_nhap" value={dau.ngay_nhap} max={homNayVn()} required />
          </label>
        </div>

        {loai === 'mua' && (
          <>
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.soHoaDon}</span>
                <input type="text" name="so_hoa_don" value={dau.so_hoa_don} autocapitalize="characters" /></label>
              <label class="nb-o"><span>{t.ngayHoaDon}</span>
                <input type="date" name="ngay_hoa_don" value={dau.ngay_hoa_don} /></label>
              <label class="nb-o"><span>{t.hanThanhToan}</span>
                <small>{t.boTrongHan}</small>
                <input type="date" name="han_thanh_toan" value={dau.han_thanh_toan} /></label>
            </div>
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.tienThue}</span>
                <input type="text" inputmode="numeric" name="tien_thue" value={dau.tien_thue} placeholder="0" /></label>
              <label class="nb-o"><span>{t.chiPhiKhac}</span>
                <small>{t.chiPhiGoiY}</small>
                <input type="text" inputmode="numeric" name="chi_phi_khac" value={dau.chi_phi_khac} placeholder="0" /></label>
            </div>
          </>
        )}

        <TruongThem dinhNghia={dnPhieu} giaTri={dau.truong_them} />

        <label class="nb-o"><span>{t.ghiChu}</span>
          <input type="text" name="ghi_chu" value={dau.ghi_chu} maxlength="500" /></label>
      </div>

      <h2>{t.hangNhap}</h2>
      {dongHien.map((d, i) => {
        const mh = tenMh.get(d.mat_hang_id);
        const coChiTiet = !!(d.ngay_san_xuat || d.so_lo_ncc || d.ngay_mo || d.so_kg_thuc);
        return (
          <div class="kho-dong-hang">
            <span class="so-thu-tu">{i + 1}</span>
            <label class="nb-o" style="margin-top:.4rem">
              <span>{t.matHang}</span>
              <ChonMatHang name={`d${i}_mat_hang`} matHang={matHang} chon={d.mat_hang_id} />
            </label>
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.soKg}</span>
                <input type="text" inputmode="decimal" name={`d${i}_so_kg`} value={d.so_kg} placeholder={i === 0 ? t.viDuKg : undefined} /></label>
              <label class="nb-o"><span>{t.soDonVi(mh?.don_vi_goi)}</span>
                <input type="text" inputmode="numeric" name={`d${i}_so_goi`} value={d.so_goi} placeholder={i === 0 ? t.viDuGoi : undefined} /></label>
              <label class="nb-o"><span>{loai === 'ton_dau' ? t.giaVonUocTinh : t.donGiaKg}</span>
                <input type="text" inputmode="numeric" name={`d${i}_don_gia`} value={d.don_gia_kg} placeholder={i === 0 ? t.viDuGia : undefined} /></label>
              <label class="nb-o"><span>{t.hanDung}</span>
                <input type="date" name={`d${i}_hsd`} value={d.han_dung} /></label>
            </div>
            <TruongThem dinhNghia={dnLo.filter(x => x.bat_buoc)} giaTri={d.truong_them} dong={i} />
            <details open={coChiTiet}>
              <summary>{t.themChiTiet}{dnLo.some(x => !x.bat_buoc && x.dang_dung) ? t.oThongTinThem : ''}</summary>
              <div class="kho-luoi">
                <label class="nb-o"><span>{t.ngaySx}</span>
                  <input type="date" name={`d${i}_nsx`} value={d.ngay_san_xuat} /></label>
                <label class="nb-o"><span>{t.soLoNcc}</span>
                  <input type="text" name={`d${i}_so_lo_ncc`} value={d.so_lo_ncc} autocapitalize="characters" /></label>
                <label class="nb-o"><span>{t.ngayMo}</span>
                  <input type="date" name={`d${i}_ngay_mo`} value={d.ngay_mo} /></label>
                <label class="nb-o"><span>{t.kgThuc}</span>
                  <input type="text" inputmode="decimal" name={`d${i}_kg_thuc`} value={d.so_kg_thuc} /></label>
              </div>
              <TruongThem dinhNghia={dnLo.filter(x => !x.bat_buoc)} giaTri={d.truong_them} dong={i} />
            </details>
            {i < dongCo.length && (
              <label class="kho-tich"><input type="checkbox" name={`d${i}_xoa`} value="co" /> {t.boDong}</label>
            )}
          </div>
        );
      })}
      <p class="kho-phu">{t.ghiChuDong}</p>

      <div class="kho-thanh-nut dinh">
        <button type="submit" name="viec" value="luu" class="nb-nut phu">{t.luuNhap}</button>
        <button type="submit" name="viec" value="them_dong" class="nb-nut phu">{t.luuThemDong}</button>
        <button type="submit" name="viec" value="gui" class="nb-nut">{t.guiDuyet}</button>
      </div>
    </form>
  ) : dienGiaDuoc && phieu && gf ? (
    // =====================================================================
    // CHẾ ĐỘ ĐIỀN GIÁ + DUYỆT (kế toán, quản lý — quyền duyet_nhap)
    // =====================================================================
    <>
      <section class="dg-anh kho-khong-in" aria-label={t.anhHoaDon}>
        {phieu.anh.length === 0 ? (
          <div class="nb-bao luu-y"><p>{phieu.loai === 'mua' ? t.chuaCoAnh : t.tonDauKhongAnh}</p></div>
        ) : (
          <>
            {phieu.anh.map((a, i) => {
              const l = anhLink.get(a);
              if (!l) return <p class="kho-phu">{t.khongMoAnh(a.split('/').pop() ?? '')}</p>;
              return a.endsWith('.pdf')
                ? <a class="nb-nut phu" href={l} target="_blank" rel="noopener">{t.moPdf(i + 1)}</a>
                : <a href={l} target="_blank" rel="noopener"><img src={l} alt={t.anhHoaDonSo(i + 1)} /></a>;
            })}
            <p class="kho-phu">{t.bamAnh}</p>
          </>
        )}
      </section>

      <div class="nb-the">
        <dl class="kho-dl">
          {phieu.loai === 'mua' && <><dt>{t.ncc}</dt><dd>{ncc.find(n => n.id === phieu!.nha_cung_cap_id)?.ten ?? '—'}</dd></>}
          <dt>{t.nhanVao}</dt><dd>{viTri.find(v => v.id === phieu!.vi_tri_id)?.ten ?? '—'}</dd>
          <dt>{t.ngayNhap}</dt><dd>{dinhDangNgay(phieu.ngay_nhap)}</dd>
          {phieu.ghi_chu && <><dt>{t.ghiChu}</dt><dd>{phieu.ghi_chu}</dd></>}
        </dl>
        <TruongThem dinhNghia={dnPhieu} giaTri={phieu.truong_them} chiDoc />
        {coTheSoan && (
          <p style="margin:.5rem 0 0"><a href={`/noi-bo/kho/nhap/${phieu.id}?soan=1`}>{t.suaDongKg}</a></p>
        )}
      </div>

      <form method="POST">
        <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />

        <h2>{phieu.loai === 'ton_dau' ? t.giaVonTungMon : t.donGiaTungMon}</h2>
        {dongDb.length === 0 && <p class="nb-rong">{t.chuaCoDong}</p>}
        {dongDb.map((d, i) => {
          const mh = tenMh.get(d.mat_hang_id);
          const ss = soSanh.get(d.id);
          const chip = chuSoSanhGia(ss, nn);
          const tt = thanhTienTam(d);
          const gv = giaVon[i];
          return (
            <div class="kho-dong-hang">
              <span class="so-thu-tu">{i + 1}</span>
              <p class="dg-ten">
                <strong>{mh?.ten ?? '—'}</strong><br />
                <span class="kho-phu">{kgs(d.so_kg)} {d.so_kg_thuc != null ? t.kgNcc : 'kg'}{d.so_kg_thuc != null && <> {t.sauRepack(kgs(d.so_kg_thuc), dinhDangPhanTram(haoRepack(d.so_kg, d.so_kg_thuc)?.pt, 1, nn))}</>}{d.so_goi ? ` · ${d.so_goi} ${mh?.don_vi_goi ?? t.goi}` : ''} · {t.han} {dinhDangNgay(d.han_dung)}{d.so_lo_ncc ? ` · ${t.loNcc(d.so_lo_ncc)}` : ''}</span>
              </p>
              <label class="nb-o"><span>{phieu.loai === 'ton_dau' ? t.giaVonUocTinh : t.donGiaKg}</span>
                <input type="text" inputmode="numeric" name={`gia_${d.id}`} value={gf.gia[d.id] ?? ''}
                  placeholder={ss?.gia_truoc ? t.lanTruoc(ss.gia_truoc) : t.viDuGia} /></label>
              {chip && (
                <p class="dg-chip-hang"><span class:list={['dg-chip', { vuot: chip.vuot }]}>{chip.chu}</span>
                  {ss?.so_phieu_truoc && <span class="kho-phu">{' '}{t.phieu} {ss.so_phieu_truoc} · {dinhDangNgay(ss.ngay_truoc)}</span>}</p>
              )}
              <p class="kho-phu" style="margin:.4rem 0 0">{t.thanhTienTam} <strong>{tt !== null && tt > 0 ? tien(tt) : '—'}</strong>
                {gv && d.don_gia_kg > 0 && Math.round(gv.gia_von_kg) !== d.don_gia_kg && <>{' '}· {t.vaoKho} {tien(gv.gia_von_kg)}/kg</>}</p>
            </div>
          );
        })}

        {phieu.loai === 'mua' ? (
          <div class="nb-the">
            <h2 style="margin-top:0">{t.hoaDon}</h2>
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.soHoaDon}</span>
                <input type="text" name="so_hoa_don" value={gf.so_hoa_don} autocapitalize="characters" /></label>
              <label class="nb-o"><span>{t.ngayHoaDon}</span>
                <input type="date" name="ngay_hoa_don" value={gf.ngay_hoa_don} max={homNayVn()} /></label>
              <label class="nb-o"><span>{t.hanThanhToan}</span>
                <small>{t.boTrongHan}</small>
                <input type="date" name="han_thanh_toan" value={gf.han_thanh_toan} /></label>
            </div>
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.tienThue}</span>
                <input type="text" inputmode="numeric" name="tien_thue" value={gf.tien_thue} placeholder="0" /></label>
              <label class="nb-o"><span>{t.chiPhiKhac}</span>
                <small>{t.chiPhiGoiYNgan}</small>
                <input type="text" inputmode="numeric" name="chi_phi_khac" value={gf.chi_phi_khac} placeholder="0" /></label>
            </div>
          </div>
        ) : (
          <p class="nb-dan" style="font-size:.88rem">{t.tonDauGhiChu}</p>
        )}

        <dl class="kho-dl nb-the">
          <dt>{t.tienHangTam}</dt><dd class="kho-so">{tien(tienHangTam)}</dd>
          {phieu.loai === 'mua' && <><dt>{t.tongTam}</dt><dd class="kho-so"><strong>{tien(tongTam)}</strong></dd></>}
        </dl>

        {canhBaoGia && (
          <div class="nb-bao luu-y"><p><strong>{canhBaoGia}</strong></p></div>
        )}
        {phieu.trang_thai === 'cho_duyet' && phieu.loai === 'mua' && soDongThieuGia > 0 && (
          <p class="kho-phu">{t.conThieuGia(soDongThieuGia)}</p>
        )}
        <p class="kho-phu">{t.chip1} <strong>{t.luuGia}</strong> {t.chip2}
          {phieu.trang_thai === 'cho_duyet' && <>{' '}{t.duyetXong1} <strong>{t.loHang}</strong> {t.duyetXong2}</>}</p>

        <div class="kho-thanh-nut dinh">
          <button type="submit" name="viec" value="luu_gia" class="nb-nut phu">{t.luuGia}</button>
          {phieu.trang_thai === 'cho_duyet' && (
            <button type="submit" name="viec" value="duyet" class="nb-nut">{t.duyetVaoKho}</button>
          )}
        </div>
      </form>

      {phieu.trang_thai === 'cho_duyet' && (
        <details class="nb-the kho-khong-in">
          <summary style="cursor:pointer;font-weight:600">{t.tuChoiPhieu}</summary>
          <form method="POST" style="margin-top:.75rem">
            <label class="nb-o"><span>{t.lyDoTuChoi}</span>
              <small>{t.lyDoTuChoiGoiY}</small>
              <textarea name="ly_do" required maxlength="500"></textarea></label>
            <button type="submit" name="viec" value="tu_choi" class="nb-nut kho-nut-xoa">{t.tuChoi}</button>
          </form>
        </details>
      )}

      {phieu.trang_thai === 'cho_duyet' && k.duoc('nhap') && laNguoiTao && (
        <form method="POST" class="kho-thanh-nut">
          <button type="submit" name="viec" value="rut" class="nb-nut phu">{t.rutVe}</button>
        </form>
      )}
    </>
  ) : phieu && (
    // =====================================================================
    // CHẾ ĐỘ XEM / DUYỆT
    // =====================================================================
    <>
      <div class="nb-the">
        <dl class="kho-dl">
          {phieu.loai === 'mua' && <><dt>{t.ncc}</dt><dd>{ncc.find(n => n.id === phieu!.nha_cung_cap_id)?.ten ?? '—'}</dd></>}
          <dt>{t.nhanVao}</dt><dd>{viTri.find(v => v.id === phieu!.vi_tri_id)?.ten ?? '—'}</dd>
          <dt>{t.ngayNhap}</dt><dd>{dinhDangNgay(phieu.ngay_nhap)}</dd>
          {phieu.so_hoa_don && <><dt>{t.hoaDon}</dt><dd>{phieu.so_hoa_don}{phieu.ngay_hoa_don && ` · ${dinhDangNgay(phieu.ngay_hoa_don)}`}</dd></>}
          {phieu.han_thanh_toan && <><dt>{t.hanThanhToan}</dt><dd>{dinhDangNgay(phieu.han_thanh_toan)}</dd></>}
          {phieu.ghi_chu && <><dt>{t.ghiChu}</dt><dd>{phieu.ghi_chu}</dd></>}
        </dl>
        <TruongThem dinhNghia={dnPhieu} giaTri={phieu.truong_them} chiDoc />
        {phieu.anh.length > 0 && (
          <div class="kho-anh">
            {phieu.anh.map(a => anhLink.get(a)
              ? <a href={anhLink.get(a)} target="_blank" rel="noopener"><img src={anhLink.get(a)} alt={t.anhChungTu} loading="lazy" /></a>
              : <span class="kho-phu">{a.split('/').pop()}</span>)}
          </div>
        )}
      </div>

      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr>
            <th>{t.matHang}</th><th class="so">Kg</th><th class="so">{t.cotGoi}</th><th class="so">{t.donGiaKg}</th>
            <th class="so">{t.cotThanhTien}</th><th>{t.cotHanDung}</th><th>{t.cotLo}</th>
            {giaVon.length > 0 && <th class="so">{t.cotGiaVon}</th>}
          </tr></thead>
          <tbody>
            {dongDb.map((d, i) => (
              <tr>
                <td>{tenMh.get(d.mat_hang_id)?.ten ?? '—'}
                  {d.so_lo_ncc && <><br /><span class="kho-phu">{t.loNcc(d.so_lo_ncc)}</span></>}
                  {dnLo.length > 0 && Object.keys(d.truong_them ?? {}).length > 0 && (
                    <><br /><span class="kho-phu">{dnLo.filter(x => d.truong_them?.[x.khoa] !== undefined).map(x => `${x.nhan}: ${d.truong_them[x.khoa] === true ? CO_KHONG.co[nn] : d.truong_them[x.khoa] === false ? CO_KHONG.khong[nn] : d.truong_them[x.khoa]}`).join(' · ')}</span></>
                  )}
                </td>
                <td class="so">{kgs(d.so_kg)}{d.so_kg_thuc != null && <><br /><span class="kho-phu">{t.sauRepack(kgs(d.so_kg_thuc), dinhDangPhanTram(haoRepack(d.so_kg, d.so_kg_thuc)?.pt, 1, nn))}</span></>}</td>
                <td class="so">{d.so_goi || '—'}</td>
                <td class="so">{tien(d.don_gia_kg)}</td>
                <td class="so">{tien(d.thanh_tien)}</td>
                <td>{dinhDangNgay(d.han_dung)}</td>
                <td>{d.lo_id ? maLo.get(d.lo_id) ?? '—' : '—'}</td>
                {giaVon.length > 0 && <td class="so">{tien(giaVon[i]?.gia_von_kg)}</td>}
              </tr>
            ))}
            <tr class="tong"><td>{t.tienHang}</td><td class="so">{kgs(dongDb.reduce((s, d) => s + d.so_kg, 0))}</td><td></td><td></td><td class="so">{tien(tienHang)}</td><td colspan={giaVon.length > 0 ? 3 : 2}></td></tr>
            {phieu.loai === 'mua' && <>
              <tr><td colspan="4">{t.thue}</td><td class="so">{tien(phieu.tien_thue)}</td><td colspan={giaVon.length > 0 ? 3 : 2}></td></tr>
              <tr><td colspan="4">{t.chiPhiKhac}</td><td class="so">{tien(phieu.chi_phi_khac)}</td><td colspan={giaVon.length > 0 ? 3 : 2}></td></tr>
              <tr class="tong"><td colspan="4">{t.tongPhaiTra}</td><td class="so">{tien(tongTien)}</td><td colspan={giaVon.length > 0 ? 3 : 2}></td></tr>
            </>}
          </tbody>
        </table>
      </div>
      {giaVon.length > 0 && (
        <p class="kho-phu">{t.gv1}{caiDat?.chi_phi_vao_gia_von ? t.gvCp : ''}{caiDat?.vat_vao_gia_von ? t.gvVat : ''}{t.gv2}</p>
      )}

      {congNo && (
        <div class="nb-the">
          <h2 style="margin-top:0">{t.congNo}</h2>
          <dl class="kho-dl">
            <dt>{t.hoaDon}</dt><dd>{congNo.da_doi_chieu ? <>{congNo.so_hoa_don} · {tien(congNo.tien_hoa_don)}</> : <span class="kho-phu">{t.chuaDoiChieu}</span>}</dd>
            <dt>{t.phaiTra}</dt><dd class="kho-so">{tien(congNo.phai_tra)}</dd>
            <dt>{t.daTra}</dt><dd class="kho-so">{tien(congNo.da_tra)}{congNo.giam_tru > 0 && <> · {t.giamTru} {tien(congNo.giam_tru)}</>}</dd>
            <dt>{t.conNo}</dt><dd class="kho-so"><strong>{congNo.con_no < 0 ? t.nccNoLai(tien(-congNo.con_no)) : tien(congNo.con_no)}</strong>
              {congNo.qua_han && <span class="kho-han het_han" style="margin-left:.4rem">{t.quaHan(congNo.so_ngay_qua_han)}</span>}</dd>
            <dt>{t.hanNo}</dt><dd>{dinhDangNgay(congNo.han_thanh_toan)}</dd>
          </dl>
          {k.duoc('ke_toan') && (
            <p style="margin:0"><a href={`/noi-bo/kho/cong-no/${congNo.nha_cung_cap_id}`}>{t.doiChieu}</a> · <a href={`/noi-bo/kho/cong-no/tra-hang?phieu=${phieu.id}`}>{t.traHang}</a></p>
          )}
        </div>
      )}

      {phieu.trang_thai === 'cho_duyet' && k.duoc('nhap') && laNguoiTao && (
        <form method="POST" class="kho-thanh-nut">
          <button type="submit" name="viec" value="rut" class="nb-nut phu">{t.rutVe}</button>
        </form>
      )}

      {phieu.trang_thai === 'da_duyet' && k.duoc('duyet') && (
        <details class="nb-the">
          <summary style="cursor:pointer;font-weight:600">{t.huyDaDuyet}</summary>
          <p class="nb-dan" style="margin-top:.75rem">{t.huy1} <strong>{t.huy2}</strong> {t.huy3}</p>
          <form method="POST">
            <label class="nb-o"><span>{t.lyDoHuy}</span><textarea name="ly_do" required maxlength="500"></textarea></label>
            <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{t.huyPhieu}</button>
          </form>
        </details>
      )}
    </>
  )}

  {soanDuoc && phieu && (
    <details class="nb-the" style="margin-top:1.5rem">
      <summary style="cursor:pointer;font-weight:600">{t.huyNhapNay}</summary>
      <form method="POST" style="margin-top:.75rem">
        <label class="nb-o"><span>{t.lyDoTuyY}</span><input type="text" name="ly_do" maxlength="500" /></label>
        <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{t.huyNhap}</button>
      </form>
    </details>
  )}

  <p class="kho-khong-in" style="margin-top:1.5rem"><a href={linkVe}>{chuVe}</a></p>
  {phieu && <KyTen ten={phieu.loai === 'ton_dau' ? [t.kyNguoiLap, t.kyNguoiDuyet] : [t.kyNguoiGiao, t.kyThuKho, t.kyNguoiDuyet, t.kyKeToan]} />}
</Kho>

<style>
  /* Ảnh hóa đơn cỡ lớn: người điền giá đọc số trên ảnh, không phải mở tab mới. */
  .dg-anh { display: grid; gap: .6rem; margin: 0 0 1rem; }
  .dg-anh img {
    display: block; width: 100%; max-height: 85vh; object-fit: contain;
    border: 1px solid var(--kho-vach); border-radius: 10px; background: #fff;
  }
  .dg-ten { margin: .4rem 0 .2rem; }
  .dg-chip-hang { margin: .1rem 0 0; }
  /* Chip so giá: xám = trong ngưỡng, đỏ = vượt ngưỡng. */
  .dg-chip {
    display: inline-block; padding: .3rem .7rem; border-radius: 999px;
    font-size: .9rem; font-weight: 600; background: var(--kem-sau); color: var(--than);
  }
  .dg-chip.vuot { background: var(--kho-do-nen); color: var(--do); }
</style>
