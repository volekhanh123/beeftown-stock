---
/**
 * KHO — DANH SÁCH PHIẾU NHẬP
 *
 * Lọc theo trạng thái bằng link GET: ?loc=cho_duyet | nhap | tu_choi |
 * da_duyet | da_huy. Quản lý, kế toán mở trang này chủ yếu để điền giá và
 * duyệt, nên có sẵn ô "Chờ duyệt". Chỉ vai xem giá thấy màn này (phiếu có
 * đơn giá); thủ kho (0031: không thấy tiền) được chuyển sang Nhận hàng
 * (/noi-bo/kho/nhan-hang — chỉ kg). Cách làm chi tiết: trang Quy trình.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho } from '../../../../lib/kho/trang.ts';
import { docDanhSachPhieuNhap, type PhieuNhapTom } from '../../../../lib/kho/nhap.ts';
import LocDanhSach from '../../../../components/kho/LocDanhSach.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { docTimDs, catTrang, dangTim } from '../../../../lib/kho/tim-ds.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangTien, phoBienNhat, trangThaiKho,
} from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('xem_gia')) return Astro.redirect(k.duoc('nhap') ? '/noi-bo/kho/nhan-hang' : '/noi-bo/kho', 302);
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tieuDe: { vi: 'Nhập hàng', en: 'Goods receipts' },
  khongDoc: { vi: 'Không đọc được phiếu nhập.', en: 'Could not read the goods receipts.' },
  chuaDung: { vi: 'Chi nhánh chưa bắt đầu dùng kho. Vào', en: 'This branch has not started using inventory yet. Go to' },
  tongQuanKho: { vi: 'Tổng quan kho', en: 'Inventory overview' },
  dan: {
    vi: 'Thủ kho gửi phiếu có kg và ảnh hóa đơn; kế toán hoặc quản lý điền giá rồi duyệt — hàng chỉ vào tồn khi đã duyệt.',
    en: 'The storekeeper sends a note with the kg and an invoice photo; the accountant or manager fills in the prices and approves it — goods go into stock only once approved.',
  },
  xemCachLam: { vi: 'Xem cách làm →', en: 'See how it works →' },
  lapPhieu: { vi: 'Lập phiếu nhập', en: 'New goods receipt' },
  nhapTonDau: { vi: 'Nhập tồn đầu kỳ', en: 'Enter opening stock' },
  locTrangThai: { vi: 'Lọc theo trạng thái', en: 'Filter by status' },
  goiY: { vi: 'Số phiếu, nhà cung cấp, số hóa đơn…', en: 'Receipt no., supplier, invoice no.…' },
  hetDs: { vi: 'Hết danh sách — bấm "Trang trước".', en: 'End of the list — press "Previous".' },
  khongKhop: { vi: 'Không tìm thấy phiếu nào khớp bộ lọc.', en: 'No receipts match the filter.' },
  khongCoMuc: { vi: (ten: string) => `Không có phiếu nào ở mục "${ten}".`, en: (ten: string) => `No receipts under "${ten}".` },
  chuaCo: { vi: 'Chưa có phiếu nhập nào.', en: 'No goods receipts yet.' },
  tonDau: { vi: ' · tồn đầu kỳ', en: ' · opening stock' },
  chuaChon: { vi: 'chưa chọn', en: 'not chosen' },
  vao: { vi: 'vào', en: 'into' },
  soDong: { vi: (n: number) => `${n} dòng`, en: (n: number) => `${n} ${s(n, 'line', 'lines')}` },
});

const LOC = [
  ['', { vi: 'Tất cả', en: 'All' }], ['cho_duyet', { vi: 'Chờ duyệt', en: 'Awaiting approval' }], ['nhap', { vi: 'Nháp', en: 'Draft' }],
  ['tu_choi', { vi: 'Bị từ chối', en: 'Rejected' }], ['da_duyet', { vi: 'Đã duyệt', en: 'Approved' }], ['da_huy', { vi: 'Đã hủy', en: 'Cancelled' }],
] as const;
const loc = LOC.some(([v]) => v === Astro.url.searchParams.get('loc'))
  ? Astro.url.searchParams.get('loc')! : '';
const tenLoc = LOC.find(([v]) => v === loc)?.[1][nn] ?? '';

const tim = docTimDs(Astro.url.searchParams);
let ds: PhieuNhapTom[] = [];
let coSau = false;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    ({ ds, coSau } = catTrang(await docDanhSachPhieuNhap(k.client, k.chiNhanh.id, loc || null,
      { tim, nhanSuId: k.nhanSu.id })));
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}
// Thẻ phiếu gọn hai dòng (Khánh duyệt 22/10/2026): không còn dòng người lập (xem trong phiếu), nên không đọc tên.
// Chỗ nhận chỉ ghi khi khác chỗ của đa số phiếu (thường là Kho lạnh).
const noiChinh = phoBienNhat(ds.map(p => p.ten_vi_tri));
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="duyet-nhap">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaDung} <a href="/noi-bo/kho">{t.tongQuanKho}</a>.</p>
  ) : (
    <>
      <p class="nb-dan">
        {t.dan}{' '}
        <a href="/noi-bo/kho/quy-trinh?qt=nhan-hang">{t.xemCachLam}</a>
      </p>

      {k.duoc('nhap') && (
        <div class="kho-nut-nhanh">
          <a class="nb-nut" href="/noi-bo/kho/nhap/moi">{t.lapPhieu}</a>
          <a class="nb-nut phu" href="/noi-bo/kho/cai-dat/ton-dau">{t.nhapTonDau}</a>
        </div>
      )}

      <nav class="kho-dh" aria-label={t.locTrangThai}>
        {LOC.map(([v, tenChip]) => (
          <a href={v ? `/noi-bo/kho/nhap?loc=${v}` : '/noi-bo/kho/nhap'} aria-current={loc === v ? 'page' : undefined}>{tenChip[nn]}</a>
        ))}
      </nav>

      <LocDanhSach duong="/noi-bo/kho/nhap" tim={tim} giu={{ loc }} coCuaToi={k.duoc('nhap')}
        goiY={t.goiY} />

      {ds.length === 0 ? (
        <p class="nb-rong">{tim.trang > 1 ? t.hetDs : dangTim(tim) ? t.khongKhop
          : loc ? t.khongCoMuc(tenLoc) : t.chuaCo}</p>
      ) : ds.map(p => {
        const [nhan, lopTT] = trangThaiKho(p.trang_thai, nn);
        const lop = lopTT || 'tat';
        return (
          <a href={`/noi-bo/kho/nhap/${p.id}`} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
            <div class="nb-dong-dau">
              <strong>{p.so_phieu}{p.loai === 'ton_dau' && t.tonDau}{p.loai !== 'ton_dau' && <> · {p.ten_nha_cung_cap ?? t.chuaChon}</>}</strong>
              <span class={`nb-nhan ${lop}`}>{nhan}</span>
            </div>
            <p class="nb-dong-tom">
              {dinhDangNgay(p.ngay_nhap)} · {t.soDong(p.so_dong)} · {dinhDangKg(p.tong_kg, nn)} kg · <strong class="kho-so">{dinhDangTien(p.tong_tien, nn)}</strong>
              {p.ten_vi_tri && p.ten_vi_tri !== noiChinh && <> · {t.vao} {p.ten_vi_tri}</>}
            </p>
          </a>
        );
      })}
      <PhanTrang duong="/noi-bo/kho/nhap" trang={tim.trang} coSau={coSau} />
    </>
  )}
</Kho>
