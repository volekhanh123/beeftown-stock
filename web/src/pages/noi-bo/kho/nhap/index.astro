---
/**
 * KHO — DANH SÁCH PHIẾU NHẬP
 *
 * Lọc theo trạng thái bằng link GET: ?loc=cho_duyet | nhap | tu_choi |
 * da_duyet | da_huy. Quản lý mở trang này chủ yếu để duyệt, nên có sẵn ô
 * "Chờ duyệt"; thủ kho tìm lại phiếu nháp chưa gửi ở ô "Nháp". Chỉ vai xem
 * giá thấy màn này (phiếu có đơn giá). Cách làm chi tiết: trang Quy trình.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, tenNhanSu } from '../../../../lib/kho/trang.ts';
import { docDanhSachPhieuNhap, type PhieuNhapTom } from '../../../../lib/kho/nhap.ts';
import LocDanhSach from '../../../../components/kho/LocDanhSach.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { docTimDs, catTrang, dangTim } from '../../../../lib/kho/tim-ds.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, TRANG_THAI_CHUNG_TU,
} from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('xem_gia')) return Astro.redirect('/noi-bo/kho', 302);

const LOC = [
  ['', 'Tất cả'], ['cho_duyet', 'Chờ duyệt'], ['nhap', 'Nháp'],
  ['tu_choi', 'Bị từ chối'], ['da_duyet', 'Đã duyệt'], ['da_huy', 'Đã hủy'],
] as const;
const loc = LOC.some(([v]) => v === Astro.url.searchParams.get('loc'))
  ? Astro.url.searchParams.get('loc')! : '';
const tenLoc = LOC.find(([v]) => v === loc)?.[1] ?? '';

const tim = docTimDs(Astro.url.searchParams);
let ds: PhieuNhapTom[] = [];
let coSau = false;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    ({ ds, coSau } = catTrang(await docDanhSachPhieuNhap(k.client, k.chiNhanh.id, loc || null,
      { tim, nhanSuId: k.nhanSu.id })));
  } catch (e) {
    loiDoc = cauLoiKho(e, 'Không đọc được phiếu nhập.');
  }
}
const ten = await tenNhanSu(k.client, ds.map(p => p.nguoi_tao));
---
<Kho k={k} tieuDe="Nhập hàng" huongDan="thu-kho">
  <h1>Nhập hàng</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">Chi nhánh chưa bắt đầu dùng kho. Vào <a href="/noi-bo/kho">Tổng quan kho</a>.</p>
  ) : (
    <>
      <p class="nb-dan">
        Hàng chỉ vào tồn khi quản lý duyệt phiếu.{' '}
        <a href="/noi-bo/kho/quy-trinh?qt=nhan-hang">Xem cách làm →</a>
      </p>

      {k.duoc('nhap') && (
        <div class="kho-nut-nhanh">
          <a class="nb-nut" href="/noi-bo/kho/nhap/moi">Lập phiếu nhập</a>
          <a class="nb-nut phu" href="/noi-bo/kho/nhap/moi?loai=ton_dau">Nhập tồn đầu kỳ</a>
        </div>
      )}

      <nav class="kho-dh" aria-label="Lọc theo trạng thái">
        {LOC.map(([v, t]) => (
          <a href={v ? `/noi-bo/kho/nhap?loc=${v}` : '/noi-bo/kho/nhap'} aria-current={loc === v ? 'page' : undefined}>{t}</a>
        ))}
      </nav>

      <LocDanhSach duong="/noi-bo/kho/nhap" tim={tim} giu={{ loc }} coCuaToi={k.duoc('nhap')}
        goiY="Số phiếu, nhà cung cấp, số hóa đơn…" />

      {ds.length === 0 ? (
        <p class="nb-rong">{tim.trang > 1 ? 'Hết danh sách — bấm "Trang trước".' : dangTim(tim) ? 'Không tìm thấy phiếu nào khớp bộ lọc.'
          : loc ? `Không có phiếu nào ở mục "${tenLoc}".` : 'Chưa có phiếu nhập nào.'}</p>
      ) : ds.map(p => {
        const [nhan, lop] = TRANG_THAI_CHUNG_TU[p.trang_thai] ?? [p.trang_thai, 'tat'];
        return (
          <a href={`/noi-bo/kho/nhap/${p.id}`} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
            <div class="nb-dong-dau">
              <strong>{p.so_phieu}{p.loai === 'ton_dau' && ' · tồn đầu kỳ'}</strong>
              <span class={`nb-nhan ${lop}`}>{nhan}</span>
            </div>
            <dl>
              <dt>Nhà cung cấp</dt><dd>{p.ten_nha_cung_cap ?? (p.loai === 'ton_dau' ? '—' : 'chưa chọn')}</dd>
              <dt>Ngày nhập</dt><dd>{dinhDangNgay(p.ngay_nhap)} · vào {p.ten_vi_tri ?? '—'}</dd>
              <dt>Hàng</dt><dd>{p.so_dong} dòng · {dinhDangKg(p.tong_kg)} kg</dd>
              <dt>Tổng tiền</dt><dd class="kho-so">{dinhDangTien(p.tong_tien)}</dd>
              <dt>Người lập</dt><dd>{ten.get(p.nguoi_tao ?? '') ?? '—'} · {dinhDangThoiDiem(p.created_at)}</dd>
            </dl>
          </a>
        );
      })}
      <PhanTrang duong="/noi-bo/kho/nhap" trang={tim.trang} coSau={coSau} />
    </>
  )}
</Kho>
