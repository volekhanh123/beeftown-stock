---
/**
 * KHO — QUÉT NHÃN (nút giữa thanh đáy)
 *
 * Quét một nhãn cân bất kỳ → biết ngay đó là món gì, gói nặng bao nhiêu, món
 * đó còn ở đâu, lô nào hạn gần nhất — và các nút làm tiếp (ra quầy, đưa bếp,
 * báo hủy). Không cần nhớ món nằm ở menu nào.
 *
 * GET cho đơn giản: máy quét cầm tay gõ mã + Enter là trang tự mở kết quả.
 * Không hiện tiền — NV quầy dùng được.
 *
 * Quét đầy đủ (GĐ5c): tồn theo từng nơi, lô hạn gần trước, mỗi lô có nút làm
 * nhanh như trang Tồn kho (mở sẵn đúng lô, đúng nơi). Nút theo vai:
 *   · vận hành: Ra quầy (lô trong kho hạn gần nhất) · Đưa bếp · Báo hủy (lô
 *     hết hạn nếu có);
 *   · ai cũng có: Thẻ kho, Xem tồn kho; NV quầy có thêm Đếm quầy;
 *   · thủ kho (pha_loc) có phiên pha lóc đang mở: "Thêm vào phiên pha" — POST
 *     một lượt quét đúng nhãn này (kho_quet_phien_pha, ma_gui riêng mỗi lần
 *     vẽ trang → bấm hai lần không cộng đôi), xong mở phiên pha đó.
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import QuetMa from '../../../components/kho/QuetMa.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../lib/kho/trang.ts';
import { docCaiDat, docMatHang, type MatHang } from '../../../lib/kho/danh-muc.ts';
import { docTon, viecVoiLo, type DongTon } from '../../../lib/kho/ton.ts';
import { docPhienPhaMo, linkTheKho, themNhanVaoPhienPha, type PhienPhaMo } from '../../../lib/kho/the-kho.ts';
import { docMaVach, tachDanhSachMa, MAU_MAC_DINH } from '../../../lib/kho/ma-vach.ts';
import { cauLoiKho, dinhDangKg, dinhDangNgay, laUuid, TEN_LOAI_VI_TRI, type KetQua } from '../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;

const q = Astro.url.searchParams;
const maNhap = tachDanhSachMa(String(q.get('ma') ?? q.get('ma_quet') ?? ''))[0] ?? '';
const vanHanh = k.duoc('van_hanh');
const laQuay = k.nhanSu.vai_tro === 'nhan_vien_quay';

// "Thêm vào phiên pha": POST về chính trang này (giữ ?ma=), thành công thì mở phiên.
let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form && k.duoc('pha_loc')) {
  const phienId = String(form.get('phien_id') ?? '');
  const kq = String(form.get('viec') ?? '') === 'them_pha'
    ? await themNhanVaoPhienPha(k.client, phienId, String(form.get('ma_gui') ?? ''), String(form.get('ma') ?? ''))
    : { ok: false, cau: 'Việc không hợp lệ.' };
  if (kq.ok && laUuid(phienId)) return chuyenHuong(Astro, `/noi-bo/kho/pha-loc/${phienId}`, kq);
  bao = kq;
}

let loiDoc = k.loiDoc;
let phienMo: PhienPhaMo[] = [];
let loiQuet: string | null = null;
let mh: MatHang | null = null;
let soKgNhan: number | null = null;
let ton: DongTon[] = [];
if (maNhap && k.chiNhanh && k.daKhoiTao) {
  try {
    const [cd, ds] = await Promise.all([docCaiDat(k.client, k.chiNhanh.id), docMatHang(k.client)]);
    const kq = docMaVach(maNhap, cd?.mau_ma_vach ?? MAU_MAC_DINH, cd?.so_le_kg ?? 3);
    if (!kq.hopLe) {
      loiQuet = kq.loi === 'Sai số kiểm tra — quét lại' ? 'Nhãn đọc sai — quét lại nhãn này.' : `${kq.loi}.`;
    } else {
      mh = ds.find(m => m.ma_can === kq.maCan && m.dang_dung) ?? null;
      soKgNhan = kq.soKg;
      if (!mh) loiQuet = `Nhãn hợp lệ nhưng mã hàng ${kq.maCan} chưa gắn với món nào. Để riêng gói này và báo quản lý.`;
      else {
        const coPha = k.duoc('pha_loc') && mh.loai !== 'tang';
        const [tonDs, phien] = await Promise.all([
          docTon(k.client, k.chiNhanh.id),
          coPha ? docPhienPhaMo(k.client, k.chiNhanh.id) : Promise.resolve([] as PhienPhaMo[]),
        ]);
        ton = tonDs.filter(t => t.mat_hang_id === mh!.id && t.loai_vi_tri !== 'cho_huy');
        // Phiên đang pha chính món này (tảng / phần cắt lớn) thì không thêm được — database cũng từ chối.
        phienMo = phien.filter(p => p.mat_hang_vao_id !== mh!.id);
      }
    }
  } catch (e) {
    loiDoc = cauLoiKho(e, 'Không đọc được tồn kho.');
  }
}

// Gom theo vị trí, lô hạn gần trước (FEFO).
const theoViTri = new Map<string, { ten: string; loai: string; id: string; lo: DongTon[] }>();
for (const t of ton) {
  const g = theoViTri.get(t.vi_tri_id) ?? { ten: t.ten_vi_tri, loai: t.loai_vi_tri, id: t.vi_tri_id, lo: [] };
  g.lo.push(t);
  theoViTri.set(t.vi_tri_id, g);
}
const nhom = [...theoViTri.values()].sort((a, b) => (a.loai === 'quay' ? -1 : 1) - (b.loai === 'quay' ? -1 : 1));
const tongGoi = ton.reduce((s, t) => s + t.so_goi, 0);
const tongKg = ton.reduce((s, t) => s + t.so_kg, 0);
const loGanNhat = [...ton].filter(t => t.tinh_trang_han !== 'het_han').sort((a, b) => a.han_dung.localeCompare(b.han_dung))[0];
const TEN_HAN: Record<string, string> = { het_han: 'Hết hạn', sap_het: 'Sắp hết hạn', con_han: 'Còn hạn' };

// Nút lớn mở sẵn đúng lô: Ra quầy lấy lô trong kho lạnh hạn gần nhất; Báo hủy
// lấy lô đã hết hạn (nếu có). Không có lô hợp thì mở phiếu theo món.
const linkLo = (loai: string, t: DongTon | undefined) => t
  ? `/noi-bo/kho/xuat/moi?loai=${loai}&tu=${encodeURIComponent(t.vi_tri_id)}&lo=${encodeURIComponent(t.lo_id)}`
  : `/noi-bo/kho/xuat/moi?loai=${loai}&mh=${encodeURIComponent(mh?.id ?? '')}`;
const loKhoGan = ton.find(t => t.loai_vi_tri === 'kho' && t.tinh_trang_han !== 'het_han');
const loBepGan = ton.find(t => (t.loai_vi_tri === 'kho' || t.loai_vi_tri === 'quay') && t.tinh_trang_han !== 'het_han');
const loHetHan = ton.find(t => (t.loai_vi_tri === 'kho' || t.loai_vi_tri === 'quay') && t.tinh_trang_han === 'het_han');
const BIEU_TUONG_VIEC = { chuyen: 'chuyen', xuat_bep: 'bep', huy: 'huy' } as const;
const maGui = crypto.randomUUID();
---
<Kho k={k} tieuDe="Quét nhãn" huongDan="quet-nhan">
  <h1>Quét nhãn</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <form method="GET" class="nb-the">
    <QuetMa nhan="Xem món này" goiY="Quét một nhãn cân bằng máy quét, hoặc bấm Quét bằng camera." tuFocus />
  </form>

  {loiQuet && <div class="nb-bao luu-y" role="status"><p>{loiQuet}</p></div>}

  {mh && (
    <section class="nb-the kho-quet-kq">
      <header>
        <strong>{mh.ten}</strong>
        <span>{soKgNhan !== null ? `Gói này: ${dinhDangKg(soKgNhan)} kg` : ''}</span>
      </header>
      <p class="kho-phu">
        Tổng đang có: {mh.dem_goi ? `${tongGoi} ${mh.don_vi_goi} · ` : ''}{dinhDangKg(tongKg)} kg
        {loGanNhat && <>{' · '}lô hạn gần nhất {dinhDangNgay(loGanNhat.han_dung)} ở {loGanNhat.ten_vi_tri}</>}
      </p>

      {nhom.length === 0 ? (
        <p class="nb-rong">Trên sổ không còn gói nào của món này.</p>
      ) : nhom.map(g => (
        <div class="kho-quet-vt">
          <h3>{g.ten} <small>{TEN_LOAI_VI_TRI[g.loai] ?? g.loai}</small></h3>
          <ul>
            {g.lo.map(l => (
              <li>
                <span class={`kho-han ${l.tinh_trang_han}`}>{TEN_HAN[l.tinh_trang_han]}</span>
                <span>Hạn {dinhDangNgay(l.han_dung)} · đóng {dinhDangNgay(l.ngay_dong_goi)}</span>
                <b>{l.dem_goi ? `${l.so_goi} ${l.don_vi_goi} · ` : ''}{dinhDangKg(l.so_kg)} kg</b>
                {vanHanh && viecVoiLo(l).length > 0 && (
                  <div class="quet-lo-nut">
                    {viecVoiLo(l).map(v => (
                      <a class="nb-nut phu" href={v.link} aria-label={`${v.ten} lô ${l.ma_lo} ở ${l.ten_vi_tri}`}>
                        <BieuTuong ten={BIEU_TUONG_VIEC[v.ma]} co={18} />{v.ten}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      {phienMo.length > 0 && (
        <div class="quet-pha">
          <h3>Gói này vừa pha xong?</h3>
          {phienMo.map(p => (
            <form method="POST">
              <input type="hidden" name="viec" value="them_pha" />
              <input type="hidden" name="phien_id" value={p.id} />
              <input type="hidden" name="ma_gui" value={maGui} />
              <input type="hidden" name="ma" value={maNhap} />
              <button type="submit" class="nb-nut"><BieuTuong ten="dao" co={20} />Thêm vào phiên pha {p.so_phieu} ({p.ten_mat_hang_vao})</button>
            </form>
          ))}
        </div>
      )}

      <div class="kho-nhanh-luoi" style="margin-top:1rem">
        {vanHanh && (
          <>
            {loKhoGan && <a class="nb-nut" href={linkLo('chuyen', loKhoGan)}><BieuTuong ten="chuyen" co={20} />Ra quầy</a>}
            <a class="nb-nut phu" href={linkLo('xuat_bep', loBepGan)}><BieuTuong ten="bep" co={20} />Đưa bếp</a>
            <a class="nb-nut phu" href={linkLo('huy', loHetHan)}><BieuTuong ten="huy" co={20} />Báo hủy</a>
          </>
        )}
        {laQuay && vanHanh && (
          <a class="nb-nut phu" href="/noi-bo/kho/quay/dem"><BieuTuong ten="kiem_ke" co={20} />Đếm quầy</a>
        )}
        <a class="nb-nut phu" href={linkTheKho(mh.id)}><BieuTuong ten="bao_cao" co={20} />Thẻ kho</a>
        <a class="nb-nut phu" href={`/noi-bo/kho/ton?q=${encodeURIComponent(mh.ma)}`}><BieuTuong ten="ton" co={20} />Xem tồn kho</a>
      </div>
    </section>
  )}
</Kho>

<style>
  .quet-lo-nut { grid-column: 1 / -1; display: flex; gap: .4rem; flex-wrap: wrap; }
  .quet-lo-nut .nb-nut {
    min-height: 48px; padding: .45rem .75rem; font-size: .85rem; gap: .35rem;
    display: inline-flex; align-items: center; flex: 1 1 7rem; justify-content: center;
  }
  .quet-pha { margin-top: 1rem; }
  .quet-pha h3 { font-size: .95rem; margin: 0 0 .4rem; }
  .quet-pha form + form { margin-top: .4rem; }
  .quet-pha .nb-nut { width: 100%; min-height: 48px; gap: .5rem; justify-content: flex-start; }
</style>
