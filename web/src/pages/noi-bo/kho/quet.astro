---
/**
 * KHO — QUÉT NHÃN (nút giữa thanh đáy)
 *
 * Quét một nhãn cân bất kỳ → biết ngay đó là món gì, gói nặng bao nhiêu, món
 * đó còn ở đâu, lô nào hạn gần nhất — và các nút làm tiếp (ra quầy, đưa bếp,
 * báo hủy). Không cần nhớ món nằm ở menu nào.
 *
 * GET cho đơn giản: máy quét cầm tay gõ mã + Enter là trang tự mở kết quả.
 * Không hiện tiền — NV quầy dùng được.
 *
 * Quét đầy đủ (GĐ5c): tồn theo từng nơi, lô hạn gần trước, mỗi lô có nút làm
 * nhanh như trang Tồn kho (mở sẵn đúng lô, đúng nơi). Nút theo vai:
 *   · vận hành: Ra quầy (lô trong kho hạn gần nhất) · Đưa bếp · Báo hủy (lô
 *     hết hạn nếu có);
 *   · ai cũng có: Thẻ kho, Xem tồn kho; NV quầy có thêm Đếm quầy;
 *   · thủ kho (pha_loc) có phiên pha lóc đang mở: "Thêm vào phiên pha" — POST
 *     một lượt quét đúng nhãn này (kho_quet_phien_pha, ma_gui riêng mỗi lần
 *     vẽ trang → bấm hai lần không cộng đôi), xong mở phiên pha đó.
 *
 * MÃ TRÊN NHÃN tra bằng bộ tra chung (tra-ma-can.ts), giống hệt database: mã của món, Ô MÃ xoay vòng của một
 * tảng (0049), mã giảm giá hàng cận date (0054). Ô mã và mã giảm đọc một lần, cùng lượt với danh mục.
 *   · Nhãn mã ô đang giao cho một tảng: hiện "Ô 1 · tảng #0001", lô của tảng đó xếp lên đầu, và các nút làm
 *     nhanh mở đúng lô đó khi lô còn hàng ở kho / quầy. Lô đó đã hết hạn thì chỉ còn Báo hủy.
 *   · Nhãn mã ô mà ô không còn gắn với tảng nào: vẫn hiện món, kèm một câu nói rõ.
 *   · Nhãn mã giảm: hiện món và "Tem giảm 30%".
 * Mỗi lô thuộc một tảng hiện kèm số tảng (docLoTang — một lượt đọc cho các lô đang hiện).
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import QuetMa from '../../../components/kho/QuetMa.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../lib/kho/trang.ts';
import { docCaiDat, docMatHang, type MatHang } from '../../../lib/kho/danh-muc.ts';
import { docTon, viecVoiLo, type DongTon } from '../../../lib/kho/ton.ts';
import { docPhienPhaMo, linkTheKho, themNhanVaoPhienPha, type PhienPhaMo } from '../../../lib/kho/the-kho.ts';
import { docMaVach, tachDanhSachMa, MAU_MAC_DINH } from '../../../lib/kho/ma-vach.ts';
import { oDangGiao, taoBangTraMaCan, traMaCan, type KhopMaCan } from '../../../lib/kho/tra-ma-can.ts';
import { docGiaoOMaCan, docMaTrenNhan, type GiaoOMa } from '../../../lib/kho/o-ma.ts';
import { chuTang, docLoTang, soTangChu } from '../../../lib/kho/tang.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, kqHai, laUuid, nhanKho, TEN_LOAI_VI_TRI_NB, type HaiThuTieng, type KetQua,
} from '../../../lib/kho/chung.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
const CAU = {
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
const t = dichNB(nn, {
  tieuDe: { vi: 'Quét nhãn', en: 'Scan label' },
  xemMon: { vi: 'Xem món này', en: 'Look up this item' },
  goiY: { vi: 'Quét một nhãn cân bằng máy quét, hoặc bấm Quét bằng camera.', en: 'Scan a scale label with the scanner, or press Scan with camera.' },
  nhanSai: { vi: 'Nhãn đọc sai — quét lại nhãn này.', en: 'The label was misread — scan it again.' },
  chuaGan: {
    vi: (ma: string) => `Nhãn hợp lệ nhưng mã hàng ${ma} chưa gắn với món nào. Để riêng gói này và báo quản lý.`,
    en: (ma: string) => `The label is valid, but item code ${ma} is not linked to any item. Set this pack aside and tell the manager.`,
  },
  khongDoc: { vi: 'Không đọc được tồn kho.', en: 'Could not read the stock.' },
  hetHan: { vi: 'Hết hạn', en: 'Expired' },
  sapHet: { vi: 'Sắp hết hạn', en: 'Expiring soon' },
  conHan: { vi: 'Còn hạn', en: 'In date' },
  goiNay: { vi: (dv: string, kg: string) => `${dv.charAt(0).toLocaleUpperCase('vi')}${dv.slice(1)} này: ${kg} kg`, en: (dv: string, kg: string) => `This ${dv}: ${kg} kg` },
  oTang: { vi: (o: number, tang: string) => `Ô ${o} · tảng ${tang}`, en: (o: number, tang: string) => `Slot ${o} · primal ${tang}` },
  chuaCoSo: { vi: 'chưa có số', en: 'without a number' },
  oTrong: { vi: (o: number) => `Ô ${o} — ô này hiện không gắn với tảng nào.`, en: (o: number) => `Slot ${o} — this slot is not assigned to a primal right now.` },
  temGiam: { vi: (pt: number) => `Tem giảm ${pt}%`, en: (pt: number) => `${pt}% discount label` },
  chuaChot: {
    vi: (phien: string, dv: string) => `Phiên lóc ${phien} của tảng này chưa chốt nên ${dv} này chưa vào sổ.`,
    en: (phien: string, dv: string) => `Butchery session ${phien} of this primal is not closed yet, so this ${dv} is not on the books.`,
  },
  hetTang: {
    vi: (dv: string, tang: string) => `Trên sổ không còn ${dv} nào của tảng ${tang} ở kho hay quầy.`,
    en: (dv: string, tang: string) => `The books show no ${dv} of primal ${tang} left in storage or at the counter.`,
  },
  nhanHetHan: {
    vi: (dv: string, han: string) => `${dv.charAt(0).toLocaleUpperCase('vi')}${dv.slice(1)} này thuộc lô đã hết hạn (hạn dùng ${han}) — để riêng và báo hủy.`,
    en: (dv: string, han: string) => `This ${dv} is from a lot that has expired (use-by ${han}) — set it aside and write it off.`,
  },
  loNhan: { vi: (dv: string) => `${dv} vừa quét thuộc lô này`, en: (dv: string) => `the scanned ${dv} is from this lot` },
  tongCo: { vi: 'Tổng đang có: ', en: 'Total on hand: ' },
  loGan: { vi: (han: string, noi: string) => `lô hạn gần nhất ${han} ở ${noi}`, en: (han: string, noi: string) => `earliest use-by ${han} at ${noi}` },
  khongCon: { vi: (dv: string) => `Trên sổ không còn ${dv} nào của món này.`, en: (dv: string) => `There are no ${dv} of this item left on the books.` },
  goiChung: { vi: 'gói', en: 'pack' },
  hanDong: { vi: (han: string, dong: string) => `Hạn ${han} · đóng ${dong}`, en: (han: string, dong: string) => `Use by ${han} · packed ${dong}` },
  viecLo: { vi: (viec: string, lo: string, noi: string) => `${viec} lô ${lo} ở ${noi}`, en: (viec: string, lo: string, noi: string) => `${viec}: lot ${lo} at ${noi}` },
  vuaPha: { vi: 'Gói này vừa pha xong?', en: 'Was this pack just cut?' },
  themPha: { vi: (so: string, ten: string) => `Thêm vào phiên pha ${so} (${ten})`, en: (so: string, ten: string) => `Add to butchery session ${so} (${ten})` },
  raQuay: { vi: 'Ra quầy', en: 'To counter' },
  duaBep: { vi: 'Đưa bếp', en: 'To kitchen' },
  baoHuy: { vi: 'Báo hủy', en: 'Write off' },
  demQuay: { vi: 'Đếm quầy', en: 'Counter count' },
  theKho: { vi: 'Thẻ kho', en: 'Stock card' },
  xemTon: { vi: 'Xem tồn kho', en: 'View stock' },
});
// Câu docMaVach trả khi sai số kiểm tra — thay bằng câu dễ hiểu hơn cho nhân viên.
const SAI_SO_KIEM_TRA = { vi: 'Sai số kiểm tra — quét lại', en: 'Wrong check digit — scan again' } satisfies HaiThuTieng;

const q = Astro.url.searchParams;
const maNhap = tachDanhSachMa(String(q.get('ma') ?? q.get('ma_quet') ?? ''))[0] ?? '';
const vanHanh = k.duoc('van_hanh');
const laQuay = k.nhanSu.vai_tro === 'nhan_vien_quay';

// "Thêm vào phiên pha": POST về chính trang này (giữ ?ma=), thành công thì mở phiên.
let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form && k.duoc('pha_loc')) {
  const phienId = String(form.get('phien_id') ?? '');
  const kq = String(form.get('viec') ?? '') === 'them_pha'
    ? await themNhanVaoPhienPha(k.client, phienId, String(form.get('ma_gui') ?? ''), String(form.get('ma') ?? ''))
    : kqHai(false, CAU.viecSai);
  if (kq.ok && laUuid(phienId)) return chuyenHuong(Astro, `/noi-bo/kho/pha-loc/${phienId}`, kq);
  bao = kq;
}

let loiDoc = k.loiDoc;
let phienMo: PhienPhaMo[] = [];
let loiQuet: string | null = null;
let mh: MatHang | null = null;
/** Vì sao nhãn ra món này: mã của món · ô mã (số ô) · mã giảm (phần trăm). */
let khop: KhopMaCan<MatHang> | null = null;
/** Ô của nhãn đang giao cho tảng nào — null khi nhãn không phải mã ô, hoặc ô đang trống. */
let giaoNhan: GiaoOMa | null = null;
let soTangLo = new Map<string, { tang_id: string; so_tang: number | null }>();
let soKgNhan: number | null = null;
let ton: DongTon[] = [];
if (maNhap && k.chiNhanh && k.daKhoiTao) {
  try {
    const [cd, ds, maNhan] = await Promise.all([docCaiDat(k.client, k.chiNhanh.id), docMatHang(k.client), docMaTrenNhan(k.client)]);
    const kq = docMaVach(maNhap, cd?.mau_ma_vach ?? MAU_MAC_DINH, cd?.so_le_kg ?? 3);
    if (!kq.hopLe) {
      loiQuet = kq.loi === SAI_SO_KIEM_TRA.vi ? t.nhanSai : `${nn === 'en' ? kq.loiEn : kq.loi}.`;
    } else {
      khop = traMaCan(taoBangTraMaCan(ds, maNhan.oMa, maNhan.maGiam), kq.maCan);
      mh = khop?.matHang ?? null;
      soKgNhan = kq.soKg;
      if (!mh || !khop) loiQuet = t.chuaGan(kq.maCan);
      else {
        const [monId, cn, laMaO] = [mh.id, k.chiNhanh.id, khop.nguon === 'o_ma'];
        // Tem giảm giá là tem dán lại cho khay cận date, không phải khay vừa pha → không mời thêm vào phiên pha.
        const coPha = k.duoc('pha_loc') && mh.loai !== 'tang' && khop.nguon !== 'ma_giam';
        const [tonMon, phien, giao] = await Promise.all([
          docTon(k.client, cn).then(async tonDs => {
            const cuaMon = tonDs.filter(x => x.mat_hang_id === monId && x.loai_vi_tri !== 'cho_huy');
            // Số tảng của đúng các lô đang hiện. Đọc hỏng thì vẫn hiện lô như cũ, chỉ thiếu số tảng.
            const tang = await docLoTang(k.client, cuaMon.map(x => x.lo_id)).catch(() => new Map<string, { tang_id: string; so_tang: number | null }>());
            return { cuaMon, tang };
          }),
          coPha ? docPhienPhaMo(k.client, cn) : Promise.resolve([] as PhienPhaMo[]),
          laMaO ? docGiaoOMaCan(k.client, cn) : Promise.resolve([] as GiaoOMa[]),
        ]);
        ton = tonMon.cuaMon;
        soTangLo = tonMon.tang;
        giaoNhan = oDangGiao(khop, giao);
        // Phiên đang pha chính món này (tảng / phần cắt lớn) thì không thêm được — database cũng từ chối.
        // Nhãn mã ô chỉ thêm được vào ĐÚNG phiên đang giữ ô đó (kho_quet_phien_pha từ chối phiên khác).
        phienMo = phien.filter(p => p.mat_hang_vao_id !== monId && (!laMaO || p.id === giaoNhan?.phien_pha_id));
      }
    }
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}

// Lô của tảng in trên nhãn (nhãn mã ô đang giao cho một tảng đã chốt phiên lóc).
const laLoNhan = (l: DongTon) => !!giaoNhan?.lo_id && l.lo_id === giaoNhan.lo_id;
const loCuaNhan = ton.filter(laLoNhan);
/** Số tảng của một lô đang hiện; lô của nhãn thì lấy luôn số tảng của ô khi lượt đọc số tảng hỏng. */
const soTangCua = (l: DongTon) => soTangLo.get(l.lo_id)?.so_tang ?? (laLoNhan(l) ? giaoNhan?.so_tang ?? null : null);

// Gom theo vị trí, lô hạn gần trước (FEFO); lô của tảng trên nhãn lên đầu, nơi đang có lô đó lên trước.
const theoViTri = new Map<string, { ten: string; loai: string; id: string; lo: DongTon[] }>();
for (const t of ton) {
  const g = theoViTri.get(t.vi_tri_id) ?? { ten: t.ten_vi_tri, loai: t.loai_vi_tri, id: t.vi_tri_id, lo: [] };
  g.lo.push(t);
  theoViTri.set(t.vi_tri_id, g);
}
for (const g of theoViTri.values()) g.lo.sort((a, b) => Number(laLoNhan(b)) - Number(laLoNhan(a)));
const nhom = [...theoViTri.values()].sort((a, b) => Number(b.lo.some(laLoNhan)) - Number(a.lo.some(laLoNhan))
  || (a.loai === 'quay' ? -1 : 1) - (b.loai === 'quay' ? -1 : 1));
const tongGoi = ton.reduce((s, t) => s + t.so_goi, 0);
const tongKg = ton.reduce((s, t) => s + t.so_kg, 0);
const loGanNhat = [...ton].filter(t => t.tinh_trang_han !== 'het_han').sort((a, b) => a.han_dung.localeCompare(b.han_dung))[0];
const TEN_HAN: Record<string, string> = { het_han: t.hetHan, sap_het: t.sapHet, con_han: t.conHan };

// Nút lớn mở sẵn đúng lô: Ra quầy lấy lô trong kho lạnh hạn gần nhất; Báo hủy
// lấy lô đã hết hạn (nếu có). Không có lô hợp thì mở phiếu theo món.
const linkLo = (loai: string, t: DongTon | undefined) => t
  ? `/noi-bo/kho/xuat/moi?loai=${loai}&tu=${encodeURIComponent(t.vi_tri_id)}&lo=${encodeURIComponent(t.lo_id)}`
  : `/noi-bo/kho/xuat/moi?loai=${loai}&mh=${encodeURIComponent(mh?.id ?? '')}`;
const loKhoGan = ton.find(t => t.loai_vi_tri === 'kho' && t.tinh_trang_han !== 'het_han');
const loBepGan = ton.find(t => (t.loai_vi_tri === 'kho' || t.loai_vi_tri === 'quay') && t.tinh_trang_han !== 'het_han');
const loHetHan = ton.find(t => (t.loai_vi_tri === 'kho' || t.loai_vi_tri === 'quay') && t.tinh_trang_han === 'het_han');

// Nhãn mã ô: các nút mở ĐÚNG lô của tảng trên nhãn khi lô đó còn hàng ở nơi làm được việc (kho, quầy —
// viecVoiLo). NV quầy ưu tiên dòng ở quầy, người khác ưu tiên dòng trong kho. Lô đó đã hết hạn thì khay cầm
// trên tay cũng hết hạn: chỉ còn Báo hủy, không mời Ra quầy / Đưa bếp bằng một lô khác.
const loNhanLam = loCuaNhan.filter(l => viecVoiLo(l, nn).length > 0)
  .sort((a, b) => Number(b.loai_vi_tri === (laQuay ? 'quay' : 'kho')) - Number(a.loai_vi_tri === (laQuay ? 'quay' : 'kho')));
const nhanHetHan = loCuaNhan.some(l => l.tinh_trang_han === 'het_han');
const loRaQuay = nhanHetHan ? undefined : (loNhanLam.find(l => l.loai_vi_tri === 'kho') ?? loKhoGan);
const loDuaBep = loNhanLam[0] ?? loBepGan;
const loBaoHuy = loNhanLam[0] ?? loHetHan;

// Dòng nói nhãn này in bằng mã gì, và các câu lưu ý về khay cầm trên tay.
const dvNhan = mh?.don_vi_goi || t.goiChung;
const tangNhan = giaoNhan ? (soTangChu(giaoNhan.so_tang) || t.chuaCoSo) : '';
const nguonNhan = !khop ? ''
  : khop.nguon === 'ma_giam' ? t.temGiam(khop.phanTram ?? 0)
  : khop.nguon === 'o_ma' ? (giaoNhan ? t.oTang(khop.soO ?? 0, tangNhan) : t.oTrong(khop.soO ?? 0))
  : '';
const luuYNhan: string[] = [];
if (giaoNhan && !giaoNhan.lo_id) luuYNhan.push(t.chuaChot(giaoNhan.so_phieu, dvNhan));
else if (giaoNhan && loCuaNhan.length === 0) luuYNhan.push(t.hetTang(dvNhan, tangNhan));
else if (nhanHetHan) luuYNhan.push(t.nhanHetHan(dvNhan, dinhDangNgay(loCuaNhan[0].han_dung)));
const BIEU_TUONG_VIEC = { chuyen: 'chuyen', xuat_bep: 'bep', huy: 'huy' } as const;
const maGui = crypto.randomUUID();
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="quet-nhan">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <form method="GET" class="nb-the">
    <QuetMa nhan={t.xemMon} goiY={t.goiY} tuFocus />
  </form>

  {loiQuet && <div class="nb-bao luu-y" role="status"><p>{loiQuet}</p></div>}

  {mh && (
    <section class="nb-the kho-quet-kq">
      <header>
        <strong>{mh.ten}</strong>
        <span>{soKgNhan !== null ? t.goiNay(dvNhan, dinhDangKg(soKgNhan, nn)) : ''}</span>
      </header>
      {nguonNhan && <p class="quet-nguon">{nguonNhan}</p>}
      {luuYNhan.length > 0 && <div class="nb-bao luu-y" role="status">{luuYNhan.map(c => <p>{c}</p>)}</div>}
      <p class="kho-phu">
        {t.tongCo}{mh.dem_goi ? `${tongGoi} ${mh.don_vi_goi} · ` : ''}{dinhDangKg(tongKg, nn)} kg
        {loGanNhat && <>{' · '}{t.loGan(dinhDangNgay(loGanNhat.han_dung), loGanNhat.ten_vi_tri)}</>}
      </p>

      {nhom.length === 0 ? (
        <p class="nb-rong">{t.khongCon(dvNhan)}</p>
      ) : nhom.map(g => (
        <div class="kho-quet-vt">
          <h3>{g.ten} <small>{nhanKho(TEN_LOAI_VI_TRI_NB, g.loai, nn)}</small></h3>
          <ul>
            {g.lo.map(l => (
              <li class:list={[{ 'lo-nhan': laLoNhan(l) }]}>
                <span class={`kho-han ${l.tinh_trang_han}`}>{TEN_HAN[l.tinh_trang_han]}</span>
                <span>{t.hanDong(dinhDangNgay(l.han_dung), dinhDangNgay(l.ngay_dong_goi))}</span>
                <b>{l.dem_goi ? `${l.so_goi} ${l.don_vi_goi} · ` : ''}{dinhDangKg(l.so_kg, nn)} kg</b>
                {chuTang(soTangCua(l), nn) && <span class="quet-tang">{chuTang(soTangCua(l), nn)}{laLoNhan(l) ? ` · ${t.loNhan(dvNhan)}` : ''}</span>}
                {vanHanh && viecVoiLo(l, nn).length > 0 && (
                  <div class="quet-lo-nut">
                    {viecVoiLo(l, nn).map(v => (
                      <a class="nb-nut phu" href={v.link} aria-label={t.viecLo(v.ten, [l.ma_lo, chuTang(soTangCua(l), nn)].filter(Boolean).join(' · '), l.ten_vi_tri)}>
                        <BieuTuong ten={BIEU_TUONG_VIEC[v.ma]} co={18} />{v.ten}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      {phienMo.length > 0 && (
        <div class="quet-pha">
          <h3>{t.vuaPha}</h3>
          {phienMo.map(p => (
            <form method="POST">
              <input type="hidden" name="viec" value="them_pha" />
              <input type="hidden" name="phien_id" value={p.id} />
              <input type="hidden" name="ma_gui" value={maGui} />
              <input type="hidden" name="ma" value={maNhap} />
              <button type="submit" class="nb-nut"><BieuTuong ten="dao" co={20} />{t.themPha(p.so_phieu, p.ten_mat_hang_vao)}</button>
            </form>
          ))}
        </div>
      )}

      <div class="kho-nhanh-luoi" style="margin-top:1rem">
        {vanHanh && (
          <>
            {loRaQuay && <a class="nb-nut" href={linkLo('chuyen', loRaQuay)}><BieuTuong ten="chuyen" co={20} />{t.raQuay}</a>}
            {!nhanHetHan && <a class="nb-nut phu" href={linkLo('xuat_bep', loDuaBep)}><BieuTuong ten="bep" co={20} />{t.duaBep}</a>}
            <a class={nhanHetHan ? 'nb-nut' : 'nb-nut phu'} href={linkLo('huy', loBaoHuy)}><BieuTuong ten="huy" co={20} />{t.baoHuy}</a>
          </>
        )}
        {laQuay && vanHanh && (
          <a class="nb-nut phu" href="/noi-bo/kho/quay/dem"><BieuTuong ten="kiem_ke" co={20} />{t.demQuay}</a>
        )}
        <a class="nb-nut phu" href={linkTheKho(mh.id)}><BieuTuong ten="bao_cao" co={20} />{t.theKho}</a>
        <a class="nb-nut phu" href={`/noi-bo/kho/ton?q=${encodeURIComponent(mh.ma)}`}><BieuTuong ten="ton" co={20} />{t.xemTon}</a>
      </div>
    </section>
  )}
</Kho>

<style>
  .quet-nguon { margin: .35rem 0 0; font-weight: 700; }
  .kho-quet-kq .nb-bao { margin: .6rem 0 0; }
  /* Số tảng nằm một dòng riêng, rộng hết thẻ — thứ duy nhất ghi trên túi tảng và in trên tem khay. */
  .quet-tang { grid-column: 1 / -1; font-weight: 700; color: var(--than); }
  .kho-quet-vt li.lo-nhan { border-left: 4px solid var(--do); padding-left: .6rem; }
  .quet-lo-nut { grid-column: 1 / -1; display: flex; gap: .4rem; flex-wrap: wrap; }
  .quet-lo-nut .nb-nut {
    min-height: 48px; padding: .45rem .75rem; font-size: .85rem; gap: .35rem;
    display: inline-flex; align-items: center; flex: 1 1 7rem; justify-content: center;
  }
  .quet-pha { margin-top: 1rem; }
  .quet-pha h3 { font-size: .95rem; margin: 0 0 .4rem; }
  .quet-pha form + form { margin-top: .4rem; }
  .quet-pha .nb-nut { width: 100%; min-height: 48px; gap: .5rem; justify-content: flex-start; }
</style>
