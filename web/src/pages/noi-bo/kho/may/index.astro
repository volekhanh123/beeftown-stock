---
/**
 * KHO — "AI ĐANG DÙNG MÁY?" (máy tính bảng dùng chung, GĐ5d, 0034)
 *
 * Màn của tablet đang KHÓA (phiên hiện tại là tài khoản máy): mỗi người đã
 * gắn vào máy là một nút tên lớn → ô PIN → đúng thì máy đổi sang phiên của
 * chính người đó (lib/kho/may-chung.ts) và mở trang chủ kho.
 *
 * Cũng là nơi nhận:
 *   · POST viec=khoa  — nút "Khóa máy" trong menu người dùng (Kho.astro)
 *   · POST viec=go    — "Gỡ tôi khỏi máy này"
 *   · GET ?khoa=1     — may-chung.js hết giờ
 *   · GET ?giu=1      — may-chung.js báo "vẫn đang dùng" (204, không dữ liệu)
 *
 * Sai PIN: câu dễ hiểu (còn N lần / đã khóa tới HH:MM). Không có token nào
 * trong HTML hay URL — ?chon= chỉ là mã nhân sự để hiện ô PIN.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import {
  giuMay, khoaMay, moKhoaNguoi, goToiKhoiMay, docManKhoa, layKhoaMay, laVaiMay, gioPhut, DUONG_MAY,
  type ManKhoa,
} from '../../../../lib/kho/may-chung.ts';
import { kqHai, laUuid, TEN_VAI_KHO_NB, type HaiThuTieng, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

// Nhịp "vẫn đang dùng" của may-chung.js: không cần đọc chi nhánh hay số đỏ.
if (Astro.url.searchParams.get('giu') === '1') return await giuMay(Astro);

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;

const batMay = !!(await layKhoaMay());
const laMay = laVaiMay(k.nhanSu.vai_tro);
const dangDung = !!k.may?.nhanSuId && k.may.nhanSuId === k.nhanSu.id;

let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'mo' && laMay) {
    const ns = String(form.get('nhan_su_id') ?? '');
    const kq = await moKhoaNguoi(Astro, ns, String(form.get('pin') ?? '').trim());
    return chuyenHuong(Astro, kq.ok ? '/noi-bo/kho' : `${DUONG_MAY}${laUuid(ns) ? `?chon=${ns}` : ''}`, kq);
  }
  if (viec === 'khoa' && dangDung) return chuyenHuong(Astro, DUONG_MAY, await khoaMay(Astro, 'bam'));
  if (viec === 'go' && dangDung) return chuyenHuong(Astro, DUONG_MAY, await goToiKhoiMay(Astro, k.may!));
  bao = kqHai(false, { vi: 'Việc không hợp lệ. Tải lại trang.', en: 'Invalid action. Reload the page.' });
} else if (Astro.url.searchParams.get('khoa') === '1' && dangDung) {
  return chuyenHuong(Astro, DUONG_MAY, await khoaMay(Astro, 'het_gio'));
}

// Màn khóa: đọc máy và người đã gắn bằng phiên máy.
let man: ManKhoa | null = null;
let loiDoc: string | null = null;
if (batMay && laMay && k.nhanSu.vai_tro === ('may_chung' as string)) {
  const r = await docManKhoa(Astro, k.client, nn);
  if (typeof r === 'string') loiDoc = r; else man = r;
}

const chonId = Astro.url.searchParams.get('chon');
const chon = man?.nguoi.find(n => n.nhan_su_id === chonId && n.coPhien) ?? null;
const coPhien = man?.nguoi.filter(n => n.coPhien) ?? [];
const canGanLai = man?.nguoi.filter(n => !n.coPhien) ?? [];
const TEN_VAI: Record<string, HaiThuTieng> = {
  chu_so_huu: { vi: 'Chủ nhà hàng', en: 'Owner' }, quan_ly: { vi: 'Quản lý', en: 'Manager' }, ...TEN_VAI_KHO_NB,
};
const t = dichNB(nn, {
  tieuDe: { vi: 'Ai đang dùng máy?', en: 'Who is using this tablet?' },
  mayDungChung: { vi: 'Máy dùng chung', en: 'Shared tablet' },
  chuaBat: { vi: 'Máy dùng chung chưa được bật.', en: 'The shared tablet feature is not turned on.' },
  canDat: { vi: 'Người quản trị cần đặt bí mật', en: 'The administrator needs to set the' },
  choWorker: { vi: 'cho Worker trên Cloudflare (xem web/KHO.md).', en: 'secret for the Worker on Cloudflare (see web/KHO.md).' },
  trongLucCho: {
    vi: 'Trong lúc chờ, mỗi người đăng nhập bằng tài khoản của mình như bình thường.',
    en: 'Meanwhile, everyone logs in with their own account as usual.',
  },
  taiKhoanMay: { vi: 'Tài khoản máy', en: 'Device account' },
  taiKhoanMayGiai: {
    vi: 'Tài khoản này dành cho máy đồng bộ bán hàng, không dùng để mở kho trên máy tính bảng.',
    en: 'This account is for the sales sync device; it is not used to open inventory on a tablet.',
  },
  mayBiKhoa: { vi: 'Máy đang bị khóa', en: 'The tablet is locked' },
  saiNhieuLan: { vi: 'vì nhập sai PIN quá nhiều lần.', en: 'because of too many wrong PINs.' },
  qlMoKhoa: {
    vi: 'Quản lý mở khóa ở Cài đặt → Nhân viên và máy (trên điện thoại hoặc máy tính của quản lý).',
    en: "A manager unlocks it in Setup → Staff and shared tablets (on the manager's phone or computer).",
  },
  tenBiKhoa: {
    vi: (gio: string) => `Tên này đang bị khóa tới ${gio} vì nhập sai PIN nhiều lần.`,
    en: (gio: string) => `This name is locked until ${gio} because of too many wrong PINs.`,
  },
  nhapPin: { vi: 'Nhập PIN của bạn', en: 'Enter your PIN' },
  moMay: { vi: 'Mở máy', en: 'Unlock' },
  chonNguoiKhac: { vi: 'Chọn người khác', en: 'Choose someone else' },
  biKhoaToi: { vi: (gio: string) => `Bị khóa tới ${gio}`, en: (gio: string) => `Locked until ${gio}` },
  chuaAiGan: { vi: 'Chưa ai gắn vào máy này. Bấm', en: 'Nobody has been added to this tablet yet. Tap' },
  ganToiNgoac: { vi: '"Gắn tôi vào máy này"', en: '"Add me to this tablet"' },
  benDuoi: { vi: 'bên dưới, đăng nhập một lần và đặt PIN.', en: 'below, log in once and set a PIN.' },
  canDangNhapLai: { vi: 'Cần đăng nhập lại trên máy này:', en: 'Need to log in again on this tablet:' },
  canDangNhapLaiGiai: {
    vi: 'Máy không còn giữ đăng nhập của những người này. Bấm "Gắn tôi vào máy này" và đăng nhập lại.',
    en: 'The tablet no longer holds these people\'s logins. Tap "Add me to this tablet" and log in again.',
  },
  ganToi: { vi: 'Gắn tôi vào máy này', en: 'Add me to this tablet' },
  dangKyLai: { vi: 'Đăng ký lại máy (quản lý)', en: 'Register this tablet again (manager)' },
  banDangDung: {
    vi: (ten: string) => `Bạn đang dùng máy${ten ? ` "${ten}"` : ''}`,
    en: (ten: string) => `You are using the tablet${ten ? ` "${ten}"` : ''}`,
  },
  tuKhoa: {
    vi: (phut: number | undefined) => `Máy tự khóa sau ${phut ?? ''} phút không dùng. Xong việc thì bấm "Khóa máy" để người sau không làm dưới tên bạn.`,
    en: (phut: number | undefined) => `The tablet locks itself after ${phut ?? ''} ${phut === 1 ? 'minute' : 'minutes'} unused. When you are done, tap "Lock tablet" so the next person does not work under your name.`,
  },
  khoaMay: { vi: 'Khóa máy', en: 'Lock tablet' },
  veTrangChu: { vi: 'Về trang chủ kho', en: 'Back to inventory home' },
  doiPin: { vi: 'Đổi PIN của tôi', en: 'Change my PIN' },
  goToi: { vi: 'Gỡ tôi khỏi máy này', en: 'Remove me from this tablet' },
  mayTinhBang: { vi: 'Máy tính bảng dùng chung', en: 'Shared tablets' },
  gioiThieu: {
    vi: 'Máy ở quầy hoặc bếp nhiều người cùng dùng: mỗi người chọn tên mình và nhập PIN, máy tự khóa sau vài phút',
    en: 'A counter or kitchen tablet that many people share: each person chooses their name and enters a PIN, and the tablet locks itself after a few minutes',
  },
  gioiThieu2: {
    vi: 'không dùng. Việc ai làm vẫn ghi đúng tên người đó.',
    en: 'unused. Whatever each person does is still recorded under their own name.',
  },
  caiMayMoi: { vi: 'Cài một máy mới', en: 'Set up a new tablet' },
  buoc1a: { vi: 'Chủ nhà hàng tạo một tài khoản', en: 'The owner creates a' },
  buoc1b: { vi: 'Máy tính bảng dùng chung', en: 'Shared tablet' },
  buoc1c: { vi: 'ở Cài đặt → Nhân viên và máy.', en: 'account in Setup → Staff and shared tablets.' },
  buoc2a: { vi: 'Quản lý mở trang này', en: 'A manager opens this page' },
  buoc2b: { vi: 'trên chính máy tính bảng đó', en: 'on that tablet itself' },
  buoc2c: { vi: ', bấm "Đăng ký máy này" và nhập tài khoản máy.', en: ', taps "Register this tablet" and enters the tablet account.' },
  buoc3: {
    vi: 'Từng người bấm "Gắn tôi vào máy này", đăng nhập một lần và đặt PIN 4–6 số.',
    en: 'Each person taps "Add me to this tablet", logs in once and sets a 4–6 digit PIN.',
  },
  dangKyMayNay: { vi: 'Đăng ký máy này', en: 'Register this tablet' },
});
---
<Kho k={k} huongDan="mo-may-pin" tieuDe={t.tieuDe}>
  {!batMay ? (
    <>
      <h1>{t.mayDungChung}</h1>
      <BaoKho bao={bao} loiDoc={k.loiDoc} />
      <div class="nb-bao luu-y">
        <p><strong>{t.chuaBat}</strong></p>
        <p>{t.canDat} <code>KHO_MAY_KHOA</code> {t.choWorker}
          {' '}{t.trongLucCho}</p>
      </div>
    </>
  ) : laMay && k.nhanSu.vai_tro !== ('may_chung' as string) ? (
    <>
      <h1>{t.taiKhoanMay}</h1>
      <BaoKho bao={bao} loiDoc={k.loiDoc} />
      <p class="nb-dan">{t.taiKhoanMayGiai}</p>
    </>
  ) : laMay ? (
    <>
      <h1>{t.tieuDe}</h1>
      {man && <p class="kho-phu may-ten">{man.may.ten}{man.may.ten_chi_nhanh ? ` · ${man.may.ten_chi_nhanh}` : ''}</p>}
      <BaoKho bao={bao} loiDoc={loiDoc} />

      {man?.may.bi_khoa && (
        <div class="nb-bao loi" role="alert">
          <p><strong>{t.mayBiKhoa}</strong> {t.saiNhieuLan}</p>
          <p>{t.qlMoKhoa}</p>
        </div>
      )}

      {man && !man.may.bi_khoa && chon && (
        <form method="POST" class="nb-the may-pin">
          <input type="hidden" name="viec" value="mo" />
          <input type="hidden" name="nhan_su_id" value={chon.nhan_su_id} />
          <p class="may-pin-ten"><strong>{chon.ho_ten}</strong></p>
          {chon.khoa_den && (
            <p class="nb-bao loi">{t.tenBiKhoa(gioPhut(chon.khoa_den))}</p>
          )}
          <label class="nb-o">
            <span>{t.nhapPin}</span>
            <input type="password" name="pin" inputmode="numeric" pattern="[0-9]*" autocomplete="off"
              minlength="4" maxlength="6" required autofocus class="may-o-pin" />
          </label>
          <button type="submit" class="nb-nut may-nut-mo">{t.moMay}</button>
          <a href={DUONG_MAY} class="nb-nut phu may-nut-mo">{t.chonNguoiKhac}</a>
        </form>
      )}

      {man && !man.may.bi_khoa && !chon && (
        coPhien.length > 0 ? (
          <ul class="may-luoi">
            {coPhien.map(n => (
              <li>
                <a href={`${DUONG_MAY}?chon=${n.nhan_su_id}`} class="may-nguoi">
                  <strong>{n.ho_ten}</strong>
                  <span>{n.khoa_den ? t.biKhoaToi(gioPhut(n.khoa_den)) : (TEN_VAI[n.vai_tro]?.[nn] ?? '')}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="nb-bao luu-y">
            <p>{t.chuaAiGan} <strong>{t.ganToiNgoac}</strong> {t.benDuoi}</p>
          </div>
        )
      )}

      {canGanLai.length > 0 && !chon && (
        <div class="nb-the">
          <p style="margin-top:0"><strong>{t.canDangNhapLai}</strong>{' '}{canGanLai.map(n => n.ho_ten).join(', ')}.</p>
          <p class="kho-phu" style="margin-bottom:0">{t.canDangNhapLaiGiai}</p>
        </div>
      )}

      <div class="may-duoi">
        <a href={`${DUONG_MAY}/gan`} class="nb-nut phu">{t.ganToi}</a>
        <a href={`${DUONG_MAY}/dang-ky`} class="nb-nut phu">{t.dangKyLai}</a>
      </div>
    </>
  ) : dangDung ? (
    <>
      <h1>{t.banDangDung(k.may?.tenMay ?? '')}</h1>
      <BaoKho bao={bao} loiDoc={k.loiDoc} />
      <p class="nb-dan">{t.tuKhoa(k.may?.phutKhoa)}</p>
      <div class="may-duoi">
        <form method="POST">
          <input type="hidden" name="viec" value="khoa" />
          <button type="submit" class="nb-nut">{t.khoaMay}</button>
        </form>
        <a href="/noi-bo/kho" class="nb-nut phu">{t.veTrangChu}</a>
        <a href={`${DUONG_MAY}/gan`} class="nb-nut phu">{t.doiPin}</a>
        <form method="POST">
          <input type="hidden" name="viec" value="go" />
          <button type="submit" class="nb-nut phu">{t.goToi}</button>
        </form>
      </div>
    </>
  ) : (
    <>
      <h1>{t.mayTinhBang}</h1>
      <BaoKho bao={bao} loiDoc={k.loiDoc} />
      <p class="nb-dan">
        {t.gioiThieu}
        {' '}{t.gioiThieu2}
      </p>
      <div class="nb-the">
        <p style="margin-top:0"><strong>{t.caiMayMoi}</strong></p>
        <ol style="margin:0;padding-left:1.2rem">
          <li>{t.buoc1a} <em>{t.buoc1b}</em> {t.buoc1c}</li>
          <li>{t.buoc2a} <strong>{t.buoc2b}</strong>{t.buoc2c}</li>
          <li>{t.buoc3}</li>
        </ol>
      </div>
      {k.duoc('duyet') && (
        <div class="may-duoi">
          <a href={`${DUONG_MAY}/dang-ky`} class="nb-nut">{t.dangKyMayNay}</a>
        </div>
      )}
    </>
  )}
</Kho>

<style>
  .may-ten { margin: -.5rem 0 1rem; font-size: 1rem; }
  .may-luoi {
    list-style: none; margin: 0 0 1.25rem; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: .75rem;
  }
  .may-nguoi {
    display: flex; flex-direction: column; justify-content: center; gap: .2rem;
    min-height: 88px; padding: .9rem 1rem; border-radius: 14px;
    background: #fff; border: 2px solid var(--vach, #ddd); color: inherit; text-decoration: none;
  }
  .may-nguoi strong { font-size: 1.15rem; }
  .may-nguoi span { font-size: .85rem; color: var(--muc-nhat, #666); }
  .may-nguoi:hover, .may-nguoi:focus-visible { border-color: var(--do, #b3261e); }
  .may-pin { max-width: 26rem; }
  .may-pin-ten { margin-top: 0; font-size: 1.2rem; }
  .may-o-pin { font-size: 1.6rem; letter-spacing: .5rem; text-align: center; }
  .may-nut-mo { width: 100%; margin-top: .5rem; text-align: center; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
  .may-duoi { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.25rem 0; }
  .may-duoi form { margin: 0; }
</style>
