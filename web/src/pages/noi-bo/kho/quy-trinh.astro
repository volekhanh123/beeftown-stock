---
/**
 * KHO — QUY TRÌNH
 *
 * Giống màn "Nghiệp vụ" của iPOS: chọn một nghiệp vụ, thấy các bước đánh số,
 * mỗi bước một câu giải thích và nút "Làm bước này". Bước đang có việc chờ
 * thì có số đỏ. Bước không phải việc của mình thì ghi rõ việc của ai.
 *
 * Hai thứ tiếng: câu của trang ở bảng t; tên, giới thiệu, bước của từng quy
 * trình là cặp { vi, en } trong quy-trinh.ts — luôn đọc [nn].
 */
import Kho from '../../../layouts/Kho.astro';
import TheTrangCon from '../../../components/kho/TheTrangCon.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import { QUY_TRINH, timQuyTrinh } from '../../../lib/kho/quy-trinh.ts';
import { soDo, nhanSo } from '../../../lib/kho/dieu-huong.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
const t = dichNB(nn, {
  h1: { vi: 'Quy trình', en: 'Workflows' },
  chonNghiepVu: { vi: 'Chọn nghiệp vụ', en: 'Choose a workflow' },
  quyTrinh: { vi: (ten: string) => `Quy trình ${ten.toLowerCase()}`, en: (ten: string) => `${ten} workflow` },
  soBuoc: { vi: (n: number) => `${n} bước`, en: (n: number) => `${n} ${n === 1 ? 'step' : 'steps'}` },
  lamBuocNay: { vi: 'Làm bước này', en: 'Do this step' },
  viecCua: { vi: (ai: string) => `Việc của ${ai}`, en: (ai: string) => `Done by: ${ai}` },
});
const qt = timQuyTrinh(Astro.url.searchParams.get('qt'));
const soCuaQt = (q: typeof qt) => q.buoc.reduce((s, b) => s + (b.quyen.some(x => k.duoc(x)) ? soDo(b, k.viec) : 0), 0);
---
<Kho k={k} tieuDe={t.quyTrinh(qt.ten[nn])} huongDan="quy-trinh">
  <TheTrangCon k={k} cha="huong_dan" />
  <h1>{t.h1}</h1>

  <nav class="kho-the-chon" aria-label={t.chonNghiepVu}>
    {QUY_TRINH.map(q => {
      const so = soCuaQt(q);
      return (
        <a href={`/noi-bo/kho/quy-trinh?qt=${q.ma}`} aria-current={q.ma === qt.ma ? 'page' : undefined}>
          {q.ten[nn]}{so > 0 && <b class="kho-so-do">{nhanSo(so)}</b>}
        </a>
      );
    })}
  </nav>

  <section class="nb-the kho-qt">
    <header class="kho-qt-dau">
      <span class="kho-qt-bt"><BieuTuong ten={qt.bieuTuong} co={26} /></span>
      <div>
        <h2>{t.quyTrinh(qt.ten[nn])}</h2>
        <p>{t.soBuoc(qt.buoc.length)} · {qt.gioiThieu[nn]}</p>
      </div>
    </header>
    <ol class="kho-qt-buoc">
      {qt.buoc.map((b, i) => {
        const duocLam = b.quyen.some(x => k.duoc(x));
        const so = duocLam ? soDo(b, k.viec) : 0;
        return (
          <li class:list={{ 'khong-phai-minh': !duocLam }}>
            <span class="kho-qt-so">{i + 1}</span>
            <div>
              <strong>{b.ten[nn]}{so > 0 && <> <b class="kho-so-do">{nhanSo(so)}</b></>}</strong>
              <p>{b.moTa[nn]}</p>
              {duocLam
                ? <a class="nb-nut phu" href={b.link}>{b.nut?.[nn] ?? t.lamBuocNay}</a>
                : <small>{t.viecCua(b.ai[nn])}</small>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</Kho>
