  hetBuocDem: { vi: 'Phiếu không còn ở bước đếm.', en: 'This sheet is no longer at the counting step.' },
  mayKhacGui: {
    vi: 'Phiếu vừa được gửi ở máy khác — không còn ở bước đếm.',
    en: 'This sheet was just sent from another device — it is no longer at the counting step.',
  },
  luuOTrong: { vi: 'Đã lưu số đếm. Ô quét đang trống — chưa đọc nhãn nào.', en: 'Counts saved. The scan box is empty — no labels read yet.' },
  daLuuDem: { vi: 'Đã lưu số đếm.', en: 'Counts saved.' },
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
