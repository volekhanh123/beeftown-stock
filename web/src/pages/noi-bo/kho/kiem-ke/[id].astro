    en: (ten: string) => `The two devices entered different numbers for: ${ten} — showing the other device's numbers. Count that line again if needed.`,
  },
  chuaGui: { vi: 'Phiếu CHƯA gửi quản lý.', en: 'The sheet has NOT been sent to the manager.' },
  suaLoi: {
    vi: (cau: string) => `${cau} Sửa chỗ báo lỗi rồi bấm "Lưu số đếm".`,
    en: (cau: string) => `${cau} Fix what is flagged, then press "Save counts".`,
  },
  moTaLo: { vi: (ma: string, han: string) => `lô ${ma} · HSD ${han}`, en: (ma: string, han: string) => `lot ${ma} · use by ${han}` },
  loNgoac: { vi: (ma: string) => ` (lô ${ma})`, en: (ma: string) => ` (lot ${ma})` },
  gioNgay: { vi: (gio: string, ngay: string) => `${gio} ngày ${ngay}`, en: (gio: string, ngay: string) => `${gio} on ${ngay}` },
  kiemKe: { vi: 'Kiểm kê', en: 'Stocktake' },
  kiemKeO: { vi: (noi: string) => `Kiểm kê ${noi}`, en: (noi: string) => `Stocktake: ${noi}` },
