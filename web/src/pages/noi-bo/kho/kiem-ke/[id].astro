const t = dichNB(nn, {
  khongDoc: { vi: 'Không đọc được phiếu kiểm kê.', en: 'Could not read the stocktake sheet.' },
  mayKhacLuu: {
    vi: 'Có người vừa lưu phiếu này ở máy khác — đã tải lại số mới nhất, kiểm tra rồi lưu lại.',
    en: 'Someone just saved this sheet on another device — the latest numbers have been loaded; check them, then save again.',
