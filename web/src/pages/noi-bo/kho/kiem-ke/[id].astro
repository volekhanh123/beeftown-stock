---
/**
 * KHO — MỘT PHIẾU KIỂM KÊ
 *
 *   · ĐANG ĐẾM (vai vận hành): ghi số đếm từng dòng. KHÔNG hiện số trên sổ —
 *     đếm mù cho đúng. Quầy: quét hết nhãn các gói → tự ra số gói và kg.
 *     "Gửi duyệt" = lưu rồi gửi; database chụp sổ sách lúc đó.
 *   · CHỜ DUYỆT: bảng sổ — đếm — chênh (kèm giá trị chênh với vai xem giá).
 *     Quản lý duyệt, hoặc trả về để đếm lại.
 *   · ĐÃ DUYỆT: từng lô trước → sau.
 */
import NoiBo from '../../../../layouts/NoiBo.astro';
import DieuHuongKho from '../../../../components/kho/DieuHuongKho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import QuetMa from '../../../../components/kho/QuetMa.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import { docCaiDat, docMatHang, type CaiDat, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import { docThongTinLo, docGiaVonLo } from '../../../../lib/kho/pha-loc.ts';
import {
  docKiemKe, docFormKiemKe, payloadTuDong, apDungQuet, dongDemTuDb, luuKiemKe, guiKiemKe, duyetKiemKe,
  tuChoiKiemKe, huyKiemKe, type KiemKe, type DongKiemKe, type LoKiemKe, type DongDemForm,
} from '../../../../lib/kho/kiem-ke.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, TRANG_THAI_CHUNG_TU, type KetQua,
} from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);

let matHang: MatHang[] = [];
let caiDat: CaiDat | null = null;
let kk: KiemKe | null = null;
let dongDb: DongKiemKe[] = [];
let loDb: LoKiemKe[] = [];
let loiDoc = k.loiDoc;
try {
  const [mh, cd, doc] = await Promise.all([
    docMatHang(k.client), docCaiDat(k.client, k.chiNhanh.id), docKiemKe(k.client, Astro.params.id ?? ''),
  ]);
  matHang = mh; caiDat = cd;
  if (doc) { kk = doc.kk; dongDb = doc.dong; loDb = doc.lo; }
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được phiếu kiểm kê.');
}
if (!kk && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/kiem-ke', { ok: false, cau: 'Không tìm thấy phiếu kiểm kê này.' });
}

const demDuoc = !!kk && kk.trang_thai === 'dang_dem' && k.duoc('van_hanh');

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
let dongLoi: DongDemForm[] | null = null;
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form && kk) {
  const viec = String(form.get('viec') ?? '');
  const ve = (kq: KetQua) => chuyenHuong(Astro, `/noi-bo/kho/kiem-ke/${kk!.id}`, kq);
  const phienBan = Number(form.get('phien_ban') ?? kk.phien_ban);
  const ghiChu = String(form.get('ghi_chu') ?? '').trim() || null;

  if (['luu', 'gui', 'quet'].includes(viec)) {
    if (!demDuoc) {
      bao = { ok: false, cau: 'Phiếu không còn ở bước đếm.' };
    } else {
      const doc = docFormKiemKe(form, matHang);
      let payload = doc.payload;
      let loi = doc.loi;
      let cauQuet = '';
      if (viec === 'quet') {
        const q = apDungQuet(doc.dong, String(form.get('ma_quet') ?? ''), matHang, caiDat?.mau_ma_vach, caiDat?.so_le_kg ?? 3);
        const p = payloadTuDong(q.dong, matHang);
        payload = p.payload; loi = p.loi;
        dongLoi = q.dong;
        cauQuet = q.soMa === 0 ? ' Ô quét đang trống.'
          : ` Đã đọc ${q.soMa} mã → ${q.soHang} mặt hàng.${q.loi.length ? ` Chưa đọc được: ${q.loi.join(' · ')}` : ''}`;
      } else {
        dongLoi = doc.dong;
      }
      if (loi.length) {
        bao = { ok: false, cau: loi.join(' · ') + cauQuet };
      } else {
        const luu = await luuKiemKe(k.client, kk.id, phienBan, ghiChu, payload);
        if (!luu.ok) {
          bao = { ok: false, cau: luu.cau + cauQuet };
        } else if (viec === 'gui') {
          const g = await guiKiemKe(k.client, kk.id, luu.phienBan ?? phienBan);
          return ve(g.ok ? g : { ok: false, cau: `Đã lưu số đếm nhưng CHƯA gửi được: ${g.cau}` });
        } else {
          return ve({ ok: true, cau: luu.cau + cauQuet });
        }
      }
    }
  } else {
    const lyDo = String(form.get('ly_do') ?? '').trim();
    let kq: KetQua;
    if (viec === 'duyet') kq = await duyetKiemKe(k.client, kk.id);
    else if (viec === 'tu_choi') kq = await tuChoiKiemKe(k.client, kk.id, lyDo);
    else if (viec === 'huy') kq = await huyKiemKe(k.client, kk.id, lyDo || null);
    else kq = { ok: false, cau: 'Việc không hợp lệ.' };
    return ve(kq);
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const tenMh = new Map(matHang.map(m => [m.id, m]));
const theoLo = kk?.kieu === 'theo_lo';
const dongHien: DongDemForm[] = dongLoi ?? dongDemTuDb(dongDb);
const loIds = [...dongDb.map(d => d.lo_id ?? ''), ...loDb.map(l => l.lo_id)];
const thongTinLo = await docThongTinLo(k.client, loIds);
const giaLo = kk && kk.trang_thai !== 'dang_dem' ? await docGiaVonLo(k.client, loDb.map(l => l.lo_id)) : new Map();
const coGia = giaLo.size > 0;
const ten = kk ? await tenNhanSu(k.client, [kk.nguoi_tao, kk.nguoi_gui, kk.nguoi_duyet]) : new Map<string, string>();
const [nhanTT, lopTT] = kk ? (TRANG_THAI_CHUNG_TU[kk.trang_thai] ?? [kk.trang_thai, 'tat']) : ['', ''];

// Chênh lệch từng dòng (sau khi gửi). Kg chênh của dòng đếm gói mà không cân
// là ƯỚC TÍNH theo kg trung bình mỗi gói — con số thật do database tính lúc duyệt.
const loTheoDong = new Map<string, LoKiemKe[]>();
for (const l of loDb) loTheoDong.set(l.kiem_ke_dong_id, [...(loTheoDong.get(l.kiem_ke_dong_id) ?? []), l]);
const chenh = (d: DongKiemKe) => {
  const mh = tenMh.get(d.mat_hang_id);
  const gSo = d.so_goi_so ?? 0, kSo = d.so_kg_so ?? 0;
  const dg = mh?.dem_goi ? (d.so_goi_dem ?? 0) - gSo : 0;
  let dk: number | null;
  let uoc = false;
  if (d.so_kg_dem !== null) dk = d.so_kg_dem - kSo;
  else if (mh?.dem_goi && gSo > 0) { dk = (dg * kSo) / gSo; uoc = true; }
  else if (mh?.dem_goi && dg === 0) dk = 0;
  else dk = null;
  const lo = loTheoDong.get(d.id) ?? [];
  const tongKg = lo.reduce((s, l) => s + l.so_kg_so, 0);
  const tongGiaTri = lo.reduce((s, l) => s + l.so_kg_so * (giaLo.get(l.lo_id)?.gia_von_kg ?? 0), 0);
  const giaTb = tongKg > 0 ? tongGiaTri / tongKg : (lo[0] ? giaLo.get(lo[0].lo_id)?.gia_von_kg ?? 0 : 0);
  return { dg, dk: dk === null ? null : Math.round(dk * 1000) / 1000, uoc, giaTri: dk === null ? null : dk * giaTb };
};
const tongGiaTriChenh = kk && kk.trang_thai !== 'dang_dem'
  ? dongDb.reduce((s, d) => s + (chenh(d).giaTri ?? 0), 0) : 0;
const coChenh = (d: DongKiemKe) => { const c = chenh(d); return c.dg !== 0 || (c.dk !== null && c.dk !== 0); };
const moTaLo = (id: string | null) => {
  if (!id) return '';
  const l = thongTinLo.get(id);
  return l ? `lô ${l.ma_lo} · HSD ${dinhDangNgay(l.han_dung)}` : '';
};
const tieuDe = kk ? `Kiểm kê ${kk.ten_vi_tri}` : 'Kiểm kê';
---
<NoiBo tieuDe={tieuDe} nhanSu={k.nhanSu}>
  <h1>{tieuDe}</h1>
  <DieuHuongKho vai={k.nhanSu.vai_tro} chiNhanh={k.chiNhanh} cacChiNhanh={k.cacChiNhanh} />
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {kk && (
    <>
      <p class="nb-dan">
        <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
        {' · '}{kk.so_phieu} · {kk.kieu === 'theo_lo' ? 'đếm từng lô' : 'đếm theo mặt hàng'} · ngày {dinhDangNgay(kk.ngay_kiem)}
        {' · '}mở bởi {ten.get(kk.nguoi_tao ?? '') ?? '—'} {dinhDangThoiDiem(kk.created_at)}
        {kk.gui_luc && <>{' · '}gửi bởi {ten.get(kk.nguoi_gui ?? '') ?? '—'} {dinhDangThoiDiem(kk.gui_luc)}</>}
        {kk.duyet_luc && <>{' · '}duyệt bởi {ten.get(kk.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(kk.duyet_luc)}</>}
      </p>
      {kk.ly_do && <div class="nb-bao luu-y"><p><strong>{kk.trang_thai === 'da_huy' ? 'Lý do hủy' : 'Quản lý trả về'}:</strong> {kk.ly_do}</p></div>}

      {demDuoc ? (
        // ===================================================================
        // ĐANG ĐẾM
        // ===================================================================
        <form method="POST">
          <input type="hidden" name="phien_ban" value={String(kk.phien_ban)} />
          <input type="hidden" name="so_dong" value={String(dongHien.length)} />
          <p class="nb-dan">Ghi đúng số đang thấy. Không còn thì ghi <strong>0</strong> và tích <em>Đã hết thật</em>. Số trên sổ sẽ hiện sau khi gửi.</p>

          {!theoLo && (
            <div class="nb-the">
              <QuetMa nhan="Đọc mã và ghi số đếm" goiY="Quét lần lượt nhãn của MỌI gói đang có — mỗi mặt hàng quét được sẽ lấy đúng số gói và tổng kg vừa quét (thay cho số đang ghi)." />
            </div>
          )}

          {dongHien.length === 0 && <p class="nb-rong">Vị trí này đang trống trên sổ. Thấy hàng thì thêm ở dưới.</p>}
          {dongHien.map((d, i) => {
            const mh = tenMh.get(d.mat_hang_id);
            return (
              <div class="kho-dong-hang">
                <span class="so-thu-tu">{i + 1}</span>
                <input type="hidden" name={`k${i}_mh`} value={d.mat_hang_id} />
                {d.lo_id && <input type="hidden" name={`k${i}_lo`} value={d.lo_id} />}
                <p style="margin:.35rem 0 .5rem"><strong>{mh?.ten ?? '—'}</strong>
                  {d.lo_id && <><br /><span class="kho-phu">{moTaLo(d.lo_id)}</span></>}</p>
                <div class="kho-luoi">
                  {mh?.dem_goi && (
                    <label class="nb-o"><span>Số {mh.don_vi_goi}</span>
                      <input type="text" inputmode="numeric" name={`k${i}_goi`} value={d.goi} /></label>
                  )}
                  <label class="nb-o"><span>{mh?.dem_goi ? 'Kg (nếu cân)' : 'Số kg'}</span>
                    <input type="text" inputmode="decimal" name={`k${i}_kg`} value={d.kg} /></label>
                </div>
                <label class="kho-tich"><input type="checkbox" name={`k${i}_het`} value="co" checked={d.het} /> Đã hết thật (ghi 0)</label>
              </div>
            );
          })}

          {!theoLo && (
            <details class="nb-the">
              <summary style="cursor:pointer;font-weight:600">Thấy mặt hàng không có trong danh sách</summary>
              <div style="margin-top:.75rem">
                <label class="nb-o"><span>Mặt hàng</span><ChonMatHang name="them_mat_hang" matHang={matHang} /></label>
                <div class="kho-luoi">
                  <label class="nb-o"><span>Số gói</span><input type="text" inputmode="numeric" name="them_goi" /></label>
                  <label class="nb-o"><span>Số kg</span><input type="text" inputmode="decimal" name="them_kg" /></label>
                </div>
              </div>
            </details>
          )}

          <label class="nb-o"><span>Ghi chú</span>
            <input type="text" name="ghi_chu" value={kk.ghi_chu ?? ''} maxlength="500" /></label>

          <div class="kho-thanh-nut dinh">
            <button type="submit" name="viec" value="luu" class="nb-nut phu">Lưu số đếm</button>
            <button type="submit" name="viec" value="gui" class="nb-nut">Gửi quản lý duyệt</button>
          </div>
        </form>
      ) : kk.trang_thai === 'dang_dem' ? (
        <p class="nb-rong">Phiếu đang được đếm. Số trên sổ và chênh lệch sẽ hiện sau khi gửi duyệt.</p>
      ) : (
        // ===================================================================
        // CHỜ DUYỆT / ĐÃ DUYỆT / ĐÃ HỦY
        // ===================================================================
        <>
          {kk.trang_thai !== 'da_huy' && (
            <div class="kho-o-so-luoi">
              <div class="kho-o-so"><b>{dongDb.filter(coChenh).length}</b><span>dòng lệch sổ / {dongDb.length}</span></div>
              {coGia && <div class={`kho-o-so ${tongGiaTriChenh < 0 ? 'gap' : ''}`}><b style="font-size:1.2rem">{dinhDangTien(tongGiaTriChenh)}</b><span>giá trị chênh (ước tính)</span></div>}
              {kk.loai_vi_tri === 'quay' && kk.nguon_so_ban === 'kiem_ke' && <div class="kho-o-so"><b style="font-size:1.1rem">Thiếu = bán</b><span>chưa nối iPOS</span></div>}
            </div>
          )}
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr>
                <th>Mặt hàng</th><th class="so">Chênh</th><th class="so">Sổ</th><th class="so">Đếm</th>
                {coGia && <th class="so">Giá trị chênh</th>}
              </tr></thead>
              <tbody>
                {dongDb.map(d => {
                  const mh = tenMh.get(d.mat_hang_id);
                  const c = chenh(d);
                  const dv = mh?.dem_goi ? ` ${mh.don_vi_goi}` : '';
                  return (
                    <tr>
                      <td>{mh?.ten ?? '—'}{d.lo_id && <><br /><span class="kho-phu">{moTaLo(d.lo_id)}</span></>}
                        {d.xac_nhan_het && <><br /><span class="kho-phu">đã xác nhận hết</span></>}</td>
                      <td class="so" style={coChenh(d) ? 'font-weight:700' : ''}>
                        {mh?.dem_goi && c.dg !== 0 ? `${c.dg > 0 ? '+' : ''}${c.dg}${dv}` : ''}
                        {c.dk !== null && c.dk !== 0 ? <>{mh?.dem_goi && c.dg !== 0 && <br />}{c.uoc ? '≈ ' : ''}{c.dk > 0 ? '+' : ''}{dinhDangKg(c.dk)} kg</> : ''}
                        {!coChenh(d) && '0'}
                      </td>
                      <td class="so">{mh?.dem_goi ? `${d.so_goi_so ?? 0}${dv} · ` : ''}{dinhDangKg(d.so_kg_so)} kg</td>
                      <td class="so">{mh?.dem_goi ? `${d.so_goi_dem ?? '—'}${dv}` : ''}{d.so_kg_dem !== null ? `${mh?.dem_goi ? ' · ' : ''}${dinhDangKg(d.so_kg_dem)} kg` : ''}</td>
                      {coGia && <td class="so">{c.giaTri !== null && Math.round(c.giaTri) !== 0 ? dinhDangTien(c.giaTri) : '—'}</td>}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {kk.trang_thai === 'da_duyet' && loDb.length > 0 && (
            <details class="nb-the">
              <summary style="cursor:pointer;font-weight:600">Từng lô: trước → sau khi duyệt</summary>
              <div class="kho-bang-khung" style="margin-top:.75rem">
                <table class="kho-bang">
                  <thead><tr><th>Mặt hàng</th><th>Lô</th><th class="so">Trước</th><th class="so">Sau</th></tr></thead>
                  <tbody>
                    {loDb.map(l => {
                      const d = dongDb.find(x => x.id === l.kiem_ke_dong_id);
                      const mh = d ? tenMh.get(d.mat_hang_id) : undefined;
                      return (
                        <tr>
                          <td>{mh?.ten ?? '—'}</td>
                          <td>{moTaLo(l.lo_id)}</td>
                          <td class="so">{mh?.dem_goi ? `${l.so_goi_so} · ` : ''}{dinhDangKg(l.so_kg_so)} kg</td>
                          <td class="so">{mh?.dem_goi ? `${l.so_goi_moi ?? '—'} · ` : ''}{dinhDangKg(l.so_kg_moi)} kg</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {kk.trang_thai === 'cho_duyet' && k.duoc('duyet') && (
            <div class="nb-the">
              <h2 style="margin-top:0">Duyệt kiểm kê</h2>
              <p class="nb-dan">Duyệt = tồn trên sổ bằng số đếm. {kk.loai_vi_tri === 'quay' && kk.nguon_so_ban === 'kiem_ke' ? 'Phần thiếu ở quầy ghi là đã bán; ' : 'Phần thiếu ghi là chênh lệch kiểm kê; '}phần thừa cộng vào lô mới nhất.</p>
              <form method="POST" class="kho-thanh-nut">
                <button type="submit" name="viec" value="duyet" class="nb-nut">Duyệt kiểm kê</button>
              </form>
              <details>
                <summary style="cursor:pointer;font-weight:600">Trả về để đếm lại</summary>
                <form method="POST" style="margin-top:.75rem">
                  <label class="nb-o"><span>Đếm lại chỗ nào?</span><textarea name="ly_do" required maxlength="500"></textarea></label>
                  <button type="submit" name="viec" value="tu_choi" class="nb-nut kho-nut-xoa">Trả về đếm lại</button>
                </form>
              </details>
            </div>
          )}
          {kk.trang_thai === 'cho_duyet' && !k.duoc('duyet') && (
            <p class="nb-dan">Đang chờ quản lý duyệt.</p>
          )}
        </>
      )}

      {(kk.trang_thai === 'dang_dem' && k.duoc('van_hanh')) || (kk.trang_thai === 'cho_duyet' && k.duoc('duyet')) ? (
        <details class="nb-the" style="margin-top:1.5rem">
          <summary style="cursor:pointer;font-weight:600">Hủy phiếu kiểm kê này</summary>
          <form method="POST" style="margin-top:.75rem">
            <label class="nb-o"><span>Lý do (không bắt buộc)</span><input type="text" name="ly_do" maxlength="500" /></label>
            <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">Hủy phiếu</button>
          </form>
        </details>
      ) : null}
    </>
  )}

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/kiem-ke">← Danh sách kiểm kê</a></p>
</NoiBo>
