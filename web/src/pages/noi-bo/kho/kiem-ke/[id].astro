  soDv: { vi: (dv: string) => `Số ${dv}`, en: (dv: string) => `Number of ${dv}` },
  // 0105: món đếm theo cái có quy đổi thùng
  soThung: { vi: (n: number) => `Số thùng (1 thùng = ${n})`, en: (n: number) => `Cases (1 case = ${n})` },
  soLe: { vi: (dv: string) => `Số ${dv} lẻ`, en: (dv: string) => `Loose ${dv}` },
  kgNeuCan: { vi: 'Kg (nếu cân)', en: 'Kg (if weighed)' },
  soKg: { vi: 'Số kg', en: 'Kg' },
  hetThat: {
    vi: (dv: string | null) => `Đã hết thật — không còn ${dv !== null ? `${dv} nào` : 'gì'}`,
    en: (dv: string | null) => `None left — ${dv !== null ? `no ${dv} left` : 'nothing left'}`,
  },
  thayMatHang: { vi: 'Thấy mặt hàng không có trong danh sách', en: 'Found an item that is not on the list' },
  dangOChoKhac: { vi: 'Sổ ghi đang ở chỗ khác', en: 'Recorded at another place' },
  matHang: { vi: 'Mặt hàng', en: 'Item' },
  soGoi: { vi: 'Số gói', en: 'Packs' },
  ghiChu: { vi: 'Ghi chú', en: 'Note' },
  luuDem: { vi: 'Lưu số đếm', en: 'Save counts' },
  guiDuyet: { vi: 'Gửi quản lý duyệt', en: 'Send to manager for approval' },
  dangDem: {
    vi: 'Phiếu đang được đếm. Số trên sổ và chênh lệch sẽ hiện sau khi gửi quản lý duyệt.',
    en: 'This sheet is being counted. The book numbers and differences show once it is sent for approval.',
  },
  daHuy: { vi: 'Phiếu này đã hủy.', en: 'This sheet was cancelled.' },
  daGuiQl: {
    vi: (luc: string | null) => `Đã gửi quản lý${luc !== null ? ` lúc ${luc}` : ''} — cảm ơn.`,
    en: (luc: string | null) => `Sent to the manager${luc !== null ? ` at ${luc}` : ''} — thank you.`,
  },
  qlDaDuyet: { vi: 'Quản lý đã duyệt số đếm này.', en: 'The manager approved this count.' },
  qlSeXem: {
    vi: 'Quản lý sẽ xem và duyệt. Cần đếm lại thì phiếu được trả về kèm lời nhắn.',
    en: 'The manager will check and approve it. If a recount is needed, the sheet comes back with a note.',
  },
  dongLech: {
    vi: (_n: number, tong: number) => `dòng lệch sổ / ${tong}`,
    en: (n: number, tong: number) => `${s(n, 'line differs', 'lines differ')} from the books / ${tong}`,
  },
  giaTriChenhUoc: { vi: 'giá trị chênh (ước tính)', en: 'value of the difference (estimate)' },
  thieuLaBan: { vi: 'Thiếu = bán', en: 'Missing = sold' },
  chuaNoiIpos: { vi: 'chưa nối iPOS', en: 'iPOS not connected' },
  nhanCongDon: { vi: 'nhãn đã quét cộng dồn', en: 'labels scanned (running)' },
  chenh: { vi: 'Chênh', en: 'Difference' },
  so: { vi: 'Sổ', en: 'Books' },
  dem: { vi: 'Đếm', en: 'Counted' },
  giaTriChenh: { vi: 'Giá trị chênh', en: 'Value of difference' },
  xacNhanHet: { vi: 'đã xác nhận hết', en: 'confirmed none left' },
  quetNhanGhiTay: {
    vi: (n: number, tay: number) => `quét ${n} nhãn${tay > 0 ? ` + ${tay} ghi tay` : ''}`,
    en: (n: number, tay: number) => `${n} ${s(n, 'label', 'labels')} scanned${tay > 0 ? ` + ${tay} typed in` : ''}`,
  },
  tungLo: { vi: 'Từng lô: trước → sau khi duyệt', en: 'Each lot: before → after approval' },
  lo: { vi: 'Lô', en: 'Lot' },
  truoc: { vi: 'Trước', en: 'Before' },
  sau: { vi: 'Sau', en: 'After' },
  duyetKiemKe: { vi: 'Duyệt kiểm kê', en: 'Approve stocktake' },
  duyetLa: { vi: 'Duyệt = tồn trên sổ bằng số đếm. ', en: 'Approving = the book stock becomes the count. ' },
  thieuQuayBan: { vi: 'Phần thiếu ở quầy ghi là đã bán; ', en: 'Anything missing at the counter is recorded as sold; ' },
  thieuChenh: { vi: 'Phần thiếu ghi là chênh lệch kiểm kê; ', en: 'Anything missing is recorded as a stocktake difference; ' },
  thuaLoMoi: { vi: 'phần thừa cộng vào lô mới nhất.', en: 'any surplus is added to the newest lot.' },
  traVeDemLai: { vi: 'Trả về để đếm lại', en: 'Send back for a recount' },
  demLaiCho: { vi: 'Đếm lại chỗ nào?', en: 'What should be recounted?' },
  nutTraVe: { vi: 'Trả về đếm lại', en: 'Send back for recount' },
  choDuyet: { vi: 'Đang chờ quản lý duyệt.', en: 'Waiting for manager approval.' },
  huyPhieuNay: { vi: 'Hủy phiếu kiểm kê này', en: 'Cancel this stocktake sheet' },
  huyLa1: { vi: 'Hủy là ', en: 'Cancelling ' },
  huyLa2: { vi: 'bỏ hết số đã đếm', en: 'throws away every count' },
  huyLa3: {
    vi: ' của phiếu này — không lấy lại được. Chỉ hủy khi mở nhầm.',
    en: ' on this sheet — it cannot be undone. Only cancel if it was opened by mistake.',
  },
  viSaoHuy: { vi: 'Vì sao hủy? (bắt buộc)', en: 'Why cancel? (required)' },
  viDuHuy: { vi: 'vd. mở nhầm vị trí', en: 'e.g. opened the wrong location' },
  huyPhieu: { vi: 'Hủy phiếu', en: 'Cancel sheet' },
  veDuyet: { vi: '← Về trang Duyệt', en: '← Back to Approvals' },
  veDanhSach: { vi: '← Danh sách kiểm kê', en: '← Stocktakes' },
  kyNguoiDem: { vi: 'Người đếm', en: 'Counted by' },
  kyKiemTra: { vi: 'Người kiểm tra', en: 'Checked by' },
  kyQuanLy: { vi: 'Quản lý duyệt', en: 'Approved by manager' },
});

let matHang: MatHang[] = [];
let caiDat: CaiDat | null = null;
let kk: KiemKe | null = null;
let dongDb: DongKiemKe[] = [];
let loDb: LoKiemKe[] = [];
let loiDoc = k.loiDoc;
// Đọc form TRƯỚC khi đọc database: bấm "Đọc mã" thì cần thêm ô mã và mã giảm giá của mọi món (nhãn của khay
// thịt ủ in bằng mã ô, khay cận date in bằng mã giảm) — đọc cùng lượt với danh mục, không thêm lượt chờ.
const form = await docFormGui(Astro);
let maNhan: Awaited<ReturnType<typeof docMaTrenNhan>> | null = null;
try {
  const [mh, cd, doc, ma] = await Promise.all([
    docMatHang(k.client), docCaiDat(k.client, k.chiNhanh.id), docKiemKe(k.client, Astro.params.id ?? ''),
    String(form?.get('viec') ?? '') === 'quet' ? docMaTrenNhan(k.client) : Promise.resolve(null),
  ]);
  matHang = mh; caiDat = cd; maNhan = ma;
  if (doc) { kk = doc.kk; dongDb = doc.dong; loDb = doc.lo; }
} catch (e) {
  loiDoc = cauLoiKho(e, t.khongDoc);
}
if (!kk && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/kiem-ke', kqHai(false, CAU.khongThay));
}

let demDuoc = !!kk && kk.trang_thai === 'dang_dem' && k.duoc('van_hanh');
const tenMh = new Map(matHang.map(m => [m.id, m]));

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
/** Câu lưu ý (khung nb-bao luu-y): nhãn không đọc được, máy khác vừa lưu... */
const luuY: string[] = [];
// Khi hiện lại form sau lỗi: số người đếm vừa gửi, và BẢN mà các số đó dựa
// vào (phien_ban, số gốc của ghi chú). null = lấy thẳng từ database.
let dongLoi: DongDemForm[] | null = null;
let phienBanForm: number | null = null;
let ghiChuForm: string | null = null;
let ghiChuGocForm: string | null = null;

if (form && kk) {
  const viec = String(form.get('viec') ?? '');
  const ve = (kq: KetQua, thamSo = '') => chuyenHuong(Astro, `/noi-bo/kho/kiem-ke/${kk!.id}${thamSo}`, kq);
  const pbTho = String(form.get('phien_ban') ?? '');
  const phienBan = /^\d{1,9}$/.test(pbTho) ? Number(pbTho) : kk.phien_ban;
  const ghiChu = String(form.get('ghi_chu') ?? '').trim() || null;

  if (['luu', 'gui', 'quet'].includes(viec)) {
    if (!demDuoc) {
      bao = kqHai(false, CAU.hetBuocDem);
    } else {
      const doc = docFormKiemKe(form, matHang);
      let dongGui = doc.dong;
      let payload = doc.payload;
      let loi = doc.loi;
      let loiEn = doc.loiEn;
      let quet: KetQuaQuetKiemKe | null = null;
      if (viec === 'quet') {
        quet = apDungQuet(doc.dong, String(form.get('ma_quet') ?? ''), matHang, caiDat?.mau_ma_vach, caiDat?.so_le_kg ?? 3, maNhan);
        const p = payloadTuDong(quet.dong, matHang);
        dongGui = quet.dong; payload = p.payload; loi = p.loi; loiEn = p.loiEn;
      }
      // Chưa lưu được thì hiện lại đúng số vừa gửi, trên đúng bản người đếm đang sửa.
      dongLoi = dongGui;
      phienBanForm = phienBan;
      ghiChuForm = ghiChu ?? '';
      ghiChuGocForm = String(form.get('ghi_chu_goc') ?? '').trim();
      // Câu "Đã đọc N nhãn: …" hai thứ tiếng (đi vào câu báo qua cookie); rỗng khi không đọc được nhãn nào.
      const cauDoc: HaiThuTieng = quet && quet.soDoc > 0
        ? { vi: `Đã đọc ${quet.soDoc} nhãn: ${quet.tomTat}.`, en: `Read ${quet.soDoc} ${s(quet.soDoc, 'label', 'labels')}: ${quet.tomTatEn}.` }
        : { vi: '', en: '' };

      // Máy khác đã lưu sau lúc trang này mở: không lưu đè — đọc lại rồi gộp.
      let mayKhac = phienBan !== kk.phien_ban;
      let luu: (KetQua & { phienBan?: number }) | null = null;
      if (!mayKhac && loi.length === 0) {
        luu = await luuKiemKe(k.client, kk.id, phienBan, ghiChu, payload);
        if (!luu.ok && laLoiMayKhac(luu.cau)) mayKhac = true;   // máy kia lưu đúng lúc mình bấm
      }

      if (mayKhac) {
        if (luu) {
          try {
            const moi = await docKiemKe(k.client, kk.id);
            if (moi) { kk = moi.kk; dongDb = moi.dong; loDb = moi.lo; }
          } catch { /* đọc lại không được: gộp với bản vừa đọc đầu trang, lần lưu sau database vẫn chặn nếu còn cũ */ }
          demDuoc = kk.trang_thai === 'dang_dem' && k.duoc('van_hanh');
        }
        if (!demDuoc) {
          bao = kqHai(false, CAU.mayKhacGui);
        } else {
          const gop = gopKhiTrung(dongGui, dongDemTuDb(dongDb));
          dongLoi = gop.dong;
          phienBanForm = kk.phien_ban;
          // Ghi chú: mình có sửa thì giữ của mình, không thì lấy ghi chú mới nhất.
          ghiChuForm = (ghiChu ?? '') !== ghiChuGocForm ? (ghiChu ?? '') : (kk.ghi_chu ?? '');
          ghiChuGocForm = kk.ghi_chu ?? '';
          luuY.push(t.mayKhacLuu);
          if (gop.giu > 0) luuY.push(t.chuaLuuDong(gop.giu));
          if (gop.trung.length > 0) {
            const ten = gop.trung.map(d => tenMh.get(d.mat_hang_id)?.ten ?? '—');
            luuY.push(t.haiMay([...new Set(ten)].join(', ')));
          }
          if (viec === 'gui') luuY.push(t.chuaGui);
          if (quet) luuY.push(...(nn === 'en' ? quet.loiEn : quet.loi));
        }
      } else if (loi.length > 0 || (luu && !luu.ok)) {
        bao = kqHai(false, loi.length > 0
          ? { vi: `Chưa lưu: ${loi.join(' · ')}`, en: `Not saved: ${loiEn.join(' · ')}` }
          : { vi: `Chưa lưu: ${luu?.cau ?? ''}`, en: `Not saved: ${luu?.cauEn ?? dichCau('en', luu?.cau ?? '')}` });
        if (cauDoc.vi) luuY.push(t.suaLoi(cauDoc[nn]));
        if (quet) luuY.push(...(nn === 'en' ? quet.loiEn : quet.loi));
      } else if (viec === 'gui') {
        const g = await guiKiemKe(k.client, kk.id, luu?.phienBan ?? phienBan);
        if (!g.ok) {
          return ve(kqHai(false, {
            vi: `Đã lưu số đếm nhưng CHƯA gửi được: ${g.cau}`,
            en: `Counts saved, but NOT sent yet: ${g.cauEn ?? dichCau('en', g.cau)}`,
          }));
        }
        // Nhân viên quầy: không báo "mấy dòng lệch sổ" — đếm mù cho lần sau.
        return ve(laQuay
          ? kqHai(true, { vi: `Đã gửi ${kk.so_phieu} cho quản lý. Cảm ơn!`, en: `${kk.so_phieu} sent to the manager. Thank you!` })
          : g);
      } else if (quet) {
        const cau: HaiThuTieng = quet.soMa === 0 ? CAU.luuOTrong
          : cauDoc.vi ? { vi: `${cauDoc.vi} Đã ghi vào phiếu.`, en: `${cauDoc.en} Entered on the sheet.` }
          : CAU.daLuuDem;
        const q = new URLSearchParams();
        if (quet.soNhanHong > 0) q.set('hong', String(quet.soNhanHong));
        if (quet.soGoiLa > 0) q.set('la', String(quet.soGoiLa));
        const thamSo = q.toString();
        return ve(kqHai(true, cau), thamSo ? `?${thamSo}` : '');
      } else {
        return ve(luu ? { ok: true, cau: luu.cau, cauEn: luu.cauEn } : kqHai(true, CAU.daLuuDem));
      }
    }
  } else {
    const lyDo = String(form.get('ly_do') ?? '').trim();
    const choDuyet = kk.trang_thai === 'cho_duyet';
    let kq: KetQua;
    // Câu database viết "ghi bán N gói" — mọi món đếm trên phiếu cùng một đơn vị ("khay") thì đổi theo, ở web.
    if (viec === 'duyet') kq = doiDonViCau(await duyetKiemKe(k.client, kk.id), donViChung(dongDb.map(d => tenMh.get(d.mat_hang_id))));
    else if (viec === 'tu_choi') kq = await tuChoiKiemKe(k.client, kk.id, lyDo);
    else if (viec === 'huy') kq = await huyKiemKe(k.client, kk.id, lyDo || null);
    else kq = kqHai(false, CAU.viecSai);
    // Quản lý duyệt / trả về / hủy phiếu chờ duyệt: về trang Duyệt — phiếu chờ tiếp theo nằm sẵn.
    if (kq.ok && (viec === 'duyet' || viec === 'tu_choi' || (viec === 'huy' && choDuyet))) {
      return chuyenHuong(Astro, '/noi-bo/kho/duyet', kq);
    }
    // Hủy phiếu đang đếm: phiếu không còn gì để làm — về danh sách kiểm kê.
    if (kq.ok && viec === 'huy') return chuyenHuong(Astro, '/noi-bo/kho/kiem-ke', kq);
    return ve(kq);
  }
}

// Câu lưu ý của lần quét trước (sau khi chuyển hướng).
if (!form && demDuoc) {
  const soTrenLink = (ten: string) => {
    const n = Number(Astro.url.searchParams.get(ten) ?? 0);
    return Number.isInteger(n) && n > 0 && n < 100000 ? n : 0;
  };
  luuY.push(...cauQuetLoi(soTrenLink('hong'), soTrenLink('la'), nn));
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const theoLo = kk?.kieu === 'theo_lo';
const dongHien: DongDemForm[] = dongLoi ?? dongDemTuDb(dongDb);
// "Thấy mặt hàng không có trong danh sách" (29/10/2026): bỏ món đã có trên phiếu (ghi số ở dòng của nó); nhóm "Gợi ý"
// là món sổ ghi đang ở chỗ khác. Đọc tồn lỗi thì chỉ mất nhóm gợi ý.
const monTrenPhieu = new Set([...dongDb.map(d => d.mat_hang_id), ...dongHien.map(d => d.mat_hang_id)].filter(Boolean));
const goiYThay = kk && demDuoc && !theoLo
  ? goiYThayMon(await docTon(k.client, kk.chi_nhanh_id).catch(() => [] as DongTon[]), { id: kk.vi_tri_id, loai: kk.loai_vi_tri }, monTrenPhieu, nn)
  : [];
const phienBanHien = phienBanForm ?? kk?.phien_ban ?? 0;
const ghiChuHien = ghiChuForm ?? kk?.ghi_chu ?? '';
const ghiChuGocHien = ghiChuGocForm ?? kk?.ghi_chu ?? '';
const loIds = [...dongHien.map(d => d.lo_id), ...dongDb.map(d => d.lo_id ?? ''), ...loDb.map(l => l.lo_id)];
// Mã lô và số tảng của các lô đang hiện — hai lượt đọc song song. Số tảng đọc hỏng thì vẫn hiện mã lô như cũ.
const [thongTinLo, soTangLo] = await Promise.all([
  docThongTinLo(k.client, loIds),
  docLoTang(k.client, loIds).catch(() => new Map<string, { tang_id: string; so_tang: number | null }>()),
]);
/** " · tảng #0001" để nối ngay sau mã lô; lô không thuộc tảng nào thì rỗng. */
const tangCua = (loId: string) => { const c = chuTang(soTangLo.get(loId)?.so_tang, nn); return c ? ` · ${c}` : ''; };
const giaLo = kk && kk.trang_thai !== 'dang_dem' ? await docGiaVonLo(k.client, loDb.map(l => l.lo_id)) : new Map();
const coGia = giaLo.size > 0;
const ten = kk ? await tenNhanSu(k.client, [kk.nguoi_tao, kk.nguoi_gui, kk.nguoi_duyet]) : new Map<string, string>();
// Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
const [nhanTT, lopTT] = kk
  ? ((tt: [string, string]) => [tt[0], tt[1] || 'tat'])(trangThaiKho(kk.trang_thai, nn))
  : ['', ''];

// Tiến độ đếm: dòng nào đã có số (tích "Đã hết thật" cũng là đã đếm).
const moTaLo = (id: string | null) => {
  if (!id) return '';
  const l = thongTinLo.get(id);
  return l ? t.moTaLo(`${l.ma_lo}${tangCua(id)}`, dinhDangNgay(l.han_dung)) : '';
};
const tenDong = (d: DongDemForm) => {
  const lo = d.lo_id ? thongTinLo.get(d.lo_id) : undefined;
  return `${tenMh.get(d.mat_hang_id)?.ten ?? '—'}${lo ? t.loNgoac(`${lo.ma_lo}${tangCua(d.lo_id)}`) : ''}`;
};
const daDem = dongHien.map(d => daDemDong(d, tenMh.get(d.mat_hang_id)?.dem_goi ?? false));
const soDaDem = daDem.filter(Boolean).length;
const chuaDem = dongHien.map((d, i) => ({ i, ten: tenDong(d) })).filter(x => !daDem[x.i]);

/** "21:42" nếu hôm nay, "21:42 ngày 24/09" nếu hôm khác. */
const gioLuc = (ts: string | null) => {
  const tg = dinhDangThoiDiem(ts);
  if (tg === '—') return '—';
  const [ngay, gio] = tg.split(' ');
  const h = homNayVn();
  return ngay === `${h.slice(8, 10)}/${h.slice(5, 7)}` ? gio : t.gioNgay(gio, ngay);
};

// Chênh lệch từng dòng (sau khi gửi). Kg chênh của dòng đếm gói mà không cân
// là ƯỚC TÍNH theo kg trung bình mỗi gói — con số thật do database tính lúc duyệt.
const loTheoDong = new Map<string, LoKiemKe[]>();
for (const l of loDb) loTheoDong.set(l.kiem_ke_dong_id, [...(loTheoDong.get(l.kiem_ke_dong_id) ?? []), l]);
const chenh = (d: DongKiemKe) => {
  const mh = tenMh.get(d.mat_hang_id);
  const gSo = d.so_goi_so ?? 0, kSo = d.so_kg_so ?? 0;
  const dg = mh?.dem_goi ? (d.so_goi_dem ?? 0) - gSo : 0;
  let dk: number | null;
  let uoc = false;
  if (d.so_kg_dem !== null) dk = d.so_kg_dem - kSo;
  else if (mh?.dem_goi && gSo > 0) { dk = (dg * kSo) / gSo; uoc = true; }
  else if (mh?.dem_goi && dg === 0) dk = 0;
  else dk = null;
  const lo = loTheoDong.get(d.id) ?? [];
  const tongKg = lo.reduce((s, l) => s + l.so_kg_so, 0);
  const tongGiaTri = lo.reduce((s, l) => s + l.so_kg_so * (giaLo.get(l.lo_id)?.gia_von_kg ?? 0), 0);
  const giaTb = tongKg > 0 ? tongGiaTri / tongKg : (lo[0] ? giaLo.get(lo[0].lo_id)?.gia_von_kg ?? 0 : 0);
  return { dg, dk: dk === null ? null : Math.round(dk * 1000) / 1000, uoc, giaTri: dk === null ? null : dk * giaTb };
};
const tongGiaTriChenh = kk && kk.trang_thai !== 'dang_dem'
  ? dongDb.reduce((s, d) => s + (chenh(d).giaTri ?? 0), 0) : 0;
const coChenh = (d: DongKiemKe) => { const c = chenh(d); return c.dg !== 0 || (c.dk !== null && c.dk !== 0); };
const tieuDe = kk ? t.kiemKeO(kk.ten_vi_tri) : t.kiemKe;
// Nhãn đã quét cộng dồn ở màn Đếm quầy (0032): số nhãn của từng món.
const coNhanQuet = (kk?.so_nhan_quet ?? 0) > 0;
const nhanQuet = kk && coNhanQuet ? await docSoNhanQuet(k.client, kk.id) : new Map<string, number>();
const choToiDuyet = kk?.trang_thai === 'cho_duyet' && k.duoc('duyet');
---
<Kho k={k} tieuDe={tieuDe} huongDan={choToiDuyet ? 'duyet-kiem-ke' : 'kiem-ke'}>
  <h1>{tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  {kk && (
    <>
      <InDau tieuDe={t.inTieuDe} soPhieu={kk.so_phieu} chiNhanh={k.chiNhanh?.ten} />
      <NutIn chu={t.inBienBan} />
    </>
  )}
  {luuY.length > 0 && <div class="nb-bao luu-y" role="status">{luuY.map(c => <p>{c}</p>)}</div>}

  {kk && (
    <>
      <p class="nb-dan">
        <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
        {' · '}{kk.so_phieu} · {kk.kieu === 'theo_lo' ? t.kieuLo : t.kieuMon} · {t.ngay} {dinhDangNgay(kk.ngay_kiem)}
        {' · '}{t.moBoi} {ten.get(kk.nguoi_tao ?? '') ?? '—'} {dinhDangThoiDiem(kk.created_at)}
        {kk.gui_luc && <>{' · '}{t.guiBoi} {ten.get(kk.nguoi_gui ?? '') ?? '—'} {dinhDangThoiDiem(kk.gui_luc)}</>}
        {kk.duyet_luc && <>{' · '}{t.duyetBoi} {ten.get(kk.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(kk.duyet_luc)}</>}
      </p>
      {kk.ly_do && <div class="nb-bao luu-y"><p><strong>{kk.trang_thai === 'da_huy' ? t.lyDoHuy : t.quanLyTraVe}:</strong> {kk.ly_do}</p></div>}

      {demDuoc ? (
        // ===================================================================
        // ĐANG ĐẾM
        // ===================================================================
        <form method="POST" action={`/noi-bo/kho/kiem-ke/${kk.id}`}>
          <input type="hidden" name="phien_ban" value={String(phienBanHien)} />
          <input type="hidden" name="so_dong" value={String(dongHien.length)} />
          <input type="hidden" name="ghi_chu_goc" value={ghiChuGocHien} />

          <div class="nb-the">
            <p style="margin:0 0 .5rem;font-size:1.2rem">
              <strong>{t.daDem(soDaDem, dongHien.length)}</strong>
              {dongHien.length > 0 && chuaDem.length === 0 && <span class="kho-phu">{' '}{t.duHet}</span>}
            </p>
            <progress max={Math.max(dongHien.length, 1)} value={soDaDem} style="width:100%;height:12px" aria-hidden="true"></progress>
          </div>

          {!theoLo && coNhanQuet && (
            <div class="nb-the">
              <p style="margin:0">{t.congDon1}<strong>{t.soNhan(kk.so_nhan_quet)}</strong>{t.congDon2}</p>
              <p style="margin:.75rem 0 0"><a class="nb-nut phu" href={`/noi-bo/kho/quay/dem?vi_tri=${kk.vi_tri_id}`}>{t.quetTiep}</a></p>
            </div>
          )}
          {!theoLo && !coNhanQuet && (
            <details class="nb-the kk-quet">
              <summary>{t.quetNhanCan}</summary>
              <QuetMa nhan={t.docVaGhi} goiY={t.quetGoiY} />
              {kk.loai_vi_tri === 'quay' && (
                <p class="nb-dan" style="margin:.75rem 0 0">{t.nhieuDot}<a href={`/noi-bo/kho/quay/dem?vi_tri=${kk.vi_tri_id}`}>{t.moDemQuay}</a>.</p>
              )}
            </details>
          )}

          {dongHien.length === 0 && <p class="nb-rong">{t.viTriTrong}</p>}
          {dongHien.map((d, i) => {
            const mh = tenMh.get(d.mat_hang_id);
            return (
              <div class:list={['kk-dong', { 'chua-dem': !daDem[i] }]} id={`dong-${i}`}>
                <input type="hidden" name={`k${i}_mh`} value={d.mat_hang_id} />
                {d.lo_id && <input type="hidden" name={`k${i}_lo`} value={d.lo_id} />}
                {d.goc != null && <input type="hidden" name={`k${i}_goc`} value={d.goc} />}
                <p class="kk-ten"><strong>{i + 1}. {mh?.ten ?? '—'}</strong>
                  {d.lo_id && <span class="kho-phu">{moTaLo(d.lo_id)}</span>}
                  {!daDem[i] && <span class="kho-phu">{t.chuaDem}</span>}
                  {!d.lo_id && (nhanQuet.get(d.mat_hang_id) ?? 0) > 0 && <span class="kho-phu">{t.daQuetNhan(nhanQuet.get(d.mat_hang_id) ?? 0)}</span>}</p>
                <div class="kk-o">
                  {/* 0105: món đếm theo cái — thùng + lẻ (khi có quy đổi thùng), không ô kg. */}
                  {mh?.dem_theo_cai && mh.so_trong_thung && (
                    <label class="nb-o"><span>{t.soThung(mh.so_trong_thung)}</span>
                      <input type="text" inputmode="numeric" name={`k${i}_thung`} value={d.thung ?? ''} /></label>
                  )}
                  {mh?.dem_goi && (
                    <label class="nb-o"><span>{mh.dem_theo_cai && mh.so_trong_thung ? t.soLe(mh.don_vi_goi) : t.soDv(mh.don_vi_goi)}</span>
                      <input type="text" inputmode="numeric" name={`k${i}_goi`} value={d.goi} /></label>
                  )}
                  {!mh?.dem_theo_cai && (
                    <label class="nb-o"><span>{mh?.dem_goi ? t.kgNeuCan : t.soKg}</span>
                      <input type="text" inputmode="decimal" name={`k${i}_kg`} value={d.kg} /></label>
                  )}
                  <label class="kho-tich kk-het" title={t.hetThat(mh?.dem_goi ? mh.don_vi_goi : null)}>
                    <input type="checkbox" name={`k${i}_het`} value="co" checked={d.het} />
                    {t.daHetThat}
                  </label>
                </div>
              </div>
            );
          })}

          {!theoLo && (
            <details class="nb-the">
              <summary style="cursor:pointer;font-weight:600;min-height:48px;display:flex;align-items:center">{t.thayMatHang}</summary>
              <div style="margin-top:.75rem">
                <label class="nb-o"><span>{t.matHang}</span><ChonMatHang name="them_mat_hang" matHang={matHang} demCai bo={monTrenPhieu}
                  goiY={goiYThay} tenGoiY={t.dangOChoKhac} /></label>
                <div class="kho-luoi">
                  <label class="nb-o"><span>{t.soGoi}</span><input type="text" inputmode="numeric" name="them_goi" /></label>
                  <label class="nb-o"><span>{t.soKg}</span><input type="text" inputmode="decimal" name="them_kg" /></label>
                </div>
              </div>
            </details>
          )}

          <label class="nb-o"><span>{t.ghiChu}</span>
            <input type="text" name="ghi_chu" value={ghiChuHien} maxlength="500" /></label>

          <div class="kho-thanh-nut dinh">
            <button type="submit" name="viec" value="luu" class="nb-nut phu">{t.luuDem}</button>
            <button type="submit" name="viec" value="gui" class="nb-nut">{t.guiDuyet}</button>
          </div>
        </form>
      ) : kk.trang_thai === 'dang_dem' ? (
        <p class="nb-rong">{t.dangDem}</p>
      ) : laQuay ? (
        // ===================================================================
        // NHÂN VIÊN QUẦY — chỉ một câu, không sổ, không chênh
        // ===================================================================
        <div class="nb-the">
          {kk.trang_thai === 'da_huy' ? (
            <p style="margin:0;font-size:1.1rem"><strong>{t.daHuy}</strong></p>
          ) : (
            <>
              <p style="margin:0;font-size:1.1rem"><strong>{t.daGuiQl(kk.gui_luc ? gioLuc(kk.gui_luc) : null)}</strong></p>
              <p class="nb-dan" style="margin:.5rem 0 0">
                {kk.trang_thai === 'da_duyet'
                  ? t.qlDaDuyet
                  : t.qlSeXem}
              </p>
            </>
          )}
        </div>
      ) : (
        // ===================================================================
        // CHỜ DUYỆT / ĐÃ DUYỆT / ĐÃ HỦY
        // ===================================================================
        <>
          {kk.trang_thai !== 'da_huy' && (
            <div class="kho-o-so-luoi">
              <div class="kho-o-so"><b>{dongDb.filter(coChenh).length}</b><span>{t.dongLech(dongDb.filter(coChenh).length, dongDb.length)}</span></div>
              {coGia && <div class={`kho-o-so ${tongGiaTriChenh < 0 ? 'gap' : ''}`}><b style="font-size:1.2rem">{dinhDangTien(tongGiaTriChenh, nn)}</b><span>{t.giaTriChenhUoc}</span></div>}
              {kk.loai_vi_tri === 'quay' && kk.nguon_so_ban === 'kiem_ke' && <div class="kho-o-so"><b style="font-size:1.1rem">{t.thieuLaBan}</b><span>{t.chuaNoiIpos}</span></div>}
              {coNhanQuet && <div class="kho-o-so"><b>{kk.so_nhan_quet}</b><span>{t.nhanCongDon}</span></div>}
            </div>
          )}
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr>
                <th>{t.matHang}</th><th class="so">{t.chenh}</th><th class="so">{t.so}</th><th class="so">{t.dem}</th>
                {coGia && <th class="so">{t.giaTriChenh}</th>}
              </tr></thead>
              <tbody>
                {dongDb.map(d => {
                  const mh = tenMh.get(d.mat_hang_id);
                  const c = chenh(d);
                  const dv = mh?.dem_goi ? ` ${mh.don_vi_goi}` : '';
                  return (
                    <tr>
                      <td>{mh?.ten ?? '—'}{d.lo_id && <><br /><span class="kho-phu">{moTaLo(d.lo_id)}</span></>}
                        {d.xac_nhan_het && <><br /><span class="kho-phu">{t.xacNhanHet}</span></>}</td>
                      <td class="so" style={coChenh(d) ? 'font-weight:700' : ''}>
                        {mh?.dem_goi && c.dg !== 0 ? `${c.dg > 0 ? '+' : ''}${c.dg}${dv}` : ''}{' '}
                        {!mh?.dem_theo_cai && c.dk !== null && c.dk !== 0 ? <>{mh?.dem_goi && c.dg !== 0 && <br />}{c.uoc ? '≈ ' : ''}{c.dk > 0 ? '+' : ''}{dinhDangKg(c.dk, nn)} kg</> : ''}{' '}
                        {!coChenh(d) && '0'}
                      </td>
                      <td class="so">{mh?.dem_theo_cai ? `${d.so_goi_so ?? 0}${dv}` : <>{mh?.dem_goi ? `${d.so_goi_so ?? 0}${dv} · ` : ''}{dinhDangKg(d.so_kg_so, nn)} kg</>}</td>
                      <td class="so">{mh?.dem_goi ? `${d.so_goi_dem ?? '—'}${dv}` : ''}{!mh?.dem_theo_cai && d.so_kg_dem !== null ? `${mh?.dem_goi ? ' · ' : ''}${dinhDangKg(d.so_kg_dem, nn)} kg` : ''}
                        {!d.lo_id && (nhanQuet.get(d.mat_hang_id) ?? 0) > 0 && (
                          <><br /><span class="kho-phu">{t.quetNhanGhiTay(nhanQuet.get(d.mat_hang_id) ?? 0, d.so_goi_them)}</span></>
                        )}
                      </td>
                      {coGia && <td class="so">{c.giaTri !== null && Math.round(c.giaTri) !== 0 ? dinhDangTien(c.giaTri, nn) : '—'}</td>}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {kk.trang_thai === 'da_duyet' && loDb.length > 0 && (
            <details class="nb-the">
              <summary style="cursor:pointer;font-weight:600">{t.tungLo}</summary>
              <div class="kho-bang-khung" style="margin-top:.75rem">
                <table class="kho-bang">
                  <thead><tr><th>{t.matHang}</th><th>{t.lo}</th><th class="so">{t.truoc}</th><th class="so">{t.sau}</th></tr></thead>
                  <tbody>
                    {loDb.map(l => {
                      const d = dongDb.find(x => x.id === l.kiem_ke_dong_id);
                      const mh = d ? tenMh.get(d.mat_hang_id) : undefined;
                      return (
                        <tr>
                          <td>{mh?.ten ?? '—'}</td>
                          <td>{moTaLo(l.lo_id)}</td>
                          <td class="so">{mh?.dem_theo_cai ? `${l.so_goi_so} ${mh.don_vi_goi}` : <>{mh?.dem_goi ? `${l.so_goi_so} · ` : ''}{dinhDangKg(l.so_kg_so, nn)} kg</>}</td>
                          <td class="so">{mh?.dem_theo_cai ? `${l.so_goi_moi ?? '—'} ${mh.don_vi_goi}` : <>{mh?.dem_goi ? `${l.so_goi_moi ?? '—'} · ` : ''}{dinhDangKg(l.so_kg_moi, nn)} kg</>}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {choToiDuyet && (
            <div class="nb-the kho-khong-in">
              <h2 style="margin-top:0">{t.duyetKiemKe}</h2>
              <p class="nb-dan">{t.duyetLa}{kk.loai_vi_tri === 'quay' && kk.nguon_so_ban === 'kiem_ke' ? t.thieuQuayBan : t.thieuChenh}{t.thuaLoMoi}</p>
              <form method="POST" class="kho-thanh-nut">
                <button type="submit" name="viec" value="duyet" class="nb-nut">{t.duyetKiemKe}</button>
              </form>
              <details>
                <summary style="cursor:pointer;font-weight:600;min-height:48px;display:flex;align-items:center">{t.traVeDemLai}</summary>
                <form method="POST" style="margin-top:.75rem">
                  <label class="nb-o"><span>{t.demLaiCho}</span><textarea name="ly_do" required maxlength="500"></textarea></label>
                  <button type="submit" name="viec" value="tu_choi" class="nb-nut kho-nut-xoa">{t.nutTraVe}</button>
                </form>
              </details>
            </div>
          )}
          {kk.trang_thai === 'cho_duyet' && !k.duoc('duyet') && (
            <p class="nb-dan">{t.choDuyet}</p>
          )}
        </>
      )}

      {(kk.trang_thai === 'dang_dem' && k.duoc('van_hanh')) || choToiDuyet ? (
        <details class="nb-the" style="margin-top:1.5rem">
          <summary style="cursor:pointer;font-weight:600;min-height:48px;display:flex;align-items:center">{t.huyPhieuNay}</summary>
          <form method="POST" style="margin-top:.75rem">
            <p class="nb-dan">{t.huyLa1}<strong>{t.huyLa2}</strong>{t.huyLa3}</p>
            <label class="nb-o"><span>{t.viSaoHuy}</span>
              <input type="text" name="ly_do" required minlength="3" maxlength="500" placeholder={t.viDuHuy} /></label>
            <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{t.huyPhieu}</button>
          </form>
        </details>
      ) : null}
    </>
  )}

  <p class="kho-khong-in" style="margin-top:1.5rem">
    {choToiDuyet
      ? <a href="/noi-bo/kho/duyet">{t.veDuyet}</a>
      : <a href="/noi-bo/kho/kiem-ke">{t.veDanhSach}</a>}
  </p>
  {kk && <KyTen ten={[t.kyNguoiDem, t.kyKiemTra, t.kyQuanLy]} />}
</Kho>

<style>
  /* Gọn 22/10/2026 (Khánh duyệt): mỗi món một hàng — tên, rồi ô số gói, ô kg, ô "Đã hết thật" trên cùng một
     hàng (điện thoại cũng vậy). Món chưa đếm: vạch xám #767676 dày 4px bên trái như trước. */
  .kk-dong {
    border: 1px solid var(--kho-vach); border-radius: var(--kho-bo); background: var(--nb-the);
    padding: .55rem .75rem .6rem; margin-bottom: .5rem; scroll-margin-top: 5.5rem;
  }
  .kk-dong.chua-dem { border-left: 4px solid var(--vien-o); }
  .kk-ten { margin: 0 0 .35rem; line-height: 1.3; }
  .kk-ten .kho-phu { font-size: .8rem; }
  .kk-ten .kho-phu::before { content: ' · '; }
  /* Hai ô số chia đều, ô "Đã hết thật" vừa chữ, không ngắt dòng — vừa 360px. */
  .kk-o { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; gap: .5rem; align-items: end; }
  .kk-o > .kk-het { grid-column: 3; }
  .kk-o:not(:has(> .nb-o + .nb-o)) > .nb-o { grid-column: 1 / 3; }   /* món chỉ đếm kg: một ô số rộng gấp đôi */
  .kk-o .nb-o { margin: 0; }
  .kk-o .nb-o > span { font-size: .78rem; }
  .kk-het { min-height: 48px; margin: 0; font-size: .82rem; white-space: nowrap; }
  .kk-quet > summary { cursor: pointer; font-weight: 600; min-height: 48px; display: list-item; padding: .6rem 0; }
</style>
