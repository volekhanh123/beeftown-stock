---
/**
 * KHO — KIỂM KÊ
 *
 * Mỗi kho / quầy một nút "Bắt đầu đếm". Cách đếm tự theo loại vị trí: quầy
 * đếm gói theo món, kho lạnh đếm từng lô (tảng) — không bắt nhân viên chọn
 * một thứ kỹ thuật. Ai cần đổi thì mở "Tùy chọn" (nhân viên quầy không thấy).
 * Nhân viên quầy chỉ thấy thẻ của quầy.
 *
 * Mỗi vị trí chỉ một phiếu đang mở — phiếu đang mở hiện ngay trên thẻ của vị
 * trí đó, kèm lời nhắn nếu quản lý trả về để đếm lại.
 *
 * Nhân viên quầy bấm thẻ quầy là sang màn Đếm quầy (/noi-bo/kho/quay/dem,
 * GĐ5b — quét cộng dồn), trừ khi phiếu đã gửi (mở phiếu xem "đã gửi lúc…").
 * Vị trí "Đang mang ra quầy" (0032) không đếm được — không có thẻ.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docViTri, docCaiDat, type ViTri, type CaiDat } from '../../../../lib/kho/danh-muc.ts';
import { docDanhSachKiemKe, batDauKiemKe, kieuTheoViTri, type KiemKeTom } from '../../../../lib/kho/kiem-ke.ts';
import LocDanhSach from '../../../../components/kho/LocDanhSach.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { docTimDs, catTrang, dangTim } from '../../../../lib/kho/tim-ds.ts';
import { cauLoiKho, dinhDangNgay, trangThaiKho, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const laQuay = k.nhanSu.vai_tro === 'nhan_vien_quay';
const nn = k.nn;
const t = dichNB(nn, {
  tatCa: { vi: 'Tất cả', en: 'All' },
  choDuyet: { vi: 'Chờ duyệt', en: 'Awaiting approval' },
  dangDem: { vi: 'Đang đếm', en: 'Counting' },
  daDuyet: { vi: 'Đã duyệt', en: 'Approved' },
  daHuy: { vi: 'Đã hủy', en: 'Cancelled' },
  khongDoc: { vi: 'Không đọc được kiểm kê.', en: 'Could not read the stocktakes.' },
  tieuDe: { vi: 'Kiểm kê', en: 'Stocktake' },
  chuaBatDau1: { vi: 'Chi nhánh chưa bắt đầu dùng kho. Vào ', en: 'This branch has not started using inventory yet. Go to ' },
  tongQuan: { vi: 'Tổng quan kho', en: 'Inventory home' },
  dan: {
    vi: 'Đếm hàng thật đang có, ghi vào phiếu, gửi quản lý duyệt. Duyệt xong tồn trên sổ bằng đúng số đếm.',
    en: 'Count the goods that are actually there, enter them on the sheet and send it to a manager for approval. Once approved, the stock on the books equals the count.',
  },
  chuaIpos1: { vi: ' Chưa nối iPOS: số ', en: ' iPOS is not connected: ' },
  chuaIpos2: { vi: 'thiếu ở quầy được tính là đã bán', en: 'whatever is missing at the counter counts as sold' },
  chuaIpos3: { vi: ' — nên đếm quầy mỗi tối.', en: ' — so count the counter every evening.' },
  coIpos: { vi: ' Số bán lấy từ iPOS: phần thiếu ghi là chênh lệch kiểm kê.', en: ' Sales come from iPOS: anything missing is recorded as a stocktake difference.' },
  quetTiep: { vi: (so: string) => `${so} · đang đếm — bấm để quét tiếp`, en: (so: string) => `${so} · counting — press to keep scanning` },
  bamQuet: { vi: 'Bấm để quét đếm quầy', en: 'Press to scan the counter count' },
  traVe: { vi: 'Quản lý trả về:', en: 'Sent back by the manager:' },
  demLai: { vi: ' — bấm để đếm lại.', en: ' — press to count again.' },
  daGuiCho: { vi: 'đã gửi, chờ quản lý duyệt', en: 'sent, awaiting manager approval' },
  dangDemSo: { vi: (a: number, b: number) => `đang đếm ${a}/${b}`, en: (a: number, b: number) => `counting ${a}/${b}` },
  demGoi: { vi: 'Đếm số gói của từng món', en: 'Count the packs of each item' },
  demLo: { vi: 'Đếm từng lô (từng tảng)', en: 'Count each lot (each primal)' },
  tuyChon: { vi: 'Tùy chọn', en: 'Options' },
  cachDem: { vi: 'Cách đếm', en: 'Counting method' },
  demLoDu: { vi: 'Đếm từng lô (từng tảng, từng hạn dùng)', en: 'Count each lot (each primal, each use-by date)' },
  batDau: { vi: 'Bắt đầu đếm', en: 'Start counting' },
  locTrangThai: { vi: 'Lọc theo trạng thái', en: 'Filter by status' },
  goiYTim: { vi: 'Số phiếu, nơi đếm…', en: 'Sheet number, location…' },
  hetDs: { vi: 'Hết danh sách — bấm "Trang trước".', en: 'End of the list — press "Previous".' },
  khongKhop: { vi: 'Không tìm thấy phiếu nào khớp bộ lọc.', en: 'No sheets match the filters.' },
  chuaCo: { vi: 'Chưa có phiếu kiểm kê nào', en: 'No stocktake sheets yet' },
  oTrangThai: { vi: ' ở trạng thái này', en: ' with this status' },
  kieuLo: { vi: 'đếm từng lô', en: 'lot by lot' },
  kieuMon: { vi: 'đếm gói theo món', en: 'packs by item' },
  daDem: { vi: 'Đã đếm', en: 'Counted' },
  soDong: { vi: (a: number, b: number) => `${a}/${b} dòng`, en: (a: number, b: number) => `${a}/${b} lines` },
  quanLyTraVe: { vi: 'Quản lý trả về', en: 'Sent back by manager' },
});

const LOC = [['', t.tatCa], ['cho_duyet', t.choDuyet], ['dang_dem', t.dangDem], ['da_duyet', t.daDuyet], ['da_huy', t.daHuy]] as const;
const loc = LOC.some(([v]) => v === Astro.url.searchParams.get('loc')) ? Astro.url.searchParams.get('loc')! : '';

let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form && k.chiNhanh && String(form.get('viec')) === 'bat_dau') {
  // Thẻ nào cũng gửi "kieu": ô ẩn (nhân viên quầy) hoặc ô chọn trong "Tùy chọn"
  // — đóng lại vẫn gửi, mặc định đúng theo loại vị trí.
  const kq = await batDauKiemKe(k.client, k.chiNhanh.id, String(form.get('vi_tri_id') ?? ''),
    String(form.get('kieu') ?? 'theo_mat_hang'), String(form.get('ma_gui') ?? ''));
  if (kq.ok && kq.id) return chuyenHuong(Astro, `/noi-bo/kho/kiem-ke/${kq.id}`, kq);
  bao = kq;
}

const tim = docTimDs(Astro.url.searchParams);
let ds: KiemKeTom[] = [];
let hien: KiemKeTom[] = [];
let coSau = false;
let viTri: ViTri[] = [];
let caiDat: CaiDat | null = null;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    // Đọc cả danh sách (không lọc) để thẻ vị trí luôn biết phiếu nào đang mở.
    // Danh sách bên dưới đọc riêng: lọc trạng thái + tìm + đúng một trang.
    let trang: KiemKeTom[];
    [ds, trang, viTri, caiDat] = await Promise.all([
      docDanhSachKiemKe(k.client, k.chiNhanh.id, null),
      docDanhSachKiemKe(k.client, k.chiNhanh.id, loc || null, { tim, nhanSuId: k.nhanSu.id }),
      docViTri(k.client, k.chiNhanh.id),
      docCaiDat(k.client, k.chiNhanh.id),
    ]);
    ({ ds: hien, coSau } = catTrang(trang));
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}
const dangMo = new Map(ds.filter(x => x.trang_thai === 'dang_dem' || x.trang_thai === 'cho_duyet').map(x => [x.vi_tri_id, x]));
// Nhân viên quầy chỉ đếm quầy — không thấy thẻ kho lạnh.
// Chỉ kho và quầy — không "chờ hủy", không "Đang mang ra quầy" (0032).
const viTriDem = viTri.filter(v => (v.loai === 'kho' || v.loai === 'quay') && v.dang_dung && (!laQuay || v.loai === 'quay'));
const DEM_QUAY = '/noi-bo/kho/quay/dem';
// Thẻ phiếu gọn hai dòng (Khánh duyệt 22/10/2026): không còn dòng người lập (xem trong phiếu), nên không đọc tên.
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="kiem-ke">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaBatDau1}<a href="/noi-bo/kho">{t.tongQuan}</a>.</p>
  ) : (
    <>
      <p class="nb-dan">
        {t.dan}
        {caiDat?.nguon_so_ban !== 'ipos'
          ? <>{t.chuaIpos1}<strong>{t.chuaIpos2}</strong>{t.chuaIpos3}</>
          : <>{t.coIpos}</>}
      </p>

      {k.duoc('van_hanh') && viTriDem.length > 0 && (
        <div class="kho-o-so-luoi">
          {viTriDem.map(v => {
            const mo = dangMo.get(v.id);
            const kieu = kieuTheoViTri(v.loai);
            const traVe = mo?.trang_thai === 'dang_dem' && !!mo.ly_do;
            // Nhân viên quầy: đếm ở màn Đếm quầy (quét cộng dồn).
            if (laQuay && v.loai === 'quay' && mo?.trang_thai !== 'cho_duyet' && (!mo || mo.kieu === 'theo_mat_hang')) {
              return (
                <a class={`kho-o-so ${traVe ? 'gap' : ''}`} href={`${DEM_QUAY}?vi_tri=${v.id}`}>
                  <b style="font-size:1.1rem">{v.ten}</b>
                  <span>{mo ? t.quetTiep(mo.so_phieu) : t.bamQuet}</span>
                  {traVe && <span style="display:block;margin-top:.35rem;color:inherit"><strong>{t.traVe}</strong> {mo!.ly_do}{t.demLai}</span>}
                </a>
              );
            }
            return mo ? (
              <a class={`kho-o-so ${mo.trang_thai === 'cho_duyet' ? 'luu-y' : traVe ? 'gap' : ''}`} href={`/noi-bo/kho/kiem-ke/${mo.id}`}>
                <b style="font-size:1.1rem">{v.ten}</b>
                <span>{mo.so_phieu} · {mo.trang_thai === 'cho_duyet' ? t.daGuiCho : t.dangDemSo(mo.so_dong_da_dem, mo.so_dong)}</span>
                {traVe && <span style="display:block;margin-top:.35rem;color:inherit"><strong>{t.traVe}</strong> {mo.ly_do}{t.demLai}</span>}
              </a>
            ) : (
              <form method="POST" class="kho-o-so">
                <input type="hidden" name="viec" value="bat_dau" />
                <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
                <input type="hidden" name="vi_tri_id" value={v.id} />
                <b style="font-size:1.1rem">{v.ten}</b>
                <span>{kieu === 'theo_mat_hang' ? t.demGoi : t.demLo}</span>
                {laQuay ? (
                  <input type="hidden" name="kieu" value={kieu} />
                ) : (
                  <details style="margin:.35rem 0 0">
                    <summary style="cursor:pointer;min-height:48px;display:flex;align-items:center;font-size:.9rem;font-weight:600">{t.tuyChon}</summary>
                    <label class="nb-o" style="margin:0 0 .5rem">
                      <span style="font-size:.88rem;color:inherit">{t.cachDem}</span>
                      <select name="kieu">
                        <option value="theo_mat_hang" selected={kieu === 'theo_mat_hang'}>{t.demGoi}</option>
                        <option value="theo_lo" selected={kieu === 'theo_lo'}>{t.demLoDu}</option>
                      </select>
                    </label>
                  </details>
                )}
                <button type="submit" class="nb-nut" style="width:100%;margin-top:.5rem">{t.batDau}</button>
              </form>
            );
          })}
        </div>
      )}

      <nav class="kho-dh" aria-label={t.locTrangThai}>
        {LOC.map(([v, ten]) => (
          <a href={v ? `/noi-bo/kho/kiem-ke?loc=${v}` : '/noi-bo/kho/kiem-ke'} aria-current={loc === v ? 'page' : undefined}>{ten}</a>
        ))}
      </nav>

      <LocDanhSach duong="/noi-bo/kho/kiem-ke" tim={tim} giu={{ loc }} coCuaToi={k.duoc('van_hanh')}
        goiY={t.goiYTim} />

      {hien.length === 0 ? (
        <p class="nb-rong">{tim.trang > 1 ? t.hetDs : dangTim(tim) ? t.khongKhop : `${t.chuaCo}${loc ? t.oTrangThai : ''}.`}</p>
      ) : hien.map(x => {
        // Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
        const [nhan, lopTT] = trangThaiKho(x.trang_thai, nn);
        const lop = lopTT || 'tat';
        return (
          <a href={`/noi-bo/kho/kiem-ke/${x.id}`} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
            <div class="nb-dong-dau">
              <strong>{x.so_phieu} · {x.ten_vi_tri}</strong>
              <span class={`nb-nhan ${lop}`}>{nhan}</span>
            </div>
            {x.trang_thai === 'dang_dem' && x.ly_do && <p class="nb-dong-tom"><strong>{t.quanLyTraVe}:</strong> {x.ly_do}</p>}
            <p class="nb-dong-tom">
              {dinhDangNgay(x.ngay_kiem)} · {x.kieu === 'theo_lo' ? t.kieuLo : t.kieuMon} · {t.daDem} {t.soDong(x.so_dong_da_dem, x.so_dong)}
            </p>
          </a>
        );
      })}
      <PhanTrang duong="/noi-bo/kho/kiem-ke" trang={tim.trang} coSau={coSau} />
    </>
  )}
</Kho>
