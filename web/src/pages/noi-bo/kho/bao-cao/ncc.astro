---
/**
 * KHO — BÁO CÁO · ĐÁNH GIÁ NHÀ CUNG CẤP (GĐ8a, migration 0039)
 *
 * Mỗi NCC trong kỳ: số lần giao, kg nhận, đơn giao thiếu / trễ, thu hồi pha
 * lóc trung bình của tảng NCC đó, kg trả lại, điểm sao 1–5 (công thức ở
 * kho_bao_cao_ncc). Vai xem giá thấy thêm giá TB/kg, số lần lệch hóa đơn, số
 * ngày trả tiền TB — database trả null cho vai khác, trang bỏ hẳn các cột đó.
 *
 * Mở cho nhap hoặc xem_gia (thủ kho xem kg — biết NCC nào hay giao thiếu).
 * Kỳ: nút nhanh như trang Báo cáo; CSV bao-cao/ncc.csv cùng cột.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho } from '../../../../lib/kho/trang.ts';
import { kyBaoCao, kyNhanh, tinhTong } from '../../../../lib/kho/bao-cao.ts';
import {
  docDanhGiaNcc, dinhNghiaDanhGiaNcc, chuSao, mucSao, CONG_THUC_SAO, type DongDanhGiaNcc,
} from '../../../../lib/kho/dat-hang.ts';
import { congNgay, dinhDangKg, dinhDangNgay, dinhDangPhanTram, dinhDangTien, homNayVn } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('nhap') && !k.duoc('xem_gia')) return Astro.redirect('/noi-bo/kho', 302);

const q = Astro.url.searchParams;
const homNay = homNayVn();
const { tu, den } = kyBaoCao(q, homNay);
const cacKy = kyNhanh(homNay);
const kyDangChon = cacKy.find(x => x.tu === tu && x.den === den)?.ten;
const coGia = k.duoc('xem_gia');
const dn = dinhNghiaDanhGiaNcc(coGia);

let dong: DongDanhGiaNcc[] = [];
let loiDoc = k.loiDoc;
let daDoc = false;
if (congNgay(tu, 366) < den) {
  loiDoc = 'Khoảng ngày dài quá — chọn tối đa 1 năm.';
} else if (k.chiNhanh && k.daKhoiTao) {
  const kq = await docDanhGiaNcc(k.client, k.chiNhanh.id, tu, den);
  dong = kq.dong;
  loiDoc = kq.loi ?? loiDoc;
  daDoc = !kq.loi;
}
const tong = tinhTong(dn, dong as unknown as Record<string, unknown>[])[0];
const kyChu = tu === den ? dinhDangNgay(tu) : `${dinhDangNgay(tu)} – ${dinhDangNgay(den)}`;
const link = (thay: Record<string, string>) => `/noi-bo/kho/bao-cao/ncc?${new URLSearchParams({ tu, den, ...thay }).toString()}`;
const soChu = (n: number) => (n === 0 ? '·' : n.toLocaleString('vi-VN'));
---
<Kho k={k} huongDan="danh-gia-ncc" tieuDe="Đánh giá nhà cung cấp" rong>
  <h1>Đánh giá nhà cung cấp</h1>
  <p>
    {coGia && <><a href="/noi-bo/kho/bao-cao">← Báo cáo kho</a> · </>}
    <a href="/noi-bo/kho/dat-hang">Đơn đặt hàng</a>
  </p>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  <form method="GET" action="/noi-bo/kho/bao-cao/ncc" class="nb-the">
    <nav class="kho-dh" aria-label="Chọn nhanh kỳ" style="margin:0;padding:0 0 .75rem">
      {cacKy.map(x => (
        <a href={link({ tu: x.tu, den: x.den })} aria-current={x.ten === kyDangChon ? 'page' : undefined} style="min-height:48px">{x.ten}</a>
      ))}
    </nav>
    <div class="kho-luoi">
      <label class="nb-o"><span>Từ ngày</span><input type="date" name="tu" value={tu} required /></label>
      <label class="nb-o"><span>Đến ngày</span><input type="date" name="den" value={den} required /></label>
    </div>
    <div class="kho-thanh-nut" style="margin:0">
      <button type="submit" class="nb-nut phu">Xem</button>
      <button type="submit" class="nb-nut phu" formaction="/noi-bo/kho/bao-cao/ncc.csv">Tải về Excel (CSV)</button>
    </div>
  </form>

  <p class="nb-dan">
    <strong>{kyChu}</strong>. Tính theo phiếu nhận hàng <strong>đã duyệt</strong> trong kỳ và đơn đặt hàng có
    <strong>ngày giao</strong> trong kỳ. <strong>Giao thiếu</strong>: đơn đã có hàng về mà còn món chưa đủ (dưới 95% số kg đặt)
    khi đã qua ngày giao. <strong>Giao trễ</strong>: hàng về sau ngày giao, hoặc qua ngày giao mà chưa thấy hàng.
  </p>

  {!k.daKhoiTao ? (
    <p class="nb-rong">Chi nhánh chưa bắt đầu dùng kho. Vào <a href="/noi-bo/kho">Tổng quan kho</a>.</p>
  ) : daDoc && (
    dong.length === 0 ? (
      <p class="nb-rong">{dn.khiTrong.cau}. <a href="/noi-bo/kho/dat-hang">Mở Đặt hàng</a></p>
    ) : (
      <>
        <div class="kho-bang-khung">
          <table class="kho-bang kho-bao-cao">
            <thead>
              <tr>
                <th>Nhà cung cấp</th>
                <th>Điểm</th>
                <th class="so">Lần giao</th>
                <th class="so">Kg nhận</th>
                {coGia && <th class="so">Giá TB/kg</th>}
                <th class="so">Đơn đặt</th>
                <th class="so">Giao thiếu</th>
                <th class="so">Giao trễ</th>
                <th class="so">Thu hồi pha TB</th>
                <th class="so">Kg trả lại</th>
                {coGia && <th class="so">Lệch hóa đơn</th>}
                {coGia && <th class="so">Ngày trả tiền TB</th>}
              </tr>
            </thead>
            <tbody>
              {dong.map(d => (
                <tr>
                  <td><strong>{d.ten}</strong></td>
                  <td>
                    <span class={`ncc-sao ${mucSao(d.diem_sao)}`} title={d.diem_sao !== null ? `${String(d.diem_sao).replace('.', ',')} / 5` : undefined}>{chuSao(d.diem_sao)}</span>
                    {d.diem_sao !== null && <span class="kho-phu"> {String(d.diem_sao).replace('.', ',')}</span>}
                  </td>
                  <td class="so">{soChu(d.so_phieu)}</td>
                  <td class="so">{d.tong_kg ? dinhDangKg(d.tong_kg) : '·'}</td>
                  {coGia && <td class="so">{d.gia_tb_kg !== null ? dinhDangTien(d.gia_tb_kg) : '—'}</td>}
                  <td class="so">{soChu(d.so_don)}</td>
                  <td class="so">{d.so_don_thieu > 0 ? <strong class="chu-do">{d.so_don_thieu}{d.kg_thieu > 0 ? ` · ${dinhDangKg(d.kg_thieu)} kg` : ''}</strong> : '·'}</td>
                  <td class="so">{d.so_don_tre > 0 ? <strong class="chu-do">{d.so_don_tre}</strong> : '·'}</td>
                  <td class="so">{d.thu_hoi_tb_pt !== null ? <>{dinhDangPhanTram(d.thu_hoi_tb_pt)}<br /><span class="kho-phu">{d.so_phien_pha} phiên</span></> : '—'}</td>
                  <td class="so">{d.kg_tra ? dinhDangKg(d.kg_tra) : '·'}</td>
                  {coGia && <td class="so">{d.so_lan_lech_hoa_don ? <strong class="chu-do">{d.so_lan_lech_hoa_don}</strong> : '·'}</td>}
                  {coGia && <td class="so">{d.so_ngay_tra_tb !== null ? `${String(d.so_ngay_tra_tb).replace('.', ',')} ngày` : '—'}</td>}
                </tr>
              ))}
            </tbody>
            {tong && (
              <tfoot>
                <tr class="tong">
                  <td>Tổng</td>
                  <td></td>
                  <td class="so">{soChu(tong.so.so_phieu ?? 0)}</td>
                  <td class="so">{dinhDangKg(tong.so.tong_kg ?? 0)}</td>
                  {coGia && <td></td>}
                  <td class="so">{soChu(tong.so.so_don ?? 0)}</td>
                  <td class="so">{soChu(tong.so.so_don_thieu ?? 0)}</td>
                  <td class="so">{soChu(tong.so.so_don_tre ?? 0)}</td>
                  <td></td>
                  <td class="so">{tong.so.kg_tra ? dinhDangKg(tong.so.kg_tra) : '·'}</td>
                  {coGia && <td></td>}
                  {coGia && <td></td>}
                </tr>
              </tfoot>
            )}
          </table>
        </div>
        <p class="kho-phu"><strong>Điểm sao:</strong> {CONG_THUC_SAO} NCC chưa có phiếu hay đơn nào trong kỳ thì chưa chấm.
          {' '}<strong>Thu hồi pha TB</strong>: tỉ lệ thịt giữ lại khi pha lóc tảng của NCC đó (các phiên đã chốt trong kỳ).
          {coGia && <> <strong>Lệch hóa đơn</strong>: phiếu đã đối chiếu mà tiền hóa đơn khác tổng phiếu. <strong>Ngày trả tiền TB</strong>: từ ngày hóa đơn tới ngày trả, tính theo số tiền.</>}
        </p>
      </>
    )
  )}
</Kho>

<style>
  .ncc-sao { font-size: 1.05rem; letter-spacing: .05em; white-space: nowrap; }
  .ncc-sao.xanh { color: #1F7A4C; }
  .ncc-sao.vang { color: #9A6B00; }
  .ncc-sao.do { color: var(--do); }
  .ncc-sao.xam { color: var(--muc-nhat); font-size: .8rem; }
</style>
