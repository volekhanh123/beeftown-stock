---
/**
 * KHO — CÀI ĐẶT · MẶT HÀNG
 *
 * Danh mục lớn (gần như mọi phần con bò), nên có ba đường nhập:
 *   1. Tạo danh mục mẫu — một lần, khi danh mục còn trống
 *   2. Dán từ Excel — nhiều dòng một lúc. Bấm "Xem trước" thấy đủ thêm mới /
 *      cập nhật (cũ → mới) / lỗi; chưa ghi gì cho tới khi bấm "Xác nhận nhập".
 *      Ô trống = giữ giá trị cũ; khớp theo Mã, không có Mã thì theo Tên.
 *   3. Thêm / sửa từng mặt hàng
 * Sửa một mặt hàng: bấm "Sửa" → form hiện ở đầu trang (?sua=<id>), để trang
 * danh sách không phải chở cả trăm form.
 *
 * Sửa nhiều món một lượt trong bảng: trang con mat-hang/sua-nhanh (GĐ8c, 0041).
 *
 * "Sau pha để ở" (GĐ5c, 0033): gói quét nhãn lúc pha lóc tự vào kho lạnh hay
 * quầy theo món. Để trống = kho lạnh. Dán Excel có cột "Sau pha để ở".
 */
import Kho from '../../../../layouts/Kho.astro';
import TheTrangCon from '../../../../components/kho/TheTrangCon.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import FormMatHang from '../../../../components/kho/FormMatHang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import {
  docMatHang, docGiaTriThuHoi, docDinhNghia, luuMatHang, nhapCsvMatHang, taoDanhMucMau,
  xemTruocDanMatHang, chuKyDan, TEN_COT_DAN_NB,
  type MatHang, type GiaTriFormMatHang, type XemTruocDan, type DongGhiMatHang, type CotDan,
} from '../../../../lib/kho/danh-muc.ts';
import {
  boDau, cauLoiKho, dinhDangKg, dinhDangTien, kqHai, nhanKho, TEN_LOAI_MAT_HANG_NB, TEN_NOI_DE_SAU_PHA_NB,
  type KetQua,
} from '../../../../lib/kho/chung.ts';
import { docTruongThem, type DinhNghiaTruong } from '../../../../lib/kho/truong-them.ts';
import { chuBangU, docBangU, moTaBangU, type DongBangU } from '../../../../lib/kho/tang.ts';
import { chuOMa, docOMa, type DongOMa } from '../../../../lib/kho/o-ma.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tieuDe: { vi: 'Mặt hàng', en: 'Items' },
  veThietLap: { vi: '← Thiết lập kho', en: '← Inventory setup' },
  suaNhanhLink: { vi: 'Sửa nhanh nhiều món (giá, hạn dùng, mã cân, mức quầy / kho)',
                  en: 'Quick edit many items (price, use-by, scale code, counter / store levels)' },
  khongDoc: { vi: 'Không đọc được danh mục.', en: 'Could not read the catalog.' },
  trong: { vi: 'trống', en: 'empty' },
  soNgay: { vi: (n: number) => `${n} ngày`, en: (n: number) => `${n} ${s(n, 'day', 'days')}` },
  xemTruocBang: { vi: 'Xem trước bảng dán', en: 'Preview of the pasted table' },
  nThem: { vi: (n: number) => `${n} thêm mới`, en: (n: number) => `${n} new` },
  nCapNhat: { vi: (n: number) => `${n} cập nhật`, en: (n: number) => `${n} updated` },
  nGiu: { vi: (n: number) => `${n} giữ nguyên`, en: (n: number) => `${n} unchanged` },
  nLoi: { vi: (n: number) => `${n} lỗi`, en: (n: number) => `${n} ${s(n, 'error', 'errors')}` },
  chuaNhap: { vi: 'Chưa nhập được.', en: 'Not imported yet.' },
  suaChoNay: { vi: ' Sửa những chỗ này trong ô dán bên dưới rồi bấm "Xem trước" lại:',
               en: ' Fix these in the paste box below, then press "Preview" again:' },
  loiKhac: { vi: (n: number) => `… và ${n} lỗi khác.`, en: (n: number) => `… and ${n} more ${s(n, 'error', 'errors')}.` },
  boQuaCot: { vi: 'Bỏ qua cột không hiểu: ', en: 'Ignored columns that were not understood: ' },
  khongDoi: { vi: 'Không có gì thay đổi — danh mục đã đúng như bảng dán.', en: 'Nothing changes — the catalog already matches the pasted table.' },
  cotMatHang: { vi: 'Mặt hàng', en: 'Item' },
  cotSeDoi: { vi: 'Sẽ thay đổi', en: 'Will change' },
  capNhat: { vi: 'Cập nhật', en: 'Update' },
  ngungDungNho: { vi: ' · ngừng dùng', en: ' · no longer used' },
  theoTangNho: { vi: 'theo dõi theo tảng', en: 'tracked per primal' },
  themMoi: { vi: 'Thêm mới', en: 'New' },
  chiCoTen: { vi: 'Chỉ có tên — điền giá, hạn dùng sau.', en: 'Name only — fill in the price and use-by later.' },
  xacNhanNhap: { vi: 'Xác nhận nhập', en: 'Confirm import' },
  suaLaiBang: { vi: 'Sửa lại bảng dán', en: 'Edit the pasted table' },
  sua: { vi: 'Sửa: ', en: 'Edit: ' },
  luuThayDoi: { vi: 'Lưu thay đổi', en: 'Save changes' },
  dongKhongSua: { vi: 'Đóng, không sửa nữa', en: 'Close without editing' },
  dmTrong: { vi: 'Danh mục đang trống.', en: 'The catalog is empty.' },
  dmMau: { vi: ' Tạo nhanh 19 mặt hàng mẫu cho quán bò nướng (8 tảng nhập khẩu phổ biến, 8 phần cắt, 3 phụ phẩm) rồi sửa lại cho đúng quán mình. Danh mục mẫu KHÔNG có giá bán — giá do anh/chị nhập.',
           en: ' Quickly create 19 sample items for a beef grill restaurant (8 common imported primals, 8 cuts, 3 by-products), then adjust them to your restaurant. The sample catalog has NO sale prices — you enter the prices.' },
  taoMau: { vi: 'Tạo danh mục mẫu', en: 'Create sample catalog' },
  themMot: { vi: '+ Thêm một mặt hàng', en: '+ Add an item' },
  themMatHang: { vi: 'Thêm mặt hàng', en: 'Add item' },
  danExcel: { vi: 'Dán nhiều mặt hàng từ Excel', en: 'Paste many items from Excel' },
  dan1: { vi: 'Trong Excel chọn các ô (nên chọn cả ', en: 'In Excel, select the cells (best to include the ' },
  dongTieuDe: { vi: 'dòng tiêu đề', en: 'header row' },
  dan2: { vi: '), sao chép rồi dán vào đây.', en: '), copy them and paste them here.' },
  dan3: { vi: 'Có dòng tiêu đề thì các cột xếp thứ tự nào cũng được. Tiêu đề hiểu được:',
          en: 'With a header row, the columns can be in any order. Headers understood:' },
  tieuDeHieu: { vi: 'Tên · Loại · Nhóm · Hạn dùng · Giá bán · Mã cân · Mã · Quầy tối thiểu kg · Sau pha để ở',
                en: 'Name · Type · Category · Use-by days · Sale price · Scale code · Code · Counter minimum kg · After butchery' },
  dan4: { vi: '. Không có dòng tiêu đề thì cột phải theo đúng thứ tự đó.',
          en: ' (the Vietnamese headers work too). Without a header row, the columns must be in exactly that order.' },
  dan5: { vi: 'Mặt hàng đã có (cùng Mã, hoặc cùng Tên khi không ghi Mã) thì được cập nhật.',
          en: 'Items that already exist (same Code, or same Name when there is no Code) are updated.' },
  oTrongGiu: { vi: 'Ô để trống = giữ nguyên giá trị cũ.', en: 'An empty cell = keep the old value.' },
  dan6: { vi: ' Tên chưa có thì thêm mặt hàng mới.', en: ' A new name adds a new item.' },
  loaiGhi: { vi: 'Loại ghi ', en: 'For Type, write ' },
  tuTang: { vi: 'tảng', en: 'primal' },
  tuPhanCat: { vi: 'phần cắt', en: 'cut' },
  hoac: { vi: ' hoặc ', en: ' or ' },
  tuPhuPham: { vi: 'phụ phẩm', en: 'by-product' },
  sauPhaGhi: { vi: 'Sau pha để ở ghi ', en: 'For After butchery, write ' },
  tuKhoLanh: { vi: 'kho lạnh', en: 'cold store' },
  tuQuay: { vi: 'quầy', en: 'counter' },
  dan7: { vi: 'Bấm "Xem trước" để thấy những gì sẽ đổi — chưa lưu gì cho tới khi bấm "Xác nhận nhập".',
          en: 'Press "Preview" to see what will change — nothing is saved until you press "Confirm import".' },
  dan8: { vi: 'Muốn xóa hẳn một giá trị (ví dụ bỏ mã cân) thì bấm "Sửa" ở từng mặt hàng.',
          en: 'To clear a value completely (for example remove a scale code), press "Edit" on that item.' },
  noiDungDan: { vi: 'Nội dung dán', en: 'Pasted content' },
  danVd: { vi: 'Tên\tLoại\tGiá bán\tMã cân\nThăn ngoại cắt lát\tphần cắt\t650000\t101\nNạc vai nguyên tảng\ttảng',
           en: 'Name\tType\tSale price\tScale code\nSliced striploin\tcut\t650000\t101\nWhole chuck roll\tprimal' },
  xemTruoc: { vi: 'Xem trước', en: 'Preview' },
  danhMuc: { vi: (n: number) => `Danh mục (${n})`, en: (n: number) => `Catalog (${n})` },
  locLoai: { vi: 'Lọc theo loại', en: 'Filter by type' },
  tatCa: { vi: 'Tất cả', en: 'All' },
  tang: { vi: 'Tảng', en: 'Primals' },
  phanCat: { vi: 'Phần cắt', en: 'Cuts' },
  phuPham: { vi: 'Phụ phẩm', en: 'By-products' },
  timVd: { vi: 'Tìm tên, mã…', en: 'Search name, code…' },
  tim: { vi: 'Tìm', en: 'Search' },
  khongCo: { vi: 'Không có mặt hàng nào.', en: 'No items.' },
  cotLoai: { vi: 'Loại', en: 'Type' },
  cotGia: { vi: 'Giá bán/kg', en: 'Sale price/kg' },
  cotHsd: { vi: 'HSD', en: 'Use-by' },
  chuaCoGia: { vi: 'chưa có', en: 'not set' },
  suaNut: { vi: 'Sửa', en: 'Edit' },
});

const q = Astro.url.searchParams;
const locLoai = q.get('loai') ?? '';
const tim = (q.get('tim') ?? '').trim();
const suaId = q.get('sua') ?? '';

let matHang: MatHang[] = [];
let thuHoi = new Map<string, number | null>();
let bangU = new Map<string, DongBangU[]>();
let oMa = new Map<string, DongOMa[]>();
let dinhNghia: DinhNghiaTruong[] = [];
let loiDoc = k.loiDoc;
try {
  [matHang, thuHoi, dinhNghia, bangU, oMa] = await Promise.all([
    docMatHang(k.client), docGiaTriThuHoi(k.client), docDinhNghia(k.client, 'mat_hang'), docBangU(k.client), docOMa(k.client),
  ]);
} catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }

let bao: KetQua | null = k.bao;
let nhapLai: FormData | null = null;
let csvLai = '';
// Dán từ Excel: bước 1 "Xem trước" chỉ so, không ghi; bước 2 "Xác nhận nhập"
// gửi lại đúng nội dung đó (ô ẩn) kèm chữ ký của bản xem trước.
let xemTruoc: XemTruocDan | null = null;
const form = await docFormGui(Astro);
if (form) {
  const viec = String(form.get('viec') ?? '');
  let kq: KetQua | null = null;
  if (viec === 'luu') {
    const id = String(form.get('id') ?? '');
    kq = await luuMatHang(k.client, form, dinhNghia, matHang.find(m => m.id === id));
    if (!kq.ok) nhapLai = form;
  } else if (viec === 'xem_truoc') {
    csvLai = String(form.get('noi_dung') ?? '');
    if (loiDoc) {
      kq = kqHai(false, { vi: 'Chưa đọc được danh mục hiện tại nên chưa so được — tải lại trang rồi bấm Xem trước lần nữa.',
                          en: 'Could not read the current catalog, so nothing could be compared — reload the page and press Preview again.' });
    } else if (!csvLai.trim()) {
      kq = kqHai(false, { vi: 'Ô dán đang trống — chọn các ô trong Excel, sao chép rồi dán vào.',
                          en: 'The paste box is empty — select the cells in Excel, copy them and paste them in.' });
    } else xemTruoc = xemTruocDanMatHang(matHang, csvLai);
  } else if (viec === 'nhap_excel') {
    csvLai = String(form.get('noi_dung') ?? '');
    const r = await nhapCsvMatHang(k.client, csvLai, String(form.get('chu_ky') ?? ''));
    kq = { ok: r.ok, cau: r.cau, cauEn: r.cauEn };
    xemTruoc = r.xemTruoc ?? null;
  } else if (viec === 'mau') {
    kq = await taoDanhMucMau(k.client);
  } else kq = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
  if (kq?.ok) return chuyenHuong(Astro, `/noi-bo/kho/cai-dat/mat-hang${locLoai ? `?loai=${locLoai}` : ''}`, kq);
  if (kq) bao = kq;
}
const coThayDoi = !!xemTruoc && (xemTruoc.them.length > 0 || xemTruoc.sua.length > 0);
const choXacNhan = !!xemTruoc && coThayDoi && xemTruoc.loi.length === 0;
/** Lỗi của bản xem trước theo ngôn ngữ đang xem (loi / loiEn cùng thứ tự). */
const loiXem = xemTruoc ? (nn === 'en' ? xemTruoc.loiEn : xemTruoc.loi) : [];
/** Giá trị một ô trong bảng xem trước. */
const hienO = (c: CotDan, v: DongGhiMatHang[CotDan]): string => {
  if (c === 'noi_de_sau_pha') return nhanKho(TEN_NOI_DE_SAU_PHA_NB, String(v ?? 'kho'), nn);
  if (v === null || v === '') return t.trong;
  if (c === 'gia_ban_kg') return dinhDangTien(v as number, nn);
  if (c === 'han_dung_ngay') return t.soNgay(Number(v));
  if (c === 'ton_toi_thieu_kg') return `${dinhDangKg(v as number, nn)} kg`;
  if (c === 'loai') return nhanKho(TEN_LOAI_MAT_HANG_NB, v as string, nn);
  return String(v);
};
const COT_MOI: CotDan[] = ['nhom', 'han_dung_ngay', 'gia_ban_kg', 'ma_can', 'ton_toi_thieu_kg', 'noi_de_sau_pha'];

// Số điền sẵn vào ô: "650.000" · "2,5" (tiếng Anh "650,000" · "2.5") — luuMatHang đọc được cả hai. Trống → ''.
const oTien = (x: number | null | undefined) => (x === null || x === undefined ? '' : x.toLocaleString(nn === 'en' ? 'en-US' : 'vi-VN'));
const oKg = (x: number | null | undefined) => (x === null || x === undefined ? '' : nn === 'en' ? String(x) : String(x).replace('.', ','));
const tuDb = (m: MatHang): GiaTriFormMatHang => ({
  id: m.id, ma: m.ma, ten: m.ten, ten_phu: m.ten_phu ?? '', nhom: m.nhom ?? '', loai: m.loai,
  dem_goi: m.dem_goi, don_vi_goi: m.don_vi_goi,
  han_dung_ngay: m.han_dung_ngay?.toString() ?? '', canh_bao_truoc_ngay: m.canh_bao_truoc_ngay?.toString() ?? '',
  gia_ban_kg: oTien(m.gia_ban_kg),
  xu_ly_mac_dinh: m.xu_ly_mac_dinh, ma_can: m.ma_can ?? '',
  ton_toi_thieu_kg: oKg(m.ton_toi_thieu_kg),
  noi_de_sau_pha: m.noi_de_sau_pha === 'quay' ? 'quay' : '',
  kho_toi_thieu_kg: oKg(m.kho_toi_thieu_kg),
  kho_toi_da_kg: oKg(m.kho_toi_da_kg),
  ma_misa: m.ma_misa ?? '',
  theo_tang: !!m.theo_tang, bang_u: chuBangU(bangU.get(m.id) ?? []),
  o_ma: chuOMa((oMa.get(m.id) ?? []).map(o => o.ma_can)),
  thu_tu: String(m.thu_tu), dang_dung: m.dang_dung, truong_them: m.truong_them ?? {},
  gia_tri_thu_hoi_kg: oTien(thuHoi.get(m.id)),
});
const tuForm = (f: FormData, id?: string): GiaTriFormMatHang => {
  const g = (t: string) => String(f.get(t) ?? '');
  const tt = docTruongThem(f, dinhNghia, undefined, dangSua?.truong_them ?? {}).giaTri;
  return {
    id, ma: g('ma'), ten: g('ten'), ten_phu: g('ten_phu'), nhom: g('nhom'), loai: g('loai') || 'phan_cat',
    dem_goi: g('dem_goi') !== 'khong', don_vi_goi: g('don_vi_goi'), han_dung_ngay: g('han_dung_ngay'),
    canh_bao_truoc_ngay: g('canh_bao_truoc_ngay'), gia_ban_kg: g('gia_ban_kg'), xu_ly_mac_dinh: g('xu_ly_mac_dinh'),
    ma_can: g('ma_can'), ton_toi_thieu_kg: g('ton_toi_thieu_kg'), noi_de_sau_pha: g('noi_de_sau_pha') === 'quay' ? 'quay' : '',
    kho_toi_thieu_kg: g('kho_toi_thieu_kg'), kho_toi_da_kg: g('kho_toi_da_kg'), ma_misa: g('ma_misa'),
    theo_tang: g('theo_tang') === 'co', bang_u: g('bang_u'), o_ma: g('o_ma'),
    thu_tu: g('thu_tu'),
    dang_dung: g('dang_dung') !== 'khong', truong_them: tt, gia_tri_thu_hoi_kg: g('gia_tri_thu_hoi_kg'),
  };
};
const TRONG: GiaTriFormMatHang = {
  ma: '', ten: '', ten_phu: '', nhom: '', loai: locLoai || 'phan_cat', dem_goi: true, don_vi_goi: '',
  han_dung_ngay: '', canh_bao_truoc_ngay: '', gia_ban_kg: '', xu_ly_mac_dinh: 'nhap_kho', ma_can: '',
  ton_toi_thieu_kg: '', noi_de_sau_pha: '', kho_toi_thieu_kg: '', kho_toi_da_kg: '', thu_tu: '', dang_dung: true, truong_them: {}, gia_tri_thu_hoi_kg: '',
};

const idLoi = nhapLai ? String(nhapLai.get('id') ?? '') : '';
const dangSua = matHang.find(m => m.id === (idLoi || suaId));
const gtSua = dangSua ? (nhapLai && idLoi ? tuForm(nhapLai, dangSua.id) : tuDb(dangSua)) : null;
const gtMoi = nhapLai && !idLoi ? tuForm(nhapLai) : TRONG;

const timBoDau = boDau(tim).toLowerCase();
const ds = matHang.filter(m =>
  (!locLoai || m.loai === locLoai)
  && (!timBoDau || boDau(`${m.ten} ${m.ma} ${m.ten_phu ?? ''} ${m.nhom ?? ''}`).toLowerCase().includes(timBoDau)));
const coXemGia = k.duoc('xem_gia');
---
<Kho k={k} huongDan="mat-hang" tieuDe={t.tieuDe} rong>
  <TheTrangCon k={k} cha="cai_dat" />
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/cai-dat">{t.veThietLap}</a> · <a href="/noi-bo/kho/cai-dat/mat-hang/sua-nhanh">{t.suaNhanhLink}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {xemTruoc && (
    <section class="nb-the" aria-labelledby="xem-truoc">
      <h2 id="xem-truoc" style="margin-top:0">{t.xemTruocBang}</h2>
      <p class="dan-dem">
        {xemTruoc.them.length > 0 && <span class="dan-nhan them">{t.nThem(xemTruoc.them.length)}</span>}
        {xemTruoc.sua.length > 0 && <span class="dan-nhan sua">{t.nCapNhat(xemTruoc.sua.length)}</span>}
        {xemTruoc.giu > 0 && <span class="dan-nhan giu">{t.nGiu(xemTruoc.giu)}</span>}
        {loiXem.length > 0 && <span class="dan-nhan loi">{t.nLoi(loiXem.length)}</span>}
      </p>
      {loiXem.length > 0 && (
        <div class="nb-bao loi" role="alert">
          <p><strong>{t.chuaNhap}</strong>{t.suaChoNay}</p>
          <ul class="dan-loi">
            {loiXem.slice(0, 30).map(l => <li>{l}</li>)}
          </ul>
          {loiXem.length > 30 && <p>{t.loiKhac(loiXem.length - 30)}</p>}
        </div>
      )}
      {xemTruoc.boQua.length > 0 && (
        <p class="kho-phu">{t.boQuaCot}{xemTruoc.boQua.join(', ')}.</p>
      )}
      {!coThayDoi ? (
        loiXem.length === 0 && <p class="nb-rong">{t.khongDoi}</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>{t.cotMatHang}</th><th>{t.cotSeDoi}</th></tr></thead>
            <tbody>
              {xemTruoc.sua.map(x => (
                <tr>
                  <td>
                    <span class="dan-nhan sua">{t.capNhat}</span><br />
                    <strong>{x.ten}</strong><br />
                    <span class="kho-phu">{x.ma}{!x.dang_dung ? t.ngungDungNho : ''}</span>
                  </td>
                  <td>
                    <ul class="dan-doi">
                      {x.cot_doi.map(c => (
                        <li>{TEN_COT_DAN_NB[c][nn]}: <del>{hienO(c, x.truoc[c])}</del> → <ins>{hienO(c, x.sau[c])}</ins></li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
              {xemTruoc.them.map(h => (
                <tr>
                  <td>
                    <span class="dan-nhan them">{t.themMoi}</span><br />
                    <strong>{h.ten}</strong><br />
                    <span class="kho-phu">{h.ma} · {nhanKho(TEN_LOAI_MAT_HANG_NB, h.loai, nn)}</span>
                  </td>
                  <td>
                    {COT_MOI.some(c => h[c] !== null) ? (
                      <ul class="dan-doi">
                        {COT_MOI.filter(c => h[c] !== null).map(c => (
                          <li>{TEN_COT_DAN_NB[c][nn]}: <ins>{hienO(c, h[c])}</ins></li>
                        ))}
                      </ul>
                    ) : <span class="kho-phu">{t.chiCoTen}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {choXacNhan ? (
        <form method="POST" class="kho-thanh-nut dinh">
          <input type="hidden" name="viec" value="nhap_excel" />
          <input type="hidden" name="chu_ky" value={chuKyDan(xemTruoc)} />
          <textarea name="noi_dung" hidden aria-hidden="true">{csvLai}</textarea>
          <button type="submit" class="nb-nut">{t.xacNhanNhap}</button>
          <a class="nb-nut phu" href="#dan-excel">{t.suaLaiBang}</a>
        </form>
      ) : (
        <p style="margin-bottom:0"><a href="#dan-excel">{t.suaLaiBang} ↓</a></p>
      )}
    </section>
  )}

  {gtSua && (
    <>
      <h2>{t.sua}{dangSua!.ten}</h2>
      <FormMatHang gt={gtSua} dinhNghia={dinhNghia} coXemGia={coXemGia} nutLuu={t.luuThayDoi} />
      <p><a href="/noi-bo/kho/cai-dat/mat-hang">{t.dongKhongSua}</a></p>
    </>
  )}

  {matHang.length === 0 && (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="mau" />
      <p style="margin-top:0"><strong>{t.dmTrong}</strong>{t.dmMau}</p>
      <button type="submit" class="nb-nut">{t.taoMau}</button>
    </form>
  )}

  <details class="nb-the" open={!gtSua && (matHang.length === 0 || (!!nhapLai && !idLoi))}>
    <summary style="cursor:pointer;font-weight:700">{t.themMot}</summary>
    <div style="margin-top:1rem">
      <FormMatHang gt={gtMoi} dinhNghia={dinhNghia} coXemGia={coXemGia} nutLuu={t.themMatHang} />
    </div>
  </details>

  <details class="nb-the" id="dan-excel" open={!!csvLai}>
    <summary style="cursor:pointer;font-weight:700">{t.danExcel}</summary>
    <form method="POST" style="margin-top:1rem">
      <input type="hidden" name="viec" value="xem_truoc" />
      <div class="nb-dan" style="font-size:.88rem">
        <p>{t.dan1}<strong>{t.dongTieuDe}</strong>{t.dan2} {t.dan3}{' '}
          <strong>{t.tieuDeHieu}</strong>{t.dan4}</p>
        <p>{t.dan5}{' '}
          <strong>{t.oTrongGiu}</strong>{t.dan6} {t.loaiGhi}<em>{t.tuTang}</em>, <em>{t.tuPhanCat}</em>{t.hoac}<em>{t.tuPhuPham}</em>. {t.sauPhaGhi}<em>{t.tuKhoLanh}</em>{t.hoac}<em>{t.tuQuay}</em>.</p>
        <p>{t.dan7} {t.dan8}</p>
      </div>
      <label class="nb-o">
        <span>{t.noiDungDan}</span>
        <textarea name="noi_dung" rows="8" placeholder={t.danVd}>{csvLai}</textarea>
      </label>
      <button type="submit" class="nb-nut">{t.xemTruoc}</button>
    </form>
  </details>

  <h2>{t.danhMuc(matHang.length)}</h2>
  <nav class="kho-dh" aria-label={t.locLoai}>
    {[['', t.tatCa], ['tang', t.tang], ['phan_cat', t.phanCat], ['phu_pham', t.phuPham]].map(([v, ten]) => (
      <a href={v ? `/noi-bo/kho/cai-dat/mat-hang?loai=${v}` : '/noi-bo/kho/cai-dat/mat-hang'} aria-current={locLoai === v ? 'page' : undefined}>{ten}</a>
    ))}
  </nav>
  <form method="GET" style="display:flex;gap:.5rem;margin-bottom:1rem">
    {locLoai && <input type="hidden" name="loai" value={locLoai} />}
    <label class="nb-o" style="flex:1;margin:0"><input type="search" name="tim" value={tim} placeholder={t.timVd} aria-label={t.tim} /></label>
    <button type="submit" class="nb-nut phu">{t.tim}</button>
  </form>

  {ds.length === 0 ? <p class="nb-rong">{t.khongCo}</p> : (
    <div class="kho-bang-khung">
      <table class="kho-bang">
        {/* Gọn 23/10/2026 (Khánh duyệt): bỏ cột Mã cân và Pha lóc ra — xem, sửa ở nút Sửa của từng món. */}
        <thead><tr><th>{t.cotMatHang}</th><th>{t.cotLoai}</th><th class="so">{t.cotGia}</th><th class="so">{t.cotHsd}</th><th></th></tr></thead>
        <tbody>
          {ds.map(m => (
            <tr style={m.dang_dung ? '' : 'opacity:.5'}>
              <td><strong>{m.ten}</strong><br /><span class="kho-phu">{m.ma}{m.nhom ? ` · ${m.nhom}` : ''}{m.ten_phu ? ` · ${m.ten_phu}` : ''}{!m.dang_dung ? t.ngungDungNho : ''}</span></td>
              <td>{nhanKho(TEN_LOAI_MAT_HANG_NB, m.loai, nn)}{m.theo_tang && <><br /><span class="kho-phu" title={moTaBangU(bangU.get(m.id) ?? [], nn)}>{t.theoTangNho}</span></>}</td>
              <td class="so">{m.gia_ban_kg !== null ? dinhDangTien(m.gia_ban_kg, nn) : (m.loai === 'phan_cat' ? <span class="kho-han sap_het">{t.chuaCoGia}</span> : '—')}</td>
              <td class="so">{m.han_dung_ngay ? t.soNgay(m.han_dung_ngay) : '—'}</td>
              <td><a href={`/noi-bo/kho/cai-dat/mat-hang?sua=${m.id}${locLoai ? `&loai=${locLoai}` : ''}`}>{t.suaNut}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Kho>

<style>
  .dan-dem { display: flex; flex-wrap: wrap; gap: .4rem; }
  /* Nhãn đếm của bản xem trước — không chỉ khác bằng màu: thêm = viền đen và dấu "+"; cập nhật = nền xám E2 (lưu ý);
     giữ = chữ xám, không nền, không viền; lỗi = nền đỏ chữ trắng. Viền trong suốt để chế độ tương phản cao vẫn vẽ khung. */
  .dan-nhan { display: inline-block; font-size: .72rem; font-weight: 700; padding: .15rem .45rem; border-radius: 4px; white-space: nowrap; border: 1.5px solid transparent; }
  .dan-nhan.them { background: transparent; color: var(--than); border: 1.5px solid var(--than); }
  .dan-nhan.them::before { content: '+ '; content: '+ ' / ''; }
  .dan-nhan.sua { background: var(--kem-dam); color: var(--than); }
  .dan-nhan.giu { background: transparent; color: var(--muc-nhat); }
  .dan-nhan.loi { background: var(--do); color: var(--kem); }
  .dan-loi { margin: .5rem 0 0; padding-left: 1.2rem; }
  .dan-doi { margin: 0; padding-left: 1.1rem; }
  .dan-doi li + li { margin-top: .2rem; }
  /* Cũ gạch ngang chữ xám, mới nền xám E2 và gạch chân đen — nhìn là thấy ô nào đổi. */
  .dan-doi del { color: var(--muc-nhat); }
  .dan-doi ins { text-decoration: underline 2px var(--than); text-underline-offset: 2px; font-weight: 700; background: var(--kem-dam); padding: 0 .25rem; border-radius: 3px; }
</style>
