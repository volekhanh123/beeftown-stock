---
/**
 * KHO — CÀI ĐẶT · Ô THÔNG TIN THÊM
 *
 * Chủ nhà hàng tự tạo ô mới cho form mà không cần lập trình viên: "Xuất xứ"
 * cho mặt hàng, "Nhiệt độ khi nhận" cho từng lô, "Số tờ khai" cho phiếu nhập…
 *
 * Tên máy (khoa) sinh tự động từ tên ô và KHÔNG đổi được; kiểu dữ liệu cũng
 * không đổi được — dữ liệu cũ đã lưu theo chúng. Muốn đổi thì tắt ô cũ, tạo ô
 * mới: giá trị cũ vẫn hiện, chỉ đọc.
 *
 * Chỉ chủ nhà hàng tạo/sửa được (database chặn — policy kho_truong_them_them).
 * Quản lý xem được danh sách để biết form đang hỏi gì.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docDinhNghia, luuDinhNghia } from '../../../../lib/kho/danh-muc.ts';
import { cauLoiKho, nhanKho, TEN_DOI_TUONG_TRUONG_NB, TEN_KIEU_TRUONG_NB, type KetQua } from '../../../../lib/kho/chung.ts';
import type { DinhNghiaTruong } from '../../../../lib/kho/truong-them.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc') && !k.duoc('cai_dat_goc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);
const sua = k.duoc('cai_dat_goc');
const nn = k.nn;
const t = dichNB(nn, {
  tieuDe: { vi: 'Ô thông tin thêm', en: 'Custom fields' },
  veThietLap: { vi: '← Thiết lập kho', en: '← Inventory setup' },
  khongDoc: { vi: 'Không đọc được ô thông tin.', en: 'Could not read the custom fields.' },
  gt1: { vi: 'Tự thêm ô vào form mà không cần sửa phần mềm. Ví dụ: ', en: 'Add your own fields to forms without changing the software. For example: ' },
  vd1: { vi: 'Xuất xứ', en: 'Origin' },
  gt2: { vi: ' (chọn Úc / Mỹ / Nhật) cho mặt hàng, ', en: ' (pick Australia / USA / Japan) for items, ' },
  vd2: { vi: 'Nhiệt độ khi nhận', en: 'Temperature on arrival' },
  gt3: { vi: ' (số) cho từng lô hàng nhập, ', en: ' (a number) for each received lot, ' },
  vd3: { vi: 'Số tờ khai hải quan', en: 'Customs declaration number' },
  gt4: { vi: ' cho phiếu nhập. Ô có dấu * là bắt buộc — phiếu nhập thiếu ô bắt buộc thì không gửi duyệt được.',
         en: ' for goods receipts. Fields marked * are required — a goods receipt missing a required field cannot be sent for approval.' },
  taoOMoi: { vi: '+ Tạo ô mới', en: '+ New field' },
  tenOSao: { vi: 'Tên ô *', en: 'Field name *' },
  tenOVd: { vi: 'Nhiệt độ khi nhận (°C)', en: 'Temperature on arrival (°C)' },
  dungCho: { vi: 'Dùng cho', en: 'Used for' },
  kieuDuLieu: { vi: 'Kiểu dữ liệu', en: 'Data type' },
  kieuGoiY: { vi: 'Không đổi được sau khi tạo.', en: 'Cannot be changed after it is created.' },
  luaChonChon: { vi: 'Các lựa chọn (chỉ cho kiểu "Chọn trong danh sách")', en: 'Options (only for "Pick from a list")' },
  moiDong: { vi: 'Mỗi dòng một lựa chọn.', en: 'One option per line.' },
  goiYDuoiTen: { vi: 'Gợi ý hiện dưới tên ô', en: 'Hint shown under the field name' },
  batBuocDien: { vi: 'Bắt buộc điền', en: 'Required' },
  thuTu: { vi: 'Thứ tự', en: 'Order' },
  taoO: { vi: 'Tạo ô', en: 'Create field' },
  chiChu: { vi: 'Chỉ chủ nhà hàng tạo và sửa được ô thông tin. Dưới đây là các ô đang có.',
            en: 'Only the owner can create and edit custom fields. These are the fields there are now.' },
  chuaCo: { vi: 'Chưa có ô thêm nào.', en: 'No custom fields yet.' },
  kieuLa: { vi: 'Kiểu: ', en: 'Type: ' },
  tenMay: { vi: ' · tên máy ', en: ' · system key ' },
  khongDoi: { vi: ' (không đổi được)', en: ' (cannot be changed)' },
  tenO: { vi: 'Tên ô', en: 'Field name' },
  cacLuaChon: { vi: 'Các lựa chọn', en: 'Options' },
  goiY: { vi: 'Gợi ý', en: 'Hint' },
  batBuoc: { vi: 'Bắt buộc', en: 'Required' },
  tinhTrang: { vi: 'Tình trạng', en: 'Status' },
  dangDung: { vi: 'Đang dùng', en: 'In use' },
  tat: { vi: 'Tắt (giữ dữ liệu cũ)', en: 'Off (keeps old data)' },
  luu: { vi: 'Lưu', en: 'Save' },
  dong: { vi: 'Đóng', en: 'Close' },
  suaO: { vi: 'Sửa', en: 'Edit' },
  daTat: { vi: ' · đã tắt', en: ' · turned off' },
});

let dinhNghia: DinhNghiaTruong[] = [];
let loiDoc = k.loiDoc;
try { dinhNghia = await docDinhNghia(k.client); }
catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }

let bao: KetQua | null = k.bao;
let nhapLai: FormData | null = null;
const form = await docFormGui(Astro);
if (form) {
  const kq = await luuDinhNghia(k.client, form, dinhNghia);
  if (kq.ok) return chuyenHuong(Astro, '/noi-bo/kho/cai-dat/o-thong-tin', kq);
  bao = kq;
  nhapLai = form;
}
const g = (ten: string) => (nhapLai && !nhapLai.get('id') ? String(nhapLai.get(ten) ?? '') : '');
const suaId = Astro.url.searchParams.get('sua') ?? '';
const DOI_TUONG = ['mat_hang', 'nha_cung_cap', 'phieu_nhap', 'lo_hang'] as const;
---
<Kho k={k} huongDan="o-thong-tin" tieuDe={t.tieuDe}>
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/cai-dat">{t.veThietLap}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <p class="nb-dan">
    {t.gt1}<em>{t.vd1}</em>{t.gt2}<em>{t.vd2}</em>{t.gt3}<em>{t.vd3}</em>{t.gt4}
  </p>

  {sua ? (
    <details class="nb-the" open={dinhNghia.length === 0 || (!!nhapLai && !nhapLai.get('id'))}>
      <summary style="cursor:pointer;font-weight:700">{t.taoOMoi}</summary>
      <form method="POST" style="margin-top:1rem">
        <div class="kho-luoi">
          <label class="nb-o"><span>{t.tenOSao}</span>
            <input type="text" name="nhan" required maxlength="80" value={g('nhan')} placeholder={t.tenOVd} /></label>
          <label class="nb-o"><span>{t.dungCho}</span>
            <select name="doi_tuong">
              {DOI_TUONG.map(d => <option value={d} selected={g('doi_tuong') === d}>{nhanKho(TEN_DOI_TUONG_TRUONG_NB, d, nn)}</option>)}
            </select></label>
          <label class="nb-o"><span>{t.kieuDuLieu}</span>
            <small>{t.kieuGoiY}</small>
            <select name="kieu">
              {Object.entries(TEN_KIEU_TRUONG_NB).map(([v, ten]) => <option value={v} selected={g('kieu') === v}>{ten[nn]}</option>)}
            </select></label>
        </div>
        <label class="nb-o"><span>{t.luaChonChon}</span>
          <small>{t.moiDong}</small>
          <textarea name="lua_chon" rows="3">{g('lua_chon')}</textarea></label>
        <label class="nb-o"><span>{t.goiYDuoiTen}</span>
          <input type="text" name="goi_y" maxlength="200" value={g('goi_y')} /></label>
        <div class="kho-luoi">
          <label class="kho-tich"><input type="checkbox" name="bat_buoc" value="co" checked={g('bat_buoc') === 'co'} /> {t.batBuocDien}</label>
          <label class="nb-o"><span>{t.thuTu}</span><input type="text" inputmode="numeric" name="thu_tu" value={g('thu_tu') || '10'} /></label>
        </div>
        <button type="submit" class="nb-nut">{t.taoO}</button>
      </form>
    </details>
  ) : (
    <div class="nb-bao luu-y"><p>{t.chiChu}</p></div>
  )}

  {DOI_TUONG.map(dt => {
    const ds = dinhNghia.filter(d => d.doi_tuong === dt);
    return (
      <>
        <h2>{nhanKho(TEN_DOI_TUONG_TRUONG_NB, dt, nn)}</h2>
        {ds.length === 0 ? <p class="kho-phu">{t.chuaCo}</p> : ds.map(d => (
          suaId === d.id && sua ? (
            <form method="POST" class="nb-the">
              <input type="hidden" name="id" value={d.id} />
              <p class="kho-phu" style="margin-top:0">{t.kieuLa}{nhanKho(TEN_KIEU_TRUONG_NB, d.kieu, nn)}{t.tenMay}<code>{d.khoa}</code>{t.khongDoi}</p>
              <label class="nb-o"><span>{t.tenO}</span><input type="text" name="nhan" required maxlength="80" value={d.nhan} /></label>
              {d.kieu === 'chon' && (
                <label class="nb-o"><span>{t.cacLuaChon}</span><small>{t.moiDong}</small>
                  <textarea name="lua_chon" rows="4">{d.lua_chon.join('\n')}</textarea></label>
              )}
              <label class="nb-o"><span>{t.goiY}</span><input type="text" name="goi_y" maxlength="200" value={d.goi_y ?? ''} /></label>
              <div class="kho-luoi">
                <label class="kho-tich"><input type="checkbox" name="bat_buoc" value="co" checked={d.bat_buoc} /> {t.batBuoc}</label>
                <label class="nb-o"><span>{t.thuTu}</span><input type="text" inputmode="numeric" name="thu_tu" value={String(d.thu_tu)} /></label>
                <label class="nb-o"><span>{t.tinhTrang}</span>
                  <select name="dang_dung"><option value="co" selected={d.dang_dung}>{t.dangDung}</option><option value="khong" selected={!d.dang_dung}>{t.tat}</option></select></label>
              </div>
              <button type="submit" class="nb-nut">{t.luu}</button>
              <a href="/noi-bo/kho/cai-dat/o-thong-tin" style="margin-left:1rem">{t.dong}</a>
            </form>
          ) : (
            <div class="nb-dong" style={d.dang_dung ? '' : 'opacity:.55'}>
              <div class="nb-dong-dau">
                <strong>{d.nhan}{d.bat_buoc && ' *'}</strong>
                {sua && <a href={`/noi-bo/kho/cai-dat/o-thong-tin?sua=${d.id}`}>{t.suaO}</a>}
              </div>
              <p class="kho-phu" style="margin:.3rem 0 0">
                {nhanKho(TEN_KIEU_TRUONG_NB, d.kieu, nn)}{d.kieu === 'chon' && `: ${d.lua_chon.join(', ')}`}{!d.dang_dung && t.daTat}
              </p>
            </div>
          )
        ))}
      </>
    );
  })}
</Kho>
