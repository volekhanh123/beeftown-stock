---
/**
 * KHO — CÀI ĐẶT · Ô THÔNG TIN THÊM
 *
 * Chủ nhà hàng tự tạo ô mới cho form mà không cần lập trình viên: "Xuất xứ"
 * cho mặt hàng, "Nhiệt độ khi nhận" cho từng lô, "Số tờ khai" cho phiếu nhập…
 *
 * Tên máy (khoa) sinh tự động từ tên ô và KHÔNG đổi được; kiểu dữ liệu cũng
 * không đổi được — dữ liệu cũ đã lưu theo chúng. Muốn đổi thì tắt ô cũ, tạo ô
 * mới: giá trị cũ vẫn hiện, chỉ đọc.
 *
 * Chỉ chủ nhà hàng tạo/sửa được (database chặn — policy kho_truong_them_them).
 * Quản lý xem được danh sách để biết form đang hỏi gì.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docDinhNghia, luuDinhNghia } from '../../../../lib/kho/danh-muc.ts';
import { cauLoiKho, TEN_DOI_TUONG_TRUONG, TEN_KIEU_TRUONG, type KetQua } from '../../../../lib/kho/chung.ts';
import type { DinhNghiaTruong } from '../../../../lib/kho/truong-them.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc') && !k.duoc('cai_dat_goc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);
const sua = k.duoc('cai_dat_goc');

let dinhNghia: DinhNghiaTruong[] = [];
let loiDoc = k.loiDoc;
try { dinhNghia = await docDinhNghia(k.client); }
catch (e) { loiDoc = cauLoiKho(e, 'Không đọc được ô thông tin.'); }

let bao: KetQua | null = k.bao;
let nhapLai: FormData | null = null;
const form = await docFormGui(Astro);
if (form) {
  const kq = await luuDinhNghia(k.client, form, dinhNghia);
  if (kq.ok) return chuyenHuong(Astro, '/noi-bo/kho/cai-dat/o-thong-tin', kq);
  bao = kq;
  nhapLai = form;
}
const g = (ten: string) => (nhapLai && !nhapLai.get('id') ? String(nhapLai.get(ten) ?? '') : '');
const suaId = Astro.url.searchParams.get('sua') ?? '';
const DOI_TUONG = ['mat_hang', 'nha_cung_cap', 'phieu_nhap', 'lo_hang'] as const;
---
<Kho k={k} tieuDe="Ô thông tin thêm">
  <h1>Ô thông tin thêm</h1>
  <p><a href="/noi-bo/kho/cai-dat">← Thiết lập kho</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <p class="nb-dan">
    Tự thêm ô vào form mà không cần sửa phần mềm. Ví dụ: <em>Xuất xứ</em> (chọn Úc / Mỹ / Nhật)
    cho mặt hàng, <em>Nhiệt độ khi nhận</em> (số) cho từng lô hàng nhập, <em>Số tờ khai hải quan</em>
    cho phiếu nhập. Ô có dấu * là bắt buộc — phiếu nhập thiếu ô bắt buộc thì không gửi duyệt được.
  </p>

  {sua ? (
    <details class="nb-the" open={dinhNghia.length === 0 || (!!nhapLai && !nhapLai.get('id'))}>
      <summary style="cursor:pointer;font-weight:700">+ Tạo ô mới</summary>
      <form method="POST" style="margin-top:1rem">
        <div class="kho-luoi">
          <label class="nb-o"><span>Tên ô *</span>
            <input type="text" name="nhan" required maxlength="80" value={g('nhan')} placeholder="Nhiệt độ khi nhận (°C)" /></label>
          <label class="nb-o"><span>Dùng cho</span>
            <select name="doi_tuong">
              {DOI_TUONG.map(d => <option value={d} selected={g('doi_tuong') === d}>{TEN_DOI_TUONG_TRUONG[d]}</option>)}
            </select></label>
          <label class="nb-o"><span>Kiểu dữ liệu</span>
            <small>Không đổi được sau khi tạo.</small>
            <select name="kieu">
              {Object.entries(TEN_KIEU_TRUONG).map(([v, t]) => <option value={v} selected={g('kieu') === v}>{t}</option>)}
            </select></label>
        </div>
        <label class="nb-o"><span>Các lựa chọn (chỉ cho kiểu "Chọn trong danh sách")</span>
          <small>Mỗi dòng một lựa chọn.</small>
          <textarea name="lua_chon" rows="3">{g('lua_chon')}</textarea></label>
        <label class="nb-o"><span>Gợi ý hiện dưới tên ô</span>
          <input type="text" name="goi_y" maxlength="200" value={g('goi_y')} /></label>
        <div class="kho-luoi">
          <label class="kho-tich"><input type="checkbox" name="bat_buoc" value="co" checked={g('bat_buoc') === 'co'} /> Bắt buộc điền</label>
          <label class="nb-o"><span>Thứ tự</span><input type="text" inputmode="numeric" name="thu_tu" value={g('thu_tu') || '10'} /></label>
        </div>
        <button type="submit" class="nb-nut">Tạo ô</button>
      </form>
    </details>
  ) : (
    <div class="nb-bao luu-y"><p>Chỉ chủ nhà hàng tạo và sửa được ô thông tin. Dưới đây là các ô đang có.</p></div>
  )}

  {DOI_TUONG.map(dt => {
    const ds = dinhNghia.filter(d => d.doi_tuong === dt);
    return (
      <>
        <h2>{TEN_DOI_TUONG_TRUONG[dt]}</h2>
        {ds.length === 0 ? <p class="kho-phu">Chưa có ô thêm nào.</p> : ds.map(d => (
          suaId === d.id && sua ? (
            <form method="POST" class="nb-the">
              <input type="hidden" name="id" value={d.id} />
              <p class="kho-phu" style="margin-top:0">Kiểu: {TEN_KIEU_TRUONG[d.kieu]} · tên máy <code>{d.khoa}</code> (không đổi được)</p>
              <label class="nb-o"><span>Tên ô</span><input type="text" name="nhan" required maxlength="80" value={d.nhan} /></label>
              {d.kieu === 'chon' && (
                <label class="nb-o"><span>Các lựa chọn</span><small>Mỗi dòng một lựa chọn.</small>
                  <textarea name="lua_chon" rows="4">{d.lua_chon.join('\n')}</textarea></label>
              )}
              <label class="nb-o"><span>Gợi ý</span><input type="text" name="goi_y" maxlength="200" value={d.goi_y ?? ''} /></label>
              <div class="kho-luoi">
                <label class="kho-tich"><input type="checkbox" name="bat_buoc" value="co" checked={d.bat_buoc} /> Bắt buộc</label>
                <label class="nb-o"><span>Thứ tự</span><input type="text" inputmode="numeric" name="thu_tu" value={String(d.thu_tu)} /></label>
                <label class="nb-o"><span>Tình trạng</span>
                  <select name="dang_dung"><option value="co" selected={d.dang_dung}>Đang dùng</option><option value="khong" selected={!d.dang_dung}>Tắt (giữ dữ liệu cũ)</option></select></label>
              </div>
              <button type="submit" class="nb-nut">Lưu</button>
              <a href="/noi-bo/kho/cai-dat/o-thong-tin" style="margin-left:1rem">Đóng</a>
            </form>
          ) : (
            <div class="nb-dong" style={d.dang_dung ? '' : 'opacity:.55'}>
              <div class="nb-dong-dau">
                <strong>{d.nhan}{d.bat_buoc && ' *'}</strong>
                {sua && <a href={`/noi-bo/kho/cai-dat/o-thong-tin?sua=${d.id}`}>Sửa</a>}
              </div>
              <p class="kho-phu" style="margin:.3rem 0 0">
                {TEN_KIEU_TRUONG[d.kieu]}{d.kieu === 'chon' && `: ${d.lua_chon.join(', ')}`}{!d.dang_dung && ' · đã tắt'}
              </p>
            </div>
          )
        ))}
      </>
    );
  })}
</Kho>
