---
/**
 * KHO — SỬA NHANH NHIỀU MẶT HÀNG (GĐ8c, migration 0041)
 *
 * Bảng mọi món (lọc loại / nhóm / tìm — trên URL), mỗi ô là một input, một nút
 * "Lưu tất cả" (form POST, không JavaScript). Chỉ dòng có ô đổi được gửi (so
 * với ô ẩn cu_<ô>_<id>); mỗi dòng mang phiên bản (updated_at lúc mở trang).
 * Database (kho_sua_nhanh_mat_hang) lưu TẤT CẢ HOẶC KHÔNG: một ô sai là không
 * lưu dòng nào, chữ đỏ hiện ngay tại dòng / ô đó, chữ đã gõ ở mọi dòng giữ
 * nguyên để sửa tiếp. Dòng bị "người khác vừa sửa" hiện lại số mới.
 *
 * Ô để trống = giữ giá trị cũ; gõ "-" để xóa hẳn ô đó. Giá vốn không sửa ở đây.
 * Điện thoại: bảng cuộn ngang, cột tên món dính bên trái.
 */
import Kho from '../../../../../layouts/Kho.astro';
import BaoKho from '../../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../../lib/kho/trang.ts';
import {
  CHU_XOA, O_SUA_NHANH, docFormSuaNhanh, docMonSuaNhanh, giaTriO, laLoiPhienBan, locMonSuaNhanh, loiTheoMon, suaNhanhMatHang,
  type MonSuaNhanh, type OSuaNhanh, type LoiDongSuaNhanh,
} from '../../../../../lib/kho/sua-nhanh.ts';
import { boDau, cauLoiKho, TEN_LOAI_MAT_HANG, type KetQua } from '../../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);

const q = Astro.url.searchParams;
const loc = { loai: q.get('loai') ?? '', nhom: q.get('nhom') ?? '', tim: (q.get('tim') ?? '').trim() };
const duongNay = `/noi-bo/kho/cai-dat/mat-hang/sua-nhanh${Astro.url.search}`;

let bao: KetQua | null = k.bao;
let loi: LoiDongSuaNhanh[] = [];
let chuGo = new Map<string, Partial<Record<OSuaNhanh, string>>>();
const form = await docFormGui(Astro);
if (form) {
  if (!k.chiNhanh) {
    bao = { ok: false, cau: 'Chưa chọn được chi nhánh — tải lại trang.' };
  } else {
    const doc = docFormSuaNhanh(form);
    const kq = await suaNhanhMatHang(k.client, k.chiNhanh.id, doc.dong);
    if (kq.ok) {
      return chuyenHuong(Astro, duongNay, {
        ok: true,
        cau: kq.soLuu > 0 ? `Đã lưu ${kq.soLuu} món.` : kq.cau,
      });
    }
    bao = { ok: false, cau: kq.cau };
    loi = kq.loi;
    chuGo = doc.chuGo;
    // Dòng "người khác vừa sửa": bỏ chữ đã gõ, hiện số mới trong database.
    for (const l of loi) if (l.id && laLoiPhienBan(l)) chuGo.delete(l.id);
  }
}

let mon: MonSuaNhanh[] = [];
let loiDoc = k.loiDoc;
try { mon = await docMonSuaNhanh(k.client); } catch (e) { loiDoc = cauLoiKho(e, 'Không đọc được danh mục.'); }

const ds = locMonSuaNhanh(mon, loc, boDau);
const cacNhom = [...new Set(mon.map(m => m.nhom).filter((x): x is string => !!x))].sort((a, b) => a.localeCompare(b, 'vi'));
const coChuaNhom = mon.some(m => !m.nhom);
const loiMon = loiTheoMon(loi);
const loiKhongDong = loi.filter(l => !l.id || !ds.some(m => m.id === l.id));
const linkLoc = (thay: Record<string, string>) => {
  const p = new URLSearchParams({ ...loc, ...thay });
  for (const [kk, v] of [...p]) if (!v) p.delete(kk);
  const s = p.toString();
  return `/noi-bo/kho/cai-dat/mat-hang/sua-nhanh${s ? `?${s}` : ''}`;
};
const oCua = (m: MonSuaNhanh, khoa: OSuaNhanh) => chuGo.get(m.id)?.[khoa] ?? giaTriO(m, khoa);
const coO = (m: MonSuaNhanh, khoa: OSuaNhanh) => !(khoa === 'noi_de_sau_pha' && m.loai === 'tang');
const kieuNhap = (khoa: OSuaNhanh) => (khoa === 'ma_can' || khoa.endsWith('_goi') || khoa === 'han_dung_ngay' || khoa === 'gia_ban_kg' ? 'numeric' : 'decimal');
---
<Kho k={k} huongDan="sua-nhanh" tieuDe="Sửa nhanh mặt hàng" rong>
  <h1>Sửa nhanh mặt hàng</h1>
  <p><a href="/noi-bo/kho/cai-dat/mat-hang">← Mặt hàng</a> · <a href="/noi-bo/kho/cai-dat">Thiết lập kho</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  {loiKhongDong.length > 0 && (
    <div class="nb-bao loi" role="alert"><ul style="margin:0;padding-left:1.1rem">{loiKhongDong.map(l => <li>{l.cau}</li>)}</ul></div>
  )}

  <div class="nb-dan" style="font-size:.9rem">
    <p style="margin-top:0">Sửa thẳng trong bảng rồi bấm <strong>Lưu tất cả</strong> — chỉ những món có ô đổi mới được lưu.
      <strong>Ô để trống = giữ nguyên.</strong> Muốn xóa hẳn một ô (vd bỏ mã cân) thì gõ dấu <strong>{CHU_XOA}</strong>.</p>
    <p style="margin-bottom:0">Có một ô sai là chưa lưu món nào: chữ đỏ hiện ngay dưới món đó, sửa rồi bấm lại.
      Giá vốn không sửa ở đây. Thêm món mới, đổi tên, đổi loại: dùng trang <a href="/noi-bo/kho/cai-dat/mat-hang">Mặt hàng</a>.</p>
  </div>

  <nav class="kho-dh" aria-label="Lọc theo loại">
    {[['', 'Tất cả'], ['tang', 'Tảng'], ['phan_cat', 'Phần cắt'], ['phu_pham', 'Phụ phẩm']].map(([v, t]) => (
      <a href={linkLoc({ loai: v })} aria-current={loc.loai === v ? 'page' : undefined}>{t}</a>
    ))}
  </nav>
  {(cacNhom.length > 0) && (
    <nav class="kho-dh" aria-label="Lọc theo nhóm">
      <a href={linkLoc({ nhom: '' })} aria-current={!loc.nhom ? 'page' : undefined}>Mọi nhóm</a>
      {cacNhom.map(n => <a href={linkLoc({ nhom: n })} aria-current={loc.nhom === n ? 'page' : undefined}>{n}</a>)}
      {coChuaNhom && <a href={linkLoc({ nhom: '(chưa có)' })} aria-current={loc.nhom === '(chưa có)' ? 'page' : undefined}>Chưa có nhóm</a>}
    </nav>
  )}
  <form method="GET" style="display:flex;gap:.5rem;margin-bottom:1rem">
    {loc.loai && <input type="hidden" name="loai" value={loc.loai} />}
    {loc.nhom && <input type="hidden" name="nhom" value={loc.nhom} />}
    <label class="nb-o" style="flex:1;margin:0"><input type="search" name="tim" value={loc.tim} placeholder="Tìm tên, mã, mã cân…" aria-label="Tìm" /></label>
    <button type="submit" class="nb-nut phu">Tìm</button>
  </form>

  {ds.length === 0 ? (
    <p class="nb-rong">{mon.length === 0 ? <>Chưa có mặt hàng nào — thêm ở <a href="/noi-bo/kho/cai-dat/mat-hang">Mặt hàng</a>.</> : 'Không có món nào khớp bộ lọc.'}</p>
  ) : (
    <form method="POST">
      <p class="kho-phu">{ds.length} món{ds.length < mon.length ? ` (trong ${mon.length})` : ''}. Kéo ngang để xem hết các cột.</p>
      <div class="sn-khung">
        <table class="kho-bang sn-bang">
          <thead>
            <tr>
              <th scope="col" class="sn-ten">Món</th>
              {O_SUA_NHANH.map(o => <th scope="col">{o.ten}</th>)}
            </tr>
          </thead>
          <tbody>
            {ds.map(m => {
              const l = loiMon.get(m.id);
              return (
                <>
                  <tr class:list={[{ 'sn-dong-loi': !!l, 'sn-tat': !m.dang_dung }]} id={`m-${m.id}`}>
                    <th scope="row" class="sn-ten">
                      <input type="hidden" name="id" value={m.id} />
                      <input type="hidden" name={`pb_${m.id}`} value={m.phien_ban} />
                      <strong>{m.ten}</strong>
                      <span class="kho-phu">{m.ma} · {TEN_LOAI_MAT_HANG[m.loai]}{m.nhom ? ` · ${m.nhom}` : ''}{!m.dem_goi ? ' · không đếm gói' : ''}</span>
                    </th>
                    {O_SUA_NHANH.map(o => {
                      const ten = `${o.khoa}_${m.id}`;
                      const sai = !!l?.o.has(o.khoa);
                      if (!coO(m, o.khoa)) return <td class="kho-phu">—</td>;
                      return (
                        <td>
                          <input type="hidden" name={`cu_${ten}`} value={giaTriO(m, o.khoa)} />
                          {o.kieu === 'noi_de' ? (
                            <select name={ten} aria-label={`${o.ten} — ${m.ten}`} class:list={{ 'sn-sai': sai }} aria-invalid={sai ? 'true' : undefined}>
                              <option value="kho" selected={oCua(m, o.khoa) !== 'quay'}>Kho lạnh</option>
                              <option value="quay" selected={oCua(m, o.khoa) === 'quay'}>Quầy</option>
                            </select>
                          ) : o.kieu === 'dang_dung' ? (
                            <select name={ten} aria-label={`${o.ten} — ${m.ten}`} class:list={{ 'sn-sai': sai }} aria-invalid={sai ? 'true' : undefined}>
                              <option value="co" selected={oCua(m, o.khoa) !== 'khong'}>Đang dùng</option>
                              <option value="khong" selected={oCua(m, o.khoa) === 'khong'}>Ngưng dùng</option>
                            </select>
                          ) : (
                            <input type="text" name={ten} value={oCua(m, o.khoa)} inputmode={kieuNhap(o.khoa)}
                              aria-label={`${o.ten} — ${m.ten}`} class:list={{ 'sn-sai': sai }} aria-invalid={sai ? 'true' : undefined}
                              autocomplete="off" />
                          )}
                        </td>
                      );
                    })}
                  </tr>
                  {l && (
                    <tr class="sn-dong-loi sn-cau">
                      <td colspan={O_SUA_NHANH.length + 1}>
                        <ul>{l.cau.map(c => <li>{c}</li>)}</ul>
                      </td>
                    </tr>
                  )}
                </>
              );
            })}
          </tbody>
        </table>
      </div>
      <div class="kho-thanh-nut dinh">
        <button type="submit" class="nb-nut">Lưu tất cả</button>
        <a class="nb-nut phu" href={linkLoc({})}>Bỏ các ô vừa gõ</a>
      </div>
    </form>
  )}
</Kho>

<style>
  /* Cuộn ngang trong khung; cột tên món dính bên trái để biết đang sửa món nào. */
  .sn-khung { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--kho-vach, #EFE4D2); border-radius: 10px; background: #fff; }
  .sn-bang { margin: 0; min-width: 1100px; border-collapse: separate; border-spacing: 0; }
  .sn-bang th, .sn-bang td { vertical-align: top; padding: .4rem .35rem; }
  .sn-bang thead th { font-size: .78rem; line-height: 1.2; white-space: normal; min-width: 6.5rem; }
  .sn-ten { position: sticky; left: 0; z-index: 1; background: #fff; text-align: left; min-width: 10rem; max-width: 14rem;
    box-shadow: 1px 0 0 var(--kho-vach, #EFE4D2); }
  .sn-ten strong { display: block; }
  .sn-ten .kho-phu { display: block; font-weight: 400; font-size: .75rem; }
  .sn-bang input[type="text"], .sn-bang select { width: 100%; min-width: 5.5rem; font-size: 16px; min-height: 44px;
    padding: .35rem .45rem; border: 1px solid var(--kho-vach-dam, #E0D2BB); border-radius: 8px; background: #fff; }
  .sn-bang .sn-sai { border: 2px solid var(--do); background: var(--kho-do-nen, #FDECEA); }
  .sn-tat td, .sn-tat .sn-ten strong { opacity: .6; }
  .sn-dong-loi .sn-ten { background: var(--kho-do-nen, #FDECEA); }
  .sn-cau td { background: var(--kho-do-nen, #FDECEA); color: var(--do); font-size: .88rem; }
  .sn-cau ul { margin: 0; padding-left: 1.1rem; }
  /* Dòng câu lỗi: chữ bám mép trái của khung khi cuộn ngang. */
  .sn-cau td ul { position: sticky; left: .5rem; max-width: 90vw; }
</style>
