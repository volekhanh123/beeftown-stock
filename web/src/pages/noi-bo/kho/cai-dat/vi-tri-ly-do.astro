---
/**
 * KHO — CÀI ĐẶT · VỊ TRÍ VÀ LÝ DO (một trang, một form — GĐ8c)
 *
 * Vị trí thuộc từng chi nhánh (kho lạnh, tủ mát, quầy thịt). Vị trí "Hàng chờ
 * hủy" và "Đang mang ra quầy" (0032) do hệ thống tạo — đổi tên được, không
 * tắt được, không đổi loại được.
 * Lý do dùng chung toàn thương hiệu; "bắt buộc ảnh" nghĩa là báo hủy với lý
 * do này phải chụp ít nhất một ảnh. Lý do Xuất bếp có ô "Tính vào định mức
 * bếp" (0044): bỏ tích thì phiếu xuất bếp lý do đó không cộng vào "bếp nhận"
 * ở báo cáo định mức (mặc định Cơm nhân viên không tính).
 *
 * GĐ8c: mọi dòng của hai bảng + vài dòng trống để thêm nằm trong MỘT form, một
 * nút "Lưu tất cả" (lib/kho/sua-nhanh.ts: docFormViTriLyDo → luuViTriLyDo).
 * Chỉ dòng có đổi được ghi; kiểm hết trước khi ghi. `phien_ban` = chuỗi các dòng
 * lúc mở trang — người khác vừa sửa thì từ chối, không đè. Lỗi thì trang hiện
 * lại đúng chữ đã gõ.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docViTri, docLyDo, type ViTri, type LyDo } from '../../../../lib/kho/danh-muc.ts';
import {
  LOAI_LY_DO_NB, SO_DONG_THEM, docFormViTriLyDo, laViTriHeThong, luuViTriLyDo, phienBanViTriLyDo, tinhDinhMuc,
} from '../../../../lib/kho/sua-nhanh.ts';
import { cauLoiKho, kqHai, nhanKho, TEN_LOAI_VI_TRI_NB, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);
const nn = k.nn;
const t = dichNB(nn, {
  tieuDe: { vi: 'Vị trí và lý do', en: 'Locations and reasons' },
  veThietLap: { vi: '← Thiết lập kho', en: '← Inventory setup' },
  khongDoc: { vi: 'Không đọc được vị trí và lý do.', en: 'Could not read the locations and reasons.' },
  gt1: { vi: 'Sửa thẳng trong các bảng, điền dòng trống để thêm mới, rồi bấm ', en: 'Edit directly in the tables, fill in the empty rows to add new ones, then press ' },
  luuTatCa: { vi: 'Lưu tất cả', en: 'Save all' },
  gt2: { vi: ' một lần.', en: ' once.' },
  gt3: { vi: 'Muốn bỏ một vị trí hay lý do thì chọn ', en: 'To stop using a location or reason, choose ' },
  ngungDung: { vi: 'Ngừng dùng', en: 'No longer used' },
  gt4: { vi: ' (không xóa — phiếu cũ vẫn cần tên).', en: ' (nothing is deleted — old documents still need the name).' },
  viTriDeHang: { vi: 'Vị trí để hàng', en: 'Storage locations' },
  chuaCoViTri: { vi: 'Chưa có vị trí nào — bấm "Bắt đầu dùng kho" ở Tổng quan kho.',
                 en: 'No locations yet — press "Start using inventory" on the inventory home page.' },
  cotTen: { vi: 'Tên', en: 'Name' },
  cotLoai: { vi: 'Loại', en: 'Type' },
  cotThuTu: { vi: 'Thứ tự', en: 'Order' },
  cotTinhTrang: { vi: 'Tình trạng', en: 'Status' },
  ariaTenViTri: { vi: (ten: string) => `Tên vị trí ${ten}`, en: (ten: string) => `Location name ${ten}` },
  heThong: { vi: '(hệ thống)', en: '(system)' },
  ariaLoaiViTri: { vi: (ten: string) => `Loại vị trí ${ten}`, en: (ten: string) => `Location type ${ten}` },
  kho: { vi: 'Kho', en: 'Store' },
  quay: { vi: 'Quầy', en: 'Counter' },
  ariaThuTu: { vi: (ten: string) => `Thứ tự ${ten}`, en: (ten: string) => `Order ${ten}` },
  luonDung: { vi: 'Luôn dùng', en: 'Always in use' },
  ariaTinhTrang: { vi: (ten: string) => `Tình trạng ${ten}`, en: (ten: string) => `Status ${ten}` },
  dangDung: { vi: 'Đang dùng', en: 'In use' },
  viTriMoiVd: { vi: '+ Vị trí mới, vd Tủ mát số 2', en: '+ New location, e.g. Chiller 2' },
  viTriMoi: { vi: '+ Vị trí mới', en: '+ New location' },
  ariaTenViTriMoi: { vi: (n: number) => `Tên vị trí mới ${n}`, en: (n: number) => `New location name ${n}` },
  ariaLoaiViTriMoi: { vi: (n: number) => `Loại vị trí mới ${n}`, en: (n: number) => `New location type ${n}` },
  ariaThuTuViTriMoi: { vi: (n: number) => `Thứ tự vị trí mới ${n}`, en: (n: number) => `New location order ${n}` },
  moi: { vi: 'Mới', en: 'New' },
  boTich: { vi: 'Bỏ tích ', en: 'Untick ' },
  tinhDinhMuc: { vi: 'Tính vào định mức bếp', en: 'Count in kitchen usage' },
  xuatBepGoiY: { vi: ' với phần bếp lấy không để nấu món bán (vd Cơm nhân viên): kho vẫn trừ đủ số kg, nhưng báo cáo Định mức bếp không cộng phần này nên không báo lệch oan.',
                 en: ' for what the kitchen takes that is not for dishes on sale (e.g. staff meals): stock still goes down by the full kg, but the Kitchen usage report leaves it out, so it does not show a false variance.' },
  cotLyDo: { vi: 'Lý do', en: 'Reason' },
  batBuocAnh: { vi: 'Bắt buộc ảnh', en: 'Photo required' },
  dinhMucBep: { vi: 'Định mức bếp', en: 'Kitchen usage' },
  ariaLyDo: { vi: (ten: string) => `Lý do ${ten}`, en: (ten: string) => `Reason ${ten}` },
  phaiChupAnh: { vi: 'Phải chụp ảnh', en: 'Photo required' },
  lyDoMoi: { vi: '+ Lý do mới', en: '+ New reason' },
  ariaLyDoMoi: { vi: (loai: string, n: number) => `${loai} mới ${n}`, en: (loai: string, n: number) => `${loai}, new row ${n}` },
  boOVuaGo: { vi: 'Bỏ các ô vừa gõ', en: 'Discard what I typed' },
});

let viTri: ViTri[] = [];
let lyDo: LyDo[] = [];
let loiDoc = k.loiDoc;
const doc = async () => {
  if (!k.chiNhanh) return;
  try {
    [viTri, lyDo] = await Promise.all([docViTri(k.client, k.chiNhanh.id), docLyDo(k.client)]);
    loiDoc = k.loiDoc;
  } catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }
};
await doc();

let bao: KetQua | null = k.bao;
/** Chữ đã gõ khi lỗi — hiện lại đúng như vậy. */
let go: FormData | null = null;
const form = await docFormGui(Astro);
if (form && k.chiNhanh) {
  let kq: KetQua;
  if (loiDoc) {
    kq = kqHai(false, { vi: 'Chưa đọc được dữ liệu hiện tại — tải lại trang rồi lưu lại.',
                        en: 'Could not read the current data — reload the page and save again.' });
  } else if (String(form.get('phien_ban') ?? '') !== phienBanViTriLyDo(viTri, lyDo)) {
    kq = kqHai(false, { vi: 'Vị trí / lý do vừa được người khác sửa — trang đã hiện số mới, gõ lại phần của bạn rồi bấm Lưu tất cả.',
                        en: 'Someone else just changed the locations / reasons — the page now shows the new values; type your changes again and press Save all.' });
  } else {
    const luu = await luuViTriLyDo(k.client, k.chiNhanh.id, docFormViTriLyDo(form, viTri, lyDo));
    kq = luu;
    if (!luu.ok) {
      go = form;
      // Dòng mới đã thêm được: xóa chữ ở ô tên để bấm Lưu lần nữa không thêm trùng.
      for (const ten of luu.oMoiDaLuu) go.set(ten, '');
    }
  }
  if (kq.ok) return chuyenHuong(Astro, '/noi-bo/kho/cai-dat/vi-tri-ly-do', kq);
  bao = kq;
  await doc();   // đã lưu được một phần thì hiện đúng số trong database
}

/** Giá trị một ô: chữ đã gõ (khi lỗi) hoặc số trong database. */
const o = (ten: string, macDinh: string) => (go && go.has(ten) ? String(go.get(ten) ?? '') : macDinh);
const tich = (ten: string, macDinh: boolean, coO: string) => (go && go.has(coO) ? go.get(ten) === 'co' : macDinh);
---
<Kho k={k} huongDan="vi-tri-ly-do" tieuDe={t.tieuDe} rong>
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/cai-dat">{t.veThietLap}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  <p class="nb-dan" style="font-size:.9rem">{t.gt1}<strong>{t.luuTatCa}</strong>{t.gt2} {t.gt3}<strong>{t.ngungDung}</strong>{t.gt4}</p>

  <form method="POST">
    <input type="hidden" name="phien_ban" value={phienBanViTriLyDo(viTri, lyDo)} />

    <h2>{t.viTriDeHang} — {k.chiNhanh?.ten}</h2>
    {viTri.length === 0 && <p class="nb-rong">{t.chuaCoViTri}</p>}
    <div class="kho-bang-khung">
      <table class="kho-bang vl-bang">
        <thead><tr><th>{t.cotTen}</th><th>{t.cotLoai}</th><th class="so">{t.cotThuTu}</th><th>{t.cotTinhTrang}</th></tr></thead>
        <tbody>
          {viTri.map(v => (
            <tr style={v.dang_dung ? undefined : 'opacity:.6'}>
              <td><input type="text" name={`vt_ten_${v.id}`} value={o(`vt_ten_${v.id}`, v.ten)} maxlength="60" aria-label={t.ariaTenViTri(v.ten)} /></td>
              <td>
                {laViTriHeThong(v)
                  ? <>{nhanKho(TEN_LOAI_VI_TRI_NB, v.loai, nn)} <span class="kho-phu">{t.heThong}</span></>
                  : <select name={`vt_loai_${v.id}`} aria-label={t.ariaLoaiViTri(v.ten)}>
                      <option value="kho" selected={o(`vt_loai_${v.id}`, v.loai) === 'kho'}>{t.kho}</option>
                      <option value="quay" selected={o(`vt_loai_${v.id}`, v.loai) === 'quay'}>{t.quay}</option>
                    </select>}
              </td>
              <td class="so"><input type="text" inputmode="numeric" name={`vt_thu_tu_${v.id}`} value={o(`vt_thu_tu_${v.id}`, String(v.thu_tu))} class="vl-so" aria-label={t.ariaThuTu(v.ten)} /></td>
              <td>
                {laViTriHeThong(v)
                  ? t.luonDung
                  : <select name={`vt_dang_dung_${v.id}`} aria-label={t.ariaTinhTrang(v.ten)}>
                      <option value="co" selected={o(`vt_dang_dung_${v.id}`, v.dang_dung ? 'co' : 'khong') === 'co'}>{t.dangDung}</option>
                      <option value="khong" selected={o(`vt_dang_dung_${v.id}`, v.dang_dung ? 'co' : 'khong') === 'khong'}>{t.ngungDung}</option>
                    </select>}
              </td>
            </tr>
          ))}
          {Array.from({ length: SO_DONG_THEM }, (_, i) => (
            <tr class="vl-moi">
              <td><input type="text" name={`vt_moi_ten_${i}`} value={o(`vt_moi_ten_${i}`, '')} maxlength="60" placeholder={i === 0 ? t.viTriMoiVd : t.viTriMoi} aria-label={t.ariaTenViTriMoi(i + 1)} /></td>
              <td>
                <select name={`vt_moi_loai_${i}`} aria-label={t.ariaLoaiViTriMoi(i + 1)}>
                  <option value="kho" selected={o(`vt_moi_loai_${i}`, 'kho') === 'kho'}>{t.kho}</option>
                  <option value="quay" selected={o(`vt_moi_loai_${i}`, 'kho') === 'quay'}>{t.quay}</option>
                </select>
              </td>
              <td class="so"><input type="text" inputmode="numeric" name={`vt_moi_thu_tu_${i}`} value={o(`vt_moi_thu_tu_${i}`, '5')} class="vl-so" aria-label={t.ariaThuTuViTriMoi(i + 1)} /></td>
              <td class="kho-phu">{t.moi}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {LOAI_LY_DO_NB.map(([loai, tenLoai]) => (
      <>
        <h2>{tenLoai[nn]}</h2>
        {loai === 'xuat_bep' && <p class="nb-dan" style="font-size:.9rem">{t.boTich}<strong>{t.tinhDinhMuc}</strong>{t.xuatBepGoiY}</p>}
        <div class="kho-bang-khung">
          <table class="kho-bang vl-bang">
            <thead><tr><th>{t.cotLyDo}</th><th class="so">{t.cotThuTu}</th><th>{t.cotTinhTrang}</th>{loai === 'huy' && <th>{t.batBuocAnh}</th>}{loai === 'xuat_bep' && <th>{t.dinhMucBep}</th>}</tr></thead>
            <tbody>
              {lyDo.filter(l => l.loai === loai).map(l => (
                <tr style={l.dang_dung ? undefined : 'opacity:.6'}>
                  <td><input type="text" name={`ld_ten_${l.id}`} value={o(`ld_ten_${l.id}`, l.ten)} maxlength="80" aria-label={t.ariaLyDo(l.ten)} /></td>
                  <td class="so"><input type="text" inputmode="numeric" name={`ld_thu_tu_${l.id}`} value={o(`ld_thu_tu_${l.id}`, String(l.thu_tu))} class="vl-so" aria-label={t.ariaThuTu(l.ten)} /></td>
                  <td>
                    <select name={`ld_dang_dung_${l.id}`} aria-label={t.ariaTinhTrang(l.ten)}>
                      <option value="co" selected={o(`ld_dang_dung_${l.id}`, l.dang_dung ? 'co' : 'khong') === 'co'}>{t.dangDung}</option>
                      <option value="khong" selected={o(`ld_dang_dung_${l.id}`, l.dang_dung ? 'co' : 'khong') === 'khong'}>{t.ngungDung}</option>
                    </select>
                  </td>
                  {loai === 'huy' && (
                    <td>
                      <input type="hidden" name={`ld_co_anh_${l.id}`} value="1" />
                      <label class="kho-tich" style="margin:0"><input type="checkbox" name={`ld_can_anh_${l.id}`} value="co" checked={tich(`ld_can_anh_${l.id}`, l.can_anh, `ld_co_anh_${l.id}`)} /> {t.phaiChupAnh}</label>
                    </td>
                  )}
                  {loai === 'xuat_bep' && (
                    <td>
                      <input type="hidden" name={`ld_co_dm_${l.id}`} value="1" />
                      <label class="kho-tich" style="margin:0"><input type="checkbox" name={`ld_tinh_dm_${l.id}`} value="co" checked={tich(`ld_tinh_dm_${l.id}`, tinhDinhMuc(l), `ld_co_dm_${l.id}`)} /> {t.tinhDinhMuc}</label>
                    </td>
                  )}
                </tr>
              ))}
              {Array.from({ length: SO_DONG_THEM }, (_, i) => (
                <tr class="vl-moi">
                  <td><input type="text" name={`ld_moi_ten_${loai}_${i}`} value={o(`ld_moi_ten_${loai}_${i}`, '')} maxlength="80" placeholder={t.lyDoMoi} aria-label={t.ariaLyDoMoi(tenLoai[nn], i + 1)} /></td>
                  <td class="kho-phu so">—</td>
                  <td class="kho-phu">{t.moi}</td>
                  {loai === 'huy' && (
                    <td><label class="kho-tich" style="margin:0"><input type="checkbox" name={`ld_moi_can_anh_${loai}_${i}`} value="co" checked={go ? go.get(`ld_moi_can_anh_${loai}_${i}`) === 'co' : true} /> {t.phaiChupAnh}</label></td>
                  )}
                  {loai === 'xuat_bep' && (
                    <td>
                      <input type="hidden" name={`ld_moi_co_dm_${loai}_${i}`} value="1" />
                      <label class="kho-tich" style="margin:0"><input type="checkbox" name={`ld_moi_tinh_dm_${loai}_${i}`} value="co" checked={go ? go.get(`ld_moi_tinh_dm_${loai}_${i}`) === 'co' : true} /> {t.tinhDinhMuc}</label>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))}

    <div class="kho-thanh-nut dinh">
      <button type="submit" class="nb-nut">{t.luuTatCa}</button>
      <a class="nb-nut phu" href="/noi-bo/kho/cai-dat/vi-tri-ly-do">{t.boOVuaGo}</a>
    </div>
  </form>
</Kho>

<style>
  .vl-bang input[type="text"], .vl-bang select { width: 100%; font-size: 16px; min-height: 44px; }
  .vl-bang td:first-child { min-width: 11rem; }
  .vl-bang .vl-so { max-width: 4.5rem; text-align: right; }
  .vl-moi td { background: var(--vang-nen); }
</style>
