---
/**
 * KHO — CÀI ĐẶT · CÔNG THỨC PHA LÓC MẪU
 *
 * "Tảng thăn ngoại thường ra: thăn cắt lát ~75%, thịt vụn ~8%, mỡ ~15%."
 * Công thức điền sẵn phiếu pha lóc và là mốc so tỉ lệ thu hồi thực tế. Không
 * bắt buộc — pha lóc vẫn ghi được khi chưa có công thức nào.
 *
 * GĐ8c: mỗi công thức một LƯỚI phần cắt × tỷ lệ % trong một form (lib/kho/
 * cong-thuc.ts): "Tính lại" cộng tổng chạy ở máy chủ (xanh 95–100%, vàng dưới,
 * đỏ vượt 100%), "Lưu công thức" thay toàn bộ phần ra (phien_ban chống ghi đè),
 * "Nhân bản công thức", "Gợi ý từ thực tế" (?goi_y=1 — tỷ lệ TB 30 ngày từ các
 * phiên pha đã chốt, chỉ kg, điền vào cột Gợi ý để chép).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docCongThuc, docMatHang, luuCongThuc, type CongThuc, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import {
  SO_DONG_TOI_DA, NGAY_GOI_Y, cauTong, chuTuCongThuc, docGoiYThucTe, docLuoiCongThuc, luuLuoiCongThuc, mauTong,
  nhanBanCongThuc, phienBanCongThuc, themDongTrong, tongChu, type ChuDongLuoi,
} from '../../../../lib/kho/cong-thuc.ts';
import { cauLoiKho, dinhDangKg, dinhDangPhanTram, homNayVn, TEN_XU_LY, type KetQua } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);

const q = Astro.url.searchParams;
const suaId = q.get('sua') ?? '';
const muonGoiY = q.get('goi_y') === '1';

let congThuc: CongThuc[] = [];
let matHang: MatHang[] = [];
let loiDoc = k.loiDoc;
try {
  [congThuc, matHang] = await Promise.all([docCongThuc(k.client), docMatHang(k.client)]);
} catch (e) { loiDoc = cauLoiKho(e, 'Không đọc được công thức.'); }

let bao: KetQua | null = k.bao;
/** Chữ đang gõ trong lưới (Tính lại / Thêm dòng / lỗi) — null = lấy từ database. */
let chuLuoi: ChuDongLuoi[] | null = null;
const form = await docFormGui(Astro);
if (form) {
  const viec = String(form.get('viec') ?? '');
  const id = String(form.get('cong_thuc_id') ?? form.get('id') ?? '');
  const ct = congThuc.find(c => c.id === id);
  let kq: (KetQua & { id?: string }) | null = null;
  if (viec === 'cong_thuc') {
    kq = await luuCongThuc(k.client, form);
  } else if (viec === 'tinh_lai' || viec === 'them_dong' || viec === 'luu_luoi') {
    const doc = docLuoiCongThuc(form);
    chuLuoi = viec === 'them_dong' ? themDongTrong(doc.chu) : doc.chu;
    if (viec === 'luu_luoi') {
      if (!ct) kq = { ok: false, cau: 'Không tìm thấy công thức này — tải lại trang.' };
      else if (doc.loi.length > 0) kq = { ok: false, cau: `Chưa lưu: ${doc.loi.join(' · ')}` };
      else kq = await luuLuoiCongThuc(k.client, ct, String(form.get('phien_ban') ?? ''), doc.dong);
    } else if (doc.loi.length > 0) {
      bao = { ok: false, cau: doc.loi.join(' · ') };
    }
  } else if (viec === 'nhan_ban') {
    kq = ct ? await nhanBanCongThuc(k.client, ct) : { ok: false, cau: 'Không tìm thấy công thức này — tải lại trang.' };
  } else {
    kq = { ok: false, cau: 'Việc không hợp lệ.' };
  }
  if (kq?.ok) {
    const ve = kq.id ?? id;
    return chuyenHuong(Astro, `/noi-bo/kho/cai-dat/cong-thuc${ve ? `?sua=${ve}` : ''}`, kq);
  }
  if (kq) bao = kq;
}

const tenMh = new Map(matHang.map(m => [m.id, m]));
const dangSua = congThuc.find(c => c.id === (form ? String(form.get('cong_thuc_id') ?? form.get('id') ?? '') || suaId : suaId));
const luoi: ChuDongLuoi[] = dangSua ? (chuLuoi ?? themDongTrong(chuTuCongThuc(dangSua))) : [];
const luoiDung = luoi.slice(0, SO_DONG_TOI_DA);
// Tổng chạy tính ở máy chủ từ chữ đang thấy trên lưới (dòng tích Bỏ / trống không tính).
const tongLuoi = tongChu(luoiDung);
const goiY = dangSua && muonGoiY && k.chiNhanh
  ? await docGoiYThucTe(k.client, k.chiNhanh.id, dangSua.mat_hang_vao_id, homNayVn())
  : null;
if (goiY?.loi) loiDoc = goiY.loi;
const tongTyLeCt = (c: CongThuc) => c.dong.reduce((s, d) => s + (d.ty_le_du_kien ?? 0), 0);
// Món có trong gợi ý mà lưới chưa có: nhắc bên dưới để thêm.
const goiYThieu = goiY ? [...goiY.tyLe].filter(([mh]) => !luoiDung.some(d => d.mh === mh)) : [];
---
<Kho k={k} huongDan="cong-thuc" tieuDe="Công thức pha lóc" rong>
  <h1>Công thức pha lóc</h1>
  <p><a href="/noi-bo/kho/cai-dat">← Thiết lập kho</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {dangSua && (
    <div class="nb-the">
      <h2 style="margin-top:0">{dangSua.ten}</h2>
      <p class="kho-phu">Đầu vào: <strong>{tenMh.get(dangSua.mat_hang_vao_id)?.ten ?? '—'}</strong>. Mỗi dòng một phần cắt ra và tỷ lệ % của kg tảng.
        Sửa xong bấm <strong>Tính lại</strong> để xem tổng, rồi <strong>Lưu công thức</strong>.</p>

      {goiY && !goiY.loi && (
        <p class="nb-dan" style="font-size:.9rem">
          {goiY.soPhien === 0
            ? `Chưa có phiên pha lóc nào đã chốt của loại tảng này trong ${NGAY_GOI_Y} ngày qua — chưa có gợi ý.`
            : <>Gợi ý từ <strong>{goiY.soPhien} phiên</strong> pha đã chốt trong {NGAY_GOI_Y} ngày ({dinhDangKg(goiY.kgVao)} kg tảng):
                cột <strong>Gợi ý</strong> là tỷ lệ thật trung bình. Chép sang ô Tỷ lệ nếu muốn dùng, rồi bấm Tính lại.</>}
        </p>
      )}

      <form method="POST" class="ct-form">
        <input type="hidden" name="cong_thuc_id" value={dangSua.id} />
        <input type="hidden" name="phien_ban" value={phienBanCongThuc(dangSua)} />
        <input type="hidden" name="so_dong" value={String(luoiDung.length)} />
        {/* Nút đầu form = nút của phím Enter: Tính lại (không lưu gì). */}
        <button type="submit" name="viec" value="tinh_lai" class="ct-an" tabindex="-1" aria-hidden="true">Tính lại</button>
        <div class="kho-bang-khung">
          <table class="kho-bang ct-luoi">
            <thead>
              <tr>
                <th>Phần ra</th>
                <th class="so">Tỷ lệ %</th>
                {goiY && <th class="so">Gợi ý</th>}
                <th>Xử lý</th>
                <th class="so">Thứ tự</th>
                <th>Bỏ</th>
              </tr>
            </thead>
            <tbody>
              {luoiDung.map((d, i) => (
                <tr style={d.bo ? 'opacity:.5' : undefined}>
                  <td><ChonMatHang name={`mh_${i}`} matHang={matHang} chon={d.mh} trong="— chọn phần ra —" /></td>
                  <td class="so"><input type="text" inputmode="decimal" name={`tl_${i}`} value={d.tl} placeholder="72,5" aria-label={`Tỷ lệ % dòng ${i + 1}`} /></td>
                  {goiY && <td class="so">{d.mh && goiY.tyLe.has(d.mh) ? <strong>{dinhDangPhanTram(goiY.tyLe.get(d.mh))}</strong> : <span class="kho-phu">—</span>}</td>}
                  <td>
                    <select name={`xl_${i}`} aria-label={`Xử lý dòng ${i + 1}`}>
                      <option value="" selected={!d.xl}>Theo mặt hàng{d.mh && tenMh.get(d.mh) ? ` (${TEN_XU_LY[tenMh.get(d.mh)!.xu_ly_mac_dinh]})` : ''}</option>
                      <option value="nhap_kho" selected={d.xl === 'nhap_kho'}>Nhập kho / ra quầy</option>
                      <option value="chuyen_bep" selected={d.xl === 'chuyen_bep'}>Chuyển bếp</option>
                      <option value="bo" selected={d.xl === 'bo'}>Bỏ đi</option>
                    </select>
                  </td>
                  <td class="so"><input type="text" inputmode="numeric" name={`tt_${i}`} value={d.tt} style="max-width:4.5rem" aria-label={`Thứ tự dòng ${i + 1}`} /></td>
                  <td><label class="kho-tich" style="margin:0"><input type="checkbox" name={`bo_${i}`} value="co" checked={d.bo} /> Bỏ</label></td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class={`tong ct-tong ${mauTong(tongLuoi)}`}>
                <td colspan={goiY ? 6 : 5}>{cauTong(tongLuoi)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
        <div class="kho-thanh-nut">
          <button type="submit" name="viec" value="tinh_lai" class="nb-nut phu">Tính lại</button>
          <button type="submit" name="viec" value="them_dong" class="nb-nut phu">Thêm dòng</button>
          <button type="submit" name="viec" value="luu_luoi" class="nb-nut">Lưu công thức</button>
        </div>
      </form>
      {goiYThieu.length > 0 && (
        <p class="kho-phu">Pha thực tế còn ra: {goiYThieu.map(([mh, tl]) => `${tenMh.get(mh)?.ten ?? '—'} ${dinhDangPhanTram(tl)}`).join(' · ')} — bấm Thêm dòng để thêm vào công thức.</p>
      )}

      <div class="kho-thanh-nut" style="margin-top:.75rem">
        {!muonGoiY
          ? <a class="nb-nut phu" href={`/noi-bo/kho/cai-dat/cong-thuc?sua=${dangSua.id}&goi_y=1`}>Gợi ý từ thực tế</a>
          : <a class="nb-nut phu" href={`/noi-bo/kho/cai-dat/cong-thuc?sua=${dangSua.id}`}>Ẩn gợi ý</a>}
        <form method="POST" style="margin:0">
          <input type="hidden" name="viec" value="nhan_ban" />
          <input type="hidden" name="cong_thuc_id" value={dangSua.id} />
          <button type="submit" class="nb-nut phu">Nhân bản công thức</button>
        </form>
      </div>

      <details style="margin-top:1rem">
        <summary style="cursor:pointer;font-weight:600">Đổi tên / ngừng dùng công thức</summary>
        <form method="POST" style="margin-top:.75rem">
          <input type="hidden" name="viec" value="cong_thuc" />
          <input type="hidden" name="id" value={dangSua.id} />
          <label class="nb-o"><span>Tên</span><input type="text" name="ten" value={dangSua.ten} required maxlength="120" /></label>
          <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu" value={dangSua.ghi_chu ?? ''} /></label>
          <label class="nb-o"><span>Tình trạng</span>
            <select name="dang_dung"><option value="co" selected={dangSua.dang_dung}>Đang dùng</option><option value="khong" selected={!dangSua.dang_dung}>Ngừng dùng</option></select></label>
          <button type="submit" class="nb-nut phu">Lưu</button>
        </form>
      </details>
      <p style="margin:1rem 0 0"><a href="/noi-bo/kho/cai-dat/cong-thuc">Đóng</a></p>
    </div>
  )}

  <details class="nb-the" open={congThuc.length === 0}>
    <summary style="cursor:pointer;font-weight:700">+ Tạo công thức mới</summary>
    <form method="POST" style="margin-top:1rem">
      <input type="hidden" name="viec" value="cong_thuc" />
      <label class="nb-o"><span>Đầu vào (tảng hoặc phần cắt)</span>
        <ChonMatHang name="mat_hang_vao_id" matHang={matHang} loai={['tang', 'phan_cat']} batBuoc /></label>
      <label class="nb-o"><span>Tên công thức</span>
        <input type="text" name="ten" required maxlength="120" placeholder="Thăn ngoại → cắt lát nướng" /></label>
      <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu" /></label>
      <button type="submit" class="nb-nut">Tạo công thức</button>
    </form>
  </details>

  <h2>Các công thức ({congThuc.length})</h2>
  {congThuc.length === 0 ? <p class="nb-rong">Chưa có công thức nào.</p> : congThuc.map(c => (
    <a href={`/noi-bo/kho/cai-dat/cong-thuc?sua=${c.id}`} class="nb-dong" style={`display:block;text-decoration:none;color:inherit;${c.dang_dung ? '' : 'opacity:.55'}`}>
      <div class="nb-dong-dau"><strong>{c.ten}</strong><span class="kho-phu">{c.dong.length} phần ra · {dinhDangPhanTram(tongTyLeCt(c))}</span></div>
      <p class="kho-phu" style="margin:.3rem 0 0">Đầu vào: {tenMh.get(c.mat_hang_vao_id)?.ten ?? '—'}</p>
    </a>
  ))}
</Kho>

<style>
  .ct-an { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ct-luoi select, .ct-luoi input[type="text"] { font-size: 16px; min-height: 44px; width: 100%; }
  .ct-luoi td:first-child { min-width: 12rem; }
  .ct-luoi td.so input { max-width: 6rem; text-align: right; }
  .ct-tong td { font-weight: 700; }
  .ct-tong.xanh td { color: var(--kho-xanh, #1F7A4C); background: var(--kho-xanh-nen, #E9F5EE); }
  .ct-tong.vang td { color: #9A6B00; background: var(--kho-vang-nen, #FFF5DC); }
  .ct-tong.do td { color: var(--do); background: var(--kho-do-nen, #FDECEA); }
</style>
