---
/**
 * KHO — CÀI ĐẶT · CÔNG THỨC PHA LÓC MẪU
 *
 * "Tảng thăn ngoại thường ra: thăn cắt lát ~75%, thịt vụn ~8%, mỡ ~15%."
 * Công thức điền sẵn phiếu pha lóc và là mốc so tỉ lệ thu hồi thực tế. Không
 * bắt buộc — pha lóc vẫn ghi được khi chưa có công thức nào.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import {
  docCongThuc, docMatHang, luuCongThuc, themDongCongThuc, xoaDongCongThuc,
  type CongThuc, type MatHang,
} from '../../../../lib/kho/danh-muc.ts';
import { cauLoiKho, dinhDangPhanTram, TEN_XU_LY, type KetQua } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho/cai-dat', 302);

const suaId = Astro.url.searchParams.get('sua') ?? '';
let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form) {
  const viec = String(form.get('viec') ?? '');
  const kq = viec === 'cong_thuc' ? await luuCongThuc(k.client, form)
    : viec === 'them_dong' ? await themDongCongThuc(k.client, form)
    : viec === 'xoa_dong' ? await xoaDongCongThuc(k.client, form)
    : { ok: false, cau: 'Việc không hợp lệ.' };
  const quayVe = String(form.get('cong_thuc_id') ?? form.get('id') ?? '');
  if (kq.ok) return chuyenHuong(Astro, `/noi-bo/kho/cai-dat/cong-thuc${quayVe ? `?sua=${quayVe}` : ''}`, kq);
  bao = kq;
}

let congThuc: CongThuc[] = [];
let matHang: MatHang[] = [];
let loiDoc = k.loiDoc;
try {
  [congThuc, matHang] = await Promise.all([docCongThuc(k.client), docMatHang(k.client)]);
} catch (e) { loiDoc = cauLoiKho(e, 'Không đọc được công thức.'); }

const tenMh = new Map(matHang.map(m => [m.id, m]));
const dangSua = congThuc.find(c => c.id === suaId);
const tongTyLe = (c: CongThuc) => c.dong.reduce((s, d) => s + (d.ty_le_du_kien ?? 0), 0);
---
<Kho k={k} huongDan="cong-thuc" tieuDe="Công thức pha lóc">
  <h1>Công thức pha lóc</h1>
  <p><a href="/noi-bo/kho/cai-dat">← Thiết lập kho</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {dangSua && (
    <div class="nb-the">
      <h2 style="margin-top:0">{dangSua.ten}</h2>
      <p class="kho-phu">Đầu vào: <strong>{tenMh.get(dangSua.mat_hang_vao_id)?.ten ?? '—'}</strong> · tổng tỉ lệ dự kiến {dinhDangPhanTram(tongTyLe(dangSua))} (phần còn lại là hao hụt)</p>
      {dangSua.dong.length === 0 ? <p class="nb-rong">Chưa có phần ra nào.</p> : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>Phần ra</th><th class="so">Tỉ lệ dự kiến</th><th>Xử lý</th><th></th></tr></thead>
            <tbody>
              {dangSua.dong.map(d => (
                <tr>
                  <td>{tenMh.get(d.mat_hang_ra_id)?.ten ?? '—'}</td>
                  <td class="so">{d.ty_le_du_kien !== null ? dinhDangPhanTram(d.ty_le_du_kien) : '—'}</td>
                  <td>{d.xu_ly ? TEN_XU_LY[d.xu_ly] : `theo mặt hàng (${TEN_XU_LY[tenMh.get(d.mat_hang_ra_id)?.xu_ly_mac_dinh ?? 'nhap_kho']})`}</td>
                  <td>
                    <form method="POST" style="margin:0">
                      <input type="hidden" name="viec" value="xoa_dong" />
                      <input type="hidden" name="id" value={d.id} />
                      <input type="hidden" name="cong_thuc_id" value={dangSua.id} />
                      <button type="submit" class="nb-nut phu" style="min-height:36px;padding:.3rem .6rem;font-size:.8rem">Bỏ</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <form method="POST">
        <input type="hidden" name="viec" value="them_dong" />
        <input type="hidden" name="cong_thuc_id" value={dangSua.id} />
        <div class="kho-luoi">
          <label class="nb-o"><span>Phần ra</span>
            <ChonMatHang name="mat_hang_ra_id" matHang={matHang} batBuoc /></label>
          <label class="nb-o"><span>Tỉ lệ dự kiến (%)</span>
            <input type="text" inputmode="decimal" name="ty_le_du_kien" placeholder="72,5" /></label>
          <label class="nb-o"><span>Xử lý</span>
            <select name="xu_ly">
              <option value="">Theo mặt hàng</option>
              <option value="nhap_kho">Nhập kho / ra quầy</option>
              <option value="chuyen_bep">Chuyển bếp</option>
              <option value="bo">Bỏ</option>
            </select></label>
          <label class="nb-o"><span>Thứ tự</span><input type="text" inputmode="numeric" name="thu_tu" value={String(dangSua.dong.length + 1)} /></label>
        </div>
        <button type="submit" class="nb-nut">Thêm / cập nhật phần ra</button>
      </form>
      <details style="margin-top:1rem">
        <summary style="cursor:pointer;font-weight:600">Đổi tên / ngừng dùng công thức</summary>
        <form method="POST" style="margin-top:.75rem">
          <input type="hidden" name="viec" value="cong_thuc" />
          <input type="hidden" name="id" value={dangSua.id} />
          <label class="nb-o"><span>Tên</span><input type="text" name="ten" value={dangSua.ten} required maxlength="120" /></label>
          <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu" value={dangSua.ghi_chu ?? ''} /></label>
          <label class="nb-o"><span>Tình trạng</span>
            <select name="dang_dung"><option value="co" selected={dangSua.dang_dung}>Đang dùng</option><option value="khong" selected={!dangSua.dang_dung}>Ngừng dùng</option></select></label>
          <button type="submit" class="nb-nut phu">Lưu</button>
        </form>
      </details>
      <p style="margin:1rem 0 0"><a href="/noi-bo/kho/cai-dat/cong-thuc">Đóng</a></p>
    </div>
  )}

  <details class="nb-the" open={congThuc.length === 0}>
    <summary style="cursor:pointer;font-weight:700">+ Tạo công thức mới</summary>
    <form method="POST" style="margin-top:1rem">
      <input type="hidden" name="viec" value="cong_thuc" />
      <label class="nb-o"><span>Đầu vào (tảng hoặc phần cắt)</span>
        <ChonMatHang name="mat_hang_vao_id" matHang={matHang} loai={['tang', 'phan_cat']} batBuoc /></label>
      <label class="nb-o"><span>Tên công thức</span>
        <input type="text" name="ten" required maxlength="120" placeholder="Thăn ngoại → cắt lát nướng" /></label>
      <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu" /></label>
      <button type="submit" class="nb-nut">Tạo công thức</button>
    </form>
  </details>

  <h2>Các công thức ({congThuc.length})</h2>
  {congThuc.length === 0 ? <p class="nb-rong">Chưa có công thức nào.</p> : congThuc.map(c => (
    <a href={`/noi-bo/kho/cai-dat/cong-thuc?sua=${c.id}`} class="nb-dong" style={`display:block;text-decoration:none;color:inherit;${c.dang_dung ? '' : 'opacity:.55'}`}>
      <div class="nb-dong-dau"><strong>{c.ten}</strong><span class="kho-phu">{c.dong.length} phần ra · {dinhDangPhanTram(tongTyLe(c))}</span></div>
      <p class="kho-phu" style="margin:.3rem 0 0">Đầu vào: {tenMh.get(c.mat_hang_vao_id)?.ten ?? '—'}</p>
    </a>
  ))}
</Kho>
