    vi: '(cùng cách như bước 1). Máy chủ dùng nó để ghi hóa đơn iPOS gửi sang và chạy lượt 5 phút.',
    en: '(the same way as step 1). The server uses it to record invoices sent by iPOS and to run the 5-minute job.',
  },
  cai4a: { vi: 'Token do iPOS cấp:', en: 'The token issued by iPOS:' },
  cai4b: {
    vi: '(hoặc Cloudflare → Workers & Pages → beeftown → Settings → Variables and Secrets → Add → loại',
    en: '(or Cloudflare → Workers & Pages → beeftown → Settings → Variables and Secrets → Add → type',
  },
  cai4c: {
    vi: '). Dùng để kéo bù hóa đơn từ iPOS. Không ghi vào wrangler.toml, không gửi qua Zalo, không dán vào trang này.',
    en: '). It is used to fetch missed invoices from iPOS. Never put it in wrangler.toml, never send it over Zalo, never paste it into this page.',
  },
  cai5a: { vi: 'Chủ điền cấu hình ở trên, chọn quầy bán, tích', en: 'The owner fills in the settings above, chooses the sales counter, ticks' },
  cai5b: { vi: ', bấm', en: ', presses' },
  cai5c: { vi: ', gửi địa chỉ nhận hóa đơn cho iPOS, rồi bấm', en: ', sends the invoice receiving address to iPOS, then presses' },
  cai5d: { vi: 'để kéo thử hóa đơn từ iPOS.', en: 'to fetch invoices from iPOS as a test.' },
  soChuaCai: { vi: (n: number) => `${n} việc chưa cài`, en: (n: number) => `${n} ${n === 1 ? 'item' : 'items'} not set up` },
  daCaiDu: { vi: 'đã cài đủ', en: 'all set up' },
  chuaCaiThiTat: {
    vi: 'Chưa cài thì phần đó tắt, mọi thứ khác vẫn chạy bình thường.',
    en: 'Anything not set up yet stays off; everything else keeps working as usual.',
  },
  // Nhật ký
  muoiLuot: { vi: '10 lượt gần nhất', en: 'Last 10 runs' },
  chuaCoLuot: { vi: 'Chưa có lượt đồng bộ nào.', en: 'No sync runs yet.' },
  luc: { vi: 'Lúc', en: 'Time' },
  aiChay: { vi: 'Ai chạy', en: 'Run by' },
  hoaDon: { vi: 'Hóa đơn', en: 'Invoices' },
  dong: { vi: 'Dòng', en: 'Lines' },
  daTruKho: { vi: 'Đã trừ kho', en: 'Deducted' },
  ketQua: { vi: 'Kết quả', en: 'Result' },
  loi: { vi: 'Lỗi', en: 'Error' },
  xong: { vi: 'Xong', en: 'Done' },
  dangChayNhan: { vi: 'Đang chạy', en: 'Running' },
});

let tt: TrangThaiIpos | null = null;
let quay: ViTri[] = [];
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    [tt, quay] = await Promise.all([
      docTrangThaiIpos(k.client, k.chiNhanh.id),
      docViTri(k.client, k.chiNhanh.id).then(ds => ds.filter(v => v.loai === 'quay' && v.dang_dung)),
    ]);
  } catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }
}
// Chỉ biết CÓ / KHÔNG — không bao giờ đưa giá trị bí mật ra trang (trừ khóa callback cho chủ).
let biMat = { token: false, taiKhoanMay: false, khoaCallback: false };
try { biMat = await trangThaiBiMatIpos(); } catch { /* coi như chưa cài */ }
const coToken = biMat.token;
let khoa: string | undefined;
if (laChu) { try { khoa = await layKhoaCallback(); } catch { /* coi như chưa cài */ } }
const gocWeb = (Astro.site ?? Astro.url).origin;
const diaChiNhan = biMat.khoaCallback ? `${gocWeb}${DUONG_HOOK}${laChu && khoa ? khoa : cheKhoa('x')}` : null;
const chuNguon = (n: string) => n === 'tay' ? t.nguonTay : n === 'callback' ? t.nguonIpos : t.nguonTuDong;

/** Giá trị ô: chữ vừa gõ (lưu hỏng) hoặc cấu hình đang dùng. */
const o = (khoa: string, hienTai: string | number | null | undefined) =>
  formLai ? String(formLai.get(khoa) ?? '') : String(hienTai ?? '');
const batDangChon = formLai ? formLai.get('bat') === 'co' : !!tt?.bat;
const quayDangChon = formLai ? String(formLai.get('vi_tri_ban_id') ?? '') : (tt?.vi_tri_ban_id ?? '');
const tenQuay = quay.find(q => q.id === tt?.vi_tri_ban_id)?.ten ?? null;
const dangIpos = tt?.nguon_so_ban === 'ipos' && !!tt?.ipos_tu_luc;
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="ipos">
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/cai-dat">{t.veThietLap}</a></p>
  <p class="kho-phu" style="margin-top:0">{t.gioiThieu}</p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaKhoiTao} <a href="/noi-bo/kho">{t.tongQuan}</a>.</p>
  ) : tt && (
    <>
      <section class={`nb-bao ${lopDen(tt.den)}`} aria-live="polite">
        <p style="margin:0"><strong>{chuDen(tt.den, nn)}.</strong> {dichCau(nn, tt.cau)}</p>
        <p class="kho-phu" style="margin:.35rem 0 0">
          {t.lanNhanHd} <strong>{tt.nhan_hd_luc ? dinhDangThoiDiem(tt.nhan_hd_luc) : t.chuaNhanHd}</strong> · {t.lanCapNhatCuoi} {dinhDangThoiDiem(tt.lan_cuoi_luc)}
          {tt.dang_chay && t.dangChay}
        </p>
        {tt.lan_cuoi_loi && <p class="kho-phu" style="margin:.35rem 0 0">{t.loiLanCuoi} {dichLoiIpos(tt.lan_cuoi_loi, nn)}</p>}
      </section>

      <div class="kho-o-so-luoi">
        <a class:list={['kho-o-so', { 'luu-y': tt.dem.chua_khop > 0 }]} href="/noi-bo/kho/ban-ipos?the=chua_khop">
          <b>{tt.dem.chua_khop + tt.dem.loi}</b><span>{t.dongChuaGhep(tt.dem.chua_khop + tt.dem.loi)}</span></a>
        <a class:list={['kho-o-so', { 'luu-y': tt.dem.thieu_hang > 0 }]} href="/noi-bo/kho/ban-ipos?the=thieu_hang">
          <b>{tt.dem.thieu_hang}</b><span>{t.dongThieuHang(tt.dem.thieu_hang)}</span></a>
        <a class="kho-o-so" href="/noi-bo/kho/ban-ipos?the=da_ghi"><b>{tt.dem.da_ghi_hom_nay}</b><span>{t.dongDaTru(tt.dem.da_ghi_hom_nay)}</span></a>
        {tt.dem.het_han > 0 && (
          <a class="kho-o-so gap" href="/noi-bo/kho/ton?han=het_han"><b>{tt.dem.het_han}</b><span>{t.dongHetHan(tt.dem.het_han)}</span></a>
        )}
      </div>

      {dongBoDuoc && (
        <form method="POST" class="nb-the">
          <input type="hidden" name="viec" value="cap_nhat" />
          <p style="margin-top:0"><strong>{t.capNhatNgay}</strong> {t.capNhatGiai}</p>
          {!coToken && (
            <p class="kho-phu">{t.mayChu} <strong>{t.chuaCaiToken}</strong> {t.chuaCaiTokenGiai}</p>
          )}
          <button type="submit" class="nb-nut" disabled={!tt.bat || tt.dang_chay}>{t.capNhatNgay}</button>
          {!tt.bat && <p class="kho-phu" style="margin:.5rem 0 0">{t.dongBoTat}</p>}
        </form>
      )}

      <h2>{t.truKhoTheoIpos}</h2>
      <div class="nb-the">
        {dangIpos ? (
          <>
            <p style="margin-top:0"><span class="nb-nhan song">{t.dangDung}</span> {t.khoTuTru}
              <strong> {dinhDangThoiDiem(tt.ipos_tu_luc)}</strong>{tenQuay ? <> {t.oQuay} <strong>{tenQuay}</strong></> : ''}. {t.demQuayGio}</p>
            {laChu && (
              <form method="POST">
                <input type="hidden" name="viec" value="tro_ve" />
                <p class="kho-phu">{t.quayLaiGiai}</p>
                <button type="submit" class="nb-nut phu">{t.quayLai}</button>
              </form>
            )}
          </>
        ) : (
          <>
            <p style="margin-top:0"><span class="nb-nhan cho">{t.chuaDung}</span> {t.soBanLay} <strong>{t.demQuayCuoiNgay}</strong> {t.soBanLayGiai}</p>
            {laChu ? (
              <form method="POST">
                <input type="hidden" name="viec" value="chuyen_sang" />
                <p class="kho-phu">{t.khiChuyen} <strong>{t.moc}</strong> {t.khiChuyenGiai}</p>
                <label class="nb-o">
                  <span>{t.mocChuyen}</span>
                  <small>{t.mocTrong}</small>
                  <input type="datetime-local" name="tu_luc" value={oMocChuyen(tt.ipos_tu_luc)} />
                </label>
                <label class="kho-tich"><input type="checkbox" name="xac_nhan" value="co" />
                  <span>{t.toiDaHieu}</span></label>
                <button type="submit" class="nb-nut" disabled={!tt.vi_tri_ban_id}>{t.chuyenSang}</button>
                {!tt.vi_tri_ban_id && <p class="kho-phu" style="margin:.5rem 0 0">{t.chonQuayTruoc}</p>}
              </form>
            ) : (
              <p class="kho-phu" style="margin:0">{t.chiChuChuyen}</p>
            )}
          </>
        )}
      </div>

      <details class="ip-gap" id="cau-hinh" open={!!formLai || !tt.bat}>
        <summary><h2>{t.cauHinh}</h2> <span class="kho-phu">· {tt.bat ? t.dangBat : t.dangTat}{tenQuay ? ` · ${tenQuay}` : ''}</span></summary>
      {laChu ? (
        <form method="POST" class="nb-the">
          <input type="hidden" name="viec" value="luu" />
          <label class="kho-tich"><input type="checkbox" name="bat" value="co" checked={batDangChon} />
            <span><strong>{t.batDongBo}</strong> {t.batDongBoGiai}</span></label>
          <div class="nb-hai">
            <label class="nb-o"><span>{t.maThuongHieu}</span>
              <input type="text" name="pos_parent" value={o('pos_parent', tt.pos_parent)} autocomplete="off" spellcheck="false" /></label>
            <label class="nb-o"><span>{t.maCuaHang}</span>
              <input type="text" name="pos_id" value={o('pos_id', tt.pos_id)} autocomplete="off" spellcheck="false" /></label>
          </div>
          <p class="kho-phu" style="margin:-.25rem 0 .75rem">{t.maIposGiai}</p>
          <label class="nb-o">
            <span>{t.quayBan}</span>
            <small>{t.quayBanGiai}</small>
            <select name="vi_tri_ban_id">
              <option value="">{t.chonQuay}</option>
              {quay.map(q => <option value={q.id} selected={q.id === quayDangChon}>{q.ten}</option>)}
            </select>
          </label>
          <div class="nb-hai">
            <label class="nb-o"><span>{t.gioMoCua}</span>
              <input type="text" inputmode="numeric" name="gio_mo_cua" value={o('gio_mo_cua', tt.gio_mo_cua)} /></label>
            <label class="nb-o"><span>{t.gioDongCua}</span>
              <input type="text" inputmode="numeric" name="gio_dong_cua" value={o('gio_dong_cua', tt.gio_dong_cua)} /></label>
          </div>
          <label class="nb-o">
            <span>{t.baoMatKetNoi}</span>
            <small>{t.baoMatKetNoiGiai}</small>
            <input type="text" inputmode="numeric" name="gio_mat_ket_noi" value={o('gio_mat_ket_noi', tt.gio_mat_ket_noi)} />
          </label>
          <p class="kho-phu" style="margin:0 0 .75rem">{t.quanVang} <strong>{t.khongDanToken}</strong> {t.tokenBiMat}</p>
          <button type="submit" class="nb-nut">{t.luuCauHinh}</button>
        </form>
      ) : (
        <div class="nb-the">
          <dl style="margin:0">
            <dt>{t.dongBo}</dt><dd>{tt.bat ? t.dangBat : t.dangTat}</dd>
            <dt>{t.maThuongHieu}</dt><dd>{tt.pos_parent ?? '—'}</dd>
            <dt>{t.maCuaHang}</dt><dd>{tt.pos_id ?? '—'}</dd>
            <dt>{t.quayBan}</dt><dd>{tenQuay ?? t.chuaChon}</dd>
            <dt>{t.khungGioMo}</dt><dd>{tt.gio_mo_cua}h – {tt.gio_dong_cua}h</dd>
            <dt>{t.baoMatKetNoiSau}</dt><dd>{t.gioKhongNhan(tt.gio_mat_ket_noi)}</dd>
          </dl>
          <p class="kho-phu" style="margin:.5rem 0 0">{t.chiChuSua}</p>
        </div>
      )}
      </details>

      <details class="nb-the ip-gap" id="dia-chi-nhan">
        <summary><h2>{t.diaChiNhan}</h2> <span class={`nb-nhan ${biMat.khoaCallback ? 'song' : 'cho'}`}>{biMat.khoaCallback ? t.daCai : t.chuaCai}</span></summary>
        {diaChiNhan ? (
          <>
            <label class="nb-o" style="margin-bottom:.5rem">
              <span>{t.danDiaChi}</span>
              <input type="text" readonly value={diaChiNhan} autocomplete="off" spellcheck="false" />
            </label>
            {!laChu && <p class="kho-phu" style="margin:0">{t.phanCuoiChe}</p>}
            {laChu && <p class="kho-phu" style="margin:0">{t.phanCuoi} <strong>{t.khoaBiMat}</strong>{t.khoaBiMatGiai}</p>}
          </>
        ) : (
          <p class="kho-phu" style="margin:0">{t.mayChu} <strong>{t.chuaCaiKhoa}</strong> {t.chuaCaiKhoaGiai}</p>
        )}

        <h3>{t.viecNhoIpos}</h3>
        <ol class="kho-phu" style="margin:.25rem 0 0;padding-left:1.25rem">
          <li>{t.nho1a} <strong>webhook</strong> {t.nho1b}</li>
          <li>{t.nho2a} <strong>{t.moiHoaDon}</strong> {t.nho2b}</li>
          <li>{t.nho3a} <strong>access_token</strong> {t.nho3b}</li>
          <li>{t.nho4a} <strong>kg</strong> {t.hayTheo} <strong>{t.goi}</strong> {t.nho4b} <a href="/noi-bo/kho/ban-ipos/ghep">{t.ghepMon}</a>.</li>
        </ol>
      </details>

      <details class="nb-the ip-gap" id="cai-lan-dau">
        {(() => {
          const chuaCai = [biMat.khoaCallback, biMat.taiKhoanMay, coToken].filter(x => !x).length;
          return <summary><h2>{t.caiLanDau}</h2> <span class={`nb-nhan ${chuaCai ? 'cho' : 'song'}`}>{chuaCai ? t.soChuaCai(chuaCai) : t.daCaiDu}</span></summary>;
        })()}
        <p style="margin:0">
          {t.khoaNhanHd} <span class={`nb-nhan ${biMat.khoaCallback ? 'song' : 'cho'}`}>{biMat.khoaCallback ? t.daCai : t.chuaCai}</span>{' '}
          {t.taiKhoanMay} <span class={`nb-nhan ${biMat.taiKhoanMay ? 'song' : 'cho'}`}>{biMat.taiKhoanMay ? t.daCai : t.chuaCai}</span>{' '}
          {t.tokenIpos} <span class={`nb-nhan ${coToken ? 'song' : 'cho'}`}>{coToken ? t.daCai : t.chuaCai}</span>
        </p>
        <ol class="kho-phu" style="margin:.75rem 0 0;padding-left:1.25rem">
          <li>{t.cai1a(KHOA_TOI_THIEU)} <code>openssl rand -hex 24</code>{t.cai1b} <code>npx wrangler secret put IPOS_CALLBACK_KHOA</code> {t.cai1c}</li>
          <li>{t.cai2a} <strong>{t.mayDongBoIpos}</strong> {t.oTrang} <a href="/noi-bo/kho/cai-dat/nhan-vien">{t.nhanVienMay}</a>{t.cai2b}</li>
          <li>{t.cai3a} <code>KHO_IPOS_EMAIL</code> {t.va} <code>KHO_IPOS_MAT_KHAU</code> {t.cai3b}</li>
          <li>{t.cai4a} <code>npx wrangler secret put IPOS_ACCESS_TOKEN</code> {t.cai4b} <strong>Secret</strong>{t.cai4c}</li>
          <li>{t.cai5a} <strong>{t.batDongBo}</strong>{t.cai5b} <strong>{t.luuCauHinh}</strong>{t.cai5c} <strong>{t.capNhatNgay}</strong> {t.cai5d}</li>
        </ol>
        <p class="kho-phu" style="margin:.5rem 0 0">{t.chuaCaiThiTat}</p>
      </details>

      <h2>{t.muoiLuot}</h2>
      {tt.lan_chay.length === 0 ? (
        <p class="nb-rong">{t.chuaCoLuot}</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>{t.luc}</th><th>{t.aiChay}</th><th class="so">{t.hoaDon}</th><th class="so">{t.dong}</th><th class="so">{t.daTruKho}</th><th>{t.ketQua}</th></tr></thead>
            <tbody>
              {tt.lan_chay.map(l => (
                <tr>
                  <td>{dinhDangThoiDiem(l.bat_dau_luc)}</td>
                  <td>{chuNguon(l.nguon)}</td>
                  <td class="so">{l.so_hd}</td>
                  <td class="so">{l.so_dong}</td>
                  <td class="so">{l.so_da_ghi}</td>
                  <td>{l.loi ? <span class="nb-nhan cho">{t.loi}</span> : l.ket_thuc_luc ? <span class="nb-nhan song">{t.xong}</span> : <span class="nb-nhan nhap">{t.dangChayNhan}</span>}
                    {l.loi && <> {dichLoiIpos(l.loi, nn)}</>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  )}
</Kho>

<style>
  /* Phần kỹ thuật gập: tiêu đề h2 nằm trong summary, tình trạng ngắn bên cạnh. */
  .ip-gap { margin: 1.5rem 0 1rem; scroll-margin-top: 5rem; }
  .ip-gap > summary { cursor: pointer; list-style: none; display: flex; align-items: center; flex-wrap: wrap; gap: .25rem .6rem; min-height: 48px; }
  .ip-gap > summary::-webkit-details-marker { display: none; }
  .ip-gap > summary::before { content: '▸'; color: var(--muc-nhat); }
  .ip-gap[open] > summary::before { content: '▾'; }
  .ip-gap > summary h2 { margin: 0; }
  .ip-gap[open] > summary { margin-bottom: .75rem; }
</style>
