const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('xem')) return Astro.redirect('/noi-bo/kho', 302);
const laChu = k.duoc('cai_dat_goc');
const dongBoDuoc = k.duoc('dong_bo_ban');
const DUONG = '/noi-bo/kho/cai-dat/ipos';
const nn = k.nn;

let bao: KetQua | null = k.bao;
let formLai: FormData | null = null;
const form = await docFormGui(Astro);
if (form && k.chiNhanh) {
  const viec = String(form.get('viec') ?? '');
  let kq: KetQua;
  if (viec === 'cap_nhat' && dongBoDuoc) {
    try {
      const r = await dongBoIpos({ supabase: k.client, chiNhanhId: k.chiNhanh.id, nguon: 'tay' });
      kq = { ok: r.ok, cau: r.cau, cauEn: r.cauEn };
    } catch {
      // dongBoIpos tự bắt lỗi và xóa token khỏi câu lỗi; tới đây là lỗi lạ — không in chi tiết
      // (câu lỗi thô có thể chứa URL kèm token).
      kq = kqHai(false, { vi: 'Không cập nhật được — thử lại sau ít phút.', en: 'Could not update — try again in a few minutes.' });
    }
  } else if (viec === 'luu' && laChu) {
    kq = await luuCauHinhIpos(k.client, k.chiNhanh.id, form);
    if (!kq.ok) formLai = form;
  } else if (viec === 'chuyen_sang' && laChu) {
    kq = await chuyenSangIpos(k.client, k.chiNhanh.id, form);
  } else if (viec === 'tro_ve' && laChu) {
    kq = await troVeDemQuay(k.client, k.chiNhanh.id);
  } else kq = kqHai(false, { vi: 'Tài khoản của bạn không làm được việc này.', en: 'Your account cannot do this.' });
  if (kq.ok) return chuyenHuong(Astro, DUONG, kq);
  bao = kq;
}

