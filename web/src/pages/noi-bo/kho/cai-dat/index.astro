  chuaBatDau: { vi: (ten: string) => `${ten} chưa bắt đầu dùng kho.`, en: (ten: string) => `${ten} has not started using inventory yet.` },
  bamTaoSan: { vi: ' Bấm để tạo sẵn kho lạnh, quầy thịt, chỗ hàng chờ hủy và lý do mặc định.',
               en: ' Press to create the cold store, the meat counter, an awaiting write-off area and the default reasons.' },
  batDauDung: { vi: 'Bắt đầu dùng kho', en: 'Start using inventory' },
  ariaDaXong: { vi: 'Số bước đã xong', en: 'Steps done' },
  daXong: { vi: (a: number, b: number) => `Đã xong ${a}/${b} bước.`, en: (a: number, b: number) => `${a}/${b} ${s(b, 'step', 'steps')} done.` },
  nhanBoQua: { vi: 'Bỏ qua', en: 'Skipped' },
  nhanXong: { vi: 'Xong', en: 'Done' },
  nhanChuaXong: { vi: 'Chưa xong', en: 'Not done' },
  lamBuocNay: { vi: 'Làm bước này', en: 'Do this step' },
  danhMuc: { vi: 'Danh mục', en: 'Catalog' },
  mayDungChung: { vi: 'Máy dùng chung', en: 'Shared tablet' },
  daBat: { vi: 'Đã bật', en: 'On' },
  chuaBat: { vi: 'Chưa bật', en: 'Off' },
  may1a: { vi: 'Chủ tạo tài khoản vai "Máy tính bảng dùng chung" ở ', en: 'The owner creates an account with the "Shared tablet" role in ' },
  nvMay: { vi: 'Nhân viên & máy dùng chung', en: 'Staff & shared tablets' },
  may2a: { vi: 'Trên tablet, quản lý mở ', en: 'On the tablet, a manager opens ' },
  may2b: { vi: ', nhập email + mật khẩu của tài khoản máy.', en: ' and enters the email + password of the tablet account.' },
  may3: { vi: 'Từng nhân viên đăng nhập đầy đủ một lần trên máy đó và đặt PIN 4–6 số.', en: 'Each staff member logs in fully once on that tablet and sets a 4–6 digit PIN.' },
  may4: { vi: 'Từ đó: chọn tên → gõ PIN. Không dùng 5 phút thì máy tự khóa.', en: 'After that: pick your name → type your PIN. After 5 minutes unused, the tablet locks itself.' },
  cachBat: { vi: 'Cách bật', en: 'How to turn it on' },
  cachBat2: { vi: ' (người quản lý Cloudflare làm một lần, mất 2 phút):', en: ' (whoever manages Cloudflare does this once; it takes 2 minutes):' },
  bat1: { vi: 'Tạo một chuỗi bí mật ngẫu nhiên, ít nhất 32 ký tự — ví dụ chạy ', en: 'Create a random secret of at least 32 characters — for example, run ' },
