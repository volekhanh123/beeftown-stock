  nguong: { vi: 'Ngưỡng cảnh báo', en: 'Alert thresholds' },
  nguongGoiY: { vi: 'Vượt các ngưỡng này thì phần mềm báo quản lý (chuông, Việc cần làm). Chỉ báo, không chặn.',
                en: 'When a threshold is crossed, the software alerts the manager (bell, To-do). It only warns; it does not block anything.' },
  luuLanCuoi: { vi: (x: string) => ` Lưu lần cuối: ${x}.`, en: (x: string) => ` Last saved: ${x}.` },
  dangMacDinh: { vi: ' Đang dùng số mặc định — xem lại rồi bấm Lưu.', en: ' Using the default values — check them, then press Save.' },
  tuDen: { vi: (a: number, b: number) => ` Từ ${a} đến ${b}.`, en: (a: number, b: number) => ` From ${a} to ${b}.` },
  luuNguong: { vi: 'Lưu ngưỡng cảnh báo', en: 'Save alert thresholds' },
  quanLyDoi: { vi: 'Quản lý hoặc chủ đổi được các ngưỡng này.', en: 'A manager or the owner can change these thresholds.' },
});

let bao: KetQua | null = k.bao;
// Lưu ngưỡng hỏng thì hiện lại đúng số vừa gõ.
let nguongLai: FormData | null = null;
const form = await docFormGui(Astro);
if (form && k.chiNhanh) {
  const viec = String(form.get('viec') ?? '');
  let kq: KetQua;
  let ve = '/noi-bo/kho/cai-dat';
  if (viec === 'khoi_tao') kq = await khoiTaoKho(k.client, k.chiNhanh.id);
  else if (viec === 'chung') kq = await luuCaiDat(k.client, form, k.chiNhanh.id);
  else if (viec === 'goc') kq = await luuCaiDatGoc(k.client, form, k.chiNhanh.id);
  else if (viec === 'nhan_quay') kq = await luuCongTacNhan(k.client, k.chiNhanh.id, form.get('chuyen_quay_can_nhan') === 'co');
  else if (viec === 'nguong') {
    kq = await luuNguong(k.client, k.chiNhanh.id, form);
    if (!kq.ok) nguongLai = form;
  } else if (viec === 'bo_qua') {
    const buoc = String(form.get('buoc') ?? '');
    kq = await danhDauBuoc(k.client, k.chiNhanh.id, buoc, form.get('bo_qua') === 'co');
    ve = `/noi-bo/kho/cai-dat#buoc-${buoc.replace(/[^a-z_]/g, '')}`;
  } else kq = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
  if (kq.ok) return chuyenHuong(Astro, ve, kq);
  bao = kq;
}

let caiDat: CaiDat | null = null;
let viTri: ViTri[] = [];
let caiDatQuay: CaiDatQuay | null = null;
let nguong: NguongDangDung | null = null;
let tienDo: TienDoThietLap | null = null;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    [caiDat, viTri, caiDatQuay, nguong] = await Promise.all([
      docCaiDat(k.client, k.chiNhanh.id), docViTri(k.client, k.chiNhanh.id), docCaiDatQuay(k.client, k.chiNhanh.id),
      docNguong(k.client, k.chiNhanh.id),
    ]);
  } catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }
}
// Tiến độ đọc riêng: hỏng thì các phần cài đặt vẫn dùng được.
let loiTienDo: string | null = null;
if (k.chiNhanh && k.daKhoiTao) {
  try { tienDo = await docTienDo(k.client, k.chiNhanh.id, nn); }
  catch (e) { loiTienDo = cauLoiKho(e, t.khongDocTienDo); }
}
/** Giá trị trong ô ngưỡng: số vừa gõ (khi lưu hỏng) hoặc số đang dùng. */
const oNguong = (khoa: string) => nguongLai ? String(nguongLai.get(khoa) ?? '') : hienSoNguong(nguong?.gia_tri[khoa], nn);

const MUC: { link: string; ten: HaiThuTieng; mo_ta: HaiThuTieng; hien: boolean }[] = [
  { link: '/noi-bo/kho/cai-dat/mat-hang', ten: { vi: 'Mặt hàng', en: 'Items' },
    mo_ta: { vi: 'Tảng nhập, phần cắt bán ở quầy, phụ phẩm. Giá bán, hạn dùng, mã cân. Dán từ Excel được.',
             en: 'Primals bought in, cuts sold at the counter, by-products. Sale prices, use-by, scale codes. You can paste from Excel.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/mat-hang/sua-nhanh', ten: { vi: 'Sửa nhanh mặt hàng', en: 'Quick edit items' },
    mo_ta: { vi: 'Một bảng mọi món: giá bán, hạn dùng, mã cân, mức quầy, mức kho lạnh — sửa nhiều món rồi Lưu tất cả một lần.',
             en: 'One table of every item: sale price, use-by, scale code, counter levels, cold store levels — edit many items, then Save all at once.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/cong-thuc', ten: { vi: 'Công thức pha lóc', en: 'Butchery recipes' },
    mo_ta: { vi: 'Mỗi loại tảng thường ra những phần nào, tỉ lệ bao nhiêu — để điền sẵn phiếu pha và so thu hồi.',
             en: 'Which cuts each primal usually gives, and in what proportions — to pre-fill butchery sessions and compare yield.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/dinh-luong', ten: { vi: 'Định lượng món', en: 'Dish recipes' },
    mo_ta: { vi: 'Mỗi suất món dùng bao nhiêu gram thịt — để so với số thịt bếp nhận. Lấy món từ iPOS, dán từ Excel được.',
             en: 'How many grams of meat each portion uses — to compare with the meat the kitchen received. Dishes come from iPOS; you can paste from Excel.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/nha-cung-cap', ten: { vi: 'Nhà cung cấp', en: 'Suppliers' },
    mo_ta: { vi: 'Tên, mã số thuế, số ngày nợ, tài khoản ngân hàng.', en: 'Name, tax code, credit days, bank account.' },
    hien: k.duoc('ncc') },
  { link: '/noi-bo/kho/cai-dat/vi-tri-ly-do', ten: { vi: 'Vị trí và lý do', en: 'Locations and reasons' },
    mo_ta: { vi: 'Kho lạnh, quầy; lý do hủy, lý do xuất bếp, ảnh bắt buộc.', en: 'Cold store, counter; write-off reasons, kitchen issue reasons, required photos.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/o-thong-tin', ten: { vi: 'Ô thông tin thêm', en: 'Custom fields' },
    mo_ta: { vi: 'Tự tạo ô mới cho mặt hàng, nhà cung cấp, phiếu nhập, lô hàng: xuất xứ, grade, nhiệt độ khi nhận…',
             en: 'Create your own fields for items, suppliers, goods receipts and lots: origin, grade, temperature on arrival…' },
    hien: k.duoc('danh_muc') || k.duoc('cai_dat_goc') },
  { link: '/noi-bo/kho/cai-dat/ma-vach', ten: { vi: 'Mã vạch cân', en: 'Scale barcodes' },
    mo_ta: { vi: 'Cách đọc nhãn cân Dahua (mặc định 2+5+5+1). Có ô thử một nhãn thật.',
             en: 'How Dahua scale labels are read (default 2+5+5+1). Includes a box to test a real label.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/ipos', ten: { vi: 'Kết nối iPOS', en: 'iPOS connection' },
    mo_ta: { vi: 'iPOS tự gửi hóa đơn sang, kho trừ ở quầy. Địa chỉ nhận hóa đơn, đèn trạng thái, Cập nhật ngay, chuyển từ đếm quầy sang iPOS.',
             en: 'iPOS sends the sales invoices over and stock is deducted at the counter. Invoice receiving address, status light, Update now, switching from counter counts to iPOS.' },
    hien: k.duoc('danh_muc') || k.duoc('cai_dat_goc') },
  { link: '/noi-bo/kho/cai-dat/can', ten: { vi: 'Đồng bộ cân', en: 'Scale sync' },
    mo_ta: { vi: 'Đưa mã cân, tên, giá bán/kg của Mặt hàng sang cân in tem qua USB. Kho là gốc.',
             en: 'Send the scale codes, names and sale prices/kg from Items to the label-printing scale by USB. Inventory is the source.' },
    hien: k.duoc('danh_muc') },
  { link: '/noi-bo/kho/cai-dat/quyen', ten: { vi: 'Ai làm được gì', en: 'Who can do what' },
    mo_ta: { vi: 'Bảng từng vai (chủ, quản lý, kế toán, thủ kho, NV quầy) làm được việc gì, ai thấy giá tiền.',
             en: 'A table of what each role (owner, manager, accountant, storekeeper, counter staff) can do, and who sees prices.' },
    hien: true },
  laChu
    ? { link: '/noi-bo/kho/cai-dat/nhan-vien', ten: { vi: 'Nhân viên & máy dùng chung', en: 'Staff & shared tablets' },
        mo_ta: { vi: 'Tạo tài khoản cho thủ kho, NV quầy/bếp, kế toán, máy tính bảng. Khóa người nghỉ việc. Xem ai đã gắn vào máy, mở khóa máy.',
                 en: 'Create accounts for storekeepers, counter/kitchen staff, the accountant and tablets. Lock people who have left. See who is linked to a tablet, unlock tablets.' },
        hien: true }
    : { link: '/noi-bo/kho/cai-dat/nhan-vien', ten: { vi: 'Máy dùng chung', en: 'Shared tablets' },
        mo_ta: { vi: 'Máy tính bảng ở quầy/bếp: ai đã gắn, ai bị khóa vì sai PIN. Mở khóa, tắt máy.',
                 en: 'Tablets at the counter/kitchen: who is linked, who is locked out after a wrong PIN. Unlock, turn a tablet off.' },
        hien: k.duoc('duyet') },
].filter(m => m.hien);

// Máy dùng chung bật khi Worker có bí mật KHO_MAY_KHOA (GĐ5d). Chỉ quản lý, chủ cần biết.
// Gói máy tính bảng cho trangThaiMayChung trả thêm cauEn; bản cũ chưa có thì hiện câu tiếng Việt.
const mayChung: { bat: boolean; cau: string; cauEn?: string } | null =
  k.duoc('duyet') ? trangThaiMayChung(await docBiMatMay()) : null;
---
<Kho k={k} huongDan="thiet-lap" tieuDe={t.tieuDe}>
  <h1>{t.tieuDe}</h1>
  <p class="kho-phu" style="margin-top:0">{t.gioiThieu}</p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {k.chiNhanh && !k.daKhoiTao && k.duoc('danh_muc') && (
    <form method="POST" class="nb-the">
      <input type="hidden" name="viec" value="khoi_tao" />
      <p style="margin-top:0"><strong>{t.chuaBatDau(k.chiNhanh.ten)}</strong>{t.bamTaoSan}</p>
      <button type="submit" class="nb-nut">{t.batDauDung}</button>
    </form>
  )}

  {loiTienDo && <div class="nb-bao loi" role="alert"><p>{dichCau(nn, loiTienDo)}</p></div>}

  {tienDo && (
    <section class="nb-the" aria-labelledby="tien-do">
      <h2 id="tien-do" style="margin-top:0">{cauConLai(tienDo, nn)}</h2>
      <div class="tl-thanh" role="progressbar" aria-valuemin="0" aria-valuemax={tienDo.tong}
        aria-valuenow={tienDo.tong - tienDo.conLai} aria-label={t.ariaDaXong}>
        <span style={`width:${phanTramXong(tienDo)}%`}></span>
      </div>
      <p class="kho-phu" style="margin:.4rem 0 0">{t.daXong(tienDo.tong - tienDo.conLai, tienDo.tong)}</p>

      <ol class="tl-ds">
        {tienDo.buoc.map((b, i) => {
          const link = linkBuocCuaVai(b.khoa, vai, nn);
          const boQuaDuoc = coTheBoQua(b, vai);
          return (
            <li id={`buoc-${b.khoa}`} class={`tl-buoc ${b.boQua ? 'bo-qua' : b.xong ? 'xong' : 'chua'}`}>
              <span class="tl-so" aria-hidden="true">{b.xong ? '✓' : i + 1}</span>
              <div class="tl-noi-dung">
                <p class="tl-ten">
                  <strong>{b.ten}</strong>{' '}
                  <span class={`nb-nhan ${b.boQua ? 'tat' : b.xong ? 'song' : 'cho'}`}>{b.boQua ? t.nhanBoQua : b.xong ? t.nhanXong : t.nhanChuaXong}</span>
                </p>
                <p class="kho-phu tl-mo-ta">{moTaBuoc(b, nn)}</p>
                {(link.length > 0 || boQuaDuoc) && (
                  <div class="tl-nut">
                    {link.map(l => (
                      <a class={`nb-nut ${b.xong ? 'phu' : ''}`} href={l.link}>{b.xong ? l.ten : (link.length === 1 ? t.lamBuocNay : l.ten)}</a>
                    ))}
                    {boQuaDuoc && (!b.xong || b.boQua) && (
                      <form method="POST">
                        <input type="hidden" name="viec" value="bo_qua" />
                        <input type="hidden" name="buoc" value={b.khoa} />
                        <input type="hidden" name="bo_qua" value={b.boQua ? 'khong' : 'co'} />
                        <button type="submit" class="nb-nut phu">{chuNutBoQua(b.khoa, b.boQua, nn)}</button>
                      </form>
                    )}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  <h2>{t.danhMuc}</h2>
  {MUC.map(m => (
    <a href={m.link} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
      <div class="nb-dong-dau"><strong>{m.ten[nn]}</strong><span aria-hidden="true">›</span></div>
      <p class="kho-phu" style="margin:.35rem 0 0">{m.mo_ta[nn]}</p>
    </a>
  ))}

  {mayChung && (
    <section class="nb-the" id="may-chung">
      <h2 style="margin-top:0">{t.mayDungChung}</h2>
      <p style="margin:0">
        <span class={`nb-nhan ${mayChung.bat ? 'song' : 'cho'}`}>{mayChung.bat ? t.daBat : t.chuaBat}</span>{' '}
        {nn === 'en' ? (mayChung.cauEn ?? mayChung.cau) : mayChung.cau}
      </p>
      {mayChung.bat ? (
        <ol class="kho-phu" style="margin:.75rem 0 0;padding-left:1.25rem">
          <li>{t.may1a}<a href="/noi-bo/kho/cai-dat/nhan-vien">{t.nvMay}</a>.</li>
          <li>{t.may2a}<strong>/noi-bo/kho/may/dang-ky</strong>{t.may2b}</li>
          <li>{t.may3}</li>
          <li>{t.may4}</li>
        </ol>
      ) : (
        <>
          <p style="margin:.75rem 0 .35rem"><strong>{t.cachBat}</strong>{t.cachBat2}</p>
          <ol class="kho-phu" style="margin:0;padding-left:1.25rem">
            <li>{t.bat1}<code>openssl rand -base64 32</code>.</li>
            <li>Cloudflare → Workers &amp; Pages → <strong>beeftown</strong> → Settings → Variables and Secrets → Add →
              {t.bat2Loai}<strong>Secret</strong>{t.bat2Ten}<code>KHO_MAY_KHOA</code>{t.bat2Dan} {t.bat2Hoac}<code>npx wrangler secret put KHO_MAY_KHOA</code>.)</li>
            <li>{t.bat3}</li>
          </ol>
          <p class="kho-phu" style="margin:.5rem 0 0">{t.chuaBatVanChay}</p>
        </>
      )}
    </section>
  )}

  {caiDat && k.duoc('danh_muc') && (
    <>
      <h2>{t.caiDatChung} — {k.chiNhanh?.ten}</h2>
      <form method="POST" class="nb-the">
        <input type="hidden" name="viec" value="chung" />
        <input type="hidden" name="mau_ma_vach" value={caiDat.mau_ma_vach ?? ''} />
        <input type="hidden" name="so_le_kg" value={String(caiDat.so_le_kg)} />
        <label class="nb-o">
          <span>{t.hangNhapVao}</span>
          <select name="vi_tri_nhan_hang_id">
            {viTri.filter(v => v.loai === 'kho' && v.dang_dung).map(v => (
              <option value={v.id} selected={v.id === caiDat!.vi_tri_nhan_hang_id}>{v.ten}</option>
            ))}
          </select>
        </label>
        <label class="nb-o">
          <span>{t.canhBaoTruoc}</span>
          <small>{t.canhBaoGoiY}</small>
          <input type="text" inputmode="numeric" name="canh_bao_truoc_ngay" value={String(caiDat.canh_bao_truoc_ngay)} />
        </label>
        <button type="submit" class="nb-nut">{t.luuCaiDatChung}</button>
      </form>

      {caiDatQuay && (
        <>
          <h2>{t.mangRaQuay}</h2>
          <form method="POST" class="nb-the">
            <input type="hidden" name="viec" value="nhan_quay" />
            <label class="kho-tich"><input type="checkbox" name="chuyen_quay_can_nhan" value="co" checked={caiDatQuay.chuyen_quay_can_nhan} />
              <span><strong>{t.quayPhaiNhan}</strong>{t.quayPhaiNhanGoiY}</span></label>
            <p class="kho-phu" style="margin:.25rem 0 .75rem">{t.quaGio(caiDatQuay.gio_nhac_chuyen)}</p>
            <button type="submit" class="nb-nut">{t.luu}</button>
          </form>
        </>
      )}
    </>
  )}

  {caiDat && (
    <>
      <h2 id="gia-von">{t.giaVon}</h2>
      {k.duoc('cai_dat_goc') ? (
        <form method="POST" class="nb-the">
          <input type="hidden" name="viec" value="goc" />
          <fieldset class="nb-o" style="border:0;padding:0;margin:0 0 1rem">
            <legend style="font-weight:600;font-size:.88rem;margin-bottom:.35rem">{t.chiaTheoLegend}</legend>
            <label class="kho-tich"><input type="radio" name="phuong_phap_gia_von" value="gia_tri" checked={caiDat.phuong_phap_gia_von === 'gia_tri'} />
              <span><strong>{t.giaTriBanDam}</strong>{t.giaTriBanGoiY}</span></label>
            <label class="kho-tich"><input type="radio" name="phuong_phap_gia_von" value="khoi_luong" checked={caiDat.phuong_phap_gia_von === 'khoi_luong'} />
              <span><strong>{t.khoiLuongDam}</strong>{t.khoiLuongGoiY}</span></label>
          </fieldset>
          <label class="kho-tich"><input type="checkbox" name="chi_phi_vao_gia_von" value="co" checked={caiDat.chi_phi_vao_gia_von} />
            <span>{t.chiPhiKhac}</span></label>
          <label class="kho-tich"><input type="checkbox" name="vat_vao_gia_von" value="co" checked={caiDat.vat_vao_gia_von} />
            <span>{t.vat}</span></label>
          <fieldset class="nb-o" style="border:0;padding:0;margin:0 0 1rem">
            <legend style="font-weight:600;font-size:.88rem;margin-bottom:.35rem">{t.nguonLegend}</legend>
            <label class="kho-tich"><input type="radio" name="nguon_so_ban" value="kiem_ke" checked={caiDat.nguon_so_ban === 'kiem_ke'} />
              <span><strong>{t.kiemKeDam}</strong>{t.kiemKeGoiY}</span></label>
            <label class="kho-tich"><input type="radio" name="nguon_so_ban" value="ipos" checked={caiDat.nguon_so_ban === 'ipos'} />
              <span><strong>iPOS</strong>{t.iposGoiY1}<a href="/noi-bo/kho/cai-dat/ipos">{t.iposNut}</a>{t.iposGoiY2}</span></label>
          </fieldset>
          <label class="kho-tich"><input type="checkbox" name="cho_tu_duyet" value="co" checked={caiDat.cho_tu_duyet} />
            <span>{t.tuDuyet}</span></label>
          <p class="kho-phu" style="margin:.25rem 0 .75rem">{t.xemXongLuu}</p>
          <button type="submit" class="nb-nut">{t.luu}</button>
        </form>
      ) : (
        <div class="nb-the">
          <p style="margin:0">{t.chiaTheo}<strong>{caiDat.phuong_phap_gia_von === 'gia_tri' ? t.giaTriBan : t.khoiLuong}</strong>{t.chiPhiVat(caiDat.chi_phi_vao_gia_von, caiDat.vat_vao_gia_von)}<strong>{caiDat.nguon_so_ban === 'ipos' ? 'iPOS' : t.kiemKeQuay}</strong>{t.chiChuDoi}</p>
        </div>
      )}
    </>
  )}

  {nguong && (
    <>
      <h2 id="nguong">{t.nguong}</h2>
      {k.duoc('danh_muc') ? (
        <form method="POST" class="nb-the">
          <input type="hidden" name="viec" value="nguong" />
          <p class="kho-phu" style="margin-top:0">{t.nguongGoiY}
            {nguong.luu_luc ? t.luuLanCuoi(dinhDangThoiDiem(nguong.luu_luc)) : t.dangMacDinh}</p>
          {Object.entries(TEN_NGUONG_NB).map(([khoa, ng]) => (
            <label class="nb-o">
              <span>{ng.ten[nn]} ({ng.don_vi[nn]})</span>
              <small>{ng.goi_y[nn]}{KHOANG_NGUONG[khoa] ? t.tuDen(KHOANG_NGUONG[khoa][0], KHOANG_NGUONG[khoa][1]) : ''}</small>
              <input type="text" inputmode="decimal" name={khoa} value={oNguong(khoa)} />
            </label>
          ))}
          <button type="submit" class="nb-nut">{t.luuNguong}</button>
        </form>
      ) : (
        <div class="nb-the">
          <ul style="margin:0;padding-left:1.2rem">
            {Object.entries(TEN_NGUONG_NB).map(([khoa, ng]) => (
              <li>{ng.ten[nn]}: <strong>{hienSoNguong(nguong!.gia_tri[khoa], nn) || '—'} {ng.don_vi[nn]}</strong></li>
            ))}
          </ul>
          <p class="kho-phu" style="margin:.5rem 0 0">{t.quanLyDoi}</p>
        </div>
      )}
    </>
  )}
</Kho>

<style>
  /* Thanh tiến độ: phần đã xong tô xanh. */
  .tl-thanh { height: 12px; border-radius: 999px; background: var(--kem-sau); overflow: hidden; }
  .tl-thanh > span { display: block; height: 100%; background: var(--xanh); border-radius: 999px; }
  .tl-ds { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .6rem; }
  .tl-buoc { display: flex; gap: .75rem; padding: .75rem; border: 1px solid var(--vach); border-radius: 10px; background: var(--nb-the); }
  .tl-buoc.chua { border-color: var(--mu-tat); }
  .tl-buoc.xong, .tl-buoc.bo-qua { opacity: .85; }
  .tl-so { flex: 0 0 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; font-weight: 700;
    background: var(--kem-sau); color: var(--muc-nhat); }
  .tl-buoc.xong .tl-so { background: var(--xanh); color: var(--kem); }
  .tl-noi-dung { flex: 1; min-width: 0; }
  .tl-ten { margin: 0; }
  .tl-mo-ta { margin: .25rem 0 0; }
  .tl-nut { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
  .tl-nut form { margin: 0; }
  .tl-nut .nb-nut { min-height: 48px; }
</style>

