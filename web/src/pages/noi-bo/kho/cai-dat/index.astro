                 en: 'Applies to items without their own setting. 1 = "expiring soon" from the day before the use-by date.' },
  luuCaiDatChung: { vi: 'Lưu cài đặt chung', en: 'Save general settings' },
  mangRaQuay: { vi: 'Mang hàng ra quầy', en: 'Bringing goods to the counter' },
  quayPhaiNhan: { vi: 'Quầy phải bấm nhận hàng', en: 'The counter must confirm receipt' },
  quayPhaiNhanGoiY: { vi: ' — hàng thủ kho mang ra chỉ vào quầy khi nhân viên quầy kiểm và bấm "Đã nhận". Nhận thiếu thì báo quản lý. Tắt: hàng vào thẳng quầy ngay khi thủ kho lập phiếu. Nhân viên quầy tự lấy hàng thì luôn vào thẳng quầy.',
                      en: ' — goods the storekeeper brings out only go into counter stock when counter staff check them and press "Received". If anything is short, the manager is alerted. Off: goods go straight into the counter as soon as the storekeeper makes the slip. When counter staff fetch goods themselves, they always go straight in.' },
  quaGio: {
    vi: (n: number) => `Quá ${n} giờ mà quầy chưa bấm nhận thì phần mềm nhắc (tô đỏ).`,
    en: (n: number) => `If the counter has not confirmed after ${n} ${s(n, 'hour', 'hours')}, the software sends a reminder (in red).`,
  },
  luu: { vi: 'Lưu', en: 'Save' },
  giaVon: { vi: 'Cách tính giá vốn và số bán', en: 'Costing method and sales figures' },
