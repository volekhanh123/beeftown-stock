const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const laChu = k.nhanSu.vai_tro === 'chu_so_huu';
const vai = k.nhanSu.vai_tro;
if (!k.duoc('danh_muc') && !k.duoc('ncc') && !k.duoc('cai_dat_goc')) return Astro.redirect('/noi-bo/kho', 302);
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tieuDe: { vi: 'Thiết lập kho', en: 'Inventory setup' },
  gioiThieu: { vi: 'Làm lần lượt các bước dưới đây trước ngày bắt đầu dùng kho thật. Bước nào không cần cho quán mình thì bấm "Bỏ qua". Các cài đặt (trước đây ở "Cài đặt kho") nằm bên dưới.',
               en: 'Work through the steps below, in order, before the day you start using inventory for real. If a step is not needed for your restaurant, press "Skip". The settings (previously under "Inventory settings") are further down.' },
