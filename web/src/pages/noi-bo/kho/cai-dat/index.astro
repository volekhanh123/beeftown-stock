    vi: (a: boolean, b: boolean) => `; chi phí khác ${a ? 'có' : 'không'} vào giá vốn; VAT ${b ? 'có' : 'không'} vào giá vốn; số bán lấy từ `,
    en: (a: boolean, b: boolean) => `; other costs are ${a ? '' : 'not '}added to the cost; VAT is ${b ? '' : 'not '}added to the cost; sales figures come from `,
  },
