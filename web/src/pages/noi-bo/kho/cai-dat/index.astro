  giaTriBanDam: { vi: 'Giá trị bán', en: 'Sale value' },
  giaTriBanGoiY: { vi: ' (khuyên dùng) — phần bán đắt gánh nhiều giá vốn hơn. Cần nhập giá bán/kg cho phần cắt.',
                   en: ' (recommended) — cuts that sell for more carry more of the cost. Needs a sale price/kg for each cut.' },
  khoiLuongDam: { vi: 'Khối lượng', en: 'Weight' },
  khoiLuongGoiY: { vi: ' — mọi phần cùng giá vốn/kg.', en: ' — every cut gets the same cost/kg.' },
  chiPhiKhac: { vi: 'Cộng chi phí khác của phiếu nhập (vận chuyển, bốc xếp) vào giá vốn',
                en: 'Add the other costs of a goods receipt (transport, handling) to the cost' },
  vat: { vi: 'Cộng thuế VAT đầu vào vào giá vốn (bật khi quán KHÔNG được khấu trừ VAT — hỏi kế toán)',
         en: 'Add input VAT to the cost (turn on if the restaurant CANNOT deduct VAT — ask the accountant)' },
  nguonLegend: { vi: 'Số thịt đã bán ở quầy lấy từ đâu', en: 'Where the counter sales figures come from' },
  kiemKeDam: { vi: 'Kiểm kê quầy cuối ngày', en: 'End-of-day counter count' },
  kiemKeGoiY: { vi: ' — chưa nối iPOS: phần thiếu khi đếm quầy được tính là đã bán.',
                en: ' — iPOS not connected: whatever is missing at the counter count is treated as sold.' },
  iposGoiY1: { vi: ' — đã nối iPOS: số bán đến từ máy tính tiền, phần thiếu khi kiểm kê là hao hụt thật. Chuyển bằng nút ',
               en: ' — iPOS connected: sales come from the till, and anything missing at a stocktake is a real loss. Switch with the ' },
  iposNut: { vi: 'Chuyển sang trừ kho theo iPOS', en: 'Switch to deducting stock from iPOS' },
  iposGoiY2: { vi: ' để đặt luôn mốc chuyển — chọn ở đây thì kho chưa trừ theo iPOS cho tới khi có mốc.',
               en: ' button, which also sets the switch-over point — choosing it here does not deduct stock by iPOS until that point is set.' },
  tuDuyet: { vi: 'Cho quản lý tự duyệt phiếu do chính mình lập (quán nhỏ nên bật; người duyệt luôn được ghi lại)',
             en: 'Let managers approve documents they created themselves (worth turning on for a small restaurant; the approver is always recorded)' },
  xemXongLuu: { vi: 'Xem xong thì bấm Lưu, kể cả khi không đổi gì — bước "Cách tính giá vốn" của Thiết lập sẽ tính là xong.',
                en: 'When you have checked it, press Save, even if nothing changed — the "Costing method" setup step then counts as done.' },
  chiaTheo: { vi: 'Chia giá vốn theo ', en: 'Cost is split by ' },
  giaTriBan: { vi: 'giá trị bán', en: 'sale value' },
  khoiLuong: { vi: 'khối lượng', en: 'weight' },
