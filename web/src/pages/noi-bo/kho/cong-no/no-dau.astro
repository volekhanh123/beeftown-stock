---
/**
 * KHO — NỢ ĐẦU KỲ (GĐ5e, migration 0035)
 *
 * Kế toán ghi MỘT LẦN số tiền quán còn nợ từng nhà cung cấp lúc bắt đầu dùng
 * phần mềm. Mỗi nhà cung cấp thành một phiếu ND- (không hàng, không lô, không
 * sổ kho): vào công nợ như phiếu nhập đã đối chiếu, trả tiền ở trang công nợ
 * của nhà cung cấp (tự chia theo hạn sớm nhất trước).
 *
 *   · Lưới: mỗi nhà cung cấp đang dùng một dòng — Số tiền, Hạn trả (bỏ trống =
 *     hôm nay + số ngày được nợ), Số hóa đơn, Ghi chú. Nhà cung cấp đã ghi thì
 *     hiện số phiếu, không gõ lại được.
 *   · Dán từ Excel (Nhà cung cấp, Số tiền, Hạn, Số hóa đơn, Ghi chú) → điền
 *     vào lưới và xem trước luôn.
 *   · "Xem trước" chỉ kiểm; "Ghi nợ đầu kỳ" gửi lại đúng các dòng đó (ô ẩn)
 *     kèm ma_gui — bấm hai lần / F5 không ghi đôi.
 *   · Ghi nhầm: hủy phiếu (có lý do) rồi ghi lại — chỉ khi chưa trả tiền.
 *   · Không có nợ nào: nút "Không có nợ đầu kỳ" đánh dấu bước này của màn
 *     Thiết lập là xong (kho_danh_dau_thiet_lap).
 *
 * Chỉ vai kế toán (kế toán, quản lý, chủ) — cùng quyền với trang Công nợ.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import {
  docNccNoDau, docNoDauKy, docFormNoDau, docDanNoDau, xemTruocNoDau, ghiNoDauKy, huyNoDauKy,
  docBuocNoDau, danhDauKhongNoDau,
  type NccNoDau, type CongNoPhieu, type ONoDau, type XemTruocNoDau, type BuocNoDau,
} from '../../../../lib/kho/cong-no.ts';
import { cauLoiKho, congNgay, dinhDangNgay, dinhDangTien, homNayVn, type KetQua } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('ke_toan')) {
  return chuyenHuong(Astro, '/noi-bo/kho', { ok: false, cau: 'Nợ đầu kỳ do kế toán hoặc quản lý ghi.' });
}
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const DUONG = '/noi-bo/kho/cong-no/no-dau';

let ncc: NccNoDau[] = [];
let daCo: CongNoPhieu[] = [];
let buoc: BuocNoDau | null = null;
let loiDoc = k.loiDoc;
try {
  [ncc, daCo, buoc] = await Promise.all([
    docNccNoDau(k.client), docNoDauKy(k.client, cn.id), docBuocNoDau(k.client, cn.id),
  ]);
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được nhà cung cấp và nợ đầu kỳ.');
}
/** Nhà cung cấp → số phiếu ND- còn hiệu lực. */
const daGhi = new Map(daCo.map(p => [p.nha_cung_cap_id, p.so_phieu]));

let bao: KetQua | null = k.bao;
let giaTri: Record<string, ONoDau> = {};
let xemTruoc: XemTruocNoDau | null = null;
let danLai = '';
let loiDan: string[] = [];
let boQuaDan: string[] = [];
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'xem_truoc' || viec === 'ghi') {
    giaTri = docFormNoDau(form);
    if (loiDoc) bao = { ok: false, cau: 'Chưa đọc được danh sách nhà cung cấp — tải lại trang rồi làm lại.' };
    else {
      const xt = xemTruocNoDau(ncc, giaTri, daGhi);
      if (Object.keys(giaTri).length === 0) bao = { ok: false, cau: 'Chưa ghi số tiền ở nhà cung cấp nào.' };
      else if (viec === 'ghi' && xt.loi.length === 0) {
        const kq = await ghiNoDauKy(k.client, cn.id, String(form.get('ma_gui') ?? ''), xt.dong);
        if (kq.ok) return chuyenHuong(Astro, DUONG, kq);
        bao = kq;
        xemTruoc = xt;
      } else xemTruoc = xt;
    }
  } else if (viec === 'dan') {
    danLai = String(form.get('noi_dung') ?? '');
    if (loiDoc) bao = { ok: false, cau: 'Chưa đọc được danh sách nhà cung cấp — tải lại trang rồi làm lại.' };
    else if (!danLai.trim()) bao = { ok: false, cau: 'Ô dán đang trống — chọn các ô trong Excel, sao chép rồi dán vào.' };
    else {
      const d = docDanNoDau(danLai, ncc);
      loiDan = d.loi;
      boQuaDan = d.boQua;
      giaTri = d.giaTri;
      if (loiDan.length === 0) {
        xemTruoc = xemTruocNoDau(ncc, giaTri, daGhi);
        danLai = '';
      } else bao = { ok: false, cau: `Bảng dán còn ${loiDan.length} lỗi — xem bên dưới. Các dòng đọc được đã điền vào lưới.` };
    }
  } else if (viec === 'huy') {
    return chuyenHuong(Astro, DUONG, await huyNoDauKy(k.client, String(form.get('phieu_id') ?? ''), String(form.get('ly_do') ?? '')));
  } else if (viec === 'khong_no' || viec === 'bo_danh_dau') {
    return chuyenHuong(Astro, DUONG, await danhDauKhongNoDau(k.client, cn.id, viec === 'khong_no'));
  } else {
    bao = { ok: false, cau: 'Việc không hợp lệ.' };
  }
}

const homNay = homNayVn();
const nccDung = ncc.filter(n => n.dang_dung);
const chuaGhi = nccDung.filter(n => !daGhi.has(n.id));
const tenNcc = new Map(ncc.map(n => [n.id, n]));
const tongDaGhi = daCo.reduce((s, p) => s + p.phai_tra, 0);
const choXacNhan = !!xemTruoc && xemTruoc.loi.length === 0 && xemTruoc.dong.length > 0;
const o = (id: string): ONoDau => giaTri[id] ?? { tien: '', han: '', hd: '', gc: '' };
/** Hạn database sẽ tự đặt khi bỏ trống. */
const hanTuDong = (n: NccNoDau | undefined) => congNgay(homNay, n?.so_ngay_no ?? 0);
---
<Kho k={k} tieuDe="Nợ đầu kỳ" rong>
  <h1>Nợ đầu kỳ</h1>
  <p><a href="/noi-bo/kho/cong-no">← Công nợ nhà cung cấp</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <div class="nb-dan">
    <p style="margin-top:0">Ghi <strong>một lần</strong> số tiền quán còn nợ từng nhà cung cấp tính tới hôm bắt đầu dùng phần mềm
      (xem sổ công nợ cũ hoặc hỏi nhà cung cấp). Sau đó trả tiền ở trang công nợ của nhà cung cấp như phiếu nhập bình thường.</p>
    <p style="margin-bottom:0">Nợ đầu kỳ chỉ là số tiền — không có hàng, không vào tồn kho.</p>
  </div>

  {daCo.length === 0 && buoc && (
    buoc.bo_qua ? (
      <form method="POST" class="nb-the">
        <input type="hidden" name="viec" value="bo_danh_dau" />
        <p style="margin-top:0"><strong>Đã đánh dấu: không có nợ đầu kỳ.</strong> Bước này trong Thiết lập đã xong.</p>
        <button type="submit" class="nb-nut phu">Bỏ đánh dấu (thật ra có nợ)</button>
      </form>
    ) : (
      <form method="POST" class="nb-the">
        <input type="hidden" name="viec" value="khong_no" />
        <p style="margin-top:0">Quán không nợ nhà cung cấp nào lúc bắt đầu? Bấm nút dưới để đánh dấu bước này xong.</p>
        <button type="submit" class="nb-nut phu">Không có nợ đầu kỳ</button>
      </form>
    )
  )}

  {xemTruoc && (
    <section class="nb-the" aria-labelledby="xem-truoc">
      <h2 id="xem-truoc" style="margin-top:0">Xem trước</h2>
      {xemTruoc.loi.length > 0 && (
        <div class="nb-bao loi" role="alert">
          <p><strong>Chưa ghi được.</strong> Sửa những chỗ này trong lưới bên dưới rồi bấm "Xem trước" lại:</p>
          <ul style="margin:.5rem 0 0;padding-left:1.2rem">{xemTruoc.loi.slice(0, 30).map(l => <li>{l}</li>)}</ul>
          {xemTruoc.loi.length > 30 && <p>… và {xemTruoc.loi.length - 30} lỗi khác.</p>}
        </div>
      )}
      {xemTruoc.dong.length > 0 && (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>Nhà cung cấp</th><th class="so">Số tiền nợ</th><th>Hạn trả</th><th>Số hóa đơn · ghi chú</th></tr></thead>
            <tbody>
              {xemTruoc.dong.map(d => (
                <tr>
                  <td><strong>{d.ten}</strong></td>
                  <td class="so"><strong>{dinhDangTien(d.so_tien)}</strong></td>
                  <td>{d.han_thanh_toan
                    ? dinhDangNgay(d.han_thanh_toan)
                    : <>{dinhDangNgay(hanTuDong(tenNcc.get(d.nha_cung_cap_id)))}<br /><span class="kho-phu">tự tính: hôm nay + {tenNcc.get(d.nha_cung_cap_id)?.so_ngay_no ?? 0} ngày</span></>}</td>
                  <td>{[d.so_hoa_don, d.ghi_chu].filter(Boolean).join(' · ') || '—'}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="tong"><td>Tổng {xemTruoc.dong.length} nhà cung cấp</td><td class="so">{dinhDangTien(xemTruoc.tong)}</td><td colspan="2"></td></tr>
            </tfoot>
          </table>
        </div>
      )}
      {choXacNhan ? (
        <form method="POST" class="kho-thanh-nut dinh">
          <input type="hidden" name="viec" value="ghi" />
          <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
          <input type="hidden" name="so_dong" value={String(xemTruoc.dong.length)} />
          {xemTruoc.dong.map((d, i) => (
            <>
              <input type="hidden" name={`n${i}_ncc`} value={d.nha_cung_cap_id} />
              <input type="hidden" name={`n${i}_tien`} value={String(d.so_tien)} />
              <input type="hidden" name={`n${i}_han`} value={d.han_thanh_toan ?? ''} />
              <input type="hidden" name={`n${i}_hd`} value={d.so_hoa_don ?? ''} />
              <input type="hidden" name={`n${i}_gc`} value={d.ghi_chu ?? ''} />
            </>
          ))}
          <button type="submit" class="nb-nut">Ghi nợ đầu kỳ ({dinhDangTien(xemTruoc.tong)})</button>
          <a class="nb-nut phu" href="#luoi">Sửa lại</a>
        </form>
      ) : (
        <p style="margin-bottom:0"><a href="#luoi">Sửa lại trong lưới ↓</a></p>
      )}
    </section>
  )}

  {daCo.length > 0 && (
    <>
      <h2>Đã ghi ({daCo.length} nhà cung cấp · {dinhDangTien(tongDaGhi)})</h2>
      {daCo.map(p => {
        const daTraTien = p.da_tra > 0 || p.giam_tru > 0;
        return (
          <div class="nb-dong">
            <div class="nb-dong-dau">
              <strong><a href={`/noi-bo/kho/cong-no/${p.nha_cung_cap_id}#p-${p.id}`}>{p.ten_nha_cung_cap}</a> · {p.so_phieu}</strong>
              <span class="nb-nhan nhap">Nợ đầu kỳ</span>
            </div>
            <dl>
              <dt>Số tiền nợ</dt><dd class="kho-so"><strong>{dinhDangTien(p.phai_tra)}</strong></dd>
              <dt>Hạn trả</dt><dd>{dinhDangNgay(p.han_thanh_toan)}{p.so_hoa_don && <> · hóa đơn {p.so_hoa_don}</>}</dd>
              <dt>Còn nợ</dt><dd class="kho-so">{p.con_no < 0 ? `−${dinhDangTien(-p.con_no)}` : dinhDangTien(p.con_no)}{p.da_tra > 0 && <span class="kho-phu"> · đã trả {dinhDangTien(p.da_tra)}</span>}</dd>
            </dl>
            {daTraTien ? (
              <p class="kho-phu" style="margin:.25rem 0 0">Đã trả tiền / giảm trừ nên không hủy được. Ghi nhầm thì hủy các khoản trả ở trang công nợ của nhà cung cấp trước.</p>
            ) : (
              <details>
                <summary style="cursor:pointer;font-size:.9rem;color:var(--muc-nhat);padding:.8rem 0">Hủy (ghi nhầm)</summary>
                <form method="POST">
                  <input type="hidden" name="viec" value="huy" />
                  <input type="hidden" name="phieu_id" value={p.id} />
                  <label class="nb-o"><span>Lý do</span><input type="text" name="ly_do" required maxlength="500" placeholder="ví dụ: ghi nhầm số tiền" /></label>
                  <button type="submit" class="nb-nut kho-nut-xoa">Hủy nợ đầu kỳ {p.so_phieu}</button>
                </form>
              </details>
            )}
          </div>
        );
      })}
    </>
  )}

  <h2 id="luoi" style="scroll-margin-top:5rem">Ghi nợ từng nhà cung cấp</h2>
  {nccDung.length === 0 ? (
    <p class="nb-rong">Chưa có nhà cung cấp nào. Thêm ở <a href="/noi-bo/kho/cai-dat/nha-cung-cap">Cài đặt › Nhà cung cấp</a> trước.</p>
  ) : chuaGhi.length === 0 ? (
    <p class="nb-rong">Mọi nhà cung cấp đang dùng đã có nợ đầu kỳ.</p>
  ) : (
    <form method="POST">
      <input type="hidden" name="viec" value="xem_truoc" />
      <input type="hidden" name="so_dong" value={String(chuaGhi.length)} />
      <p class="kho-phu" style="margin-top:0">Nhà cung cấp không nợ thì để trống ô số tiền. Hạn trả bỏ trống = hôm nay + số ngày được nợ của nhà cung cấp.</p>
      {chuaGhi.map((n, i) => {
        const g = o(n.id);
        return (
          <div class="kho-dong-hang">
            <input type="hidden" name={`n${i}_ncc`} value={n.id} />
            <p style="margin:0 0 .4rem"><strong>{n.ten}</strong>{n.ma_so_thue && <span class="kho-phu"> · MST {n.ma_so_thue}</span>}</p>
            <div class="kho-luoi">
              <label class="nb-o"><span>Số tiền còn nợ</span>
                <input type="text" inputmode="numeric" name={`n${i}_tien`} value={g.tien} placeholder="ví dụ 12.500.000" /></label>
              <label class="nb-o"><span>Hạn trả</span>
                <small>Trống = {dinhDangNgay(hanTuDong(n))} ({n.so_ngay_no} ngày)</small>
                <input type="date" name={`n${i}_han`} value={g.han} /></label>
            </div>
            <details open={!!g.hd || !!g.gc}>
              <summary>Thêm: số hóa đơn, ghi chú</summary>
              <div class="kho-luoi">
                <label class="nb-o"><span>Số hóa đơn</span>
                  <input type="text" name={`n${i}_hd`} value={g.hd} maxlength="60" autocapitalize="characters" /></label>
                <label class="nb-o"><span>Ghi chú</span>
                  <input type="text" name={`n${i}_gc`} value={g.gc} maxlength="500" placeholder="ví dụ: theo biên bản đối chiếu 30/09" /></label>
              </div>
            </details>
          </div>
        );
      })}
      {/* Đang có bản xem trước thì thanh dính dưới đáy là nút Ghi — nút này thôi dính. */}
      <div class={choXacNhan ? 'kho-thanh-nut' : 'kho-thanh-nut dinh'}>
        <button type="submit" class={choXacNhan ? 'nb-nut phu' : 'nb-nut'}>Xem trước</button>
      </div>
    </form>
  )}

  {chuaGhi.length > 0 && (
    <details class="nb-the" id="dan-excel" open={!!danLai} style="margin-top:1.5rem">
      <summary style="cursor:pointer;font-weight:700">Dán từ Excel</summary>
      {loiDan.length > 0 && (
        <div class="nb-bao loi" role="alert" style="margin-top:1rem">
          <p><strong>Bảng dán còn lỗi.</strong> Sửa trong ô dán rồi bấm lại:</p>
          <ul style="margin:.5rem 0 0;padding-left:1.2rem">{loiDan.slice(0, 30).map(l => <li>{l}</li>)}</ul>
          {loiDan.length > 30 && <p>… và {loiDan.length - 30} lỗi khác.</p>}
        </div>
      )}
      {boQuaDan.length > 0 && <p class="kho-phu">Bỏ qua cột không hiểu: {boQuaDan.join(', ')}.</p>}
      <form method="POST" style="margin-top:1rem">
        <input type="hidden" name="viec" value="dan" />
        <div class="nb-dan" style="font-size:.88rem">
          <p>Trong Excel chọn các ô (nên chọn cả <strong>dòng tiêu đề</strong>), sao chép rồi dán vào đây. Tiêu đề hiểu được:{' '}
            <strong>Nhà cung cấp · Số tiền · Hạn trả · Số hóa đơn · Ghi chú</strong>. Không có dòng tiêu đề thì cột theo đúng thứ tự đó.</p>
          <p style="margin-bottom:0">Nhà cung cấp ghi tên (như trong danh mục, có dấu hay không đều được) hoặc mã số thuế.
            Hạn trả ghi dạng 31/10/2026. Dán xong các số được điền vào lưới và hiện bản xem trước — chưa ghi gì cho tới khi bấm "Ghi nợ đầu kỳ".</p>
        </div>
        <label class="nb-o">
          <span>Nội dung dán</span>
          <textarea name="noi_dung" rows="6" placeholder={'Nhà cung cấp\tSố tiền\tHạn trả\nCông ty Thịt Bò Úc\t12500000\t31/10/2026'}>{danLai}</textarea>
        </label>
        <button type="submit" class="nb-nut phu">Điền vào lưới và xem trước</button>
      </form>
    </details>
  )}
</Kho>
