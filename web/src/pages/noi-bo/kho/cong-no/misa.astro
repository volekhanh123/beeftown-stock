---
/**
 * KHO — XUẤT SANG MISA (GĐ8b, migration 0040) · /noi-bo/kho/cong-no/misa
 *
 * Chọn kỳ + loại (mua hàng / thanh toán) → xem trước bảng (đúng cột của file,
 * COT_MISA trong lib/kho/misa.ts), số dòng thiếu mã MISA (link sửa NCC, ô sửa
 * mã mặt hàng ngay tại đây) → tải CSV (/noi-bo/kho/cong-no/misa.csv, UTF-8 BOM,
 * dấu ; hoặc ,). Thẻ "Mã tài khoản" sửa các TK mặc định (kho_luu_misa_tk).
 *
 * Chưa có file mẫu nhập khẩu của MISA — cột, tên cột, cách ghi ngày / số gom
 * ở COT_MISA và DINH_DANG_MISA ("CHỈNH KHI CÓ FILE MẪU"). Chỉ vai kế toán.
 *
 * Hai thứ tiếng: FILE MISA luôn tiếng Việt (misa.ts, misa.csv.ts — theo mẫu của
 * MISA). Màn tiếng Anh dịch phần giao diện: tên cột xem trước có thêm tên cột
 * thật của file (tiếng Việt) bên dưới; ô dữ liệu xem trước giữ đúng nội dung
 * file, chỉ đổi cách ghi số.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import {
  docDuLieuMisa, docMisaTk, luuMisaTk, luuMaMisaMatHang, docMaMisaDanhMuc,
} from '../../../../lib/kho/cong-no.ts';
import {
  COT_MISA, TEN_LOAI_MISA, TEN_TK_MISA, docBoLocMisa, docFormMisaTk, docMaMisa, oXemMisa, thieuMaMisa, tomTatMisa,
  type CotMisa, type DongMisa, type LoaiMisa,
} from '../../../../lib/kho/misa.ts';
import { cauLoiKho, dinhDangNgay, dinhDangTien, homNayVn, kqHai, type HaiThuTieng, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('ke_toan')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const nn = k.nn;
const cn = k.chiNhanh;
const homNay = homNayVn();
const sp = Astro.url.searchParams;
const loc = docBoLocMisa(sp, homNay);
const DUONG = '/noi-bo/kho/cong-no/misa';
const giuQ = `${DUONG}?tu=${loc.tu}&den=${loc.den}&loai=${loc.loai}${loc.ngan === ',' ? '&ngan=phay' : ''}`;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
/** Câu báo của trang — cả hai thứ tiếng đi theo câu báo (KetQua.cauEn). */
const CAU = {
  mangDut: {
    vi: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.',
    en: 'Could not read what was sent — the connection may have dropped. Please send it again.',
  },
  maSai: {
    vi: 'Mã MISA chỉ gồm chữ không dấu, số và các dấu _ . / - (tối đa 40 ký tự).',
    en: 'A MISA code may only contain unaccented letters, digits and _ . / - (up to 40 characters).',
  },
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
/** Tên tài khoản (TEN_TK_MISA của misa.ts) ở tiếng Anh, theo khóa. */
const TEN_TK_EN: Record<string, string> = {
  tk_no_hang: 'Goods account (debit on purchase)',
  tk_thue: 'Deductible input VAT account',
  tk_co_ncc: 'Supplier payables account',
  tk_tien_mat: 'Cash account',
  tk_ngan_hang: 'Bank deposit account',
  tk_bu_tru: 'Offset account (money the supplier owes the restaurant)',
};
const tenTk = (khoa: string, tenVi: string) => (nn === 'en' ? TEN_TK_EN[khoa] ?? tenVi : tenVi);
/** Tên cột của file (COT_MISA) ở tiếng Anh, theo khóa — chỉ để hiện; file giữ tên tiếng Việt. */
const TEN_COT_EN: Record<string, string> = {
  ngay_chung_tu: 'Document date', so_chung_tu: 'Document no.', so_hoa_don: 'Invoice no.', ngay_hoa_don: 'Invoice date',
  ma_ncc: 'Supplier code', ten_ncc: 'Supplier name', ma_so_thue: 'Tax code', dien_giai: 'Description',
  ma_hang: 'Item code', ten_hang: 'Item name', dvt: 'Unit', so_luong: 'Quantity', don_gia: 'Unit price',
  thanh_tien: 'Amount', thue_suat: 'VAT %', tien_thue: 'VAT amount', tk_no: 'Debit account', tk_co: 'Credit account',
  tk_thue: 'VAT account', ten_loai: 'Type', ten_hinh_thuc: 'Method',
};
/** Ô xem trước: đúng nội dung file (oXemMisa); màn tiếng Anh ghi số kiểu Anh (1,234 · 3.5). */
const oXem = (d: DongMisa, c: CotMisa) => {
  const o = oXemMisa(d, c);
  if (nn !== 'en') return o;
  if (c.kieu === 'tien') return o.replace(/\./g, ',');
  return c.kieu === 'so' || c.kieu === 'phan_tram' ? o.replace(',', '.') : o;
};
const t = dichNB(nn, {
  tieuDe: { vi: 'Xuất sang MISA', en: 'Export to MISA' },
  veCongNo: { vi: '← Công nợ', en: '← Payables' },
  khongDoc: { vi: 'Không đọc được dữ liệu MISA.', en: 'Could not read the MISA data.' },
  tuNgay: { vi: 'Từ ngày', en: 'From' },
  denNgay: { vi: 'Đến ngày', en: 'To' },
  loaiDuLieu: { vi: 'Loại dữ liệu', en: 'Data type' },
  loaiMuaHang: { vi: TEN_LOAI_MISA.mua_hang, en: 'Purchases (goods receipts)' },
  loaiThanhToan: { vi: TEN_LOAI_MISA.thanh_toan, en: 'Payments, deductions, offsets, refunds' },
  nganCot: { vi: 'Ngăn cột bằng', en: 'Column separator' },
  chamPhay: { vi: 'Dấu ; (Excel tiếng Việt)', en: 'Semicolon ; (Vietnamese Excel)' },
  phay: { vi: 'Dấu , (Excel tiếng Anh)', en: 'Comma , (English Excel)' },
  xemTruoc: { vi: 'Xem trước', en: 'Preview' },
  dongChungTu: {
    vi: (_a: number, b: number) => `dòng · ${b} chứng từ`,
    en: (a: number, b: number) => `${s(a, 'line', 'lines')} · ${b} ${s(b, 'document', 'documents')}`,
  },
  tienHang: { vi: 'tiền hàng và chi phí (chưa thuế)', en: 'goods and costs (before tax)' },
  tongSoTien: { vi: 'tổng số tiền', en: 'total amount' },
  tienThue: { vi: 'tiền thuế', en: 'tax' },
  dongThieuMa: { vi: (_n: number) => 'dòng thiếu mã MISA', en: (n: number) => `${s(n, 'line', 'lines')} missing a MISA code` },
  taiCsv: { vi: (a: string, b: string) => `Tải file CSV (${a}–${b})`, en: (a: string, b: string) => `Download CSV file (${a}–${b})` },
  moExcel: {
    vi: 'Mở bằng Excel, soát lại, lưu thành .xlsx nếu MISA đòi, rồi nhập khẩu vào MISA. Lưu ý: Excel tự bỏ số 0 ở đầu mã số thuế, số hóa đơn (0012345 thành 12345) — nếu có, mở bằng Excel → Dữ liệu → Từ văn bản/CSV và chọn kiểu Văn bản cho các cột đó.',
    en: 'Open it in Excel, check it, save it as .xlsx if MISA needs that, then import it into MISA. Note: Excel drops leading zeros from tax codes and invoice numbers (0012345 becomes 12345) — if you have those, open the file via Excel → Data → From Text/CSV and set those columns to Text.',
  },
  rongMua: { vi: 'Không có phiếu nhập mua nào được duyệt trong kỳ này.', en: 'No approved purchase receipts in this period.' },
  rongTt: { vi: 'Không có khoản trả tiền nào trong kỳ này.', en: 'No payments in this period.' },
  dongDau: { vi: (a: number, b: number) => ` (${a} dòng đầu / ${b})`, en: (a: number, b: number) => ` (first ${a} of ${b} lines)` },
  nenVang: {
    vi: 'Dòng nền vàng: thiếu mã MISA của nhà cung cấp hoặc mặt hàng (file vẫn xuất, cột cuối đánh dấu "x").',
    en: 'Yellow lines: the supplier or item has no MISA code (the file is still exported, with an "x" in the last column).',
  },
  maThieu: { vi: 'Mã MISA còn thiếu', en: 'Missing MISA codes' },
  daDuMa: { vi: 'Mọi nhà cung cấp và mặt hàng trong kỳ này đã có mã MISA.', en: 'Every supplier and item in this period has a MISA code.' },
  nhaCungCap: { vi: 'Nhà cung cấp', en: 'Suppliers' },
  nccThieu: {
    vi: ' — thiếu mã thì file dùng mã số thuế (hoặc mã tạm "NCC-…"):',
    en: ' — without a code, the file uses the tax code (or a temporary "NCC-…" code):',
  },
  bamGhiMa: { vi: ' — bấm để ghi "Mã nhà cung cấp bên MISA"', en: ' — click to add its MISA supplier code' },
  matHang: { vi: 'Mặt hàng', en: 'Items' },
  mhThieu: { vi: ' — thiếu mã thì file dùng mã trong kho:', en: ' — without a code, the file uses the inventory code:' },
  maTrongKho: { vi: (ma: string) => `mã trong kho ${ma}`, en: (ma: string) => `inventory code ${ma}` },
  maMisa: { vi: 'Mã MISA', en: 'MISA code' },
  luuMa: { vi: 'Lưu mã', en: 'Save code' },
  maTkMacDinh: { vi: 'Mã tài khoản mặc định', en: 'Default account codes' },
  dungChoCot: {
    vi: 'Dùng cho cột TK Nợ / TK Có của file. Sửa theo hệ thống tài khoản quán đang dùng trong MISA.',
    en: 'Used for the debit / credit account columns of the file. Change them to match the chart of accounts the restaurant uses in MISA.',
  },
  macDinh: { vi: (x: string) => `Mặc định ${x}`, en: (x: string) => `Default ${x}` },
  luuMaTk: { vi: 'Lưu mã tài khoản', en: 'Save account codes' },
});
const TEN_LOAI: Record<LoaiMisa, string> = { mua_hang: t.loaiMuaHang, thanh_toan: t.loaiThanhToan };

let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = kqHai(false, CAU.mangDut);
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'luu_tk') {
    const f = docFormMisaTk(form);
    if (f.loi.length) {
      // misa.ts (file cho MISA) chỉ viết lỗi tiếng Việt, mỗi lỗi mở đầu bằng tên tài khoản — dựng bản tiếng Anh theo tên đó.
      const loiEn = f.loi.map(l => {
        const tk = TEN_TK_MISA.find(([, ten]) => l.startsWith(`${ten}:`));
        return tk ? `${TEN_TK_EN[tk[0]] ?? tk[1]}: an account code is 3 to 10 digits (for example 331)` : l;
      });
      bao = { ok: false, cau: f.loi.join(' · '), cauEn: loiEn.join(' · ') };
    } else return chuyenHuong(Astro, `${giuQ}#tai-khoan`, await luuMisaTk(k.client, cn.id, f.tk));
  } else if (viec === 'ma_hang') {
    const ma = docMaMisa(form.get('ma_misa'));
    if (ma === undefined) bao = kqHai(false, CAU.maSai);
    else return chuyenHuong(Astro, `${giuQ}#thieu-ma`, await luuMaMisaMatHang(k.client, String(form.get('mat_hang_id') ?? ''), ma));
  } else {
    bao = kqHai(false, CAU.viecSai);
  }
}

let dong: DongMisa[] = [];
let tk: Record<string, string> = {};
let thieu: ReturnType<typeof thieuMaMisa> = { ncc: [], matHang: [] };
let loiDoc = k.loiDoc;
try {
  const [d, maTk, dm] = await Promise.all([
    docDuLieuMisa(k.client, cn.id, loc.tu, loc.den, loc.loai),
    docMisaTk(k.client, cn.id),
    docMaMisaDanhMuc(k.client),
  ]);
  dong = d; tk = maTk;
  thieu = thieuMaMisa(dong, dm.ncc, dm.matHang);
} catch (e) {
  loiDoc = cauLoiKho(e, t.khongDoc);
}
const tt = tomTatMisa(dong);
const cot = COT_MISA[loc.loai];
const XEM = 50;
const linkTai = `/noi-bo/kho/cong-no/misa.csv?tu=${loc.tu}&den=${loc.den}&loai=${loc.loai}${loc.ngan === ',' ? '&ngan=phay' : ''}`;
---
<Kho k={k} huongDan="misa" tieuDe={t.tieuDe} rong>
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/cong-no">{t.veCongNo}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <form method="GET" action={DUONG} class="nb-the">
    <div class="kho-luoi">
      <label class="nb-o"><span>{t.tuNgay}</span><input type="date" name="tu" value={loc.tu} max={homNay} /></label>
      <label class="nb-o"><span>{t.denNgay}</span><input type="date" name="den" value={loc.den} max={homNay} /></label>
      <label class="nb-o"><span>{t.loaiDuLieu}</span>
        <select name="loai">
          {(Object.keys(TEN_LOAI_MISA) as LoaiMisa[]).map(l => <option value={l} selected={loc.loai === l}>{TEN_LOAI[l]}</option>)}
        </select></label>
      <label class="nb-o"><span>{t.nganCot}</span>
        <select name="ngan">
          <option value="cham_phay" selected={loc.ngan === ';'}>{t.chamPhay}</option>
          <option value="phay" selected={loc.ngan === ','}>{t.phay}</option>
        </select></label>
    </div>
    <button type="submit" class="nb-nut phu">{t.xemTruoc}</button>
  </form>

  <div class="kho-o-so-luoi">
    <div class="kho-o-so"><b>{tt.soDong}</b><span>{t.dongChungTu(tt.soDong, tt.soChungTu)}</span></div>
    <div class="kho-o-so"><b style="font-size:1.2rem">{dinhDangTien(tt.tongTien, nn)}</b><span>{loc.loai === 'mua_hang' ? t.tienHang : t.tongSoTien}</span></div>
    {loc.loai === 'mua_hang' && <div class="kho-o-so"><b style="font-size:1.2rem">{dinhDangTien(tt.tongThue, nn)}</b><span>{t.tienThue}</span></div>}
    <a href="#thieu-ma" class={`kho-o-so ${tt.soThieuMa > 0 ? 'luu-y' : ''}`}><b>{tt.soThieuMa}</b><span>{t.dongThieuMa(tt.soThieuMa)}</span></a>
  </div>

  <p style="display:flex;flex-wrap:wrap;gap:.5rem;align-items:center">
    <a class="nb-nut" href={linkTai} download>{t.taiCsv(dinhDangNgay(loc.tu), dinhDangNgay(loc.den))}</a>
    <span class="kho-phu">{t.moExcel}</span>
  </p>

  {dong.length === 0 ? (
    <p class="nb-rong">{loc.loai === 'mua_hang' ? t.rongMua : t.rongTt}</p>
  ) : (
    <>
      <h2>{t.xemTruoc}{dong.length > XEM ? t.dongDau(XEM, dong.length) : ''}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr>{cot.map(c => <th class={c.kieu === 'tien' || c.kieu === 'so' || c.kieu === 'phan_tram' ? 'so' : undefined}>{nn === 'en'
            ? <>{TEN_COT_EN[c.khoa] ?? c.ten}<br /><small class="kho-phu" lang="vi">{c.ten}</small></>
            : c.ten}</th>)}</tr></thead>
          <tbody>
            {dong.slice(0, XEM).map(d => (
              <tr style={d.thieu_ma ? 'background:var(--vang-nen)' : undefined}>
                {cot.map(c => <td class={c.kieu === 'tien' || c.kieu === 'so' || c.kieu === 'phan_tram' ? 'so' : undefined}>{oXem(d, c)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="kho-phu">{t.nenVang}</p>
    </>
  )}

  <section id="thieu-ma" style="scroll-margin-top:5rem">
    <h2>{t.maThieu}</h2>
    {thieu.ncc.length === 0 && thieu.matHang.length === 0 ? (
      <p class="nb-rong">{t.daDuMa}</p>
    ) : (
      <>
        {thieu.ncc.length > 0 && (
          <>
            <p><strong>{t.nhaCungCap}</strong>{t.nccThieu}</p>
            <ul>
              {thieu.ncc.map(n => <li><a href={`/noi-bo/kho/cai-dat/nha-cung-cap?sua=${n.id}`}>{n.ten}</a>{t.bamGhiMa}</li>)}
            </ul>
          </>
        )}
        {thieu.matHang.length > 0 && (
          <>
            <p><strong>{t.matHang}</strong>{t.mhThieu}</p>
            {thieu.matHang.map(m => (
              <form method="POST" class="kho-luoi" style="align-items:end">
                <input type="hidden" name="viec" value="ma_hang" />
                <input type="hidden" name="mat_hang_id" value={m.id} />
                <p style="margin:0 0 .9rem"><strong>{m.ten}</strong><br /><span class="kho-phu">{t.maTrongKho(m.ma)}</span></p>
                <label class="nb-o"><span>{t.maMisa}</span><input type="text" name="ma_misa" maxlength="40" autocapitalize="characters" required /></label>
                <button type="submit" class="nb-nut phu">{t.luuMa}</button>
              </form>
            ))}
          </>
        )}
      </>
    )}
  </section>

  <section id="tai-khoan" class="nb-the" style="margin-top:1.5rem;scroll-margin-top:5rem">
    <h2 style="margin-top:0">{t.maTkMacDinh}</h2>
    <p class="kho-phu">{t.dungChoCot}</p>
    <form method="POST">
      <input type="hidden" name="viec" value="luu_tk" />
      <div class="kho-luoi">
        {TEN_TK_MISA.map(([khoa, ten, macDinh]) => (
          <label class="nb-o"><span>{tenTk(khoa, ten)}</span><small>{t.macDinh(macDinh)}</small>
            <input type="text" inputmode="numeric" name={khoa} value={tk[khoa] ?? macDinh} maxlength="10" /></label>
        ))}
      </div>
      <button type="submit" class="nb-nut phu">{t.luuMaTk}</button>
    </form>
  </section>
</Kho>
