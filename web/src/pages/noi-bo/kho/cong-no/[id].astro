---
/**
 * KHO — CÔNG NỢ MỘT NHÀ CUNG CẤP (id = nha_cung_cap_id)
 *
 *   · các phiếu CÒN VIỆC (còn nợ, NCC nợ lại, hoặc chưa đối chiếu): phải trả,
 *     đã trả, còn nợ, hạn; đối chiếu hóa đơn ngay trên dòng; link trả hàng.
 *     ?phieu=tat_ca hiện cả phiếu đã xong (để sửa đối chiếu, trả hàng muộn);
 *   · ghi thanh toán / giảm trừ: để trống phần chia thì trả phiếu đến hạn
 *     sớm nhất trước; muốn trả đúng phiếu nào thì ghi số tiền ở phiếu đó;
 *   · lịch sử các khoản (30 khoản mới nhất, ?tat_ca=1 xem hết); ghi nhầm thì
 *     hủy (có lý do) rồi ghi lại.
 *
 * ?mo=<phiếu> mở sẵn ô đối chiếu của phiếu đó (link từ danh sách "Chưa đối
 * chiếu" ở trang Công nợ). Chỉ vai kế toán (kế toán, quản lý, chủ) mở được.
 *
 * GĐ5e: phiếu ND- (nợ đầu kỳ, 0035) nằm chung danh sách, nhãn "Nợ đầu kỳ":
 * không có trang phiếu nhập, không trả hàng, không đối chiếu (đã đối chiếu
 * sẵn lúc ghi). Trả tiền, tự chia theo hạn như phiếu mua.
 *
 * GĐ8b (0040): nút "Trả tiền" mở /cong-no/<id>/tra-tien (xem trước cách chia,
 * "Trả đủ", chuyển khoản / tiền mặt / bù trừ / NCC hoàn tiền / giảm trừ);
 * "Đối chiếu hóa đơn gộp" mở /cong-no/<id>/hoa-don-gop; "In biên bản đối
 * chiếu" mở /cong-no/<id>/doi-chieu. Phiếu thuộc hóa đơn gộp không đối chiếu
 * lẻ được (database chặn) — bỏ đối chiếu gộp ở đây (khi chưa trả tiền).
 * Số tài khoản vừa đổi trong 30 ngày → dòng đỏ nhắc gọi hỏi lại NCC; đọc nhật ký đổi tài khoản
 * lỗi → khối vàng "chưa kiểm được" (CanhBaoTaiKhoan, chung với màn Trả tiền).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import CanhBaoTaiKhoan from '../../../../components/kho/CanhBaoTaiKhoan.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import {
  docCongNoNcc, docCongNoPhieu, docThanhToan, docTenNccTrang, doiChieuHoaDon, huyThanhToan,
  docHoaDonGop, boDoiChieuGop, docCanhBaoTaiKhoan, tenKhoan, cauLoiCongNo,
  dinhDangLech, tienLech, laNoDau, type CongNoNcc, type CongNoPhieu, type ThanhToan, type HoaDonGop, type CanhBaoDoiTk,
} from '../../../../lib/kho/cong-no.ts';
import { linkAnh } from '../../../../lib/kho/anh.ts';
import {
  congNgay, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, homNayVn, laUuid, kqHai, type HaiThuTieng, type KetQua,
} from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
/** Câu báo của trang — cả hai thứ tiếng đi theo câu báo (KetQua.cauEn). */
const CAU = {
  quyen: { vi: 'Công nợ nhà cung cấp do kế toán hoặc quản lý xem.', en: 'Supplier payables are for the accountant or a manager.' },
  mangDut: {
    vi: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.',
    en: 'Could not read what was sent — the connection may have dropped. Please send it again.',
  },
  phieuSai: { vi: 'Phiếu không hợp lệ.', en: 'Invalid document.' },
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
if (!k.duoc('ke_toan')) {
  return chuyenHuong(Astro, '/noi-bo/kho', kqHai(false, CAU.quyen));
}
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nccId = Astro.params.id ?? '';

// Không có NCC → "Không tìm thấy"; đọc lỗi → "Không đọc được… Chưa ghi gì" (không giả là không có).
const docNcc = await docTenNccTrang(k.client, nccId, { dangGui: Astro.request.method === 'POST' });
if (!docNcc.ncc) return chuyenHuong(Astro, '/noi-bo/kho/cong-no', docNcc.bao);
const ncc = docNcc.ncc;

const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tieuDe: { vi: (ten: string) => `Công nợ · ${ten}`, en: (ten: string) => `Payables · ${ten}` },
  khongDoc: { vi: 'Không đọc được công nợ.', en: 'Could not read payables.' },
  nccNoLai: { vi: 'nhà cung cấp nợ lại', en: 'supplier owes the restaurant' },
  conNo: { vi: 'còn nợ', en: 'owed' },
  quaHan: { vi: 'quá hạn', en: 'overdue' },
  ngayDuocNo: { vi: (_n: number) => 'ngày được nợ', en: (n: number) => s(n, 'credit day', 'credit days') },
  chuyenKhoan: { vi: 'Chuyển khoản:', en: 'Bank transfer:' },
  traTien: { vi: 'Trả tiền', en: 'Pay' },
  doiChieuGop: { vi: 'Đối chiếu hóa đơn gộp', en: 'Reconcile a combined invoice' },
  inBienBan: { vi: 'In biên bản đối chiếu', en: 'Print reconciliation statement' },
  ghiNhanh: { vi: 'Ghi nhanh:', en: 'Quick entry:' },
  nhanhCk: { vi: 'chuyển khoản', en: 'bank transfer' },
  nhanhTm: { vi: 'tiền mặt', en: 'cash' },
  nhanhBt: { vi: 'bù trừ', en: 'offset' },
  nhanhGt: { vi: 'giảm trừ', en: 'deduction' },
  nhanhHt: { vi: 'NCC hoàn tiền', en: 'supplier refund' },
  hoaDonKieu: { vi: 'Hóa đơn:', en: 'Invoices:' },
  hdGop: { vi: 'gộp nhiều lần giao', en: 'one for several deliveries' },
  hdTungLan: { vi: 'mỗi lần giao một hóa đơn', en: 'one per delivery' },
  tatCaPhieu: { vi: 'Tất cả phiếu nhập', en: 'All goods receipts' },
  phieuConViec: { vi: 'Phiếu còn việc', en: 'Receipts needing action' },
  phieuConViecGiai: { vi: 'Phiếu còn nợ hoặc chưa đối chiếu hóa đơn.', en: 'Receipts still owed or not yet reconciled with an invoice.' },
  rongTatCa: {
    vi: 'Chưa có phiếu nhập mua hay nợ đầu kỳ nào của nhà cung cấp này.',
    en: 'This supplier has no purchase receipts or opening balance yet.',
  },
  rongXong: { vi: 'Không còn phiếu nào phải trả hay phải đối chiếu.', en: 'Nothing left to pay or reconcile.' },
  ghiNgay: { vi: 'ghi', en: 'recorded' },
  nhapNgay: { vi: 'nhập', en: 'received' },
  noDau: { vi: 'Nợ đầu kỳ', en: 'Opening balance' },
  hoaDonGop: { vi: 'Hóa đơn gộp', en: 'Combined invoice' },
  lechGiai: { vi: 'Tiền hóa đơn khác tổng phiếu nhập', en: 'The invoice amount differs from the goods receipt total' },
  lech: { vi: 'LỆCH', en: 'MISMATCH' },
  nccNoLaiNhan: { vi: 'NCC nợ lại', en: 'Supplier owes us' },
  daTraDu: { vi: 'Đã trả đủ', en: 'Paid in full' },
  quaHanNgay: { vi: (n: number) => `Quá hạn ${n} ngày`, en: (n: number) => `${n} ${s(n, 'day', 'days')} overdue` },
  hanNgay: { vi: (d: string) => `Hạn ${d}`, en: (d: string) => `Due ${d}` },
  hoaDon: { vi: 'Hóa đơn', en: 'Invoice' },
  khongGhi: { vi: 'không ghi', en: 'none recorded' },
  noDauNho: { vi: 'nợ đầu kỳ', en: 'opening balance' },
  phieuNho: { vi: 'phiếu', en: 'receipt' },
  chuaDoiChieu: { vi: 'chưa đối chiếu', en: 'not reconciled' },
  phaiTra: { vi: 'Phải trả', en: 'Payable' },
  daTra: { vi: 'Đã trả', en: 'Paid' },
  giamTruNho: { vi: 'giảm trừ', en: 'deductions' },
  tienTraNho: { vi: 'tiền trả', en: 'payments' },
  buTruNho: { vi: 'bù trừ', en: 'offsets' },
  nccHoanNho: { vi: 'NCC hoàn', en: 'supplier refunded' },
  conNoCot: { vi: 'Còn nợ', en: 'Owed' },
  ghiNham: { vi: 'Ghi nhầm? Hủy ở trang ', en: 'Entered by mistake? Cancel it on the ' },
  trangNoDau: { vi: 'Nợ đầu kỳ', en: 'Opening balances' },
  khiChuaTra: { vi: ' (khi chưa trả tiền).', en: ' page (only while nothing has been paid).' },
  traHangNcc: { vi: 'Trả hàng cho nhà cung cấp →', en: 'Return goods to the supplier →' },
  daDoiChieuGop: {
    vi: 'Đã đối chiếu theo hóa đơn gộp — muốn sửa thì bỏ đối chiếu hóa đơn đó ở mục ',
    en: 'Reconciled through a combined invoice — to change it, undo that invoice in the ',
  },
  mucHdGop: { vi: 'Hóa đơn gộp', en: 'Combined invoices' },
  hetCau: { vi: '.', en: ' section.' },
  suaDoiChieu: { vi: 'Sửa đối chiếu hóa đơn', en: 'Edit invoice reconciliation' },
  doiChieuHd: { vi: 'Đối chiếu hóa đơn', en: 'Reconcile invoice' },
  soHoaDon: { vi: 'Số hóa đơn', en: 'Invoice no.' },
  ngayHoaDon: { vi: 'Ngày hóa đơn', en: 'Invoice date' },
  tongTienHd: { vi: 'Tổng tiền in trên hóa đơn', en: 'Total printed on the invoice' },
  phieuNhapGoiY: {
    vi: (tien: string) => `Phiếu nhập: ${tien}. Ghi đúng số in trên hóa đơn.`,
    en: (tien: string) => `Goods receipt: ${tien}. Enter exactly what the invoice says.`,
  },
  viDuTien: { vi: 'ví dụ 5.450.000', en: 'e.g. 5,450,000' },
  hanThanhToan: { vi: 'Hạn thanh toán', en: 'Payment due date' },
  boTrongHan: {
    vi: (n: number) => `Bỏ trống = ngày hóa đơn + ${n} ngày`,
    en: (n: number) => `Empty = invoice date + ${n} ${s(n, 'day', 'days')}`,
  },
  ghiChu: { vi: 'Ghi chú', en: 'Note' },
  batBuocLech: {
    vi: 'Bắt buộc khi tiền hóa đơn khác phiếu nhập — ghi lý do lệch.',
    en: 'Required when the invoice differs from the goods receipt — give the reason.',
  },
  viDuGhiChu: { vi: 'ví dụ: NCC tính thêm phí giao hàng', en: 'e.g. the supplier added a delivery fee' },
  luuDoiChieu: { vi: 'Lưu đối chiếu', en: 'Save reconciliation' },
  chiXemConViec: { vi: 'Chỉ xem phiếu còn việc', en: 'Show only receipts needing action' },
  xemCaPhieuXong: {
    vi: (n: number) => `Xem cả ${n} phiếu đã xong (đã trả đủ, đã đối chiếu) →`,
    en: (n: number) => `Also show ${n} finished ${s(n, 'receipt', 'receipts')} (paid in full, reconciled) →`,
  },
  hd: { vi: 'HĐ', en: 'Inv.' },
  daBo: { vi: 'Đã bỏ', en: 'Undone' },
  dtPhieu: { vi: 'Phiếu', en: 'Receipts' },
  soPhieu: { vi: (n: number) => `${n} phiếu`, en: (n: number) => `${n} ${s(n, 'receipt', 'receipts')}` },
  tongPhieu: { vi: 'Tổng phiếu', en: 'Receipts total' },
  tienThue: { vi: 'Tiền thuế', en: 'Tax' },
  lyDoLech: { vi: 'Lý do lệch', en: 'Reason for difference' },
  lyDoBo: { vi: 'Lý do bỏ', en: 'Reason for undoing' },
  boDoiChieuHd: {
    vi: 'Bỏ đối chiếu hóa đơn này (chọn nhầm phiếu, sai số)',
    en: 'Undo this invoice reconciliation (wrong receipts, wrong amounts)',
  },
  chiBoDuoc: {
    vi: 'Chỉ bỏ được khi các phiếu chưa có khoản trả tiền, giảm trừ, bù trừ hay hoàn tiền nào. Các phiếu trở lại như trước khi đối chiếu.',
    en: 'Only possible while none of the receipts has a payment, deduction, offset or refund. The receipts go back to how they were before.',
  },
  lyDo: { vi: 'Lý do', en: 'Reason' },
  boDoiChieu: { vi: 'Bỏ đối chiếu', en: 'Undo reconciliation' },
  cacKhoan: { vi: 'Các khoản đã ghi', en: 'Recorded entries' },
  chuaCoKhoan: {
    vi: 'Chưa có khoản trả tiền, giảm trừ, bù trừ hay hoàn tiền nào.',
    en: 'No payments, deductions, offsets or refunds yet.',
  },
  daHuy: { vi: 'Đã hủy', en: 'Cancelled' },
  ngay: { vi: 'Ngày', en: 'Date' },
  ghiBoi: { vi: 'ghi bởi', en: 'recorded by' },
  chiaCho: { vi: 'Chia cho', en: 'Split across' },
  phieuTraHang: { vi: 'Phiếu trả hàng', en: 'Return slip' },
  xemHangTra: { vi: 'Xem hàng đã trả →', en: 'See returned goods →' },
  lyDoHuy: { vi: 'Lý do hủy', en: 'Reason for cancelling' },
  anhChungTu: { vi: 'Chứng từ thanh toán', en: 'Payment document' },
  huyKhoan: { vi: 'Hủy khoản này (ghi nhầm)', en: 'Cancel this entry (entered by mistake)' },
  huyKhoanNut: { vi: 'Hủy khoản', en: 'Cancel entry' },
  xemThem: {
    vi: (n: number) => `Xem thêm ${n} khoản cũ hơn`,
    en: (n: number) => `Show ${n} older ${s(n, 'entry', 'entries')}`,
  },
  veTatCa: { vi: '← Công nợ tất cả nhà cung cấp', en: '← Payables for all suppliers' },
});

const q = Astro.url.searchParams;
const tatCaPhieu = q.get('phieu') === 'tat_ca';
const tatCaKhoan = q.get('tat_ca') === '1';
const moPhieu = q.get('mo') ?? '';
/** Link về chính trang này, giữ các lựa chọn xem đang bật. */
const lienKet = (thay: Record<string, string | null> = {}, neo = '') => {
  const u = new URLSearchParams(q);
  u.delete('mo');
  for (const [khoa, gt] of Object.entries(thay)) {
    if (gt === null) u.delete(khoa); else u.set(khoa, gt);
  }
  const chuoi = u.toString();
  return `/noi-bo/kho/cong-no/${ncc.id}${chuoi ? `?${chuoi}` : ''}${neo}`;
};

let bao: KetQua | null = k.bao;
/** Phiếu vừa đối chiếu lỗi: mở lại ô đó với đúng những gì đã gõ. */
let doiChieuLoi: { phieuId: string; giaTri: Record<string, string> } | null = null;
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = kqHai(false, CAU.mangDut);
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  // Xong thì về đầu trang (không nhảy xuống neo) để thấy ngay câu báo xanh/đỏ.
  const ve = (kq: KetQua) => chuyenHuong(Astro, lienKet(), kq);
  if (viec === 'doi_chieu') {
    const id = String(form.get('phieu_id') ?? '');
    if (!laUuid(id)) bao = kqHai(false, CAU.phieuSai);
    else {
      const kq = await doiChieuHoaDon(k.client, id, form);
      if (kq.ok) return ve(kq);
      bao = kq;
      doiChieuLoi = { phieuId: id, giaTri: kq.giaTri ?? {} };
    }
  } else if (viec === 'bo_gop') {
    return ve(await boDoiChieuGop(k.client, String(form.get('hoa_don_id') ?? ''), String(form.get('ly_do') ?? '')));
  } else if (viec === 'huy_tt') {
    return ve(await huyThanhToan(k.client, String(form.get('thanh_toan_id') ?? ''), String(form.get('ly_do') ?? '').trim()));
  } else {
    bao = kqHai(false, CAU.viecSai);
  }
}

let tong: CongNoNcc | undefined;
let phieu: CongNoPhieu[] = [];
let thanhToan: ThanhToan[] = [];
let conNuaKhoan = 0;
let hoaDonGop: HoaDonGop[] = [];
let loiDoc = k.loiDoc;
// Đọc song song nhưng NGOÀI Promise.all dưới: không ném (nhật ký lỗi → chuaKiem, khối cảnh báo
// nói "chưa kiểm được"), và phần công nợ đọc lỗi cũng không làm mất cảnh báo đổi tài khoản.
const docCanhBao = docCanhBaoTaiKhoan(k.client, ncc.id);
try {
  const [dsTong, dsPhieu, tt, hd] = await Promise.all([
    docCongNoNcc(k.client, cn.id, ncc.id),
    docCongNoPhieu(k.client, cn.id, { nccId: ncc.id, conViec: !tatCaPhieu }),
    docThanhToan(k.client, cn.id, ncc.id, tatCaKhoan ? null : 30),
    docHoaDonGop(k.client, cn.id, ncc.id),
  ]);
  tong = dsTong[0];
  phieu = dsPhieu;
  thanhToan = tt.ds;
  conNuaKhoan = tt.conNua;
  hoaDonGop = hd;
} catch (e) {
  loiDoc = cauLoiCongNo(e, t.khongDoc, nn);
}
const canhBaoTk: CanhBaoDoiTk = await docCanhBao;
const homNay = homNayVn();
const tuanToi = congNgay(homNay, 7);
// Số tổng từ view gom theo nhà cung cấp — đúng dù danh sách chỉ hiện phiếu còn việc.
const conNo = tong?.con_no ?? 0;
const quaHan = tong?.no_qua_han ?? 0;
const soPhieuXong = Math.max((tong?.so_phieu ?? 0) - phieu.length, 0);
const ten = await tenNhanSu(k.client, thanhToan.map(x => x.nguoi_tao));
const anh = await linkAnh(k.client, thanhToan.flatMap(x => x.anh));
const soHdGop = new Map(hoaDonGop.filter(h => h.trang_thai === 'hieu_luc').map(h => [h.id, h.so_hoa_don]));
const coNoLai = (tong?.con_no ?? 0) < 0 || phieu.some(p => p.con_no < 0);
const TT = `/noi-bo/kho/cong-no/${ncc.id}/tra-tien`;
/** Số tiền điền sẵn vào ô nhập, theo cách ghi số của ngôn ngữ đang xem (docTien đọc được cả hai). */
const soO = (n: number) => n.toLocaleString(nn === 'en' ? 'en-US' : 'vi-VN');
---
<Kho k={k} huongDan="ghi-thanh-toan" tieuDe={t.tieuDe(ncc.ten)} rong>
  <h1>{ncc.ten}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <div class="kho-o-so-luoi">
    <div class={`kho-o-so ${conNo < 0 ? 'luu-y' : ''}`}><b style="font-size:1.25rem">{conNo < 0 ? `−${dinhDangTien(-conNo, nn)}` : dinhDangTien(conNo, nn)}</b><span>{conNo < 0 ? t.nccNoLai : t.conNo}</span></div>
    <div class={`kho-o-so ${quaHan > 0 ? 'gap' : ''}`}><b style="font-size:1.25rem">{dinhDangTien(quaHan, nn)}</b><span>{t.quaHan}</span></div>
    <div class="kho-o-so"><b>{ncc.so_ngay_no}</b><span>{t.ngayDuocNo(ncc.so_ngay_no)}</span></div>
  </div>
  {(ncc.ngan_hang || ncc.so_tai_khoan) && (
    <p class="nb-dan">{t.chuyenKhoan} <strong>{ncc.so_tai_khoan ?? '—'}</strong>{ncc.ngan_hang && ` · ${ncc.ngan_hang}`}</p>
  )}
  <CanhBaoTaiKhoan canhBao={canhBaoTk} />
  <div class="cn-nut" id="ghi-thanh-toan">
    <a class="nb-nut" href={TT}>{t.traTien}</a>
    <a class="nb-nut phu" href={`/noi-bo/kho/cong-no/${ncc.id}/hoa-don-gop`}>{t.doiChieuGop}</a>
    <a class="nb-nut phu" href={`/noi-bo/kho/cong-no/${ncc.id}/doi-chieu`}>{t.inBienBan}</a>
  </div>
  <p class="kho-phu" style="margin-top:-.5rem">
    {t.ghiNhanh}{' '}
    <a href={`${TT}?kieu=chuyen_khoan`}>{t.nhanhCk}</a> ·{' '}
    <a href={`${TT}?kieu=tien_mat`}>{t.nhanhTm}</a> ·{' '}
    <a href={`${TT}?kieu=bu_tru`}>{t.nhanhBt}</a> ·{' '}
    <a href={`${TT}?kieu=giam_tru`}>{t.nhanhGt}</a>
    {coNoLai && <> · <a href={`${TT}?kieu=hoan_tien`}><strong>{t.nhanhHt}</strong></a></>}
    {' '}· {t.hoaDonKieu} {ncc.kieu_hoa_don === 'gop' ? t.hdGop : t.hdTungLan}
  </p>

  <h2>{tatCaPhieu ? t.tatCaPhieu : t.phieuConViec}</h2>
  {!tatCaPhieu && <p class="kho-phu" style="margin-top:-.5rem">{t.phieuConViecGiai}</p>}
  {phieu.length === 0 ? (
    <p class="nb-rong">{tatCaPhieu || soPhieuXong === 0 ? t.rongTatCa : t.rongXong}</p>
  ) : phieu.map(p => {
    const lech = tienLech(p);
    const noDau = laNoDau(p);
    const loiO = doiChieuLoi?.phieuId === p.id ? doiChieuLoi.giaTri : null;
    const o = (khoa: string, macDinh: string) => loiO?.[khoa] ?? macDinh;
    return (
      <div class="nb-dong" id={`p-${p.id}`} style="scroll-margin-top:5rem">
        <div class="nb-dong-dau">
          {noDau
            ? <strong>{p.so_phieu} · {t.ghiNgay} {dinhDangNgay(p.ngay_nhap)}</strong>
            : <strong><a href={`/noi-bo/kho/nhap/${p.id}`}>{p.so_phieu}</a> · {t.nhapNgay} {dinhDangNgay(p.ngay_nhap)}</strong>}
          <span style="display:inline-flex;gap:.35rem;flex-wrap:wrap">
            {noDau && <span class="nb-nhan nhap" style="text-transform:none">{t.noDau}</span>}
            {p.hoa_don_gop_id && <span class="nb-nhan nhap" style="text-transform:none">{t.hoaDonGop} {soHdGop.get(p.hoa_don_gop_id) ?? ''}</span>}
            {lech !== 0 && <span class="nb-nhan cho" style="text-transform:none" title={t.lechGiai}>{t.lech} {dinhDangLech(lech, nn)}</span>}
            {p.con_no <= 0
              ? <span class="nb-nhan song">{p.con_no < 0 ? t.nccNoLaiNhan : t.daTraDu}</span>
              : p.qua_han
                ? <span class="nb-nhan tat">{t.quaHanNgay(p.so_ngay_qua_han)}</span>
                : <span class={`nb-nhan ${p.han_thanh_toan && p.han_thanh_toan <= tuanToi ? 'cho' : 'nhap'}`}>{t.hanNgay(dinhDangNgay(p.han_thanh_toan))}</span>}
          </span>
        </div>
        <dl>
          <dt>{t.hoaDon}</dt>
          <dd>{noDau
            ? <>{p.so_hoa_don ?? <span class="kho-phu">{t.khongGhi}</span>} · {t.noDauNho} <strong>{dinhDangTien(p.phai_tra, nn)}</strong></>
            : p.da_doi_chieu
            ? <>{p.so_hoa_don}{p.ngay_hoa_don && ` · ${dinhDangNgay(p.ngay_hoa_don)}`} · <strong>{dinhDangTien(p.tien_hoa_don, nn)}</strong>
                {lech !== 0 && <span class="kho-phu">{' '}({t.phieuNho} {dinhDangTien(p.tong_tien_phieu, nn)}{p.ghi_chu_doi_chieu ? ` — ${p.ghi_chu_doi_chieu}` : ''})</span>}</>
            : <span class="kho-phu">{t.chuaDoiChieu} · {t.phieuNho} {dinhDangTien(p.tong_tien_phieu, nn)}</span>}</dd>
          <dt>{t.phaiTra}</dt><dd class="kho-so">{dinhDangTien(p.phai_tra, nn)}</dd>
          <dt>{t.daTra}</dt><dd class="kho-so">{dinhDangTien(p.da_tra, nn)}{p.giam_tru > 0 && <> · {t.giamTruNho} {dinhDangTien(p.giam_tru, nn)}</>}
            {(p.bu_tru > 0 || p.hoan_tien > 0) && <span class="kho-phu">{' '}({t.tienTraNho} {dinhDangTien(p.tien_tra, nn)}{p.bu_tru > 0 ? ` · ${t.buTruNho} ${dinhDangTien(p.bu_tru, nn)}` : ''}{p.hoan_tien > 0 ? ` · ${t.nccHoanNho} ${dinhDangTien(p.hoan_tien, nn)}` : ''})</span>}</dd>
          <dt>{t.conNoCot}</dt><dd class="kho-so"><strong>{p.con_no < 0 ? `−${dinhDangTien(-p.con_no, nn)}` : dinhDangTien(p.con_no, nn)}</strong></dd>
        </dl>
        {noDau ? (
          <p class="kho-phu" style="margin:.25rem 0 0">{t.ghiNham}<a href="/noi-bo/kho/cong-no/no-dau">{t.trangNoDau}</a>{t.khiChuaTra}</p>
        ) : (
        <>
        <p style="margin:.25rem 0 0"><a href={`/noi-bo/kho/cong-no/tra-hang?phieu=${p.id}`}>{t.traHangNcc}</a></p>
        {p.hoa_don_gop_id ? (
          <p class="kho-phu" style="margin:.5rem 0 0">{t.daDoiChieuGop}<a href="#hoa-don-gop">{t.mucHdGop}</a>{t.hetCau}</p>
        ) : (
        <details open={loiO !== null || moPhieu === p.id}>
          <summary style="cursor:pointer;font-weight:600;padding:.8rem 0">{p.da_doi_chieu ? t.suaDoiChieu : t.doiChieuHd}</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="doi_chieu" />
            <input type="hidden" name="phieu_id" value={p.id} />
            <div class="kho-luoi">
              <label class="nb-o"><span>{t.soHoaDon}</span><input type="text" name="so_hoa_don" value={o('so_hoa_don', p.so_hoa_don ?? '')} required autocapitalize="characters" /></label>
              <label class="nb-o"><span>{t.ngayHoaDon}</span><input type="date" name="ngay_hoa_don" value={o('ngay_hoa_don', p.ngay_hoa_don ?? '')} max={homNay} /></label>
              <label class="nb-o"><span>{t.tongTienHd}</span>
                <small>{t.phieuNhapGoiY(dinhDangTien(p.tong_tien_phieu, nn))}</small>
                <input type="text" inputmode="numeric" name="tien_hoa_don" value={o('tien_hoa_don', p.tien_hoa_don !== null ? soO(p.tien_hoa_don) : '')} required placeholder={t.viDuTien} /></label>
              <label class="nb-o"><span>{t.hanThanhToan}</span><small>{t.boTrongHan(ncc.so_ngay_no)}</small><input type="date" name="han_thanh_toan" value={o('han_thanh_toan', '')} /></label>
            </div>
            <label class="nb-o"><span>{t.ghiChu}</span><small>{t.batBuocLech}</small>
              <input type="text" name="ghi_chu_doi_chieu" value={o('ghi_chu_doi_chieu', p.ghi_chu_doi_chieu ?? '')} maxlength="500" placeholder={t.viDuGhiChu} /></label>
            <button type="submit" class="nb-nut phu">{t.luuDoiChieu}</button>
          </form>
        </details>
        )}
        </>
        )}
      </div>
    );
  })}
  {tatCaPhieu
    ? <p><a href={lienKet({ phieu: null })}>{t.chiXemConViec}</a></p>
    : soPhieuXong > 0 && <p><a href={lienKet({ phieu: 'tat_ca' })}>{t.xemCaPhieuXong(soPhieuXong)}</a></p>}

  {hoaDonGop.length > 0 && (
    <section id="hoa-don-gop" style="scroll-margin-top:5rem">
      <h2>{t.mucHdGop}</h2>
      {hoaDonGop.map(h => (
        <div class="nb-dong" style={h.trang_thai === 'da_bo' ? 'opacity:.6' : ''}>
          <div class="nb-dong-dau">
            <strong>{t.hd} {h.so_hoa_don} · {dinhDangNgay(h.ngay)}</strong>
            <span class={`nb-nhan ${h.trang_thai === 'da_bo' ? 'tat' : 'song'}`}>{h.trang_thai === 'da_bo' ? t.daBo : dinhDangTien(h.tong_tien, nn)}</span>
          </div>
          <dl>
            <dt>{t.dtPhieu}</dt><dd>{h.phieu.length > 0 ? h.phieu.map(x => `${x.so_phieu ?? '?'}: ${dinhDangTien(x.so_tien, nn)}`).join(' · ') : t.soPhieu(h.so_phieu)}</dd>
            <dt>{t.tongPhieu}</dt><dd>{dinhDangTien(h.tong_phieu, nn)}{h.tong_tien !== h.tong_phieu && <> · <span class="nb-nhan cho" style="text-transform:none">{t.lech} {dinhDangLech(h.tong_tien - h.tong_phieu, nn)}</span></>}</dd>
            {h.tien_thue > 0 && <><dt>{t.tienThue}</dt><dd>{dinhDangTien(h.tien_thue, nn)}</dd></>}
            {h.ly_do_lech && <><dt>{t.lyDoLech}</dt><dd>{h.ly_do_lech}</dd></>}
            {h.ly_do_bo && <><dt>{t.lyDoBo}</dt><dd>{h.ly_do_bo}</dd></>}
          </dl>
          {h.trang_thai === 'hieu_luc' && (
            <details>
              <summary style="cursor:pointer;font-size:.85rem;color:var(--muc-nhat);padding:.8rem 0">{t.boDoiChieuHd}</summary>
              <form method="POST" style="margin-top:.5rem">
                <input type="hidden" name="viec" value="bo_gop" />
                <input type="hidden" name="hoa_don_id" value={h.id} />
                <p class="kho-phu">{t.chiBoDuoc}</p>
                <label class="nb-o"><span>{t.lyDo}</span><input type="text" name="ly_do" required maxlength="500" /></label>
                <button type="submit" class="nb-nut kho-nut-xoa">{t.boDoiChieu}</button>
              </form>
            </details>
          )}
        </div>
      ))}
    </section>
  )}

  <h2 id="cac-khoan" style="scroll-margin-top:5rem">{t.cacKhoan}</h2>
  {thanhToan.length === 0 ? (
    <p class="nb-rong">{t.chuaCoKhoan}</p>
  ) : thanhToan.map(kh => (
    <div class="nb-dong" style={kh.trang_thai === 'da_huy' ? 'opacity:.6' : ''}>
      <div class="nb-dong-dau">
        <strong>{kh.so_phieu} · {tenKhoan(kh, nn)}</strong>
        <span class={`nb-nhan ${kh.trang_thai === 'da_huy' ? 'tat' : 'song'}`}>{kh.trang_thai === 'da_huy' ? t.daHuy : dinhDangTien(kh.so_tien, nn)}</span>
      </div>
      <dl>
        <dt>{t.ngay}</dt><dd>{dinhDangNgay(kh.ngay)} · {t.ghiBoi} {ten.get(kh.nguoi_tao ?? '') ?? '—'} {dinhDangThoiDiem(kh.created_at)}</dd>
        <dt>{t.chiaCho}</dt><dd>{kh.phan_bo.map(x => `${x.so_phieu ?? '?'}: ${dinhDangTien(x.so_tien, nn)}`).join(' · ') || '—'}</dd>
        {kh.ghi_chu && <><dt>{t.ghiChu}</dt><dd>{kh.ghi_chu}</dd></>}
        {kh.phieu_xuat_id && <><dt>{t.phieuTraHang}</dt><dd><a href={`/noi-bo/kho/xuat/${kh.phieu_xuat_id}`}>{t.xemHangTra}</a></dd></>}
        {kh.ly_do_huy && <><dt>{t.lyDoHuy}</dt><dd>{kh.ly_do_huy}</dd></>}
      </dl>
      {kh.anh.length > 0 && (
        <div class="kho-anh">{kh.anh.map(a => anh.get(a) ? <a href={anh.get(a)} target="_blank" rel="noopener"><img src={anh.get(a)} alt={t.anhChungTu} loading="lazy" /></a> : <span class="kho-phu">{a.split('/').pop()}</span>)}</div>
      )}
      {kh.trang_thai === 'hieu_luc' && !kh.phieu_xuat_id && (
        <details>
          <summary style="cursor:pointer;font-size:.85rem;color:var(--muc-nhat);padding:.8rem 0">{t.huyKhoan}</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="huy_tt" />
            <input type="hidden" name="thanh_toan_id" value={kh.id} />
            <label class="nb-o"><span>{t.lyDo}</span><input type="text" name="ly_do" required maxlength="500" /></label>
            <button type="submit" class="nb-nut kho-nut-xoa">{t.huyKhoanNut}</button>
          </form>
        </details>
      )}
    </div>
  ))}
  {conNuaKhoan > 0 && (
    <p><a class="nb-nut phu" href={lienKet({ tat_ca: '1' }, '#cac-khoan')}>{t.xemThem(conNuaKhoan)}</a></p>
  )}

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/cong-no">{t.veTatCa}</a></p>
</Kho>

<style>
  .cn-nut { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1rem; scroll-margin-top: 5rem; }
</style>
