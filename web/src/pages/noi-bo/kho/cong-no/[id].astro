---
/**
 * KHO — CÔNG NỢ MỘT NHÀ CUNG CẤP (id = nha_cung_cap_id)
 *
 *   · các phiếu CÒN VIỆC (còn nợ, NCC nợ lại, hoặc chưa đối chiếu): phải trả,
 *     đã trả, còn nợ, hạn; đối chiếu hóa đơn ngay trên dòng; link trả hàng.
 *     ?phieu=tat_ca hiện cả phiếu đã xong (để sửa đối chiếu, trả hàng muộn);
 *   · ghi thanh toán / giảm trừ: để trống phần chia thì trả phiếu đến hạn
 *     sớm nhất trước; muốn trả đúng phiếu nào thì ghi số tiền ở phiếu đó;
 *   · lịch sử các khoản (30 khoản mới nhất, ?tat_ca=1 xem hết); ghi nhầm thì
 *     hủy (có lý do) rồi ghi lại.
 *
 * ?mo=<phiếu> mở sẵn ô đối chiếu của phiếu đó (link từ danh sách "Chưa đối
 * chiếu" ở trang Công nợ). Chỉ vai kế toán (kế toán, quản lý, chủ) mở được.
 *
 * GĐ5e: phiếu ND- (nợ đầu kỳ, 0035) nằm chung danh sách, nhãn "Nợ đầu kỳ":
 * không có trang phiếu nhập, không trả hàng, không đối chiếu (đã đối chiếu
 * sẵn lúc ghi). Trả tiền, tự chia theo hạn như phiếu mua.
 *
 * GĐ8b (0040): nút "Trả tiền" mở /cong-no/<id>/tra-tien (xem trước cách chia,
 * "Trả đủ", chuyển khoản / tiền mặt / bù trừ / NCC hoàn tiền / giảm trừ);
 * "Đối chiếu hóa đơn gộp" mở /cong-no/<id>/hoa-don-gop; "In biên bản đối
 * chiếu" mở /cong-no/<id>/doi-chieu. Phiếu thuộc hóa đơn gộp không đối chiếu
 * lẻ được (database chặn) — bỏ đối chiếu gộp ở đây (khi chưa trả tiền).
 * Số tài khoản vừa đổi trong 30 ngày → dòng đỏ nhắc gọi hỏi lại NCC.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import {
  docCongNoNcc, docCongNoPhieu, docThanhToan, docTenNcc, doiChieuHoaDon, huyThanhToan,
  docHoaDonGop, boDoiChieuGop, docNhatKyTaiKhoan, doiTaiKhoanGanDay, tenKhoan,
  dinhDangLech, tienLech, laNoDau, type CongNoNcc, type CongNoPhieu, type ThanhToan, type HoaDonGop, type DoiTaiKhoan,
} from '../../../../lib/kho/cong-no.ts';
import { linkAnh } from '../../../../lib/kho/anh.ts';
import { cauLoiKho, congNgay, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, homNayVn, laUuid, type KetQua } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('ke_toan')) {
  return chuyenHuong(Astro, '/noi-bo/kho', { ok: false, cau: 'Công nợ nhà cung cấp do kế toán hoặc quản lý xem.' });
}
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nccId = Astro.params.id ?? '';

const ncc = await docTenNcc(k.client, nccId);
if (!ncc) return chuyenHuong(Astro, '/noi-bo/kho/cong-no', { ok: false, cau: 'Không tìm thấy nhà cung cấp này.' });

const q = Astro.url.searchParams;
const tatCaPhieu = q.get('phieu') === 'tat_ca';
const tatCaKhoan = q.get('tat_ca') === '1';
const moPhieu = q.get('mo') ?? '';
/** Link về chính trang này, giữ các lựa chọn xem đang bật. */
const lienKet = (thay: Record<string, string | null> = {}, neo = '') => {
  const u = new URLSearchParams(q);
  u.delete('mo');
  for (const [khoa, gt] of Object.entries(thay)) {
    if (gt === null) u.delete(khoa); else u.set(khoa, gt);
  }
  const chuoi = u.toString();
  return `/noi-bo/kho/cong-no/${ncc.id}${chuoi ? `?${chuoi}` : ''}${neo}`;
};

let bao: KetQua | null = k.bao;
/** Phiếu vừa đối chiếu lỗi: mở lại ô đó với đúng những gì đã gõ. */
let doiChieuLoi: { phieuId: string; giaTri: Record<string, string> } | null = null;
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  // Xong thì về đầu trang (không nhảy xuống neo) để thấy ngay câu báo xanh/đỏ.
  const ve = (kq: KetQua) => chuyenHuong(Astro, lienKet(), kq);
  if (viec === 'doi_chieu') {
    const id = String(form.get('phieu_id') ?? '');
    if (!laUuid(id)) bao = { ok: false, cau: 'Phiếu không hợp lệ.' };
    else {
      const kq = await doiChieuHoaDon(k.client, id, form);
      if (kq.ok) return ve(kq);
      bao = kq;
      doiChieuLoi = { phieuId: id, giaTri: kq.giaTri ?? {} };
    }
  } else if (viec === 'bo_gop') {
    return ve(await boDoiChieuGop(k.client, String(form.get('hoa_don_id') ?? ''), String(form.get('ly_do') ?? '')));
  } else if (viec === 'huy_tt') {
    return ve(await huyThanhToan(k.client, String(form.get('thanh_toan_id') ?? ''), String(form.get('ly_do') ?? '').trim()));
  } else {
    bao = { ok: false, cau: 'Việc không hợp lệ.' };
  }
}

let tong: CongNoNcc | undefined;
let phieu: CongNoPhieu[] = [];
let thanhToan: ThanhToan[] = [];
let conNuaKhoan = 0;
let hoaDonGop: HoaDonGop[] = [];
let nhatKyTk: DoiTaiKhoan[] = [];
let loiDoc = k.loiDoc;
try {
  const [dsTong, dsPhieu, tt, hd, nk] = await Promise.all([
    docCongNoNcc(k.client, cn.id, ncc.id),
    docCongNoPhieu(k.client, cn.id, { nccId: ncc.id, conViec: !tatCaPhieu }),
    docThanhToan(k.client, cn.id, ncc.id, tatCaKhoan ? null : 30),
    docHoaDonGop(k.client, cn.id, ncc.id),
    docNhatKyTaiKhoan(k.client, ncc.id, 5).catch(() => [] as DoiTaiKhoan[]),
  ]);
  tong = dsTong[0];
  phieu = dsPhieu;
  thanhToan = tt.ds;
  conNuaKhoan = tt.conNua;
  hoaDonGop = hd;
  nhatKyTk = nk;
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được công nợ.');
}
const homNay = homNayVn();
const tuanToi = congNgay(homNay, 7);
// Số tổng từ view gom theo nhà cung cấp — đúng dù danh sách chỉ hiện phiếu còn việc.
const conNo = tong?.con_no ?? 0;
const quaHan = tong?.no_qua_han ?? 0;
const soPhieuXong = Math.max((tong?.so_phieu ?? 0) - phieu.length, 0);
const ten = await tenNhanSu(k.client, thanhToan.map(t => t.nguoi_tao));
const anh = await linkAnh(k.client, thanhToan.flatMap(t => t.anh));
const soHdGop = new Map(hoaDonGop.filter(h => h.trang_thai === 'hieu_luc').map(h => [h.id, h.so_hoa_don]));
const doiTk = doiTaiKhoanGanDay(nhatKyTk, Date.now());
const coNoLai = (tong?.con_no ?? 0) < 0 || phieu.some(p => p.con_no < 0);
const TT = `/noi-bo/kho/cong-no/${ncc.id}/tra-tien`;
---
<Kho k={k} huongDan="ghi-thanh-toan" tieuDe={`Công nợ · ${ncc.ten}`} rong>
  <h1>{ncc.ten}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <div class="kho-o-so-luoi">
    <div class={`kho-o-so ${conNo < 0 ? 'luu-y' : ''}`}><b style="font-size:1.25rem">{conNo < 0 ? `−${dinhDangTien(-conNo)}` : dinhDangTien(conNo)}</b><span>{conNo < 0 ? 'nhà cung cấp nợ lại' : 'còn nợ'}</span></div>
    <div class={`kho-o-so ${quaHan > 0 ? 'gap' : ''}`}><b style="font-size:1.25rem">{dinhDangTien(quaHan)}</b><span>quá hạn</span></div>
    <div class="kho-o-so"><b>{ncc.so_ngay_no}</b><span>ngày được nợ</span></div>
  </div>
  {(ncc.ngan_hang || ncc.so_tai_khoan) && (
    <p class="nb-dan">Chuyển khoản: <strong>{ncc.so_tai_khoan ?? '—'}</strong>{ncc.ngan_hang && ` · ${ncc.ngan_hang}`}</p>
  )}
  {doiTk && (
    <div class="nb-bao loi" role="alert"><p>
      Tài khoản ngân hàng vừa đổi lúc {dinhDangThoiDiem(doiTk.luc)}: {doiTk.so_tai_khoan_cu}{doiTk.ngan_hang_cu ? ` (${doiTk.ngan_hang_cu})` : ''} → <strong>{doiTk.so_tai_khoan_moi ?? '(trống)'}{doiTk.ngan_hang_moi ? ` (${doiTk.ngan_hang_moi})` : ''}</strong>.
      Gọi điện hỏi lại nhà cung cấp (số điện thoại cũ đã biết) trước khi chuyển tiền.
    </p></div>
  )}
  <div class="cn-nut" id="ghi-thanh-toan">
    <a class="nb-nut" href={TT}>Trả tiền</a>
    <a class="nb-nut phu" href={`/noi-bo/kho/cong-no/${ncc.id}/hoa-don-gop`}>Đối chiếu hóa đơn gộp</a>
    <a class="nb-nut phu" href={`/noi-bo/kho/cong-no/${ncc.id}/doi-chieu`}>In biên bản đối chiếu</a>
  </div>
  <p class="kho-phu" style="margin-top:-.5rem">
    Ghi nhanh:{' '}
    <a href={`${TT}?kieu=chuyen_khoan`}>chuyển khoản</a> ·{' '}
    <a href={`${TT}?kieu=tien_mat`}>tiền mặt</a> ·{' '}
    <a href={`${TT}?kieu=bu_tru`}>bù trừ</a> ·{' '}
    <a href={`${TT}?kieu=giam_tru`}>giảm trừ</a>
    {coNoLai && <> · <a href={`${TT}?kieu=hoan_tien`}><strong>NCC hoàn tiền</strong></a></>}
    {' '}· Hóa đơn: {ncc.kieu_hoa_don === 'gop' ? 'gộp nhiều lần giao' : 'mỗi lần giao một hóa đơn'}
  </p>

  <h2>{tatCaPhieu ? 'Tất cả phiếu nhập' : 'Phiếu còn việc'}</h2>
  {!tatCaPhieu && <p class="kho-phu" style="margin-top:-.5rem">Phiếu còn nợ hoặc chưa đối chiếu hóa đơn.</p>}
  {phieu.length === 0 ? (
    <p class="nb-rong">{tatCaPhieu || soPhieuXong === 0 ? 'Chưa có phiếu nhập mua hay nợ đầu kỳ nào của nhà cung cấp này.' : 'Không còn phiếu nào phải trả hay phải đối chiếu.'}</p>
  ) : phieu.map(p => {
    const lech = tienLech(p);
    const noDau = laNoDau(p);
    const loiO = doiChieuLoi?.phieuId === p.id ? doiChieuLoi.giaTri : null;
    const o = (khoa: string, macDinh: string) => loiO?.[khoa] ?? macDinh;
    return (
      <div class="nb-dong" id={`p-${p.id}`} style="scroll-margin-top:5rem">
        <div class="nb-dong-dau">
          {noDau
            ? <strong>{p.so_phieu} · ghi {dinhDangNgay(p.ngay_nhap)}</strong>
            : <strong><a href={`/noi-bo/kho/nhap/${p.id}`}>{p.so_phieu}</a> · nhập {dinhDangNgay(p.ngay_nhap)}</strong>}
          <span style="display:inline-flex;gap:.35rem;flex-wrap:wrap">
            {noDau && <span class="nb-nhan nhap" style="text-transform:none">Nợ đầu kỳ</span>}
            {p.hoa_don_gop_id && <span class="nb-nhan nhap" style="text-transform:none">Hóa đơn gộp {soHdGop.get(p.hoa_don_gop_id) ?? ''}</span>}
            {lech !== 0 && <span class="nb-nhan cho" style="text-transform:none" title="Tiền hóa đơn khác tổng phiếu nhập">LỆCH {dinhDangLech(lech)}</span>}
            {p.con_no <= 0
              ? <span class="nb-nhan song">{p.con_no < 0 ? 'NCC nợ lại' : 'Đã trả đủ'}</span>
              : p.qua_han
                ? <span class="nb-nhan tat">Quá hạn {p.so_ngay_qua_han} ngày</span>
                : <span class={`nb-nhan ${p.han_thanh_toan && p.han_thanh_toan <= tuanToi ? 'cho' : 'nhap'}`}>Hạn {dinhDangNgay(p.han_thanh_toan)}</span>}
          </span>
        </div>
        <dl>
          <dt>Hóa đơn</dt>
          <dd>{noDau
            ? <>{p.so_hoa_don ?? <span class="kho-phu">không ghi</span>} · nợ đầu kỳ <strong>{dinhDangTien(p.phai_tra)}</strong></>
            : p.da_doi_chieu
            ? <>{p.so_hoa_don}{p.ngay_hoa_don && ` · ${dinhDangNgay(p.ngay_hoa_don)}`} · <strong>{dinhDangTien(p.tien_hoa_don)}</strong>
                {lech !== 0 && <span class="kho-phu">{' '}(phiếu {dinhDangTien(p.tong_tien_phieu)}{p.ghi_chu_doi_chieu ? ` — ${p.ghi_chu_doi_chieu}` : ''})</span>}</>
            : <span class="kho-phu">chưa đối chiếu · phiếu {dinhDangTien(p.tong_tien_phieu)}</span>}</dd>
          <dt>Phải trả</dt><dd class="kho-so">{dinhDangTien(p.phai_tra)}</dd>
          <dt>Đã trả</dt><dd class="kho-so">{dinhDangTien(p.da_tra)}{p.giam_tru > 0 && <> · giảm trừ {dinhDangTien(p.giam_tru)}</>}
            {(p.bu_tru > 0 || p.hoan_tien > 0) && <span class="kho-phu">{' '}(tiền trả {dinhDangTien(p.tien_tra)}{p.bu_tru > 0 ? ` · bù trừ ${dinhDangTien(p.bu_tru)}` : ''}{p.hoan_tien > 0 ? ` · NCC hoàn ${dinhDangTien(p.hoan_tien)}` : ''})</span>}</dd>
          <dt>Còn nợ</dt><dd class="kho-so"><strong>{p.con_no < 0 ? `−${dinhDangTien(-p.con_no)}` : dinhDangTien(p.con_no)}</strong></dd>
        </dl>
        {noDau ? (
          <p class="kho-phu" style="margin:.25rem 0 0">Ghi nhầm? Hủy ở trang <a href="/noi-bo/kho/cong-no/no-dau">Nợ đầu kỳ</a> (khi chưa trả tiền).</p>
        ) : (
        <>
        <p style="margin:.25rem 0 0"><a href={`/noi-bo/kho/cong-no/tra-hang?phieu=${p.id}`}>Trả hàng cho nhà cung cấp →</a></p>
        {p.hoa_don_gop_id ? (
          <p class="kho-phu" style="margin:.5rem 0 0">Đã đối chiếu theo hóa đơn gộp — muốn sửa thì bỏ đối chiếu hóa đơn đó ở mục <a href="#hoa-don-gop">Hóa đơn gộp</a>.</p>
        ) : (
        <details open={loiO !== null || moPhieu === p.id}>
          <summary style="cursor:pointer;font-weight:600;padding:.8rem 0">{p.da_doi_chieu ? 'Sửa đối chiếu hóa đơn' : 'Đối chiếu hóa đơn'}</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="doi_chieu" />
            <input type="hidden" name="phieu_id" value={p.id} />
            <div class="kho-luoi">
              <label class="nb-o"><span>Số hóa đơn</span><input type="text" name="so_hoa_don" value={o('so_hoa_don', p.so_hoa_don ?? '')} required autocapitalize="characters" /></label>
              <label class="nb-o"><span>Ngày hóa đơn</span><input type="date" name="ngay_hoa_don" value={o('ngay_hoa_don', p.ngay_hoa_don ?? '')} max={homNay} /></label>
              <label class="nb-o"><span>Tổng tiền in trên hóa đơn</span>
                <small>Phiếu nhập: {dinhDangTien(p.tong_tien_phieu)}. Ghi đúng số in trên hóa đơn.</small>
                <input type="text" inputmode="numeric" name="tien_hoa_don" value={o('tien_hoa_don', p.tien_hoa_don !== null ? p.tien_hoa_don.toLocaleString('vi-VN') : '')} required placeholder="ví dụ 5.450.000" /></label>
              <label class="nb-o"><span>Hạn thanh toán</span><small>Bỏ trống = ngày hóa đơn + {ncc.so_ngay_no} ngày</small><input type="date" name="han_thanh_toan" value={o('han_thanh_toan', '')} /></label>
            </div>
            <label class="nb-o"><span>Ghi chú</span><small>Bắt buộc khi tiền hóa đơn khác phiếu nhập — ghi lý do lệch.</small>
              <input type="text" name="ghi_chu_doi_chieu" value={o('ghi_chu_doi_chieu', p.ghi_chu_doi_chieu ?? '')} maxlength="500" placeholder="ví dụ: NCC tính thêm phí giao hàng" /></label>
            <button type="submit" class="nb-nut phu">Lưu đối chiếu</button>
          </form>
        </details>
        )}
        </>
        )}
      </div>
    );
  })}
  {tatCaPhieu
    ? <p><a href={lienKet({ phieu: null })}>Chỉ xem phiếu còn việc</a></p>
    : soPhieuXong > 0 && <p><a href={lienKet({ phieu: 'tat_ca' })}>Xem cả {soPhieuXong} phiếu đã xong (đã trả đủ, đã đối chiếu) →</a></p>}

  {hoaDonGop.length > 0 && (
    <section id="hoa-don-gop" style="scroll-margin-top:5rem">
      <h2>Hóa đơn gộp</h2>
      {hoaDonGop.map(h => (
        <div class="nb-dong" style={h.trang_thai === 'da_bo' ? 'opacity:.6' : ''}>
          <div class="nb-dong-dau">
            <strong>HĐ {h.so_hoa_don} · {dinhDangNgay(h.ngay)}</strong>
            <span class={`nb-nhan ${h.trang_thai === 'da_bo' ? 'tat' : 'song'}`}>{h.trang_thai === 'da_bo' ? 'Đã bỏ' : dinhDangTien(h.tong_tien)}</span>
          </div>
          <dl>
            <dt>Phiếu</dt><dd>{h.phieu.length > 0 ? h.phieu.map(x => `${x.so_phieu ?? '?'}: ${dinhDangTien(x.so_tien)}`).join(' · ') : `${h.so_phieu} phiếu`}</dd>
            <dt>Tổng phiếu</dt><dd>{dinhDangTien(h.tong_phieu)}{h.tong_tien !== h.tong_phieu && <> · <span class="nb-nhan cho" style="text-transform:none">LỆCH {dinhDangLech(h.tong_tien - h.tong_phieu)}</span></>}</dd>
            {h.tien_thue > 0 && <><dt>Tiền thuế</dt><dd>{dinhDangTien(h.tien_thue)}</dd></>}
            {h.ly_do_lech && <><dt>Lý do lệch</dt><dd>{h.ly_do_lech}</dd></>}
            {h.ly_do_bo && <><dt>Lý do bỏ</dt><dd>{h.ly_do_bo}</dd></>}
          </dl>
          {h.trang_thai === 'hieu_luc' && (
            <details>
              <summary style="cursor:pointer;font-size:.85rem;color:var(--muc-nhat);padding:.8rem 0">Bỏ đối chiếu hóa đơn này (chọn nhầm phiếu, sai số)</summary>
              <form method="POST" style="margin-top:.5rem">
                <input type="hidden" name="viec" value="bo_gop" />
                <input type="hidden" name="hoa_don_id" value={h.id} />
                <p class="kho-phu">Chỉ bỏ được khi các phiếu chưa có khoản trả tiền, giảm trừ, bù trừ hay hoàn tiền nào. Các phiếu trở lại như trước khi đối chiếu.</p>
                <label class="nb-o"><span>Lý do</span><input type="text" name="ly_do" required maxlength="500" /></label>
                <button type="submit" class="nb-nut kho-nut-xoa">Bỏ đối chiếu</button>
              </form>
            </details>
          )}
        </div>
      ))}
    </section>
  )}

  <h2 id="cac-khoan" style="scroll-margin-top:5rem">Các khoản đã ghi</h2>
  {thanhToan.length === 0 ? (
    <p class="nb-rong">Chưa có khoản trả tiền, giảm trừ, bù trừ hay hoàn tiền nào.</p>
  ) : thanhToan.map(t => (
    <div class="nb-dong" style={t.trang_thai === 'da_huy' ? 'opacity:.6' : ''}>
      <div class="nb-dong-dau">
        <strong>{t.so_phieu} · {tenKhoan(t)}</strong>
        <span class={`nb-nhan ${t.trang_thai === 'da_huy' ? 'tat' : 'song'}`}>{t.trang_thai === 'da_huy' ? 'Đã hủy' : dinhDangTien(t.so_tien)}</span>
      </div>
      <dl>
        <dt>Ngày</dt><dd>{dinhDangNgay(t.ngay)} · ghi bởi {ten.get(t.nguoi_tao ?? '') ?? '—'} {dinhDangThoiDiem(t.created_at)}</dd>
        <dt>Chia cho</dt><dd>{t.phan_bo.map(x => `${x.so_phieu ?? '?'}: ${dinhDangTien(x.so_tien)}`).join(' · ') || '—'}</dd>
        {t.ghi_chu && <><dt>Ghi chú</dt><dd>{t.ghi_chu}</dd></>}
        {t.phieu_xuat_id && <><dt>Phiếu trả hàng</dt><dd><a href={`/noi-bo/kho/xuat/${t.phieu_xuat_id}`}>Xem hàng đã trả →</a></dd></>}
        {t.ly_do_huy && <><dt>Lý do hủy</dt><dd>{t.ly_do_huy}</dd></>}
      </dl>
      {t.anh.length > 0 && (
        <div class="kho-anh">{t.anh.map(a => anh.get(a) ? <a href={anh.get(a)} target="_blank" rel="noopener"><img src={anh.get(a)} alt="Chứng từ thanh toán" loading="lazy" /></a> : <span class="kho-phu">{a.split('/').pop()}</span>)}</div>
      )}
      {t.trang_thai === 'hieu_luc' && !t.phieu_xuat_id && (
        <details>
          <summary style="cursor:pointer;font-size:.85rem;color:var(--muc-nhat);padding:.8rem 0">Hủy khoản này (ghi nhầm)</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="huy_tt" />
            <input type="hidden" name="thanh_toan_id" value={t.id} />
            <label class="nb-o"><span>Lý do</span><input type="text" name="ly_do" required maxlength="500" /></label>
            <button type="submit" class="nb-nut kho-nut-xoa">Hủy khoản</button>
          </form>
        </details>
      )}
    </div>
  ))}
  {conNuaKhoan > 0 && (
    <p><a class="nb-nut phu" href={lienKet({ tat_ca: '1' }, '#cac-khoan')}>Xem thêm {conNuaKhoan} khoản cũ hơn</a></p>
  )}

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/cong-no">← Công nợ tất cả nhà cung cấp</a></p>
</Kho>

<style>
  .cn-nut { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1rem; scroll-margin-top: 5rem; }
</style>
