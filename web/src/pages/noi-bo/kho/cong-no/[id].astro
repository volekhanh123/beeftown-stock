---
/**
 * KHO — CÔNG NỢ MỘT NHÀ CUNG CẤP (id = nha_cung_cap_id)
 *
 *   · các phiếu nhập: phải trả, đã trả, còn nợ, hạn; đối chiếu hóa đơn ngay
 *     trên dòng (kế toán); link trả hàng;
 *   · ghi thanh toán / giảm trừ: để trống phần chia thì trả phiếu đến hạn
 *     sớm nhất trước; muốn trả đúng phiếu nào thì ghi số tiền ở phiếu đó;
 *   · lịch sử các khoản; ghi nhầm thì hủy (có lý do) rồi ghi lại.
 */
import NoiBo from '../../../../layouts/NoiBo.astro';
import DieuHuongKho from '../../../../components/kho/DieuHuongKho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import {
  docCongNoPhieu, docThanhToan, docTenNcc, doiChieuHoaDon, ghiThanhToan, huyThanhToan, TEN_HINH_THUC,
  type CongNoPhieu, type ThanhToan,
} from '../../../../lib/kho/cong-no.ts';
import { linkAnh } from '../../../../lib/kho/anh.ts';
import { cauLoiKho, congNgay, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, homNayVn, laUuid, type KetQua } from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('xem_gia')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nccId = Astro.params.id ?? '';

const ncc = await docTenNcc(k.client, nccId);
if (!ncc) return chuyenHuong(Astro, '/noi-bo/kho/cong-no', { ok: false, cau: 'Không tìm thấy nhà cung cấp này.' });

let bao: KetQua | null = k.bao;
let giaTriLoi: Record<string, string> = {};
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  const ve = (kq: KetQua) => chuyenHuong(Astro, `/noi-bo/kho/cong-no/${ncc.id}`, kq);
  if (viec === 'doi_chieu') {
    const id = String(form.get('phieu_id') ?? '');
    if (!laUuid(id)) bao = { ok: false, cau: 'Phiếu không hợp lệ.' };
    else return ve(await doiChieuHoaDon(k.client, id, form));
  } else if (viec === 'thanh_toan') {
    const kq = await ghiThanhToan(k.client, cn.id, ncc.id, form);
    if (kq.ok) return ve(kq);
    bao = kq;
    giaTriLoi = kq.giaTri ?? {};
  } else if (viec === 'huy_tt') {
    return ve(await huyThanhToan(k.client, String(form.get('thanh_toan_id') ?? ''), String(form.get('ly_do') ?? '').trim()));
  } else {
    bao = { ok: false, cau: 'Việc không hợp lệ.' };
  }
}

let phieu: CongNoPhieu[] = [];
let thanhToan: ThanhToan[] = [];
let loiDoc = k.loiDoc;
try {
  [phieu, thanhToan] = await Promise.all([
    docCongNoPhieu(k.client, cn.id, { nccId: ncc.id }),
    docThanhToan(k.client, cn.id, ncc.id),
  ]);
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được công nợ.');
}
const homNay = homNayVn();
const tuanToi = congNgay(homNay, 7);
const conNo = phieu.reduce((s, p) => s + p.con_no, 0);
const quaHan = phieu.filter(p => p.qua_han).reduce((s, p) => s + p.con_no, 0);
const phieuNo = phieu.filter(p => p.con_no > 0);
const soPhieu = new Map(phieu.map(p => [p.id, p.so_phieu]));
const ten = await tenNhanSu(k.client, thanhToan.map(t => t.nguoi_tao));
const anh = await linkAnh(k.client, thanhToan.flatMap(t => t.anh));
const keToan = k.duoc('ke_toan');
const g = (khoa: string, macDinh = '') => giaTriLoi[khoa] ?? macDinh;
---
<NoiBo tieuDe={`Công nợ · ${ncc.ten}`} nhanSu={k.nhanSu}>
  <h1>{ncc.ten}</h1>
  <DieuHuongKho vai={k.nhanSu.vai_tro} chiNhanh={k.chiNhanh} cacChiNhanh={k.cacChiNhanh} />
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <div class="kho-o-so-luoi">
    <div class={`kho-o-so ${conNo < 0 ? 'luu-y' : ''}`}><b style="font-size:1.25rem">{conNo < 0 ? `−${dinhDangTien(-conNo)}` : dinhDangTien(conNo)}</b><span>{conNo < 0 ? 'nhà cung cấp nợ lại' : 'còn nợ'}</span></div>
    <div class={`kho-o-so ${quaHan > 0 ? 'gap' : ''}`}><b style="font-size:1.25rem">{dinhDangTien(quaHan)}</b><span>quá hạn</span></div>
    <div class="kho-o-so"><b>{ncc.so_ngay_no}</b><span>ngày được nợ</span></div>
  </div>
  {(ncc.ngan_hang || ncc.so_tai_khoan) && (
    <p class="nb-dan">Chuyển khoản: <strong>{ncc.so_tai_khoan ?? '—'}</strong>{ncc.ngan_hang && ` · ${ncc.ngan_hang}`}</p>
  )}

  <h2>Phiếu nhập</h2>
  {phieu.length === 0 ? (
    <p class="nb-rong">Chưa có phiếu nhập mua nào được duyệt của nhà cung cấp này.</p>
  ) : phieu.map(p => (
    <div class="nb-dong">
      <div class="nb-dong-dau">
        <strong><a href={`/noi-bo/kho/nhap/${p.id}`}>{p.so_phieu}</a> · nhập {dinhDangNgay(p.ngay_nhap)}</strong>
        {p.con_no <= 0
          ? <span class="nb-nhan song">{p.con_no < 0 ? 'NCC nợ lại' : 'Đã trả đủ'}</span>
          : p.qua_han
            ? <span class="nb-nhan tat">Quá hạn {p.so_ngay_qua_han} ngày</span>
            : <span class={`nb-nhan ${p.han_thanh_toan && p.han_thanh_toan <= tuanToi ? 'cho' : 'nhap'}`}>Hạn {dinhDangNgay(p.han_thanh_toan)}</span>}
      </div>
      <dl>
        <dt>Hóa đơn</dt>
        <dd>{p.da_doi_chieu
          ? <>{p.so_hoa_don}{p.ngay_hoa_don && ` · ${dinhDangNgay(p.ngay_hoa_don)}`} · <strong>{dinhDangTien(p.tien_hoa_don)}</strong>
              {p.tien_hoa_don !== p.tong_tien_phieu && <span class="kho-phu"> (phiếu {dinhDangTien(p.tong_tien_phieu)})</span>}</>
          : <span class="kho-phu">chưa đối chiếu · phiếu {dinhDangTien(p.tong_tien_phieu)}</span>}</dd>
        <dt>Phải trả</dt><dd class="kho-so">{dinhDangTien(p.phai_tra)}</dd>
        <dt>Đã trả</dt><dd class="kho-so">{dinhDangTien(p.da_tra)}{p.giam_tru > 0 && <> · giảm trừ {dinhDangTien(p.giam_tru)}</>}</dd>
        <dt>Còn nợ</dt><dd class="kho-so"><strong>{p.con_no < 0 ? `−${dinhDangTien(-p.con_no)}` : dinhDangTien(p.con_no)}</strong></dd>
      </dl>
      {keToan && (
        <p style="margin:.25rem 0 0"><a href={`/noi-bo/kho/cong-no/tra-hang?phieu=${p.id}`}>Trả hàng cho nhà cung cấp →</a></p>
      )}
      {keToan && (
        <details>
          <summary style="cursor:pointer;font-weight:600;padding:.4rem 0">{p.da_doi_chieu ? 'Sửa đối chiếu hóa đơn' : 'Đối chiếu hóa đơn'}</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="doi_chieu" />
            <input type="hidden" name="phieu_id" value={p.id} />
            <div class="kho-luoi">
              <label class="nb-o"><span>Số hóa đơn</span><input type="text" name="so_hoa_don" value={p.so_hoa_don ?? ''} required autocapitalize="characters" /></label>
              <label class="nb-o"><span>Ngày hóa đơn</span><input type="date" name="ngay_hoa_don" value={p.ngay_hoa_don ?? ''} max={homNay} /></label>
              <label class="nb-o"><span>Tổng tiền hóa đơn</span><input type="text" inputmode="numeric" name="tien_hoa_don" value={p.tien_hoa_don !== null ? p.tien_hoa_don.toLocaleString('vi-VN') : p.tong_tien_phieu.toLocaleString('vi-VN')} required /></label>
              <label class="nb-o"><span>Hạn thanh toán</span><small>Bỏ trống = ngày hóa đơn + {ncc.so_ngay_no} ngày</small><input type="date" name="han_thanh_toan" /></label>
            </div>
            <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu_doi_chieu" value={p.ghi_chu_doi_chieu ?? ''} maxlength="500" /></label>
            <button type="submit" class="nb-nut phu">Lưu đối chiếu</button>
          </form>
        </details>
      )}
    </div>
  ))}

  {keToan && (
    <section class="nb-the" style="margin-top:1.5rem">
      <h2 style="margin-top:0">Ghi thanh toán</h2>
      <form method="POST" enctype="multipart/form-data">
        <input type="hidden" name="viec" value="thanh_toan" />
        <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
        <input type="hidden" name="so_pb" value={String(phieuNo.length)} />
        <div class="kho-luoi">
          <label class="nb-o"><span>Loại</span>
            <select name="loai">
              <option value="thanh_toan" selected={g('loai') !== 'giam_tru'}>Trả tiền</option>
              <option value="giam_tru" selected={g('loai') === 'giam_tru'}>Giảm trừ (chiết khấu, hàng thiếu)</option>
            </select></label>
          <label class="nb-o"><span>Số tiền</span><input type="text" inputmode="numeric" name="so_tien" value={g('so_tien')} required placeholder="ví dụ 5.450.000" /></label>
          <label class="nb-o"><span>Hình thức</span>
            <select name="hinh_thuc">
              {Object.entries(TEN_HINH_THUC).map(([v, t]) => <option value={v} selected={g('hinh_thuc', 'chuyen_khoan') === v}>{t}</option>)}
            </select></label>
          <label class="nb-o"><span>Ngày</span><input type="date" name="ngay" value={g('ngay', homNay)} max={homNay} required /></label>
        </div>
        <label class="nb-o"><span>Ghi chú</span><input type="text" name="ghi_chu" value={g('ghi_chu')} maxlength="500" placeholder="ví dụ: UNC Vietcombank 25/09" /></label>
        <label class="nb-o"><span>Ảnh ủy nhiệm chi / biên nhận</span><input type="file" name="anh" accept="image/*,application/pdf" multiple /></label>
        {phieuNo.length > 0 && (
          <details open={phieuNo.some((_, i) => !!giaTriLoi[`pb${i}_tien`])}>
            <summary style="cursor:pointer;font-weight:600;padding:.4rem 0">Chia cho phiếu cụ thể (không bắt buộc)</summary>
            <p class="kho-phu">Để trống hết = trả phiếu đến hạn sớm nhất trước. Ghi số tiền ở từng phiếu thì tổng phải bằng số tiền trả.</p>
            {phieuNo.map((p, i) => (
              <div class="kho-luoi" style="align-items:end">
                <input type="hidden" name={`pb${i}_phieu`} value={p.id} />
                <p style="margin:0 0 .9rem"><strong>{p.so_phieu}</strong><br /><span class="kho-phu">còn nợ {dinhDangTien(p.con_no)}{p.qua_han ? ' · quá hạn' : ''}</span></p>
                <label class="nb-o"><span>Trả phiếu này</span><input type="text" inputmode="numeric" name={`pb${i}_tien`} value={g(`pb${i}_tien`)} /></label>
              </div>
            ))}
          </details>
        )}
        <button type="submit" class="nb-nut" style="width:100%;margin-top:.5rem">Ghi thanh toán</button>
      </form>
    </section>
  )}

  <h2>Các khoản đã ghi</h2>
  {thanhToan.length === 0 ? (
    <p class="nb-rong">Chưa có khoản trả tiền hay giảm trừ nào.</p>
  ) : thanhToan.map(t => (
    <div class="nb-dong" style={t.trang_thai === 'da_huy' ? 'opacity:.6' : ''}>
      <div class="nb-dong-dau">
        <strong>{t.so_phieu} · {t.loai === 'thanh_toan' ? `Trả tiền (${TEN_HINH_THUC[t.hinh_thuc ?? 'khac']})` : t.phieu_xuat_id ? 'Giảm trừ do trả hàng' : 'Giảm trừ'}</strong>
        <span class={`nb-nhan ${t.trang_thai === 'da_huy' ? 'tat' : 'song'}`}>{t.trang_thai === 'da_huy' ? 'Đã hủy' : dinhDangTien(t.so_tien)}</span>
      </div>
      <dl>
        <dt>Ngày</dt><dd>{dinhDangNgay(t.ngay)} · ghi bởi {ten.get(t.nguoi_tao ?? '') ?? '—'} {dinhDangThoiDiem(t.created_at)}</dd>
        <dt>Chia cho</dt><dd>{t.phan_bo.map(x => `${soPhieu.get(x.phieu_nhap_id) ?? '?'}: ${dinhDangTien(x.so_tien)}`).join(' · ') || '—'}</dd>
        {t.ghi_chu && <><dt>Ghi chú</dt><dd>{t.ghi_chu}</dd></>}
        {t.ly_do_huy && <><dt>Lý do hủy</dt><dd>{t.ly_do_huy}</dd></>}
      </dl>
      {t.anh.length > 0 && (
        <div class="kho-anh">{t.anh.map(a => anh.get(a) ? <a href={anh.get(a)} target="_blank" rel="noopener"><img src={anh.get(a)} alt="Chứng từ thanh toán" loading="lazy" /></a> : <span class="kho-phu">{a.split('/').pop()}</span>)}</div>
      )}
      {keToan && t.trang_thai === 'hieu_luc' && !t.phieu_xuat_id && (
        <details>
          <summary style="cursor:pointer;font-size:.85rem;color:var(--muc-nhat);padding:.3rem 0">Hủy khoản này (ghi nhầm)</summary>
          <form method="POST" style="margin-top:.5rem">
            <input type="hidden" name="viec" value="huy_tt" />
            <input type="hidden" name="thanh_toan_id" value={t.id} />
            <label class="nb-o"><span>Lý do</span><input type="text" name="ly_do" required maxlength="500" /></label>
            <button type="submit" class="nb-nut kho-nut-xoa">Hủy khoản</button>
          </form>
        </details>
      )}
    </div>
  ))}

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/cong-no">← Công nợ tất cả nhà cung cấp</a></p>
</NoiBo>
