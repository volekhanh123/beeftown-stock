---
/**
 * KHO — TRẢ TIỀN NHÀ CUNG CẤP (GĐ8b, migration 0040) · /cong-no/<ncc>/tra-tien
 *
 * Hai bước, không JavaScript:
 *   1. Chọn cách trả (chuyển khoản, tiền mặt, bù trừ, NCC hoàn tiền, giảm trừ),
 *      gõ số tiền → "Xem trước"; hoặc bấm "Trả đủ" (điền đúng số còn nợ).
 *   2. Bảng chia vào từng phiếu do DATABASE tính (kho_xem_truoc_thanh_toan —
 *      hạn sớm nhất trước; hoàn tiền: phiếu NCC nợ lại quán). Sửa số ở phiếu
 *      nào thì gửi phần chia đó; không sửa gì thì database tự chia lại lúc ghi
 *      (kho_ghi_thanh_toan_v2). Ngày, ghi chú, ảnh ủy nhiệm chi → "Ghi".
 * ?kieu=<cách trả>&so_tien= điền sẵn bước 1 (link "Ghi nhanh" ở trang NCC).
 * Ghi xong về trang công nợ của NCC. Chỉ vai kế toán.
 */
import Kho from '../../../../../layouts/Kho.astro';
import BaoKho from '../../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../../lib/kho/trang.ts';
import {
  docTenNcc, docCongNoNcc, xemTruocThanhToan, docFormTraTien, ghiThanhToanV2, KIEU_TRA, TEN_HINH_THUC,
  type ChiaThanhToan, type CongNoNcc,
} from '../../../../../lib/kho/cong-no.ts';
import { cauLoiKho, dinhDangNgay, dinhDangTien, homNayVn, laUuid, type KetQua } from '../../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('ke_toan')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const ncc = await docTenNcc(k.client, Astro.params.id ?? '');
if (!ncc) return chuyenHuong(Astro, '/noi-bo/kho/cong-no', { ok: false, cau: 'Không tìm thấy nhà cung cấp này.' });
const VE = `/noi-bo/kho/cong-no/${ncc.id}`;
const homNay = homNayVn();

let bao: KetQua | null = k.bao;
let buoc2 = false;
let chia: { dong: ChiaThanhToan[]; tongChia: number; tongConLai: number } | null = null;
let giaTri: Record<string, string> = {};
let maGui: string = crypto.randomUUID();
let loiDoc = k.loiDoc;

const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'ghi') {
    const kq = await ghiThanhToanV2(k.client, cn.id, ncc.id, form);
    if (kq.ok) return chuyenHuong(Astro, VE, kq);
    bao = kq;
    // Dựng lại bảng chia với đúng chữ vừa gõ, giữ ma_gui (bấm lại không ghi đôi).
    const mg = String(form.get('ma_gui') ?? '');
    if (laUuid(mg)) maGui = mg;
  }
  const f = docFormTraTien(form, false);
  giaTri = { ...f.giaTri };
  if (viec !== 'ghi') {
    // Bước 1 → 2: xem trước. "Trả đủ" = không gửi số tiền.
    const traDu = viec === 'tra_du';
    if (f.loi.length) bao = { ok: false, cau: f.loi.join(' · ') };
    else if (!traDu && f.soTien === null) bao = { ok: false, cau: 'Ghi số tiền, hoặc bấm "Trả đủ".' };
    else {
      try {
        chia = await xemTruocThanhToan(k.client, cn.id, ncc.id, f.loai!, traDu ? null : f.soTien);
        if (traDu) giaTri.so_tien = chia.tongChia.toLocaleString('vi-VN');
        const soTien = traDu ? chia.tongChia : f.soTien!;
        if (chia.tongConLai === 0) {
          bao = { ok: false, cau: f.loai === 'hoan_tien' ? 'Nhà cung cấp không nợ lại quán đồng nào — không có gì để hoàn.' : 'Nhà cung cấp này không còn phiếu nào đang nợ.' };
        } else if (soTien > chia.tongConLai) {
          bao = { ok: false, cau: `Số tiền ${soTien.toLocaleString('vi-VN')} đ lớn hơn số ${f.loai === 'hoan_tien' ? 'NCC còn nợ lại quán' : 'còn nợ'} (${chia.tongConLai.toLocaleString('vi-VN')} đ). Sửa lại số tiền hoặc bấm "Trả đủ".` };
        } else {
          buoc2 = true;
          for (const [i, d] of chia.dong.entries()) giaTri[`pb${i}_tien`] = d.so_tien > 0 ? d.so_tien.toLocaleString('vi-VN') : '';
        }
      } catch (e) {
        bao = { ok: false, cau: cauLoiKho(e, 'Không xem trước được cách chia.') };
      }
    }
  } else if (f.loai && f.soTien !== null) {
    // Ghi lỗi: đọc lại cách chia gợi ý, giữ các ô đã gõ.
    try {
      chia = await xemTruocThanhToan(k.client, cn.id, ncc.id, f.loai, f.soTien);
      buoc2 = true;
    } catch (e) {
      loiDoc = cauLoiKho(e, 'Không xem trước được cách chia.');
    }
  }
} else {
  const q = Astro.url.searchParams;
  giaTri = { kieu: q.get('kieu') ?? '', so_tien: q.get('so_tien') ?? '' };
}

let tong: CongNoNcc | undefined;
try {
  tong = (await docCongNoNcc(k.client, cn.id, ncc.id))[0];
} catch (e) {
  loiDoc = loiDoc ?? cauLoiKho(e, 'Không đọc được công nợ.');
}
const kieu = KIEU_TRA.some(x => x.ma === giaTri.kieu) ? giaTri.kieu : 'chuyen_khoan';
const laHoan = kieu === 'hoan_tien';
const conNo = tong?.con_no ?? 0;
const g = (khoa: string, macDinh = '') => giaTri[khoa] ?? macDinh;
const tenKieu = KIEU_TRA.find(x => x.ma === kieu)?.ten ?? '';
---
<Kho k={k} huongDan="ghi-thanh-toan" tieuDe={`Trả tiền · ${ncc.ten}`}>
  <h1>Trả tiền · {ncc.ten}</h1>
  <p><a href={VE}>← Công nợ {ncc.ten}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  <div class="kho-o-so-luoi">
    <div class={`kho-o-so ${conNo < 0 ? 'luu-y' : ''}`}><b style="font-size:1.25rem">{conNo < 0 ? `−${dinhDangTien(-conNo)}` : dinhDangTien(conNo)}</b><span>{conNo < 0 ? 'nhà cung cấp nợ lại quán' : 'còn nợ'}</span></div>
    <div class={`kho-o-so ${(tong?.no_qua_han ?? 0) > 0 ? 'gap' : ''}`}><b style="font-size:1.25rem">{dinhDangTien(tong?.no_qua_han ?? 0)}</b><span>quá hạn</span></div>
  </div>
  {ncc.so_tai_khoan && <p class="nb-dan">Chuyển khoản: <strong>{ncc.so_tai_khoan}</strong>{ncc.ngan_hang && ` · ${ncc.ngan_hang}`}</p>}

  {!buoc2 ? (
    <form method="POST" class="nb-the">
      <fieldset class="tt-kieu">
        <legend>Trả bằng cách nào?</legend>
        {KIEU_TRA.map(x => (
          <label>
            <input type="radio" name="kieu" value={x.ma} checked={kieu === x.ma} />
            <span><strong>{x.ten}</strong><small>{x.moTa}</small></span>
          </label>
        ))}
      </fieldset>
      <label class="nb-o"><span>Số tiền</span>
        <input type="text" inputmode="numeric" name="so_tien" value={g('so_tien')} placeholder="ví dụ 5.450.000" /></label>
      <div class="tt-nut">
        <button type="submit" name="viec" value="xem_truoc" class="nb-nut">Xem trước cách chia</button>
        <button type="submit" name="viec" value="tra_du" class="nb-nut phu">Trả đủ</button>
      </div>
      <p class="kho-phu" style="margin:.5rem 0 0">"Trả đủ" điền đúng số còn nợ của mọi phiếu (với NCC hoàn tiền: đúng số NCC còn nợ lại quán).</p>
    </form>
  ) : chia && (
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="viec" value="ghi" />
      <input type="hidden" name="ma_gui" value={maGui} />
      <input type="hidden" name="kieu" value={kieu} />
      <input type="hidden" name="so_tien" value={g('so_tien')} />
      <input type="hidden" name="so_pb" value={String(chia.dong.length)} />
      <div class="nb-the">
        <p style="margin:0 0 .5rem"><strong>{tenKieu}: {g('so_tien')} đ</strong>{' '}
          <a href={`${Astro.url.pathname}?kieu=${kieu}&so_tien=${encodeURIComponent(g('so_tien'))}`}>Sửa</a></p>
        <p class="kho-phu" style="margin:0 0 .75rem">
          {laHoan ? 'Chia vào các phiếu nhà cung cấp đang nợ lại quán, phiếu cũ trước.' : 'Chia vào phiếu đến hạn sớm nhất trước.'}
          {' '}Muốn chia khác thì sửa số ở từng phiếu — tổng phải bằng số tiền.
        </p>
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>Phiếu</th><th>Hạn trả</th><th class="so">{laHoan ? 'NCC nợ lại' : 'Còn nợ'}</th><th class="so">Trả phiếu này</th></tr></thead>
            <tbody>
              {chia.dong.map((d, i) => (
                <tr>
                  <td><strong>{d.so_phieu}</strong><br /><span class="kho-phu">{dinhDangNgay(d.ngay_nhap)}</span></td>
                  <td>{d.han_thanh_toan ? dinhDangNgay(d.han_thanh_toan) : '—'}</td>
                  <td class="so">{dinhDangTien(d.con_lai)}</td>
                  <td class="so">
                    <input type="hidden" name={`pb${i}_phieu`} value={d.phieu_nhap_id} />
                    <input type="hidden" name={`pb${i}_goi_y`} value={String(d.so_tien)} />
                    <input type="text" inputmode="numeric" name={`pb${i}_tien`} value={g(`pb${i}_tien`)} aria-label={`Trả phiếu ${d.so_phieu}`} style="max-width:10rem;text-align:right" />
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="tong"><td colspan="2">Tổng</td><td class="so">{dinhDangTien(chia.tongConLai)}</td><td class="so">{dinhDangTien(chia.tongChia)}</td></tr>
            </tfoot>
          </table>
        </div>
      </div>
      <div class="nb-the">
        <div class="kho-luoi">
          {laHoan && (
            <label class="nb-o"><span>NCC trả bằng</span>
              <select name="hinh_thuc_hoan">
                <option value="chuyen_khoan" selected={g('hinh_thuc_hoan') !== 'tien_mat'}>{TEN_HINH_THUC.chuyen_khoan}</option>
                <option value="tien_mat" selected={g('hinh_thuc_hoan') === 'tien_mat'}>{TEN_HINH_THUC.tien_mat}</option>
              </select></label>
          )}
          <label class="nb-o"><span>Ngày</span><input type="date" name="ngay" value={g('ngay', homNay)} max={homNay} required /></label>
        </div>
        <label class="nb-o"><span>Ghi chú{kieu === 'bu_tru' ? ' (bắt buộc: khoản gì)' : ''}</span>
          <input type="text" name="ghi_chu" value={g('ghi_chu')} maxlength="500" required={kieu === 'bu_tru'}
            placeholder={kieu === 'bu_tru' ? 'ví dụ: trừ tiền cọc vỏ thùng' : 'ví dụ: UNC Vietcombank 25/09'} /></label>
        {kieu !== 'bu_tru' && kieu !== 'giam_tru' && (
          <label class="nb-o"><span>Ảnh ủy nhiệm chi / biên nhận</span><input type="file" name="anh" accept="image/*,application/pdf" multiple /></label>
        )}
      </div>
      <div class="kho-thanh-nut dinh">
        <button type="submit" class="nb-nut">Ghi {tenKieu.toLowerCase()}</button>
      </div>
    </form>
  )}
</Kho>

<style>
  .tt-kieu { border: 0; padding: 0; margin: 0 0 1rem; display: grid; gap: .5rem; }
  .tt-kieu legend { font-weight: 700; margin-bottom: .5rem; padding: 0; }
  .tt-kieu label { display: flex; gap: .75rem; align-items: flex-start; min-height: 48px; padding: .6rem .75rem;
    border: 1px solid var(--kho-vach, #ddd); border-radius: 10px; background: #fff; cursor: pointer; }
  .tt-kieu input { width: 1.25rem; height: 1.25rem; margin-top: .15rem; flex: none; }
  .tt-kieu span { display: flex; flex-direction: column; }
  .tt-kieu small { color: var(--muc-nhat); }
  .tt-nut { display: flex; flex-wrap: wrap; gap: .5rem; }
</style>
