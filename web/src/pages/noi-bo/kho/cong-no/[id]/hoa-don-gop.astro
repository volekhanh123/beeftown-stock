---
/**
 * KHO — ĐỐI CHIẾU HÓA ĐƠN GỘP (GĐ8b, migration 0040) · /cong-no/<ncc>/hoa-don-gop
 *
 * Nhà cung cấp xuất MỘT hóa đơn cho NHIỀU lần giao (cuối tuần, cuối tháng):
 * tích các phiếu nhập nằm trong hóa đơn → gõ số hóa đơn, ngày, tổng tiền,
 * tiền thuế → "Xem trước" (bảng chia từng phiếu: xemTruocHoaDonGop, soi gương
 * database — tổng khớp từng đồng) → "Lưu đối chiếu" (kho_doi_chieu_hoa_don_gop,
 * ma_gui). Tổng hóa đơn lệch tổng phiếu thì bắt buộc lý do lệch.
 *
 * Chỉ phiếu nhập MUA đã duyệt, chưa thuộc hóa đơn gộp nào (nợ đầu kỳ không
 * gộp). Phiếu chưa đối chiếu được tích sẵn. ?tu=&den= lọc theo ngày nhập.
 * Bỏ đối chiếu gộp: ở trang công nợ của NCC (mục "Hóa đơn gộp").
 */
import Kho from '../../../../../layouts/Kho.astro';
import BaoKho from '../../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../../lib/kho/trang.ts';
import {
  docTenNcc, docCongNoPhieu, docFormHoaDonGop, xemTruocHoaDonGop, doiChieuGop, dinhDangLech,
  type CongNoPhieu, type ChiaHoaDonGop,
} from '../../../../../lib/kho/cong-no.ts';
import { cauLoiKho, dinhDangNgay, dinhDangTien, homNayVn, laUuid, type KetQua } from '../../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('ke_toan')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const ncc = await docTenNcc(k.client, Astro.params.id ?? '');
if (!ncc) return chuyenHuong(Astro, '/noi-bo/kho/cong-no', { ok: false, cau: 'Không tìm thấy nhà cung cấp này.' });
const VE = `/noi-bo/kho/cong-no/${ncc.id}`;
const homNay = homNayVn();
const sp = Astro.url.searchParams;
const ngay = (v: string | null) => (v && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v : null);
const tu = ngay(sp.get('tu'));
const den = ngay(sp.get('den'));

let phieu: CongNoPhieu[] = [];
let loiDoc = k.loiDoc;
try {
  phieu = (await docCongNoPhieu(k.client, cn.id, { nccId: ncc.id }))
    .filter(p => p.loai !== 'no_dau' && !p.hoa_don_gop_id)
    .filter(p => (!tu || p.ngay_nhap >= tu) && (!den || p.ngay_nhap <= den))
    .sort((a, b) => (a.ngay_nhap < b.ngay_nhap ? -1 : a.ngay_nhap > b.ngay_nhap ? 1 : a.so_phieu.localeCompare(b.so_phieu)));
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được phiếu nhập.');
}

let bao: KetQua | null = k.bao;
let giaTri: Record<string, string> = {};
let chon = new Set(phieu.filter(p => !p.da_doi_chieu).map(p => p.id));
let chia: ChiaHoaDonGop | null = null;
let maGui: string = crypto.randomUUID();
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  const f = docFormHoaDonGop(form);
  giaTri = f.giaTri;
  chon = new Set(f.phieu);
  const mg = String(form.get('ma_gui') ?? '');
  if (laUuid(mg)) maGui = mg;
  const daChon = phieu.filter(p => chon.has(p.id));
  if (daChon.length !== f.phieu.length) {
    bao = { ok: false, cau: 'Có phiếu vừa được đối chiếu ở chỗ khác hoặc không còn trong danh sách — tải lại trang rồi chọn lại.' };
  } else {
    const tongPhieu = daChon.reduce((a, p) => a + p.tong_tien_phieu, 0);
    if (f.tongTien !== null && daChon.length >= 2) chia = xemTruocHoaDonGop(daChon, f.tongTien, f.tienThue);
    if (String(form.get('viec') ?? '') === 'luu') {
      const kq = await doiChieuGop(k.client, cn.id, ncc.id, form, tongPhieu);
      if (kq.ok) return chuyenHuong(Astro, VE, kq);
      bao = kq;
    } else if (f.loi.length) {
      bao = { ok: false, cau: f.loi.join(' · ') };
    }
  }
}
const g = (khoa: string, macDinh = '') => giaTri[khoa] ?? macDinh;
const tongChon = phieu.filter(p => chon.has(p.id)).reduce((a, p) => a + p.tong_tien_phieu, 0);
---
<Kho k={k} huongDan="hoa-don-gop" tieuDe={`Hóa đơn gộp · ${ncc.ten}`} rong>
  <h1>Đối chiếu hóa đơn gộp · {ncc.ten}</h1>
  <p><a href={VE}>← Công nợ {ncc.ten}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  <p class="nb-dan">Nhà cung cấp gửi một hóa đơn cho nhiều lần giao: tích các phiếu nhập nằm trong hóa đơn, gõ số tiền trên hóa đơn, bấm <strong>Xem trước</strong> rồi <strong>Lưu đối chiếu</strong>.</p>

  <form method="GET" class="kho-tim-hang" style="margin-bottom:1rem">
    <label class="nb-o"><span>Nhập từ ngày</span><input type="date" name="tu" value={tu ?? ''} max={homNay} /></label>
    <label class="nb-o"><span>Đến ngày</span><input type="date" name="den" value={den ?? ''} max={homNay} /></label>
    <button type="submit" class="nb-nut phu">Lọc phiếu</button>
  </form>

  {phieu.length === 0 ? (
    <p class="nb-rong">Không có phiếu nhập nào để gộp{tu || den ? ' trong khoảng ngày này' : ''}. Phiếu đã thuộc một hóa đơn gộp và phiếu nợ đầu kỳ không hiện ở đây.</p>
  ) : (
    <form method="POST">
      <input type="hidden" name="ma_gui" value={maGui} />
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>Chọn</th><th>Phiếu</th><th>Ngày nhập</th><th>Hóa đơn hiện tại</th><th class="so">Tổng phiếu</th><th class="so">Còn nợ</th></tr></thead>
          <tbody>
            {phieu.map(p => (
              <tr>
                <td><input type="checkbox" name="phieu" value={p.id} checked={chon.has(p.id)} aria-label={`Chọn phiếu ${p.so_phieu}`} style="width:1.4rem;height:1.4rem" /></td>
                <td><a href={`/noi-bo/kho/nhap/${p.id}`}><strong>{p.so_phieu}</strong></a></td>
                <td>{dinhDangNgay(p.ngay_nhap)}</td>
                <td>{p.da_doi_chieu ? <>{p.so_hoa_don} · {dinhDangTien(p.tien_hoa_don)}</> : <span class="kho-phu">chưa đối chiếu</span>}</td>
                <td class="so">{dinhDangTien(p.tong_tien_phieu)}</td>
                <td class="so">{dinhDangTien(p.con_no)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot><tr class="tong"><td colspan="4">Đang chọn {chon.size} phiếu</td><td class="so">{dinhDangTien(tongChon)}</td><td></td></tr></tfoot>
        </table>
      </div>

      <div class="nb-the" style="margin-top:1rem">
        <div class="kho-luoi">
          <label class="nb-o"><span>Số hóa đơn</span><input type="text" name="so_hoa_don" value={g('so_hoa_don')} maxlength="60" required autocapitalize="characters" /></label>
          <label class="nb-o"><span>Ngày hóa đơn</span><input type="date" name="ngay" value={g('ngay', homNay)} max={homNay} required /></label>
          <label class="nb-o"><span>Tổng tiền in trên hóa đơn</span><small>Gồm cả thuế. Ghi đúng số in trên hóa đơn.</small>
            <input type="text" inputmode="numeric" name="tong_tien" value={g('tong_tien')} required placeholder="ví dụ 25.450.000" /></label>
          <label class="nb-o"><span>Tiền thuế GTGT</span><small>Để trống nếu hóa đơn không có thuế.</small>
            <input type="text" inputmode="numeric" name="tien_thue" value={g('tien_thue')} placeholder="ví dụ 1.850.000" /></label>
        </div>
        <label class="nb-o"><span>Lý do lệch</span><small>Bắt buộc khi tổng hóa đơn khác tổng các phiếu đã chọn.</small>
          <input type="text" name="ly_do_lech" value={g('ly_do_lech')} maxlength="500" placeholder="ví dụ: NCC tính thêm phí giao hàng" /></label>
        <p class="kho-phu" style="margin:0">Hạn trả của các phiếu = ngày hóa đơn + {ncc.so_ngay_no} ngày được nợ.</p>
      </div>

      {chia && (
        <div class="nb-the">
          <h2 style="margin-top:0">Xem trước: chia hóa đơn vào từng phiếu</h2>
          {chia.lech !== 0 && (
            <p><span class="nb-nhan cho" style="text-transform:none">LỆCH {dinhDangLech(chia.lech)}</span> so với tổng các phiếu {dinhDangTien(chia.tongPhieu)} — ghi lý do lệch.</p>
          )}
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr><th>Phiếu</th><th class="so">Tổng phiếu</th><th class="so">Phần hóa đơn</th><th class="so">Trong đó thuế</th></tr></thead>
              <tbody>
                {chia.phieu.map(p => (
                  <tr><td>{p.so_phieu}</td><td class="so">{dinhDangTien(p.tong_tien_phieu)}</td><td class="so"><strong>{dinhDangTien(p.so_tien)}</strong></td><td class="so">{dinhDangTien(p.tien_thue)}</td></tr>
                ))}
              </tbody>
              <tfoot><tr class="tong"><td>Tổng</td><td class="so">{dinhDangTien(chia.tongPhieu)}</td>
                <td class="so">{dinhDangTien(chia.phieu.reduce((a, p) => a + p.so_tien, 0))}</td>
                <td class="so">{dinhDangTien(chia.phieu.reduce((a, p) => a + p.tien_thue, 0))}</td></tr></tfoot>
            </table>
          </div>
        </div>
      )}

      <div class="kho-thanh-nut dinh" style="display:flex;gap:.5rem;flex-wrap:wrap">
        <button type="submit" name="viec" value="xem_truoc" class="nb-nut phu">Xem trước</button>
        <button type="submit" name="viec" value="luu" class="nb-nut">Lưu đối chiếu</button>
      </div>
    </form>
  )}
</Kho>
