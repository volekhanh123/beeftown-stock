  xemLaiPhien: { vi: 'Xem lại phiên', en: 'View the session' },
  kgTangVao: { vi: 'kg tảng vào', en: 'kg of primal in' },
  kgHaoHut: { vi: 'kg hao hụt', en: 'kg lost' },
  thapDau: { vi: 'Thu hồi thấp hơn dự kiến', en: 'Yield below expected' },
  thapChiTiet: {
    vi: (a: string, b: string, nguong: string) => `: ${a} so với ${b} (ngưỡng báo ${nguong} điểm).`,
    en: (a: string, b: string, nguong: string) => `: ${a} against ${b} (alert threshold: ${nguong} points).`,
  },
  daXemLuc: { vi: (ten: string, luc: string) => `Đã xem: ${ten} lúc ${luc}`, en: (ten: string, luc: string) => `Seen: ${ten} at ${luc}` },
  ghiChuKhongBuoc: { vi: 'Ghi chú (không bắt buộc)', en: 'Note (optional)' },
  viDuDaXem: { vi: 'ví dụ: tảng nhiều mỡ, đã nhắc nhà cung cấp', en: 'e.g. fatty primal, told the supplier' },
  daXem: { vi: 'Đã xem', en: 'Seen' },
  daBaoQuanLy: { vi: 'Đã báo quản lý.', en: 'The manager has been told.' },
  tang: { vi: 'Tảng', en: 'Primal' },
  tangDemPha: { vi: 'Tảng đem pha', en: 'Primal cut' },
  cotLo: { vi: 'Lô', en: 'Lot' },
  layO: { vi: 'Lấy ở', en: 'Taken from' },
  soTang: { vi: 'Số tảng', en: 'Primals' },
  phanCatRa: { vi: 'Phần cắt ra', en: 'Cuts' },
  loMoi: { vi: 'Lô mới', en: 'New lot' },
  moLaiTieuDe: { vi: 'Mở lại phiên để sửa (cân nhầm, ghi nhầm)', en: 'Reopen the session to fix it (wrong weight, wrong entry)' },
  moLai1: { vi: 'Chỉ mở lại được khi các lô mới ', en: 'It can only be reopened while the new lots ' },
  moLai2: { vi: 'chưa được chuyển, bán, xuất hay kiểm kê', en: 'have not been moved, sold, issued or counted' },
  moLai3: {
    vi: '. Mở lại = tồn trở về như trước khi chốt; sửa xong phải chốt lại.',
    en: '. Reopening puts stock back to how it was before closing; close it again once fixed.',
  },
  lyDoMoLaiNhan: { vi: 'Lý do mở lại', en: 'Reason for reopening' },
  moLaiPhien: { vi: 'Mở lại phiên', en: 'Reopen session' },
  veDanhSach: { vi: '← Danh sách phiên pha lóc', en: '← Butchery sessions' },
  // 0049 — ô mã (món theo dõi theo tảng)
  oMaTd: { vi: 'Ô mã của tảng này', en: 'Rotating codes for this primal' },
  oMaGt: {
    vi: 'Món theo dõi theo tảng: mỗi phiên một tảng. Giao ô mã cho phần cắt — Beeftown Cân ở quầy bật Tự gửi thì tự gửi xuống cân sau khoảng 15–60 giây (không thì quản lý bấm Gửi xuống cân), cân đổi tên phím thành tên phần cắt kèm số tảng. Chờ dòng "Cân sẵn sàng" hiện xanh (bấm Xem lại cân), rồi cân, in tem bằng đúng phím đó.',
    en: 'Items tracked per primal: one primal per session. Assign rotating codes to the cuts — if Beeftown Scale at the counter has automatic sending on, it sends them to the scale within about 15–60 seconds (otherwise a manager presses Send to scale), and the scale key is renamed to the cut plus the primal number. Wait for the "Scale ready" line to turn green (press Check the scale again), then weigh and print with that key.',
  },
  oMaTang: { vi: (so: string) => `Tảng ${so}`, en: (so: string) => `Primal ${so}` },
  oMaDong: { vi: (so: number, ma: string) => `ô ${so} · mã ${ma}`, en: (so: number, ma: string) => `slot ${so} · code ${ma}` },
  oMaChuaGiao: { vi: 'Chưa giao ô mã.', en: 'No rotating code assigned yet.' },
  oMaNut: { vi: 'Giao ô mã cho phần cắt', en: 'Assign rotating codes to the cuts' },
  oMaChonTang: { vi: 'Chọn đúng một tảng ở mục Tảng đem pha rồi mới giao ô mã.', en: 'Choose exactly one primal under Primal cut before assigning codes.' },
  oMaXemLai: { vi: 'Xem lại cân', en: 'Check the scale again' },
});
// Thủ kho (pha_loc, không xem giá) không thấy cột / chữ tiền nào (0031).
const xemGia = k.duoc('xem_gia');
const idThamSo = Astro.params.id ?? '';
const DUONG = `/noi-bo/kho/pha-loc/${idThamSo}`;

// ---------------------------------------------------------------------------
// Đọc
// ---------------------------------------------------------------------------
let matHang: MatHang[] = [];
let viTri: ViTri[] = [];
let caiDat: CaiDat | null = null;
let congThuc: CongThuc[] = [];
let ton: DongTon[] = [];
let phien: PhienPha | null = null;
let vaoDb: DauVao[] = [];
let raDb: DauRa[] = [];
let nhan: NhanQuet[] = [];
let noiDe = new Map<string, 'kho' | 'quay' | null>();
let loiDoc = k.loiDoc;
try {
  let doc: Awaited<ReturnType<typeof docPhienPha>>;
  [matHang, viTri, caiDat, congThuc, ton, doc, nhan, noiDe] = await Promise.all([
    docMatHang(k.client), docViTri(k.client, cn.id), docCaiDat(k.client, cn.id),
    docCongThuc(k.client), docTon(k.client, cn.id), docPhienPha(k.client, idThamSo),
    docNhanQuet(k.client, idThamSo), docNoiDeSauPha(k.client),
  ]);
  if (doc) { phien = doc.phien; vaoDb = doc.vao; raDb = doc.ra; }
} catch (e) {
  loiDoc = cauLoiKho(e, t.khongDoc);
}
if (!phien && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/pha-loc', kqHai(false, CAU.khongThay));
}

const q = Astro.url.searchParams;
const form = await docFormGui(Astro);
const mhVao = matHang.find(m => m.id === phien?.mat_hang_vao_id) ?? null;
const soanDuoc = k.duoc('pha_loc') && phien?.trang_thai === 'nhap';
const tenVt = new Map(viTri.map(v => [v.id, v]));
/** Dòng gõ tay để trống "Để ở": theo nơi để sau pha của món (kho lạnh / quầy). */
const viTriTheoMon = (id: string) => viTriSauPha(noiDe.get(id), viTri);

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
let docLoi: KetQuaDocPhien | null = null;
// Hiện lại sau lỗi quét: mã trong ô và ma_gui của lượt đó.
let maConLai = '';
let maGuiLai: string | null = null;
if (Astro.request.method === 'POST' && !form) {
  bao = kqHai(false, CAU.mangDut);
}
if (form && phien) {
  const viec = String(form.get('viec') ?? '');
  const ve = (kq: KetQua, them = '') => chuyenHuong(Astro, `${DUONG}${them}`, kq);
  const khongSua: KetQua = kqHai(false, CAU.khongSua);

  if (['luu', 'them_dong', 'ket_qua'].includes(viec)) {
    if (!soanDuoc || !mhVao) {
      bao = khongSua;
    } else {
      const kq = await luuPhienPha(k.client, cn.id, form, {
        id: phien.id, phienBan: Number(form.get('phien_ban')), matHangVaoId: mhVao.id, viTriTheoMon,
      });
      if (!kq.ok) {
        bao = kq;
        docLoi = kq.doc ?? null;
      } else if (viec === 'ket_qua') {
        return ve(kqHai(true, CAU.luuXemKetQua), '?buoc=ket-qua');
      } else if (viec === 'them_dong') {
        const them = Math.min(Number(form.get('so_ra') ?? 0) + 3, 60);
        return ve(kqHai(true, CAU.luuThemDong), `?ra=${them}#go-tay`);
      } else {
        return ve(kq);
      }
    }
  } else if (VIEC_LUU_GO_TAY_TRUOC.includes(viec)) {
    // Quét, −1, bỏ lượt, bỏ món (GĐ5e): cùng một form với các ô gõ kg — LƯU
    // PHẦN GÕ TAY TRƯỚC rồi mới làm, để gõ kg phụ phẩm xong quét nhãn ngay
    // (không bấm Lưu) thì số vừa gõ không mất.
    if (!soanDuoc || !mhVao) return ve(khongSua);
    const maGui = String(form.get('ma_gui') ?? '');
    const maQuet = String(form.get('ma_quet') ?? '').trim();
    let daLuu = false;
    if (form.has('so_ra')) {
      const luu = await luuPhienPha(k.client, cn.id, form, {
        id: phien.id, phienBan: Number(form.get('phien_ban')), matHangVaoId: mhVao.id, viTriTheoMon,
      });
      if (!luu.ok) {
        // Chưa quét / chưa sửa gì: hiện lại đúng chữ đã gõ và các mã trong ô.
        bao = kqHai(false, {
          vi: `${viec === 'quet' ? 'Chưa cộng nhãn' : 'Chưa sửa'} — phần gõ tay chưa lưu được: ${luu.cau}`,
          en: `${viec === 'quet' ? 'Labels not added' : 'Not changed'} — the typed-in part could not be saved: ${luu.cauEn ?? dichCau('en', luu.cau)}`,
        });
        docLoi = luu.doc ?? null;
        maConLai = maQuet;
        maGuiLai = laUuid(maGui) ? maGui : null;
      } else daLuu = true;
    } else daLuu = true;

    if (daLuu && viec === 'quet') {
      // Ô quét trống (vd. Enter trong ô kg — nút đầu form là nút quét): chỉ lưu.
      if (!maQuet) return ve(kqHai(true, CAU.daLuu));
      const kq = await quetPhienPha(k.client, phien.id, maGui, maQuet);
      const loiEn = (kq.loiNhanEn ?? []).join(' · ');
      if (kq.ok) {
        const loi = kq.loiNhan ?? [];
        // Có nhãn không cộng được: báo đỏ để thợ để ý (quét lại / báo quản lý).
        return ve(loi.length > 0
          ? kqHai(false, { vi: `${kq.cau} Chưa cộng — ${loi.join(' · ')}`, en: `${kq.cauEn ?? dichCau('en', kq.cau)} Not added — ${loiEn}` })
          : kq);
      }
      if (kq.loiNhan && kq.loiNhan.length > 0) {
        // Không nhãn nào cộng được: toàn nhãn hỏng / lạ — không giữ lại trong ô.
        return ve(kqHai(false, { vi: `Chưa cộng nhãn nào — ${kq.loiNhan.join(' · ')}`, en: `No labels added — ${loiEn}` }));
      }
      // Lỗi mạng / database: giữ các mã trong ô và ma_gui — gửi lại không cộng đôi.
      // Phần gõ tay ĐÃ lưu (phiên bản mới): đọc lại phiên để form mang đúng phien_ban.
      bao = kq;
      maConLai = maQuet;
      maGuiLai = laUuid(maGui) ? maGui : null;
      try {
        const [doc, nhanMoi] = await Promise.all([docPhienPha(k.client, phien.id), docNhanQuet(k.client, phien.id)]);
        if (doc) { phien = doc.phien; vaoDb = doc.vao; raDb = doc.ra; }
        nhan = nhanMoi;
      } catch { /* giữ bản đã đọc — bấm lại sẽ báo nếu phiên đã đổi */ }
    } else if (daLuu) {
      // Món cần sửa đi theo URL của nút (formaction ?mon=…), ma_gui riêng của lệnh sửa.
      const cach = viec === 'bo_luot' ? 'lan_cuoi' as const : viec === 'bot_mot' ? 'bot_mot' as const : 'xoa_mon' as const;
      // "Đã bớt 1 gói." → đơn vị của chính món đó ("Đã bớt 1 khay.").
      return ve(doiDonViCau(await suaQuetPhienPha(k.client, phien.id, String(form.get('ma_gui_sua') ?? ''), cach,
        q.get('mon') || null), cach === 'bot_mot' ? matHang.find(m => m.id === q.get('mon'))?.don_vi_goi : null));
    }
  } else if (viec === 'giao_o_ma') {
    if (!soanDuoc) return ve(khongSua);
    return ve(await giaoOMa(k.client, phien.id));
  } else if (viec === 'chot') {
    if (!soanDuoc) return ve(khongSua);
    const pb = Number(String(form.get('phien_ban') ?? ''));
    const c = await chotPhien(k.client, phien.id, Number.isInteger(pb) ? pb : null);
    return ve(c, c.ok ? '?buoc=xong' : '?buoc=ket-qua');
  } else if (viec === 'mo_lai' || viec === 'huy') {
    const lyDo = String(form.get('ly_do') ?? '').trim();
    return ve(viec === 'mo_lai' ? await moLaiPhien(k.client, phien.id, lyDo) : await huyPhien(k.client, phien.id, lyDo || null));
  } else if (viec === 'da_xem') {
    const ghiChu = String(form.get('ghi_chu_xem') ?? '').trim();
    return ve(await xacNhanPhien(k.client, phien.id, ghiChu || null));
  } else {
    bao = kqHai(false, CAU.viecSai);
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const buoc = phien ? buocPhien(phien.trang_thai, soanDuoc, q.get('buoc')) : 'xem';
// 0049: món theo tảng — ô mã đang giao cho phiên và số tảng đem pha.
let oMaPhien: GiaoOMa[] = [];
let soTangPhien = '';
const loVaoPhien = [...new Set(vaoDb.map(v => v.lo_id))];
// 0061: ô đã lên cân chưa (máy quầy báo), tem cân in / nhãn quét, nhãn mã thường. Không đọc được → null: không vẽ gì.
let tomTatCan: TomTatCan | null = null;
if (phien && mhVao?.theo_tang && !loiDoc) {
  try {
    const [g, cp] = await Promise.all([docGiaoOMa(k.client, cn.id, phien.id), docCanPhien(k.client, phien.id)]);
    oMaPhien = g;
    tomTatCan = cp ? tomTatCanPhien(cp) : null;
  } catch { /* không đọc được ô mã: khung ô mã hiện "chưa giao" */ }
}
const tenMh = new Map(matHang.map(m => [m.id, m]));
const viTriRa = viTri.filter(v => v.loai !== 'cho_huy' && v.loai !== 'dang_chuyen' && v.dang_dung);
const tenNoiDe = (id: string | null) => {
  const v = id ? tenVt.get(id) : undefined;
  return v ? v.ten : '—';
};

// Công thức của loại tảng này (chọn trong mục "Thêm").
const ctCuaTang = congThuc.filter(c => c.mat_hang_vao_id === phien?.mat_hang_vao_id && (c.dang_dung || c.id === phien?.cong_thuc_id));
const ctChonId = docLoi?.dau.cong_thuc_id ?? phien?.cong_thuc_id ?? '';
const ctChon = ctCuaTang.find(c => c.id === ctChonId) ?? null;

// Đầu vào: mọi lô của loại tảng đang có (trừ chờ hủy, đang mang ra quầy) + lô đã ghi trong nháp.
type DongVao = { key: string; lo_id: string; vi_tri_id: string; ton_kg: number; ton_goi: number; ma_lo: string; han_dung: string; tinh_trang: string };
const dongVao: DongVao[] = ton
  .filter(t => t.mat_hang_id === phien?.mat_hang_vao_id && t.loai_vi_tri !== 'cho_huy' && t.loai_vi_tri !== 'dang_chuyen' && t.so_kg > 0)
  .map(t => ({ key: `${t.lo_id}|${t.vi_tri_id}`, lo_id: t.lo_id, vi_tri_id: t.vi_tri_id, ton_kg: t.so_kg, ton_goi: t.so_goi,
               ma_lo: t.ma_lo, han_dung: t.han_dung, tinh_trang: t.tinh_trang_han }));
const thieu = vaoDb.filter(v => !dongVao.some(d => d.key === `${v.lo_id}|${v.vi_tri_id}`));
// Ba lượt đọc song song: mã lô + hạn dùng của lô không còn tồn; số tảng, ngày mổ, ngày ủ xong của tảng đem pha và
// tảng còn trong kho (mục chọn tảng); số tảng gốc của các lô phiên này sinh ra. Hai lượt sau đọc hỏng thì trang
// vẫn hiện mã lô như cũ, chỉ thiếu số tảng và câu nhắc.
type NgayU = { so_tang: number | null; ngay_mo: string | null; ngay_u_xong: string | null };
const [loThem, ngayU, tangRa] = await Promise.all([
  docThongTinLo(k.client, [...thieu.map(v => v.lo_id), ...raDb.map(r => r.lo_id ?? ''), ...vaoDb.map(v => v.lo_id)]),
  docNgayUTang(k.client, [...dongVao.map(d => d.lo_id), ...vaoDb.map(v => v.lo_id)]).catch(() => new Map<string, NgayU>()),
  docLoTang(k.client, raDb.map(r => r.lo_id)).catch(() => new Map<string, { tang_id: string; so_tang: number | null }>()),
]);
soTangPhien = loVaoPhien.length === 1 ? soTangChu(ngayU.get(loVaoPhien[0])?.so_tang) : '';
// Tảng đã chọn mà hôm nay (ngày Việt Nam) còn đang ủ: nhắc ở bước Cân & quét và bước Kết quả. Chỉ nhắc, không
// chặn — có lúc phải lóc sớm; người lóc cần biết mình đang làm thế.
const homNay = homNayVn();
const canhBaoU = loVaoPhien.map(id => cauTangConU(ngayU.get(id), homNay, nn)).filter((c): c is string => !!c);
/** "tảng #0001" của một tảng trong mục chọn tảng; lô không phải tảng thì rỗng. */
const tangVao = (loId: string) => chuTang(ngayU.get(loId)?.so_tang, nn);
// Ngày mổ và tình trạng ủ ở mục chọn tảng. Lô không phải tảng (không số tảng, không ngày mổ, không ngày ủ xong) → null.
const LOP_U: Record<TinhTrangU, string> = { dang_u: 'nhap', san_sang: 'song', chua_co_bang_u: 'tat' };
const uCua = (loId: string) => {
  const x = ngayU.get(loId);
  if (!x || (x.so_tang === null && !x.ngay_mo && !x.ngay_u_xong)) return null;
  const tt = tinhTrangU(x.ngay_u_xong, homNay);
  return {
    mo: x.ngay_mo ? t.moNgay(dinhDangNgay(x.ngay_mo)) : '', lop: LOP_U[tt.tinh_trang_u],
    nhan: nhanKho(TINH_TRANG_U_NB, tt.tinh_trang_u, nn), con: cauConU(tt, nn),
  };
};
for (const v of thieu) {
  const l = loThem.get(v.lo_id);
  dongVao.push({ key: `${v.lo_id}|${v.vi_tri_id}`, lo_id: v.lo_id, vi_tri_id: v.vi_tri_id, ton_kg: 0, ton_goi: 0,
                 ma_lo: l?.ma_lo ?? '—', han_dung: l?.han_dung ?? '', tinh_trang: 'het_han' });
}
dongVao.sort((a, b) => a.han_dung.localeCompare(b.han_dung) || a.ma_lo.localeCompare(b.ma_lo));
const giaLo = xemGia
  ? await docGiaVonLo(k.client, [...dongVao.map(d => d.lo_id), ...raDb.map(r => r.lo_id ?? '')])
  : new Map<string, { gia_von_kg: number; gia_tri: number }>();

const vaoTheoKey = new Map(vaoDb.map(v => [`${v.lo_id}|${v.vi_tri_id}`, v]));
const loiTheoKey = new Map((docLoi?.vao ?? []).map(v => [`${v.lo_id}|${v.vi_tri_id}`, v]));
const giaTriVao = (d: DongVao) => {
  const e = loiTheoKey.get(d.key);
  if (e) return { dung: e.dung, kg: e.so_kg, goi: e.so_goi };
  const v = vaoTheoKey.get(d.key);
  if (!v) return { dung: false, kg: '', goi: '' };
  const layHet = v.so_kg === d.ton_kg;
  return { dung: true, kg: layHet ? '' : String(v.so_kg).replace('.', ','), goi: layHet || !v.so_goi ? '' : String(v.so_goi) };
};

// Món đã quét nhãn (dòng ra tu_quet) và dòng gõ tay.
const mon = monDaQuet(raDb, nhan, tenMh);
const tongNhan = mon.reduce((s, m) => s + m.so_nhan, 0);
const raTay = raDb.filter(r => !r.tu_quet);
const daCoMon = new Set(raDb.map(r => r.mat_hang_id));
const raCo: RaForm[] = docLoi?.ra ?? (raTay.length
  ? raTay.map(r => ({
      mat_hang_id: r.mat_hang_id, so_kg: String(r.so_kg).replace('.', ','), so_goi: r.so_goi ? String(r.so_goi) : '',
      xu_ly: r.xu_ly, vi_tri_id: r.vi_tri_id ?? '', han_dung: r.han_dung ?? '',
    }))
  : dongGoTayTheoCongThuc(ctChon?.dong ?? [], tenMh, daCoMon));
// Dòng đã có trong nháp mới có ô "Bỏ dòng này"; dòng gợi ý từ công thức thì để trống kg là bỏ qua.
const soDongDaLuu = docLoi ? docLoi.ra.length : raTay.length;
const soRaMuon = Math.min(Math.max(Number(q.get('ra') ?? 0) || 0, 0), 60);
const soRaTrong = Math.max(raCo.length ? 1 : 2, soRaMuon - raCo.length);
const raHien: RaForm[] = [...raCo, ...Array.from({ length: soRaTrong }, () => raTrong(''))];

// Số kg, % (không tiền) — mọi bước. Vai xem giá thêm bản có giá vốn ở bước kết quả.
let xemThuKg: KetQuaTinhKg | null = null;
let xemThu: KetQuaTinh | null = null;
let loiXemThu: string | null = null;
if (phien && phien.trang_thai !== 'da_huy' && !loiDoc) {
  const r = await xemThuPhienKg(k.client, phien.id);
  xemThuKg = r.kq; loiXemThu = r.loi;
  if (xemGia && buoc === 'ket_qua' && vaoDb.length > 0 && raDb.length > 0) {
    const g = await xemThuPhien(k.client, phien.id);
    xemThu = g.kq; loiXemThu = loiXemThu ?? g.loi;
  }
}
const kgTheoRa = new Map((xemThuKg?.dong ?? []).map(d => [d.ra_id, d]));
const tinhTheoRa = new Map((xemThu?.dong ?? []).map(d => [d.ra_id, d]));
// So với dự kiến: phiên đã chốt dùng đúng số đã ghi lúc chốt.
const tyLeHien = phien?.trang_thai === 'da_chot' ? phien.ty_le_thu_hoi : (xemThuKg?.ty_le_thu_hoi ?? null);
const duKien = phien?.trang_thai === 'da_chot' ? phien.ty_le_du_kien : (xemThuKg?.ty_le_du_kien ?? null);
const nguonDuKien = phien?.trang_thai === 'da_chot' ? phien.nguon_du_kien : (xemThuKg?.nguon_du_kien ?? null);
const nguong = xemThuKg?.nguong_thu_hoi_diem ?? 3;
const soSanh = soSanhThuHoi(tyLeHien, duKien, nguong);
const coTheChot = vaoDb.length > 0 && raDb.length > 0;

const raQuay = buoc === 'xong' ? goiRaQuay(raDb, ton) : { lo: [], tongGoi: 0, daOQuay: 0, donVi: null, donViQuay: null };
const ten = phien ? await tenNhanSu(k.client, [phien.nguoi_tao, phien.nguoi_chot, phien.nguoi_huy, phien.da_xem_boi]) : new Map<string, string>();
// Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
const [nhanTT, lopTT] = phien
  ? ((tt: [string, string]) => [tt[0], tt[1] || 'tat'])(trangThaiKho(phien.trang_thai, nn))
  : ['—', 'tat'];
const maGuiForm = crypto.randomUUID();
const ngayPha = docLoi?.dau.ngay_pha ?? phien?.ngay_pha ?? homNayVn();
const ghiChu = docLoi?.dau.ghi_chu ?? phien?.ghi_chu ?? '';
const tieuDe = t.phien(phien?.so_phieu ?? '');
const chuaBatMaVach = !caiDat?.mau_ma_vach;
// ?ma= từ màn Quét: chỉ giữ chữ số, dấu phẩy, khoảng trắng.
const maThamSo = (q.get('ma') ?? '').replace(/[^\d,\s]/g, '').slice(0, 4000).trim();
const bienLai = (giaBan: number | null | undefined, giaVon: number) =>
  giaBan && giaBan > 0 ? dinhDangPhanTram(((giaBan - giaVon) * 100) / giaBan, 1, nn) : '—';
const soGoiMon = (m: { dem_goi: boolean; so_goi: number; so_nhan: number; don_vi_goi: string }) =>
  m.dem_goi ? `${m.so_goi} ${m.don_vi_goi}` : t.soNhan(m.so_nhan);
const kgs = (x: number | null | undefined) => dinhDangKg(x, nn);
const pt = (x: number | null | undefined) => dinhDangPhanTram(x, 1, nn);
const tien = (x: number | null | undefined) => dinhDangTien(x, nn);
const tenNguon = (ma: string) => nhanKho(TEN_NGUON_DU_KIEN_NB, ma, nn);
---
<Kho k={k} tieuDe={tieuDe} huongDan={phien?.thu_hoi_thap && k.duoc('duyet') ? 'thu-hoi-thap' : 'pha-loc'}>
  {buoc === 'can_quet' && <p class="pl-buoc">{t.buoc2}</p>}
  {buoc === 'ket_qua' && <p class="pl-buoc">{t.buoc3}</p>}
  <h1>{buoc === 'xong' ? t.daChot(phien?.so_phieu ?? '') : tieuDe}{mhVao && buoc !== 'xong' ? ` · ${mhVao.ten}` : ''}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {phien && buoc === 'xem' && (
    <p class="nb-dan">
      <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
      {' · '}{t.lapBoi(ten.get(phien.nguoi_tao ?? '') ?? '—', dinhDangThoiDiem(phien.created_at))}
      {phien.chot_luc && <>{' · '}{t.chotBoi} {ten.get(phien.nguoi_chot ?? '') ?? '—'} {dinhDangThoiDiem(phien.chot_luc)}</>}
      {phien.huy_luc && <>{' · '}{t.huyBoi} {ten.get(phien.nguoi_huy ?? '') ?? '—'} {dinhDangThoiDiem(phien.huy_luc)}</>}
    </p>
  )}
  {phien?.ly_do && buoc !== 'xong' && (
    <div class="nb-bao luu-y"><p><strong>{phien.trang_thai === 'da_huy' ? t.lyDoHuy : t.lyDoMoLai}:</strong> {phien.ly_do}</p></div>
  )}

  {!phien ? null : buoc === 'can_quet' ? (
    // =======================================================================
    // BƯỚC 2 — CÂN & QUÉT
    // =======================================================================
    <>
      {/* MỘT form cho cả bước (GĐ5e): ô quét, −1 / bỏ lượt / bỏ món và các ô gõ
          kg. Bấm nút nào máy chủ cũng lưu phần gõ tay trước (VIEC_LUU_GO_TAY_TRUOC)
          — gõ kg phụ phẩm rồi quét nhãn ngay thì số vừa gõ không mất. */}
      {canhBaoU.length > 0 && <div class="nb-bao luu-y" role="status">{canhBaoU.map(c => <p>{c}</p>)}</div>}
      {mhVao?.theo_tang && (
        <section class="nb-the" id="o-ma">
          <h2 style="margin-top:0">{t.oMaTd}{soTangPhien && <> · {t.oMaTang(soTangPhien)}</>}</h2>
          <p class="kho-phu">{t.oMaGt}</p>
          {oMaPhien.length === 0 ? <p class="nb-rong">{t.oMaChuaGiao}</p> : (
            <ul>
              {oMaPhien.map(o => <li><strong>{o.ten_hang}</strong> — {t.oMaDong(o.so_o, o.ma_can)}</li>)}
            </ul>
          )}
          {tomTatCan && <DoiChieuCan tomTat={tomTatCan} kieu="can" />}
          {/* Trang không có JavaScript: Beeftown Cân báo về kho mỗi phút (ngay sau khi tự gửi) — bấm để đọc lại. */}
          {tomTatCan?.dong.some(d => d.muc !== null && d.muc !== 'san_sang') && (
            <p><a class="nb-nut phu" href={`${DUONG}#o-ma`}>{t.oMaXemLai}</a></p>
          )}
          {loVaoPhien.length === 1 ? (
            <form method="POST" action={DUONG}>
              <button type="submit" name="viec" value="giao_o_ma" class="nb-nut phu">{t.oMaNut}</button>
            </form>
          ) : <p class="kho-phu">{t.oMaChonTang}</p>}
        </section>
      )}

      <form method="POST" action={DUONG}>
        <input type="hidden" name="ma_gui" value={maGuiLai ?? maGuiForm} />
        <input type="hidden" name="ma_gui_sua" value={crypto.randomUUID()} />
        <input type="hidden" name="phien_ban" value={String(phien.phien_ban)} />
        <input type="hidden" name="so_vao" value={String(dongVao.length)} />
        <input type="hidden" name="so_ra" value={String(raHien.length)} />

        {chuaBatMaVach ? (
          <div class="nb-bao luu-y">
            <p><strong>{t.chuaDocNhan}</strong>{t.chuaDocNhanDuoi}</p>
          </div>
        ) : (
          <div class="nb-the">
            <QuetMa nhan={t.congNhan} tuFocus giaTri={maConLai || maThamSo}
              goiY={t.quetGoiY} />
          </div>
        )}

        {xemThuKg && (
          <div class="kho-o-so-luoi">
            <div class="kho-o-so"><b>{kgs(xemThuKg.tong_kg_vao)}</b><span>{t.kgTangPha}</span></div>
            <div class="kho-o-so"><b>{kgs(xemThuKg.kg_thit + xemThuKg.kg_phu_pham + xemThuKg.kg_bo)}</b><span>{t.kgDaCan}</span></div>
            <div class="kho-o-so"><b>{pt(xemThuKg.ty_le_thu_hoi)}</b><span>{t.thuHoiTam}</span></div>
            <div class="kho-o-so"><b>{tongNhan}</b><span>{t.nhanDaQuet}</span></div>
          </div>
        )}

        <h2>{t.daQuet}</h2>
        {mon.length === 0 ? (
          <p class="nb-rong">{t.chuaQuet}</p>
        ) : (
          <>
            {mon.map(m => (
              <div class="kho-dong-hang pl-mon">
                <div class="pl-mon-chu">
                  <strong>{m.ten}</strong><br />
                  <span class="pl-so">{soGoiMon(m)} · {kgs(m.so_kg)} kg</span><br />
                  <span class="kho-phu">{t.deO(tenNoiDe(m.vi_tri_id))}</span>
                </div>
                <button type="submit" name="viec" value="bot_mot" formaction={`${DUONG}?mon=${m.mat_hang_id}`} formnovalidate
                  class="nb-nut phu pl-bot" aria-label={t.botMot(m.don_vi_goi, m.ten)}>−1</button>
              </div>
            ))}
            <div class="kho-thanh-nut">
              <button type="submit" name="viec" value="bo_luot" formnovalidate class="nb-nut phu" style="flex:1 1 12rem">{t.boLuot}</button>
            </div>
            <details class="nb-the">
              <summary style="cursor:pointer;font-weight:600">{t.boHanMon}</summary>
              <p class="kho-phu">{t.boHanGoiY}</p>
              {mon.map(m => (
                <button type="submit" name="viec" value="xoa_mon" formaction={`${DUONG}?mon=${m.mat_hang_id}`} formnovalidate
                  class="nb-nut phu kho-nut-xoa" style="width:100%;margin:.4rem 0">
                  {t.boMon(m.ten, soGoiMon(m))}
                </button>
              ))}
            </details>
          </>
        )}

        <h2 id="go-tay">{t.goTay}</h2>
        <p class="kho-phu" style="margin-top:0">{t.goTayGoiY}</p>
        {raHien.map((r, i) => {
          const mh = tenMh.get(r.mat_hang_id);
          return (
            <div class="kho-dong-hang">
              <div class="kho-luoi">
                <label class="nb-o"><span>{t.matHang}</span>
                  <ChonMatHang name={`r${i}_mat_hang`} matHang={matHang} chon={r.mat_hang_id} /></label>
                <label class="nb-o"><span>{t.soKg}</span>
                  <input type="text" inputmode="decimal" name={`r${i}_so_kg`} value={r.so_kg} placeholder={i === 0 ? t.viDu125 : undefined} /></label>
                <label class="nb-o"><span>{t.xuLy}</span>
                  <select name={`r${i}_xu_ly`}>
                    <option value="">{mh ? t.macDinh(nhanKho(TEN_XU_LY_NB, mh.xu_ly_mac_dinh, nn)) : t.macDinhMh}</option>
                    <option value="nhap_kho" selected={r.xu_ly === 'nhap_kho'}>{t.giuLai}</option>
                    <option value="chuyen_bep" selected={r.xu_ly === 'chuyen_bep'}>{t.chuyenBep}</option>
                    <option value="bo" selected={r.xu_ly === 'bo'}>{t.bo}</option>
                  </select></label>
              </div>
              <details open={!!r.han_dung || !!r.so_goi || !!r.vi_tri_id}>
                <summary>{t.themGoiY}</summary>
                <div class="kho-luoi">
                  <label class="nb-o"><span>{t.soDv(mh?.don_vi_goi ?? t.goi)}</span>
                    <input type="text" inputmode="numeric" name={`r${i}_so_goi`} value={r.so_goi} /></label>
                  <label class="nb-o"><span>{t.deODau}</span>
                    <select name={`r${i}_vi_tri`}>
                      <option value="">{t.theoMh}</option>
                      {viTriRa.map(v => <option value={v.id} selected={v.id === r.vi_tri_id}>{v.ten}</option>)}
                    </select></label>
                  <label class="nb-o"><span>{t.hanDung}</span>
                    <input type="date" name={`r${i}_hsd`} value={r.han_dung} /></label>
                </div>
                <p class="kho-phu" style="margin:.25rem 0 0">{t.hanTrong}</p>
              </details>
              {i < soDongDaLuu && (
                <label class="kho-tich"><input type="checkbox" name={`r${i}_xoa`} value="co" /> {t.boDong}</label>
              )}
            </div>
          );
        })}
        <button type="submit" name="viec" value="them_dong" class="nb-nut phu">{t.luuThemDong}</button>

        <details class="nb-the" open={vaoDb.length === 0 || (docLoi?.loi.length ?? 0) > 0} style="margin-top:1rem">
          <summary style="cursor:pointer;font-weight:600">
            {t.tangPha}{vaoDb.length === 0
              ? t.chuaChonTang
              : t.loKg(vaoDb.length, kgs(vaoDb.reduce((s, v) => s + v.so_kg, 0)))}
          </summary>
          {dongVao.length === 0 ? (
            <p class="nb-rong">{t.khongConLo(mhVao?.ten ?? '')}</p>
          ) : (
            <div class="kho-lo-chon" style="margin-top:.75rem">
              {dongVao.map((d, i) => {
                const gt = giaTriVao(d);
                const gia = giaLo.get(d.lo_id);
                const u = uCua(d.lo_id);
                return (
                  <div>
                    <input type="hidden" name={`v${i}_lo`} value={d.lo_id} />
                    <input type="hidden" name={`v${i}_vi_tri`} value={d.vi_tri_id} />
                    <div class="dau">
                      <label class="kho-tich" style="padding:0">
                        <input type="checkbox" name={`v${i}_dung`} value="co" checked={gt.dung} />
                        <b>{t.lo(d.ma_lo)}{tangVao(d.lo_id) && ` · ${tangVao(d.lo_id)}`}</b>
                      </label>
                      <span class="kho-phu">
                        {tenVt.get(d.vi_tri_id)?.ten ?? '—'} · {t.conTruoc}<strong>{kgs(d.ton_kg)} kg</strong>{t.conSau}
                        {mhVao?.dem_goi && <> · {d.ton_goi} {mhVao.don_vi_goi}</>}
                        {xemGia && gia && <> · {tien(gia.gia_von_kg)}/kg</>}
                        {' · '}<span class={`kho-han ${d.tinh_trang}`}>{t.hsd} {dinhDangNgay(d.han_dung)}</span>
                      </span>
                    </div>
                    {u && <p class="kho-phu pl-u">{u.mo && <>{u.mo}{' · '}</>}<span class={`nb-nhan ${u.lop}`}>{u.nhan}</span>{u.con && <>{' '}{u.con}</>}</p>}
                    <div class="kho-luoi">
                      <label class="nb-o"><span>{t.kgLay}</span>
                        <input type="text" inputmode="decimal" name={`v${i}_so_kg`} value={gt.kg} placeholder={t.layHet} /></label>
                      {mhVao?.dem_goi && (
                        <label class="nb-o"><span>{t.soDvLay(mhVao.don_vi_goi)}</span>
                          <input type="text" inputmode="numeric" name={`v${i}_so_goi`} value={gt.goi} /></label>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
          <p class="kho-phu">{t.tichLo(mhVao?.dem_goi ? mhVao.don_vi_goi : null)}</p>
        </details>

        <details class="nb-the">
          <summary style="cursor:pointer;font-weight:600">{t.themNgay}</summary>
          <div class="kho-luoi" style="margin-top:.75rem">
            <label class="nb-o"><span>{t.ngayPha}</span>
              <input type="date" name="ngay_pha" value={ngayPha} max={homNayVn()} required /></label>
            <label class="nb-o"><span>{t.ghiChu}</span>
              <input type="text" name="ghi_chu" value={ghiChu} maxlength="500" placeholder={t.viDuGhiChu} /></label>
            {ctCuaTang.length > 0 ? (
              <label class="nb-o"><span>{t.congThuc}</span>
                <select name="cong_thuc_id">
                  <option value="">{t.khongChon}</option>
                  {ctCuaTang.map(c => <option value={c.id} selected={c.id === ctChonId}>{c.ten}</option>)}
                </select></label>
            ) : (
              <input type="hidden" name="cong_thuc_id" value="" />
            )}
          </div>
        </details>

        <div class="kho-thanh-nut dinh">
          <button type="submit" name="viec" value="luu" class="nb-nut phu">{t.luu}</button>
          <button type="submit" name="viec" value="ket_qua" class="nb-nut">{t.luuXem}</button>
        </div>
      </form>

      <details class="nb-the" style="margin-top:1.5rem">
        <summary style="cursor:pointer;font-weight:600">{t.huyNhapNay}</summary>
        <form method="POST" action={DUONG} style="margin-top:.75rem">
          <label class="nb-o"><span>{t.lyDoKhongBuoc}</span><input type="text" name="ly_do" maxlength="500" /></label>
          <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{t.huyNhap}</button>
        </form>
      </details>
    </>
  ) : buoc === 'ket_qua' ? (
    // =======================================================================
    // BƯỚC 3 — KẾT QUẢ, CHỐT
    // =======================================================================
    <>
      {loiXemThu && <div class="nb-bao loi"><p>{dichCau(nn, loiXemThu)}</p></div>}
      {canhBaoU.length > 0 && <div class="nb-bao luu-y" role="status">{canhBaoU.map(c => <p>{c}</p>)}</div>}
      {xemThuKg && (
        <>
          <div class="kho-o-so-luoi">
            <div class={`kho-o-so ${soSanh.muc === 'thap' ? 'gap' : ''}`}><b>{pt(xemThuKg.ty_le_thu_hoi)}</b><span>{t.thuHoiThit}</span></div>
            <div class="kho-o-so"><b>{pt(xemThuKg.ty_le_du_kien)}</b><span>{t.duKien}{xemThuKg.nguon_du_kien ? ` (${tenNguon(xemThuKg.nguon_du_kien)})` : ''}</span></div>
            <div class="kho-o-so"><b>{pt(xemThuKg.ty_le_tb_30_ngay)}</b><span>{t.tb30}</span></div>
            <div class={`kho-o-so ${xemThuKg.kg_hao_hut < 0 ? 'luu-y' : ''}`}><b>{pt(phanTramCua(xemThuKg.kg_hao_hut, xemThuKg.tong_kg_vao))}</b><span>{t.haoHut(kgs(xemThuKg.kg_hao_hut))}</span></div>
          </div>
          {soSanh.muc === 'thap' && (
            <div class="nb-bao luu-y"><p>
              {t.thap1(pt(Math.abs(soSanh.chenh ?? 0)), kgs(nguong))}
              {' '}{t.thap2}
            </p></div>
          )}
          <p class="nb-dan">
            {t.tangVao}<strong>{kgs(xemThuKg.tong_kg_vao)} kg</strong>{t.thitGiu}<strong>{kgs(xemThuKg.kg_thit)} kg</strong>
            {' · '}{t.phuPhamBo(kgs(xemThuKg.kg_phu_pham), kgs(xemThuKg.kg_bo))}
          </p>
          {xemThuKg.canh_bao.length > 0 && (
            <div class="nb-bao luu-y">{xemThuKg.canh_bao.map(c => <p>{dichCau(nn, c)}</p>)}</div>
          )}
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr><th>{t.phanRa}</th><th class="so">{t.cotGoi}</th><th class="so">Kg</th><th class="so">{t.phanTramTang}</th><th>{t.diDau}</th></tr></thead>
              <tbody>
                {xemThuKg.dong.map(d => {
                  const mh = tenMh.get(d.mat_hang_id);
                  return (
                    <tr>
                      <td>{d.ten}{d.tu_quet && <span class="kho-phu">{t.quetNhan}</span>}</td>
                      <td class="so">{mh?.dem_goi && d.so_goi > 0 ? d.so_goi : '—'}</td>
                      <td class="so">{kgs(d.so_kg)}</td>
                      <td class="so">{pt(d.ty_le)}</td>
                      <td>{d.xu_ly === 'nhap_kho' ? tenNoiDe(d.vi_tri_id) : nhanKho(TEN_XU_LY_NB, d.xu_ly, nn)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="kho-phu">{t.giaiThich}</p>
        </>
      )}

      {tomTatCan && <DoiChieuCan tomTat={tomTatCan} kieu="doi_chieu" />}

      {xemGia && xemThu && (
        <details class="nb-the">
          <summary style="cursor:pointer;font-weight:600">{t.giaVonTungPhan}</summary>
          <p class="nb-dan">{t.giaVonVao}<strong>{tien(xemThu.gia_tri_vao)}</strong> ({tien(xemThu.gia_von_vao_kg)}/kg){t.chiaTheo(xemThu.chia_theo === 'gia_tri')}</p>
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr><th>{t.phanRa}</th><th class="so">Kg</th><th class="so">{t.giaVon}</th><th class="so">{t.giaVonKg}</th><th class="so">{t.giaBanKg}</th><th class="so">{t.bienLai}</th></tr></thead>
              <tbody>
                {raDb.map(r => {
                  const tinh = tinhTheoRa.get(r.id);
                  const mh = tenMh.get(r.mat_hang_id);
                  return (
                    <tr>
                      <td>{mh?.ten ?? '—'}</td>
                      <td class="so">{kgs(r.so_kg)}</td>
                      <td class="so">{tinh ? tien(tinh.gia_tri) : '—'}</td>
                      <td class="so">{tinh && r.xu_ly !== 'bo' ? tien(tinh.gia_von_kg) : '—'}</td>
                      <td class="so">{mh?.gia_ban_kg ? tien(mh.gia_ban_kg) : '—'}</td>
                      <td class="so">{tinh && tinh.nhom === 'thit' ? bienLai(mh?.gia_ban_kg, tinh.gia_von_kg) : '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="kho-phu">{t.tongGiaVon}</p>
        </details>
      )}

      {coTheChot ? (
        <form method="POST" action={DUONG} class="kho-thanh-nut dinh">
          <input type="hidden" name="phien_ban" value={String(phien.phien_ban)} />
          <a class="nb-nut phu" href={DUONG}>{t.canQuetTiep}</a>
          <button type="submit" name="viec" value="chot" class="nb-nut">{t.chotPhien}</button>
        </form>
      ) : (
        <>
          <p class="nb-rong">{vaoDb.length === 0 ? t.chuaChonTangPha : t.chuaCoPhanRa}{t.quayLaiCan}</p>
          <p><a class="nb-nut" href={DUONG}>{t.canQuet}</a></p>
        </>
      )}
      <p class="kho-phu">{t.chotGiaiThich}</p>
    </>
  ) : buoc === 'xong' ? (
    // =======================================================================
    // XONG — CHUYỂN RA QUẦY NGAY
    // =======================================================================
    <>
      <div class="kho-o-so-luoi">
        <div class={`kho-o-so ${soSanh.muc === 'thap' ? 'gap' : ''}`}><b>{pt(phien.ty_le_thu_hoi)}</b><span>{t.thuHoiThit}</span></div>
        <div class="kho-o-so"><b>{kgs(phien.tong_kg_thit)}</b><span>{t.kgThitRa}</span></div>
      </div>
      {raQuay.daOQuay > 0 && <p class="nb-dan">{t.daOQuay(raQuay.daOQuay, raQuay.donViQuay)}</p>}
      {raQuay.lo.length > 0 ? (
        <section class="nb-the">
          <h2 style="margin-top:0">{t.chuyenRaQuay(raQuay.tongGoi, raQuay.donVi)}</h2>
          <p class="nb-dan" style="margin-top:0">{t.chuyenGoiY}</p>
          <div class="pl-luoi">
            {raQuay.lo.map(l => (
              <a class="nb-nut phu pl-nut" href={l.link}>
                <b>{l.ten}</b>
                <span>{l.dem_goi && l.so_goi > 0 ? `${l.so_goi} ${l.don_vi_goi} · ` : ''}{kgs(l.so_kg)} kg · {tenNoiDe(l.vi_tri_id)}</span>
              </a>
            ))}
          </div>
        </section>
      ) : (
        <p class="nb-dan">{t.khongConPhan}</p>
      )}
      <div class="kho-thanh-nut">
        <a class="nb-nut" href="/noi-bo/kho/pha-loc/moi">{t.phaTangKhac}</a>
        <a class="nb-nut phu" href={DUONG}>{t.xemLaiPhien}</a>
      </div>
    </>
  ) : (
    // =======================================================================
    // XEM
    // =======================================================================
    <>
      {phien.trang_thai === 'da_chot' && (
        <div class="kho-o-so-luoi">
          <div class={`kho-o-so ${phien.thu_hoi_thap ? 'gap' : ''}`}><b>{pt(phien.ty_le_thu_hoi)}</b><span>{t.thuHoiThit}</span></div>
          <div class="kho-o-so"><b>{pt(phien.ty_le_du_kien)}</b><span>{t.duKien}{nguonDuKien ? ` (${tenNguon(nguonDuKien)})` : ''}</span></div>
          <div class="kho-o-so"><b>{kgs(phien.tong_kg_vao)}</b><span>{t.kgTangVao}</span></div>
          <div class="kho-o-so"><b>{kgs(phien.tong_kg_hao_hut)}</b><span>{t.kgHaoHut}</span></div>
        </div>
      )}

      {phien.trang_thai === 'da_chot' && phien.thu_hoi_thap && (
        <section class={`nb-bao ${phien.da_xem_luc ? 'xong' : 'luu-y'}`}>
          <p><strong>{t.thapDau}</strong>{t.thapChiTiet(pt(phien.ty_le_thu_hoi), pt(phien.ty_le_du_kien), kgs(nguong))}</p>
          {phien.da_xem_luc ? (
            <p>{t.daXemLuc(ten.get(phien.da_xem_boi ?? '') ?? '—', dinhDangThoiDiem(phien.da_xem_luc))}{phien.da_xem_ghi_chu ? ` — ${phien.da_xem_ghi_chu}` : ''}</p>
          ) : k.duoc('duyet') ? (
            <form method="POST" action={DUONG}>
              <label class="nb-o"><span>{t.ghiChuKhongBuoc}</span>
                <input type="text" name="ghi_chu_xem" maxlength="500" placeholder={t.viDuDaXem} /></label>
              <button type="submit" name="viec" value="da_xem" class="nb-nut">{t.daXem}</button>
            </form>
          ) : (
            <p>{t.daBaoQuanLy}</p>
          )}
        </section>
      )}
      {phien.trang_thai === 'da_chot' && !phien.thu_hoi_thap && k.duoc('duyet') && phien.da_xem_luc && (
        <p class="kho-phu">{t.daXemLuc(ten.get(phien.da_xem_boi ?? '') ?? '—', dinhDangThoiDiem(phien.da_xem_luc))}</p>
      )}

      <div class="nb-the">
        <dl class="kho-dl">
          <dt>{t.ngayPha}</dt><dd>{dinhDangNgay(phien.ngay_pha)}</dd>
          <dt>{t.tang}</dt><dd>{tenMh.get(phien.mat_hang_vao_id)?.ten ?? '—'}</dd>
          {phien.ghi_chu && <><dt>{t.ghiChu}</dt><dd>{phien.ghi_chu}</dd></>}
          {tongNhan > 0 && <><dt>{t.nhanDaQuetDt}</dt><dd>{tongNhan}</dd></>}
        </dl>
      </div>

      {tomTatCan && <DoiChieuCan tomTat={tomTatCan} kieu="doi_chieu" />}

      <h2>{t.tangDemPha}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>{t.cotLo}</th><th>{t.layO}</th><th class="so">Kg</th><th class="so">{t.soTang}</th>{xemGia && <th class="so">{t.giaVonKg}</th>}</tr></thead>
          <tbody>
            {vaoDb.map(v => (
              <tr>
                <td>{loThem.get(v.lo_id)?.ma_lo ?? '—'}{chuTang(ngayU.get(v.lo_id)?.so_tang, nn) && <>{' · '}<strong>{chuTang(ngayU.get(v.lo_id)?.so_tang, nn)}</strong></>}<br /><span class="kho-phu">{ngayU.get(v.lo_id)?.ngay_mo && <>{t.moNgay(dinhDangNgay(ngayU.get(v.lo_id)?.ngay_mo))}{' · '}</>}{t.hsd} {dinhDangNgay(loThem.get(v.lo_id)?.han_dung)}</span></td>
                <td>{tenVt.get(v.vi_tri_id)?.ten ?? '—'}</td>
                <td class="so">{kgs(v.so_kg)}</td>
                <td class="so">{v.so_goi || '—'}</td>
                {xemGia && <td class="so">{giaLo.get(v.lo_id) ? tien(giaLo.get(v.lo_id)!.gia_von_kg) : '—'}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>{t.phanCatRa}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>{t.phanRa}</th><th class="so">Kg</th><th class="so">{t.cotGoi}</th><th class="so">{t.phanTramTang}</th><th>{t.xuLy}</th><th>{t.loMoi}</th>{xemGia && <><th class="so">{t.giaVonKg}</th><th class="so">{t.bienLai}</th></>}</tr></thead>
          <tbody>
            {raDb.map(r => {
              const g = r.lo_id ? giaLo.get(r.lo_id) : undefined;
              const l = r.lo_id ? loThem.get(r.lo_id) : undefined;
              return (
                <tr>
                  <td>{tenMh.get(r.mat_hang_id)?.ten ?? '—'}{r.tu_quet && <span class="kho-phu">{t.quetNhan}</span>}</td>
                  <td class="so">{kgs(r.so_kg)}</td>
                  <td class="so">{r.so_goi || '—'}</td>
                  <td class="so">{pt(kgTheoRa.get(r.id)?.ty_le ?? null)}</td>
                  <td>{nhanKho(TEN_XU_LY_NB, r.xu_ly, nn)}{r.xu_ly === 'nhap_kho' && r.vi_tri_id ? ` · ${tenVt.get(r.vi_tri_id)?.ten ?? ''}` : ''}</td>
                  <td>{l ? <>{l.ma_lo}{chuTang(tangRa.get(r.lo_id ?? '')?.so_tang, nn) && <>{' · '}<strong>{chuTang(tangRa.get(r.lo_id ?? '')?.so_tang, nn)}</strong></>}<br /><span class="kho-phu">{t.hsd} {dinhDangNgay(l.han_dung)}</span></> : '—'}</td>
                  {xemGia && <>
                    <td class="so">{g ? tien(g.gia_von_kg) : '—'}</td>
                    <td class="so">{g ? bienLai(r.gia_ban_kg, g.gia_von_kg) : '—'}</td>
                  </>}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {phien.trang_thai === 'da_chot' && k.duoc('pha_loc') && (
        <details class="nb-the">
          <summary style="cursor:pointer;font-weight:600">{t.moLaiTieuDe}</summary>
          <p class="nb-dan" style="margin-top:.75rem">{t.moLai1}<strong>{t.moLai2}</strong>{t.moLai3}</p>
          <form method="POST" action={DUONG}>
            <label class="nb-o"><span>{t.lyDoMoLaiNhan}</span><textarea name="ly_do" required maxlength="500"></textarea></label>
            <button type="submit" name="viec" value="mo_lai" class="nb-nut kho-nut-xoa">{t.moLaiPhien}</button>
          </form>
        </details>
      )}
    </>
  )}

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/pha-loc">{t.veDanhSach}</a></p>
</Kho>

<style>
  .pl-buoc { margin: 0 0 .15rem; font-size: .85rem; font-weight: 700; color: var(--muc-nhat); }
  .pl-mon { display: flex; align-items: center; gap: .75rem; }
  /* Ngày mổ và tình trạng ủ của tảng, ngay dưới dòng lô trong mục chọn tảng. */
  .pl-u { margin: 0 0 .5rem; }
  .pl-mon-chu { flex: 1; min-width: 0; }
  .pl-so { font-size: 1.15rem; }
  .pl-bot { min-width: 64px; min-height: 48px; }
  .pl-luoi { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); margin: .5rem 0 1rem; }
  .pl-nut { width: 100%; min-height: 64px; flex-direction: column; align-items: flex-start; justify-content: center;
    gap: .2rem; text-align: left; padding: .75rem 1rem; }
  .pl-nut b { font-size: 1.1rem; }
  .pl-nut span { font-size: .9rem; font-weight: 400; }
</style>
