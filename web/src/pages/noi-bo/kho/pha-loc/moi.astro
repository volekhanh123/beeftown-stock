---
/**
 * KHO — PHA LÓC, BƯỚC 1: CHỌN TẢNG (GĐ5c, migration 0033)
 *
 * Mỗi loại tảng đang có trong kho là một NÚT, kèm tổng kg và số tảng —
 * thợ nhìn là biết, không phải mở ô chọn. Bấm nút → tạo phiên nháp ngay
 * (kho_luu_phien_pha, chưa có phần ra) rồi sang bước 2 "Cân & quét"
 * /pha-loc/<id>. Tảng chỉ nằm ở một lô thì lô đó được điền sẵn (lấy hết);
 * nhiều lô thì chọn ở bước 2. Loại tảng có đúng một công thức đang dùng thì
 * gắn luôn công thức đó (để so thu hồi dự kiến).
 *
 * Mỗi nút một form, một ma_gui riêng: bấm hai lần không mở hai phiên.
 * Còn phiên nháp đang dở thì hiện lên trước — làm tiếp, khỏi mở phiên mới.
 *
 * Chỉ kg và số tảng — không tiền (thủ kho không thấy tiền, 0031).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docCongThuc, type CongThuc } from '../../../../lib/kho/danh-muc.ts';
import { docTon, type DongTon } from '../../../../lib/kho/ton.ts';
import {
  docDanhSachPhienPha, taoPhienPha, tomTatTang, vaoMacDinh, type PhienPhaTom,
} from '../../../../lib/kho/pha-loc.ts';
import { cauLoiKho, dinhDangKg, dinhDangNgay, kqHai, laUuid, type HaiThuTieng, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('pha_loc')) return Astro.redirect('/noi-bo/kho/pha-loc', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nn = k.nn;
const CAU = {
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
// Bảng chữ tên `ch` (không phải `t`): nút tảng dùng `t` cho từng loại tảng.
const ch = dichNB(nn, {
  khongDoc: { vi: 'Không đọc được tồn kho.', en: 'Could not read the stock.' },
  tieuDe: { vi: 'Pha lóc mới', en: 'New butchery session' },
  buoc1: { vi: 'Bước 1/3 · Chọn tảng đem pha', en: 'Step 1/3 · Choose the primal to cut' },
  dangDo: { vi: 'Phiên đang dở', en: 'Sessions in progress' },
  dangDoGoiY: {
    vi: 'Đang pha dở thì bấm để làm tiếp — không cần mở phiên mới.',
    en: 'In the middle of one? Press it to carry on — no need to open a new session.',
  },
  daGhiRa: { vi: (kg: string) => `đã ghi ${kg} kg ra`, en: (kg: string) => `${kg} kg out recorded` },
  chonTang: { vi: 'Đem pha loại tảng nào?', en: 'Which primal are you cutting?' },
  chuaCoTang: { vi: 'Kho chưa có tảng nào. Tảng vào kho khi nhận hàng xong.', en: 'There are no primals in stock yet. Primals come in once goods are received.' },
  soLo: { vi: (n: number) => `${n} lô`, en: (n: number) => `${n} ${n === 1 ? 'lot' : 'lots'}` },
  motLoai: {
    vi: 'Mỗi phiên một loại tảng. Pha hai loại thì làm hai phiên — để thu hồi của từng loại không lẫn vào nhau.',
    en: 'One type of primal per session. If you cut two types, make two sessions — so their yields do not get mixed up.',
  },
  veDanhSach: { vi: '← Danh sách phiên pha lóc', en: '← Butchery sessions' },
});

let bao: KetQua | null = k.bao;
let loiDoc = k.loiDoc;
let ton: DongTon[] = [];
let congThuc: CongThuc[] = [];
let dangDo: PhienPhaTom[] = [];
try {
  [ton, congThuc, dangDo] = await Promise.all([
    docTon(k.client, cn.id), docCongThuc(k.client), docDanhSachPhienPha(k.client, cn.id, 'nhap'),
  ]);
} catch (e) {
  loiDoc = cauLoiKho(e, ch.khongDoc);
}
const tang = tomTatTang(ton);

const form = await docFormGui(Astro);
if (form) {
  const viec = String(form.get('viec') ?? '');
  const mhId = String(form.get('mat_hang_vao_id') ?? '');
  if (viec !== 'tao' || !laUuid(mhId)) {
    bao = kqHai(false, CAU.viecSai);
  } else {
    // Đúng một công thức đang dùng → gắn luôn. Nhiều công thức: để trống,
    // database tự lấy công thức đầu tiên khi tính thu hồi dự kiến.
    const ct = congThuc.filter(c => c.mat_hang_vao_id === mhId && c.dang_dung);
    const kq = await taoPhienPha(k.client, cn.id, String(form.get('ma_gui') ?? ''), mhId,
      ct.length === 1 ? ct[0].id : null, vaoMacDinh(ton, mhId));
    if (kq.ok && kq.id) return chuyenHuong(Astro, `/noi-bo/kho/pha-loc/${kq.id}`, kq);
    bao = kq;
  }
}
---
<Kho k={k} tieuDe={ch.tieuDe} huongDan="pha-loc">
  <p class="pl-buoc">{ch.buoc1}</p>
  <h1>{ch.tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {dangDo.length > 0 && (
    <section class="nb-the">
      <h2 style="margin-top:0">{ch.dangDo}</h2>
      <p class="nb-dan" style="margin-top:0">{ch.dangDoGoiY}</p>
      <div class="pl-luoi">
        {dangDo.map(p => (
          <a class="nb-nut phu pl-nut" href={`/noi-bo/kho/pha-loc/${p.id}`}>
            <b>{p.ten_mat_hang_vao}</b>
            <span>{p.so_phieu} · {dinhDangNgay(p.ngay_pha)} · {ch.daGhiRa(dinhDangKg(p.kg_ra_nhap, nn))}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <h2>{ch.chonTang}</h2>
  {tang.length === 0 ? (
    <p class="nb-rong">{ch.chuaCoTang}</p>
  ) : (
    <div class="pl-luoi">
      {tang.map(t => (
        <form method="POST">
          <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
          <input type="hidden" name="mat_hang_vao_id" value={t.mat_hang_id} />
          <button type="submit" name="viec" value="tao" class="nb-nut phu pl-nut">
            <b>{t.ten}</b>
            <span>
              {dinhDangKg(t.so_kg, nn)} kg
              {t.dem_goi && t.so_goi > 0 && <>{' · '}{t.so_goi} {t.don_vi_goi}</>}
              {t.so_lo > 1 && <>{' · '}{ch.soLo(t.so_lo)}</>}
            </span>
          </button>
        </form>
      ))}
    </div>
  )}
  <p class="kho-phu">{ch.motLoai}</p>

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/pha-loc">{ch.veDanhSach}</a></p>
</Kho>

<style>
  .pl-buoc { margin: 0 0 .15rem; font-size: .85rem; font-weight: 700; color: var(--muc-nhat); }
  /* Gọn 22/10/2026 (Khánh duyệt): nút chọn tảng nhỏ, nền phụ (không còn 17 nút đỏ), 2 cột trên điện thoại. */
  .pl-luoi { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); margin: .5rem 0 1rem; }
  .pl-luoi form { margin: 0; height: 100%; }
  .pl-nut { width: 100%; height: 100%; min-height: 56px; flex-direction: column; align-items: flex-start; justify-content: center;
    gap: .15rem; text-align: left; padding: .55rem .75rem; }
  .pl-nut b { font-size: .95rem; line-height: 1.25; }
  .pl-nut span { font-size: .8rem; font-weight: 400; }
</style>
