---
/**
 * KHO — PHA LÓC, BƯỚC 1: CHỌN TẢNG (GĐ5c, migration 0033)
 *
 * Mỗi loại tảng đang có trong kho là một NÚT, kèm tổng kg và số tảng —
 * thợ nhìn là biết, không phải mở ô chọn. Bấm nút → tạo phiên nháp ngay
 * (kho_luu_phien_pha, chưa có phần ra) rồi sang bước 2 "Cân & quét"
 * /pha-loc/<id>. Tảng chỉ nằm ở một lô thì lô đó được điền sẵn (lấy hết);
 * nhiều lô thì chọn ở bước 2. Loại tảng có đúng một công thức đang dùng thì
 * gắn luôn công thức đó (để so thu hồi dự kiến).
 *
 * Mỗi nút một form, một ma_gui riêng: bấm hai lần không mở hai phiên.
 * Còn phiên nháp đang dở thì hiện lên trước — làm tiếp, khỏi mở phiên mới.
 *
 * MÓN THEO DÕI THEO TẢNG — "LÓC #0142" MỘT CHẠM: mục "Tảng lóc được" (tảng có
 * số, không còn đang ủ, còn chỗ lóc được, chưa nằm trong phiên nháp nào —
 * tangLocDuoc, cùng luật với nút "Lóc" ở Tảng · ủ) mỗi tảng một nút. Bấm
 * (viec=loc_tang, cả từ Tảng · ủ) → locMotTang mở phiên với ĐÚNG lô đó, gắn
 * công thức khi loại tảng có một công thức, giao ô mã luôn → vào thẳng bước 2,
 * kể cả khi giao ô hỏng (câu đỏ). Không mở được thì báo ở trang đã bấm.
 *
 * Chỉ kg và số tảng — không tiền (thủ kho không thấy tiền, 0031).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, docFormGui, ketThucPost } from '../../../../lib/kho/trang.ts';
import { docCongThuc, type CongThuc } from '../../../../lib/kho/danh-muc.ts';
import { docTon, type DongTon } from '../../../../lib/kho/ton.ts';
import {
  choLocTheoLo, congThucMot, docDanhSachPhienPha, docLoCuaPhien, locMotTang, taoPhienPha, tangLocDuoc, tomTatTang, vaoMacDinh,
  type PhienPhaTom,
} from '../../../../lib/kho/pha-loc.ts';
import { cauConU, docTangTon, soTangChu, type TangTon } from '../../../../lib/kho/tang.ts';
import { cauLoiKho, dinhDangKg, dinhDangNgay, kqHai, laUuid, type HaiThuTieng } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('pha_loc')) return Astro.redirect('/noi-bo/kho/pha-loc', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nn = k.nn;
const CAU = {
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
// Bảng chữ tên `ch` (không phải `t`): nút tảng dùng `t` cho từng loại tảng.
const ch = dichNB(nn, {
  khongDoc: { vi: 'Không đọc được tồn kho.', en: 'Could not read the stock.' },
  tieuDe: { vi: 'Pha lóc mới', en: 'New butchery session' },
  buoc1: { vi: 'Bước 1/3 · Chọn tảng đem pha', en: 'Step 1/3 · Choose the primal to cut' },
  dangDo: { vi: 'Phiên đang dở', en: 'Sessions in progress' },
  dangDoGoiY: {
    vi: 'Đang pha dở thì bấm để làm tiếp — không cần mở phiên mới.',
    en: 'In the middle of one? Press it to carry on — no need to open a new session.',
  },
  daGhiRa: { vi: (kg: string) => `đã ghi ${kg} kg ra`, en: (kg: string) => `${kg} kg out recorded` },
  chonTang: { vi: 'Đem pha loại tảng nào?', en: 'Which primal are you cutting?' },
  chuaCoTang: { vi: 'Kho chưa có tảng nào. Tảng vào kho khi nhận hàng xong.', en: 'There are no primals in stock yet. Primals come in once goods are received.' },
  soLo: { vi: (n: number) => `${n} lô`, en: (n: number) => `${n} ${n === 1 ? 'lot' : 'lots'}` },
  motLoai: {
    vi: 'Mỗi phiên một loại tảng. Pha hai loại thì làm hai phiên — để thu hồi của từng loại không lẫn vào nhau.',
    en: 'One type of primal per session. If you cut two types, make two sessions — so their yields do not get mixed up.',
  },
  veDanhSach: { vi: '← Danh sách phiên pha lóc', en: '← Butchery sessions' },
  tangLoc: { vi: (n: number) => `Tảng lóc được · ${n} tảng`, en: (n: number) => `Primals you can cut · ${n}` },
  tangLocGoiY: {
    vi: 'Bấm tảng sắp lóc: phiên mở đúng tảng đó, khỏi chọn lô; ô mã giao luôn khi tảng có một công thức.',
    en: 'Press the primal you are about to cut: the session opens with that primal, no lot to choose; rotating codes are assigned right away when it has one recipe.',
  },
  loc: { vi: 'Lóc', en: 'Cut' },
  khongDocTang: {
    vi: 'Chưa đọc được danh sách tảng lóc được — tải lại trang. Vẫn mở phiên được bằng nút loại tảng ở dưới.',
    en: 'Could not read the primals you can cut — reload the page. You can still open a session with the primal type buttons below.',
  },
});

const form = await docFormGui(Astro);
const viec = form ? String(form.get('viec') ?? '') : '';
// Lượt gửi nào cũng kết thúc bằng 303 (#194, đợt 5): không ghi được thì câu lỗi đi theo cookie về chính trang — trang
// dựng lại từ database, không điền lại chữ nào của lượt gửi (mỗi nút một ma_gui mới).
const VE = Astro.url.pathname + Astro.url.search;
// "Lóc #0142" (mục Tảng lóc được ở đây, nút Lóc ở Tảng · ủ): locMotTang tự đọc lại đúng tảng đó, công thức, ô mã và
// phiên nháp ngay lúc bấm — không dùng danh sách trang đọc để hiện; đọc hỏng thì không ghi gì. Có id phiên (kể cả khi
// giao ô hỏng: câu đỏ) → vào thẳng bước 2. Không thì báo ở trang đã bấm: ve chỉ nhận đúng "tang" (Tảng · ủ).
if (form && viec === 'loc_tang') return ketThucPost(Astro, form, VE, async form => {
  const kq = await locMotTang(k.client, cn.id, { maGui: String(form.get('ma_gui') ?? ''), loId: String(form.get('lo_id') ?? '') });
  if (kq.id) return { kq, toi: `/noi-bo/kho/pha-loc/${kq.id}` };
  return { kq, toi: form.get('ve') === 'tang' ? '/noi-bo/kho/tang' : undefined };
});

// Mọi lượt POST khác (tạo phiên theo loại tảng, việc lạ, thân form hỏng): ketThucPost ngay, trước mọi lượt đọc chỉ để hiện
// trang.
if (Astro.request.method === 'POST') return ketThucPost(Astro, form, VE, async form => {
  const mhId = String(form.get('mat_hang_vao_id') ?? '');
  if (viec !== 'tao' || !laUuid(mhId)) return { kq: kqHai(false, CAU.viecSai) };
  // Tồn và công thức chỉ để chọn sẵn công thức, lượng vào (như lúc trang hiện); đọc hỏng thì gửi trống — database tự
  // chọn, như trước.
  const [ton, congThuc] = await Promise.all([docTon(k.client, cn.id), docCongThuc(k.client)])
    .catch((): [DongTon[], CongThuc[]] => [[], []]);
  // Đúng một công thức đang dùng → gắn luôn. Nhiều công thức: để trống,
  // database tự lấy công thức đầu tiên khi tính thu hồi dự kiến.
  const kq = await taoPhienPha(k.client, cn.id, String(form.get('ma_gui') ?? ''), mhId,
    congThucMot(congThuc, mhId), vaoMacDinh(ton, mhId));
  return { kq, toi: kq.ok && kq.id ? `/noi-bo/kho/pha-loc/${kq.id}` : undefined };
});

let loiDoc = k.loiDoc;
let ton: DongTon[] = [];
let dangDo: PhienPhaTom[] = [];
// Tảng lóc được: đọc hỏng (null) thì không hiện nút nào, có câu "chưa đọc được" — nút theo loại tảng vẫn dùng được.
let tangTon: TangTon[] | null = null;
try {
  [ton, dangDo, tangTon] = await Promise.all([
    docTon(k.client, cn.id), docDanhSachPhienPha(k.client, cn.id, 'nhap'),
    docTangTon(k.client, cn.id).catch(() => null),
  ]);
} catch (e) {
  loiDoc = cauLoiKho(e, ch.khongDoc);
}
const tang = tomTatTang(ton);
// Tảng đang nằm trong phiên nháp không có nút mới — phiên đó đã có ở "Phiên đang dở".
const loNhap = tangTon && !loiDoc ? await docLoCuaPhien(k.client, dangDo).catch(() => null) : null;
const tangLoc = tangTon && loNhap ? tangLocDuoc(tangTon, choLocTheoLo(ton), loNhap) : [];
const loiTangLoc = !loiDoc && (!tangTon || !loNhap);

---
<Kho k={k} tieuDe={ch.tieuDe} huongDan="pha-loc">
  <p class="pl-buoc">{ch.buoc1}</p>
  <h1>{ch.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {dangDo.length > 0 && (
    <section class="nb-the">
      <h2 style="margin-top:0">{ch.dangDo}</h2>
      <p class="nb-dan" style="margin-top:0">{ch.dangDoGoiY}</p>
      <div class="pl-luoi">
        {dangDo.map(p => (
          <a class="nb-nut phu pl-nut" href={`/noi-bo/kho/pha-loc/${p.id}`}>
            <b>{p.ten_mat_hang_vao}</b>
            <span>{p.so_phieu} · {dinhDangNgay(p.ngay_pha)} · {ch.daGhiRa(dinhDangKg(p.kg_ra_nhap, nn))}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {tangLoc.length > 0 && (
    <section class="nb-the" id="tang-loc">
      <h2 style="margin-top:0">{ch.tangLoc(tangLoc.length)}</h2>
      <p class="nb-dan" style="margin-top:0">{ch.tangLocGoiY}</p>
      <div class="pl-luoi">
        {tangLoc.map(x => (
          <form method="POST">
            <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
            <input type="hidden" name="lo_id" value={x.lo_id} />
            <button type="submit" name="viec" value="loc_tang" class="nb-nut phu pl-nut">
              <b>{ch.loc}{' '}{soTangChu(x.so_tang)}</b>
              <span>
                {x.ten_hang}{' · '}{dinhDangKg(x.kg_loc, nn)}{' kg'}
                {cauConU(x, nn) && <>{' · '}{cauConU(x, nn)}</>}
              </span>
            </button>
          </form>
        ))}
      </div>
    </section>
  )}
  {loiTangLoc && <div class="nb-bao luu-y" role="status"><p>{ch.khongDocTang}</p></div>}

  <h2>{ch.chonTang}</h2>
  {tang.length === 0 ? (
    <p class="nb-rong">{ch.chuaCoTang}</p>
  ) : (
    <div class="pl-luoi">
      {tang.map(t => (
        <form method="POST">
          <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
          <input type="hidden" name="mat_hang_vao_id" value={t.mat_hang_id} />
          <button type="submit" name="viec" value="tao" class="nb-nut phu pl-nut">
            <b>{t.ten}</b>
            <span>
              {dinhDangKg(t.so_kg, nn)} kg
              {t.dem_goi && t.so_goi > 0 && <>{' · '}{t.so_goi} {t.don_vi_goi}</>}
              {t.so_lo > 1 && <>{' · '}{ch.soLo(t.so_lo)}</>}
            </span>
          </button>
        </form>
      ))}
    </div>
  )}
  <p class="kho-phu">{ch.motLoai}</p>

  <p style="margin-top:1.5rem"><a href="/noi-bo/kho/pha-loc">{ch.veDanhSach}</a></p>
</Kho>

<style>
  .pl-buoc { margin: 0 0 .15rem; font-size: .85rem; font-weight: 700; color: var(--muc-nhat); }
  /* Gọn 22/10/2026 (Khánh duyệt): nút chọn tảng nhỏ, nền phụ (không còn 17 nút đỏ), 2 cột trên điện thoại. */
  .pl-luoi { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); margin: .5rem 0 1rem; }
  .pl-luoi form { margin: 0; height: 100%; }
  .pl-nut { width: 100%; height: 100%; min-height: 56px; flex-direction: column; align-items: flex-start; justify-content: center;
    gap: .15rem; text-align: left; padding: .55rem .75rem; }
  .pl-nut b { font-size: .95rem; line-height: 1.25; }
  .pl-nut span { font-size: .8rem; font-weight: 400; }
</style>
