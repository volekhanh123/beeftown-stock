---
/**
 * KHO — DANH SÁCH PHIÊN PHA LÓC
 *
 * Trên cùng: thu hồi bình quân 30 ngày theo từng loại tảng (tính theo kg, chỉ
 * phiên đã chốt) — con số chủ nhà hàng nhìn để biết thợ pha có đều tay không,
 * tảng của nhà cung cấp nào ra thịt tốt. Dưới: các phiên, phiên nháp lên đầu.
 *
 * Vai xem giá và vai pha lóc (thủ kho) mở được trang. Danh sách chỉ có kg và
 * % thu hồi — không có tiền (0031: thủ kho không thấy tiền).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho } from '../../../../lib/kho/trang.ts';
import { docDanhSachPhienPha, thuHoiTheoTang, type PhienPhaTom } from '../../../../lib/kho/pha-loc.ts';
import LocDanhSach from '../../../../components/kho/LocDanhSach.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { docTimDs, catTrang, dangTim } from '../../../../lib/kho/tim-ds.ts';
import {
  cauLoiKho, congNgay, dinhDangKg, dinhDangNgay, dinhDangPhanTram, homNayVn, trangThaiKho,
} from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('xem_gia') && !k.duoc('pha_loc')) return Astro.redirect('/noi-bo/kho', 302);
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tatCa: { vi: 'Tất cả', en: 'All' },
  nhap: { vi: 'Nháp', en: 'Draft' },
  daChot: { vi: 'Đã chốt', en: 'Closed' },
  daHuy: { vi: 'Đã hủy', en: 'Cancelled' },
  khongDoc: { vi: 'Không đọc được phiên pha lóc.', en: 'Could not read the butchery sessions.' },
  tieuDe: { vi: 'Pha lóc', en: 'Butchery' },
  chuaBatDau1: { vi: 'Chi nhánh chưa bắt đầu dùng kho. Vào ', en: 'This branch has not started using inventory yet. Go to ' },
  tongQuan: { vi: 'Tổng quan kho', en: 'Inventory home' },
  dan1: {
    vi: 'Mỗi lần pha: chọn tảng đem pha, quét nhãn từng gói cắt ra, gõ kg phụ phẩm và phần bỏ. Phần mềm tính ',
    en: 'Each session: choose the primal to cut, scan the label of each pack you cut, and type the kg of by-products and discards. The system works out the ',
  },
  dan2: { vi: 'tỉ lệ thu hồi', en: 'yield' },
  dan3: { vi: ' và ', en: ' and the ' },
  dan4: { vi: 'giá vốn thật mỗi kg', en: 'real cost per kg' },
  dan5: { vi: ' của từng phần. Tồn chỉ đổi khi bấm ', en: ' of each part. Stock only changes when you press ' },
  dan6: { vi: 'Chốt phiên', en: 'Close session' },
  phienMoi: { vi: 'Phiên pha mới', en: 'New butchery session' },
  thuHoi30: { vi: 'Thu hồi 30 ngày qua', en: 'Yield, last 30 days' },
  tang: { vi: 'Tảng', en: 'Primal' },
  soPhien: { vi: 'Số phiên', en: 'Sessions' },
  kgVao: { vi: 'Kg vào', en: 'Kg in' },
  kgThitRa: { vi: 'Kg thịt ra', en: 'Kg meat out' },
  thuHoi: { vi: 'Thu hồi', en: 'Yield' },
  congThuc: {
    vi: 'Thu hồi = kg thịt giữ lại (phần cắt, kể cả phần chuyển bếp) ÷ kg tảng đem pha. Không tính phụ phẩm và phần bỏ.',
    en: 'Yield = kg of meat kept (cuts, including those sent to the kitchen) ÷ kg of primal cut. By-products and discards are not counted.',
  },
  locTrangThai: { vi: 'Lọc theo trạng thái', en: 'Filter by status' },
  goiYTim: { vi: 'Số phiên, tên tảng…', en: 'Session number, primal name…' },
  hetDs: { vi: 'Hết danh sách — bấm "Trang trước".', en: 'End of the list — press "Previous".' },
  khongKhop: { vi: 'Không tìm thấy phiên nào khớp bộ lọc.', en: 'No sessions match the filters.' },
  chuaCo: { vi: 'Chưa có phiên pha lóc nào', en: 'No butchery sessions yet' },
  oTrangThai: { vi: ' ở trạng thái này', en: ' with this status' },
  thapDaXem: { vi: 'Thu hồi thấp · đã xem', en: 'Low yield · seen' },
  thap: { vi: 'Thu hồi thấp', en: 'Low yield' },
  vaoRa: {
    vi: (vao: string, thit: string) => `${vao} kg vào → ${thit} kg thịt · thu hồi `,
    en: (vao: string, thit: string) => `${vao} kg in → ${thit} kg meat · yield `,
  },
  duKien: { vi: (pt: string) => ` (dự kiến ${pt})`, en: (pt: string) => ` (expected ${pt})` },
  loVao: {
    vi: (n: number, kg: string) => `${n} lô vào (${kg} kg)`,
    en: (n: number, kg: string) => `${n} ${s(n, 'lot', 'lots')} in (${kg} kg)`,
  },
  phanRa: {
    vi: (n: number, kg: string) => `${n} phần ra (${kg} kg)`,
    en: (n: number, kg: string) => `${n} ${s(n, 'output', 'outputs')} (${kg} kg)`,
  },
});

const LOC = [['', t.tatCa], ['nhap', t.nhap], ['da_chot', t.daChot], ['da_huy', t.daHuy]] as const;
const loc = LOC.some(([v]) => v === Astro.url.searchParams.get('loc')) ? Astro.url.searchParams.get('loc')! : '';

const tim = docTimDs(Astro.url.searchParams);
let ds: PhienPhaTom[] = [];
let daChot: PhienPhaTom[] = [];
let coSau = false;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    // Bảng thu hồi 30 ngày đọc riêng các phiên đã chốt — không phụ thuộc bộ
    // lọc của danh sách (lọc "Nháp" trước đây làm bảng biến mất).
    let trang: PhienPhaTom[];
    [trang, daChot] = await Promise.all([
      docDanhSachPhienPha(k.client, k.chiNhanh.id, loc || null, { tim, nhanSuId: k.nhanSu.id }),
      tim.trang === 1 ? docDanhSachPhienPha(k.client, k.chiNhanh.id, 'da_chot') : Promise.resolve([]),
    ]);
    ({ ds, coSau } = catTrang(trang));
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}
const tu30 = congNgay(homNayVn(), -30);
const thuHoi = thuHoiTheoTang(daChot.filter(p => p.ngay_pha >= tu30));
const sapXep = [...ds].sort((a, b) => (a.trang_thai === 'nhap' ? 0 : 1) - (b.trang_thai === 'nhap' ? 0 : 1));
// Thẻ phiếu gọn hai dòng (Khánh duyệt 22/10/2026): không còn dòng người lập (xem trong phiếu), nên không đọc tên.
---
<Kho k={k} huongDan="pha-loc" tieuDe={t.tieuDe}>
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaBatDau1}<a href="/noi-bo/kho">{t.tongQuan}</a>.</p>
  ) : (
    <>
      <p class="nb-dan">
        {t.dan1}<strong>{t.dan2}</strong>{k.duoc('xem_gia') && <>{t.dan3}<strong>{t.dan4}</strong></>}{t.dan5}<em>{t.dan6}</em>.
      </p>

      {k.duoc('pha_loc') && (
        <div class="kho-nut-nhanh">
          <a class="nb-nut" href="/noi-bo/kho/pha-loc/moi">{t.phienMoi}</a>
        </div>
      )}

      {thuHoi.length > 0 && (
        <>
          <h2>{t.thuHoi30}</h2>
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead><tr><th>{t.tang}</th><th class="so">{t.soPhien}</th><th class="so">{t.kgVao}</th><th class="so">{t.kgThitRa}</th><th class="so">{t.thuHoi}</th></tr></thead>
              <tbody>
                {thuHoi.map(x => (
                  <tr>
                    <td>{x.ten}</td>
                    <td class="so">{x.so_phien}</td>
                    <td class="so">{dinhDangKg(x.kg_vao, nn)}</td>
                    <td class="so">{dinhDangKg(x.kg_thit, nn)}</td>
                    <td class="so"><strong>{dinhDangPhanTram(x.ty_le, 1, nn)}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="kho-phu" style="margin-top:-.5rem">{t.congThuc}</p>
        </>
      )}

      <nav class="kho-dh" aria-label={t.locTrangThai}>
        {LOC.map(([v, ten]) => (
          <a href={v ? `/noi-bo/kho/pha-loc?loc=${v}` : '/noi-bo/kho/pha-loc'} aria-current={loc === v ? 'page' : undefined}>{ten}</a>
        ))}
      </nav>

      <LocDanhSach duong="/noi-bo/kho/pha-loc" tim={tim} giu={{ loc }} coCuaToi={k.duoc('pha_loc')}
        goiY={t.goiYTim} />

      {sapXep.length === 0 ? (
        <p class="nb-rong">{tim.trang > 1 ? t.hetDs : dangTim(tim) ? t.khongKhop : `${t.chuaCo}${loc ? t.oTrangThai : ''}.`}</p>
      ) : sapXep.map(p => {
        // Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
        const [nhan, lopTT] = trangThaiKho(p.trang_thai, nn);
        const lop = lopTT || 'tat';
        return (
          <a href={`/noi-bo/kho/pha-loc/${p.id}`} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
            <div class="nb-dong-dau">
              <strong>{p.so_phieu} · {p.ten_mat_hang_vao}</strong>
              <span>
                {p.thu_hoi_thap && <span class={`nb-nhan ${p.da_xem_luc ? 'tat' : 'cho'}`}>{p.da_xem_luc ? t.thapDaXem : t.thap}</span>}
                {' '}<span class={`nb-nhan ${lop}`}>{nhan}</span>
              </span>
            </div>
            <p class="nb-dong-tom">
              {dinhDangNgay(p.ngay_pha)} ·{' '}
              {p.trang_thai === 'da_chot' ? (
                <>{t.vaoRa(dinhDangKg(p.tong_kg_vao, nn), dinhDangKg(p.tong_kg_thit, nn))}<strong>{dinhDangPhanTram(p.ty_le_thu_hoi, 1, nn)}</strong>{p.ty_le_du_kien !== null && <>{t.duKien(dinhDangPhanTram(p.ty_le_du_kien, 1, nn))}</>}</>
              ) : (
                <>{t.loVao(p.so_dau_vao, dinhDangKg(p.kg_vao_nhap, nn))} · {t.phanRa(p.so_dau_ra, dinhDangKg(p.kg_ra_nhap, nn))}</>
              )}
            </p>
          </a>
        );
      })}
      <PhanTrang duong="/noi-bo/kho/pha-loc" trang={tim.trang} coSau={coSau} />
    </>
  )}
</Kho>
