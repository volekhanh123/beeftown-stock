---
/**
 * KHO — CHUYỂN QUẦY, XUẤT BẾP, XUẤT KHÁC, BÁO HỦY
 *
 * Nút lớn cho các việc hằng ngày ở quầy; dưới là các phiếu gần đây. Quản lý
 * vào đây để duyệt báo hủy (ô "Chờ duyệt hủy"). Phiếu không có tiền nên nhân
 * viên quầy/bếp đọc được hết.
 *
 * "Đang mang ra" (0032): phiếu chuyển ra quầy chưa xong — đang trên đường chờ
 * quầy bấm nhận, hoặc quầy nhận thiếu chờ quản lý xử lý.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho, tenNhanSu } from '../../../../lib/kho/trang.ts';
import { docDanhSachPhieuXuat, docDonViPhieuXuat, TEN_LOAI_XUAT_NB, type PhieuXuatTom, type LoaiXuat } from '../../../../lib/kho/xuat.ts';
import { cauLoiKho, dinhDangKg, dinhDangThoiDiem, nhanKho, trangThaiKho } from '../../../../lib/kho/chung.ts';
import LocDanhSach from '../../../../components/kho/LocDanhSach.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { docTimDs, catTrang, dangTim } from '../../../../lib/kho/tim-ds.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tatCa: { vi: 'Tất cả', en: 'All' },
  choDuyetHuy: { vi: 'Chờ duyệt hủy', en: 'Write-offs to approve' },
  dangMangRa: { vi: 'Đang mang ra', en: 'On the way' },
  chuyen: { vi: 'Chuyển', en: 'Transfers' },
  xuatBep: { vi: 'Xuất bếp', en: 'To kitchen' },
  xuatKhac: { vi: 'Xuất khác', en: 'Other issues' },
  huy: { vi: 'Hủy', en: 'Write-offs' },
  traNcc: { vi: 'Trả NCC', en: 'Supplier returns' },
  khongDoc: { vi: 'Không đọc được phiếu xuất.', en: 'Could not read the issue slips.' },
  tu: { vi: (noi: string) => `từ ${noi}`, en: (noi: string) => `from ${noi}` },
  tieuDe: { vi: 'Chuyển, xuất, hủy', en: 'Transfers, issues, write-offs' },
  chuaBatDau1: { vi: 'Chi nhánh chưa bắt đầu dùng kho. Vào ', en: 'This branch has not started using inventory yet. Go to ' },
  tongQuan: { vi: 'Tổng quan kho', en: 'Inventory home' },
  nutChuyen: { vi: 'Chuyển hàng ra quầy', en: 'Transfer to counter' },
  nutXuatBep: { vi: 'Xuất bếp', en: 'Issue to kitchen' },
  nutXuatKhac: { vi: 'Xuất khác', en: 'Other issue' },
  nutBaoHuy: { vi: 'Báo hủy', en: 'Report write-off' },
  dan1: { vi: 'Hàng lấy ra theo ', en: 'Goods are taken from the ' },
  dan2: { vi: 'lô hết hạn sớm nhất trước', en: 'lot with the earliest use-by date first' },
  dan3: {
    vi: '. Hàng đã hết hạn không lên quầy, không vào bếp — chỉ báo hủy được. Báo hủy: hàng rời quầy ngay, ',
    en: '. Expired goods do not go to the counter or the kitchen — they can only be written off. Write-off: the goods leave the counter at once and are only recorded as lost after the ',
  },
  dan4: { vi: 'quản lý duyệt', en: 'manager approves' },
  dan5: {
    vi: ' mới ghi mất. Xuất khác (dùng nội bộ, tặng khách, hàng mẫu…) phải chọn lý do.',
    en: '. Other issues (staff use, gifts to guests, samples…) need a reason.',
  },
  locPhieu: { vi: 'Lọc phiếu', en: 'Filter slips' },
  goiYTim: { vi: 'Số phiếu, nơi, lý do…', en: 'Slip number, location, reason…' },
  hetDs: { vi: 'Hết danh sách — bấm "Trang trước".', en: 'End of the list — press "Previous".' },
  khongKhop: { vi: 'Không tìm thấy phiếu nào khớp bộ lọc.', en: 'No slips match the filters.' },
  chuaCo: { vi: 'Chưa có phiếu nào', en: 'No slips yet' },
  oMucNay: { vi: ' ở mục này', en: ' in this section' },
  noi: { vi: 'Nơi', en: 'Where' },
  hang: { vi: 'Hàng', en: 'Goods' },
  soDong: { vi: (n: number) => `${n} dòng`, en: (n: number) => `${n} ${s(n, 'line', 'lines')}` },
  // dv: đơn vị đếm chung của các món trên phiếu ("khay"); phiếu có món khác đơn vị thì chữ chung.
  soGoi: { vi: (n: number, dv?: string) => `${n} ${dv ?? 'gói'}`, en: (n: number, dv?: string) => `${n} ${dv ?? s(n, 'pack', 'packs')}` },
  lyDo: { vi: 'Lý do', en: 'Reason' },
  nguoiLap: { vi: 'Người lập', en: 'Made by' },
});

const LOC = [
  ['', t.tatCa], ['cho_duyet', t.choDuyetHuy], ['dang_chuyen', t.dangMangRa], ['chuyen', t.chuyen],
  ['xuat_bep', t.xuatBep], ['xuat_khac', t.xuatKhac], ['huy', t.huy], ['tra_ncc', t.traNcc],
] as const;
/** Lọc theo trạng thái (các mục còn lại lọc theo loại phiếu). */
const LOC_TRANG_THAI: Record<string, string[]> = {
  cho_duyet: ['cho_duyet'],
  dang_chuyen: ['dang_chuyen', 'nhan_thieu'],
};
const loc = LOC.some(([v]) => v === Astro.url.searchParams.get('loc')) ? Astro.url.searchParams.get('loc')! : '';

const tim = docTimDs(Astro.url.searchParams);
let ds: PhieuXuatTom[] = [];
let coSau = false;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    ({ ds, coSau } = catTrang(await docDanhSachPhieuXuat(k.client, k.chiNhanh.id, LOC_TRANG_THAI[loc]
      ? { trangThai: LOC_TRANG_THAI[loc] }
      : { loai: loc || null }, { tim, nhanSuId: k.nhanSu.id })));
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}
// Tên người lập và đơn vị đếm chung của từng phiếu ("khay") — hai lượt đọc song song.
const [ten, donVi] = await Promise.all([
  tenNhanSu(k.client, ds.map(p => p.nguoi_tao)), docDonViPhieuXuat(k.client, ds.map(p => p.id)),
]);
const moTa = (p: PhieuXuatTom) =>
  p.loai === 'chuyen' ? `${p.ten_vi_tri} → ${p.ten_vi_tri_den ?? '—'}` : t.tu(p.ten_vi_tri);
---
<Kho k={k} huongDan="chuyen-xuat" tieuDe={t.tieuDe}>
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaBatDau1}<a href="/noi-bo/kho">{t.tongQuan}</a>.</p>
  ) : (
    <>
      {k.duoc('van_hanh') && (
        <div class="kho-nut-nhanh">
          <a class="nb-nut" href="/noi-bo/kho/xuat/moi?loai=chuyen">{t.nutChuyen}</a>
          <a class="nb-nut phu" href="/noi-bo/kho/xuat/moi?loai=xuat_bep">{t.nutXuatBep}</a>
          <a class="nb-nut phu" href="/noi-bo/kho/xuat/moi?loai=xuat_khac">{t.nutXuatKhac}</a>
          <a class="nb-nut phu" href="/noi-bo/kho/xuat/moi?loai=huy">{t.nutBaoHuy}</a>
        </div>
      )}
      <p class="nb-dan">
        {t.dan1}<strong>{t.dan2}</strong>{t.dan3}<strong>{t.dan4}</strong>{t.dan5}
      </p>

      <nav class="kho-dh" aria-label={t.locPhieu}>
        {LOC.map(([v, ten]) => (
          <a href={v ? `/noi-bo/kho/xuat?loc=${v}` : '/noi-bo/kho/xuat'} aria-current={loc === v ? 'page' : undefined}>{ten}</a>
        ))}
      </nav>

      <LocDanhSach duong="/noi-bo/kho/xuat" tim={tim} giu={{ loc }} coCuaToi={k.duoc('van_hanh')}
        goiY={t.goiYTim} />

      {ds.length === 0 ? (
        <p class="nb-rong">{tim.trang > 1 ? t.hetDs : dangTim(tim) ? t.khongKhop : `${t.chuaCo}${loc ? t.oMucNay : ''}.`}</p>
      ) : ds.map(p => {
        // Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
        const [nhan, lopTT] = trangThaiKho(p.trang_thai, nn);
        const lop = lopTT || 'tat';
        return (
          <a href={`/noi-bo/kho/xuat/${p.id}`} class="nb-dong" style="display:block;text-decoration:none;color:inherit">
            <div class="nb-dong-dau">
              <strong>{p.so_phieu} · {nhanKho(TEN_LOAI_XUAT_NB, p.loai as LoaiXuat, nn)}</strong>
              <span class={`nb-nhan ${lop}`}>{nhan}</span>
            </div>
            <dl>
              <dt>{t.noi}</dt><dd>{moTa(p)}</dd>
              <dt>{t.hang}</dt><dd>{t.soDong(p.so_dong)} · {p.tong_goi ? `${t.soGoi(p.tong_goi, donVi.get(p.id))} · ` : ''}{dinhDangKg(p.tong_kg, nn)} kg</dd>
              {p.ten_ly_do && <><dt>{t.lyDo}</dt><dd>{p.ten_ly_do}</dd></>}
              <dt>{t.nguoiLap}</dt><dd>{ten.get(p.nguoi_tao ?? '') ?? '—'} · {dinhDangThoiDiem(p.created_at)}</dd>
            </dl>
          </a>
        );
      })}
      <PhanTrang duong="/noi-bo/kho/xuat" trang={tim.trang} coSau={coSau} />
    </>
  )}
</Kho>
