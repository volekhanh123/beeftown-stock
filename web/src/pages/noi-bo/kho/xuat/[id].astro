    en: (noi: string) => `. The missing part is still "On the way to the counter" — a manager chooses to return it to ${noi} (if the goods are still there) or record it as lost (dropped, missing).`,
  },
  soGoiDem: { vi: (n: number, dv: string | null) => `${n} ${dv ?? 'gói'}`, en: (n: number, dv: string | null) => `${n} ${dv ?? s(n, 'pack', 'packs')}` },
