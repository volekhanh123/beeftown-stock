  veDuyet: { vi: '← Về trang Duyệt', en: '← Back to Approvals' },
  veDanhSach: { vi: '← Danh sách phiếu', en: '← List of slips' },
  kyBaoHuy: { vi: 'Người báo hủy', en: 'Reported by' },
  kyChungKien: { vi: 'Người chứng kiến', en: 'Witness' },
  kyQuanLyDuyet: { vi: 'Quản lý duyệt', en: 'Approved by manager' },
  kyThuKho: { vi: 'Thủ kho', en: 'Storekeeper' },
  kyNccNhan: { vi: 'Nhà cung cấp nhận', en: 'Received by supplier' },
  kyKeToan: { vi: 'Kế toán', en: 'Accountant' },
  kyNguoiXuat: { vi: 'Người xuất', en: 'Issued by' },
  kyNguoiNhan: { vi: 'Người nhận', en: 'Received by' },
  kyQuanLy: { vi: 'Quản lý', en: 'Manager' },
  kyNguoiGiao: { vi: 'Người giao', en: 'Delivered by' },
});

const idThamSo = Astro.params.id ?? '';
const moi = idThamSo === 'moi';
if (moi && !k.duoc('van_hanh')) {
  return chuyenHuong(Astro, '/noi-bo/kho/xuat', kqHai(false, CAU.khongQuyen));
}

let matHang: MatHang[] = [];
let viTri: ViTri[] = [];
let lyDo: LyDo[] = [];
let caiDat: CaiDat | null = null;
let ton: DongTon[] = [];
let phieu: PhieuXuat | null = null;
let dongDb: DongXuat[] = [];
let soCai: DongSoCai[] = [];
let loiDoc = k.loiDoc;
// Đọc form TRƯỚC khi đọc database: bấm "Đọc mã" ở phiếu mới thì cần thêm ô mã, mã giảm giá và ô đang giao —
// đọc chúng cùng lượt với danh mục, không thêm lượt chờ, và không đọc ở những lần mở trang khác.
const form = await docFormGui(Astro);
const canMaNhan = moi && String(form?.get('viec') ?? '') === 'quet';
let maNhan: MaTrenNhan | null = null;
let giaoO: GiaoOMa[] = [];
try {
  [matHang, viTri, lyDo, caiDat, ton, maNhan, giaoO] = await Promise.all([
    docMatHang(k.client), docViTri(k.client, cn.id), docLyDo(k.client), docCaiDat(k.client, cn.id),
    moi ? docTon(k.client, cn.id) : Promise.resolve([] as DongTon[]),
    canMaNhan ? docMaTrenNhan(k.client) : Promise.resolve(null),
    canMaNhan ? docGiaoOMaCan(k.client, cn.id) : Promise.resolve([] as GiaoOMa[]),
  ]);
  if (!moi) {
    const doc = await docPhieuXuat(k.client, idThamSo);
    if (doc) { phieu = doc.phieu; dongDb = doc.dong; soCai = doc.soCai; }
  }
} catch (e) {
  loiDoc = cauLoiKho(e, ch.khongDoc);
}
if (!moi && !phieu && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/xuat', kqHai(false, CAU.khongThay));
}

// ---------------------------------------------------------------------------
// Loại phiếu và nơi lấy / nơi nhận (lập mới)
// ---------------------------------------------------------------------------
const q = Astro.url.searchParams;
const loai: LoaiXuat = phieu?.loai
  ?? ((LOAI_LAP_DUOC as readonly string[]).includes(q.get('loai') ?? '') ? q.get('loai') as LoaiXuat : 'chuyen');
const moHuy = loai === 'huy';
// Xuất bếp và xuất khác: chỉ hàng còn hạn, lý do là nút chọn (xuất khác bắt buộc).
const laXuatRa = loai === 'xuat_bep' || loai === 'xuat_khac';
// Bỏ "Hàng chờ hủy" và "Đang mang ra quầy" (0032) — không phải chỗ để hàng.
const dungDuoc = viTri.filter(laNoiDeHang);
const khoDau = dungDuoc.find(v => v.id === caiDat?.vi_tri_nhan_hang_id) ?? dungDuoc.find(v => v.loai === 'kho');
const quayDau = dungDuoc.find(v => v.loai === 'quay');

// Link mang sẵn lô (?lo) hay món (?mh) cần lấy.
const loThamSo = laUuid(q.get('lo')) ? q.get('lo') : null;
const mhThamSo = matHang.find(m => m.id === q.get('mh') && m.dang_dung) ?? null;

// Nơi lấy mặc định. Chuyển: từ kho. Xuất bếp / báo hủy: thủ kho làm ở Kho
// lạnh, còn nhân viên quầy (và quản lý) thường làm ở quầy.
const macDinh = (loai === 'chuyen' || vai === 'thu_kho' ? khoDau ?? quayDau : quayDau ?? khoDau) ?? dungDuoc[0] ?? null;
/** Nơi đang có hàng khớp điều kiện — ưu tiên nơi mặc định, rồi theo thứ tự vị trí. */
const noiCo = (dk: (t: DongTon) => boolean) => {
  const co = (v: ViTri) => ton.some(t => t.vi_tri_id === v.id && (t.so_kg > 0 || t.so_goi > 0) && dk(t));
  return macDinh && co(macDinh) ? macDinh : dungDuoc.find(co);
};
const tu = dungDuoc.find(v => v.id === q.get('tu'))
  ?? (loThamSo ? noiCo(t => t.lo_id === loThamSo) : undefined)
  // Đưa bếp / báo hủy một món (từ trang Quét): lấy ở chỗ đang có món đó.
  // Phiếu chuyển thì không — "mang ra quầy" luôn đi từ kho.
  ?? (mhThamSo && loai !== 'chuyen'
    ? noiCo(t => t.mat_hang_id === mhThamSo.id && (!laXuatRa || t.tinh_trang_han !== 'het_han'))
    : undefined)
  ?? macDinh;
const den = loai !== 'chuyen' ? null
  : dungDuoc.find(v => v.id === q.get('den') && v.id !== tu?.id)
    ?? dungDuoc.find(v => v.id !== tu?.id && v.loai !== tu?.loai) ?? dungDuoc.find(v => v.id !== tu?.id) ?? null;
const giuLink: Record<string, string> = {
  ...(loThamSo ? { lo: loThamSo } : {}), ...(mhThamSo ? { mh: mhThamSo.id } : {}),
};
const linkMoi = (thay: Record<string, string>) => {
  const p = new URLSearchParams({ loai, ...(tu ? { tu: tu.id } : {}), ...(den ? { den: den.id } : {}), ...giuLink, ...thay });
  return `/noi-bo/kho/xuat/moi?${p.toString()}`;
};
// Đổi loại phiếu mà vẫn giữ lô / món đang cần lấy (vd. mở "Xuất bếp" mới thấy lô đã hỏng → "Báo hủy").
const linkLoai = (l: LoaiXuat) => {
  const p = new URLSearchParams({ loai: l, ...(loThamSo && tu ? { tu: tu.id } : {}), ...giuLink });
  return `/noi-bo/kho/xuat/moi?${p.toString()}`;
};
const chiConHan = laXuatRa || (loai === 'chuyen' && den?.loai === 'quay');

// Lô và mặt hàng đang có ở nơi lấy.
const loTaiTu = ton.filter(t => t.vi_tri_id === tu?.id && (t.so_kg > 0 || t.so_goi > 0))
  .sort((a, b) => a.han_dung.localeCompare(b.han_dung) || a.ma_lo.localeCompare(b.ma_lo));
const hangTaiTu = new Set(loTaiTu.filter(t => !chiConHan || t.tinh_trang_han !== 'het_han').map(t => t.mat_hang_id));
const mhChon = matHang.filter(m => hangTaiTu.has(m.id));
// Lô mà link chỉ tới, nếu còn ở nơi lấy. Hết hạn mà phiếu chỉ nhận hàng còn hạn thì không điền được.
const loChon = loThamSo ? loTaiTu.find(t => t.lo_id === loThamSo) ?? null : null;
const loChonKhoa = !!loChon && chiConHan && loChon.tinh_trang_han === 'het_han';
// Nhân viên quầy chuyển hàng: không phải chọn lô — máy tự lấy hàng hạn gần trước.
const anTheoLo = vai === 'nhan_vien_quay' && loai === 'chuyen';
const lyDoLoai = lyDo.filter(l => l.loai === loai);
const NUT_GHI = moHuy ? CAU.guiBaoHuy : CAU.ghiPhieu;
const nutGhi = NUT_GHI[nn];
const tenMh = new Map(matHang.map(m => [m.id, m]));
// Đơn vị đếm chung của các món trên phiếu đã ghi ("khay") — cho câu "quầy nhận 8/10 khay", "đã trả 2 khay thiếu".
// Món khác đơn vị thì null: câu dùng chữ chung "gói".
const donViPhieu = donViChung(dongDb.map(d => tenMh.get(d.mat_hang_id)));
// Xuất bếp nhanh: món hay đưa bếp mà nơi lấy đang có (còn hạn).
const monNhanh = moi && loai === 'xuat_bep'
  ? (await docMonHayDungBep(k.client, cn.id)).filter(id => hangTaiTu.has(id)).map(id => tenMh.get(id)!).filter(Boolean)
  : [];

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
/** Dòng lưu ý (khung nb-bao luu-y) dưới câu báo: nhãn không đọc được, ảnh chưa tải lên... */
const luuY: string[] = [];
let dongA: DongXuatForm[] | null = null;
let dongB: DongLoForm[] | null = null;
let anhGiu: string[] = [];
let dienSanMh = false;
let ghiChuForm = '';
let lyDoForm = '';
/** Báo hủy: bước đang hiện. */
let buocHuy: BuocHuy = 'hang';
// Gửi lại form (Đọc mã, sửa lỗi) thì GIỮ ma_gui: ảnh đã tải nằm dưới ma_gui này,
// và lỡ lần trước đã ghi được mà mạng rớt thì bấm lại vẫn chỉ ra một phiếu.
const maGuiCu = String(form?.get('ma_gui') ?? '');
const maGuiForm = moi && laUuid(maGuiCu) ? maGuiCu : crypto.randomUUID();
if (form) {
  // Nút không mang "viec": nút món nhanh (them_mh) và nút lý do ở bước 2 báo hủy.
  const themMh = String(form.get('them_mh') ?? '');
  const viec = String(form.get('viec') ?? '')
    || (laUuid(themMh) ? 'them_mh' : '')
    || (moHuy && form.get('buoc') === 'ly_do' && laUuid(form.get('ly_do_id')) ? 'chon_ly_do' : '');
  ghiChuForm = String(form.get('ghi_chu') ?? '');
  lyDoForm = String(form.get('ly_do_id') ?? '');
  const coLyDo = () => lyDoLoai.some(l => l.id === lyDoForm && l.dang_dung);
  if (moi && ['quet', 'them_dong', 'them_mh', 'ghi', 'buoc_hang', 'buoc_ly_do', 'chon_ly_do'].includes(viec)) {
    if (!tu) {
      bao = kqHai(false, CAU.chuaCoNoi);
    } else if (viec === 'ghi') {
      const kq = await taoPhieuXuat(k.client, cn.id, form, { loai, viTriId: tu.id, matHang, lyDo: lyDoLoai, den });
      if (kq.ok && kq.id) return chuyenHuong(Astro, `/noi-bo/kho/xuat/${kq.id}`, kq);
      bao = { ok: false, cau: kq.cau, cauEn: kq.cauEn };
      dongA = kq.doc?.dong ?? null;
      dongB = kq.doc?.theoLo ?? null;
      anhGiu = kq.anh ?? [];
      // Bị từ chối: về đúng bước còn thiếu (hàng lỗi → bước 1, chưa lý do → bước 2).
      if (moHuy) buocHuy = buocHuySau('ghi', { hangXong: !!kq.doc && kq.doc.loi.length === 0 && kq.doc.payload.length > 0, coLyDo: coLyDo() });
    } else {
      // "Đọc mã" / "Thêm một dòng" / món nhanh / lui tới giữa các bước báo hủy:
      // vẽ lại form với đúng số đang ghi, chưa ghi gì.
      const doc = docFormPhieuXuat(form, matHang);
      dongB = doc.theoLo;
      if (moHuy) {
        const giu = await giuAnhHuy(k.client, cn.id, form, maGuiForm);
        anhGiu = giu.duongDan;
        luuY.push(...(nn === 'en' ? giu.loiEn : giu.loi));
        buocHuy = buocHuySau(viec, { hangXong: doc.loi.length === 0 && doc.payload.length > 0, coLyDo: coLyDo() });
        if (viec === 'buoc_ly_do' && buocHuy === 'hang') {
          bao = kqHai(false, doc.loi.length ? { vi: doc.loi.join(' · '), en: doc.loiEn.join(' · ') } : CAU.chuaCoHang);
        } else if (viec === 'chon_ly_do' && buocHuy === 'ly_do') {
          bao = kqHai(false, CAU.lyDoNgung);
        }
      }
      if (viec === 'them_mh') {
        // Món nhanh: thêm một dòng món đó (đã có thì thôi) — dòng đó là dòng để ghi số.
        dongA = doc.dong.some(d => d.mat_hang_id === themMh)
          ? doc.dong : [...doc.dong, { mat_hang_id: themMh, so_goi: '', so_kg: '' }];
        dienSanMh = true;
      } else if (viec !== 'quet') {
        dongA = doc.dong;
      } else {
        // Nhãn mã ô của một tảng: ghi vào đúng lô của tảng đó khi lô còn đủ ở nơi lấy; không thì ghi theo món.
        const quet = dongTuQuet(String(form.get('ma_quet') ?? ''), matHang, caiDat?.mau_ma_vach, caiDat?.so_le_kg ?? 3, {
          maNhan,
          datLo: { giao: giaoO, lo: loTaiTu, tonKhac: ton, tenNoiLay: tu.ten, chiConHan, homNay: homNayVn(), dong: doc.dong, theoLo: doc.theoLo },
        });
        // Món vừa vào lô của tảng: bỏ dòng theo món còn trống số của chính món đó (phiếu mở sẵn món rồi mới quét).
        const gop = gopKetQuaQuet(doc.dong, doc.theoLo, quet);
        dongA = gop.dong;
        dongB = gop.theoLo;
        // Câu báo đi qua cookie khi chuyển trang: dựng cả hai thứ tiếng (tham số nn = thứ tiếng của câu).
        const cauDaDoc = (nn: NgonNguNB) => CAU_DA_DOC[nn](
          quet.soDoc, tomTatHang([...quet.dong, ...quet.theoLo], matHang, 3, nn), quet.cauDatLo?.[nn] ?? '', NUT_GHI[nn]);
        bao = quet.soMa === 0
          ? kqHai(false, CAU.oQuetTrong)
          : quet.soDoc > 0
            ? kqHai(true, { vi: cauDaDoc('vi'), en: cauDaDoc('en') })
            // Đọc được nhãn nhưng không nhãn nào được ghi (lô đã hết hạn): không nói "chưa đọc được".
            : kqHai(false, quet.soHetHan > 0 ? CAU.chuaGhiNhan : CAU.chuaDocNhan);
        luuY.unshift(...(nn === 'en' ? quet.loiEn : quet.loi));
        // Món vừa quét mà cũng đang có số ở phần lô: báo ngay, đừng đợi bấm ghi mới bị chặn.
        const coOLo = new Set(doc.theoLo.filter(l => l.so_goi || l.so_kg).map(l => l.mat_hang_id));
        for (const d of quet.dong) {
          if (coOLo.has(d.mat_hang_id)) luuY.push(ch.vuaQuetCoLo(tenMh.get(d.mat_hang_id)?.ten));
        }
        // Mã cân lạ: chỉ người sửa được danh mục mới thấy mã và chỗ sửa.
        if (quet.maCanLa.length > 0 && k.duoc('danh_muc')) {
          luuY.push(ch.maCanLa(quet.maCanLa.join(', '), quet.maCanLa.length));
        }
      }
    }
  } else if (phieu) {
    let kq: KetQua;
    const lyDoGo = String(form.get('ly_do') ?? '').trim();
    if (viec === 'duyet') kq = await duyetHuy(k.client, phieu.id);
    else if (viec === 'tu_choi') kq = await tuChoiHuy(k.client, phieu.id, lyDoGo);
    else if (viec === 'tra_ve' || viec === 'ghi_mat') {
      // Hàng đi đường nhận thiếu: xong thì ở lại phiếu để thấy kết quả. Câu database viết "N gói" — đổi sang
      // đơn vị của món trên phiếu ("2 khay thiếu") ở web, cả hai thứ tiếng.
      kq = doiDonViCau(await xuLyChuyenThieu(k.client, phieu.id, viec === 'tra_ve' ? 'tra_ve' : 'mat', lyDoGo), donViPhieu);
      return chuyenHuong(Astro, `/noi-bo/kho/xuat/${phieu.id}`, kq);
    } else if (viec === 'huy_chuyen') {
      kq = doiDonViCau(await huyChuyenDiDuong(k.client, phieu.id, lyDoGo), donViPhieu);
      return chuyenHuong(Astro, `/noi-bo/kho/xuat/${phieu.id}`, kq);
    } else if (viec === 'huy_tra') {
      // Trả hàng NCC còn chờ kế toán xác nhận tiền (0040): hàng về lại chỗ cũ.
      return chuyenHuong(Astro, `/noi-bo/kho/xuat/${phieu.id}`, await huyTraHangChoTien(k.client, phieu.id, lyDoGo));
    } else kq = kqHai(false, CAU.viecSai);
    // Duyệt / từ chối xong: về hộp Duyệt, phiếu kế tiếp nằm sẵn ở đó. Lỗi thì ở lại phiếu này.
    return chuyenHuong(Astro, kq.ok ? '/noi-bo/kho/duyet' : `/noi-bo/kho/xuat/${phieu.id}`, kq);
  } else {
    bao = kqHai(false, CAU.viecSai);
  }
} else if (moi) {
  // Mở từ link: điền sẵn. Gửi form rồi thì luôn giữ đúng số người dùng đã ghi.
  if (loChon && !loChonKhoa) {
    dongB = [{
      lo_id: loChon.lo_id, mat_hang_id: loChon.mat_hang_id,
      so_goi: loChon.dem_goi && loChon.so_goi > 0 ? String(loChon.so_goi) : '',
      so_kg: loChon.dem_goi ? '' : String(loChon.so_kg).replace('.', ','),
    }];
  } else if (loThamSo && !loChon && tu) {
    luuY.push(ch.loKhongCon(tu.ten));
  }
  if (mhThamSo && loChon?.mat_hang_id !== mhThamSo.id) {
    dongA = [{ mat_hang_id: mhThamSo.id, so_goi: '', so_kg: '' }];
    dienSanMh = true;
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const lyDoChon = lyDoLoai.filter(l => l.dang_dung || l.id === lyDoForm);
// Một dòng trống để ghi thêm (trước là 2–4 dòng). Link đã chọn sẵn món thì
// chính dòng đó là dòng để ghi.
const dongHienA: DongXuatForm[] = [
  ...(dongA ?? []),
  ...(dienSanMh ? [] : [{ mat_hang_id: '', so_goi: '', so_kg: '' }]),
];
const theoLoCu = new Map((dongB ?? []).map(l => [l.lo_id, l]));
const loCoSo = new Set((dongB ?? []).filter(l => l.so_goi || l.so_kg).map(l => l.lo_id));
// Lô link chọn sẵn lên đầu, rồi tới lô đang có số (vừa quét nhãn của tảng đó, hay gõ tay) — khỏi phải dò trong
// danh sách dài. Nhân viên quầy chuyển hàng chỉ thấy lô đã chọn / đang có số.
// Báo hủy (Khánh duyệt 22/10/2026): lô hết hạn rồi sắp hết hạn lên đầu (hạn gần trước); lô còn hạn xa nằm trong
// mục gập "Xem mọi lô khác" — vẫn ở trong form (ô số vẫn gửi đi), chỉ không bày ra.
const MUC_HAN_LO: Record<DongTon['tinh_trang_han'], number> = { het_han: 0, sap_het: 1, con_han: 2 };
const loHien = (anTheoLo ? loTaiTu.filter(t => t.lo_id === loChon?.lo_id || loCoSo.has(t.lo_id)) : loTaiTu)
  .slice().sort((a, b) => Number(b.lo_id === loChon?.lo_id) - Number(a.lo_id === loChon?.lo_id)
    || Number(loCoSo.has(b.lo_id)) - Number(loCoSo.has(a.lo_id))
    || (moHuy ? MUC_HAN_LO[a.tinh_trang_han] - MUC_HAN_LO[b.tinh_trang_han] || a.han_dung.localeCompare(b.han_dung) : 0));
const hienTheoLo = !anTheoLo || loHien.length > 0;
/** Số lô bày ra trước mục "Xem mọi lô khác": báo hủy = lô đã chọn / có số / hết hoặc sắp hết hạn; loại khác = tất cả. */
const soLoDau = moHuy
  ? loHien.filter(t => t.lo_id === loChon?.lo_id || loCoSo.has(t.lo_id) || t.tinh_trang_han !== 'con_han').length
  : loHien.length;

// Ảnh báo hủy: lý do nào cần ảnh, nói bằng chữ ngay dưới ô ảnh.
const lyDoDung = lyDoChon.filter(l => l.dang_dung);
const lyDoCanAnh = lyDoDung.filter(l => l.can_anh);
const moiLyDoCanAnh = lyDoDung.length > 0 && lyDoCanAnh.length === lyDoDung.length;
const lyDoDangChon = lyDoChon.find(l => l.id === lyDoForm) ?? null;
const canAnh = moHuy && (lyDoDangChon ? lyDoDangChon.can_anh : moiLyDoCanAnh);
const anhLinkGiu = anhGiu.length ? await linkAnh(k.client, anhGiu) : new Map<string, string>();

// Báo hủy bước 2, 3: hàng và lý do đã chọn đi theo dưới dạng ô ẩn.
const hienHang = !moHuy || buocHuy === 'hang';
const dongGiu = (dongA ?? []).filter(d => d.mat_hang_id || d.so_goi || d.so_kg);
const loGiu = (dongB ?? []).filter(l => l.so_goi || l.so_kg);
const tomTatGiu = tomTatHang([...dongGiu, ...loGiu], matHang, 6, nn) || ch.chuaCoHangNgan;
const BUOC_HUY: [BuocHuy, string][] = [['hang', ch.buocHang], ['ly_do', ch.buocLyDo], ['anh', ch.buocAnh]];

// Mã lô của phiếu đã ghi và số tảng của mọi lô đang hiện (phiếu mới: các lô ở nơi lấy) — hai lượt đọc song song.
// Số tảng đọc hỏng thì trang vẫn hiện mã lô như cũ.
const loDangHien = phieu ? [...soCai.map(s => s.lo_id), ...dongDb.map(d => d.lo_id ?? '')] : loTaiTu.map(t => t.lo_id);
const [loTheoMa, soTangLo] = await Promise.all([
  phieu ? docThongTinLo(k.client, loDangHien) : Promise.resolve(new Map() as Awaited<ReturnType<typeof docThongTinLo>>),
  docLoTang(k.client, loDangHien).catch(() => new Map<string, { tang_id: string; so_tang: number | null }>()),
]);
/** "tảng #0001" của một lô; lô không thuộc tảng nào thì rỗng. */
const tangChu = (loId: string | null | undefined) => chuTang(soTangLo.get(loId ?? '')?.so_tang, nn);
/** Lô của món đếm theo cái (0105): kg của nó là số cái — không hiện, không cộng vào kg. */
const laCaiLo = (loId: string | null | undefined) => !!tenMh.get(loTheoMa.get(loId ?? '')?.mat_hang_id ?? '')?.dem_theo_cai;
/** " · tảng #0001" để nối ngay sau mã lô. */
const tangCua = (loId: string | null | undefined) => (tangChu(loId) ? ` · ${tangChu(loId)}` : '');
const ten = phieu ? await tenNhanSu(k.client, [phieu.nguoi_tao, phieu.nguoi_duyet, phieu.nguoi_nhan, phieu.nguoi_xu_ly]) : new Map<string, string>();
const anhLink = phieu ? await linkAnh(k.client, phieu.anh) : new Map<string, string>();
// Phiếu trả hàng: quay lại công nợ của đúng nhà cung cấp (trang Công nợ chỉ
// vai kế toán — kế toán, quản lý, chủ — mở được; thủ kho xem giá nhưng không vào đó).
const nccTra = phieu?.loai === 'tra_ncc' && k.duoc('ke_toan')
  ? await docNhaCungCapCuaPhieuNhap(k.client, phieu.phieu_nhap_id) : null;
// Trả hàng hai bước (0040): phiếu còn chờ kế toán xác nhận tiền thì người ghi,
// kế toán hoặc quản lý hủy được (database kiểm lại quyền).
const huyTraDuoc = phieu?.loai === 'tra_ncc' && phieu.trang_thai === 'cho_xac_nhan_tien'
  && (phieu.nguoi_tao === k.nhanSu.id || k.duoc('ke_toan') || k.duoc('duyet'));
// Trạng thái lạ: hiện nguyên mã, màu xám (như trước).
const [nhanTT, lopTT] = phieu
  ? ((tt: [string, string]) => [tt[0], tt[1] || 'tat'])(trangThaiKho(phieu.trang_thai, nn))
  : [ch.moi, 'nhap'];
const tenLoai = nhanKho(TEN_LOAI_XUAT_NB, loai, nn);
const tieuDe = moi ? tenLoai : `${tenLoai} ${phieu?.so_phieu ?? ''}`;
const choToiDuyet = phieu?.trang_thai === 'cho_duyet' && k.duoc('duyet');
// Phiếu chuyển đi đường (0032): nút nào hiện cho người đang xem.
const nut = phieu
  ? nutPhieuChuyen(phieu, { id: k.nhanSu.id, duyet: k.duoc('duyet'), vanHanh: k.duoc('van_hanh') })
  : { huyChuyen: false, xuLyThieu: false, diNhan: false };
const diDuong = phieu?.loai === 'chuyen'
  && (['dang_chuyen', 'da_nhan', 'nhan_thieu', 'da_tra_ve', 'da_huy'].includes(phieu.trang_thai) || !!phieu.nhan_luc);
const coCotNhan = dongDb.some(d => d.so_goi_nhan !== null || d.so_kg_nhan !== null);
// Phần thiếu đã trả về / ghi mất (sổ của chính phiếu này).
const traVe = soCai.filter(s => s.loai === 'chuyen_den' && s.vi_tri_id === phieu?.vi_tri_id);
const ghiMat = soCai.filter(s => s.loai === 'hao_hut');
const congGoi = (ds: DongSoCai[]) => Math.abs(ds.reduce((t, x) => t + x.so_goi, 0));
const congKg = (ds: DongSoCai[]) => Math.abs(ds.reduce((t, x) => t + x.so_kg, 0));
// Nút "?": việc chính của màn này với người đang xem (lib/kho/huong-dan.ts).
const huongDan = choToiDuyet ? 'duyet-huy'
  : nut.xuLyThieu ? 'nhan-thieu'
  : loai === 'huy' ? 'bao-huy'
  : loai === 'xuat_bep' ? 'xuat-bep'
  : loai === 'xuat_khac' ? 'xuat-khac'
  : loai === 'tra_ncc' ? (k.duoc('ke_toan') ? 'tra-ncc' : 'tra-hang')
  : vai === 'nhan_vien_quay' ? (moi ? 'tu-lay-hang' : 'nhan-ra-quay')
  : 'ra-quay';
// Sổ của phiếu: chỉ các dòng rời nơi lấy (chuyển đi / xuất bếp) — đủ để biết lô nào.
const soCaiLay = soCai.filter(s => s.vi_tri_id === phieu?.vi_tri_id && ['chuyen_di', 'xuat_bep', 'xuat_khac', 'tra_ncc'].includes(s.loai));
const daHuy = soCai.filter(s => s.loai === 'huy');
---
<Kho k={k} tieuDe={tieuDe} huongDan={huongDan}>
  <h1>{tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  {!moi && phieu && (
    <>
      <InDau tieuDe={(TIEU_DE_IN[phieu.loai] ?? TIEU_DE_IN_KHAC)[nn]}
        soPhieu={phieu.so_phieu} chiNhanh={k.chiNhanh?.ten} />
      <NutIn chu={phieu.loai === 'huy' ? ch.inBienBan : ch.inPhieu} />
    </>
  )}
  {luuY.length > 0 && (
    <div class="nb-bao luu-y" role="status">{luuY.map(c => <p>{c}</p>)}</div>
  )}

  {moi ? (
    <>
      {hienHang && (
        <>
          <nav class="kho-dh" aria-label={ch.loaiPhieu}>
            {LOAI_LAP_DUOC.map(l => (
              <a href={linkLoai(l)} aria-current={l === loai ? 'page' : undefined}>{nhanKho(TEN_LOAI_XUAT_NB, l, nn)}</a>
            ))}
          </nav>
          <div class="nb-the">
            <p style="margin:0 0 .4rem"><strong>{ch.layTu}</strong></p>
            <nav class="kho-dh" aria-label={ch.noiLay} style="margin:0;padding-bottom:.5rem">
              {dungDuoc.map(v => <a href={linkMoi({ tu: v.id, den: den?.id === v.id ? '' : (den?.id ?? '') })} aria-current={v.id === tu?.id ? 'page' : undefined}>{v.ten}</a>)}
            </nav>
            {loai === 'chuyen' && (
              <>
                <p style="margin:.4rem 0"><strong>{ch.duaDen}</strong></p>
                <nav class="kho-dh" aria-label={ch.noiNhan} style="margin:0;padding-bottom:0">
                  {dungDuoc.filter(v => v.id !== tu?.id).map(v => <a href={linkMoi({ den: v.id })} aria-current={v.id === den?.id ? 'page' : undefined}>{v.ten}</a>)}
                </nav>
              </>
            )}
          </div>
        </>
      )}

      {moHuy && (
        <ol class="xh-buoc" aria-label={ch.cacBuocHuy}>
          {BUOC_HUY.map(([b, ten], i) => <li aria-current={b === buocHuy ? 'step' : undefined}>{i + 1} · {ten}</li>)}
        </ol>
      )}

      {loChonKhoa && loChon && (
        <div class="nb-bao luu-y" role="status">
          <p>
            {ch.loHetHan(`${loChon.ma_lo}${tangCua(loChon.lo_id)}`, loChon.ten_hang, loai)}{' '}
            <a href={`/noi-bo/kho/xuat/moi?loai=huy&tu=${loChon.vi_tri_id}&lo=${loChon.lo_id}`}>{ch.baoHuyLoNay}</a>
          </p>
        </div>
      )}

      {!tu || (loai === 'chuyen' && !den) ? (
        <p class="nb-rong">{ch.canViTri(loai === 'chuyen')}</p>
      ) : (
        <form method="POST" enctype="multipart/form-data">
          <input type="hidden" name="ma_gui" value={maGuiForm} />
          {den && <input type="hidden" name="vi_tri_den_id" value={den.id} />}
          {moHuy && <input type="hidden" name="buoc" value={buocHuy} />}
          {anhGiu.map(d => <input type="hidden" name="anh_da_tai" value={d} />)}

          {hienHang ? (
            <>
              <input type="hidden" name="so_dong" value={String(dongHienA.length)} />
              <input type="hidden" name="so_lo" value={String(hienTheoLo ? loHien.length : 0)} />
              <p class="nb-dan">
                {loai === 'chuyen' && <>{ch.chuyenTu}<strong>{tu.ten}</strong>{ch.sang}<strong>{den?.ten}</strong>.</>}{' '}
                {loai === 'xuat_bep' && <>{ch.xuatBepTu}<strong>{tu.ten}</strong>.</>}{' '}
                {loai === 'xuat_khac' && <>{ch.xuatTu}<strong>{tu.ten}</strong>{ch.xuatKhacDuoi}</>}{' '}
                {loai === 'huy' && <>{ch.baoHuyO}<strong>{tu.ten}</strong>{ch.baoHuyDuoi}</>}
                {chiConHan && <>{ch.boQua1}<strong>{ch.boQua2}</strong>{ch.boQua3}</>}
              </p>

              <h2>{moHuy ? ch.hangCanHuy : ch.hangLayRa}</h2>
              <QuetMa tuFocus />
              {monNhanh.length > 0 && (
                <div class="xb-nhanh">
                  <p class="kho-phu" style="margin:.5rem 0 .4rem">{ch.monHayDua}</p>
                  <div class="xb-nhanh-luoi">
                    {monNhanh.map(m => (
                      <button type="submit" name="them_mh" value={m.id} class="nb-nut phu" formnovalidate>{m.ten}</button>
                    ))}
                  </div>
                </div>
              )}
              <p class="kho-phu">{ch.khongQuetDuoc}</p>
              {dongHienA.map((d, i) => (
                <div class="kho-dong-hang">
                  <span class="so-thu-tu">{i + 1}</span>
                  <label class="nb-o" style="margin-top:.4rem"><span>{ch.matHang}</span>
                    <ChonMatHang name={`d${i}_mat_hang`} matHang={mhChon.length ? [...mhChon, ...matHang.filter(m => m.id === d.mat_hang_id && !hangTaiTu.has(m.id))] : matHang} chon={d.mat_hang_id} trong={mhChon.length ? ch.chonMatHang : ch.noiTrong} demCai={loai !== 'chuyen'} />
                  </label>
                  {/* 0105: chọn món đếm theo cái (sốt, đồ uống) thì CSS :has() giấu ô kg, nhãn thành "Số chai, lon…".
                      Phiếu mang ra quầy không có các món này (để một chỗ, không chuyển). */}
                  <div class="kho-luoi">
                    <label class="nb-o"><span class="xb-nhan-goi">{ch.soGoi}</span><span class="xb-nhan-cai">{ch.soCai}</span>
                      <input type="text" inputmode="numeric" name={`d${i}_so_goi`} value={d.so_goi} /></label>
                    <label class="nb-o xb-chi-thit"><span>{ch.soKg}</span>
                      <input type="text" inputmode="decimal" name={`d${i}_so_kg`} value={d.so_kg} placeholder={i === 0 ? ch.goiYKg : undefined} /></label>
                  </div>
                </div>
              ))}
              <div class="kho-thanh-nut" style="margin-top:0">
                <button type="submit" name="viec" value="them_dong" class="nb-nut phu" formnovalidate>{ch.themDong}</button>
              </div>

              {/* Gập sẵn (22/10/2026): quét nhãn hoặc chọn món ở trên là đủ; mở sẵn khi đi từ nút của một lô. */}
              {hienTheoLo && (
                <details open={!!loChon || loCoSo.size > 0}>
                  <summary style="cursor:pointer;font-weight:600;padding:.5rem 0">{anTheoLo ? ch.loDaChon : moHuy ? ch.chonLoHuy : ch.hoacChonLo}</summary>
                  <p class="kho-phu" style="margin-top:0">{ch.motCho}</p>
                  {loHien.length === 0 ? (
                    <p class="nb-rong">{ch.khongCoHang(tu.ten)}</p>
                  ) : (() => {
                    // Một lô = một hàng gọn: tên, rồi "lô · còn · HSD", rồi ô số. Chỉ số i chạy liền qua cả hai nhóm.
                    const dongLo = (t: DongTon, i: number) => {
                      const cu = theoLoCu.get(t.lo_id);
                      const khoa = chiConHan && t.tinh_trang_han === 'het_han';
                      return (
                        <div>
                          <input type="hidden" name={`l${i}_lo`} value={t.lo_id} />
                          <input type="hidden" name={`l${i}_mat_hang`} value={t.mat_hang_id} />
                          <div class="dau">
                            <b>{t.ten_hang}</b>
                            <span class="kho-phu">{ch.lo} {t.ma_lo}{tangChu(t.lo_id) && <>{' · '}<strong>{tangChu(t.lo_id)}</strong></>} · {ch.conTruoc}{laDemCai({ loai: t.loai_hang }) ? `${t.so_goi} ${t.don_vi_goi}` : <>{t.dem_goi ? `${t.so_goi} ${t.don_vi_goi} · ` : ''}{dinhDangKg(t.so_kg, nn)} kg</>}{ch.conSau} ·{' '}
                              <span class={`kho-han ${t.tinh_trang_han}`}>{chuTinhTrangHan(t.tinh_trang_han, nn)}{' · '}{ch.hsd} {dinhDangNgay(t.han_dung)}</span></span>
                          </div>
                          {khoa ? (
                            <p class="kho-phu" style="margin:.2rem 0 .6rem">{ch.chiBaoHuy}</p>
                          ) : (
                            <div class="kho-luoi">
                              {t.dem_goi && (
                                <label class="nb-o"><span>{ch.soDv(t.don_vi_goi)}</span>
                                  <input type="text" inputmode="numeric" name={`l${i}_so_goi`} value={cu?.so_goi ?? ''} /></label>
                              )}
                              {!laDemCai({ loai: t.loai_hang }) && (
                                <label class="nb-o"><span>{ch.soKg}{t.dem_goi ? ch.neuCan : ''}</span>
                                  <input type="text" inputmode="decimal" name={`l${i}_so_kg`} value={cu?.so_kg ?? ''} /></label>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    };
                    return (
                      <>
                        {soLoDau > 0 && <div class="kho-lo-chon">{loHien.slice(0, soLoDau).map((t, i) => dongLo(t, i))}</div>}
                        {soLoDau < loHien.length && (
                          <details class="xh-lo-them" open={soLoDau === 0}>
                            <summary>{ch.xemLoKhac(loHien.length - soLoDau)}</summary>
                            <div class="kho-lo-chon">{loHien.slice(soLoDau).map((t, j) => dongLo(t, soLoDau + j))}</div>
                          </details>
                        )}
                      </>
                    );
                  })()}
                </details>
              )}
            </>
          ) : (
            // Báo hủy bước 2, 3: hàng đã ghi ở bước 1 đi theo dưới dạng ô ẩn.
            <>
              <input type="hidden" name="so_dong" value={String(dongGiu.length)} />
              {dongGiu.map((d, i) => (
                <>
                  <input type="hidden" name={`d${i}_mat_hang`} value={d.mat_hang_id} />
                  <input type="hidden" name={`d${i}_so_goi`} value={d.so_goi} />
                  <input type="hidden" name={`d${i}_so_kg`} value={d.so_kg} />
                </>
              ))}
              <input type="hidden" name="so_lo" value={String(loGiu.length)} />
              {loGiu.map((l, i) => (
                <>
                  <input type="hidden" name={`l${i}_lo`} value={l.lo_id} />
                  <input type="hidden" name={`l${i}_mat_hang`} value={l.mat_hang_id} />
                  <input type="hidden" name={`l${i}_so_goi`} value={l.so_goi} />
                  <input type="hidden" name={`l${i}_so_kg`} value={l.so_kg} />
                </>
              ))}
              <div class="nb-the">
                <p style="margin:0">{ch.huyO}<strong>{tu.ten}</strong>: {tomTatGiu}.</p>
                {buocHuy === 'anh' && lyDoDangChon && <p style="margin:.4rem 0 0">{ch.lyDoHai}<strong>{lyDoDangChon.ten}</strong></p>}
                <div class="kho-thanh-nut" style="margin:.6rem 0 0">
                  <button type="submit" name="viec" value="buoc_hang" class="nb-nut phu" formnovalidate>{ch.suaHang}</button>
                  {buocHuy === 'anh' && <button type="submit" name="viec" value="buoc_ly_do" class="nb-nut phu" formnovalidate>{ch.doiLyDo}</button>}
                </div>
              </div>
            </>
          )}

          {moHuy && buocHuy === 'ly_do' && (
            <>
              <h2>{ch.viSaoHuy}</h2>
              {lyDoDung.length === 0 ? (
                <p class="nb-rong">{ch.chuaCoLyDoHuy}</p>
              ) : (
                <div class="xh-ly-do-luoi">
                  {lyDoDung.map(l => (
                    <button type="submit" name="ly_do_id" value={l.id} class={`nb-nut ${l.id === lyDoForm ? '' : 'phu'}`}
                      aria-pressed={l.id === lyDoForm ? 'true' : 'false'}>
                      {l.ten}{l.can_anh && <small>{ch.canChupAnh}</small>}
                    </button>
                  ))}
                </div>
              )}
            </>
          )}
          {/* Lý do đã chọn đi theo khi ở bước 1 và bước 3 (bước 2 là các nút chọn lại). */}
          {moHuy && buocHuy !== 'ly_do' && laUuid(lyDoForm) && <input type="hidden" name="ly_do_id" value={lyDoForm} />}
          {moHuy && buocHuy !== 'anh' && <input type="hidden" name="ghi_chu" value={ghiChuForm} />}

          {(!moHuy || buocHuy === 'anh') && (
            <div class="nb-the">
              {laXuatRa && (
                <fieldset class="xk-chon">
                  <legend>{ch.lyDo}{loai === 'xuat_khac' ? ' *' : ''}</legend>
                  {loai === 'xuat_bep' && (
                    <label><input type="radio" name="ly_do_id" value="" checked={!lyDoChon.some(l => l.id === lyDoForm)} /> {ch.khongGhi}</label>
                  )}
                  {lyDoChon.map(l => (
                    <label><input type="radio" name="ly_do_id" value={l.id} checked={l.id === lyDoForm} required={loai === 'xuat_khac'} /> {l.ten}</label>
                  ))}
                  {loai === 'xuat_khac' && lyDoChon.length === 0 && (
                    <p class="kho-phu">{ch.chuaCoLyDoKhac}</p>
                  )}
                </fieldset>
              )}
              {moHuy && (
                <>
                  <label class="nb-o"><span>{ch.anhHang}{canAnh ? ' *' : ch.khongBatBuoc}</span>
                    <small>{canAnh ? ch.lyDoCanAnh(lyDoDangChon?.ten ?? '') : ch.khongCanAnh}{ch.chupRo}</small>
                    <input type="file" name="anh" accept="image/*" capture="environment" multiple required={canAnh && anhGiu.length === 0} /></label>
                  {anhGiu.length > 0 && (
                    <>
                      <p class="kho-phu" style="margin:-.25rem 0 .4rem">{ch.daCoAnh(anhGiu.length)}</p>
                      <div class="kho-anh">
                        {anhGiu.map(d => anhLinkGiu.get(d)
                          ? <a href={anhLinkGiu.get(d)} target="_blank" rel="noopener"><img src={anhLinkGiu.get(d)} alt={ch.altAnhDaChup} loading="lazy" /></a>
                          : <span class="kho-phu">{d.split('/').pop()}</span>)}
                      </div>
                    </>
                  )}
                </>
              )}
              <label class="nb-o"><span>{ch.ghiChu}</span>
                <input type="text" name="ghi_chu" value={ghiChuForm} maxlength="500" /></label>
            </div>
          )}

          <div class="kho-thanh-nut dinh">
            {moHuy && buocHuy === 'hang' && <button type="submit" name="viec" value="buoc_ly_do" class="nb-nut" formnovalidate>{ch.tiepLyDo}</button>}
            {(!moHuy || buocHuy === 'anh') && <button type="submit" name="viec" value="ghi" class={`nb-nut ${moHuy ? 'kho-nut-xoa' : ''}`}>{nutGhi}</button>}
          </div>
        </form>
      )}
    </>
  ) : phieu && (
    // =======================================================================
    // XEM / DUYỆT
    // =======================================================================
    <>
      <p class="nb-dan">
        <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
        {' · '}{ch.lapBoi(ten.get(phieu.nguoi_tao ?? '') ?? '—', dinhDangThoiDiem(phieu.created_at))}
        {phieu.duyet_luc && <>{' · '}{phieu.trang_thai === 'tu_choi' ? ch.tuChoiBoi : ch.duyetBoi} {ten.get(phieu.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(phieu.duyet_luc)}</>}
      </p>
      {phieu.ly_do_tu_choi && <div class="nb-bao luu-y"><p><strong>{ch.lyDoTuChoiHai}</strong> {phieu.ly_do_tu_choi}</p></div>}
      {diDuong && (
        <div class={`nb-bao ${phieu.trang_thai === 'nhan_thieu' ? 'luu-y' : ''}`} role="status">
          {phieu.trang_thai === 'dang_chuyen' && (
            <p>{ch.dangMang1(phieu.ten_vi_tri_den ?? '')}<strong>{ch.dangMang2}</strong>{ch.dangMang3}
              {nut.diNhan && <>{' '}<a href="/noi-bo/kho/quay/nhan">{ch.moNhanHang}</a></>}</p>
          )}
          {phieu.trang_thai === 'nhan_thieu' && (
            <p>{ch.thieu1}<strong>{ch.thieu2}</strong>{ch.thieu3(phieu.ten_vi_tri)}</p>
          )}
          {phieu.trang_thai === 'da_tra_ve' && (
            <p>{ch.daTraVe(`${congGoi(traVe) ? `${ch.soGoiDem(congGoi(traVe), donViPhieu)} · ` : ''}${dinhDangKg(congKg(traVe), nn)} kg`, phieu.ten_vi_tri)}</p>
          )}
          {phieu.trang_thai === 'da_nhan' && phieu.xu_ly_thieu === 'mat' && (
            <p>{ch.daGhiMat(`${congGoi(ghiMat) ? `${ch.soGoiDem(congGoi(ghiMat), donViPhieu)} · ` : ''}${dinhDangKg(congKg(ghiMat), nn)} kg`)}</p>
          )}
          {phieu.trang_thai === 'da_nhan' && !phieu.xu_ly_thieu && <p>{ch.nhanDu}</p>}
          {phieu.trang_thai === 'da_huy' && <p>{ch.chuyenDaHuy(phieu.ten_vi_tri)}</p>}
        </div>
      )}

      <div class="nb-the">
        <dl class="kho-dl">
          <dt>{phieu.loai === 'chuyen' ? ch.tu : ch.layO}</dt><dd>{phieu.ten_vi_tri}</dd>
          {phieu.loai === 'chuyen' && <><dt>{ch.den}</dt><dd>{phieu.ten_vi_tri_den}</dd></>}
          {phieu.yeu_cau_id && <><dt>{ch.theoYeuCau}</dt><dd><a href={`/noi-bo/kho/quay/yeu-cau/${phieu.yeu_cau_id}`}>{phieu.so_yeu_cau ?? ch.cuaQuay}</a></dd></>}
          {phieu.nhan_luc && (
            <><dt>{ch.quayNhan}</dt><dd>{ten.get(phieu.nguoi_nhan ?? '') ?? '—'} · {dinhDangThoiDiem(phieu.nhan_luc)}
              {phieu.tong_goi_nhan !== null && <>{' · '}{ch.nhanTrenGoi(phieu.tong_goi_nhan, phieu.tong_goi, donViPhieu)}</>}</dd></>
          )}
          {phieu.xu_ly_luc && (
            <><dt>{phieu.trang_thai === 'da_huy' ? ch.huyChuyenDt : phieu.xu_ly_thieu === 'tra_ve' ? ch.traVeKhoDt : ch.ghiMatDt}</dt>
              <dd>{ten.get(phieu.nguoi_xu_ly ?? '') ?? '—'} · {dinhDangThoiDiem(phieu.xu_ly_luc)}{phieu.ly_do_xu_ly && <>{' · '}{phieu.ly_do_xu_ly}</>}</dd></>
          )}
          {phieu.loai === 'tra_ncc' && phieu.phieu_nhap_id && (
            <><dt>{ch.phieuNhap}</dt><dd>{k.duoc('xem_gia') ? <a href={`/noi-bo/kho/nhap/${phieu.phieu_nhap_id}`}>{ch.xemPhieuNhap}</a> : ch.traLaiNcc}</dd></>
          )}
          <dt>{ch.ngay}</dt><dd>{dinhDangNgay(phieu.ngay)}</dd>
          {phieu.ten_ly_do && <><dt>{ch.lyDo}</dt><dd>{phieu.ten_ly_do}</dd></>}
          {phieu.ghi_chu && <><dt>{ch.ghiChu}</dt><dd>{dichCau(nn, phieu.ghi_chu)}</dd></>}
        </dl>
        {phieu.anh.length > 0 && (
          <div class="kho-anh">
            {phieu.anh.map(a => anhLink.get(a)
              ? <a href={anhLink.get(a)} target="_blank" rel="noopener"><img src={anhLink.get(a)} alt={ch.altAnh} loading="lazy" /></a>
              : <span class="kho-phu">{a.split('/').pop()}</span>)}
          </div>
        )}
      </div>

      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>{ch.matHang}</th><th class="so">{ch.cotGoi}</th><th class="so">{ch.cotKgSo}</th><th class="so">{ch.cotKgQuet}</th>{coCotNhan && <th class="so">{ch.quayNhan}</th>}<th>{ch.cotLoChiDinh}</th></tr></thead>
          <tbody>
            {dongDb.map(d => {
              const m = tenMh.get(d.mat_hang_id);
              // Quầy nhận: hàng đếm gói so số gói, hàng theo kg so số kg.
              const thieu = m?.dem_goi ? (d.so_goi_nhan ?? d.so_goi) < d.so_goi : (d.so_kg_nhan ?? d.so_kg) < d.so_kg;
              return (
              <tr>
                <td>{m?.ten ?? '—'}</td>
                {m?.dem_theo_cai ? <>
                  <td class="so">{d.so_goi} {m.don_vi_goi}</td><td class="so">—</td><td class="so">—</td>
                </> : <>
                <td class="so">{d.so_goi || '—'}</td>
                <td class="so">{dinhDangKg(d.so_kg, nn)}</td>
                <td class="so">{d.so_kg_do !== null ? dinhDangKg(d.so_kg_do, nn) : '—'}</td>
                </>}
                {coCotNhan && (
                  <td class="so">{m?.dem_goi ? (d.so_goi_nhan ?? '—') : d.so_kg_nhan !== null ? dinhDangKg(d.so_kg_nhan, nn) : '—'}{thieu && <strong>{ch.thieuNgoac}</strong>}</td>
                )}
                <td>{d.lo_id ? `${loTheoMa.get(d.lo_id)?.ma_lo ?? '—'}${tangCua(d.lo_id)}` : ch.tuLayHang}</td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <h2>{ch.loDaLay}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>{ch.cotLo}</th><th>{ch.cotHan}</th><th>{ch.cotSoGhi}</th><th class="so">{ch.cotGoi}</th><th class="so">Kg</th></tr></thead>
          <tbody>
            {soCaiLay.map(s => (
              <tr>
                <td>{loTheoMa.get(s.lo_id)?.ma_lo ?? '—'}{tangCua(s.lo_id)}</td>
                <td>{dinhDangNgay(loTheoMa.get(s.lo_id)?.han_dung)}</td>
                <td>{nhanKho(TEN_LOAI_SO_CAI_NB, s.loai, nn)}</td>
                <td class="so">{Math.abs(s.so_goi) || '—'}</td>
                <td class="so">{laCaiLo(s.lo_id) ? '—' : dinhDangKg(Math.abs(s.so_kg), nn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {phieu.loai === 'huy' && (
        <p class="kho-phu">
          {phieu.trang_thai === 'cho_duyet' && ch.huyCho}{' '}
          {phieu.trang_thai === 'da_duyet' && (daHuy.every(x => laCaiLo(x.lo_id))
            ? ch.daGhiHuyChu(ch.soGoiDem(Math.abs(daHuy.reduce((s, x) => s + x.so_goi, 0)), donViPhieu))
            : ch.daGhiHuy(dinhDangKg(Math.abs(daHuy.filter(x => !laCaiLo(x.lo_id)).reduce((s, x) => s + x.so_kg, 0)), nn)))}{' '}
          {phieu.trang_thai === 'tu_choi' && ch.veChoCu}
        </p>
      )}

      {phieu.loai === 'huy' && choToiDuyet && (
        <div class="nb-the kho-khong-in">
          <h2 style="margin-top:0">{ch.duyetBaoHuy}</h2>
          <form method="POST" class="kho-thanh-nut">
            <button type="submit" name="viec" value="duyet" class="nb-nut">{ch.duyetGhiHuy}</button>
          </form>
          <details>
            <summary style="cursor:pointer;font-weight:600">{ch.tuChoiTraVe}</summary>
            <form method="POST" style="margin-top:.75rem">
              <label class="nb-o"><span>{ch.lyDoTuChoi}</span><textarea name="ly_do" required maxlength="500"></textarea></label>
              <button type="submit" name="viec" value="tu_choi" class="nb-nut kho-nut-xoa">{ch.tuChoi}</button>
            </form>
          </details>
        </div>
      )}

      {nut.xuLyThieu && (
        <div class="nb-the kho-khong-in">
          <h2 style="margin-top:0">{ch.xuLyThieu}</h2>
          <form method="POST">
            <label class="nb-o"><span>{ch.lyDoSao}</span>
              <small>{ch.xuLyGoiY(phieu.ten_vi_tri)}</small>
              <textarea name="ly_do" required maxlength="500"></textarea></label>
            <div class="kho-thanh-nut" style="margin:0">
              <button type="submit" name="viec" value="tra_ve" class="nb-nut">{ch.nutTraVe}</button>
              <button type="submit" name="viec" value="ghi_mat" class="nb-nut kho-nut-xoa">{ch.nutGhiMat}</button>
            </div>
          </form>
        </div>
      )}
      {huyTraDuoc && (
        <details class="nb-the kho-khong-in">
          <summary style="cursor:pointer;font-weight:600">{ch.huyTraTieuDe(phieu.ten_vi_tri)}</summary>
          <form method="POST" style="margin-top:.75rem">
            <p class="kho-phu" style="margin-top:0">{ch.huyTraGoiY}</p>
            <label class="nb-o"><span>{ch.lyDoHuy}</span><input type="text" name="ly_do" required maxlength="500" placeholder={ch.viDuHuyTra} /></label>
            <button type="submit" name="viec" value="huy_tra" class="nb-nut kho-nut-xoa">{ch.nutHuyTra}</button>
          </form>
        </details>
      )}
      {nut.huyChuyen && (
        <details class="nb-the kho-khong-in">
          <summary style="cursor:pointer;font-weight:600">{ch.huyChuyenTieuDe(phieu.ten_vi_tri)}</summary>
          <form method="POST" style="margin-top:.75rem">
            <p class="kho-phu" style="margin-top:0">{ch.huyChuyenGoiY}</p>
            <label class="nb-o"><span>{ch.lyDoKhongBuoc}</span><input type="text" name="ly_do" maxlength="500" /></label>
            <button type="submit" name="viec" value="huy_chuyen" class="nb-nut kho-nut-xoa">{ch.nutHuyChuyen}</button>
          </form>
        </details>
      )}
    </>
  )}

  <p class="kho-khong-in" style="margin-top:1.5rem">
    {nccTra
      ? <a href={`/noi-bo/kho/cong-no/${nccTra}`}>{ch.veCongNo}</a>
      : choToiDuyet
        ? <a href="/noi-bo/kho/duyet">{ch.veDuyet}</a>
        : <a href="/noi-bo/kho/xuat">{ch.veDanhSach}</a>}
  </p>
  {!moi && phieu && <KyTen ten={phieu.loai === 'huy' ? [ch.kyBaoHuy, ch.kyChungKien, ch.kyQuanLyDuyet]
    : phieu.loai === 'tra_ncc' ? [ch.kyThuKho, ch.kyNccNhan, ch.kyKeToan]
    : phieu.loai === 'xuat_khac' ? [ch.kyNguoiXuat, ch.kyNguoiNhan, ch.kyQuanLy] : [ch.kyNguoiGiao, ch.kyNguoiNhan]} />}
</Kho>

<style>
  /* 0105: mỗi dòng "theo mặt hàng" — chọn món đếm theo cái (lựa chọn mang data-cai) thì giấu ô kg, nhãn số gói thành
     "Số chai, lon, hộp". Luật nào cũng có :has(): trình duyệt không hiểu thì thấy đủ ô, xuat.ts bỏ kg của món này. */
  .kho-dong-hang:has(option[data-cai]:checked) .xb-chi-thit,
  .kho-dong-hang:has(option[data-cai]:checked) .xb-nhan-goi,
  .kho-dong-hang:not(:has(option[data-cai]:checked)) .xb-nhan-cai { display: none; }
  /* Báo hủy: lô còn hạn xa nằm trong mục gập (22/10/2026). */
  .xh-lo-them > summary { cursor: pointer; font-weight: 600; min-height: 44px; display: list-item; padding: .6rem 0; }
  /* Báo hủy 3 bước */
  .xh-buoc { list-style: none; display: flex; gap: .5rem; padding: 0; margin: 0 0 1rem; font-size: .9rem; }
  .xh-buoc li { flex: 1; padding: .4rem .25rem; border-bottom: 3px solid var(--vach); color: var(--muc-nhat); }
  .xh-buoc li[aria-current] { border-color: var(--do); color: inherit; font-weight: 700; }
  .xh-ly-do-luoi { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); margin-bottom: 1rem; }
  .xh-ly-do-luoi .nb-nut { min-height: 64px; font-size: 1.05rem; flex-direction: column; gap: .15rem; }
  .xh-ly-do-luoi small { font-size: .8rem; font-weight: 400; }
  /* Lý do xuất bếp / xuất khác: ô tròn to */
  .xk-chon { display: flex; flex-wrap: wrap; gap: .5rem; border: 0; padding: 0; margin: 0 0 1rem; }
  .xk-chon legend { font-weight: 600; margin-bottom: .4rem; padding: 0; }
  .xk-chon label { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1rem;
    border: 1px solid var(--vach); border-radius: 10px; background: var(--nb-the); cursor: pointer; font-size: 16px; }
  .xk-chon input { width: 22px; height: 22px; margin: 0; }
  .xk-chon label:has(input:checked) { border-color: var(--do); font-weight: 700; }
  /* Xuất bếp nhanh */
  .xb-nhanh-luoi { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); margin-bottom: .5rem; }
</style>
