---
/**
 * KHO — MỘT PHIẾU CHUYỂN / XUẤT BẾP / XUẤT KHÁC / BÁO HỦY (lập mới khi id = "moi")
 *
 * Lập mới: ?loai=chuyen|xuat_bep|xuat_khac|huy, nơi lấy ?tu=, nơi nhận ?den= (chuyển).
 * Link từ trang chủ, thông báo và trang Quét còn mang sẵn thứ cần lấy:
 *   ?lo=<lô>  → lô đó điền sẵn ở phần "theo lô" với TẤT CẢ số gói (hàng đếm
 *               gói) hoặc số kg (hàng theo kg) đang có ở nơi lấy. Không có
 *               ?tu thì nơi lấy là chỗ lô đang nằm.
 *   ?mh=<món> → một dòng "theo mặt hàng" chọn sẵn món đó.
 * Đổi nơi bằng link GET ở đầu trang — danh sách lô bên dưới là lô ĐANG CÓ ở
 * nơi lấy, nên nơi lấy phải chọn trước. Xuất bếp / báo hủy: thủ kho mặc định
 * lấy ở Kho lạnh, nhân viên quầy lấy ở quầy.
 *
 * Hai cách ghi hàng, dùng chung được nhưng KHÔNG cho một món ở cả hai chỗ
 * (kho sẽ bị trừ hai lần):
 *   · theo mặt hàng: "3 gói thăn cắt lát" — tự lấy hàng hạn gần trước; quét
 *     nhãn cân là nhanh nhất, nên ô quét nằm đầu phần hàng và có sẵn con trỏ;
 *   · theo lô: ghi số gói ở đúng lô cần lấy — hợp với báo hủy lô hết hạn.
 *     Nhân viên quầy chuyển hàng không thấy phần này (trừ khi link đã chọn
 *     sẵn lô) — máy tự lấy đúng lô.
 *
 * Ảnh báo hủy tải lên một lần rồi giữ trong ô ẩn (lib/kho/xuat.ts): bấm
 * "Đọc mã", "Thêm một dòng", lui / tới giữa các bước hay gửi bị lỗi đều không
 * làm mất ảnh.
 *
 * BÁO HỦY 3 BƯỚC (GĐ5b): 1 · Hàng (quét / chọn món / lô — mở từ ?lo= thì lô
 * đã điền sẵn) → 2 · Lý do (mỗi lý do một nút lớn, bấm là sang bước sau) →
 * 3 · Ảnh và gửi (bắt buộc ảnh khi lý do cần ảnh). Ô ẩn "buoc" nói form đang
 * ở bước nào; hàng, lý do, ảnh đi theo dưới dạng ô ẩn.
 *
 * XUẤT BẾP NHANH: 6 món hay đưa bếp nhất (từ phiếu xuất bếp gần đây) thành
 * nút — bấm là thêm một dòng món đó. Lý do xuất bếp / xuất khác là nút chọn
 * (ô tròn to), xuất khác bắt buộc chọn.
 *
 * PHIẾU CHUYỂN ĐI ĐƯỜNG (0032): hiện ai nhận, nhận bao nhiêu. Quản lý xử lý
 * phần nhận thiếu (trả về kho / ghi mất, phải ghi lý do); người lập hủy được
 * chuyến khi quầy chưa bấm nhận.
 *
 * Phiếu ghi xong không sửa được (sổ kho bất biến). Chuyển nhầm thì chuyển
 * ngược lại; báo hủy nhầm thì quản lý từ chối. Duyệt / từ chối xong quay về
 * hộp Duyệt để làm tiếp phiếu kế.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import NutIn from '../../../../components/kho/NutIn.astro';
import InDau from '../../../../components/kho/InDau.astro';
import KyTen from '../../../../components/kho/KyTen.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import QuetMa from '../../../../components/kho/QuetMa.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import {
  docCaiDat, docLyDo, docMatHang, docViTri, type CaiDat, type LyDo, type MatHang, type ViTri,
} from '../../../../lib/kho/danh-muc.ts';
import { docTon, type DongTon } from '../../../../lib/kho/ton.ts';
import { docThongTinLo } from '../../../../lib/kho/pha-loc.ts';
import {
  docPhieuXuat, taoPhieuXuat, duyetHuy, tuChoiHuy, dongTuQuet, gopDong, docFormPhieuXuat, giuAnhHuy,
  tomTatHang, docNhaCungCapCuaPhieuNhap, TEN_LOAI_XUAT, LOAI_LAP_DUOC, laNoiDeHang, buocHuySau,
  docMonHayDungBep, nutPhieuChuyen, xuLyChuyenThieu, huyChuyenDiDuong,
  type BuocHuy, type DongLoForm, type DongSoCai, type DongXuat, type DongXuatForm, type LoaiXuat, type PhieuXuat,
} from '../../../../lib/kho/xuat.ts';
import { linkAnh } from '../../../../lib/kho/anh.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangThoiDiem, laUuid,
  TEN_LOAI_SO_CAI, TRANG_THAI_CHUNG_TU, type KetQua,
} from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const vai = k.nhanSu.vai_tro;

const idThamSo = Astro.params.id ?? '';
const moi = idThamSo === 'moi';
if (moi && !k.duoc('van_hanh')) {
  return chuyenHuong(Astro, '/noi-bo/kho/xuat', { ok: false, cau: 'Tài khoản của bạn không chuyển, xuất hay báo hủy hàng.' });
}

let matHang: MatHang[] = [];
let viTri: ViTri[] = [];
let lyDo: LyDo[] = [];
let caiDat: CaiDat | null = null;
let ton: DongTon[] = [];
let phieu: PhieuXuat | null = null;
let dongDb: DongXuat[] = [];
let soCai: DongSoCai[] = [];
let loiDoc = k.loiDoc;
try {
  [matHang, viTri, lyDo, caiDat] = await Promise.all([
    docMatHang(k.client), docViTri(k.client, cn.id), docLyDo(k.client), docCaiDat(k.client, cn.id),
  ]);
  if (moi) ton = await docTon(k.client, cn.id);
  else {
    const doc = await docPhieuXuat(k.client, idThamSo);
    if (doc) { phieu = doc.phieu; dongDb = doc.dong; soCai = doc.soCai; }
  }
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được phiếu.');
}
if (!moi && !phieu && !loiDoc) {
  return chuyenHuong(Astro, '/noi-bo/kho/xuat', { ok: false, cau: 'Không tìm thấy phiếu này.' });
}

// ---------------------------------------------------------------------------
// Loại phiếu và nơi lấy / nơi nhận (lập mới)
// ---------------------------------------------------------------------------
const q = Astro.url.searchParams;
const loai: LoaiXuat = phieu?.loai
  ?? ((LOAI_LAP_DUOC as readonly string[]).includes(q.get('loai') ?? '') ? q.get('loai') as LoaiXuat : 'chuyen');
const moHuy = loai === 'huy';
// Xuất bếp và xuất khác: chỉ hàng còn hạn, lý do là nút chọn (xuất khác bắt buộc).
const laXuatRa = loai === 'xuat_bep' || loai === 'xuat_khac';
// Bỏ "Hàng chờ hủy" và "Đang mang ra quầy" (0032) — không phải chỗ để hàng.
const dungDuoc = viTri.filter(laNoiDeHang);
const khoDau = dungDuoc.find(v => v.id === caiDat?.vi_tri_nhan_hang_id) ?? dungDuoc.find(v => v.loai === 'kho');
const quayDau = dungDuoc.find(v => v.loai === 'quay');

// Link mang sẵn lô (?lo) hay món (?mh) cần lấy.
const loThamSo = laUuid(q.get('lo')) ? q.get('lo') : null;
const mhThamSo = matHang.find(m => m.id === q.get('mh') && m.dang_dung) ?? null;

// Nơi lấy mặc định. Chuyển: từ kho. Xuất bếp / báo hủy: thủ kho làm ở Kho
// lạnh, còn nhân viên quầy (và quản lý) thường làm ở quầy.
const macDinh = (loai === 'chuyen' || vai === 'thu_kho' ? khoDau ?? quayDau : quayDau ?? khoDau) ?? dungDuoc[0] ?? null;
/** Nơi đang có hàng khớp điều kiện — ưu tiên nơi mặc định, rồi theo thứ tự vị trí. */
const noiCo = (dk: (t: DongTon) => boolean) => {
  const co = (v: ViTri) => ton.some(t => t.vi_tri_id === v.id && (t.so_kg > 0 || t.so_goi > 0) && dk(t));
  return macDinh && co(macDinh) ? macDinh : dungDuoc.find(co);
};
const tu = dungDuoc.find(v => v.id === q.get('tu'))
  ?? (loThamSo ? noiCo(t => t.lo_id === loThamSo) : undefined)
  // Đưa bếp / báo hủy một món (từ trang Quét): lấy ở chỗ đang có món đó.
  // Phiếu chuyển thì không — "mang ra quầy" luôn đi từ kho.
  ?? (mhThamSo && loai !== 'chuyen'
    ? noiCo(t => t.mat_hang_id === mhThamSo.id && (!laXuatRa || t.tinh_trang_han !== 'het_han'))
    : undefined)
  ?? macDinh;
const den = loai !== 'chuyen' ? null
  : dungDuoc.find(v => v.id === q.get('den') && v.id !== tu?.id)
    ?? dungDuoc.find(v => v.id !== tu?.id && v.loai !== tu?.loai) ?? dungDuoc.find(v => v.id !== tu?.id) ?? null;
const giuLink: Record<string, string> = {
  ...(loThamSo ? { lo: loThamSo } : {}), ...(mhThamSo ? { mh: mhThamSo.id } : {}),
};
const linkMoi = (thay: Record<string, string>) => {
  const p = new URLSearchParams({ loai, ...(tu ? { tu: tu.id } : {}), ...(den ? { den: den.id } : {}), ...giuLink, ...thay });
  return `/noi-bo/kho/xuat/moi?${p.toString()}`;
};
// Đổi loại phiếu mà vẫn giữ lô / món đang cần lấy (vd. mở "Xuất bếp" mới thấy lô đã hỏng → "Báo hủy").
const linkLoai = (l: LoaiXuat) => {
  const p = new URLSearchParams({ loai: l, ...(loThamSo && tu ? { tu: tu.id } : {}), ...giuLink });
  return `/noi-bo/kho/xuat/moi?${p.toString()}`;
};
const chiConHan = laXuatRa || (loai === 'chuyen' && den?.loai === 'quay');

// Lô và mặt hàng đang có ở nơi lấy.
const loTaiTu = ton.filter(t => t.vi_tri_id === tu?.id && (t.so_kg > 0 || t.so_goi > 0))
  .sort((a, b) => a.han_dung.localeCompare(b.han_dung) || a.ma_lo.localeCompare(b.ma_lo));
const hangTaiTu = new Set(loTaiTu.filter(t => !chiConHan || t.tinh_trang_han !== 'het_han').map(t => t.mat_hang_id));
const mhChon = matHang.filter(m => hangTaiTu.has(m.id));
// Lô mà link chỉ tới, nếu còn ở nơi lấy. Hết hạn mà phiếu chỉ nhận hàng còn hạn thì không điền được.
const loChon = loThamSo ? loTaiTu.find(t => t.lo_id === loThamSo) ?? null : null;
const loChonKhoa = !!loChon && chiConHan && loChon.tinh_trang_han === 'het_han';
// Nhân viên quầy chuyển hàng: không phải chọn lô — máy tự lấy hàng hạn gần trước.
const anTheoLo = vai === 'nhan_vien_quay' && loai === 'chuyen';
const lyDoLoai = lyDo.filter(l => l.loai === loai);
const nutGhi = moHuy ? 'Gửi báo hủy' : 'Ghi phiếu';
const tenMh = new Map(matHang.map(m => [m.id, m]));
// Xuất bếp nhanh: món hay đưa bếp mà nơi lấy đang có (còn hạn).
const monNhanh = moi && loai === 'xuat_bep'
  ? (await docMonHayDungBep(k.client, cn.id)).filter(id => hangTaiTu.has(id)).map(id => tenMh.get(id)!).filter(Boolean)
  : [];

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
/** Dòng vàng dưới câu báo: nhãn không đọc được, ảnh chưa tải lên... */
const luuY: string[] = [];
let dongA: DongXuatForm[] | null = null;
let dongB: DongLoForm[] | null = null;
let anhGiu: string[] = [];
let dienSanMh = false;
let ghiChuForm = '';
let lyDoForm = '';
/** Báo hủy: bước đang hiện. */
let buocHuy: BuocHuy = 'hang';
const form = await docFormGui(Astro);
// Gửi lại form (Đọc mã, sửa lỗi) thì GIỮ ma_gui: ảnh đã tải nằm dưới ma_gui này,
// và lỡ lần trước đã ghi được mà mạng rớt thì bấm lại vẫn chỉ ra một phiếu.
const maGuiCu = String(form?.get('ma_gui') ?? '');
const maGuiForm = moi && laUuid(maGuiCu) ? maGuiCu : crypto.randomUUID();
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form) {
  // Nút không mang "viec": nút món nhanh (them_mh) và nút lý do ở bước 2 báo hủy.
  const themMh = String(form.get('them_mh') ?? '');
  const viec = String(form.get('viec') ?? '')
    || (laUuid(themMh) ? 'them_mh' : '')
    || (moHuy && form.get('buoc') === 'ly_do' && laUuid(form.get('ly_do_id')) ? 'chon_ly_do' : '');
  ghiChuForm = String(form.get('ghi_chu') ?? '');
  lyDoForm = String(form.get('ly_do_id') ?? '');
  const coLyDo = () => lyDoLoai.some(l => l.id === lyDoForm && l.dang_dung);
  if (moi && ['quet', 'them_dong', 'them_mh', 'ghi', 'buoc_hang', 'buoc_ly_do', 'chon_ly_do'].includes(viec)) {
    if (!tu) {
      bao = { ok: false, cau: 'Chưa có kho hay quầy nào để lấy hàng.' };
    } else if (viec === 'ghi') {
      const kq = await taoPhieuXuat(k.client, cn.id, form, { loai, viTriId: tu.id, matHang, lyDo: lyDoLoai, den });
      if (kq.ok && kq.id) return chuyenHuong(Astro, `/noi-bo/kho/xuat/${kq.id}`, kq);
      bao = { ok: false, cau: kq.cau };
      dongA = kq.doc?.dong ?? null;
      dongB = kq.doc?.theoLo ?? null;
      anhGiu = kq.anh ?? [];
      // Bị từ chối: về đúng bước còn thiếu (hàng lỗi → bước 1, chưa lý do → bước 2).
      if (moHuy) buocHuy = buocHuySau('ghi', { hangXong: !!kq.doc && kq.doc.loi.length === 0 && kq.doc.payload.length > 0, coLyDo: coLyDo() });
    } else {
      // "Đọc mã" / "Thêm một dòng" / món nhanh / lui tới giữa các bước báo hủy:
      // vẽ lại form với đúng số đang ghi, chưa ghi gì.
      const doc = docFormPhieuXuat(form, matHang);
      dongB = doc.theoLo;
      if (moHuy) {
        const giu = await giuAnhHuy(k.client, cn.id, form, maGuiForm);
        anhGiu = giu.duongDan;
        luuY.push(...giu.loi);
        buocHuy = buocHuySau(viec, { hangXong: doc.loi.length === 0 && doc.payload.length > 0, coLyDo: coLyDo() });
        if (viec === 'buoc_ly_do' && buocHuy === 'hang') {
          bao = { ok: false, cau: doc.loi.length ? doc.loi.join(' · ') : 'Chưa có hàng nào — quét nhãn, chọn món hoặc ghi số ở lô cần hủy.' };
        } else if (viec === 'chon_ly_do' && buocHuy === 'ly_do') {
          bao = { ok: false, cau: 'Lý do này không còn dùng — chọn lý do khác.' };
        }
      }
      if (viec === 'them_mh') {
        // Món nhanh: thêm một dòng món đó (đã có thì thôi) — dòng đó là dòng để ghi số.
        dongA = doc.dong.some(d => d.mat_hang_id === themMh)
          ? doc.dong : [...doc.dong, { mat_hang_id: themMh, so_goi: '', so_kg: '' }];
        dienSanMh = true;
      } else if (viec !== 'quet') {
        dongA = doc.dong;
      } else {
        const quet = dongTuQuet(String(form.get('ma_quet') ?? ''), matHang, caiDat?.mau_ma_vach, caiDat?.so_le_kg ?? 3);
        dongA = gopDong(doc.dong, quet.dong);
        bao = quet.soMa === 0
          ? { ok: false, cau: 'Ô quét đang trống — quét nhãn vào ô rồi bấm "Đọc mã đã quét".' }
          : quet.soDoc > 0
            ? { ok: true, cau: `Đã đọc ${quet.soDoc} nhãn: ${tomTatHang(quet.dong, matHang)}. Kiểm lại rồi bấm "${nutGhi}".` }
            : { ok: false, cau: 'Chưa đọc được nhãn nào.' };
        luuY.unshift(...quet.loi);
        // Món vừa quét mà cũng đang có số ở phần lô: báo ngay, đừng đợi bấm ghi mới bị chặn.
        const coOLo = new Set(doc.theoLo.filter(l => l.so_goi || l.so_kg).map(l => l.mat_hang_id));
        for (const d of quet.dong) {
          if (coOLo.has(d.mat_hang_id)) luuY.push(`${tenMh.get(d.mat_hang_id)?.ten ?? 'Một món'} vừa quét cũng đang ghi ở phần lô — xóa số ở một chỗ.`);
        }
        // Mã cân lạ: chỉ người sửa được danh mục mới thấy mã và chỗ sửa.
        if (quet.maCanLa.length > 0 && k.duoc('danh_muc')) {
          luuY.push(`Cho quản lý: mã cân ${quet.maCanLa.join(', ')} chưa gắn với món nào — gắn ở Cài đặt → Mặt hàng.`);
        }
      }
    }
  } else if (phieu) {
    let kq: KetQua;
    const lyDoGo = String(form.get('ly_do') ?? '').trim();
    if (viec === 'duyet') kq = await duyetHuy(k.client, phieu.id);
    else if (viec === 'tu_choi') kq = await tuChoiHuy(k.client, phieu.id, lyDoGo);
    else if (viec === 'tra_ve' || viec === 'ghi_mat') {
      // Hàng đi đường nhận thiếu: xong thì ở lại phiếu để thấy kết quả.
      kq = await xuLyChuyenThieu(k.client, phieu.id, viec === 'tra_ve' ? 'tra_ve' : 'mat', lyDoGo);
      return chuyenHuong(Astro, `/noi-bo/kho/xuat/${phieu.id}`, kq);
    } else if (viec === 'huy_chuyen') {
      kq = await huyChuyenDiDuong(k.client, phieu.id, lyDoGo);
      return chuyenHuong(Astro, `/noi-bo/kho/xuat/${phieu.id}`, kq);
    } else kq = { ok: false, cau: 'Việc không hợp lệ.' };
    // Duyệt / từ chối xong: về hộp Duyệt, phiếu kế tiếp nằm sẵn ở đó. Lỗi thì ở lại phiếu này.
    return chuyenHuong(Astro, kq.ok ? '/noi-bo/kho/duyet' : `/noi-bo/kho/xuat/${phieu.id}`, kq);
  } else {
    bao = { ok: false, cau: 'Việc không hợp lệ.' };
  }
} else if (moi) {
  // Mở từ link: điền sẵn. Gửi form rồi thì luôn giữ đúng số người dùng đã ghi.
  if (loChon && !loChonKhoa) {
    dongB = [{
      lo_id: loChon.lo_id, mat_hang_id: loChon.mat_hang_id,
      so_goi: loChon.dem_goi && loChon.so_goi > 0 ? String(loChon.so_goi) : '',
      so_kg: loChon.dem_goi ? '' : String(loChon.so_kg).replace('.', ','),
    }];
  } else if (loThamSo && !loChon && tu) {
    luuY.push(`Lô được chọn không còn hàng ở ${tu.ten} — có thể đã chuyển hay hủy rồi.`);
  }
  if (mhThamSo && loChon?.mat_hang_id !== mhThamSo.id) {
    dongA = [{ mat_hang_id: mhThamSo.id, so_goi: '', so_kg: '' }];
    dienSanMh = true;
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const lyDoChon = lyDoLoai.filter(l => l.dang_dung || l.id === lyDoForm);
// Một dòng trống để ghi thêm (trước là 2–4 dòng). Link đã chọn sẵn món thì
// chính dòng đó là dòng để ghi.
const dongHienA: DongXuatForm[] = [
  ...(dongA ?? []),
  ...(dienSanMh ? [] : [{ mat_hang_id: '', so_goi: '', so_kg: '' }]),
];
const theoLoCu = new Map((dongB ?? []).map(l => [l.lo_id, l]));
const loCoSo = new Set((dongB ?? []).filter(l => l.so_goi || l.so_kg).map(l => l.lo_id));
// Lô link chọn sẵn lên đầu. Nhân viên quầy chuyển hàng chỉ thấy lô đã chọn / đang có số.
const loHien = (anTheoLo ? loTaiTu.filter(t => t.lo_id === loChon?.lo_id || loCoSo.has(t.lo_id)) : loTaiTu)
  .slice().sort((a, b) => Number(b.lo_id === loChon?.lo_id) - Number(a.lo_id === loChon?.lo_id));
const hienTheoLo = !anTheoLo || loHien.length > 0;

// Ảnh báo hủy: lý do nào cần ảnh, nói bằng chữ ngay dưới ô ảnh.
const lyDoDung = lyDoChon.filter(l => l.dang_dung);
const lyDoCanAnh = lyDoDung.filter(l => l.can_anh);
const moiLyDoCanAnh = lyDoDung.length > 0 && lyDoCanAnh.length === lyDoDung.length;
const lyDoDangChon = lyDoChon.find(l => l.id === lyDoForm) ?? null;
const canAnh = moHuy && (lyDoDangChon ? lyDoDangChon.can_anh : moiLyDoCanAnh);
const anhLinkGiu = anhGiu.length ? await linkAnh(k.client, anhGiu) : new Map<string, string>();

// Báo hủy bước 2, 3: hàng và lý do đã chọn đi theo dưới dạng ô ẩn.
const hienHang = !moHuy || buocHuy === 'hang';
const dongGiu = (dongA ?? []).filter(d => d.mat_hang_id || d.so_goi || d.so_kg);
const loGiu = (dongB ?? []).filter(l => l.so_goi || l.so_kg);
const tomTatGiu = tomTatHang([...dongGiu, ...loGiu], matHang, 6) || 'chưa có hàng';
const BUOC_HUY: [BuocHuy, string][] = [['hang', 'Hàng'], ['ly_do', 'Lý do'], ['anh', 'Ảnh và gửi']];

const loTheoMa = phieu ? await docThongTinLo(k.client, [...soCai.map(s => s.lo_id), ...dongDb.map(d => d.lo_id ?? '')]) : new Map();
const ten = phieu ? await tenNhanSu(k.client, [phieu.nguoi_tao, phieu.nguoi_duyet, phieu.nguoi_nhan, phieu.nguoi_xu_ly]) : new Map<string, string>();
const anhLink = phieu ? await linkAnh(k.client, phieu.anh) : new Map<string, string>();
// Phiếu trả hàng: quay lại công nợ của đúng nhà cung cấp (trang Công nợ chỉ
// vai kế toán — kế toán, quản lý, chủ — mở được; thủ kho xem giá nhưng không vào đó).
const nccTra = phieu?.loai === 'tra_ncc' && k.duoc('ke_toan')
  ? await docNhaCungCapCuaPhieuNhap(k.client, phieu.phieu_nhap_id) : null;
const [nhanTT, lopTT] = phieu ? (TRANG_THAI_CHUNG_TU[phieu.trang_thai] ?? [phieu.trang_thai, 'tat']) : ['Mới', 'nhap'];
const tieuDe = moi ? TEN_LOAI_XUAT[loai] : `${TEN_LOAI_XUAT[loai]} ${phieu?.so_phieu ?? ''}`;
const choToiDuyet = phieu?.trang_thai === 'cho_duyet' && k.duoc('duyet');
// Phiếu chuyển đi đường (0032): nút nào hiện cho người đang xem.
const nut = phieu
  ? nutPhieuChuyen(phieu, { id: k.nhanSu.id, duyet: k.duoc('duyet'), vanHanh: k.duoc('van_hanh') })
  : { huyChuyen: false, xuLyThieu: false, diNhan: false };
const diDuong = phieu?.loai === 'chuyen'
  && (['dang_chuyen', 'da_nhan', 'nhan_thieu', 'da_tra_ve', 'da_huy'].includes(phieu.trang_thai) || !!phieu.nhan_luc);
const coCotNhan = dongDb.some(d => d.so_goi_nhan !== null || d.so_kg_nhan !== null);
// Phần thiếu đã trả về / ghi mất (sổ của chính phiếu này).
const traVe = soCai.filter(s => s.loai === 'chuyen_den' && s.vi_tri_id === phieu?.vi_tri_id);
const ghiMat = soCai.filter(s => s.loai === 'hao_hut');
const congGoi = (ds: DongSoCai[]) => Math.abs(ds.reduce((t, x) => t + x.so_goi, 0));
const congKg = (ds: DongSoCai[]) => Math.abs(ds.reduce((t, x) => t + x.so_kg, 0));
// Nút "?": việc chính của màn này với người đang xem (lib/kho/huong-dan.ts).
const huongDan = choToiDuyet ? 'duyet-huy'
  : nut.xuLyThieu ? 'nhan-thieu'
  : loai === 'huy' ? 'bao-huy'
  : loai === 'xuat_bep' ? 'xuat-bep'
  : loai === 'xuat_khac' ? 'xuat-khac'
  : loai === 'tra_ncc' ? 'tra-ncc'
  : vai === 'nhan_vien_quay' ? (moi ? 'tu-lay-hang' : 'nhan-ra-quay')
  : 'ra-quay';
// Sổ của phiếu: chỉ các dòng rời nơi lấy (chuyển đi / xuất bếp) — đủ để biết lô nào.
const soCaiLay = soCai.filter(s => s.vi_tri_id === phieu?.vi_tri_id && ['chuyen_di', 'xuat_bep', 'xuat_khac', 'tra_ncc'].includes(s.loai));
const daHuy = soCai.filter(s => s.loai === 'huy');
---
<Kho k={k} tieuDe={tieuDe} huongDan={huongDan}>
  <h1>{tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  {!moi && phieu && (
    <>
      <InDau tieuDe={({ huy: 'BIÊN BẢN HỦY HÀNG', chuyen: 'PHIẾU CHUYỂN KHO', xuat_bep: 'PHIẾU XUẤT BẾP',
        xuat_khac: 'PHIẾU XUẤT KHÁC', tra_ncc: 'PHIẾU TRẢ HÀNG NHÀ CUNG CẤP' } as Record<string, string>)[phieu.loai] ?? 'PHIẾU XUẤT KHO'}
        soPhieu={phieu.so_phieu} chiNhanh={k.chiNhanh?.ten} />
      <NutIn chu={phieu.loai === 'huy' ? 'In biên bản' : 'In phiếu'} />
    </>
  )}
  {luuY.length > 0 && (
    <div class="nb-bao luu-y" role="status">{luuY.map(c => <p>{c}</p>)}</div>
  )}

  {moi ? (
    <>
      {hienHang && (
        <>
          <nav class="kho-dh" aria-label="Loại phiếu">
            {LOAI_LAP_DUOC.map(l => (
              <a href={linkLoai(l)} aria-current={l === loai ? 'page' : undefined}>{TEN_LOAI_XUAT[l]}</a>
            ))}
          </nav>
          <div class="nb-the">
            <p style="margin:0 0 .4rem"><strong>Lấy từ</strong></p>
            <nav class="kho-dh" aria-label="Nơi lấy" style="margin:0;padding-bottom:.5rem">
              {dungDuoc.map(v => <a href={linkMoi({ tu: v.id, den: den?.id === v.id ? '' : (den?.id ?? '') })} aria-current={v.id === tu?.id ? 'page' : undefined}>{v.ten}</a>)}
            </nav>
            {loai === 'chuyen' && (
              <>
                <p style="margin:.4rem 0"><strong>Đưa đến</strong></p>
                <nav class="kho-dh" aria-label="Nơi nhận" style="margin:0;padding-bottom:0">
                  {dungDuoc.filter(v => v.id !== tu?.id).map(v => <a href={linkMoi({ den: v.id })} aria-current={v.id === den?.id ? 'page' : undefined}>{v.ten}</a>)}
                </nav>
              </>
            )}
          </div>
        </>
      )}

      {moHuy && (
        <ol class="xh-buoc" aria-label="Các bước báo hủy">
          {BUOC_HUY.map(([b, t], i) => <li aria-current={b === buocHuy ? 'step' : undefined}>{i + 1} · {t}</li>)}
        </ol>
      )}

      {loChonKhoa && loChon && (
        <div class="nb-bao luu-y" role="status">
          <p>
            Lô {loChon.ma_lo} ({loChon.ten_hang}) đã hết hạn — không {loai === 'chuyen' ? 'đưa ra quầy' : loai === 'xuat_bep' ? 'đưa bếp' : 'xuất'} được.{' '}
            <a href={`/noi-bo/kho/xuat/moi?loai=huy&tu=${loChon.vi_tri_id}&lo=${loChon.lo_id}`}>Báo hủy lô này</a>
          </p>
        </div>
      )}

      {!tu || (loai === 'chuyen' && !den) ? (
        <p class="nb-rong">Cần ít nhất {loai === 'chuyen' ? 'hai vị trí (kho và quầy)' : 'một kho hoặc quầy'} đang dùng. Thêm trong Cài đặt → Vị trí.</p>
      ) : (
        <form method="POST" enctype="multipart/form-data">
          <input type="hidden" name="ma_gui" value={maGuiForm} />
          {den && <input type="hidden" name="vi_tri_den_id" value={den.id} />}
          {moHuy && <input type="hidden" name="buoc" value={buocHuy} />}
          {anhGiu.map(d => <input type="hidden" name="anh_da_tai" value={d} />)}

          {hienHang ? (
            <>
              <input type="hidden" name="so_dong" value={String(dongHienA.length)} />
              <input type="hidden" name="so_lo" value={String(hienTheoLo ? loHien.length : 0)} />
              <p class="nb-dan">
                {loai === 'chuyen' && <>Chuyển từ <strong>{tu.ten}</strong> sang <strong>{den?.ten}</strong>.</>}
                {loai === 'xuat_bep' && <>Xuất cho bếp từ <strong>{tu.ten}</strong>.</>}
                {loai === 'xuat_khac' && <>Xuất từ <strong>{tu.ten}</strong> cho việc khác: dùng nội bộ, tặng khách, hàng mẫu… — phải chọn lý do.</>}
                {loai === 'huy' && <>Báo hủy hàng ở <strong>{tu.ten}</strong>. Hàng chuyển ngay sang "Hàng chờ hủy"; quản lý duyệt mới ghi mất.</>}
                {chiConHan && <> Lô <strong>đã hết hạn</strong> được bỏ qua — chỉ báo hủy được.</>}
              </p>

              <h2>{moHuy ? 'Hàng cần hủy' : 'Hàng lấy ra'}</h2>
              <QuetMa tuFocus />
              {monNhanh.length > 0 && (
                <div class="xb-nhanh">
                  <p class="kho-phu" style="margin:.5rem 0 .4rem">Món hay đưa bếp — bấm để thêm một dòng:</p>
                  <div class="xb-nhanh-luoi">
                    {monNhanh.map(m => (
                      <button type="submit" name="them_mh" value={m.id} class="nb-nut phu" formnovalidate>{m.ten}</button>
                    ))}
                  </div>
                </div>
              )}
              <p class="kho-phu">Không quét được thì chọn món và ghi số gói — máy tự lấy hàng hạn gần trước. Hàng theo kg (không đếm gói) thì ghi số kg.</p>
              {dongHienA.map((d, i) => (
                <div class="kho-dong-hang">
                  <span class="so-thu-tu">{i + 1}</span>
                  <label class="nb-o" style="margin-top:.4rem"><span>Mặt hàng</span>
                    <ChonMatHang name={`d${i}_mat_hang`} matHang={mhChon.length ? [...mhChon, ...matHang.filter(m => m.id === d.mat_hang_id && !hangTaiTu.has(m.id))] : matHang} chon={d.mat_hang_id} trong={mhChon.length ? '— chọn mặt hàng —' : '— nơi này đang trống —'} />
                  </label>
                  <div class="kho-luoi">
                    <label class="nb-o"><span>Số gói</span>
                      <input type="text" inputmode="numeric" name={`d${i}_so_goi`} value={d.so_goi} /></label>
                    <label class="nb-o"><span>Số kg</span>
                      <input type="text" inputmode="decimal" name={`d${i}_so_kg`} value={d.so_kg} placeholder={i === 0 ? 'hàng theo kg / kg quét được' : undefined} /></label>
                  </div>
                </div>
              ))}
              <div class="kho-thanh-nut" style="margin-top:0">
                <button type="submit" name="viec" value="them_dong" class="nb-nut phu" formnovalidate>+ Thêm một dòng</button>
              </div>

              {hienTheoLo && (
                <details open={moHuy || !!loChon || loCoSo.size > 0}>
                  <summary style="cursor:pointer;font-weight:600;padding:.5rem 0">{anTheoLo ? 'Lô đã chọn' : moHuy ? 'Chọn lô cần hủy' : 'Hoặc chọn đúng lô cần lấy'}</summary>
                  <p class="kho-phu" style="margin-top:0">Món đã ghi ở trên thì đừng ghi lại ở đây — mỗi món chỉ ghi một chỗ.</p>
                  {loHien.length === 0 ? (
                    <p class="nb-rong">{tu.ten} đang không có hàng.</p>
                  ) : (
                    <div class="kho-lo-chon">
                      {loHien.map((t, i) => {
                        const cu = theoLoCu.get(t.lo_id);
                        const khoa = chiConHan && t.tinh_trang_han === 'het_han';
                        return (
                          <div>
                            <input type="hidden" name={`l${i}_lo`} value={t.lo_id} />
                            <input type="hidden" name={`l${i}_mat_hang`} value={t.mat_hang_id} />
                            <div class="dau">
                              <b>{t.ten_hang}</b>
                              <span class="kho-phu">lô {t.ma_lo} · còn {t.dem_goi ? `${t.so_goi} ${t.don_vi_goi} · ` : ''}{dinhDangKg(t.so_kg)} kg ·{' '}
                                <span class={`kho-han ${t.tinh_trang_han}`}>HSD {dinhDangNgay(t.han_dung)}</span></span>
                            </div>
                            {khoa ? (
                              <p class="kho-phu" style="margin:.2rem 0 .6rem">Đã hết hạn — chỉ báo hủy được.</p>
                            ) : (
                              <div class="kho-luoi">
                                {t.dem_goi && (
                                  <label class="nb-o"><span>Số {t.don_vi_goi}</span>
                                    <input type="text" inputmode="numeric" name={`l${i}_so_goi`} value={cu?.so_goi ?? ''} /></label>
                                )}
                                <label class="nb-o"><span>Số kg{t.dem_goi ? ' (nếu cân)' : ''}</span>
                                  <input type="text" inputmode="decimal" name={`l${i}_so_kg`} value={cu?.so_kg ?? ''} /></label>
                              </div>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  )}
                </details>
              )}
            </>
          ) : (
            // Báo hủy bước 2, 3: hàng đã ghi ở bước 1 đi theo dưới dạng ô ẩn.
            <>
              <input type="hidden" name="so_dong" value={String(dongGiu.length)} />
              {dongGiu.map((d, i) => (
                <>
                  <input type="hidden" name={`d${i}_mat_hang`} value={d.mat_hang_id} />
                  <input type="hidden" name={`d${i}_so_goi`} value={d.so_goi} />
                  <input type="hidden" name={`d${i}_so_kg`} value={d.so_kg} />
                </>
              ))}
              <input type="hidden" name="so_lo" value={String(loGiu.length)} />
              {loGiu.map((l, i) => (
                <>
                  <input type="hidden" name={`l${i}_lo`} value={l.lo_id} />
                  <input type="hidden" name={`l${i}_mat_hang`} value={l.mat_hang_id} />
                  <input type="hidden" name={`l${i}_so_goi`} value={l.so_goi} />
                  <input type="hidden" name={`l${i}_so_kg`} value={l.so_kg} />
                </>
              ))}
              <div class="nb-the">
                <p style="margin:0">Hủy ở <strong>{tu.ten}</strong>: {tomTatGiu}.</p>
                {buocHuy === 'anh' && lyDoDangChon && <p style="margin:.4rem 0 0">Lý do: <strong>{lyDoDangChon.ten}</strong></p>}
                <div class="kho-thanh-nut" style="margin:.6rem 0 0">
                  <button type="submit" name="viec" value="buoc_hang" class="nb-nut phu" formnovalidate>← Sửa hàng</button>
                  {buocHuy === 'anh' && <button type="submit" name="viec" value="buoc_ly_do" class="nb-nut phu" formnovalidate>Đổi lý do</button>}
                </div>
              </div>
            </>
          )}

          {moHuy && buocHuy === 'ly_do' && (
            <>
              <h2>Vì sao phải hủy?</h2>
              {lyDoDung.length === 0 ? (
                <p class="nb-rong">Chưa có lý do hủy nào đang dùng — quản lý thêm trong Cài đặt → Lý do.</p>
              ) : (
                <div class="xh-ly-do-luoi">
                  {lyDoDung.map(l => (
                    <button type="submit" name="ly_do_id" value={l.id} class={`nb-nut ${l.id === lyDoForm ? '' : 'phu'}`}
                      aria-pressed={l.id === lyDoForm ? 'true' : 'false'}>
                      {l.ten}{l.can_anh && <small>cần chụp ảnh</small>}
                    </button>
                  ))}
                </div>
              )}
            </>
          )}
          {/* Lý do đã chọn đi theo khi ở bước 1 và bước 3 (bước 2 là các nút chọn lại). */}
          {moHuy && buocHuy !== 'ly_do' && laUuid(lyDoForm) && <input type="hidden" name="ly_do_id" value={lyDoForm} />}
          {moHuy && buocHuy !== 'anh' && <input type="hidden" name="ghi_chu" value={ghiChuForm} />}

          {(!moHuy || buocHuy === 'anh') && (
            <div class="nb-the">
              {laXuatRa && (
                <fieldset class="xk-chon">
                  <legend>Lý do{loai === 'xuat_khac' ? ' *' : ''}</legend>
                  {loai === 'xuat_bep' && (
                    <label><input type="radio" name="ly_do_id" value="" checked={!lyDoChon.some(l => l.id === lyDoForm)} /> Không ghi</label>
                  )}
                  {lyDoChon.map(l => (
                    <label><input type="radio" name="ly_do_id" value={l.id} checked={l.id === lyDoForm} required={loai === 'xuat_khac'} /> {l.ten}</label>
                  ))}
                  {loai === 'xuat_khac' && lyDoChon.length === 0 && (
                    <p class="kho-phu">Chưa có lý do xuất khác nào — quản lý mở Thiết lập kho, bấm Khởi tạo để có sẵn Dùng nội bộ, Tặng khách, Hàng mẫu, Khác.</p>
                  )}
                </fieldset>
              )}
              {moHuy && (
                <>
                  <label class="nb-o"><span>Ảnh chụp hàng{canAnh ? ' *' : ' (không bắt buộc)'}</span>
                    <small>{canAnh ? `Lý do "${lyDoDangChon?.ten ?? ''}" cần ảnh.` : 'Lý do này không cần ảnh — có thì càng tốt.'} Chụp rõ nhãn và tình trạng hàng.</small>
                    <input type="file" name="anh" accept="image/*" capture="environment" multiple required={canAnh && anhGiu.length === 0} /></label>
                  {anhGiu.length > 0 && (
                    <>
                      <p class="kho-phu" style="margin:-.25rem 0 .4rem">Đã có {anhGiu.length} ảnh — không cần chụp lại. Muốn thêm thì chọn tiếp.</p>
                      <div class="kho-anh">
                        {anhGiu.map(d => anhLinkGiu.get(d)
                          ? <a href={anhLinkGiu.get(d)} target="_blank" rel="noopener"><img src={anhLinkGiu.get(d)} alt="Ảnh hàng báo hủy đã chụp" loading="lazy" /></a>
                          : <span class="kho-phu">{d.split('/').pop()}</span>)}
                      </div>
                    </>
                  )}
                </>
              )}
              <label class="nb-o"><span>Ghi chú</span>
                <input type="text" name="ghi_chu" value={ghiChuForm} maxlength="500" /></label>
            </div>
          )}

          <div class="kho-thanh-nut dinh">
            {moHuy && buocHuy === 'hang' && <button type="submit" name="viec" value="buoc_ly_do" class="nb-nut" formnovalidate>Tiếp: chọn lý do →</button>}
            {(!moHuy || buocHuy === 'anh') && <button type="submit" name="viec" value="ghi" class={`nb-nut ${moHuy ? 'kho-nut-xoa' : ''}`}>{nutGhi}</button>}
          </div>
        </form>
      )}
    </>
  ) : phieu && (
    // =======================================================================
    // XEM / DUYỆT
    // =======================================================================
    <>
      <p class="nb-dan">
        <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
        {' · '}lập bởi {ten.get(phieu.nguoi_tao ?? '') ?? '—'} lúc {dinhDangThoiDiem(phieu.created_at)}
        {phieu.duyet_luc && <>{' · '}{phieu.trang_thai === 'tu_choi' ? 'từ chối' : 'duyệt'} bởi {ten.get(phieu.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(phieu.duyet_luc)}</>}
      </p>
      {phieu.ly_do_tu_choi && <div class="nb-bao luu-y"><p><strong>Lý do từ chối:</strong> {phieu.ly_do_tu_choi}</p></div>}
      {diDuong && (
        <div class={`nb-bao ${phieu.trang_thai === 'nhan_thieu' ? 'luu-y' : ''}`} role="status">
          {phieu.trang_thai === 'dang_chuyen' && (
            <p>Hàng đang được mang ra {phieu.ten_vi_tri_den} — <strong>chưa vào quầy</strong>. Quầy kiểm hàng rồi bấm "Đã nhận đủ", thiếu thì ghi số thực nhận.
              {nut.diNhan && <>{' '}<a href="/noi-bo/kho/quay/nhan">Mở màn Nhận hàng</a></>}</p>
          )}
          {phieu.trang_thai === 'nhan_thieu' && (
            <p>Quầy <strong>nhận thiếu</strong>. Phần thiếu vẫn nằm ở "Đang mang ra quầy" — quản lý chọn trả về {phieu.ten_vi_tri} (hàng còn đó) hoặc ghi mất (rơi vỡ, thất lạc).</p>
          )}
          {phieu.trang_thai === 'da_tra_ve' && (
            <p>Quầy nhận thiếu; phần thiếu ({congGoi(traVe) ? `${congGoi(traVe)} gói · ` : ''}{dinhDangKg(congKg(traVe))} kg) đã trả về {phieu.ten_vi_tri}.</p>
          )}
          {phieu.trang_thai === 'da_nhan' && phieu.xu_ly_thieu === 'mat' && (
            <p>Quầy nhận thiếu; phần thiếu ({congGoi(ghiMat) ? `${congGoi(ghiMat)} gói · ` : ''}{dinhDangKg(congKg(ghiMat))} kg) đã ghi mất.</p>
          )}
          {phieu.trang_thai === 'da_nhan' && !phieu.xu_ly_thieu && <p>Quầy đã nhận đủ hàng.</p>}
          {phieu.trang_thai === 'da_huy' && <p>Chuyến đã hủy — hàng về lại {phieu.ten_vi_tri}.</p>}
        </div>
      )}

      <div class="nb-the">
        <dl class="kho-dl">
          <dt>{phieu.loai === 'chuyen' ? 'Từ' : 'Lấy ở'}</dt><dd>{phieu.ten_vi_tri}</dd>
          {phieu.loai === 'chuyen' && <><dt>Đến</dt><dd>{phieu.ten_vi_tri_den}</dd></>}
          {phieu.yeu_cau_id && <><dt>Theo yêu cầu</dt><dd><a href={`/noi-bo/kho/quay/yeu-cau/${phieu.yeu_cau_id}`}>{phieu.so_yeu_cau ?? 'của quầy'}</a></dd></>}
          {phieu.nhan_luc && (
            <><dt>Quầy nhận</dt><dd>{ten.get(phieu.nguoi_nhan ?? '') ?? '—'} · {dinhDangThoiDiem(phieu.nhan_luc)}
              {phieu.tong_goi_nhan !== null && <>{' · '}{phieu.tong_goi_nhan}/{phieu.tong_goi} gói</>}</dd></>
          )}
          {phieu.xu_ly_luc && (
            <><dt>{phieu.trang_thai === 'da_huy' ? 'Hủy chuyến' : phieu.xu_ly_thieu === 'tra_ve' ? 'Trả về kho' : 'Ghi mất'}</dt>
              <dd>{ten.get(phieu.nguoi_xu_ly ?? '') ?? '—'} · {dinhDangThoiDiem(phieu.xu_ly_luc)}{phieu.ly_do_xu_ly && <>{' · '}{phieu.ly_do_xu_ly}</>}</dd></>
          )}
          {phieu.loai === 'tra_ncc' && phieu.phieu_nhap_id && (
            <><dt>Phiếu nhập</dt><dd>{k.duoc('xem_gia') ? <a href={`/noi-bo/kho/nhap/${phieu.phieu_nhap_id}`}>xem phiếu nhập và công nợ</a> : 'trả lại nhà cung cấp'}</dd></>
          )}
          <dt>Ngày</dt><dd>{dinhDangNgay(phieu.ngay)}</dd>
          {phieu.ten_ly_do && <><dt>Lý do</dt><dd>{phieu.ten_ly_do}</dd></>}
          {phieu.ghi_chu && <><dt>Ghi chú</dt><dd>{phieu.ghi_chu}</dd></>}
        </dl>
        {phieu.anh.length > 0 && (
          <div class="kho-anh">
            {phieu.anh.map(a => anhLink.get(a)
              ? <a href={anhLink.get(a)} target="_blank" rel="noopener"><img src={anhLink.get(a)} alt="Ảnh hàng báo hủy" loading="lazy" /></a>
              : <span class="kho-phu">{a.split('/').pop()}</span>)}
          </div>
        )}
      </div>

      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>Mặt hàng</th><th class="so">Gói</th><th class="so">Kg (sổ)</th><th class="so">Kg quét/cân</th>{coCotNhan && <th class="so">Quầy nhận</th>}<th>Lô chỉ định</th></tr></thead>
          <tbody>
            {dongDb.map(d => {
              const m = tenMh.get(d.mat_hang_id);
              // Quầy nhận: hàng đếm gói so số gói, hàng theo kg so số kg.
              const thieu = m?.dem_goi ? (d.so_goi_nhan ?? d.so_goi) < d.so_goi : (d.so_kg_nhan ?? d.so_kg) < d.so_kg;
              return (
              <tr>
                <td>{m?.ten ?? '—'}</td>
                <td class="so">{d.so_goi || '—'}</td>
                <td class="so">{dinhDangKg(d.so_kg)}</td>
                <td class="so">{d.so_kg_do !== null ? dinhDangKg(d.so_kg_do) : '—'}</td>
                {coCotNhan && (
                  <td class="so">{m?.dem_goi ? (d.so_goi_nhan ?? '—') : d.so_kg_nhan !== null ? dinhDangKg(d.so_kg_nhan) : '—'}{thieu && <strong> (thiếu)</strong>}</td>
                )}
                <td>{d.lo_id ? loTheoMa.get(d.lo_id)?.ma_lo ?? '—' : 'tự lấy hàng hạn gần trước'}</td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <h2>Lô đã lấy</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr><th>Lô</th><th>Hạn dùng</th><th>Sổ ghi</th><th class="so">Gói</th><th class="so">Kg</th></tr></thead>
          <tbody>
            {soCaiLay.map(s => (
              <tr>
                <td>{loTheoMa.get(s.lo_id)?.ma_lo ?? '—'}</td>
                <td>{dinhDangNgay(loTheoMa.get(s.lo_id)?.han_dung)}</td>
                <td>{TEN_LOAI_SO_CAI[s.loai] ?? s.loai}</td>
                <td class="so">{Math.abs(s.so_goi) || '—'}</td>
                <td class="so">{dinhDangKg(Math.abs(s.so_kg))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {phieu.loai === 'huy' && (
        <p class="kho-phu">
          {phieu.trang_thai === 'cho_duyet' && 'Hàng đang nằm ở "Hàng chờ hủy" — không còn tính là hàng ở quầy, chưa ghi mất.'}
          {phieu.trang_thai === 'da_duyet' && `Đã ghi hủy ${dinhDangKg(Math.abs(daHuy.reduce((s, x) => s + x.so_kg, 0)))} kg.`}
          {phieu.trang_thai === 'tu_choi' && 'Hàng đã về lại chỗ cũ.'}
        </p>
      )}

      {phieu.loai === 'huy' && choToiDuyet && (
        <div class="nb-the kho-khong-in">
          <h2 style="margin-top:0">Duyệt báo hủy</h2>
          <form method="POST" class="kho-thanh-nut">
            <button type="submit" name="viec" value="duyet" class="nb-nut">Duyệt — ghi hủy</button>
          </form>
          <details>
            <summary style="cursor:pointer;font-weight:600">Từ chối — trả hàng về chỗ cũ</summary>
            <form method="POST" style="margin-top:.75rem">
              <label class="nb-o"><span>Lý do từ chối</span><textarea name="ly_do" required maxlength="500"></textarea></label>
              <button type="submit" name="viec" value="tu_choi" class="nb-nut kho-nut-xoa">Từ chối</button>
            </form>
          </details>
        </div>
      )}

      {nut.xuLyThieu && (
        <div class="nb-the kho-khong-in">
          <h2 style="margin-top:0">Xử lý hàng thiếu</h2>
          <form method="POST">
            <label class="nb-o"><span>Lý do *</span>
              <small>Hàng còn ở {phieu.ten_vi_tri} thì "Trả về kho". Rơi vỡ, thất lạc thì "Ghi mất" — tính vào hao hụt.</small>
              <textarea name="ly_do" required maxlength="500"></textarea></label>
            <div class="kho-thanh-nut" style="margin:0">
              <button type="submit" name="viec" value="tra_ve" class="nb-nut">Trả về kho</button>
              <button type="submit" name="viec" value="ghi_mat" class="nb-nut kho-nut-xoa">Ghi mất</button>
            </div>
          </form>
        </div>
      )}
      {nut.huyChuyen && (
        <details class="nb-the kho-khong-in">
          <summary style="cursor:pointer;font-weight:600">Hủy chuyến — hàng về lại {phieu.ten_vi_tri}</summary>
          <form method="POST" style="margin-top:.75rem">
            <p class="kho-phu" style="margin-top:0">Chỉ hủy được khi quầy chưa bấm nhận. Yêu cầu của quầy (nếu có) quay về chờ mang ra.</p>
            <label class="nb-o"><span>Lý do (không bắt buộc)</span><input type="text" name="ly_do" maxlength="500" /></label>
            <button type="submit" name="viec" value="huy_chuyen" class="nb-nut kho-nut-xoa">Hủy chuyến</button>
          </form>
        </details>
      )}
    </>
  )}

  <p class="kho-khong-in" style="margin-top:1.5rem">
    {nccTra
      ? <a href={`/noi-bo/kho/cong-no/${nccTra}`}>← Công nợ nhà cung cấp</a>
      : choToiDuyet
        ? <a href="/noi-bo/kho/duyet">← Về trang Duyệt</a>
        : <a href="/noi-bo/kho/xuat">← Danh sách phiếu</a>}
  </p>
  {!moi && phieu && <KyTen ten={phieu.loai === 'huy' ? ['Người báo hủy', 'Người chứng kiến', 'Quản lý duyệt']
    : phieu.loai === 'tra_ncc' ? ['Thủ kho', 'Nhà cung cấp nhận', 'Kế toán']
    : phieu.loai === 'xuat_khac' ? ['Người xuất', 'Người nhận', 'Quản lý'] : ['Người giao', 'Người nhận']} />}
</Kho>

<style>
  /* Báo hủy 3 bước */
  .xh-buoc { list-style: none; display: flex; gap: .5rem; padding: 0; margin: 0 0 1rem; font-size: .9rem; }
  .xh-buoc li { flex: 1; padding: .4rem .25rem; border-bottom: 3px solid var(--vach); color: var(--muc-nhat); }
  .xh-buoc li[aria-current] { border-color: var(--do); color: inherit; font-weight: 700; }
  .xh-ly-do-luoi { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); margin-bottom: 1rem; }
  .xh-ly-do-luoi .nb-nut { min-height: 64px; font-size: 1.05rem; flex-direction: column; gap: .15rem; }
  .xh-ly-do-luoi small { font-size: .8rem; font-weight: 400; }
  /* Lý do xuất bếp / xuất khác: ô tròn to */
  .xk-chon { display: flex; flex-wrap: wrap; gap: .5rem; border: 0; padding: 0; margin: 0 0 1rem; }
  .xk-chon legend { font-weight: 600; margin-bottom: .4rem; padding: 0; }
  .xk-chon label { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1rem;
    border: 1px solid var(--vach); border-radius: 10px; background: #fff; cursor: pointer; font-size: 16px; }
  .xk-chon input { width: 22px; height: 22px; margin: 0; accent-color: var(--do); }
  .xk-chon label:has(input:checked) { border-color: var(--do); font-weight: 700; }
  /* Xuất bếp nhanh */
  .xb-nhanh-luoi { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); margin-bottom: .5rem; }
</style>
