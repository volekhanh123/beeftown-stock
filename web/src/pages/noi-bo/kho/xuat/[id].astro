  huyTraTieuDe: { vi: (noi: string) => `Hủy phiếu trả hàng — hàng về lại ${noi}`, en: (noi: string) => `Cancel the supplier return — goods go back to ${noi}` },
  huyTraGoiY: {
    vi: 'Chỉ hủy được khi kế toán chưa xác nhận. Dùng khi ghi nhầm số kg hoặc nhà cung cấp không nhận lại hàng — hủy xong thì ghi lại cho đúng.',
    en: 'Can only be cancelled before the accountant confirms. Use it when the kg was entered wrongly or the supplier would not take the goods back — then record it again correctly.',
  },
  lyDoHuy: { vi: 'Lý do hủy', en: 'Reason for cancelling' },
