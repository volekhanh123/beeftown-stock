  huyChuyenGoiY: {
    vi: 'Chỉ hủy được khi quầy chưa bấm nhận. Yêu cầu của quầy (nếu có) quay về chờ mang ra.',
    en: 'Can only be cancelled before the counter confirms receipt. The counter request (if any) goes back to waiting.',
  },
  lyDoKhongBuoc: { vi: 'Lý do (không bắt buộc)', en: 'Reason (optional)' },
