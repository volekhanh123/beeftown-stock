---
/**
 * KHO — HỘP DUYỆT
 *
 * Mọi thứ đang chờ quản lý duyệt, ở MỘT chỗ, cũ nhất trước: phiếu nhập, báo
 * hủy, kiểm kê. Trước đây là ba danh sách lọc riêng; duyệt xong một phiếu lại
 * phải quay ra lọc lại.
 *
 * Thứ tự nhóm có lý do: kiểm kê ở một vị trí bị chặn khi vị trí đó còn phiếu
 * nhập chưa duyệt hoặc phiên pha lóc còn nháp (0023). Nên phiếu nhập đứng đầu,
 * kiểm kê đứng cuối, và phiên pha lóc nháp được nhắc riêng.
 *
 * Duyệt xong ở trang chi tiết thì quay về đây — phiếu tiếp theo nằm sẵn.
 * Link phiếu nhập mang ?tu=duyet để nút quay lại của trang phiếu về đây.
 *
 * Kế toán (0031) vào đây bằng quyền duyet_nhap: chỉ thấy phiếu nhập — điền
 * giá rồi duyệt. Báo hủy, kiểm kê, nhắc phiên pha lóc chỉ cho vai duyet.
 */
import Kho from '../../../layouts/Kho.astro';
import BaoKho from '../../../components/kho/BaoKho.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import { moTrangKho, tenNhanSu } from '../../../lib/kho/trang.ts';
import { docDanhSachPhieuNhap, type PhieuNhapTom } from '../../../lib/kho/nhap.ts';
import { docDanhSachPhieuXuat, docDonViPhieuXuat, type PhieuXuatTom } from '../../../lib/kho/xuat.ts';
import { docDanhSachKiemKe, type KiemKeTom } from '../../../lib/kho/kiem-ke.ts';
import { docDanhSachPhienPha, type PhienPhaTom } from '../../../lib/kho/pha-loc.ts';
import { cauLoiKho, dinhDangKg, dinhDangTien } from '../../../lib/kho/chung.ts';
import { thoiGianTruoc } from '../../../lib/kho/viec.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('duyet') && !k.duoc('duyet_nhap')) return Astro.redirect('/noi-bo/kho', 302);
const duyetNhap = k.duoc('duyet_nhap');
const duyetKhac = k.duoc('duyet');
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  khongDoc: { vi: 'Không đọc được danh sách chờ duyệt.', en: 'Could not read the approval list.' },
  tieuDe: { vi: 'Duyệt', en: 'Approvals' },
  choDuyet: { vi: 'Chờ duyệt', en: 'Awaiting approval' },
  khongCo: { vi: 'Không có gì chờ duyệt.', en: 'Nothing is waiting for approval.' },
  phieuNhap: { vi: 'Phiếu nhập', en: 'Goods receipts' },
  tonDau: { vi: ' · Tồn đầu kỳ', en: ' · Opening stock' },
  soDong: { vi: (n: number) => `${n} dòng`, en: (n: number) => `${n} ${s(n, 'line', 'lines')}` },
  chuaCoGia: { vi: ' · chưa có giá', en: ' · no prices yet' },
  gui: { vi: 'gửi', en: 'sent' },
  dienGiaDuyet: { vi: 'Điền giá & duyệt', en: 'Add prices & approve' },
  phienNhap: {
    vi: (n: number) => `${n} phiên pha lóc còn nháp`,
    en: (n: number) => `${n} butchery ${s(n, 'session', 'sessions')} still in draft`,
  },
  phienNhapDan: {
    vi: '— kiểm kê ở kho có tảng đang pha sẽ bị chặn cho tới khi phiên được chốt hoặc hủy.',
    en: '— stocktakes in a store with primals being butchered are blocked until the session is closed or cancelled.',
  },
  baoHuy: { vi: 'Báo hủy', en: 'Write-offs' },
  khongLyDo: { vi: 'Không ghi lý do', en: 'No reason given' },
  // dv: đơn vị đếm chung của các món trên phiếu ("khay"); phiếu có món khác đơn vị thì chữ chung.
  soGoi: { vi: (n: number, dv?: string) => `${n} ${dv ?? 'gói'} · `, en: (n: number, dv?: string) => `${n} ${dv ?? s(n, 'pack', 'packs')} · ` },
  o: { vi: 'ở', en: 'at' },
  bao: { vi: 'báo', en: 'reported' },
  xemAnhDuyet: { vi: 'Xem ảnh & duyệt', en: 'See photos & approve' },
  kiemKe: { vi: 'Kiểm kê', en: 'Stocktakes' },
  dongDaDem: { vi: (n: number) => `${n} dòng đã đếm`, en: (n: number) => `${n} ${s(n, 'line', 'lines')} counted` },
  xemChenhLech: { vi: 'Xem chênh lệch', en: 'See differences' },
});

let nhap: PhieuNhapTom[] = [];
let huy: PhieuXuatTom[] = [];
let kiemKe: KiemKeTom[] = [];
let phaNhap: PhienPhaTom[] = [];
let ten = new Map<string, string>();
/** Đơn vị đếm chung của từng phiếu báo hủy ("khay"). */
let donVi = new Map<string, string>();
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  const cn = k.chiNhanh.id;
  try {
    [nhap, huy, kiemKe, phaNhap] = await Promise.all([
      duyetNhap ? docDanhSachPhieuNhap(k.client, cn, 'cho_duyet') : Promise.resolve([]),
      duyetKhac ? docDanhSachPhieuXuat(k.client, cn, { loai: 'huy', trangThai: 'cho_duyet' }) : Promise.resolve([]),
      duyetKhac ? docDanhSachKiemKe(k.client, cn, 'cho_duyet') : Promise.resolve([]),
      duyetKhac ? docDanhSachPhienPha(k.client, cn, 'nhap') : Promise.resolve([]),
    ]);
    const cu = <T extends { created_at: string }>(a: T, b: T) => a.created_at.localeCompare(b.created_at);
    nhap.sort(cu); huy.sort(cu); kiemKe.sort(cu); phaNhap.sort(cu);
    [ten, donVi] = await Promise.all([
      tenNhanSu(k.client, [...nhap, ...huy, ...kiemKe, ...phaNhap].map(x => x.nguoi_tao)),
      docDonViPhieuXuat(k.client, huy.map(p => p.id)),
    ]);
  } catch (e) {
    loiDoc = cauLoiKho(e, t.khongDoc);
  }
}
const tong = nhap.length + huy.length + kiemKe.length;
const truoc = (luc: string) => thoiGianTruoc(luc, new Date(), nn);
---
<Kho k={k} tieuDe={t.tieuDe} huongDan={duyetKhac ? 'quan-ly-duyet' : 'duyet-nhap'}>
  <h1>{t.choDuyet}{tong > 0 ? ` · ${tong}` : ''}</h1>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />

  {tong === 0 && phaNhap.length === 0 ? (
    <p class="nb-rong">{t.khongCo}</p>
  ) : (
    <>
      {nhap.length > 0 && (
        <section class="kho-duyet-nhom">
          <h2><BieuTuong ten="nhap" /> {t.phieuNhap} · {nhap.length}</h2>
          <ul class="kho-duyet-ds">
            {nhap.map(p => (
              <li>
                <a href={`/noi-bo/kho/nhap/${p.id}?tu=duyet`} class="kho-duyet-the">
                  <span class="kho-duyet-chinh">
                    <strong>{p.so_phieu}{p.ten_nha_cung_cap ? ` · ${p.ten_nha_cung_cap}` : p.loai === 'ton_dau' ? t.tonDau : ''}</strong>
                    <span>{p.tong_kg > 0 && <>{dinhDangKg(p.tong_kg, nn)} kg · </>}{t.soDong(p.so_dong)}{p.tong_tien > 0 ? ` · ${dinhDangTien(p.tong_tien, nn)}` : t.chuaCoGia}</span>
                    <small>{ten.get(p.nguoi_tao ?? '') ?? '—'} {t.gui} · {truoc(p.created_at)}</small>
                  </span>
                  <span class="nb-nut phu">{t.dienGiaDuyet}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {phaNhap.length > 0 && (
        <div class="nb-bao luu-y">
          <p><strong>{t.phienNhap(phaNhap.length)}</strong> {t.phienNhapDan}{' '}
            {phaNhap.slice(0, 3).map((f, i) => <>{i > 0 ? ', ' : ''}<a href={`/noi-bo/kho/pha-loc/${f.id}`}>{f.so_phieu}</a></>)}
          </p>
        </div>
      )}

      {huy.length > 0 && (
        <section class="kho-duyet-nhom">
          <h2><BieuTuong ten="huy" /> {t.baoHuy} · {huy.length}</h2>
          <ul class="kho-duyet-ds">
            {huy.map(p => (
              <li>
                <a href={`/noi-bo/kho/xuat/${p.id}`} class="kho-duyet-the">
                  <span class="kho-duyet-chinh">
                    <strong>{p.so_phieu} · {p.ten_ly_do ?? t.khongLyDo}</strong>
                    <span>{p.tong_goi > 0 ? t.soGoi(p.tong_goi, donVi.get(p.id)) : ''}{p.tong_kg > 0 && <>{dinhDangKg(p.tong_kg, nn)} kg · </>}{t.o} {p.ten_vi_tri}</span>
                    <small>{ten.get(p.nguoi_tao ?? '') ?? '—'} {t.bao} · {truoc(p.created_at)}</small>
                  </span>
                  <span class="nb-nut phu">{t.xemAnhDuyet}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {kiemKe.length > 0 && (
        <section class="kho-duyet-nhom">
          <h2><BieuTuong ten="kiem_ke" /> {t.kiemKe} · {kiemKe.length}</h2>
          <ul class="kho-duyet-ds">
            {kiemKe.map(p => (
              <li>
                <a href={`/noi-bo/kho/kiem-ke/${p.id}`} class="kho-duyet-the">
                  <span class="kho-duyet-chinh">
                    <strong>{p.so_phieu} · {p.ten_vi_tri}</strong>
                    <span>{t.dongDaDem(p.so_dong)}</span>
                    <small>{ten.get(p.nguoi_tao ?? '') ?? '—'} · {truoc(p.created_at)}</small>
                  </span>
                  <span class="nb-nut phu">{t.xemChenhLech}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</Kho>
