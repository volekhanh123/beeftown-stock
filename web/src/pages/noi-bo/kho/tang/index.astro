---
/**
 * KHO — TẢNG · Ủ (0048)
 *
 * Món bật "Theo dõi theo tảng": mỗi tảng là một lô có số tảng (#0142), ngày mổ
 * và ngày ủ xong (tra bảng ủ theo tuổi thịt lúc nhận). Màn này cho phòng ủ và
 * bếp lóc biết tảng nào sẵn sàng lóc, tảng nào còn ủ mấy ngày. Không có tiền.
 *
 * 0050: bấm số tảng để truy vết (tang/[lo_id]); ô tìm "#0142" (?tim=) mở thẳng
 * tảng đó; mục "Đã lóc" (tảng nhận trong 90 ngày, đã lóc) cho biết bán được
 * bao nhiêu, còn bao nhiêu — đọc bằng kho_bao_cao_tang.
 * Không thấy số: câu cauKhongThayTang nói rõ số cấp lúc nhận hàng (0097) chỉ
 * hiện ở đây sau khi phiếu nhận được duyệt; chỉ vai nhap được chỉ sang Nhận hàng
 * (câu và link) — màn đó chuyển hướng vai khác.
 *
 * Lóc một chạm (vai pha_loc): dưới số tảng có nút "Lóc" — cùng luật tangLocDuoc
 * với mục "Tảng lóc được" ở Pha lóc mới (có số tảng, không còn đang ủ, còn chỗ
 * lóc được, chưa nằm trong phiên nháp). Nút gửi về /pha-loc/moi (viec=loc_tang,
 * ve=tang): mở được phiên thì vào thẳng bước 2, không thì quay lại đây kèm câu
 * báo. Tảng đang nằm trong phiên nháp: link "Đang lóc · PL…" tới phiên đó. Không
 * thêm cột (bảng giữ 5 cột). Đọc hỏng thì không có nút nào, trang vẫn hiện.
 *
 * 0107 (Khánh chốt 28/10/2026 — "nguyên tảng và ủ là hai mục khác nhau"): tảng → Trim → một tảng ủ + vụn thừa →
 * ủ → Cắt → khay. Bảng trên là NGUYÊN TẢNG (lô nhận hàng; nút "Trim"); bảng "Tảng ủ (đã trim)" là tảng sau trim
 * (loai_tang 'u' của kho_v_tang — số tảng của tảng gốc, ngày bắt đầu ủ, đã ủ bao nhiêu ngày; nút "Cắt"). Cả hai
 * nút cùng lóc một chạm (locMotTang gắn đúng công thức của món: Trim / Cắt). Trình tự do database giữ lúc chốt.
 */
import Kho from '../../../../layouts/Kho.astro';
import TheTrangCon from '../../../../components/kho/TheTrangCon.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import { moTrangKho } from '../../../../lib/kho/trang.ts';
import { cauLoiKho, congNgay, dinhDangKg, dinhDangNgay, dinhDangPhanTram, homNayVn, nhanKho, phoBienNhat } from '../../../../lib/kho/chung.ts';
import {
  cauConU, cauKhongThayTang, docBaoCaoTang, docTangTon, soTangChu, timTangTheoSo, TINH_TRANG_BAN_NB, TINH_TRANG_U_NB,
  type DongTang, type TangTon, type TinhTrangU,
} from '../../../../lib/kho/tang.ts';
import { docChoLocTang, docDanhSachPhienPha, docLoCuaPhien, tangLocDuoc } from '../../../../lib/kho/pha-loc.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
const cn = k.chiNhanh;
const t = dichNB(nn, {
  tieuDe: { vi: 'Tảng · ủ', en: 'Primals · aging' },
  khongDoc: { vi: 'Không đọc được danh sách tảng.', en: 'Could not read the primals.' },
  gioiThieu: {
    vi: 'Món theo dõi theo tảng: mỗi tảng có số riêng (ghi trên túi tảng), ngày mổ và ngày ủ xong theo bảng ủ của món.',
    en: 'Items tracked per primal: each primal has its own number (written on its bag), slaughter date and aging end date from the item\'s aging table.',
  },
  rong: {
    vi: 'Chưa có tảng nào. Bật "Theo dõi theo tảng" cho món ở Thiết lập → Mặt hàng, rồi nhận hàng từng tảng có ngày mổ.',
    en: 'No primals yet. Turn on "Track each primal" for the item in Setup → Items, then receive each primal with its slaughter date.',
  },
  so: { vi: 'Số tảng', en: 'Primal no.' },
  mon: { vi: 'Món', en: 'Item' },
  tuoi: { vi: 'Tuổi', en: 'Age' },
  uXong: { vi: 'Ủ xong', en: 'Aging ends' },
  kg: { vi: 'Kg', en: 'Kg' },
  han: { vi: 'Hạn dùng', en: 'Use-by' },
  noiChinh: { vi: (noi: string) => `Tảng nằm ở ${noi}, trừ dòng có ghi chỗ khác.`, en: (noi: string) => `Primals are in ${noi} unless the line says otherwise.` },
  ngay: { vi: (n: number) => `${n} ngày`, en: (n: number) => `${n} ${n === 1 ? 'day' : 'days'}` },
  soTang: { vi: (n: number) => `${n} tảng`, en: (n: number) => `${n} ${n === 1 ? 'primal' : 'primals'}` },
  tim: { vi: 'Tìm tảng theo số', en: 'Find a primal by number' },
  timGoiY: { vi: 'vd 142 hoặc #0142', en: 'e.g. 142 or #0142' },
  mo: { vi: 'Mở', en: 'Open' },
  moNhanHang: { vi: 'Mở Nhận hàng', en: 'Open Receive goods' },
  daLoc: { vi: 'Đã lóc (nhận trong 90 ngày)', en: 'Cut (received in the last 90 days)' },
  baoCao: { vi: 'Báo cáo theo tảng', en: 'By-primal report' },
  ngayLoc: { vi: 'Ngày lóc', en: 'Cut on' },
  thuHoi: { vi: 'Thu hồi', en: 'Yield' },
  daBan: { vi: 'Đã bán', en: 'Sold' },
  con: { vi: 'Còn', en: 'Left' },
  tinhTrang: { vi: 'Tình trạng', en: 'Status' },
  dangLoc: { vi: (sp: string) => `Đang lóc · ${sp}`, en: (sp: string) => `Being cut · ${sp}` },
  khongDocLoc: {
    vi: 'Chưa đọc được tảng nào đang lóc — nút Trim / Cắt tạm ẩn, tải lại trang.',
    en: 'Could not read which primals are being cut — the Trim / Cut buttons are hidden; reload the page.',
  },
  // 0107 — nguyên tảng và tảng ủ là hai mục
  nguyenTang: { vi: 'Nguyên tảng — chờ trim', en: 'Whole primals — waiting to be trimmed' },
  trim: { vi: 'Trim', en: 'Trim' },
  trimTang: { vi: (so: string) => `Trim tảng ${so}`, en: (so: string) => `Trim primal ${so}` },
  tangU: { vi: 'Tảng ủ (đã trim)', en: 'Aging primals (trimmed)' },
  tangUGioiThieu: {
    vi: 'Trim xong mỗi nguyên tảng ra một tảng ủ (giữ số tảng) và vụn thừa. Ủ xong bấm Cắt: tảng ủ chỉ ra khay, không ra vụn.',
    en: 'Trimming a whole primal gives one aging primal (same number) plus trimmings. When aging is done press Cut: an aging primal only gives trays, no trimmings.',
  },
  batDauU: { vi: 'Bắt đầu ủ', en: 'Aging since' },
  daU: { vi: 'Đã ủ', en: 'Aged' },
  cat: { vi: 'Cắt', en: 'Cut' },
  catTang: { vi: (so: string) => `Cắt tảng ủ ${so}`, en: (so: string) => `Cut aging primal ${so}` },
});

let ds: TangTon[] = [];
let daLoc: DongTang[] = [];
let loiDoc = k.loiDoc;
const homNay = homNayVn();
const tim = (Astro.url.searchParams.get('tim') ?? '').trim().slice(0, 12);
if (cn) {
  try {
    [ds, daLoc] = await Promise.all([docTangTon(k.client, cn.id), docBaoCaoTang(k.client, cn.id, congNgay(homNay, -90), homNay)]);
  } catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }
}
if (tim) {
  const loId = timTangTheoSo([...ds, ...daLoc], tim);
  if (loId) return Astro.redirect(`/noi-bo/kho/tang/${loId}`, 302);
}
// Nút "Lóc" (vai pha_loc): tảng lóc được theo đúng luật của Pha lóc mới; tảng đang nằm trong phiên nháp → link tới phiên.
const locDuoc = new Set<string>();
let dangLoc = new Map<string, { id: string; so_phieu: string }>();
let loiLoc = false;
if (cn && ds.length > 0 && k.duoc('pha_loc') && k.daKhoiTao) {
  try {
    const [nhap, cho] = await Promise.all([docDanhSachPhienPha(k.client, cn.id, 'nhap'), docChoLocTang(k.client, cn.id, ds.map(x => x.lo_id))]);
    dangLoc = await docLoCuaPhien(k.client, nhap);
    for (const x of tangLocDuoc(ds, cho, dangLoc)) locDuoc.add(x.lo_id);
  } catch {
    dangLoc = new Map();
    loiLoc = true;
  }
}
const daLocHien = daLoc.filter(d => d.ngay_loc !== null);
// 0107: nguyên tảng (lô nhận hàng) và tảng ủ (sau trim) là hai mục.
const nguyen = ds.filter(x => x.loai_tang !== 'u');
const dangU = ds.filter(x => x.loai_tang === 'u').sort((a, b) => (b.so_ngay_u ?? 0) - (a.so_ngay_u ?? 0) || (a.so_tang ?? 0) - (b.so_tang ?? 0));
const NHOM: TinhTrangU[] = ['san_sang', 'dang_u', 'chua_co_bang_u'];
const theoNhom = NHOM.map(tt => ({ tt, ds: nguyen.filter(x => x.tinh_trang_u === tt) })).filter(x => x.ds.length);
// Gọn 22/10/2026 (Khánh duyệt): bảng tảng còn 5 cột — bỏ Ngày mổ (đã có Tuổi), Hạn dùng (tảng đang ủ xem Ủ xong)
// và Ở đâu: tảng gần như luôn nằm một chỗ, chỉ ghi chỗ dưới tên món khi tảng nằm khác chỗ của đa số tảng. Ngày mổ,
// hạn dùng, chỗ để đủ ở trang chi tiết tảng.
const noiChinh = phoBienNhat(ds.map(x => x.vi_tri));
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="theo-tang">
  <TheTrangCon k={k} cha="ton" />
  <h1>{t.tieuDe}</h1>
  <p class="kho-phu">{t.gioiThieu}{noiChinh && <>{' '}{t.noiChinh(noiChinh)}</>}</p>
  <p><a href="/noi-bo/kho/bao-cao/theo-tang">{t.baoCao}</a></p>
  <BaoKho bao={k.bao} loiDoc={loiDoc} />
  {/* Ô tìm chỉ tìm trong lô (có sau khi duyệt); số tảng cấp lúc nhận hàng (0097) có trước đó — câu nói rõ điều này.
      Đọc danh sách hỏng (BaoKho đã báo) hay chưa có chi nhánh thì không nói "không thấy": đọc lỗi khác không có. */}
  {tim && cn && !loiDoc && (
    <div class="nb-bao loi" role="alert"><p>{cauKhongThayTang(tim, k.duoc('nhap'))[nn]}{k.duoc('nhap') && <>{' '}<a href="/noi-bo/kho/nhan-hang">{t.moNhanHang}</a></>}</p></div>
  )}
  {loiLoc && <div class="nb-bao luu-y" role="status"><p>{t.khongDocLoc}</p></div>}

  <form method="GET" action="/noi-bo/kho/tang" class="kho-thanh-nut">
    <label class="nb-o" style="margin:0"><span>{t.tim}</span>
      <input type="text" name="tim" value={tim} placeholder={t.timGoiY} /></label>
    <button type="submit" class="nb-nut phu">{t.mo}</button>
  </form>

  {!loiDoc && ds.length === 0 && daLocHien.length === 0 && <p class="nb-rong">{t.rong}</p>}

  {theoNhom.map(g => (
    <section class="nb-the">
      <h2 style="margin-top:0">{g.tt === 'chua_co_bang_u' ? t.nguyenTang : nhanKho(TINH_TRANG_U_NB, g.tt, nn)} · {t.soTang(g.ds.length)}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr>
            <th>{t.so}</th><th>{t.mon}</th><th class="so">{t.tuoi}</th>
            <th>{t.uXong}</th><th class="so">{t.kg}</th>
          </tr></thead>
          <tbody>
            {g.ds.map(x => (
              <tr>
                <td>
                  <a href={`/noi-bo/kho/tang/${x.lo_id}`}><strong>{soTangChu(x.so_tang) || x.ma_lo}</strong></a>
                  {dangLoc.has(x.lo_id) ? (
                    <><br /><a class="kho-phu" href={`/noi-bo/kho/pha-loc/${dangLoc.get(x.lo_id)?.id}`}>{t.dangLoc(dangLoc.get(x.lo_id)?.so_phieu ?? '')}</a></>
                  ) : locDuoc.has(x.lo_id) && (
                    <form method="POST" action="/noi-bo/kho/pha-loc/moi" style="margin:.35rem 0 0">
                      <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
                      <input type="hidden" name="lo_id" value={x.lo_id} />
                      <input type="hidden" name="ve" value="tang" />
                      <button type="submit" name="viec" value="loc_tang" class="nb-nut phu" aria-label={t.trimTang(soTangChu(x.so_tang))}>{t.trim}</button>
                    </form>
                  )}
                </td>
                <td>{x.ten_hang}{x.vi_tri && x.vi_tri !== noiChinh && <><br /><span class="kho-phu">{x.vi_tri}</span></>}</td>
                <td class="so">{x.tuoi_ngay === null ? '—' : t.ngay(x.tuoi_ngay)}</td>
                <td>{x.ngay_u_xong ? dinhDangNgay(x.ngay_u_xong) : '—'}{cauConU(x, nn) && <><br /><span class="kho-phu">{cauConU(x, nn)}</span></>}</td>
                <td class="so">{dinhDangKg(x.so_kg, nn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  {dangU.length > 0 && (
    <section class="nb-the">
      <h2 style="margin-top:0">{t.tangU} · {t.soTang(dangU.length)}</h2>
      <p class="kho-phu">{t.tangUGioiThieu}</p>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr>
            <th>{t.so}</th><th>{t.mon}</th><th>{t.batDauU}</th>
            <th class="so">{t.daU}</th><th class="so">{t.kg}</th>
          </tr></thead>
          <tbody>
            {dangU.map(x => (
              <tr>
                <td>
                  <a href={`/noi-bo/kho/tang/${x.lo_id}`}><strong>{soTangChu(x.so_tang) || x.ma_lo}</strong></a>
                  {dangLoc.has(x.lo_id) ? (
                    <><br /><a class="kho-phu" href={`/noi-bo/kho/pha-loc/${dangLoc.get(x.lo_id)?.id}`}>{t.dangLoc(dangLoc.get(x.lo_id)?.so_phieu ?? '')}</a></>
                  ) : locDuoc.has(x.lo_id) && (
                    <form method="POST" action="/noi-bo/kho/pha-loc/moi" style="margin:.35rem 0 0">
                      <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
                      <input type="hidden" name="lo_id" value={x.lo_id} />
                      <input type="hidden" name="ve" value="tang" />
                      <button type="submit" name="viec" value="loc_tang" class="nb-nut phu" aria-label={t.catTang(soTangChu(x.so_tang))}>{t.cat}</button>
                    </form>
                  )}
                </td>
                <td>{x.ten_hang}{x.vi_tri && x.vi_tri !== noiChinh && <><br /><span class="kho-phu">{x.vi_tri}</span></>}</td>
                <td>{x.ngay_bat_dau_u ? dinhDangNgay(x.ngay_bat_dau_u) : '—'}</td>
                <td class="so">{x.so_ngay_u === null ? '—' : t.ngay(x.so_ngay_u)}</td>
                <td class="so">{dinhDangKg(x.so_kg, nn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {daLocHien.length > 0 && (
    <section class="nb-the">
      <h2 style="margin-top:0">{t.daLoc} · {t.soTang(daLocHien.length)}</h2>
      <div class="kho-bang-khung">
        <table class="kho-bang">
          <thead><tr>
            <th>{t.so}</th><th>{t.mon}</th><th>{t.ngayLoc}</th><th class="so">{t.thuHoi}</th>
            <th class="so">{t.daBan}</th><th class="so">{t.con}</th><th>{t.han}</th><th>{t.tinhTrang}</th>
          </tr></thead>
          <tbody>
            {daLocHien.map(x => (
              <tr>
                <td><a href={`/noi-bo/kho/tang/${x.lo_id}`}><strong>{soTangChu(x.so_tang)}</strong></a></td>
                <td>{x.ten_hang}</td>
                <td>{x.ngay_loc ? dinhDangNgay(x.ngay_loc) : '—'}</td>
                <td class="so">{dinhDangPhanTram(x.thu_hoi_pt, 1, nn)}</td>
                <td class="so">{dinhDangKg(x.kg_ban, nn)}{x.ban_pt !== null && <><br /><span class="kho-phu">{dinhDangPhanTram(x.ban_pt, 0, nn)}</span></>}</td>
                <td class="so">{x.kg_con > 0 ? dinhDangKg(x.kg_con, nn) : '·'}</td>
                <td>{dinhDangNgay(x.han_dung)}</td>
                <td>{nhanKho(TINH_TRANG_BAN_NB, x.tinh_trang, nn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
</Kho>
