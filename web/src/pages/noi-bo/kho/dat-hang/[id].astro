---
/**
 * KHO — MỘT ĐƠN ĐẶT HÀNG (GĐ8a, migration 0039)
 *
 *   · NHÁP: sửa món / kg / ngày giao / ghi chú (quyền nhap, gửi kèm phien_ban —
 *     hai máy không đè nhau). Quản lý / chủ (nhap + duyet_nhap): "Lưu và gửi"
 *     hoặc "Gửi cho nhà cung cấp". Bỏ đơn nháp: nhap.
 *   · ĐÃ GỬI / NHẬN MỘT PHẦN: "Nhận hàng theo đơn này" (nhap) → phiếu nhận hàng
 *     nháp điền sẵn món và kg còn thiếu (kho_tao_phieu_nhap_tu_don) → mở màn nhận
 *     hàng. Hủy đơn: quản lý / chủ, bắt buộc lý do.
 *   · Mọi lúc: bảng đặt / đã nhận / còn lại, các phiếu nhận hàng đã gắn, link
 *     "In · Lưu PDF · Gửi Zalo".
 *
 * Đọc bằng kho_doc_don_dat_kg (chỉ kg). Giá dự kiến và thành tiền chỉ khi
 * k.duoc('xem_gia') — đọc bảng kho_don_dat_dong (RLS xem_gia). Không JavaScript.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docMatHang, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import {
  docDonDat, docGiaDonDat, docFormDonDat, chuFormDonDat, soDongThem, formTuDon, luuDonDat, guiDonDat, huyDonDat,
  taoPhieuTuDon, nhanTrangThaiDon, TOI_DA_DONG_THEM,
  type DonDat, type DongDatForm, type FormDonDat, type MonDat,
} from '../../../../lib/kho/dat-hang.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangThoiDiem, dinhDangTien, homNayVn, TRANG_THAI_CHUNG_TU,
  type KetQua,
} from '../../../../lib/kho/chung.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('nhap') && !k.duoc('xem_gia')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const DS = '/noi-bo/kho/dat-hang';
const coGia = k.duoc('xem_gia');
const lapDuoc = k.duoc('nhap');
const guiDuoc = lapDuoc && k.duoc('duyet_nhap');

let don: DonDat | null = null;
let gia = new Map<string, number | null>();
let matHang: MatHang[] = [];
let loiDoc = k.loiDoc;
try {
  don = await docDonDat(k.client, Astro.params.id ?? '');
  if (don) {
    [gia, matHang] = await Promise.all([
      coGia ? docGiaDonDat(k.client, don.id) : Promise.resolve(new Map<string, number | null>()),
      lapDuoc && don.trang_thai === 'nhap' ? docMatHang(k.client) : Promise.resolve([] as MatHang[]),
    ]);
  }
} catch (e) {
  loiDoc = cauLoiKho(e, 'Không đọc được đơn đặt hàng.');
}
if (!don && !loiDoc) return chuyenHuong(Astro, DS, { ok: false, cau: 'Không tìm thấy đơn đặt hàng này.' });

const laNhap = don?.trang_thai === 'nhap';
const choHang = don?.trang_thai === 'da_gui' || don?.trang_thai === 'nhan_mot_phan';
const suaDuoc = !!don && laNhap && lapDuoc;
const huyDuoc = !!don && (laNhap ? lapDuoc : choHang && guiDuoc);
const mon = new Map<string, MonDat>(matHang.filter(m => m.dang_dung || don?.dong.some(d => d.mat_hang_id === m.id))
  .map(m => [m.id, { ten: m.ten, dem_goi: m.dem_goi, don_vi_goi: m.don_vi_goi }]));

// ---------------------------------------------------------------------------
// Lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
let chu: FormDonDat | null = null;
let soDong = 2;
const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = { ok: false, cau: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.' };
}
if (form && don) {
  const d = don;
  const viec = String(form.get('viec') ?? '');
  const phienBan = Number(form.get('phien_ban'));
  const ve = (kq: KetQua, duoi = '') => chuyenHuong(Astro, `${DS}/${d.id}${duoi}`, kq);
  soDong = soDongThem(form, 2);

  if (['luu', 'luu_gui', 'them_dong'].includes(viec) && !suaDuoc) {
    bao = { ok: false, cau: 'Đơn đã gửi hoặc đã hủy — không sửa được nữa. Muốn đổi thì hủy đơn rồi lập đơn mới.' };
  } else if (viec === 'them_dong') {
    chu = chuFormDonDat(form, soDong);
    soDong = Math.min(soDong + 3, TOI_DA_DONG_THEM);
  } else if (viec === 'luu' || viec === 'luu_gui') {
    const r = docFormDonDat(form, mon, { coGia, soDong });
    chu = r.chu;
    if (r.loi.length) bao = { ok: false, cau: r.loi.join(' · ') };
    else {
      const kq = await luuDonDat(k.client, cn.id, {
        id: d.id, maGui: crypto.randomUUID(), phienBan, nccId: d.nha_cung_cap_id,
        ngayGiao: r.ngayGiao, ghiChu: r.chu.ghiChu, dong: r.dong,
      });
      if (!kq.ok) bao = kq;
      else if (viec === 'luu_gui' && guiDuoc) {
        const gui = await guiDonDat(k.client, d.id, kq.phienBan ?? phienBan + 1);
        return gui.ok ? ve(gui, '/in') : ve({ ok: false, cau: `Đã lưu nhưng chưa gửi được: ${gui.cau}` });
      } else return ve(kq);
    }
  } else if (viec === 'gui') {
    const kq = guiDuoc ? await guiDonDat(k.client, d.id, phienBan)
      : { ok: false, cau: 'Quản lý hoặc chủ quán mới gửi được đơn cho nhà cung cấp.' };
    return kq.ok ? ve(kq, '/in') : ve(kq);
  } else if (viec === 'huy') {
    const lyDo = String(form.get('ly_do') ?? '').trim();
    const kq = !huyDuoc ? { ok: false, cau: 'Tài khoản của bạn không hủy được đơn này — nhờ quản lý.' }
      : !laNhap && !lyDo ? { ok: false, cau: 'Ghi lý do hủy (ví dụ: nhà cung cấp hết hàng).' }
      : await huyDonDat(k.client, d.id, lyDo || null);
    return kq.ok && laNhap ? chuyenHuong(Astro, DS, kq) : ve(kq);
  } else if (viec === 'nhan') {
    const kq = lapDuoc ? await taoPhieuTuDon(k.client, d.id, String(form.get('ma_gui') ?? ''))
      : { ok: false, cau: 'Tài khoản của bạn không nhận hàng được.' };
    return kq.ok && kq.id ? chuyenHuong(Astro, `/noi-bo/kho/nhan-hang/${kq.id}`, kq) : ve(kq);
  } else {
    bao = { ok: false, cau: 'Việc không hợp lệ.' };
  }
}

// ---------------------------------------------------------------------------
// Hiển thị
// ---------------------------------------------------------------------------
const [nhanTT, lopTT] = don ? nhanTrangThaiDon(don.trang_thai) : ['', 'tat'];
const tongDat = don ? don.dong.reduce((s, d) => s + d.so_kg_dat, 0) : 0;
const tongNhan = don ? don.dong.reduce((s, d) => s + d.so_kg_da_nhan, 0) : 0;
const thanhTien = (mh: string, kg: number) => {
  const g = gia.get(mh);
  return g === null || g === undefined ? null : Math.round(kg * g);
};
const tongTien = don && coGia
  ? don.dong.reduce<number | null>((s, d) => { const t = thanhTien(d.mat_hang_id, d.so_kg_dat); return t === null ? s : (s ?? 0) + t; }, null)
  : null;
/** Ô của dòng đang có: form gửi lại thì chữ đã gõ, không thì số trên đơn. */
const oDong = (mh: string): DongDatForm => {
  const cu = chu?.co.get(mh);
  if (cu) return cu;
  const d = don?.dong.find(x => x.mat_hang_id === mh);
  return d ? formTuDon(d, gia.get(mh)) : { mh, kg: '', goi: '', gia: '' };
};
const idTrenDon = new Set(don?.dong.map(d => d.mat_hang_id) ?? []);
const dongThem = Array.from({ length: soDong }, (_, i) => chu?.them[i] ?? { mh: '', kg: '', goi: '', gia: '' });
const linkPhieu = (id: string) => (lapDuoc ? `/noi-bo/kho/nhan-hang/${id}` : `/noi-bo/kho/nhap/${id}`);
const nhanPhieu = (tt: string) => (tt === 'tu_choi' ? ['Bị trả về', 'tat'] : TRANG_THAI_CHUNG_TU[tt] ?? [tt, 'tat']);
const tieuDe = don ? `Đơn đặt ${don.so_phieu}` : 'Đơn đặt hàng';
---
<Kho k={k} tieuDe={tieuDe} huongDan="dat-hang">
  <h1>{tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {don && (
    <>
      {/* ======================= Đầu đơn ======================= */}
      <div class="nb-the">
        <p class="nb-dan" style="margin-top:0">
          <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
          {' '}· lập bởi {don.ten_nguoi_lap ?? '—'} lúc {dinhDangThoiDiem(don.created_at)}
          {don.gui_luc && <> · gửi {dinhDangThoiDiem(don.gui_luc)}{don.ten_nguoi_gui ? ` bởi ${don.ten_nguoi_gui}` : ''}</>}
        </p>
        {don.tre_hen && (
          <div class="nb-bao loi" role="alert"><p style="margin:0"><strong>Quá ngày giao</strong> — chưa thấy đủ hàng. Gọi nhà cung cấp hỏi lại; không giao nữa thì hủy đơn.</p></div>
        )}
        {don.trang_thai === 'huy' && (
          <div class="nb-bao luu-y"><p style="margin:0">Đơn đã hủy{don.huy_luc ? ` lúc ${dinhDangThoiDiem(don.huy_luc)}` : ''}{don.ly_do_huy ? `: ${don.ly_do_huy}` : '.'}</p></div>
        )}
        <dl class="kho-dl">
          <dt>Nhà cung cấp</dt><dd><strong>{don.ten_nha_cung_cap ?? '—'}</strong></dd>
          <dt>Ngày đặt</dt><dd>{dinhDangNgay(don.ngay_dat)}</dd>
          <dt>Ngày giao</dt><dd><strong>{dinhDangNgay(don.ngay_giao_du_kien)}</strong></dd>
          {don.ghi_chu && <><dt>Ghi chú</dt><dd>{don.ghi_chu}</dd></>}
          {coGia && tongTien !== null && <><dt>Tiền dự kiến</dt><dd>{dinhDangTien(tongTien)}</dd></>}
        </dl>
        <div class="kho-nut-nhanh" style="margin-bottom:0">
          <a class="nb-nut phu" href={`${DS}/${don.id}/in`}>In · Lưu PDF · Gửi Zalo</a>
          {choHang && lapDuoc && (
            <form method="POST">
              <input type="hidden" name="ma_gui" value={crypto.randomUUID()} />
              <button type="submit" name="viec" value="nhan" class="nb-nut dh-lon" style="width:100%">Nhận hàng theo đơn này</button>
            </form>
          )}
        </div>
      </div>

      {/* ======================= Món: xem ======================= */}
      {!suaDuoc && (
        <>
          <h2>Món đặt · {don.dong.length} món · {dinhDangKg(tongDat)} kg{tongNhan > 0 && <> · đã nhận {dinhDangKg(tongNhan)} kg</>}</h2>
          <div class="kho-bang-khung">
            <table class="kho-bang">
              <thead>
                <tr>
                  <th>Món</th>
                  <th class="so">Đặt</th>
                  <th class="so">Đã nhận</th>
                  <th class="so">Còn thiếu</th>
                  {coGia && <th class="so">Giá dự kiến/kg</th>}
                  {coGia && <th class="so">Thành tiền</th>}
                </tr>
              </thead>
              <tbody>
                {don.dong.map(d => (
                  <tr>
                    <td><strong>{d.ten_mat_hang}</strong><br /><span class="kho-phu">{d.ma}</span></td>
                    <td class="so">{dinhDangKg(d.so_kg_dat)} kg{d.so_goi_dat ? <><br /><span class="kho-phu">{d.so_goi_dat} {d.don_vi_goi}</span></> : null}</td>
                    <td class="so">{d.so_kg_da_nhan > 0 ? `${dinhDangKg(d.so_kg_da_nhan)} kg` : '·'}</td>
                    <td class="so">{d.du || d.so_kg_con_lai <= 0 ? '✓ đủ' : `${dinhDangKg(d.so_kg_con_lai)} kg`}</td>
                    {coGia && <td class="so">{gia.get(d.mat_hang_id) != null ? dinhDangTien(gia.get(d.mat_hang_id)) : '—'}</td>}
                    {coGia && <td class="so">{thanhTien(d.mat_hang_id, d.so_kg_dat) !== null ? dinhDangTien(thanhTien(d.mat_hang_id, d.so_kg_dat)) : '—'}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {choHang && <p class="kho-phu">Đủ = nhận từ 95% số kg đặt trở lên (thịt cân không tròn số), hoặc đủ số gói đã đặt. Đã nhận tính cả phiếu đang chờ duyệt.</p>}
        </>
      )}

      {/* ======================= Món: sửa nháp ======================= */}
      {suaDuoc && (
        <form method="POST" class="nb-the">
          <input type="hidden" name="phien_ban" value={String(don.phien_ban)} />
          <input type="hidden" name="so_dong" value={String(soDong)} />
          <h2 style="margin-top:0">Món đặt (đơn nháp — sửa được)</h2>
          <p class="kho-phu">Ghi 0 hoặc để trống số kg là bỏ món đó khỏi đơn.</p>
          <ul class="kho-dong-ds">
            {don.dong.map(d => {
              const o = oDong(d.mat_hang_id);
              return (
                <li>
                  <input type="hidden" name="mh" value={d.mat_hang_id} />
                  <span><strong>{d.ten_mat_hang}</strong><small>{d.ma}</small></span>
                  <span class="dh-o-hang">
                    <label class="nb-o dh-o"><span class="an">{d.ten_mat_hang} — số kg</span>
                      <input type="text" inputmode="decimal" name={`kg_${d.mat_hang_id}`} value={o.kg} autocomplete="off" /><small>kg</small></label>
                    {d.dem_goi && (
                      <label class="nb-o dh-o"><span class="an">{d.ten_mat_hang} — số {d.don_vi_goi}</span>
                        <input type="text" inputmode="numeric" name={`goi_${d.mat_hang_id}`} value={o.goi} autocomplete="off" /><small>{d.don_vi_goi}</small></label>
                    )}
                    {coGia && (
                      <label class="nb-o dh-o dh-o-gia"><span class="an">{d.ten_mat_hang} — giá dự kiến / kg</span>
                        <input type="text" inputmode="numeric" name={`gia_${d.mat_hang_id}`} value={o.gia} placeholder="giá/kg" autocomplete="off" /><small>đ/kg</small></label>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>

          <h3>Thêm món</h3>
          {dongThem.map((d, i) => (
            <div class={`dh-them${coGia ? ' co-gia' : ''}`}>
              <label class="nb-o"><span>Món</span>
                <ChonMatHang name={`t${i}_mh`} matHang={matHang.filter(m => !idTrenDon.has(m.id) || m.id === d.mh)} chon={d.mh} /></label>
              <label class="nb-o"><span>Số kg</span><input type="text" inputmode="decimal" name={`t${i}_kg`} value={d.kg} autocomplete="off" /></label>
              <label class="nb-o"><span>Số gói / tảng</span><input type="text" inputmode="numeric" name={`t${i}_goi`} value={d.goi} autocomplete="off" /></label>
              {coGia && <label class="nb-o"><span>Giá dự kiến/kg</span><input type="text" inputmode="numeric" name={`t${i}_gia`} value={d.gia} autocomplete="off" /></label>}
            </div>
          ))}
          {soDong < TOI_DA_DONG_THEM && (
            <button type="submit" name="viec" value="them_dong" class="nb-nut phu" formnovalidate>+ Thêm dòng</button>
          )}

          <div class="kho-luoi" style="margin-top:1rem">
            <label class="nb-o"><span>Ngày giao</span>
              <input type="date" name="ngay_giao" value={chu ? chu.ngayGiao : don.ngay_giao_du_kien} min={homNayVn()} /></label>
          </div>
          <label class="nb-o"><span>Ghi chú cho nhà cung cấp</span>
            <input type="text" name="ghi_chu" maxlength="500" value={chu ? chu.ghiChu : (don.ghi_chu ?? '')} /></label>
          {!guiDuoc && <p class="kho-phu">Lưu xong, nhờ quản lý xem lại và gửi đơn cho nhà cung cấp.</p>}

          <div class="kho-thanh-nut dinh">
            <button type="submit" name="viec" value="luu" class={`nb-nut dh-lon${guiDuoc ? ' phu' : ''}`}>Lưu</button>
            {guiDuoc && <button type="submit" name="viec" value="luu_gui" class="nb-nut dh-lon">Lưu và gửi cho nhà cung cấp</button>}
          </div>
        </form>
      )}

      {/* ======================= Phiếu nhận hàng theo đơn ======================= */}
      {don.phieu.length > 0 && (
        <>
          <h2>Phiếu nhận hàng theo đơn này</h2>
          <ul class="kho-dong-ds nb-the">
            {don.phieu.map(p => (
              <li>
                <span>
                  <strong>{p.so_phieu}</strong>
                  <small>Nhận {dinhDangNgay(p.ngay_nhap)} · {dinhDangKg(p.tong_kg)} kg</small>
                </span>
                <span class={`nb-nhan ${nhanPhieu(p.trang_thai)[1]}`} style="flex:0 0 auto">{nhanPhieu(p.trang_thai)[0]}</span>
                <a class="nb-nut phu" href={linkPhieu(p.id)}>Xem</a>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* ======================= Hủy ======================= */}
      {huyDuoc && (
        <details class="nb-the" style="margin-top:1.5rem">
          <summary style="cursor:pointer;font-weight:600">{laNhap ? 'Bỏ đơn nháp này' : 'Hủy đơn (nhà cung cấp không giao)'}</summary>
          <form method="POST" style="margin-top:.75rem">
            <label class="nb-o"><span>Lý do{laNhap ? ' (không bắt buộc)' : ' *'}</span>
              <input type="text" name="ly_do" maxlength="500" required={!laNhap} placeholder="ví dụ: nhà cung cấp hết hàng" /></label>
            {!laNhap && <p class="kho-phu">Phiếu nhận hàng đã gắn vẫn giữ nguyên — hàng đã về là đã về.</p>}
            <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{laNhap ? 'Bỏ đơn' : 'Hủy đơn'}</button>
          </form>
        </details>
      )}
      {choHang && lapDuoc && !guiDuoc && (
        <p class="kho-phu">Nhà cung cấp báo không giao? Nhờ quản lý hủy đơn.</p>
      )}
    </>
  )}

  <p style="margin-top:1.5rem"><a href={DS}>← Danh sách đơn đặt hàng</a></p>
</Kho>

<style>
  .dh-lon { min-height: 56px; font-size: 1.05rem; }
  .dh-o-hang { display: flex; gap: .4rem; flex-wrap: wrap; flex: 0 0 auto; }
  .dh-o { display: flex; align-items: center; gap: .3rem; margin: 0; }
  .dh-o input { width: 5.5rem; text-align: right; font-size: 1.1rem !important; }
  .dh-o-gia input { width: 7.5rem; }
  .dh-them { display: grid; grid-template-columns: 1fr 6rem 6rem; gap: .5rem; align-items: end; }
  .dh-them.co-gia { grid-template-columns: 1fr 6rem 6rem 8rem; }
  @media (max-width: 560px) {
    .dh-them, .dh-them.co-gia { grid-template-columns: 1fr 1fr; }
    .dh-them > label:first-child { grid-column: 1 / -1; }
  }
  .an { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
