---
/**
 * KHO — ĐẶT THEO MÓN: CHỌN MÓN TRƯỚC, MÁY GOM MỖI NHÀ CUNG CẤP MỘT ĐƠN NHÁP (0111, đợt 2)
 *
 * Khánh chốt 29/10/2026: đặt hàng chọn được món trước rồi mới tới nhà cung cấp ("hết ribeye, đặt ai?").
 *
 *   · Bảng gợi ý MỌI món (kho_goi_y_dat_hang, p_ncc null, không tiền): món nên đặt điền sẵn số kg, mỗi món có ô chọn
 *     nhà cung cấp — chọn sẵn NCC đề xuất (NCC chính → giao gần nhất ở chi nhánh này), các NCC bán món đó lên đầu
 *     (danh mục NCC – món, lib/kho/ncc-mat-hang.ts), NCC khác ở dưới. Món chưa cần đặt nằm trong mục gập.
 *   · "Thêm món khác": dòng thêm như form đơn, ô NCC trống = NCC đề xuất của món.
 *   · "Lập đơn nháp" → lapDonTheoNcc: mỗi NCC một đơn nháp (mã gửi suy ra từ mã gửi của form và nội dung đơn — bấm
 *     lại nguyên form không lập đôi). Một đơn → mở đơn đó; nhiều đơn → danh sách đơn nháp. Lập được một phần: câu báo
 *     kể riêng NCC lỗi / chưa chắc, form hiện lại đã bỏ các dòng vào đơn (boDongDaLap).
 *   · Đang có đơn nháp chưa gửi: báo trên đầu — số kg trong đơn nháp CHƯA trừ vào gợi ý (0039 chỉ trừ đơn đã gửi),
 *     mở lại trang rồi bấm lần nữa là đặt đôi.
 *
 * Không ô giá, không ngày giao: giá dự kiến điền trong từng đơn nháp, ngày giao tự tính theo NCC. Không JavaScript.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import DongDatTheoMon from '../../../../components/kho/DongDatTheoMon.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docMatHang, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import { docNccNhap, type NccNhap } from '../../../../lib/kho/nhan-hang.ts';
import {
  docGoiYDatHang, docDsDonDat, chuFormTheoMon, docFormTheoMon, lapDonTheoNcc, boDongDaLap, soDongThem, oKgGoiY, oGoiGoiY,
  TOI_DA_DONG_THEM, type DonDatTom, type GoiYDat, type MonDat, type FormTheoMon,
} from '../../../../lib/kho/dat-hang.ts';
import { docNccMon, nccCuaMon, type NccMon } from '../../../../lib/kho/ncc-mat-hang.ts';
import { cauLoiKho, kqHai, laUuid, type KetQua } from '../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('nhap')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const DS = '/noi-bo/kho/dat-hang';
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  tieuDe: { vi: 'Đặt theo món', en: 'Order by item' },
  khongDocDanhMuc: { vi: 'Không đọc được danh mục.', en: 'Could not read the catalog.' },
  khongDocGoiY: {
    vi: 'Không đọc được gợi ý đặt hàng — mạng hoặc database đang trục trặc. Vẫn thêm món tay được ở dưới, hoặc tải lại trang.',
    en: 'Could not read the order suggestions — the connection or the database is having trouble. You can still add items by hand below, or reload the page.',
  },
  dan: {
    vi: 'Chọn món cần đặt, máy gom theo nhà cung cấp: mỗi nhà cung cấp một đơn nháp. Nhà cung cấp chọn sẵn là nhà cung cấp chính của món (không có thì nơi giao gần nhất) — đổi được.',
    en: 'Choose the items to order and the app groups them by supplier: one draft order per supplier. The supplier picked for you is the item\'s main supplier (or whoever delivered it last) — you can change it.',
  },
  theoNcc: { vi: 'Đặt theo nhà cung cấp', en: 'Order by supplier' },
  nenDat: { vi: (n: number) => `Nên đặt (${n} món)`, en: (n: number) => `To order (${n} ${s(n, 'item', 'items')})` },
  khongCanDat: { vi: 'Chưa món nào cần đặt theo tồn kho và lượng dùng. Món muốn đặt thêm thì thêm ở dưới.', en: 'Nothing needs ordering based on stock and use. Add any items you want below.' },
  chuaCan: { vi: (n: number) => `Chưa cần đặt (${n} món)`, en: (n: number) => `Not needed yet (${n} ${s(n, 'item', 'items')})` },
  deXuat: { vi: '— nhà cung cấp đề xuất của món —', en: '— the item\'s suggested supplier —' },
  themMonKhac: { vi: 'Thêm món khác', en: 'Add other items' },
  monSo: { vi: (n: number) => `Món ${n}`, en: (n: number) => `Item ${n}` },
  soKg: { vi: 'Số kg', en: 'Kg' },
  soGoiTang: { vi: 'Số gói / tảng', en: 'Packs / pieces' },
  datCuaAi: { vi: 'Đặt của ai', en: 'Order from' },
  themDong: { vi: '+ Thêm dòng', en: '+ More lines' },
  gomSan: { vi: 'Theo số đang điền sẵn, máy sẽ lập:', en: 'With the numbers filled in now, the app will create:' },
  monCua: { vi: (ten: string, n: number) => `${ten}: ${n} món`, en: (ten: string, n: number) => `${ten}: ${n} ${s(n, 'item', 'items')}` },
  giaSau: {
    vi: 'Giá dự kiến và ngày giao điền trong từng đơn nháp (ngày giao để trống thì tự tính theo nhà cung cấp).',
    en: 'Expected prices and delivery dates go in each draft order (a blank delivery date is worked out from the supplier).',
  },
  lap: { vi: 'Lập đơn nháp', en: 'Create draft orders' },
  dangCoNhap: {
    vi: (n: number, ds: string) => `Đang có ${n} đơn nháp chưa gửi (${ds}). Số kg trong đơn nháp chưa được trừ vào gợi ý dưới đây — mở các đơn đó để soát trước khi lập thêm, kẻo đặt đôi.`,
    en: (n: number, ds: string) => `There ${n === 1 ? 'is' : 'are'} ${n} unsent draft ${s(n, 'order', 'orders')} (${ds}). The kg in drafts is not taken off the suggestions below — open them to check before creating more, or you may order twice.`,
  },
  moNhap: { vi: 'Mở các đơn nháp', en: 'Open the drafts' },
  veDs: { vi: '← Danh sách đơn đặt hàng', en: '← Purchase orders list' },
});

let ncc: NccNhap[] = [];
let matHang: MatHang[] = [];
let loiDoc = k.loiDoc;
try {
  [ncc, matHang] = await Promise.all([docNccNhap(k.client, cn.id), docMatHang(k.client)]);
} catch (e) { loiDoc = cauLoiKho(e, t.khongDocDanhMuc); }
// Gợi ý: lỗi thì báo ngay, vẫn thêm món tay được. Danh mục NCC – món chỉ để xếp ô chọn NCC — lỗi thì ô chọn không
// chia nhóm, gợi ý vẫn hiện. Đơn nháp đang có: chỉ để nhắc — lỗi thì không nhắc.
let goiY: GoiYDat[] = [];
let dsNccMon: NccMon[] = [];
let donNhap: DonDatTom[] = [];
let loiGoiY = false;
await Promise.all([
  docGoiYDatHang(k.client, cn.id, null).then(x => { goiY = x; }, () => { loiGoiY = true; }),
  docNccMon(k.client, cn.id).then(x => { dsNccMon = x; }, () => {}),
  docDsDonDat(k.client, cn.id, 'nhap', { q: '', tu: null, den: null, cuaToi: false, trang: 1 }, { gioiHan: 30 })
    .then(x => { donNhap = x; }, () => {}),
]);

const mon = new Map<string, MonDat>(matHang.filter(m => m.dang_dung)
  .map(m => [m.id, { ten: m.ten, dem_goi: m.dem_goi, don_vi_goi: m.don_vi_goi }]));
const tenNcc = new Map(ncc.map(n => [n.id, n.ten]));
const nccDung = new Set(ncc.map(n => n.id));
// NCC đề xuất của từng món: của gợi ý (NCC chính → giao gần nhất), món ngoài gợi ý thì NCC đầu của danh mục.
const macDinh = new Map<string, string>();
for (const c of dsNccMon) {
  if (!c.da_bo && !macDinh.has(c.mat_hang_id)) macDinh.set(c.mat_hang_id, nccCuaMon(dsNccMon, c.mat_hang_id)[0]?.nha_cung_cap_id ?? '');
}
for (const g of goiY) if (g.nha_cung_cap_id) macDinh.set(g.mat_hang_id, g.nha_cung_cap_id);

// ---------------------------------------------------------------------------
// Gửi form
// ---------------------------------------------------------------------------
const form = await docFormGui(Astro);
const maGuiCu = String(form?.get('ma_gui') ?? '');
const maGui = laUuid(maGuiCu) ? maGuiCu : crypto.randomUUID();
let soDong = soDongThem(form);
let bao: KetQua | null = k.bao;
let chu: FormTheoMon | null = null;
if (form) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'them_dong') {
    chu = chuFormTheoMon(form, soDong);
    soDong = Math.min(soDong + 3, TOI_DA_DONG_THEM);
  } else if (viec === 'lap' && ncc.length === 0) {
    // Đọc danh sách NCC lỗi: mọi NCC sẽ bị coi là "ngừng giao dịch" — nói đúng lỗi thay vì đổ cho NCC.
    chu = chuFormTheoMon(form, soDong);
    bao = kqHai(false, {
      vi: 'Chưa đọc được danh sách nhà cung cấp — tải lại trang rồi bấm lại.',
      en: 'Could not read the supplier list — reload the page and press again.',
    });
  } else if (viec === 'lap') {
    const r = docFormTheoMon(form, mon, { soDong, nccDung, macDinh });
    chu = r.chu;
    if (r.loi.length) bao = { ok: false, cau: r.loi.join(' · '), cauEn: r.loiEn.join(' · ') };
    else {
      const kq = await lapDonTheoNcc(k.client, cn.id, r.theoNcc, maGui, tenNcc);
      if (kq.ok) return chuyenHuong(Astro, kq.don.length === 1 ? `${DS}/${kq.don[0].id}` : `${DS}?loc=nhap`, kq);
      bao = kq;
      chu = boDongDaLap(r.chu, new Set(kq.don.flatMap(x => x.mon)));
    }
  } else {
    bao = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const canDat = goiY.filter(g => g.de_nghi_kg > 0 || g.duoi_toi_thieu);
const chuaCan = goiY.filter(g => !(g.de_nghi_kg > 0 || g.duoi_toi_thieu));
const idGoiY = new Set(goiY.map(g => g.mat_hang_id));
/** Giá trị ô: form gửi lại thì giữ chữ đã gõ, lần đầu là số gợi ý. */
const oGoiY = (g: GoiYDat, o: 'kg' | 'goi') => {
  const cu = chu?.co.get(g.mat_hang_id);
  if (cu) return cu[o];
  return o === 'kg' ? oKgGoiY(g) : oGoiGoiY(g);
};
const nccDong = (g: GoiYDat) => chu?.nccCo.get(g.mat_hang_id) || g.nha_cung_cap_id || '';
/** Ô chọn NCC của một món: NCC bán món đó (danh mục, NCC chính đầu) rồi NCC khác. */
const nhomNcc = (monId: string) => {
  const ban = nccCuaMon(dsNccMon, monId).filter(c => nccDung.has(c.nha_cung_cap_id))
    .map(c => ({ id: c.nha_cung_cap_id, ten: tenNcc.get(c.nha_cung_cap_id) ?? '', chinh: c.la_chinh }));
  return { ban, khac: ncc.filter(n => !ban.some(c => c.id === n.id)).map(n => ({ id: n.id, ten: n.ten })) };
};
const dongThem = Array.from({ length: soDong }, (_, i) => ({
  ...(chu?.them[i] ?? { mh: '', kg: '', goi: '', gia: '' }), ncc: chu?.nccThem[i] ?? '',
}));
// Lần đầu mở trang: kể trước máy sẽ lập những đơn nào với số điền sẵn.
const gomSan = new Map<string, number>();
if (!chu) {
  for (const g of canDat) {
    const n = g.nha_cung_cap_id;
    if (oKgGoiY(g) && n) gomSan.set(n, (gomSan.get(n) ?? 0) + 1);
  }
}
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="dat-hang">
  <h1>{t.tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  <p class="kho-phu">{t.dan} <a href={`${DS}/moi`}>{t.theoNcc}</a></p>
  {loiGoiY && <div class="nb-bao luu-y" role="alert"><p>{t.khongDocGoiY}</p></div>}
  {donNhap.length > 0 && (
    <div class="nb-bao luu-y" role="status"><p>{t.dangCoNhap(donNhap.length, [...new Set(donNhap.map(d => d.ten_nha_cung_cap))].join(', '))}{' '}<a href={`${DS}?loc=nhap`}>{t.moNhap}</a></p></div>
  )}

  <form method="POST">
    <input type="hidden" name="ma_gui" value={maGui} />
    <input type="hidden" name="so_dong" value={String(soDong)} />

    {!loiGoiY && (
      <>
        <h2>{t.nenDat(canDat.length)}</h2>
        {canDat.length === 0 && <p class="kho-phu">{t.khongCanDat}</p>}
        <ul class="kho-dong-ds">
          {canDat.map(g => (
            <DongDatTheoMon g={g} kg={oGoiY(g, 'kg')} goi={oGoiY(g, 'goi')} nccChon={nccDong(g)} {...nhomNcc(g.mat_hang_id)} chiTiet />
          ))}
        </ul>

        {chuaCan.length > 0 && (
          <details class="nb-the" style="margin-top:1rem" open={chuaCan.some(g => !!chu?.co.get(g.mat_hang_id)?.kg) || undefined}>
            <summary style="cursor:pointer;font-weight:600">{t.chuaCan(chuaCan.length)}</summary>
            <ul class="kho-dong-ds">
              {chuaCan.map(g => (
                <DongDatTheoMon g={g} kg={oGoiY(g, 'kg')} goi={oGoiY(g, 'goi')} nccChon={nccDong(g)} {...nhomNcc(g.mat_hang_id)} />
              ))}
            </ul>
          </details>
        )}
      </>
    )}

    <h2>{t.themMonKhac}</h2>
    {dongThem.map((d, i) => (
      <div class="dh-them">
        <label class="nb-o"><span>{t.monSo(i + 1)}</span>
          <ChonMatHang name={`t${i}_mh`} matHang={matHang.filter(m => !idGoiY.has(m.id) || m.id === d.mh)} chon={d.mh} /></label>
        <label class="nb-o"><span>{t.soKg}</span>
          <input type="text" inputmode="decimal" name={`t${i}_kg`} value={d.kg} autocomplete="off" /></label>
        <label class="nb-o"><span>{t.soGoiTang}</span>
          <input type="text" inputmode="numeric" name={`t${i}_goi`} value={d.goi} autocomplete="off" /></label>
        <label class="nb-o"><span>{t.datCuaAi}</span>
          <select name={`t${i}_ncc`}>
            <option value="">{t.deXuat}</option>
            {ncc.map(n => <option value={n.id} selected={n.id === d.ncc}>{n.ten}</option>)}
          </select></label>
      </div>
    ))}
    {soDong < TOI_DA_DONG_THEM && (
      <button type="submit" name="viec" value="them_dong" class="nb-nut phu" formnovalidate>{t.themDong}</button>
    )}

    <div class="nb-the" style="margin-top:1rem">
      {gomSan.size > 0 && (
        <>
          <p style="margin:0 0 .25rem"><strong>{t.gomSan}</strong></p>
          <ul style="margin:0 0 .5rem">
            {[...gomSan].map(([id, n]) => <li>{t.monCua(tenNcc.get(id) ?? '—', n)}</li>)}
          </ul>
        </>
      )}
      <p class="kho-phu" style="margin:0">{t.giaSau}</p>
    </div>

    <div class="kho-thanh-nut dinh">
      <button type="submit" name="viec" value="lap" class="nb-nut dh-lon">{t.lap}</button>
    </div>
  </form>

  <p style="margin-top:1.5rem"><a href={DS}>{t.veDs}</a></p>
</Kho>

<style>
  .dh-lon { min-height: 56px; font-size: 1.05rem; }
  .dh-them { display: grid; grid-template-columns: 1fr 6rem 6rem 12rem; gap: .5rem; align-items: end; }
  @media (max-width: 560px) {
    .dh-them { grid-template-columns: 1fr 1fr; }
    .dh-them > label:first-child, .dh-them > label:last-child { grid-column: 1 / -1; }
  }
</style>
