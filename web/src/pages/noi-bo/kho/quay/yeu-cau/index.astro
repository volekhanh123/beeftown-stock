---
/**
 * KHO — QUẦY CẦN HÀNG (0032)
 *
 * NV quầy: gửi yêu cầu mang hàng ra quầy. Phần mềm liệt kê sẵn món ở quầy dưới
 * mức (kho_goi_y_ra_quay) kèm số gói nên lấy — sửa số được, ghi 0 là bỏ món,
 * thêm món khác ở các dòng bên dưới. Gửi xong mở trang yêu cầu vừa gửi.
 * Thủ kho: danh sách yêu cầu đang chờ, cũ trước — bấm vào để mang ra.
 *
 * Nhiều quầy thì đổi quầy bằng link ?vt=<quầy> (GET) — danh sách gợi ý là của
 * quầy đó. "Thêm dòng" gửi lại form (viec = them_dong), giữ nguyên số đã gõ
 * và ma_gui. Không có JavaScript.
 */
import Kho from '../../../../../layouts/Kho.astro';
import TheTrangCon from '../../../../../components/kho/TheTrangCon.astro';
import BaoKho from '../../../../../components/kho/BaoKho.astro';
import BieuTuong from '../../../../../components/kho/BieuTuong.astro';
import ChonMatHang from '../../../../../components/kho/ChonMatHang.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../../lib/kho/trang.ts';
import { docViTri, type ViTri } from '../../../../../lib/kho/danh-muc.ts';
import {
  docMatHangQuay, docGoiYRaQuay, docDanhSachYeuCau, docDonViYeuCau, docFormYeuCau, taoYeuCau, soDeNghi, cauSoLuong,
  type GoiYRaQuay, type MatHangQuay, type YeuCauQuay,
} from '../../../../../lib/kho/quay.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangThoiDiem, kqHai, laUuid, trangThaiKho, type HaiThuTieng, type KetQua,
} from '../../../../../lib/kho/chung.ts';
import { dichNB } from '../../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('van_hanh')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const CAU = {
  viecSai: { vi: 'Việc không hợp lệ.', en: 'Invalid action.' },
} satisfies Record<string, HaiThuTieng>;
const t = dichNB(nn, {
  khongDocDm: { vi: 'Không đọc được danh mục.', en: 'Could not read the catalog.' },
  khongDocYc: { vi: 'Không đọc được yêu cầu của quầy.', en: 'Could not read the counter requests.' },
  goi: { vi: 'gói', en: 'packs' },
  tieuDe: { vi: 'Quầy cần hàng', en: 'Counter requests' },
  yeuCauRaQuay: { vi: 'Yêu cầu hàng ra quầy', en: 'Request stock for the counter' },
  dangChoMang: { vi: 'Đang chờ mang ra', en: 'Waiting to be brought out' },
  soMon: { vi: (n: number) => `${n} món`, en: (n: number) => `${n} ${s(n, 'item', 'items')}` },
  // dv: đơn vị đếm chung của các món trong yêu cầu ("khay"); không có thì chữ chung.
  soGoi: { vi: (n: number, dv?: string) => `${n} ${dv ?? 'gói'}`, en: (n: number, dv?: string) => `${n} ${dv ?? s(n, 'pack', 'packs')}` },
  xem: { vi: 'Xem', en: 'View' },
  mangRa: { vi: 'Mang ra', en: 'Bring out' },
  chuaYeuCau: {
    vi: 'Quầy chưa yêu cầu gì. Mang hàng ra không cần yêu cầu:',
    en: 'The counter has not requested anything. To bring goods out without a request:',
  },
  lapPhieuChuyen: { vi: 'lập phiếu chuyển', en: 'create a transfer slip' },
  chuaCoQuay: {
    vi: 'Chi nhánh chưa có quầy nào đang dùng. Quản lý thêm quầy ở Cài đặt → Vị trí và lý do.',
    en: 'This branch has no counter in use. A manager adds counters in Setup → Locations and reasons.',
  },
  chonQuay: { vi: 'Chọn quầy', en: 'Choose counter' },
  monSapHet: { vi: 'Món quầy sắp hết', en: 'Counter items running low' },
  khongDuoiMuc: {
    vi: 'Không món nào dưới mức tối thiểu. Cần thêm món gì thì ghi ở dưới.',
    en: 'No items are below their minimum. If you need anything else, add it below.',
  },
  soDienSan: {
    vi: 'Số đã điền sẵn là số nên lấy cho đủ quầy. Sửa được; ghi 0 là không lấy món đó.',
    en: 'The numbers filled in are what the counter needs to be full. You can change them; enter 0 to skip an item.',
  },
  quayCon: { vi: (sl: string) => `Quầy còn ${sl}`, en: (sl: string) => `Counter has ${sl}` },
  dangMangRa: { vi: (sl: string) => ` · đang mang ra ${sl}`, en: (sl: string) => ` · ${sl} on the way` },
  khoCon: { vi: (sl: string) => `kho còn ${sl}`, en: (sl: string) => `store has ${sl}` },
  nMonHetKho: {
    vi: (n: number) => `${n} món kho cũng đã hết — báo quản lý đặt hàng`,
    en: (n: number) => `${n} ${n === 1 ? 'item is' : 'items are'} out in the store too — ask a manager to order more`,
  },
  soDvAn: { vi: (ten: string, dv: string) => `${ten} — số ${dv}`, en: (ten: string, dv: string) => `${ten} — quantity (${dv})` },
  themMon: { vi: 'Thêm món khác', en: 'Add other items' },
  themMonGoiY: {
    vi: 'Món đếm gói: ghi số gói. Món bán theo ký: ghi số kg (vd. 1,5).',
    en: 'Items counted in packs: enter the number of packs. Items sold by weight: enter the kg (e.g. 1.5).',
  },
  mon: { vi: (n: number) => `Món ${n}`, en: (n: number) => `Item ${n}` },
  soLuong: { vi: 'Số lượng', en: 'Quantity' },
  themDong: { vi: '+ Thêm dòng', en: '+ Add line' },
  ghiChuThuKho: { vi: 'Ghi chú cho thủ kho (không bắt buộc)', en: 'Note for the storekeeper (optional)' },
  guiYeuCau: { vi: 'Gửi yêu cầu cho thủ kho', en: 'Send a request to the storekeeper' },
  ganDay: { vi: 'Gần đây', en: 'Recent' },
  phieu: { vi: (so: string) => ` · phiếu ${so}`, en: (so: string) => ` · slip ${so}` },
});

const laQuay = k.nhanSu.vai_tro === 'nhan_vien_quay';
// Thủ kho là người mang ra, không tự yêu cầu mình. Quản lý / chủ gửi thay quầy được.
const choGui = laQuay || k.duoc('duyet');

let viTri: ViTri[] = [];
let matHang: MatHangQuay[] = [];
let loiDoc = k.loiDoc;
try {
  [viTri, matHang] = await Promise.all([docViTri(k.client, cn.id), docMatHangQuay(k.client)]);
} catch (e) { loiDoc = cauLoiKho(e, t.khongDocDm); }
const cacQuay = viTri.filter(v => v.loai === 'quay' && v.dang_dung);

// ---------------------------------------------------------------------------
// Gửi yêu cầu
// ---------------------------------------------------------------------------
const form = await docFormGui(Astro);
// Quầy đang chọn: form gửi lên (gửi lỗi thì vẫn đúng quầy đó), hoặc ?vt=, hoặc quầy đầu.
const vtChon = String(form?.get('vi_tri_id') ?? Astro.url.searchParams.get('vt') ?? '');
const quay = cacQuay.find(v => v.id === vtChon) ?? cacQuay[0] ?? null;
const maGuiCu = String(form?.get('ma_gui') ?? '');
const maGui = laUuid(maGuiCu) ? maGuiCu : crypto.randomUUID();
const soDongCu = Number(form?.get('so_dong') ?? 0);
let soDong = Number.isInteger(soDongCu) && soDongCu >= 1 && soDongCu <= 30 ? soDongCu : 3;
let bao: KetQua | null = k.bao;
if (form && choGui) {
  const viec = String(form.get('viec') ?? '');
  if (viec === 'them_dong') {
    soDong = Math.min(soDong + 2, 30);
  } else if (viec === 'gui') {
    const { dong, loi, loiEn, nguon } = docFormYeuCau(form, matHang, soDong);
    if (loi.length > 0) bao = kqHai(false, { vi: loi.join(' '), en: loiEn.join(' ') });
    else {
      const vt = String(form.get('vi_tri_id') ?? '');
      const kq = await taoYeuCau(k.client, cn.id, maGui, laUuid(vt) ? vt : quay?.id ?? null, nguon,
        String(form.get('ghi_chu') ?? '').trim(), dong);
      if (kq.ok && kq.id) return chuyenHuong(Astro, `/noi-bo/kho/quay/yeu-cau/${kq.id}`, kq);
      bao = kq;
    }
  } else {
    bao = kqHai(false, CAU.viecSai);
  }
}

// ---------------------------------------------------------------------------
// Đọc
// ---------------------------------------------------------------------------
let goiY: GoiYRaQuay[] = [];
let yeuCau: YeuCauQuay[] = [];
let ten = new Map<string, string>();
/** Đơn vị đếm chung của từng yêu cầu ("khay") — cho dòng "1 món · 10 khay". */
let donVi = new Map<string, string>();
try {
  const [g, y] = await Promise.all([
    choGui && quay ? docGoiYRaQuay(k.client, cn.id, quay.id) : Promise.resolve([] as GoiYRaQuay[]),
    docDanhSachYeuCau(k.client, cn.id, { gioiHan: 30 }),
  ]);
  goiY = g; yeuCau = y;
  [ten, donVi] = await Promise.all([
    tenNhanSu(k.client, yeuCau.map(y => y.nguoi_tao)), docDonViYeuCau(k.client, yeuCau.map(y => y.id), matHang),
  ]);
} catch (e) { loiDoc = loiDoc ?? cauLoiKho(e, t.khongDocYc); }

const dangCho = yeuCau.filter(y => y.trang_thai === 'cho').sort((a, b) => a.created_at.localeCompare(b.created_at));
const khac = yeuCau.filter(y => y.trang_thai !== 'cho');
// Gọn 22/10/2026 (Khánh duyệt): món kho cũng hết không có ô nhập — thủ kho không có gì mà mang ra. Gom vào một
// mục gập "n món kho đã hết"; vẫn thêm được ở "Thêm món" nếu thấy sổ sai.
const conKho = (g: GoiYRaQuay) => (g.dem_goi ? g.so_goi_kho : g.so_kg_kho) > 0;
const goiYCo = goiY.filter(conKho);
const goiYHetKho = goiY.filter(g => !conKho(g));
const idGoiY = new Set(goiYCo.map(g => g.mat_hang_id));
const mhTheoId = new Map(matHang.map(m => [m.id, m]));
/** Giá trị ô: gửi lại form thì giữ số đã gõ, lần đầu thì số gợi ý. */
const giaTriGoiY = (g: GoiYRaQuay) => {
  const cu = form?.get(`g_${g.mat_hang_id}`);
  if (cu !== null && cu !== undefined) return String(cu);
  const n = soDeNghi(g);
  // Ô nhập: "1,5" hay "1.5" đều đọc được (docKg) — viết theo thói quen của người xem.
  return n > 0 ? String(g.dem_goi ? n : dinhDangKg(n, nn)) : '';
};
const dongThem = Array.from({ length: soDong }, (_, i) => ({
  i, mh: String(form?.get(`t${i}_mat_hang`) ?? ''), so: String(form?.get(`t${i}_so`) ?? ''),
}));
// Trạng thái lạ: hiện nguyên mã, lớp "nhap" (như trước).
const nhan = (tt: string) => ((x: [string, string]) => [x[0], x[1] || 'nhap'])(trangThaiKho(tt, nn));
---
<Kho k={k} tieuDe={t.tieuDe} huongDan={laQuay ? 'yeu-cau' : 'ra-quay'}>
  <TheTrangCon k={k} cha="quay" />
  <h1>{choGui ? t.yeuCauRaQuay : t.tieuDe}</h1>
  <BaoKho bao={bao} loiDoc={loiDoc} />

  {/* ======================= Yêu cầu đang chờ ======================= */}
  {dangCho.length > 0 && (
    <section class="kho-khoi">
      <h2><BieuTuong ten="chuyen" /> {t.dangChoMang} · {dangCho.length}</h2>
      <ul class="kho-dong-ds">
        {dangCho.map(y => (
          <li>
            <span>
              <strong>{y.so_phieu} · {y.ten_vi_tri}</strong>
              <small>{t.soMon(y.so_mon)}{y.tong_goi > 0 ? ` · ${t.soGoi(y.tong_goi, donVi.get(y.id))}` : ''} · {dinhDangThoiDiem(y.created_at)}{y.nguoi_tao && ten.get(y.nguoi_tao) ? ` · ${ten.get(y.nguoi_tao)}` : ''}</small>
            </span>
            <a class="nb-nut yc-nut" href={`/noi-bo/kho/quay/yeu-cau/${y.id}`}>{laQuay ? t.xem : t.mangRa}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {!choGui && dangCho.length === 0 && (
    <p class="nb-rong">{t.chuaYeuCau}{' '}
      <a href="/noi-bo/kho/xuat/moi?loai=chuyen">{t.lapPhieuChuyen}</a>.</p>
  )}

  {/* ======================= Gửi yêu cầu mới ======================= */}
  {choGui && !quay && (
    <div class="nb-bao luu-y"><p>{t.chuaCoQuay}</p></div>
  )}
  {choGui && quay && (
    <form method="POST" class="nb-the">
      <input type="hidden" name="ma_gui" value={maGui} />
      <input type="hidden" name="so_dong" value={String(soDong)} />
      <input type="hidden" name="vi_tri_id" value={quay.id} />
      {cacQuay.length > 1 && (
        <nav class="kho-dh" aria-label={t.chonQuay}>
          {cacQuay.map(v => (
            <a href={`/noi-bo/kho/quay/yeu-cau?vt=${v.id}`} aria-current={v.id === quay.id ? 'page' : undefined}>{v.ten}</a>
          ))}
        </nav>
      )}

      <h2 style="margin-top:0">{t.monSapHet}</h2>
      {goiY.length === 0 ? (
        <p class="kho-phu">{t.khongDuoiMuc}</p>
      ) : (
        <>
          {goiYCo.length > 0 && <p class="kho-phu">{t.soDienSan}</p>}
          <ul class="kho-dong-ds yc-ds">
            {goiYCo.map(g => (
              <li>
                <span>
                  <strong>{g.ten}</strong>
                  <small>
                    {t.quayCon(cauSoLuong(g, g.so_goi_quay, g.so_kg_quay, nn))}
                    {(g.so_goi_dang_mang > 0 || g.so_kg_dang_mang > 0) ? t.dangMangRa(cauSoLuong(g, g.so_goi_dang_mang, g.so_kg_dang_mang, nn)) : ''}
                    {' · '}{t.khoCon(cauSoLuong(g, g.so_goi_kho, g.so_kg_kho, nn))}
                  </small>
                </span>
                <label class="nb-o yc-o">
                  <span class="an">{t.soDvAn(g.ten, g.dem_goi ? g.don_vi_goi || t.goi : 'kg')}</span>
                  <input type="text" inputmode={g.dem_goi ? 'numeric' : 'decimal'} name={`g_${g.mat_hang_id}`}
                    value={giaTriGoiY(g)} autocomplete="off" />
                  <small>{g.dem_goi ? g.don_vi_goi || t.goi : 'kg'}</small>
                </label>
              </li>
            ))}
          </ul>
          {goiYHetKho.length > 0 && (
            <details class="yc-het-kho">
              <summary>{t.nMonHetKho(goiYHetKho.length)}</summary>
              <ul class="kho-dong-ds">
                {goiYHetKho.map(g => (
                  <li><span><strong>{g.ten}</strong><small>{t.quayCon(cauSoLuong(g, g.so_goi_quay, g.so_kg_quay, nn))}</small></span></li>
                ))}
              </ul>
            </details>
          )}
        </>
      )}

      <h2>{t.themMon}</h2>
      <p class="kho-phu">{t.themMonGoiY}</p>
      {dongThem.map(d => (
        <div class="yc-them">
          <label class="nb-o">
            <span>{t.mon(d.i + 1)}</span>
            <ChonMatHang name={`t${d.i}_mat_hang`} matHang={matHang.filter(m => !idGoiY.has(m.id) || m.id === d.mh)} chon={d.mh} />
          </label>
          <label class="nb-o">
            <span>{t.soLuong}{d.mh && mhTheoId.get(d.mh) ? ` (${mhTheoId.get(d.mh)!.dem_goi ? mhTheoId.get(d.mh)!.don_vi_goi || t.goi : 'kg'})` : ''}</span>
            <input type="text" inputmode="decimal" name={`t${d.i}_so`} value={d.so} autocomplete="off" />
          </label>
        </div>
      ))}
      <button type="submit" name="viec" value="them_dong" class="nb-nut phu" formnovalidate>{t.themDong}</button>

      <label class="nb-o" style="margin-top:1rem">
        <span>{t.ghiChuThuKho}</span>
        <input type="text" name="ghi_chu" maxlength="500" value={String(form?.get('ghi_chu') ?? '')} />
      </label>
      <div class="kho-thanh-nut dinh">
        <button type="submit" name="viec" value="gui" class="nb-nut yc-lon">{t.guiYeuCau}</button>
      </div>
    </form>
  )}

  {/* ======================= Đã xử lý gần đây ======================= */}
  {khac.length > 0 && (
    <>
      <h2>{t.ganDay}</h2>
      <ul class="kho-dong-ds nb-the">
        {khac.map(y => (
          <li>
            <span>
              <strong>{y.so_phieu} · {y.ten_vi_tri}</strong>
              <small>{t.soMon(y.so_mon)} · {dinhDangThoiDiem(y.created_at)}{y.so_phieu_xuat ? t.phieu(y.so_phieu_xuat) : ''}</small>
            </span>
            <span class={`nb-nhan ${nhan(y.trang_thai)[1]}`} style="flex:0 0 auto">{nhan(y.trang_thai)[0]}</span>
            <a class="nb-nut phu yc-nut" href={`/noi-bo/kho/quay/yeu-cau/${y.id}`}>{t.xem}</a>
          </li>
        ))}
      </ul>
    </>
  )}
</Kho>

<style>
  .yc-nut { min-height: 48px !important; font-size: .95rem !important; }
  .yc-lon { min-height: 56px; font-size: 1.05rem; width: 100%; }
  .yc-o { display: flex; align-items: center; gap: .4rem; margin: 0; flex: 0 0 auto; }
  .yc-o input { width: 5rem; text-align: right; font-size: 1.15rem !important; }
  /* Mỗi món một hàng gọn: ô số ở bên phải, kể cả điện thoại (22/10/2026). */
  .yc-ds li { flex-wrap: nowrap; }
  .yc-ds li > span { flex: 1 1 auto; }
  .yc-het-kho { margin-top: .75rem; }
  .yc-het-kho > summary { cursor: pointer; font-weight: 600; min-height: 44px; display: list-item; padding: .6rem 0; color: var(--do-dam); }
  .yc-them { display: grid; grid-template-columns: 1fr 7rem; gap: .5rem; align-items: end; }
  .an { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
