import { docTon, type DongTon } from '../../../lib/kho/ton.ts';
import { docMatHang, type MatHang } from '../../../lib/kho/danh-muc.ts';
import { docCongNoNcc, type CongNoNcc } from '../../../lib/kho/cong-no.ts';
import { docThongBao, docChiSoQuanTri, type ChiSoQuanTri } from '../../../lib/kho/thong-bao.ts';
import { gomSuKien, laViec, type SuKien } from '../../../lib/kho/viec.ts';
import { goiYXepQuay, dauThang, thayDoiPt } from '../../../lib/kho/trang-chu.ts';
import { docSoTangCuaLo } from '../../../lib/kho/tang.ts';
import { docDanhSachYeuCau, type YeuCauQuay } from '../../../lib/kho/quay.ts';
