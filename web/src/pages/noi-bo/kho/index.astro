  .kho-yc-lon { width: 100%; min-height: 56px; font-size: 1.1rem; gap: .5rem; margin-bottom: 1rem; }
  .kho-yc-the { margin-bottom: 1rem; }
  .kho-yc-nut { min-height: 48px !important; font-size: .95rem !important; }
</style>
