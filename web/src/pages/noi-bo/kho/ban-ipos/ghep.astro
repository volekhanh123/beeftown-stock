---
/**
 * KHO — GHÉP MÃ MÓN iPOS VỚI MÓN KHO (GĐ7a 0037; GĐ7c 0042: "bán theo", thực đơn iPOS)
 *
 * Mã món iPOS chưa ghép (gom theo mã, đếm số dòng đang chờ), mỗi mã một form:
 *   · chọn món kho — gợi ý trước (trùng mã cân, tên không dấu giống nhau:
 *     goiYMatHang trong lib/kho/ban-ipos.ts), rồi mọi món đang dùng;
 *   · "Hàng cân nhãn" — món thật đọc từ mã cân trên nhãn;
 *   · "Không phải hàng kho" (nước, đồ khô…) — bán món này kho không trừ;
 *   · "Bán theo": theo món kho | kg | gói (+ "mỗi gói = … kg") | suất (món chế
 *     biến: kho không trừ, chỉ đếm suất cho định lượng GĐ7b).
 * Ghép xong kho_ipos_gan_ma_v2 xử lý lại ngay mọi dòng chưa khớp / thiếu hàng
 * / lỗi cùng mã.
 *
 * Thực đơn iPOS (#thuc-don, kho_ipos_menu — không giá): tìm, chia trang như
 * danh sách phiếu (GĐ4b); món chưa ghép có nút "Ghép" → ?ma=<mã> đưa mã đó
 * lên đầu, ghép trước khi bán.
 *
 * ?ma=<mã> (từ nút "Ghép món" ở màn Bán hàng iPOS / thực đơn) đưa mã đó lên đầu.
 *
 * Mã món iPOS toàn số trùng mã cân của món (0103: FABi đặt mã món = mã cân, vd 01011): kho tự nhận,
 * bán theo kg — form của mã đó ghi "kho tự nhận", vẫn chọn sẵn món ấy và "Theo kg" nếu muốn ghép tay.
 * Tên của mã ?ma= không còn dòng chưa khớp lấy từ dòng bán gần nhất (docTenMaIpos).
 *
 * Chặn ghép sai TRƯỚC khi gọi database (kiemGhep trong lib/kho/ban-ipos.ts): mã trùng mã giảm / mã ô
 * thì thực đơn hiện "kho tự nhận" thay nút Ghép (oThucDon), và form từ chối ghép kiểu món kho cho mã đó;
 * ghép "Không phải hàng kho" / suất / hàng cân nhãn thì phải tích "Mã này là món khác trên FABi" (FABi có
 * món khác trùng mã). Ghép món có ô mà không chọn ô thì trang dựng lại form với ô "Vẫn ghép món chung".
 * Hai ô xác nhận chỉ hiện khi ganMaIpos đòi, form giữ đúng lựa chọn đã gửi.
 *
 * Món cần có trên FABi (#mon-fabi, lib/kho/thu-ngan.ts): mỗi món cân (mã cân, 0103) + mỗi ô mã + mỗi mã
 * giảm đang bật một món, đối chiếu thực đơn iPOS và mã đã bán qua iPOS (không biết → không kết luận); tải
 * file nhập món cho FABi mon-fabi.xlsx (chỉ món chưa thấy trên FABi) và bảng đối chiếu mon-fabi.csv. Đọc
 * riêng — lỗi chỉ báo ở mục đó. Giá/kg ở mục này là giá bán (không giá vốn).
 * Quyền danh_muc (quản lý, chủ).
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docMatHang, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import { cauLoiKho, dinhDangKg, dinhDangThoiDiem, dinhDangTien, type KetQua } from '../../../../lib/kho/chung.ts';
import { docTimDs, catTrang, linkDs } from '../../../../lib/kho/tim-ds.ts';
import {
  docMaChuaGhep, docMaDaGhep, docMenuIpos, docMonMenu, docTenMaIpos, ganMaIpos, goiYMatHang, goiYOMa, maCanTuNhan, oThucDon,
  tenDonViBan, CHON_DON_VI_BAN_NB,
  type MaChuaGhep, type MaIposDaGhep, type MonMenuIpos, type NguCanhGhep,
} from '../../../../lib/kho/ban-ipos.ts';
import { docOMa, type DongOMa } from '../../../../lib/kho/o-ma.ts';
import { docThemMonFabi, monCanCoTrenFabi, mucMonFabi, nhanTrenFabi, type DongMonFabi, type ThemMonFabi } from '../../../../lib/kho/thu-ngan.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';
import { dichCau } from '../../../../lib/cau-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho', 302);
const DUONG = '/noi-bo/kho/ban-ipos/ghep';
const sp = Astro.url.searchParams;
const tim = docTimDs(sp);
const nn = k.nn;
const t = dichNB(nn, {
  tieuDe: { vi: 'Ghép món iPOS', en: 'Match iPOS dishes' },
  veBanIpos: { vi: '← Bán hàng iPOS', en: '← iPOS sales' },
  khongDoc: { vi: 'Không đọc được mã món iPOS.', en: 'Could not read the iPOS dish codes.' },
  dan1: { vi: 'Mỗi món trên iPOS cần biết nó là món nào trong kho, và iPOS bán nó', en: 'Each dish on iPOS needs to know which stock item it is, and whether iPOS sells it' },
  dan2: { vi: 'theo kg, theo gói hay theo suất', en: 'by kg, by pack or by portion' },
  dan3: {
    vi: '. Ghép một lần là xong — mọi dòng bán cùng mã, cả dòng đang chờ, tự trừ kho. Món bếp nấu (phở, lẩu…) chọn',
    en: '. Match it once and you are done — every sale line with that code, including the waiting ones, is deducted from stock automatically. For dishes the kitchen cooks (pho, hotpot…) choose',
  },
  dan4: { vi: 'Bán theo suất', en: 'Sold by portion' },
  dan5: { vi: ': kho không trừ, chỉ đếm suất để so định lượng.', en: ': no stock is deducted; portions are only counted to compare with recipes.' },
  dan6: {
    vi: 'Món cân đặt mã món trên FABi bằng mã cân (vd 01011 cho mã cân 1011) thì kho tự nhận, bán theo kg — không cần ghép.',
    en: 'A weighed dish whose FABi dish code is its scale code (e.g. 01011 for scale code 1011) is recognised automatically, sold by kg — no need to match it.',
  },
  khoTuNhanCanForm: {
    vi: (ma: string, ten: string) => `Kho tự nhận mã này: mã cân ${ma} → ${ten}, bán theo kg. Không cần ghép — chỉ ghép khi món FABi mang mã này là món khác.`,
    en: (ma: string, ten: string) => `Stock recognises this code by itself: scale code ${ma} → ${ten}, sold by kg. No need to match it — only match it if the FABi dish with this code is a different dish.`,
  },
  khoTuNhanCan: {
    vi: (ten: string) => `${ten} — kho tự nhận (mã cân)`,
    en: (ten: string) => `${ten} — recognised automatically (scale code)`,
  },
  chuaKhoiTao: { vi: 'Chi nhánh chưa bắt đầu dùng kho. Vào', en: 'This branch has not started using inventory yet. Go to' },
  tongQuan: { vi: 'Tổng quan kho', en: 'Inventory home' },
  chuaGhep: { vi: 'Chưa ghép', en: 'Not matched' },
  khongConMa: { vi: 'Không còn mã nào chưa ghép. Tốt lắm!', en: 'No codes left to match. Well done!' },
  khongTen: { vi: '(iPOS không gửi tên)', en: '(iPOS sent no name)' },
  ma: { vi: 'mã', en: 'code' },
  maCan: { vi: 'mã cân', en: 'scale code' },
  dongCho: {
    vi: (n: number, luc: string) => `${n} dòng đang chờ · bán gần nhất ${luc}`,
    en: (n: number, luc: string) => `${n} waiting ${n === 1 ? 'line' : 'lines'} · last sold ${luc}`,
  },
  dangGhep: {
