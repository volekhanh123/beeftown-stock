  goiCan: { vi: 'Hàng cân nhãn — món đọc từ mã cân', en: 'Scale-labelled goods — item read from the scale code' },
  khongPhaiHangKho: { vi: 'Không phải hàng kho (nước, đồ khô…)', en: 'Not a stock item (drinks, dry goods…)' },
  moiMon: { vi: 'Mọi món', en: 'All items' },
  banTheo: { vi: 'iPOS bán món này theo', en: 'iPOS sells this dish by' },
  moiGoi: { vi: 'Mỗi gói = … kg (chỉ khi bán theo gói)', en: 'Each pack = … kg (only when sold by pack)' },
  moiGoiGiai: {
    vi: 'Món kho tính theo kg mà iPOS bán theo gói thì điền, vd 0,5. Món đếm gói thì để trống — lấy kg theo sổ.',
    en: 'Fill this in when the stock item is tracked in kg but iPOS sells it by pack, e.g. 0.5. Leave it empty for pack-counted items — the kg comes from the books.',
  },
  ghep: { vi: 'Ghép', en: 'Match' },
  daGhep: { vi: 'Đã ghép', en: 'Matched' },
  chuaGhepMa: { vi: 'Chưa ghép mã nào.', en: 'No codes matched yet.' },
  maIpos: { vi: 'Mã iPOS', en: 'iPOS code' },
  tenIpos: { vi: 'Tên trên iPOS', en: 'Name on iPOS' },
  monKho: { vi: 'Món kho', en: 'Stock item' },
  banTheoCot: { vi: 'Bán theo', en: 'Sold by' },
  sua: { vi: 'Sửa', en: 'Edit' },
  boGhep: { vi: 'Bỏ ghép', en: 'Unmatch' },
  thucDon: { vi: 'Thực đơn iPOS', en: 'iPOS menu' },
  thucDonGiai: {
    vi: 'Danh sách món đã đọc được từ iPOS. API iPOS DW đang dùng không có đường đọc thực đơn, nên danh sách này không được làm mới — món hiện ở mục chưa ghép phía trên sau lần bán đầu tiên.',
    en: 'The dish list already read from iPOS. The iPOS DW API in use has no way to read the menu, so this list is not refreshed — a dish shows up under not matched above after its first sale.',
  },
  timGoiY: { vi: 'Tìm mã, tên món, nhóm', en: 'Search code, dish name, group' },
  timNhan: { vi: 'Tìm món trên thực đơn iPOS', en: 'Search dishes on the iPOS menu' },
  tim: { vi: 'Tìm', en: 'Search' },
  boTim: { vi: 'Bỏ tìm', en: 'Clear search' },
  khongKhop: { vi: 'Không có món nào khớp.', en: 'No dishes match.' },
  chuaDocMenu: {
    vi: 'Chưa có thực đơn iPOS — API iPOS DW không đọc được thực đơn. Ghép món theo các mã chưa ghép phía trên.',
    en: 'There is no iPOS menu — the iPOS DW API cannot read the menu. Match dishes from the unmatched codes above.',
  },
  tenMon: { vi: 'Tên món', en: 'Dish name' },
  nhom: { vi: 'Nhóm', en: 'Group' },
  ngungBan: { vi: 'Ngừng bán', en: 'No longer sold' },
  monCheBien: { vi: 'Món chế biến (chỉ đếm suất)', en: 'Cooked dish (portions counted only)' },
  khongPhaiHangKhoNgan: { vi: 'Không phải hàng kho', en: 'Not a stock item' },
  hangCanNhan: { vi: 'Hàng cân nhãn', en: 'Scale-labelled goods' },
  motGoi: { vi: (kg: string) => ` · 1 gói = ${kg} kg`, en: (kg: string) => ` · 1 pack = ${kg} kg` },
  nhomOMa: { vi: 'Ô mã (món theo tảng — trừ đúng lô của tảng)', en: 'Rotating codes (per-primal items — deduct the exact primal lot)' },
  oChu: {
    vi: (ten: string, so: number, ma: string) => `${ten} — ô ${so} (mã ${ma})`,
    en: (ten: string, so: number, ma: string) => `${ten} — slot ${so} (code ${ma})`,
  },
  oGiai: {
    vi: 'Món ô mã trên FABi bán theo cân: để "Bán theo" trống hoặc chọn kg.',
    en: 'Rotating-code dishes on FABi are sold by weight: leave "Sold by" empty or choose kg.',
  },
  khongO: { vi: ' · món theo tảng, không ô — kho không biết tảng', en: ' · per-primal item without a slot — the primal is unknown' },
  vanGhepMonChung: {
    vi: 'Vẫn ghép món chung — bán mã này kho trừ theo hạn gần nhất, không biết tảng',
    en: 'Match as the general dish anyway — selling this code deducts by nearest expiry, primal unknown',
  },
  vanGhepTrungMa: {
    vi: 'Mã này là món khác trên FABi — vẫn ghép (kho thôi tự nhận mã này)',
    en: 'This code is a different dish on FABi — match anyway (stock stops recognising this code by itself)',
  },
  khoTuNhanGiam: {
    vi: (pt: number) => `Mã giảm ${pt}% — kho tự nhận, đừng ghép`,
    en: (pt: number) => `${pt}% discount code — recognised automatically, do not match`,
  },
  khoTuNhanO: {
    vi: (so: number, ten: string) => `Ô ${so}${ten ? ` (${ten})` : ''} — kho tự nhận`,
    en: (so: number, ten: string) => `Slot ${so}${ten ? ` (${ten})` : ''} — recognised automatically`,
  },
  nenBoGhep: { vi: 'Mã này kho tự nhận — nên Bỏ ghép', en: 'Stock recognises this code by itself — unmatch it' },
  monFabi: { vi: 'Món cần có trên FABi', en: 'Dishes needed on FABi' },
  monFabiGiai: {
    vi: 'Mỗi món cân, mỗi ô mã và mỗi mã giảm đang bật cần MỘT món trên FABi: mã món = mã vạch = mã cân (hoặc mã ô, mã giảm) đủ 5 số, đơn vị Kg, giá/kg như cột dưới (mã giảm: giá đã giảm). Không ghép các mã này — kho tự nhận. Đổi giá trong kho thì sửa giá trên FABi cùng lúc.',
    en: 'Every weighed item, every rotating code and every active discount code needs ONE dish on FABi: dish code = barcode = scale code (or slot code, discount code) in 5 digits, unit Kg, price per kg as in the table (discount: discounted price). Do not match these codes — stock recognises them by itself. When you change a price in stock, change it on FABi at the same time.',
  },
  nhapFabiGiai: {
    vi: 'File nhập: FABi → Thực đơn → Món ăn → Tiện ích → Thêm món từ file → tải file lên. File chỉ gồm món chưa bán qua FABi lần nào, chưa ghép, có giá — FABi chỉ thêm món mới. Món đã tạo trên FABi mà chưa bán thì xoá dòng đó trong file trước khi tải lên. Mở file bằng Excel rồi lưu lại có thể làm mất số 0 đầu của mã — tải thẳng lên FABi.',
    en: 'Import file: FABi → Menu → Dishes → Utilities → Add dishes from file → upload it. The file only has dishes never sold through FABi, not matched, with a price — FABi only adds new dishes. A dish already created on FABi but not sold yet: delete its row from the file before uploading. Opening the file in Excel and saving it again may drop the leading zeros of the codes — upload it to FABi as downloaded.',
  },
  taiNhapFabi: {
    vi: (n: number) => `Tải file nhập món cho FABi (.xlsx) · ${n} món`,
    en: (n: number) => `Download the FABi import file (.xlsx) · ${n} ${n === 1 ? 'dish' : 'dishes'}`,
  },
  khongMonMoiFabi: {
    vi: 'Không có món mới cần thêm trên FABi — mọi mã dưới đây đã bán qua FABi, đã ghép, hoặc chưa có giá.',
    en: 'No new dishes need adding on FABi — every code below has been sold through FABi, is matched, or has no price yet.',
  },
  trongFile: { vi: 'có trong file nhập', en: 'in the import file' },
  loaiCan: { vi: (ten: string) => `${ten} · mã cân`, en: (ten: string) => `${ten} · scale code` },
  khongDocFabi: { vi: 'Không đọc được danh sách món cần có trên FABi.', en: 'Could not read the list of dishes needed on FABi.' },
  chuaDocMenuFabi: {
    vi: 'Không có thực đơn iPOS (API iPOS DW không đọc được thực đơn) — phần mềm không biết món nào đã có trên FABi: kiểm tay trên FABi. Xem',
    en: 'There is no iPOS menu (the iPOS DW API cannot read the menu) — the app does not know which dishes are already on FABi: check by hand in FABi. See',
  },
  ketNoiIpos: { vi: 'Kết nối iPOS', en: 'iPOS connection' },
  menuDocLuc: {
    vi: (luc: string, n: number) => `Đối chiếu với thực đơn iPOS đọc lúc ${luc} (${n} món). Thực đơn chỉ có mã món — mã vạch phải thử bằng một tem.`,
    en: (luc: string, n: number) => `Compared with the iPOS menu read at ${luc} (${n} ${n === 1 ? 'dish' : 'dishes'}). The menu only has dish codes — check the barcode with one test label.`,
  },
  khongCanMonFabi: { vi: 'Chưa có món cân, ô mã hay mã giảm nào đang dùng — chưa cần món nào trên FABi.', en: 'No weighed items, rotating codes or active discount codes in use yet — no FABi dishes are needed.' },
  taiFabi: { vi: 'Tải bảng đối chiếu (CSV)', en: 'Download the check list (CSV)' },
  tenMonFabi: { vi: 'Tên món trên FABi (gợi ý)', en: 'Dish name on FABi (suggested)' },
  maMon: { vi: 'Mã món', en: 'Dish code' },
  maVach: { vi: 'Mã vạch', en: 'Barcode' },
  giaKg: { vi: 'Giá/kg', en: 'Price/kg' },
  trenFabi: { vi: 'Trên FABi', en: 'On FABi' },
  loaiO: { vi: (ten: string, so: number) => `${ten} · ô ${so}`, en: (ten: string, so: number) => `${ten} · slot ${so}` },
  loaiGiam: { vi: (ten: string, pt: number) => `${ten} · giảm ${pt}%`, en: (ten: string, pt: number) => `${ten} · ${pt}% off` },
  quaMa: { vi: (ma: string) => `qua mã ${ma} đã ghép`, en: (ma: string) => `through matched code ${ma}` },
});

let bao: KetQua | null = k.bao;
/** Lần ghép vừa bị từ chối: dựng lại form của mã đó với đúng lựa chọn đã gửi (và ô xác nhận nếu cần). */
let guiLai: { ma: string; chon: string; donVi: string; kg: string; canXacNhanKhongO: boolean; canXacNhanTrungMa: boolean } | null = null;
const form = await docFormGui(Astro);
if (form && k.chiNhanh && String(form.get('viec')) === 'ghep') {
  const kq = await ganMaIpos(k.client, k.chiNhanh.id, form);
  if (kq.ok) return chuyenHuong(Astro, DUONG, kq);
  bao = kq;
  const chu = (x: string) => String(form.get(x) ?? '').trim();
  guiLai = { ma: chu('ma_ipos').slice(0, 100), chon: chu('mat_hang_id'), donVi: chu('don_vi_ban'), kg: chu('kg_moi_don_vi'),
             canXacNhanKhongO: kq.canXacNhanKhongO === true, canXacNhanTrungMa: kq.canXacNhanTrungMa === true };
}
const maChon = guiLai?.ma || (sp.get('ma') ?? '').trim().slice(0, 100);

let chuaGhep: MaChuaGhep[] = [];
let daGhep: MaIposDaGhep[] = [];
let matHang: MatHang[] = [];
let menu: MonMenuIpos[] = [];
let menuCoSau = false;
let oMaTheoMon = new Map<string, DongOMa[]>();
let monChon: MonMenuIpos | null = null;
let tenChon: string | null = null;
let them: ThemMonFabi | null = null;
let loiFabi: string | null = null;
/** Phần chính (món, ô, mã đã ghép) đọc đủ — mục FABi chỉ kết luận khi có đủ dữ liệu này. */
let docDuChinh = false;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    let trangMenu: MonMenuIpos[];
    [chuaGhep, daGhep, matHang, trangMenu, monChon, tenChon] = await Promise.all([
      docMaChuaGhep(k.client, k.chiNhanh.id), docMaDaGhep(k.client, k.chiNhanh.id), docMatHang(k.client),
      docMenuIpos(k.client, k.chiNhanh.id, tim),
      maChon ? docMonMenu(k.client, k.chiNhanh.id, maChon) : Promise.resolve(null),
      // Tên chỉ để hiển thị: đọc lỗi thì để trống, không làm hỏng cả trang.
      maChon ? docTenMaIpos(k.client, k.chiNhanh.id, maChon).catch(() => null) : Promise.resolve(null),
    ]);
    ({ ds: menu, coSau: menuCoSau } = catTrang(trangMenu));
    // 0051: ô mã để ghép món ô trên FABi. Lỗi đọc (database chưa có 0049) → không có nhóm này.
    // Mục "Món cần có trên FABi" thì cần đủ ô: đọc lỗi → mục đó báo lỗi, không liệt kê thiếu.
    oMaTheoMon = await docOMa(k.client).catch(() => { loiFabi = t.khongDocFabi; return new Map<string, DongOMa[]>(); });
    docDuChinh = true;
  } catch (e) { loiDoc = cauLoiKho(e, t.khongDoc); }
  // Món cần có trên FABi: thực đơn đủ trang, mã giảm, mẫu mã vạch — đọc riêng, lỗi chỉ báo ở mục đó.
  if (docDuChinh && !loiFabi) {
    try { them = await docThemMonFabi(k.client, k.chiNhanh.id); } catch (e) { loiFabi = cauLoiKho(e, t.khongDocFabi); }
  }
}
// Mã được chọn lên đầu; chưa có trong danh sách (đã ghép rồi / chỉ có trên thực đơn) thì vẫn cho ghép.
const cuChon = daGhep.find(m => m.ma_ipos === maChon);
if (maChon) {
  const i = chuaGhep.findIndex(m => m.ma_ipos === maChon);
  if (i > 0) chuaGhep.unshift(...chuaGhep.splice(i, 1));
  else if (i < 0) {
    chuaGhep.unshift({ ma_ipos: maChon, ten_ipos: cuChon?.ten_ipos ?? monChon?.ten_ipos ?? tenChon, so_dong: 0, ma_can: null, lan_cuoi: '' });
  }
}
const daGhepTheoMa = new Map(daGhep.map(m => [m.ma_ipos, m]));
const dangDung = matHang.filter(m => m.dang_dung);
const tenMon = new Map(matHang.map(m => [m.id, m.ten]));
const cacO = [...oMaTheoMon.values()].flat()
  .map(o => ({ ...o, ten: tenMon.get(o.mat_hang_id) ?? '—' }))
  .sort((a, b) => a.ten.localeCompare(b.ten, 'vi') || a.so_o - b.so_o);
const oTheoId = new Map(cacO.map(o => [o.id, o]));
const chuKieu = (m: MaIposDaGhep) => m.o_ma_id && oTheoId.has(m.o_ma_id)
  ? t.oChu(oTheoId.get(m.o_ma_id)!.ten, oTheoId.get(m.o_ma_id)!.so_o, oTheoId.get(m.o_ma_id)!.ma_can)
  : m.don_vi_ban === 'suat' ? t.monCheBien
  : m.kieu === 'bo_qua' ? t.khongPhaiHangKhoNgan
  : m.kieu === 'goi_can' ? `${t.hangCanNhan}${m.mat_hang_id ? ` (${tenMon.get(m.mat_hang_id) ?? '—'})` : ''}`
  : `${tenMon.get(m.mat_hang_id ?? '') ?? '—'}${m.kieu === 'mon' && m.mat_hang_id && oMaTheoMon.has(m.mat_hang_id) ? t.khongO : ''}`;
// Mã kho tự nhận (mã giảm, mã ô): mã giảm chỉ biết khi đọc được phần FABi — không biết thì thôi nhãn, form vẫn chặn.
// Ô / mã giảm của món đã ngừng dùng: kho không tự nhận (kho_ipos_ghi_dong 0054) — monDangDung để oThucDon hiện nút Ghép.
const idDangDung = new Set(dangDung.map(m => m.id));
const ngGhep: NguCanhGhep = { oMa: cacO, maGiam: them?.maGiam ?? [], monDangDung: idDangDung, monMaCan: matHang };
// Chọn được trong form chỉ ô của món đang dùng — ô của món đã ngừng dùng thì kho_ipos_gan_o_ma (0051) luôn từ chối.
const oDangDung = cacO.filter(o => idDangDung.has(o.mat_hang_id));
const dsFabi: DongMonFabi[] = them
  ? monCanCoTrenFabi({ matHang, oMa: cacO, maGiam: them.maGiam, menu: them.menu, daGhep, soChuSo: them.soChuSo, daBan: them.daBan })
  : [];
const soVaoFile = dsFabi.filter(d => d.vaoFile).length;
// Mục FABi in gì (hàm thuần): lỗi → chỉ câu lỗi; chưa đọc đủ → không số, không kết luận.
const mucFabi = mucMonFabi(them, loiFabi, dsFabi.length);
const chuBanTheo = (m: MaIposDaGhep) => m.kieu === 'bo_qua' && m.don_vi_ban !== 'suat' ? '—'
  : `${tenDonViBan(m.don_vi_ban, nn)}${m.kg_moi_don_vi ? t.motGoi(dinhDangKg(m.kg_moi_don_vi, nn)) : ''}`;
const idMa = (ma: string) => `ma-${ma.replace(/[^A-Za-z0-9_-]/g, '_')}`;
---
<Kho k={k} tieuDe={t.tieuDe} huongDan="ban-ipos">
  <h1>{t.tieuDe}</h1>
  <p><a href="/noi-bo/kho/ban-ipos">{t.veBanIpos}</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  <p class="nb-dan">{t.dan1} <strong>{t.dan2}</strong>{t.dan3} <strong>{t.dan4}</strong>{t.dan5} {t.dan6}</p>

  {!k.daKhoiTao ? (
    <p class="nb-rong">{t.chuaKhoiTao} <a href="/noi-bo/kho">{t.tongQuan}</a>.</p>
  ) : (
    <>
      <h2>{t.chuaGhep} · {chuaGhep.filter(m => m.so_dong > 0).length}</h2>
      {chuaGhep.length === 0 ? (
        <p class="nb-rong">{t.khongConMa}</p>
      ) : chuaGhep.map(m => {
        const goiY = goiYMatHang(m, dangDung);
        const cu = daGhepTheoMa.get(m.ma_ipos);
        // 0103: mã món = mã cân → kho tự nhận (bán theo kg); form vẫn mở cho trường hợp FABi dùng mã này cho món khác.
        const tuCan = maCanTuNhan(m.ma_ipos, ngGhep);
        const gl = guiLai?.ma === m.ma_ipos ? guiLai : null;
        // Vừa bị từ chối → giữ đúng lựa chọn đã gửi; đang ghép (bấm Sửa) → chọn sẵn đúng cái đang ghép;
        // chưa ghép → gợi ý đầu tiên.
        const oGoiY = goiYOMa(m, oDangDung);
        const dangChon = !cu ? (gl ? gl.chon : oGoiY ? `o:${oGoiY.id}` : goiY[0]?.id ?? '')
          : gl ? gl.chon
          : cu.o_ma_id ? `o:${cu.o_ma_id}`
          : cu.don_vi_ban === 'suat' ? ''
          : cu.kieu === 'mon' ? (cu.mat_hang_id ?? '')
          : cu.kieu;
        return (
          <form method="POST" class="nb-the" id={idMa(m.ma_ipos)}>
            <input type="hidden" name="viec" value="ghep" />
            <input type="hidden" name="ma_ipos" value={m.ma_ipos} />
            <p style="margin-top:0"><strong>{m.ten_ipos ?? t.khongTen}</strong> · {t.ma} <code>{m.ma_ipos}</code>
              {m.ma_can && <> · {t.maCan} {m.ma_can}</>}</p>
            <p class="kho-phu" style="margin:-.5rem 0 .75rem">
              {m.so_dong > 0 ? t.dongCho(m.so_dong, dinhDangThoiDiem(m.lan_cuoi))
                : cu ? t.dangGhep(chuKieu(cu)) : t.khongCho}
            </p>
            {tuCan && !cu && <p class="nb-bao">{t.khoTuNhanCanForm(tuCan.maCan, tuCan.tenMon)}</p>}
            <label class="nb-o">
              <span>{t.laMonNao}</span>
              <small>{t.khongCanChon}</small>
              <select name="mat_hang_id">
                <option value="">{t.chon}</option>
                {goiY.length > 0 && (
                  <optgroup label={t.nhomGoiY}>
                    {goiY.map(g => <option value={g.id} selected={g.id === dangChon}>{g.ten} ({g.ma})</option>)}
                  </optgroup>
                )}
                {oDangDung.length > 0 && (
                  <optgroup label={t.nhomOMa}>
                    {oDangDung.map(o => <option value={`o:${o.id}`} selected={dangChon === `o:${o.id}`}>{t.oChu(o.ten, o.so_o, o.ma_can)}</option>)}
                  </optgroup>
                )}
                <optgroup label={t.nhomKhac}>
                  <option value="goi_can" selected={dangChon === 'goi_can'}>{t.goiCan}</option>
                  <option value="bo_qua" selected={dangChon === 'bo_qua'}>{t.khongPhaiHangKho}</option>
                </optgroup>
                <optgroup label={t.moiMon}>
                  {dangDung.map(g => <option value={g.id} selected={g.id === dangChon && !goiY.some(x => x.id === g.id)}>{g.ten} ({g.ma})</option>)}
                </optgroup>
              </select>
            </label>
            <fieldset class="nb-o">
              <legend>{t.banTheo}</legend>
              {oDangDung.length > 0 && <small>{t.oGiai}</small>}
              {CHON_DON_VI_BAN_NB.map(c => (
                <label class="kho-tich"><input type="radio" name="don_vi_ban" value={c.ma}
                    checked={(gl ? gl.donVi : cu ? (cu.don_vi_ban ?? '') : tuCan ? 'kg' : '') === c.ma} />
                  <span><strong>{c.ten[nn]}</strong> — {c.giai[nn]}</span></label>
              ))}
            </fieldset>
            <label class="nb-o">
              <span>{t.moiGoi}</span>
              <small>{t.moiGoiGiai}</small>
              <input type="text" inputmode="decimal" name="kg_moi_don_vi" value={gl ? gl.kg : (cu?.kg_moi_don_vi ?? '')} autocomplete="off" />
            </label>
            {gl?.canXacNhanKhongO && (
              <label class="kho-tich"><input type="checkbox" name="khong_o" value="co" />
                <span>{t.vanGhepMonChung}</span></label>
            )}
            {gl?.canXacNhanTrungMa && (
              <label class="kho-tich"><input type="checkbox" name="trung_ma" value="co" />
                <span>{t.vanGhepTrungMa}</span></label>
            )}
            <button type="submit" class="nb-nut">{t.ghep}</button>
          </form>
        );
      })}

      <h2>{t.daGhep} · {daGhep.length}</h2>
      {daGhep.length === 0 ? (
        <p class="nb-rong">{t.chuaGhepMa}</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>{t.maIpos}</th><th>{t.tenIpos}</th><th>{t.monKho}</th><th>{t.banTheoCot}</th><th></th></tr></thead>
            <tbody>
              {daGhep.map(m => (
                <tr>
                  <td><code>{m.ma_ipos}</code></td>
                  <td>{m.ten_ipos ?? '—'}</td>
                  <td>{chuKieu(m)}</td>
                  <td>{chuBanTheo(m)}</td>
                  <td>
                    <a class="nb-nut phu" href={`${DUONG}?ma=${encodeURIComponent(m.ma_ipos)}#${idMa(m.ma_ipos)}`}>{t.sua}</a>{' '}
                    <form method="POST" style="margin:0;display:inline">
                      <input type="hidden" name="viec" value="ghep" />
                      <input type="hidden" name="ma_ipos" value={m.ma_ipos} />
                      <input type="hidden" name="mat_hang_id" value="bo_ghep" />
                      <button type="submit" class="nb-nut phu">{t.boGhep}</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <h2 id="mon-fabi">{t.monFabi}{mucFabi.kieu === 'co' ? ` · ${mucFabi.soMon}` : ''}</h2>
      <p class="kho-phu">{t.monFabiGiai}</p>
      {mucFabi.kieu === 'loi' ? (
        <p class="nb-bao loi">{dichCau(nn, mucFabi.cau)}</p>
      ) : mucFabi.kieu === 'co' && (
        <>
          {mucFabi.chuaDocMenu ? (
            <p class="nb-bao luu-y">{t.chuaDocMenuFabi} <a href="/noi-bo/kho/cai-dat/ipos">{t.ketNoiIpos}</a>.</p>
          ) : (
            <p class="kho-phu">{t.menuDocLuc(dinhDangThoiDiem(mucFabi.menuLuc), mucFabi.soMonMenu)}</p>
          )}
          {dsFabi.length === 0 ? (
            <p class="nb-rong">{t.khongCanMonFabi}</p>
          ) : (
            <>
              {soVaoFile > 0 ? (
                <>
                  <p><a class="nb-nut" href="/noi-bo/kho/ban-ipos/mon-fabi.xlsx">{t.taiNhapFabi(soVaoFile)}</a>{' '}
                    <a class="nb-nut phu" href="/noi-bo/kho/ban-ipos/mon-fabi.csv">{t.taiFabi}</a></p>
                  <p class="kho-phu">{t.nhapFabiGiai}</p>
                </>
              ) : (
                <p><span class="kho-phu">{t.khongMonMoiFabi}</span>{' '}
                  <a class="nb-nut phu" href="/noi-bo/kho/ban-ipos/mon-fabi.csv">{t.taiFabi}</a></p>
              )}
              <div class="kho-bang-khung">
                <table class="kho-bang">
                  <thead><tr><th>{t.tenMonFabi}</th><th>{t.maMon}</th><th>{t.maVach}</th><th>{t.giaKg}</th><th>{t.trenFabi}</th></tr></thead>
                  <tbody>
                    {dsFabi.map(d => {
                      const [nhan, lop] = nhanTrenFabi(d.trenFabi);
                      return (
                        <tr>
                          <td>{d.tenGoiY}<br /><span class="kho-phu">{d.loai === 'can' ? t.loaiCan(d.tenMonKho) : d.loai === 'o' ? t.loaiO(d.tenMonKho, d.so_o ?? 0) : t.loaiGiam(d.tenMonKho, d.phan_tram ?? 0)}</span></td>
                          <td><code>{d.maMon}</code></td>
                          <td><code>{d.maVach}</code></td>
                          <td class="so">{d.giaKg === null ? '—' : dinhDangTien(d.giaKg, nn)}</td>
                          <td>
                            <span class={`nb-nhan ${lop}`}>{nhan[nn]}</span>{d.maDaGhep && <> {t.quaMa(d.maDaGhep)}</>}
                            {d.vaoFile && <> <span class="nb-nhan thong-tin">{t.trongFile}</span></>}
                            {d.canhBao.map(c => <p class="kho-phu" style="margin:.25rem 0 0">{c[nn]}</p>)}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </>
      )}

      <h2 id="thuc-don">{t.thucDon}</h2>
      <p class="kho-phu">{t.thucDonGiai}</p>
      <form method="GET" action={`${DUONG}#thuc-don`} class="kho-tim" role="search">
        <div class="kho-tim-hang">
          <input type="search" name="q" value={tim.q} placeholder={t.timGoiY} aria-label={t.timNhan} />
          <button type="submit" class="nb-nut phu">{t.tim}</button>
        </div>
        {tim.q && <p class="kho-phu" style="margin:.25rem 0 0"><a href={`${linkDs(DUONG, sp, { q: null, ma: null })}#thuc-don`}>{t.boTim}</a></p>}
      </form>
      {menu.length === 0 ? (
        <p class="nb-rong">{tim.q ? t.khongKhop : t.chuaDocMenu}</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>{t.maIpos}</th><th>{t.tenMon}</th><th>{t.nhom}</th><th>{t.ghep}</th></tr></thead>
            <tbody>
              {menu.map(m => {
                const g = daGhepTheoMa.get(m.ma_ipos);
                // Mã giảm / mã ô: kho tự nhận khi để trống — không mời ghép; đã lỡ ghép như món kho thì nhắc Bỏ ghép.
                const o = oThucDon(m.ma_ipos, g, ngGhep);
                return (
                  <tr>
                    <td><code>{m.ma_ipos}</code></td>
                    <td>{m.ten_ipos ?? '—'}{!m.dang_ban && <> <span class="nb-nhan tat">{t.ngungBan}</span></>}</td>
                    <td>{m.loai ?? '—'}</td>
                    <td>{o.kieu === 'da_ghep' && g
                      ? <>{chuKieu(g)}{g.don_vi_ban && g.don_vi_ban !== 'suat' ? ` · ${tenDonViBan(g.don_vi_ban, nn).toLowerCase()}` : ''}
                          {o.ghepSai && <> <span class="nb-nhan luu-y">{t.nenBoGhep}</span></>}</>
                      : o.kieu === 'tu_nhan_giam' ? <span class="nb-nhan thong-tin">{t.khoTuNhanGiam(o.phanTram)}</span>
                      : o.kieu === 'tu_nhan_o' ? <span class="nb-nhan thong-tin">{t.khoTuNhanO(o.soO, oTheoId.get(o.oMaId)?.ten ?? '')}</span>
                      : o.kieu === 'tu_nhan_can' ? <span class="nb-nhan thong-tin">{t.khoTuNhanCan(o.tenMon)}</span>
                      : <a class="nb-nut phu" href={`${DUONG}?ma=${encodeURIComponent(m.ma_ipos)}#${idMa(m.ma_ipos)}`}>{t.ghep}</a>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      <PhanTrang duong={DUONG} trang={tim.trang} coSau={menuCoSau} />
    </>
  )}
</Kho>
