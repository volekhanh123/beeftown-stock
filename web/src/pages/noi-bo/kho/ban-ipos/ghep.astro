---
/**
 * KHO — GHÉP MÃ MÓN iPOS VỚI MÓN KHO (GĐ7a 0037; GĐ7c 0042: "bán theo", thực đơn iPOS)
 *
 * Mã món iPOS chưa ghép (gom theo mã, đếm số dòng đang chờ), mỗi mã một form:
 *   · chọn món kho — gợi ý trước (trùng mã cân, tên không dấu giống nhau:
 *     goiYMatHang trong lib/kho/ban-ipos.ts), rồi mọi món đang dùng;
 *   · "Hàng cân nhãn" — món thật đọc từ mã cân trên nhãn;
 *   · "Không phải hàng kho" (nước, đồ khô…) — bán món này kho không trừ;
 *   · "Bán theo": theo món kho | kg | gói (+ "mỗi gói = … kg") | suất (món chế
 *     biến: kho không trừ, chỉ đếm suất cho định lượng GĐ7b).
 * Ghép xong kho_ipos_gan_ma_v2 xử lý lại ngay mọi dòng chưa khớp / thiếu hàng
 * / lỗi cùng mã.
 *
 * Thực đơn iPOS (#thuc-don, kho_ipos_menu — không giá): tìm, chia trang như
 * danh sách phiếu (GĐ4b); món chưa ghép có nút "Ghép" → ?ma=<mã> đưa mã đó
 * lên đầu, ghép trước khi bán.
 *
 * ?ma=<mã> (từ nút "Ghép món" ở màn Bán hàng iPOS / thực đơn) đưa mã đó lên đầu.
 * Quyền danh_muc (quản lý, chủ). Không cột tiền nào.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import PhanTrang from '../../../../components/kho/PhanTrang.astro';
import { moTrangKho, docFormGui, chuyenHuong } from '../../../../lib/kho/trang.ts';
import { docMatHang, type MatHang } from '../../../../lib/kho/danh-muc.ts';
import { cauLoiKho, dinhDangKg, dinhDangThoiDiem, type KetQua } from '../../../../lib/kho/chung.ts';
import { docTimDs, catTrang, linkDs } from '../../../../lib/kho/tim-ds.ts';
import {
  docMaChuaGhep, docMaDaGhep, docMenuIpos, docMonMenu, ganMaIpos, goiYMatHang, tenDonViBan, CHON_DON_VI_BAN,
  type MaChuaGhep, type MaIposDaGhep, type MonMenuIpos,
} from '../../../../lib/kho/ban-ipos.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('danh_muc')) return Astro.redirect('/noi-bo/kho', 302);
const DUONG = '/noi-bo/kho/ban-ipos/ghep';
const sp = Astro.url.searchParams;
const maChon = (sp.get('ma') ?? '').trim().slice(0, 100);
const tim = docTimDs(sp);

let bao: KetQua | null = k.bao;
const form = await docFormGui(Astro);
if (form && k.chiNhanh && String(form.get('viec')) === 'ghep') {
  const kq = await ganMaIpos(k.client, k.chiNhanh.id, form);
  if (kq.ok) return chuyenHuong(Astro, DUONG, kq);
  bao = kq;
}

let chuaGhep: MaChuaGhep[] = [];
let daGhep: MaIposDaGhep[] = [];
let matHang: MatHang[] = [];
let menu: MonMenuIpos[] = [];
let menuCoSau = false;
let monChon: MonMenuIpos | null = null;
let loiDoc = k.loiDoc;
if (k.chiNhanh && k.daKhoiTao) {
  try {
    let trangMenu: MonMenuIpos[];
    [chuaGhep, daGhep, matHang, trangMenu, monChon] = await Promise.all([
      docMaChuaGhep(k.client, k.chiNhanh.id), docMaDaGhep(k.client, k.chiNhanh.id), docMatHang(k.client),
      docMenuIpos(k.client, k.chiNhanh.id, tim),
      maChon ? docMonMenu(k.client, k.chiNhanh.id, maChon) : Promise.resolve(null),
    ]);
    ({ ds: menu, coSau: menuCoSau } = catTrang(trangMenu));
  } catch (e) { loiDoc = cauLoiKho(e, 'Không đọc được mã món iPOS.'); }
}
// Mã được chọn lên đầu; chưa có trong danh sách (đã ghép rồi / chỉ có trên thực đơn) thì vẫn cho ghép.
const cuChon = daGhep.find(m => m.ma_ipos === maChon);
if (maChon) {
  const i = chuaGhep.findIndex(m => m.ma_ipos === maChon);
  if (i > 0) chuaGhep.unshift(...chuaGhep.splice(i, 1));
  else if (i < 0) {
    chuaGhep.unshift({ ma_ipos: maChon, ten_ipos: cuChon?.ten_ipos ?? monChon?.ten_ipos ?? null, so_dong: 0, ma_can: null, lan_cuoi: '' });
  }
}
const daGhepTheoMa = new Map(daGhep.map(m => [m.ma_ipos, m]));
const dangDung = matHang.filter(m => m.dang_dung);
const tenMon = new Map(matHang.map(m => [m.id, m.ten]));
const chuKieu = (m: MaIposDaGhep) => m.don_vi_ban === 'suat' ? 'Món chế biến (chỉ đếm suất)'
  : m.kieu === 'bo_qua' ? 'Không phải hàng kho'
  : m.kieu === 'goi_can' ? `Hàng cân nhãn${m.mat_hang_id ? ` (${tenMon.get(m.mat_hang_id) ?? '—'})` : ''}`
  : tenMon.get(m.mat_hang_id ?? '') ?? '—';
const chuBanTheo = (m: MaIposDaGhep) => m.kieu === 'bo_qua' && m.don_vi_ban !== 'suat' ? '—'
  : `${tenDonViBan(m.don_vi_ban)}${m.kg_moi_don_vi ? ` · 1 gói = ${dinhDangKg(m.kg_moi_don_vi)} kg` : ''}`;
const idMa = (ma: string) => `ma-${ma.replace(/[^A-Za-z0-9_-]/g, '_')}`;
---
<Kho k={k} tieuDe="Ghép món iPOS" huongDan="ban-ipos">
  <h1>Ghép món iPOS</h1>
  <p><a href="/noi-bo/kho/ban-ipos">← Bán hàng iPOS</a></p>
  <BaoKho bao={bao} loiDoc={loiDoc} />
  <p class="nb-dan">Mỗi món trên iPOS cần biết nó là món nào trong kho, và iPOS bán nó <strong>theo kg, theo gói hay theo suất</strong>.
    Ghép một lần là xong — mọi dòng bán cùng mã, cả dòng đang chờ, tự trừ kho. Món bếp nấu (phở, lẩu…) chọn
    <strong>Bán theo suất</strong>: kho không trừ, chỉ đếm suất để so định lượng.</p>

  {!k.daKhoiTao ? (
    <p class="nb-rong">Chi nhánh chưa bắt đầu dùng kho. Vào <a href="/noi-bo/kho">Tổng quan kho</a>.</p>
  ) : (
    <>
      <h2>Chưa ghép · {chuaGhep.filter(m => m.so_dong > 0).length}</h2>
      {chuaGhep.length === 0 ? (
        <p class="nb-rong">Không còn mã nào chưa ghép. Tốt lắm!</p>
      ) : chuaGhep.map(m => {
        const goiY = goiYMatHang(m, dangDung);
        const cu = daGhepTheoMa.get(m.ma_ipos);
        // Đang ghép (bấm Sửa) → chọn sẵn đúng cái đang ghép; chưa ghép → gợi ý đầu tiên.
        const dangChon = !cu ? (goiY[0]?.id ?? '')
          : cu.don_vi_ban === 'suat' ? ''
          : cu.kieu === 'mon' ? (cu.mat_hang_id ?? '')
          : cu.kieu;
        return (
          <form method="POST" class="nb-the" id={idMa(m.ma_ipos)}>
            <input type="hidden" name="viec" value="ghep" />
            <input type="hidden" name="ma_ipos" value={m.ma_ipos} />
            <p style="margin-top:0"><strong>{m.ten_ipos ?? '(iPOS không gửi tên)'}</strong> · mã <code>{m.ma_ipos}</code>
              {m.ma_can && <> · mã cân {m.ma_can}</>}</p>
            <p class="kho-phu" style="margin:-.5rem 0 .75rem">
              {m.so_dong > 0 ? `${m.so_dong} dòng đang chờ · bán gần nhất ${dinhDangThoiDiem(m.lan_cuoi)}`
                : cu ? `Đang ghép: ${chuKieu(cu)} — ghép lại để đổi.` : 'Không có dòng nào đang chờ.'}
            </p>
            <label class="nb-o">
              <span>Là món nào trong kho?</span>
              <small>Món chế biến (Bán theo suất) thì không cần chọn.</small>
              <select name="mat_hang_id">
                <option value="">— Chọn —</option>
                {goiY.length > 0 && (
                  <optgroup label="Gợi ý">
                    {goiY.map(g => <option value={g.id} selected={g.id === dangChon}>{g.ten} ({g.ma})</option>)}
                  </optgroup>
                )}
                <optgroup label="Khác">
                  <option value="goi_can" selected={dangChon === 'goi_can'}>Hàng cân nhãn — món đọc từ mã cân</option>
                  <option value="bo_qua" selected={dangChon === 'bo_qua'}>Không phải hàng kho (nước, đồ khô…)</option>
                </optgroup>
                <optgroup label="Mọi món">
                  {dangDung.map(g => <option value={g.id} selected={g.id === dangChon && !goiY.some(x => x.id === g.id)}>{g.ten} ({g.ma})</option>)}
                </optgroup>
              </select>
            </label>
            <fieldset class="nb-o">
              <legend>iPOS bán món này theo</legend>
              {CHON_DON_VI_BAN.map(c => (
                <label class="kho-tich"><input type="radio" name="don_vi_ban" value={c.ma}
                    checked={(cu?.don_vi_ban ?? '') === c.ma} />
                  <span><strong>{c.ten}</strong> — {c.giai}</span></label>
              ))}
            </fieldset>
            <label class="nb-o">
              <span>Mỗi gói = … kg (chỉ khi bán theo gói)</span>
              <small>Món kho tính theo kg mà iPOS bán theo gói thì điền, vd 0,5. Món đếm gói thì để trống — lấy kg theo sổ.</small>
              <input type="text" inputmode="decimal" name="kg_moi_don_vi" value={cu?.kg_moi_don_vi ?? ''} autocomplete="off" />
            </label>
            <button type="submit" class="nb-nut">Ghép</button>
          </form>
        );
      })}

      <h2>Đã ghép · {daGhep.length}</h2>
      {daGhep.length === 0 ? (
        <p class="nb-rong">Chưa ghép mã nào.</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>Mã iPOS</th><th>Tên trên iPOS</th><th>Món kho</th><th>Bán theo</th><th></th></tr></thead>
            <tbody>
              {daGhep.map(m => (
                <tr>
                  <td><code>{m.ma_ipos}</code></td>
                  <td>{m.ten_ipos ?? '—'}</td>
                  <td>{chuKieu(m)}</td>
                  <td>{chuBanTheo(m)}</td>
                  <td>
                    <a class="nb-nut phu" href={`${DUONG}?ma=${encodeURIComponent(m.ma_ipos)}#${idMa(m.ma_ipos)}`}>Sửa</a>{' '}
                    <form method="POST" style="margin:0;display:inline">
                      <input type="hidden" name="viec" value="ghep" />
                      <input type="hidden" name="ma_ipos" value={m.ma_ipos} />
                      <input type="hidden" name="mat_hang_id" value="bo_ghep" />
                      <button type="submit" class="nb-nut phu">Bỏ ghép</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <h2 id="thuc-don">Thực đơn iPOS</h2>
      <p class="kho-phu">Danh sách món đọc từ iPOS (mỗi giờ, hoặc khi iPOS báo thực đơn đổi). Ghép trước những món thịt bán ở quầy —
        khỏi đợi có dòng bán mới ghép.</p>
      <form method="GET" action={`${DUONG}#thuc-don`} class="kho-tim" role="search">
        <div class="kho-tim-hang">
          <input type="search" name="q" value={tim.q} placeholder="Tìm mã, tên món, nhóm" aria-label="Tìm món trên thực đơn iPOS" />
          <button type="submit" class="nb-nut phu">Tìm</button>
        </div>
        {tim.q && <p class="kho-phu" style="margin:.25rem 0 0"><a href={`${linkDs(DUONG, sp, { q: null, ma: null })}#thuc-don`}>Bỏ tìm</a></p>}
      </form>
      {menu.length === 0 ? (
        <p class="nb-rong">{tim.q ? 'Không có món nào khớp.' : 'Chưa đọc được thực đơn iPOS — xem màn Kết nối iPOS.'}</p>
      ) : (
        <div class="kho-bang-khung">
          <table class="kho-bang">
            <thead><tr><th>Mã iPOS</th><th>Tên món</th><th>Nhóm</th><th>Ghép</th></tr></thead>
            <tbody>
              {menu.map(m => {
                const g = daGhepTheoMa.get(m.ma_ipos);
                return (
                  <tr>
                    <td><code>{m.ma_ipos}</code></td>
                    <td>{m.ten_ipos ?? '—'}{!m.dang_ban && <> <span class="nb-nhan tat">Ngừng bán</span></>}</td>
                    <td>{m.loai ?? '—'}</td>
                    <td>{g
                      ? <>{chuKieu(g)}{g.don_vi_ban && g.don_vi_ban !== 'suat' ? ` · ${tenDonViBan(g.don_vi_ban).toLowerCase()}` : ''}</>
                      : <a class="nb-nut phu" href={`${DUONG}?ma=${encodeURIComponent(m.ma_ipos)}#${idMa(m.ma_ipos)}`}>Ghép</a>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      <PhanTrang duong={DUONG} trang={tim.trang} coSau={menuCoSau} />
    </>
  )}
</Kho>
