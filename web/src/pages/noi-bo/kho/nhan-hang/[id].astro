---
/**
 * KHO — NHẬN HÀNG, BƯỚC 2 VÀ 3 (GĐ5a)
 *
 * Bốn màn trên cùng một đường dẫn, do trạng thái phiếu và ?buoc quyết định:
 *   · THÊM HÀNG (bước 2)  : phiếu nháp / bị trả về — thẻ lớn các dòng đã cân
 *                           (Sửa / Bỏ) và form thêm MỘT dòng: nút món hay giao,
 *                           kg, số tảng; hạn dùng, nhiệt độ… trong "Thêm chi tiết"
 *   · XEM LẠI (?buoc=gui) : tóm tắt gọn + một nút "Gửi cho kế toán / quản lý"
 *   · XONG (?buoc=xong)   : vừa gửi — nút Nhận hàng tiếp / Về trang chủ
 *   · XEM                 : đã gửi / đã duyệt / đã hủy — chỉ xem; người lập
 *                           được "Rút về để sửa" khi phiếu còn chờ duyệt
 *
 * Phiếu theo đơn đặt (0039, khóa don_dat của kho_doc_phieu_nhap_kg): mỗi dòng có
 * nhãn "Đặt N kg" cạnh kg nhận; món trong đơn chưa cân được nhắc ở form thêm món.
 *
 * KHÔNG có tiền ở đây: đọc bằng kho_doc_phieu_nhap_kg, ghi bằng
 * kho_luu_phieu_nhap_kg (migration 0031). Mỗi lệnh lưu CẢ phiếu kèm phien_ban,
 * rồi chuyển hướng 303 — F5 không gửi lại. Gõ sai thì hiện lại đúng chữ đã gõ.
 * Không JavaScript. Chữ tiếng Anh của màn này cũng không nói tới giá, tiền.
 */
import Kho from '../../../../layouts/Kho.astro';
import BaoKho from '../../../../components/kho/BaoKho.astro';
import TruongThem from '../../../../components/kho/TruongThem.astro';
import ChonMatHang from '../../../../components/kho/ChonMatHang.astro';
import NhanHangChon from '../../../../components/kho/NhanHangChon.astro';
import { moTrangKho, docFormGui, chuyenHuong, tenNhanSu } from '../../../../lib/kho/trang.ts';
import { docDinhNghia, docMatHang, docViTri, type MatHang, type ViTri } from '../../../../lib/kho/danh-muc.ts';
import {
  docPhieuNhan, docNccNhap, docMonGanDay, gopMonGanDay, docFormDongNhan, docFormDauNhan, dongNhanTrong,
  dongNhanVaoForm, dongLuuTuPhieu, ghepDongNhan, luuPhieuNhan, themDongNhan, themAnhNhan, kiemTruocKhiGui,
  guiPhieuNhan, rutPhieuNhan, huyPhieuNhan,
  type DauNhan, type DongNhanForm, type MonKiem, type NccNhap, type PhieuNhan,
} from '../../../../lib/kho/nhan-hang.ts';
import {
  cauLoiKho, dinhDangKg, dinhDangNgay, dinhDangThoiDiem, homNayVn, kqHai, trangThaiKho, type KetQua,
} from '../../../../lib/kho/chung.ts';
import { hienThiGiaTri, type DinhNghiaTruong, type GiaTriTruong } from '../../../../lib/kho/truong-them.ts';
import { soTangChu } from '../../../../lib/kho/tang.ts';
import { dichNB } from '../../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
if (!k.duoc('nhap')) return Astro.redirect('/noi-bo/kho', 302);
if (!k.chiNhanh || !k.daKhoiTao) return Astro.redirect('/noi-bo/kho', 302);
const cn = k.chiNhanh;
const DS = '/noi-bo/kho/nhan-hang';
const nn = k.nn;
const s = (n: number, mot: string, nhieu: string) => (n === 1 ? mot : nhieu);
const t = dichNB(nn, {
  khongDoc: { vi: 'Không đọc được phiếu nhận hàng.', en: 'Could not read the receiving note.' },
  biTraVe: { vi: 'Bị trả về', en: 'Sent back' },
  tdPhieu: { vi: (so: string) => `Nhận hàng ${so}`, en: (so: string) => `Receiving note ${so}` },
  tdChung: { vi: 'Nhận hàng', en: 'Receive goods' },
  buoc2: { vi: 'Bước 2/3 · Cân từng món', en: 'Step 2/3 · Weigh each item' },
  buoc3: { vi: 'Bước 3/3 · Xem lại rồi gửi', en: 'Step 3/3 · Review and send' },
  daGuiTd: { vi: 'Đã gửi', en: 'Sent' },
  phieuBiTraVe: { vi: 'Phiếu bị trả về:', en: 'Note sent back:' },
  suaTheoLyDo: { vi: 'Sửa theo lý do trên rồi gửi lại.', en: 'Fix it as described above, then send it again.' },
  daGuiSo: { vi: '✓ Đã gửi', en: '✓ Sent' },
  seDuyet: {
    vi: 'Kế toán / quản lý sẽ điền giá và duyệt. Duyệt xong hàng mới vào tồn kho.',
    en: 'The accountant or manager will check and approve it. Goods go into stock once it is approved.',
  },
  soMon: { vi: (n: number) => `${n} món`, en: (n: number) => `${n} ${s(n, 'item', 'items')}` },
  tangGoi: { vi: 'tảng/gói', en: 'pieces/packs' },
  nhanTiep: { vi: 'Nhận hàng tiếp', en: 'Receive another delivery' },
  veTrangChu: { vi: 'Về trang chủ', en: 'Back to home' },
  tonDau: { vi: ' · tồn đầu kỳ', en: ' · opening stock' },
  lapBoi: { vi: 'lập bởi', en: 'made by' },
  luc: { vi: 'lúc', en: 'at' },
  gui: { vi: 'gửi', en: 'sent' },
  duyetBoi: { vi: 'duyệt bởi', en: 'approved by' },
  nguoiGiao: { vi: 'Người giao', en: 'Delivered by' },
  chuaChon: { vi: 'chưa chọn', en: 'not chosen' },
  theoDon: { vi: 'Theo đơn đặt', en: 'Purchase order' },
  henGiao: { vi: 'hẹn giao', en: 'due' },
  nhanVao: { vi: 'Nhận vào', en: 'Received into' },
  ngayNhan: { vi: 'Ngày nhận', en: 'Received on' },
  soHoaDon: { vi: 'Số hóa đơn', en: 'Invoice no.' },
  anhHoaDon: { vi: 'Ảnh hóa đơn', en: 'Invoice photo' },
  daChup: { vi: (n: number) => `✓ Đã chụp ${n} ảnh`, en: (n: number) => `✓ ${n} ${s(n, 'photo', 'photos')} taken` },
  chuaChup: { vi: 'Chưa chụp — phải có ảnh mới gửi được', en: 'Not taken yet — a photo is needed before sending' },
  themAnhNhieu: { vi: 'Thêm ảnh (hóa đơn nhiều trang, phiếu cân…)', en: 'Add photos (multi-page invoice, weighing slip…)' },
  chupHoacChon: { vi: 'Chụp hoặc chọn ảnh hóa đơn', en: 'Take or choose an invoice photo' },
  themAnh: { vi: 'Thêm ảnh', en: 'Add photos' },
  suaDau: { vi: 'Sửa người giao, nơi nhận, ngày, số hóa đơn', en: 'Edit supplier, location, date, invoice no.' },
  noiNhan: { vi: 'Nơi nhận hàng', en: 'Receiving location' },
  ngayNhanO: { vi: 'Ngày nhận', en: 'Date received' },
  soHoaDonO: { vi: 'Số hóa đơn (nếu có)', en: 'Invoice no. (if any)' },
  luuDau: { vi: 'Lưu thông tin phiếu', en: 'Save note details' },
  hangDaCan: { vi: 'Hàng đã cân', en: 'Weighed goods' },
  chuaCoMon: { vi: 'Chưa có món nào. Thêm món đầu tiên ở dưới.', en: 'No items yet. Add the first one below.' },
  dat: {
    vi: (kg: number, goi: number | null, donVi: string) => `Đặt ${dinhDangKg(kg, nn)} kg${goi ? ` · ${goi} ${donVi}` : ''}`,
    en: (kg: number, goi: number | null, donVi: string) => `Ordered ${dinhDangKg(kg, nn)} kg${goi ? ` · ${goi} ${donVi}` : ''}`,
  },
  ngoaiDon: { vi: 'Ngoài đơn', en: 'Not on the order' },
  hsd: { vi: (ngay: string) => `HSD ${ngay}`, en: (ngay: string) => `Use by ${ngay}` },
  loNcc: { vi: (so: string) => `lô NCC ${so}`, en: (so: string) => `supplier lot ${so}` },
  sua: { vi: 'Sửa', en: 'Edit' },
  bo: { vi: 'Bỏ', en: 'Remove' },
  suaDong: { vi: (n: number) => `Sửa dòng ${n}`, en: (n: number) => `Edit line ${n}` },
  themMonTiep: { vi: 'Thêm món tiếp', en: 'Add the next item' },
  themMon: { vi: 'Thêm món', en: 'Add an item' },
  conChuaCan: {
    vi: (so: string, ds: string) => `Trong đơn ${so} còn chưa cân: ${ds}.`,
    en: (so: string, ds: string) => `Still to weigh from order ${so}: ${ds}.`,
  },
  monCon: { vi: (ten: string, kg: string) => `${ten} (còn ${kg} kg)`, en: (ten: string, kg: string) => `${ten} (${kg} kg left)` },
  monGi: { vi: 'Món gì?', en: 'Which item?' },
  monHayGiao: { vi: 'Món hay giao', en: 'Items usually delivered' },
  monKhac: { vi: '— món khác —', en: '— other item —' },
  chonMon: { vi: '— chọn món —', en: '— choose an item —' },
  soKg: { vi: 'Số kg *', en: 'Weight (kg) *' },
  viDuKg: { vi: 'ví dụ 12,5', en: 'e.g. 12.5' },
  soDonVi: {
    vi: (dv: string | undefined) => `Số ${dv ?? 'tảng / gói'}`,
    en: (dv: string | undefined) => `Number of ${dv ?? 'pieces / packs'}`,
  },
  viDuGoi: { vi: 'ví dụ 2', en: 'e.g. 2' },
  ngayMo: { vi: 'Ngày mổ (món theo dõi theo tảng)', en: 'Slaughter date (items tracked per primal)' },
  ngayMoGoiY: {
    vi: 'Xem trên nhãn thùng. Món theo tảng: mỗi lần thêm là MỘT tảng — cân riêng từng tảng, bỏ trống ô số tảng.',
    en: 'See the box label. Items tracked per primal: each line is ONE primal — weigh each primal on its own, leave the count empty.',
  },
  motTang: { vi: '1 tảng', en: '1 primal' },
  moNgay: { vi: (ngay: string) => `mổ ${ngay}`, en: (ngay: string) => `slaughtered ${ngay}` },
  themChiTiet: { vi: 'Thêm chi tiết: hạn dùng, ngày sản xuất, số lô', en: 'More details: use-by date, production date, lot no.' },
  thongTinKhac: { vi: ', thông tin khác', en: ', other info' },
  hanDung: { vi: 'Hạn dùng', en: 'Use-by date' },
  boTrongHsd: { vi: 'Bỏ trống = tự tính theo hạn mặc định của món.', en: 'Leave blank to use the item\'s default shelf life.' },
  ngaySx: { vi: 'Ngày sản xuất', en: 'Production date' },
  soLo: { vi: 'Số lô trên thùng / nhãn', en: 'Lot no. on the box / label' },
  luuDong: { vi: 'Lưu dòng này', en: 'Save this line' },
  themDong: { vi: '+ Thêm dòng', en: '+ Add line' },
  thoiKhongSua: { vi: 'Thôi, không sửa', en: 'Cancel edit' },
  xongXemLai: { vi: 'Xong, xem lại →', en: 'Done, review →' },
  boPhieuNay: { vi: 'Bỏ phiếu này (lập nhầm)', en: 'Discard this note (made by mistake)' },
  lyDoTuyY: { vi: 'Lý do (không bắt buộc)', en: 'Reason (optional)' },
  boPhieu: { vi: 'Bỏ phiếu', en: 'Discard note' },
  chuaGuiDuoc: { vi: 'Chưa gửi được:', en: 'Cannot send yet:' },
  quayLaiSua: { vi: '← Quay lại sửa', en: '← Go back and fix' },
  guiKeToan: { vi: 'Gửi cho kế toán / quản lý', en: 'Send to the accountant / manager' },
  suaTiep: { vi: '← Sửa tiếp', en: '← Keep editing' },
  dangCho: { vi: 'Đang chờ kế toán / quản lý điền giá và duyệt.', en: 'Waiting for the accountant or manager to check and approve.' },
  daDuyet: { vi: 'Đã duyệt — hàng đã vào tồn.', en: 'Approved — the goods are in stock.' },
  xemTon: { vi: 'Xem tồn kho →', en: 'See stock on hand →' },
  rutVe: { vi: 'Rút về để sửa', en: 'Take back to edit' },
  veDs: { vi: '← Danh sách nhận hàng', en: '← Receiving list' },
});

// ---------------------------------------------------------------------------
// Đọc phiếu và danh mục
// ---------------------------------------------------------------------------
let phieu: PhieuNhan | null = null;
let matHang: MatHang[] = [];
let viTri: ViTri[] = [];
let dnPhieu: DinhNghiaTruong[] = [];
let dnLo: DinhNghiaTruong[] = [];
let loiDoc = k.loiDoc;
try {
  [phieu, matHang, viTri, dnPhieu, dnLo] = await Promise.all([
    docPhieuNhan(k.client, Astro.params.id ?? ''), docMatHang(k.client), docViTri(k.client, cn.id),
    docDinhNghia(k.client, 'phieu_nhap'), docDinhNghia(k.client, 'lo_hang'),
  ]);
} catch (e) {
  loiDoc = cauLoiKho(e, t.khongDoc);
}
if (!phieu && !loiDoc) {
  return chuyenHuong(Astro, DS, kqHai(false, { vi: 'Không tìm thấy phiếu nhận hàng này.', en: 'This receiving note was not found.' }));
}

const soanDuoc = !!phieu && (phieu.trang_thai === 'nhap' || phieu.trang_thai === 'tu_choi');
const laNguoiTao = !!phieu?.nguoi_tao && phieu.nguoi_tao === k.nhanSu.id;
const mon = new Map<string, MonKiem>(matHang.map(m => [m.id, { ten: m.ten, dem_goi: m.dem_goi, don_vi_goi: m.don_vi_goi, theo_tang: !!m.theo_tang }]));
// 0046: có món theo dõi theo tảng thì form thêm dòng có ô ngày mổ.
const coTheoTang = matHang.some(m => m.theo_tang && m.dang_dung);

// ---------------------------------------------------------------------------
// Xử lý lệnh gửi lên
// ---------------------------------------------------------------------------
let bao: KetQua | null = k.bao;
let dongForm: DongNhanForm | null = null;
let suaId: string | null = Astro.url.searchParams.get('sua');
let maGuiAnh: string | null = null;
let anhDaTai: string[] = [];
// Sửa đầu phiếu chưa lưu được: hiện lại đúng chữ đã gõ, mở sẵn mục sửa.
let dauForm: DauNhan | null = null;

const form = await docFormGui(Astro);
if (Astro.request.method === 'POST' && !form) {
  bao = kqHai(false, {
    vi: 'Không đọc được dữ liệu gửi lên — mạng có thể đã đứt giữa chừng. Thử gửi lại.',
    en: 'Could not read what was sent — the connection may have dropped. Please send again.',
  });
}
if (form && phieu) {
  const p = phieu;
  const viec = String(form.get('viec') ?? '');
  const phienBan = Number(form.get('phien_ban'));
  const maGui = String(form.get('ma_gui') ?? '');
  const ve = (kq: KetQua, them = '') => chuyenHuong(Astro, `${DS}/${p.id}${them}`, kq);
  const canSoan = ['them_dong', 'bo_dong', 'them_anh', 'sua_dau', 'gui', 'huy'].includes(viec);

  if (canSoan && !soanDuoc) {
    bao = kqHai(false, {
      vi: 'Phiếu đã gửi hoặc đã duyệt — không sửa được nữa. Muốn sửa thì bấm "Rút về để sửa".',
      en: 'This note has been sent or approved — it can no longer be edited. To edit it, press "Take back to edit".',
    });
  } else if (viec === 'them_dong') {
    // Có dong_id = đang sửa dòng đó; không có = thêm dòng mới ở cuối.
    const dongId = String(form.get('dong_id') ?? '');
    const cu = p.dong.find(d => d.id === dongId);
    const r = docFormDongNhan(form, dnLo, mon, cu?.truong_them ?? {});
    if (!r.luu) {
      bao = { ok: false, cau: r.loi.join(' · '), cauEn: r.loiEn.join(' · ') };
      dongForm = r.dong;
      suaId = cu ? cu.id : null;
    } else if (dongId) {
      const ds = ghepDongNhan(p.dong, { thay: dongId, dong: r.luu });
      const kq = ds ? await luuPhieuNhan(k.client, cn.id, p, phienBan, maGui, ds)
        : kqHai(false, {
          vi: 'Dòng này không còn trên phiếu (có người vừa sửa) — xem lại danh sách.',
          en: 'This line is no longer on the note (someone just edited it) — check the list again.',
        });
      if (kq.ok) return ve(kqHai(true, { vi: 'Đã sửa dòng.', en: 'Line updated.' }));
      bao = kq; dongForm = r.dong; suaId = dongId;
    } else {
      const kq = await themDongNhan(k.client, cn.id, p, phienBan, maGui, r.luu);
      // Món theo tảng: điền sẵn món và ngày mổ cho tảng tiếp theo (tảng cùng thùng hay cùng ngày mổ).
      if (kq.ok && mon.get(r.luu.mat_hang_id)?.theo_tang) {
        return ve(kqHai(true, { vi: 'Đã thêm tảng. Cân tảng tiếp theo, hoặc bấm "Xong, xem lại".',
                                en: 'Primal added. Weigh the next primal, or press "Done, review".' }),
                  `?tiep=${r.luu.mat_hang_id}&mo=${r.luu.ngay_mo ?? ''}#them`);
      }
      if (kq.ok) return ve(kq, '#them');
      bao = kq; dongForm = r.dong;
    }
  } else if (viec === 'bo_dong') {
    const ds = ghepDongNhan(p.dong, { bo: String(form.get('dong_id') ?? '') });
    const kq = ds ? await luuPhieuNhan(k.client, cn.id, p, phienBan, maGui, ds)
      : kqHai(false, { vi: 'Dòng này không còn trên phiếu.', en: 'This line is no longer on the note.' });
    return ve(kq.ok ? kqHai(true, { vi: 'Đã bỏ dòng.', en: 'Line removed.' }) : kq);
  } else if (viec === 'them_anh') {
    const kq = await themAnhNhan(k.client, cn.id, p, phienBan, form);
    if (kq.ok) return ve(kq);
    bao = kq; maGuiAnh = kq.maGui ?? null; anhDaTai = kq.anhDaTai ?? [];
  } else if (viec === 'sua_dau') {
    const r = docFormDauNhan(form, p.loai, dnPhieu, p.truong_them);
    if (r.loi.length) {
      bao = { ok: false, cau: r.loi.join(' · '), cauEn: r.loiEn.join(' · ') };
      dauForm = r.dau;
    } else {
      const kq = await luuPhieuNhan(k.client, cn.id, p, phienBan, maGui, p.dong.map(dongLuuTuPhieu), { dau: r.dau });
      if (kq.ok) return ve(kqHai(true, { vi: 'Đã sửa thông tin phiếu.', en: 'Note details updated.' }));
      bao = kq; dauForm = r.dau;
    }
  } else if (viec === 'gui') {
    const kq = await guiPhieuNhan(k.client, p.id, phienBan);
    return kq.ok ? ve(kq, '?buoc=xong') : ve(kq, '?buoc=gui');
  } else if (viec === 'rut') {
    const kq = laNguoiTao ? await rutPhieuNhan(k.client, p.id)
      : kqHai(false, { vi: 'Chỉ người lập phiếu mới rút về được.', en: 'Only the person who made the note can take it back.' });
    return ve(kq);
  } else if (viec === 'huy') {
    const kq = await huyPhieuNhan(k.client, p.id, String(form.get('ly_do') ?? '').trim() || null);
    return kq.ok ? chuyenHuong(Astro, DS, kq) : ve(kq);
  } else {
    bao = kqHai(false, { vi: 'Việc không hợp lệ.', en: 'Invalid action.' });
  }
}

// ---------------------------------------------------------------------------
// Dữ liệu hiển thị
// ---------------------------------------------------------------------------
const buocUrl = Astro.url.searchParams.get('buoc');
const man: 'them' | 'gui' | 'xong' | 'xem' = !phieu ? 'xem'
  : soanDuoc ? (buocUrl === 'gui' && !dongForm ? 'gui' : 'them')
  : buocUrl === 'xong' && phieu.trang_thai === 'cho_duyet' ? 'xong' : 'xem';

const dongSua = soanDuoc && suaId ? phieu?.dong.find(d => d.id === suaId) ?? null : null;
const tiep = Astro.url.searchParams.get('tiep') ?? '';
const tiepMo = Astro.url.searchParams.get('mo') ?? '';
const dongHien: DongNhanForm = dongForm ?? (dongSua ? dongNhanVaoForm(dongSua)
  : mon.get(tiep)?.theo_tang ? { ...dongNhanTrong(), mat_hang_id: tiep, ngay_mo: /^\d{4}-\d{2}-\d{2}$/.test(tiepMo) ? tiepMo : '' }
  : dongNhanTrong());

// Món hay giao: món đã có trên phiếu này trước, rồi món của vài phiếu gần nhất cùng nhà cung cấp.
let monNut: MatHang[] = [];
let ncc: NccNhap[] = [];
if (phieu && man === 'them') {
  const [cuNcc, dsNcc] = await Promise.all([
    docMonGanDay(k.client, cn.id, phieu.ten_nha_cung_cap, phieu.id),
    phieu.loai === 'mua' ? docNccNhap(k.client, cn.id).catch(() => []) : Promise.resolve([]),
  ]);
  ncc = dsNcc;
  const theoId = new Map(matHang.map(m => [m.id, m]));
  monNut = gopMonGanDay([phieu.dong.map(d => d.mat_hang_id), ...cuNcc], 12)
    .map(id => theoId.get(id)).filter((m): m is MatHang => !!m && m.dang_dung).slice(0, 8);
}
const chonONut = monNut.some(m => m.id === dongHien.mat_hang_id);
const monDangChon = mon.get(dongHien.mat_hang_id);

const noiNhan = viTri.filter(v => (v.dang_dung && (v.loai === 'kho' || v.loai === 'quay')) || v.id === phieu?.vi_tri_id);
const dauHien: DauNhan | null = dauForm ?? (phieu ? {
  nha_cung_cap_id: phieu.nha_cung_cap_id ?? '', vi_tri_id: phieu.vi_tri_id, ngay_nhap: phieu.ngay_nhap,
  so_hoa_don: phieu.so_hoa_don ?? '', truong_them: phieu.truong_them,
} : null);

const tongKg = phieu ? phieu.dong.reduce((s, d) => s + d.so_kg, 0) : 0;
const tongGoi = phieu ? phieu.dong.reduce((s, d) => s + (d.so_goi || 0), 0) : 0;
const vanDe = phieu && man === 'gui' ? kiemTruocKhiGui(phieu, dnPhieu, dnLo, nn) : [];
const ten = phieu ? await tenNhanSu(k.client, [phieu.nguoi_tao, phieu.nguoi_gui, phieu.nguoi_duyet]) : new Map<string, string>();
// Nhãn trạng thái cho thủ kho: "Bị trả về" dễ hiểu hơn "Bị từ chối".
const nhanTrangThai = (tt: string): [string, string] => {
  if (tt === 'tu_choi') return [t.biTraVe, 'tat'];
  const [nhan, lop] = trangThaiKho(tt, nn);
  return [nhan, lop || 'tat'];
};
const [nhanTT, lopTT] = phieu ? nhanTrangThai(phieu.trang_thai) : ['', 'tat'];
const maGuiForm = crypto.randomUUID();
const maGuiAnhForm = maGuiAnh ?? crypto.randomUUID();

/** "Nhiệt độ khi nhận: 2 · Số xe: 51C…" cho thẻ dòng. */
const tomTatTruong = (gt: GiaTriTruong) => dnLo
  .filter(x => gt?.[x.khoa] !== undefined && gt[x.khoa] !== '')
  .map(x => `${x.nhan}: ${hienThiGiaTri(x, gt[x.khoa], nn)}`).join(' · ');
const soGoiChu = (so: number, donVi: string) => (so > 0 ? `${so} ${donVi}` : '');
// Phiếu nhận theo đơn đặt (0039): cột "Đặt" cạnh kg nhận, món trong đơn chưa có trên phiếu.
const donDat = phieu?.don_dat ?? null;
const datTheoMon = new Map((donDat?.dong ?? []).map(x => [x.mat_hang_id, x]));
const chuDat = (mh: string, donVi: string) => {
  const x = datTheoMon.get(mh);
  return x ? t.dat(x.so_kg_dat, x.so_goi_dat, donVi) : null;
};
// Chỉ nhắc món còn thiếu: phiếu đang sửa (nháp / bị trả về) chưa tính vào so_kg_da_nhan, nên
// món đã về đủ ở phiếu trước (≥ 95% kg đặt — luật "đủ" của 0039) không bị nhắc lại.
const monDatChuaCan = (donDat?.dong ?? []).filter(x => !phieu?.dong.some(d => d.mat_hang_id === x.mat_hang_id)
  && x.so_kg_da_nhan < x.so_kg_dat * 0.95);
const tieuDe = phieu ? t.tdPhieu(phieu.so_phieu) : t.tdChung;
---
<Kho k={k} tieuDe={tieuDe} huongDan="nhan-hang-can">
  {man === 'them' && <p class="nh-buoc">{t.buoc2}</p>}
  {man === 'gui' && <p class="nh-buoc">{t.buoc3}</p>}
  <h1>{man === 'xong' ? t.daGuiTd : tieuDe}</h1>
  {!(man === 'xong' && bao?.ok) && <BaoKho bao={bao} loiDoc={loiDoc} />}

  {phieu && phieu.trang_thai === 'tu_choi' && phieu.ly_do && man !== 'xong' && (
    <div class="nb-bao loi nh-tra-ve" role="alert">
      <p><strong>{t.phieuBiTraVe}</strong> {phieu.ly_do}</p>
      <p>{t.suaTheoLyDo}</p>
    </div>
  )}

  {phieu && man === 'xong' && (
    // =====================================================================
    // XONG
    // =====================================================================
    <div class="nb-the nh-xong">
      <p class="nh-xong-dau">{t.daGuiSo} {phieu.so_phieu}</p>
      <p>{t.seDuyet}</p>
      <p class="kho-phu">{t.soMon(phieu.dong.length)} · {dinhDangKg(tongKg, nn)} kg{tongGoi > 0 && <> · {tongGoi} {t.tangGoi}</>}</p>
      <div class="kho-nut-nhanh">
        <a class="nb-nut nh-lon" href={`${DS}/moi`}>{t.nhanTiep}</a>
        <a class="nb-nut phu nh-lon" href="/noi-bo/kho">{t.veTrangChu}</a>
      </div>
    </div>
  )}

  {phieu && man !== 'xong' && (
    // =====================================================================
    // THÔNG TIN PHIẾU (mọi màn)
    // =====================================================================
    <div class="nb-the">
      <p class="nb-dan" style="margin-top:0">
        <span class={`nb-nhan ${lopTT}`}>{nhanTT}</span>
        {phieu.loai === 'ton_dau' && <>{t.tonDau}</>}
        {' '}· {t.lapBoi} {ten.get(phieu.nguoi_tao ?? '') ?? '—'} {t.luc} {dinhDangThoiDiem(phieu.created_at)}
        {phieu.gui_luc && <> · {t.gui} {dinhDangThoiDiem(phieu.gui_luc)}</>}
        {phieu.duyet_luc && phieu.trang_thai === 'da_duyet' && <> · {t.duyetBoi} {ten.get(phieu.nguoi_duyet ?? '') ?? '—'} {dinhDangThoiDiem(phieu.duyet_luc)}</>}
      </p>
      <dl class="kho-dl">
        {phieu.loai === 'mua' && <><dt>{t.nguoiGiao}</dt><dd><strong>{phieu.ten_nha_cung_cap ?? t.chuaChon}</strong></dd></>}
        {donDat && <><dt>{t.theoDon}</dt><dd><a href={`/noi-bo/kho/dat-hang/${donDat.id}`}>{donDat.so_phieu}</a> · {t.henGiao} {dinhDangNgay(donDat.ngay_giao_du_kien)}</dd></>}
        <dt>{t.nhanVao}</dt><dd>{phieu.ten_vi_tri ?? '—'}</dd>
        <dt>{t.ngayNhan}</dt><dd>{dinhDangNgay(phieu.ngay_nhap)}</dd>
        {phieu.so_hoa_don && <><dt>{t.soHoaDon}</dt><dd>{phieu.so_hoa_don}</dd></>}
        {phieu.loai === 'mua' && (
          <><dt>{t.anhHoaDon}</dt><dd>{phieu.so_anh > 0
            ? <span class="nh-da-chup">{t.daChup(phieu.so_anh)}</span>
            : <strong class="nh-thieu">{t.chuaChup}</strong>}</dd></>
        )}
      </dl>
      <TruongThem dinhNghia={dnPhieu} giaTri={phieu.truong_them} chiDoc />

      {man === 'them' && (
        <>
          <form method="POST" enctype="multipart/form-data" class="nh-anh">
            <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />
            <input type="hidden" name="ma_gui" value={maGuiAnhForm} />
            {anhDaTai.map(a => <input type="hidden" name="anh_da_tai" value={a} />)}
            <label class="nb-o" style="margin-bottom:.5rem">
              <span>{phieu.so_anh > 0 ? t.themAnhNhieu : t.chupHoacChon}</span>
              <input type="file" name="anh" accept="image/*,application/pdf" multiple class="nh-tep" />
            </label>
            <button type="submit" name="viec" value="them_anh" class="nb-nut phu">{t.themAnh}</button>
          </form>

          <details class="nh-sua-dau" open={!!dauForm || undefined}>
            <summary>{t.suaDau}</summary>
            <form method="POST">
              <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />
              <input type="hidden" name="ma_gui" value={maGuiForm} />
              {phieu.loai === 'mua' && (
                <label class="nb-o"><span>{t.nguoiGiao}</span>
                  <select name="ncc_khac" required>
                    {ncc.length === 0 && phieu.nha_cung_cap_id && <option value={phieu.nha_cung_cap_id}>{phieu.ten_nha_cung_cap}</option>}
                    {ncc.map(n => <option value={n.id} selected={n.id === dauHien?.nha_cung_cap_id}>{n.ten}</option>)}
                  </select>
                </label>
              )}
              <div class="nb-o">
                <span>{t.nhanVao}</span>
                <NhanHangChon name="vi_tri_id" nhan={t.noiNhan} chon={dauHien?.vi_tri_id}
                  ds={noiNhan.map(v => ({ value: v.id, nhan: v.ten }))} />
              </div>
              <div class="kho-luoi">
                <label class="nb-o"><span>{t.ngayNhanO}</span>
                  <input type="date" name="ngay_nhap" value={dauHien?.ngay_nhap} max={homNayVn()} required /></label>
                {phieu.loai === 'mua' && (
                  <label class="nb-o"><span>{t.soHoaDonO}</span>
                    <input type="text" name="so_hoa_don" value={dauHien?.so_hoa_don} maxlength="60" autocapitalize="characters" /></label>
                )}
              </div>
              {phieu.loai === 'mua' && <TruongThem dinhNghia={dnPhieu} giaTri={dauHien?.truong_them ?? phieu.truong_them} />}
              <button type="submit" name="viec" value="sua_dau" class="nb-nut phu">{t.luuDau}</button>
            </form>
          </details>
        </>
      )}
    </div>
  )}

  {phieu && man !== 'xong' && (
    // =====================================================================
    // CÁC DÒNG ĐÃ CÂN
    // =====================================================================
    <>
      <h2>{t.hangDaCan}{phieu.dong.length > 0 && <> · {t.soMon(phieu.dong.length)} · {dinhDangKg(tongKg, nn)} kg{tongGoi > 0 && <> · {tongGoi} {t.tangGoi}</>}</>}</h2>
      {phieu.dong.length === 0 ? (
        <p class="nb-rong">{t.chuaCoMon}</p>
      ) : (
        <div class="nh-ds">
          {phieu.dong.map((d, i) => (
            <div class={`nh-the-dong${dongSua?.id === d.id ? ' dang-sua' : ''}`}>
              <div class="nh-the-dau">
                <span class="nh-so">{i + 1}</span>
                <strong class="nh-ten">{d.ten_mat_hang}</strong>
              </div>
              <p class="nh-kg"><b>{dinhDangKg(d.so_kg, nn)} kg</b>{d.theo_tang ? <> · {t.motTang}{d.so_tang ? ` ${soTangChu(d.so_tang)}` : ''}</> : d.so_goi > 0 && <> · {soGoiChu(d.so_goi, d.don_vi_goi)}</>}
                {d.ngay_mo && <> · {t.moNgay(dinhDangNgay(d.ngay_mo))}</>}
                {donDat && <span class="nh-dat">{chuDat(d.mat_hang_id, d.don_vi_goi) ?? t.ngoaiDon}</span>}</p>
              {(d.han_dung || d.so_lo_ncc || tomTatTruong(d.truong_them)) && (
                <p class="kho-phu nh-chi-tiet">
                  {[d.han_dung ? t.hsd(dinhDangNgay(d.han_dung)) : '', d.so_lo_ncc ? t.loNcc(d.so_lo_ncc) : '', tomTatTruong(d.truong_them)]
                    .filter(Boolean).join(' · ')}
                </p>
              )}
              {man === 'them' && (
                <div class="nh-the-nut">
                  <a class="nb-nut phu" href={`${DS}/${phieu.id}?sua=${d.id}#them`}>{t.sua}</a>
                  <form method="POST">
                    <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />
                    <input type="hidden" name="ma_gui" value={maGuiForm} />
                    <input type="hidden" name="dong_id" value={d.id} />
                    <button type="submit" name="viec" value="bo_dong" class="nb-nut phu kho-nut-xoa">{t.bo}</button>
                  </form>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </>
  )}

  {phieu && man === 'them' && (
    // =====================================================================
    // THÊM / SỬA MỘT DÒNG
    // =====================================================================
    <>
      <form method="POST" class="nb-the nh-them" id="them">
        <h2 style="margin-top:0">{dongSua ? t.suaDong(phieu.dong.indexOf(dongSua) + 1) : phieu.dong.length ? t.themMonTiep : t.themMon}</h2>
        {!dongSua && monDatChuaCan.length > 0 && (
          <p class="kho-phu">{t.conChuaCan(donDat?.so_phieu ?? '', monDatChuaCan.map(x => t.monCon(x.ten_mat_hang, dinhDangKg(Math.max(x.so_kg_dat - x.so_kg_da_nhan, 0), nn))).join(', '))}</p>
        )}
        <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />
        <input type="hidden" name="ma_gui" value={maGuiForm} />
        {dongSua && <input type="hidden" name="dong_id" value={dongSua.id} />}

        <div class="nb-o">
          <span>{t.monGi}</span>
          <NhanHangChon name="mh" nhan={t.monHayGiao} chon={chonONut ? dongHien.mat_hang_id : ''}
            ds={monNut.map(m => ({ value: m.id, nhan: m.ten, phu: m.nhom }))} />
          <ChonMatHang name="mh_khac" matHang={matHang} chon={chonONut ? '' : dongHien.mat_hang_id}
            trong={monNut.length ? t.monKhac : t.chonMon} />
        </div>

        <div class="kho-luoi">
          <label class="nb-o"><span>{t.soKg}</span>
            <input type="text" inputmode="decimal" name="so_kg" value={dongHien.so_kg} placeholder={t.viDuKg} class="nh-o-lon" /></label>
          <label class="nb-o"><span>{t.soDonVi(monDangChon?.don_vi_goi)}</span>
            <input type="text" inputmode="numeric" name="so_goi" value={dongHien.so_goi} placeholder={t.viDuGoi} class="nh-o-lon" /></label>
        </div>

        {coTheoTang && (
          <label class="nb-o"><span>{t.ngayMo}</span>
            <small>{t.ngayMoGoiY}</small>
            <input type="date" name="ngay_mo" value={dongHien.ngay_mo} /></label>
        )}

        <TruongThem dinhNghia={dnLo.filter(x => x.bat_buoc)} giaTri={dongHien.truong_them} dong={0} />

        <details open={!!(dongHien.han_dung || dongHien.ngay_san_xuat || dongHien.so_lo_ncc) || undefined}>
          <summary>{t.themChiTiet}{dnLo.some(x => !x.bat_buoc && x.dang_dung) ? t.thongTinKhac : ''}</summary>
          <div class="kho-luoi">
            <label class="nb-o"><span>{t.hanDung}</span>
              <small>{t.boTrongHsd}</small>
              <input type="date" name="hsd" value={dongHien.han_dung} /></label>
            <label class="nb-o"><span>{t.ngaySx}</span>
              <input type="date" name="nsx" value={dongHien.ngay_san_xuat} /></label>
            <label class="nb-o"><span>{t.soLo}</span>
              <input type="text" name="so_lo_ncc" value={dongHien.so_lo_ncc} maxlength="60" autocapitalize="characters" /></label>
          </div>
          <TruongThem dinhNghia={dnLo.filter(x => !x.bat_buoc)} giaTri={dongHien.truong_them} dong={0} />
        </details>

        <div class="kho-thanh-nut">
          <button type="submit" name="viec" value="them_dong" class="nb-nut nh-lon">{dongSua ? t.luuDong : t.themDong}</button>
          {dongSua && <a class="nb-nut phu" href={`${DS}/${phieu.id}#them`}>{t.thoiKhongSua}</a>}
        </div>
      </form>

      {phieu.dong.length > 0 && (
        <div class="kho-thanh-nut dinh">
          <a class="nb-nut nh-lon" href={`${DS}/${phieu.id}?buoc=gui`}>{t.xongXemLai}</a>
        </div>
      )}

      <details class="nb-the" style="margin-top:1.5rem">
        <summary style="cursor:pointer;font-weight:600">{t.boPhieuNay}</summary>
        <form method="POST" style="margin-top:.75rem">
          <label class="nb-o"><span>{t.lyDoTuyY}</span><input type="text" name="ly_do" maxlength="500" /></label>
          <button type="submit" name="viec" value="huy" class="nb-nut kho-nut-xoa">{t.boPhieu}</button>
        </form>
      </details>
    </>
  )}

  {phieu && man === 'gui' && (
    // =====================================================================
    // XEM LẠI RỒI GỬI
    // =====================================================================
    <>
      {vanDe.length > 0 ? (
        <div class="nb-bao luu-y">
          <p><strong>{t.chuaGuiDuoc}</strong></p>
          <ul>{vanDe.map(v => <li>{v}</li>)}</ul>
          <p><a href={`${DS}/${phieu.id}`}>{t.quayLaiSua}</a></p>
        </div>
      ) : (
        <form method="POST" class="kho-thanh-nut dinh">
          <input type="hidden" name="phien_ban" value={String(phieu.phien_ban)} />
          <button type="submit" name="viec" value="gui" class="nb-nut nh-lon">{t.guiKeToan}</button>
        </form>
      )}
      <p style="margin-top:1rem"><a href={`${DS}/${phieu.id}`}>{t.suaTiep}</a></p>
    </>
  )}

  {phieu && man === 'xem' && (
    // =====================================================================
    // CHỈ XEM
    // =====================================================================
    <>
      {phieu.trang_thai === 'cho_duyet' && (
        <p class="nb-dan">{t.dangCho}</p>
      )}
      {phieu.trang_thai === 'da_duyet' && (
        <p class="nb-dan">{t.daDuyet} <a href="/noi-bo/kho/ton">{t.xemTon}</a></p>
      )}
      {phieu.trang_thai === 'cho_duyet' && laNguoiTao && (
        <form method="POST" class="kho-thanh-nut">
          <button type="submit" name="viec" value="rut" class="nb-nut phu">{t.rutVe}</button>
        </form>
      )}
    </>
  )}

  {man !== 'xong' && <p class="kho-khong-in" style="margin-top:1.5rem"><a href={DS}>{t.veDs}</a></p>}
</Kho>

<style>
  .nh-buoc { margin: 0 0 .15rem; font-size: .85rem; font-weight: 700; color: var(--muc-nhat); }
  .nh-lon { min-height: 56px; font-size: 1.05rem; }
  .nh-tep { font-size: 16px; min-height: 48px; }
  .nh-o-lon { font-size: 1.25rem !important; min-height: 56px; }
  .nh-da-chup { font-weight: 700; color: var(--kho-xanh, #1f7a4c); }
  .nh-thieu { color: var(--do, #b3261e); }
  .nh-tra-ve p { margin: .2rem 0; }
  .nh-anh { margin: .75rem 0; }
  .nh-sua-dau > summary { cursor: pointer; font-weight: 600; min-height: 48px; display: flex; align-items: center; }
  .nh-ds { display: grid; gap: .6rem; margin-bottom: 1rem; }
  .nh-the-dong {
    border: 1px solid var(--kho-vach, #ddd); border-radius: 12px; background: #fff; padding: .75rem .9rem;
  }
  .nh-the-dong.dang-sua { border: 2px solid var(--than, #2b1d14); }
  .nh-the-dau { display: flex; align-items: center; gap: .5rem; }
  .nh-so {
    flex-shrink: 0; background: var(--than, #2b1d14); color: var(--kem, #fff); font-size: .75rem; font-weight: 700;
    padding: .1rem .45rem; border-radius: 4px;
  }
  .nh-ten { font-size: 1.05rem; }
  .nh-kg { margin: .35rem 0 .2rem; font-size: 1.05rem; }
  .nh-kg b { font-size: 1.35rem; }
  .nh-dat { display: inline-block; margin-left: .5rem; padding: .1rem .45rem; border-radius: 4px; background: var(--kem-sau, #f3eee6); font-size: .85rem; color: var(--muc-nhat); }
  .nh-chi-tiet { margin: 0 0 .3rem; }
  .nh-the-nut { display: flex; gap: .5rem; margin-top: .5rem; }
  .nh-the-nut .nb-nut, .nh-the-nut form { flex: 1; }
  .nh-the-nut form .nb-nut { width: 100%; }
  .nh-them details > summary { cursor: pointer; min-height: 48px; display: flex; align-items: center; font-weight: 600; }
  .nh-xong { text-align: center; padding: 1.5rem 1rem; }
  .nh-xong-dau { font-size: 1.5rem; font-weight: 800; color: var(--kho-xanh, #1f7a4c); margin: 0 0 .5rem; }
</style>
