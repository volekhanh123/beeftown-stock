---
/**
 * KHO — HƯỚNG DẪN SỬ DỤNG (GĐ6)
 *
 * Nội dung ở lib/kho/huong-dan.ts (dùng chung với trang chia sẻ gửi Zalo).
 * Nút "?" trên thanh trên của mọi màn kho trỏ về đây, đúng #id của màn đó.
 *
 * Lọc theo vai (?vai=thu_kho…, mặc định vai người đang xem; ?vai=tat-ca xem
 * hết) KHÔNG xóa mục nào khỏi HTML: mục của vai mình bày ra (mục lục chỉ gồm
 * các mục này), mục của vai khác nằm trong MỘT mục gập "Việc của vai khác".
 * Nhờ vậy mọi #id luôn có trong HTML — link cũ vẫn tới đúng chỗ.
 *
 * Gọn 23/10/2026 (Khánh duyệt): mỗi mục là một <details> — tiêu đề và câu tóm tắt;
 * bấm mở mới thấy bước, mẹo, ảnh. ?mo=<id> mở sẵn mục đó (và mục gập "vai khác"
 * nếu nó nằm trong đó): nút "?" của mọi màn (layouts/Kho.astro) và mục lục dùng
 * ?mo=<id>#<id>.
 *
 * Không JavaScript: chip vai là link, câu hỏi dùng <details>.
 *
 * Hai thứ tiếng: câu của trang ở bảng t; câu của từng mục, câu hỏi, tên nhóm
 * là cặp { vi, en } trong huong-dan.ts — luôn đọc [nn].
 */
import Kho from '../../../layouts/Kho.astro';
import TheTrangCon from '../../../components/kho/TheTrangCon.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import {
  MUC_HUONG_DAN, NHOM_VAI, CAU_HOI, dinhDang, vaiHuongDan, nhomCua,
  type MucHuongDan, type VaiHuongDan,
} from '../../../lib/kho/huong-dan.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const nn = k.nn;
const t = dichNB(nn, {
  tieuDe: { vi: 'Hướng dẫn', en: 'Help' },
  h1: { vi: 'Hướng dẫn sử dụng kho', en: 'Inventory user guide' },
  // Hai nửa câu quanh nút <strong>?</strong> — khoảng trắng nằm sẵn trong câu.
  dan1: { vi: 'Mỗi việc là vài bước đánh số, chữ in đậm là chữ trên nút cần bấm. Bấm ',
          en: 'Each task is a few numbered steps; bold text is the label on the button to press. Press ' },
  dan2: { vi: ' ở góc trên của màn nào thì mở đúng mục của màn đó.',
          en: ' at the top of any screen to open the section for that screen. The screenshots show the Vietnamese screens.' },
  xemTheoVai: { vi: 'Xem theo vai', en: 'View by role' },
  xemTatCa: { vi: 'Xem tất cả', en: 'Show all' },
  mucLuc: { vi: 'Mục lục', en: 'Contents' },
  cauHoi: { vi: 'Câu hỏi thường gặp', en: 'Frequently asked questions' },
  viecCua: { vi: (ten: string) => `Việc của ${ten}`, en: (ten: string) => `${ten} tasks` },
  vaiKhac: { vi: 'Việc của vai khác', en: 'Tasks for other roles' },
  soMuc: { vi: (n: number) => `${n} mục`, en: (n: number) => `${n} ${n === 1 ? 'section' : 'sections'}` },
});

const DUONG = '/noi-bo/kho/huong-dan';
const thamSo = Astro.url.searchParams.get('vai');
const tatCa = thamSo === 'tat-ca';
const vaiChon: VaiHuongDan = tatCa ? 'chung' : vaiHuongDan(thamSo ?? k.nhanSu.vai_tro);
const locVai = !tatCa && vaiChon !== 'chung';
const tenVai = (v: VaiHuongDan) => NHOM_VAI.find(n => n.vai === v)?.ten[nn] ?? '';

interface Khoi { id: string; ten: string; muc: MucHuongDan[] }
const theoNhom = (ds: MucHuongDan[]): Khoi[] => NHOM_VAI
  .map(n => ({ id: `nhom-${n.vai.replace(/_/g, '-')}`, ten: n.ten[nn], muc: ds.filter(m => nhomCua(m) === n.vai) }))
  .filter(n => n.muc.length > 0);

// "Bắt đầu" luôn trên cùng; rồi việc của vai đang chọn; rồi phần còn lại.
const batDau = MUC_HUONG_DAN.filter(m => nhomCua(m) === 'chung');
const cuaToi = locVai ? MUC_HUONG_DAN.filter(m => nhomCua(m) !== 'chung' && m.vai.includes(vaiChon)) : [];
const conLai = MUC_HUONG_DAN.filter(m => nhomCua(m) !== 'chung' && !cuaToi.includes(m));
const khoi: Khoi[] = [
  { id: 'nhom-chung', ten: tenVai('chung'), muc: batDau },
  ...(locVai ? [{ id: 'viec-cua-toi', ten: t.viecCua(tenVai(vaiChon)), muc: cuaToi }] : []),
];
const khoiKhac = theoNhom(conLai);
/** Mục mở sẵn (?mo=<id>): nút "?" của màn, link trong mục lục. */
const mo = Astro.url.searchParams.get('mo') ?? '';
const moVaiKhac = locVai && conLai.some(m => m.id === mo);
/** Link mở sẵn một mục, giữ vai đang lọc. */
const linkMo = (id: string) => `${DUONG}?${new URLSearchParams({ ...(thamSo ? { vai: thamSo } : {}), mo: id }).toString()}#${id}`;
---
<Kho k={k} tieuDe={t.tieuDe}>
  <TheTrangCon k={k} cha="huong_dan" />
  <h1>{t.h1}</h1>
  <p class="nb-dan">{t.dan1}<strong>?</strong>{t.dan2}</p>

  <nav class="kho-dh" aria-label={t.xemTheoVai}>
    {NHOM_VAI.filter(n => n.vai !== 'chung').map(n => (
      <a href={`${DUONG}?vai=${n.vai}`} aria-current={locVai && n.vai === vaiChon ? 'page' : undefined}>{n.ten[nn]}</a>
    ))}
    <a href={`${DUONG}?vai=tat-ca`} aria-current={!locVai ? 'page' : undefined}>{t.xemTatCa}</a>
  </nav>

  <section class="nb-the hd-muc-luc" aria-labelledby="muc-luc">
    <h2 id="muc-luc" style="margin-top:0">{t.mucLuc}</h2>
    {(locVai ? khoi : [...khoi, ...khoiKhac]).map(n => (
      <>
        <p class="hd-nhom-ten"><a href={`#${n.id}`}>{n.ten}</a></p>
        <ul>{n.muc.map(m => <li><a href={linkMo(m.id)}>{m.tieuDe[nn]}</a></li>)}</ul>
      </>
    ))}
    {locVai && khoiKhac.length > 0 && <p class="hd-nhom-ten"><a href="#vai-khac">{t.vaiKhac}</a></p>}
    <p class="hd-nhom-ten"><a href="#cau-hoi">{t.cauHoi}</a></p>
  </section>

  {(() => {
    const theMuc = (m: MucHuongDan) => (
      <details class="nb-the hd-the" id={m.id} open={m.id === mo}>
        <summary>
          <h3>{m.tieuDe[nn]}</h3>
          <span class="hd-tom-tat" set:html={dinhDang(m.tomTat[nn])} />
        </summary>
        <ol class="hd-buoc">{m.buoc.map(b => <li set:html={dinhDang(b[nn])} />)}</ol>
        {m.meo && m.meo.length > 0 && (
          <ul class="hd-meo">{m.meo.map(x => <li set:html={dinhDang(x[nn])} />)}</ul>
        )}
        {m.anh && (
          <figure class="hd-anh">
            <img src={m.anh.file} alt={m.anh.chu[nn]} width={m.anh.rong} height={m.anh.cao} loading="lazy" decoding="async" />
            <figcaption class="kho-phu">{m.anh.chu[nn]}</figcaption>
          </figure>
        )}
        {m.link && <p class="kho-khong-in" style="margin:.75rem 0 0"><a class="nb-nut phu" href={m.link.href}>{m.link.chu[nn]} →</a></p>}
      </details>
    );
    const theKhoi = (ds: Khoi[]) => ds.map(n => (
      <>
        <h2 id={n.id} class="hd-nhom">{n.ten}</h2>
        {n.muc.map(theMuc)}
      </>
    ));
    return <>
      {theKhoi(locVai ? khoi : [...khoi, ...khoiKhac])}
      {locVai && khoiKhac.length > 0 && (
        <details class="hd-vai-khac" id="vai-khac" open={moVaiKhac}>
          <summary>{t.vaiKhac} · {t.soMuc(conLai.length)}</summary>
          {theKhoi(khoiKhac)}
        </details>
      )}
    </>;
  })()}

  <h2 id="cau-hoi" class="hd-nhom">{t.cauHoi}</h2>
  <section class="nb-the hd-hoi">
    {CAU_HOI.map(c => (
      <details id={c.id}>
        <summary>{c.hoi[nn]}</summary>
        <p set:html={dinhDang(c.dap[nn])} />
      </details>
    ))}
  </section>
</Kho>

<style>
  .hd-nhom { margin: 1.75rem 0 .5rem; }
  .hd-vai-khac { border-top: 2px solid var(--kho-vach); padding-top: .5rem; margin-top: 1.75rem; scroll-margin-top: 5rem; }
  .hd-vai-khac > summary { cursor: pointer; font-weight: 700; font-size: 1.1rem; min-height: 48px; display: list-item; padding: .6rem 0; }
  /* Mỗi mục một thẻ gập: tiêu đề + câu tóm tắt; bấm mở ra bước, mẹo, ảnh. */
  .hd-the > summary { cursor: pointer; list-style: none; position: relative; padding-left: 1.4rem; }
  .hd-the > summary::-webkit-details-marker { display: none; }
  .hd-the > summary::before { content: '▸'; position: absolute; left: 0; top: .1rem; color: var(--muc-nhat); }
  .hd-the[open] > summary::before { content: '▾'; }
  .hd-the > summary h3 { margin: 0 0 .25rem; font-size: 1.02rem; }
  .hd-the[open] > summary { margin-bottom: .5rem; }
  .hd-muc-luc ul { margin: .25rem 0 .75rem; padding-left: 1.2rem; }
  .hd-muc-luc li { margin: .3rem 0; }
  .hd-nhom-ten { margin: .5rem 0 0; font-weight: 700; }
  .hd-the { scroll-margin-top: 5rem; }
  .hd-tom-tat { display: block; margin: 0; color: var(--muc-nhat); font-size: .92rem; }
  .hd-buoc { margin: 0; padding-left: 1.4rem; }
  .hd-buoc li { margin: .4rem 0; line-height: 1.5; }
  .hd-meo { margin: .75rem 0 0; padding-left: 1.2rem; font-size: .92rem; color: var(--muc-nhat); }
  .hd-meo li { margin: .3rem 0; }
  .hd-anh { margin: 1rem 0 0; }
  .hd-anh img {
    display: block; width: 100%; max-width: 320px; height: auto;
    border: 1px solid var(--kho-vach); border-radius: var(--kho-bo);
  }
  .hd-anh figcaption { margin-top: .35rem; }
  .hd-hoi details { border-bottom: 1px solid var(--kho-vach); scroll-margin-top: 5rem; }
  .hd-hoi details:last-child { border-bottom: 0; }
  .hd-hoi summary { cursor: pointer; font-weight: 600; min-height: 48px; display: flex; align-items: center; }
  .hd-hoi details p { margin: 0 0 .9rem; }
  @media print {
    .hd-anh img { max-width: 220px; }
    .hd-the { break-inside: avoid; }
    .hd-the > summary::before { content: none; }
    /* In ra thì in đủ bước của mọi mục, kể cả mục đang gập (trình duyệt hiểu ::details-content). */
    .hd-the::details-content, .hd-vai-khac::details-content { content-visibility: visible; display: block; }
  }
</style>
