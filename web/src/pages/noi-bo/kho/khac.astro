---
/**
 * KHO — KHÁC
 *
 * Nút cuối thanh đáy trên điện thoại: mọi mục kho mà vai này được dùng, dạng
 * lưới ô lớn (như iPOS), kèm phần khác của nhà hàng (đặt bàn, website...) cho
 * quản lý / chủ, và nút đăng xuất.
 */
import Kho from '../../../layouts/Kho.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import { mucCuaVai, thaoTacCuaVai, soDo, nhanSo, MUC_CRM } from '../../../lib/kho/dieu-huong.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const vai = k.nhanSu.vai_tro;
const muc = mucCuaVai(vai).filter(m => m.ma !== 'trang_chu');
const nhanh = thaoTacCuaVai(vai);
const crm = MUC_CRM.filter(m => m.vai.includes(vai));
const nn = k.nn;
const t = dichNB(nn, {
  tieuDe: { vi: 'Khác', en: 'More' },
  tatCa: { vi: 'Tất cả mục', en: 'All sections' },
  soViec: { vi: (n: number) => `${n} việc`, en: (n: number) => `${n} to do` },
  thaoTacNhanh: { vi: 'Thao tác nhanh', en: 'Quick actions' },
  phanKhac: { vi: 'Phần khác của nhà hàng', en: 'Other restaurant areas' },
  dangXuat: { vi: 'Đăng xuất', en: 'Log out' },
});
---
<Kho k={k} huongDan="menu" tieuDe={t.tieuDe}>
  <h1>{t.tatCa}</h1>

  <ul class="kho-o-luoi kho-khac-luoi">
    {muc.map(m => {
      const so = soDo(m, k.viec);
      return (
        <li>
          <a href={m.link} class="kho-o">
            <BieuTuong ten={m.bieuTuong} co={26} />
            <span>{m.ten[nn]}</span>
            {so > 0 && <b class="kho-so-do" aria-label={t.soViec(so)}>{nhanSo(so)}</b>}
          </a>
        </li>
      );
    })}
  </ul>

  {nhanh.length > 0 && (
    <>
      <h2>{t.thaoTacNhanh}</h2>
      <div class="kho-nhanh-luoi">
        {nhanh.map(x => <a class="nb-nut phu" href={x.link}><BieuTuong ten={x.bieuTuong} co={20} />{x.ten[nn]}</a>)}
      </div>
    </>
  )}

  {crm.length > 0 && (
    <>
      <h2>{t.phanKhac}</h2>
      <div class="kho-nhanh-luoi">
        {crm.map(m => <a class="nb-nut phu" href={m.link}><BieuTuong ten={m.bieuTuong} co={20} />{m.ten[nn]}</a>)}
      </div>
    </>
  )}

  <form method="POST" action="/noi-bo/dang-xuat" class="kho-thanh-nut">
    <button type="submit" class="nb-nut phu kho-nut-xoa"><BieuTuong ten="dang_xuat" co={20} />{t.dangXuat}</button>
  </form>
</Kho>
