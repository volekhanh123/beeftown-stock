---
/**
 * KHO — KHÁC (TẤT CẢ CHỨC NĂNG)
 *
 * Nút cuối thanh đáy trên điện thoại, và đích của ô "Tìm chức năng" ở cột trái
 * máy tính: ô tìm (cả thao tác nhanh và mục con), mọi ô kho vai này dùng được theo nhóm
 * (NHOM_KHO), phần khác của nhà hàng cho quản lý / chủ, rồi nút ra khỏi phiên.
 * Dữ liệu: lib/ban-do-chuc-nang.ts; vẽ: components/BanDoChucNang.astro.
 *
 * Máy tính bảng dùng chung (có người mở khóa bằng PIN): như menu người dùng của
 * layouts/Kho.astro — không phần nhà hàng, "Khóa máy" thay cho "Đăng xuất" (đăng
 * xuất ở đây là xóa phiên của cả máy).
 */
import Kho from '../../../layouts/Kho.astro';
import BieuTuong from '../../../components/kho/BieuTuong.astro';
import BanDoChucNang from '../../../components/BanDoChucNang.astro';
import { moTrangKho } from '../../../lib/kho/trang.ts';
import {
  banDoChucNang, thaoTacNhanhChucNang, timChucNang, lamSachTimChucNang,
} from '../../../lib/ban-do-chuc-nang.ts';
import { DUONG_MAY, laCheDoMay } from '../../../lib/kho/may-chung.ts';
import { dichNB } from '../../../lib/ngon-ngu-noi-bo.ts';

const k = await moTrangKho(Astro);
if (k instanceof Response) return k;
const vai = k.nhanSu.vai_tro;
const nn = k.nn;
const cheDoMay = laCheDoMay(vai, k.may);
const tim = lamSachTimChucNang(Astro.url.searchParams.get('tim'));
const nhom = banDoChucNang(vai, 'kho', { cheDoMay });
const nhanh = thaoTacNhanhChucNang(vai);
const ketQua = timChucNang(nhom, nhanh, tim);
const t = dichNB(nn, {
  tieuDe: { vi: 'Khác', en: 'More' },
  tatCa: { vi: 'Tất cả chức năng', en: 'All features' },
  dangXuat: { vi: 'Đăng xuất', en: 'Log out' },
  khoaMay: { vi: 'Khóa máy', en: 'Lock tablet' },
});
---
<Kho k={k} huongDan="menu" tieuDe={t.tieuDe}>
  <h1>{t.tatCa}</h1>

  <BanDoChucNang nn={nn} hanhDong="/noi-bo/kho/khac" nhom={nhom} tim={tim} ketQua={ketQua} viec={k.viec} />

  {cheDoMay ? (
    <form method="POST" action={DUONG_MAY} class="kho-thanh-nut">
      <input type="hidden" name="viec" value="khoa" />
      <button type="submit" class="nb-nut phu"><BieuTuong ten="dang_xuat" co={20} />{t.khoaMay}</button>
    </form>
  ) : (
    <form method="POST" action="/noi-bo/dang-xuat" class="kho-thanh-nut">
      <button type="submit" class="nb-nut phu kho-nut-xoa"><BieuTuong ten="dang_xuat" co={20} />{t.dangXuat}</button>
    </form>
  )}
</Kho>
