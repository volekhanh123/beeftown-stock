---
/**
 * SOẠN MỘT TIN TUYỂN DỤNG
 *
 * Mọi thứ của một tin ở một chỗ: nội dung hai thứ tiếng, lương, form nộp hồ
 * sơ hỏi gì, đăng và gỡ. Quyền do database quyết định — xem đầu
 * lib/tin-tuyen-dung.ts.
 *
 * BỐN FORM TÁCH NHAU: soạn (Lưu / Lưu và đăng), dịch ngay, duyệt lương, gỡ
 * tin. Nút Lưu là nút submit đầu tiên của form soạn, nên một cú Enter trong ô
 * chữ chỉ lưu — không bao giờ đăng tin hay duyệt lương.
 *
 * BẢN DỊCH (0036): lưu xong là máy dịch nền những ô có câu tiếng Việt vừa
 * đổi — xem lib/ban-dich.ts. Ô tiếng Anh/Hàn vẫn sửa tay được; sửa tay thắng
 * máy cho tới khi câu tiếng Việt của ô đó đổi.
 *
 * GHI ĐƯỢC THÌ CHUYỂN HƯỚNG 303 về chính tin (lib/gui-noi-bo.ts): F5 không lưu
 * lại bản cũ — lần hai trước đây ra "Tin vừa được người khác sửa … CHƯA được
 * lưu" dù lần một đã lưu. Không ghi được thì dựng lại trang ngay, với đúng chữ
 * người soạn vừa gõ. Lần hai của cú bấm đúp: luuTin / goTin / duyetLuong tự
 * nhận ra tin đã đúng như vừa gửi.
 */
import NoiBo from '../../../layouts/NoiBo.astro';
import { TRUONG_FORM } from '../../../lib/truong-form';
import { BO_PHAN, LOAI_HOP_DONG, MA_CHUA_CHOT, CHUA_CHOT, DON_VI_LUONG, dinhDangLuong } from '../../../lib/tuyen-dung';
import {
  docTin, luuTin, duyetLuong, goTin, TRANG_THAI, homNayVn, donViDeXuat, canhBaoDonVi, O_DICH,
  type TinTuyenDung, type KetQuaLuu,
} from '../../../lib/tin-tuyen-dung';
import { dichBu, chayNen, oDangCho, moTaO, cauTomTat } from '../../../lib/ban-dich';
import { dichNB, nnCua } from '../../../lib/ngon-ngu-noi-bo';
import { dichCau } from '../../../lib/cau-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, docBaoNoiBo, docFormNoiBo } from '../../../lib/gui-noi-bo';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const nn = nnCua(Astro);
const t = dichNB(nn, {
  tinTD:        { vi: 'Tin tuyển dụng', en: 'Job posting' },
  daTao:        { vi: 'Đã tạo tin ở dạng nháp. Viết mô tả và yêu cầu, rồi bấm "Lưu và đăng lên trang".',
                  en: 'Created the posting as a draft. Write the description and requirements, then press "Save and publish".' },
  khongDocTin:  { vi: 'Không đọc được tin.', en: 'Could not read the posting.' },
  dangDich:     { vi: (cau: string) => `${cau} Bản tiếng Anh và tiếng Hàn đang được dịch — tải lại trang sau ít giây để xem.`,
                  en: (cau: string) => `${cau} The English and Korean versions are being translated — reload in a few seconds to see them.` },
  tatCaTin:     { vi: '← Tất cả tin tuyển dụng', en: '← All job postings' },
  khongThay:    { vi: 'Không tìm thấy tin này, hoặc tài khoản của bạn không xem được.', en: 'This posting was not found, or your account cannot view it.' },
  maTin1:       { vi: 'Mã tin ', en: 'Posting code ' },
  maTin2:       { vi: ' — cố định, vì form công khai gửi đúng mã này.', en: ' — fixed, because the public form sends exactly this code.' },
  dangLuc:      { vi: (g: string) => ` Đăng lúc ${g}. `, en: (g: string) => ` Published at ${g}. ` },
  xemTrang:     { vi: 'Xem trên trang ↗', en: 'View on the site ↗' },
  quaHan1:      { vi: 'Hạn nộp đã qua, nên tin này ', en: 'The deadline has passed, so this posting is ' },
  quaHan2:      { vi: 'không còn hiện', en: 'no longer shown' },
  quaHan3:      { vi: ' trên trang dù vẫn đang đăng. Lùi hạn nộp, hoặc để trống, để tin hiện lại.',
                  en: ' on the site even though it is live. Move the deadline later, or clear it, to show it again.' },
  chiDoc:       { vi: 'Chỉ chủ nhà hàng, quản lý và marketing sửa được tin. Bạn đang xem ở chế độ chỉ đọc.',
                  en: 'Only the owner, managers and marketing can edit postings. You are in read-only mode.' },
  tenPhanLoai:  { vi: 'Tên và phân loại', en: 'Title and category' },
  tenViTri:     { vi: 'Tên vị trí', en: 'Position title (in Vietnamese)' },
  boPhan:       { vi: 'Bộ phận', en: 'Department' },
  loaiHD:       { vi: 'Loại hợp đồng', en: 'Contract type' },
  soLuong:      { vi: 'Số lượng cần tuyển', en: 'Openings' },
  hanNop:       { vi: 'Hạn nộp', en: 'Deadline' },
  hanNopPhu:    { vi: 'Hạn nộp để trống nếu tuyển liên tục. Qua hạn thì tin tự ẩn khỏi trang.',
                  en: 'Leave the deadline empty for ongoing hiring. After the deadline the posting hides itself.' },
  capBac:       { vi: 'Cấp bậc, lộ trình', en: 'Level, career path (in Vietnamese)' },
  capBacVD:     { vi: 'Ví dụ: 3 bậc · Hướng lên quản lý cửa hàng', en: 'e.g. 3 bậc · Hướng lên quản lý cửa hàng' },
  caLam:        { vi: 'Ca làm', en: 'Shifts (in Vietnamese)' },
  caLamVD:      { vi: 'Ví dụ: Ca tối 16:00–22:00', en: 'e.g. Ca tối 16:00–22:00' },
  noiDungTin:   { vi: 'Nội dung tin', en: 'Posting text' },
  noiDungPhu1:  { vi: 'Muốn đăng thì phải có mô tả và yêu cầu. Chữ trong ngoặc vuông, kiểu ',
                  en: 'To publish, the description and requirements must be filled in (in Vietnamese). Text in square brackets, like ' },
  noiDungPhu2:  { vi: ', được coi là chưa viết xong và chặn việc đăng.', en: ', counts as unfinished and blocks publishing.' },
  moTa:         { vi: 'Mô tả công việc', en: 'Job description' },
  yeuCau:       { vi: 'Yêu cầu', en: 'Requirements' },
  quyenLoi:     { vi: 'Quyền lợi', en: 'Benefits' },
  khongBatBuoc: { vi: 'Không bắt buộc.', en: 'Optional.' },
  banDichTom:   { vi: 'Bản tiếng Anh và tiếng Hàn — máy tự dịch', en: 'English and Korean versions — machine translated' },
  banDichPhu:   { vi: 'Mỗi lần lưu, máy dịch những ô có câu tiếng Việt vừa đổi. Sửa tay ô nào thì ô đó được giữ, cho tới khi câu tiếng Việt của nó đổi. Xóa trắng một ô là nhờ máy dịch lại ô đó.',
                  en: 'Each save translates the fields whose Vietnamese text changed. A field you edit by hand is kept until its Vietnamese text changes. Clear a field to have it machine-translated again.' },
  tiengAnh:     { vi: 'Tiếng Anh', en: 'English' },
  tiengHan:     { vi: 'Tiếng Hàn', en: 'Korean' },
  luongDeXuat:  { vi: 'Lương đề xuất', en: 'Proposed salary' },
  dangHien:     { vi: 'Đang hiện trên trang: ', en: 'Shown on the site: ' },
  chuaCoLuong:  { vi: 'chưa có — trang không hiện lương', en: 'none — the site shows no salary' },
  luongPhuDuyet:{ vi: '. Lưu mức đề xuất rồi duyệt ở ô "Duyệt lương" bên dưới.', en: '. Save the proposed amount, then approve it under "Approve salary" below.' },
  luongPhuKhong:{ vi: '. Mức đề xuất chỉ lên trang khi chủ nhà hàng hoặc quản lý duyệt.', en: '. A proposed salary goes on the site only after the owner or a manager approves it.' },
  tu:           { vi: 'Từ (đồng)', en: 'From (dong)' },
  den:          { vi: 'Đến (đồng)', en: 'To (dong)' },
  donVi:        { vi: 'Đơn vị', en: 'Unit' },
  formHoi:      { vi: 'Form nộp hồ sơ hỏi gì', en: 'What the application form asks' },
  formHoi1:     { vi: 'Họ tên, số điện thoại và ô đồng ý luôn có. Trường bật vẫn không bắt buộc; trường tắt thì biến khỏi form, và dù có ai gửi lên cũng ',
                  en: 'Name, phone number and the consent box are always there. Fields that are on are still optional; fields that are off disappear from the form, and even if someone sends them they are ' },
  formHoi2:     { vi: 'không được lưu', en: 'not saved' },
  luuDoiNgay:   { vi: 'Lưu — trang đổi ngay', en: 'Save — the site changes right away' },
  luuVanGo:     { vi: 'Lưu (tin vẫn đang gỡ)', en: 'Save (posting stays down)' },
  luuNhap:      { vi: 'Lưu nháp', en: 'Save draft' },
  luuDang:      { vi: 'Lưu và đăng lên trang', en: 'Save and publish' },
  banDich:      { vi: 'Bản dịch', en: 'Translations' },
  conCho:       { vi: (n: number) => `Còn ${n} ô tiếng Anh/Hàn đang chờ máy dịch. Máy tự làm sau mỗi lần lưu và khi có người mở trang nội bộ; bấm nút này để dịch ngay và xem kết quả.`,
                  en: (n: number) => `${n} English/Korean fields are waiting for machine translation. It runs after each save and whenever someone opens the internal app; press this button to translate now and see the result.` },
  dichNgay:     { vi: 'Dịch ngay', en: 'Translate now' },
  duyetLuong:   { vi: 'Duyệt lương', en: 'Approve salary' },
  deXuatDaLuu:  { vi: 'Mức đề xuất đã lưu: ', en: 'Saved proposal: ' },
  chuaCo:       { vi: 'chưa có', en: 'none' },
  duyetLuc:     { vi: (g: string) => ` — duyệt lúc ${g}`, en: (g: string) => ` — approved at ${g}` },
  camKet:       { vi: 'Lương là cam kết với người lao động. Nút duyệt đưa ĐÚNG mức đề xuất đã lưu lên trang; sửa mức đề xuất thì bấm lưu ở trên trước.',
                  en: 'A salary is a commitment to workers. The approve button puts EXACTLY the saved proposal on the site; if you change the proposal, save it above first.' },
  duyetDeXuat:  { vi: 'Duyệt mức đề xuất', en: 'Approve the proposal' },
  boDuyet:      { vi: 'Bỏ duyệt — gỡ lương khỏi trang', en: 'Remove approval — take the salary off the site' },
  goTin:        { vi: 'Gỡ tin', en: 'Take down' },
  goTinPhu:     { vi: 'Tin biến khỏi trang tuyển dụng ngay. Hồ sơ đã nộp vẫn còn nguyên, và đăng lại lúc nào cũng được.',
                  en: 'The posting disappears from the careers page right away. Applications are kept, and you can publish it again any time.' },
  goKhoiTrang:  { vi: 'Gỡ khỏi trang', en: 'Remove from site' },
});
const duocSoan = ['chu_so_huu', 'quan_ly', 'marketing'].includes(nhanSu.vai_tro);
const duocDuyetLuong = ['chu_so_huu', 'quan_ly'].includes(nhanSu.vai_tro);
const id = Astro.params.id ?? '';

// Gửi về đúng đường dẫn tin, bỏ ?moi=1 — không thì F5 lại hiện câu "Đã tạo tin".
const duongDan = `/noi-bo/tin-tuyen-dung/${id}`;

let bao: KetQuaLuu | null = docBaoNoiBo(Astro.cookies, Astro.url.pathname)
  ?? (Astro.url.searchParams.has('moi') ? { ok: true, cau: t.daTao } : null);

if (Astro.request.method === 'POST') {
  const form = await docFormNoiBo(Astro.request);
  if (!form) bao = { ok: false, cau: CAU_DOC_FORM_HONG[nn] };

  if (form) {
    const viec = String(form.get('viec') ?? '');
    const phienBan = String(form.get('phien_ban') ?? '');
    // Mức đề xuất người duyệt đang thấy trên màn hình (ô ẩn) — để lần hai của cú bấm đúp biết
    // trang đã hiện đúng mức đó chưa.
    const daThay = { tu: String(form.get('de_xuat_tu') ?? ''), den: String(form.get('de_xuat_den') ?? ''),
                     donVi: String(form.get('de_xuat_don_vi') ?? '') };
    bao = viec === 'go'       ? await goTin(client, id, nn)
        : viec === 'duyet'    ? await duyetLuong(client, id, phienBan, true, nn, daThay)
        : viec === 'bo_duyet' ? await duyetLuong(client, id, phienBan, false, nn, daThay)
        // Dịch ngay thì CHỜ kết quả: người bấm nút muốn biết nó xong hay hỏng vì sao.
        : viec === 'dich'     ? cauTomTat(await dichBu(client, { bang: 'vi_tri_tuyen_dung', dongId: id }), nn)
        :                       await luuTin(client, id, form, nn);

    if (bao.ok) {
      // Lưu xong thì dịch nền đúng tin này: trang trả về ngay, bản dịch vào sau
      // vài giây. Máy hỏng cũng không làm hỏng lần lưu — xem chayNen().
      if (viec === 'luu' || viec === 'luu_dang') {
        chayNen(Astro.locals, dichBu(client, { bang: 'vi_tri_tuyen_dung', dongId: id }));
        // Ô nào đang chờ máy dịch — ngay sau khi lưu thì gần như mọi ô vừa đổi.
        if ((await oDangCho(client, 'vi_tri_tuyen_dung', id)).size > 0) bao = { ...bao, cau: t.dangDich(bao.cau) };
      }
      return chuyenHuongNoiBo(Astro, bao, duongDan);
    }
  }
}

let tin: TinTuyenDung | null = null;
let loiDoc: string | null = null;
try {
  tin = await docTin(client, id);
} catch (e) {
  loiDoc = e instanceof Error ? dichCau(nn, e.message) : t.khongDocTin;
}

// Ô nào đang chờ máy dịch.
const dangCho = tin ? await oDangCho(client, 'vi_tri_tuyen_dung', id) : new Set<string>();

// Lưu hỏng thì hiện lại đúng những gì người dùng vừa gõ, không bắt gõ lại.
const v: TinTuyenDung | null = tin && { ...tin, ...(bao && !bao.ok ? bao.daGo : undefined) };
const dangDang = tin?.trang_thai === 'da_cong_bo';
const quaHan = !!tin?.han_nop && tin.han_nop < homNayVn();
const luongDangHien = tin?.luong_da_duyet
  ? dinhDangLuong(tin.luong_tu, tin.luong_den, tin.luong_don_vi, nn) : null;
const luongDeXuat = tin
  ? dinhDangLuong(tin.luong_de_xuat_tu, tin.luong_de_xuat_den, tin.luong_de_xuat_don_vi, nn) : null;
const donVi = v ? donViDeXuat(v) : 'thang';
const nhacDonVi = v ? canhBaoDonVi(v.luong_de_xuat_tu, v.luong_de_xuat_den, donVi, nn) : null;
const gioVn = (iso: string) => new Date(iso).toLocaleString(nn === 'en' ? 'en-GB' : 'vi-VN', {
  timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit',
  day: 'numeric', month: 'numeric', year: 'numeric',
});
---
<NoiBo tieuDe={(nn === 'en' && tin?.ten_en) || tin?.ten_vi || t.tinTD} nhanSu={nhanSu}>
  <p style="margin:0 0 .75rem;font-size:.9rem">
    <a href="/noi-bo/tin-tuyen-dung">{t.tatCaTin}</a>
  </p>

  {bao && <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`}><p>{bao.cau}</p></div>}
  {loiDoc && <div class="nb-bao loi"><p>{loiDoc}</p></div>}

  {!tin && !loiDoc && (
    <div class="nb-rong">
      <p style="margin:0">{t.khongThay}</p>
    </div>
  )}

  {tin && v && (
    <>
      <div class="nb-dong-dau" style="margin-bottom:.35rem">
        {/* Tiêu đề theo ngôn ngữ giao diện; ô soạn bên dưới vẫn là tên tiếng Việt (câu gốc). */}
        <h1 style="margin:0">{(nn === 'en' && tin.ten_en) || tin.ten_vi}</h1>
        <span class={`nb-nhan ${TRANG_THAI[tin.trang_thai].lop}`}>{TRANG_THAI[tin.trang_thai].ten[nn]}</span>
      </div>
      <p class="nb-dan" style="font-size:.85rem">
        {t.maTin1}<code>{tin.ma}</code>{t.maTin2}
        {dangDang && tin.cong_bo_luc && (
          <>{t.dangLuc(gioVn(tin.cong_bo_luc))}<a href={nn === 'en' ? '/en/jobs' : '/tuyen-dung'} target="_blank" rel="noopener">{t.xemTrang}</a></>
        )}
      </p>

      {dangDang && quaHan && (
        <div class="nb-bao luu-y">
          <p>{t.quaHan1}<strong>{t.quaHan2}</strong>{t.quaHan3}</p>
        </div>
      )}

      {!duocSoan && (
        <div class="nb-bao luu-y">
          <p>{t.chiDoc}</p>
        </div>
      )}

      {/* ------------------------------------------------------------ SOẠN */}
      <form method="POST" action={duongDan} class="nb-soan">
        <input type="hidden" name="phien_ban" value={tin.updated_at} />
        <fieldset disabled={!duocSoan}>

          <section class="nb-the">
            <h2>{t.tenPhanLoai}</h2>
            <label class="nb-o">
              <span>{t.tenViTri}</span>
              <input type="text" name="ten_vi" required maxlength="120" value={v.ten_vi}
                     autocapitalize="sentences" />
            </label>
            <div class="nb-hai">
              <label class="nb-o">
                <span>{t.boPhan}</span>
                <select name="bo_phan">
                  {Object.entries(BO_PHAN).map(([ma, nhan]) => (
                    <option value={ma} selected={ma === v.bo_phan}>{nhan[nn]}</option>
                  ))}
                </select>
              </label>
              <label class="nb-o">
                <span>{t.loaiHD}</span>
                <select name="loai_hop_dong">
                  {Object.entries(LOAI_HOP_DONG).map(([ma, nhan]) => (
                    <option value={ma} selected={ma === v.loai_hop_dong}>{nhan[nn]}</option>
                  ))}
                  {/* Chưa chốt = null (0043): trang công khai không hiện dòng loại hợp đồng. */}
                  <option value={MA_CHUA_CHOT} selected={v.loai_hop_dong == null}>{CHUA_CHOT[nn]}</option>
                </select>
              </label>
              <label class="nb-o">
                <span>{t.soLuong}</span>
                <input type="number" name="so_luong" min="1" max="999" inputmode="numeric"
                       value={v.so_luong ?? ''} />
              </label>
              <label class="nb-o">
                <span>{t.hanNop}</span>
                <input type="date" name="han_nop" value={v.han_nop ?? ''} />
              </label>
            </div>
            <p class="nb-dan" style="font-size:.8rem;margin:-.5rem 0 1rem">{t.hanNopPhu}</p>
            <label class="nb-o">
              <span>{t.capBac}</span>
              <small>{t.capBacVD}</small>
              <input type="text" name="cap_bac" value={v.cap_bac ?? ''} />
            </label>
            <label class="nb-o">
              <span>{t.caLam}</span>
              <small>{t.caLamVD}</small>
              <input type="text" name="ca_lam" value={v.ca_lam ?? ''} />
            </label>
          </section>

          <section class="nb-the">
            <h2>{t.noiDungTin}</h2>
            <p class="nb-dan" style="font-size:.85rem">
              {t.noiDungPhu1}<code>[chờ duyệt]</code>{t.noiDungPhu2}
            </p>
            <label class="nb-o">
              <span>{t.moTa}</span>
              <textarea name="mo_ta_vi" rows="5">{v.mo_ta_vi ?? ''}</textarea>
            </label>
            <label class="nb-o">
              <span>{t.yeuCau}</span>
              <textarea name="yeu_cau_vi" rows="4">{v.yeu_cau_vi ?? ''}</textarea>
            </label>
            <label class="nb-o">
              <span>{t.quyenLoi}</span>
              <small>{t.khongBatBuoc}</small>
              <textarea name="quyen_loi_vi" rows="4">{v.quyen_loi_vi ?? ''}</textarea>
            </label>

            <details class="nb-tieng-anh" open={dangCho.size > 0}>
              <summary>{t.banDichTom}</summary>
              <p class="nb-dan" style="font-size:.85rem">{t.banDichPhu}</p>
              {([['en', t.tiengAnh], ['ko', t.tiengHan]] as const).map(([l, tenNgonNgu]) => (
                <fieldset class="nb-ngon-ngu">
                  <legend>{tenNgonNgu}</legend>
                  {O_DICH.map(o => {
                    const ten = `${o.cot}_${l}` as const;
                    const trangThai = moTaO(tin.ban_dich?.[o.cot]?.[l], dangCho.has(`${o.cot}/${l}`), nn);
                    return (
                      <label class="nb-o">
                        <span>{o.ten[nn]} ({l.toUpperCase()})</span>
                        {o.dong === 1
                          ? <input type="text" name={ten} lang={l} maxlength={o.cot === 'ten' ? 120 : undefined}
                                   value={v[ten] ?? ''} />
                          : <textarea name={ten} rows={o.dong} lang={l}>{v[ten] ?? ''}</textarea>}
                        {/* Chữ lúc mở màn hình — lib/tin-tuyen-dung.ts so với nó để biết ô nào được sửa tay. */}
                        <input type="hidden" name={`goc_${ten}`} value={tin[ten] ?? ''} />
                        {trangThai && <small class={`nb-dich ${trangThai.lop}`}>{trangThai.chu}</small>}
                      </label>
                    );
                  })}
                </fieldset>
              ))}
            </details>
          </section>

          <section class="nb-the">
            <h2>{t.luongDeXuat}</h2>
            <p class="nb-dan" style="font-size:.85rem">
              {t.dangHien}<strong>{luongDangHien ?? t.chuaCoLuong}</strong>{duocDuyetLuong ? t.luongPhuDuyet : t.luongPhuKhong}
            </p>
            {/* Bước 100 chứ không 1.000: lương giờ hay lẻ trăm, như 25.500 đ, mà
                trình duyệt từ chối số lệch bước. */}
            <div class="nb-hai">
              <label class="nb-o">
                <span>{t.tu}</span>
                <input type="number" name="luong_de_xuat_tu" min="0" step="100" inputmode="numeric"
                       value={v.luong_de_xuat_tu ?? ''} />
              </label>
              <label class="nb-o">
                <span>{t.den}</span>
                <input type="number" name="luong_de_xuat_den" min="0" step="100" inputmode="numeric"
                       value={v.luong_de_xuat_den ?? ''} />
              </label>
              <label class="nb-o">
                <span>{t.donVi}</span>
                <select name="luong_de_xuat_don_vi">
                  {Object.entries(DON_VI_LUONG).map(([ma, nhan]) => (
                    <option value={ma} selected={ma === donVi}>đ/{nhan[nn]}</option>
                  ))}
                </select>
              </label>
            </div>
            {nhacDonVi && <div class="nb-bao luu-y"><p>{nhacDonVi}</p></div>}
          </section>

          <section class="nb-the">
            <h2>{t.formHoi}</h2>
            <p class="nb-dan" style="font-size:.85rem">
              {t.formHoi1}<strong>{t.formHoi2}</strong>.
            </p>
            <div class="nb-truong">
              {TRUONG_FORM.map(f => (
                <label>
                  <input type="checkbox" name={f.cot} value="co" checked={v[f.cot] === true} />
                  <span>{f.ten[nn]}</span>
                </label>
              ))}
            </div>
          </section>

          {duocSoan && (
            <div class="nb-dong-nut" style="margin-bottom:1.5rem">
              <button type="submit" name="viec" value="luu" class="nb-nut">
                {dangDang ? t.luuDoiNgay
                  : tin.trang_thai === 'da_thu_hoi' ? t.luuVanGo : t.luuNhap}
              </button>
              {!dangDang && (
                <button type="submit" name="viec" value="luu_dang" class="nb-nut phu">
                  {t.luuDang}
                </button>
              )}
            </div>
          )}
        </fieldset>
      </form>

      {/* ------------------------------------------------------------ DỊCH */}
      {duocSoan && dangCho.size > 0 && (
        <form method="POST" action={duongDan} class="nb-the">
          <input type="hidden" name="viec" value="dich" />
          <h2>{t.banDich}</h2>
          <p class="nb-dan" style="font-size:.85rem">{t.conCho(dangCho.size)}</p>
          <button type="submit" class="nb-nut phu">{t.dichNgay}</button>
        </form>
      )}

      {/* -------------------------------------------------------- DUYỆT LƯƠNG */}
      {duocDuyetLuong && (
        <form method="POST" action={duongDan} class="nb-the">
          <input type="hidden" name="phien_ban" value={tin.updated_at} />
          {/* Mức đề xuất đang thấy — lần hai của cú bấm đúp so với mức trang đang hiện (duyetLuong). */}
          <input type="hidden" name="de_xuat_tu" value={tin.luong_de_xuat_tu ?? ''} />
          <input type="hidden" name="de_xuat_den" value={tin.luong_de_xuat_den ?? ''} />
          <input type="hidden" name="de_xuat_don_vi" value={tin.luong_de_xuat_don_vi ?? ''} />
          <h2>{t.duyetLuong}</h2>
          <p style="margin:0 0 .4rem">{t.deXuatDaLuu}<strong>{luongDeXuat ?? t.chuaCo}</strong></p>
          <p style="margin:0 0 .85rem">
            {t.dangHien}<strong>{luongDangHien ?? t.chuaCo}</strong>
            {tin.luong_da_duyet && tin.luong_duyet_luc && (
              <span class="nb-dan">{t.duyetLuc(gioVn(tin.luong_duyet_luc))}</span>
            )}
          </p>
          <p class="nb-dan" style="font-size:.85rem">{t.camKet}</p>
          <div class="nb-dong-nut" style="margin-top:0">
            <button type="submit" name="viec" value="duyet" class="nb-nut" disabled={!luongDeXuat}>
              {t.duyetDeXuat}
            </button>
            {tin.luong_da_duyet && (
              <button type="submit" name="viec" value="bo_duyet" class="nb-nut phu">
                {t.boDuyet}
              </button>
            )}
          </div>
        </form>
      )}

      {/* ------------------------------------------------------------ GỠ TIN */}
      {duocSoan && dangDang && (
        <form method="POST" action={duongDan} class="nb-the">
          <input type="hidden" name="viec" value="go" />
          <h2>{t.goTin}</h2>
          <p class="nb-dan" style="font-size:.85rem">{t.goTinPhu}</p>
          <button type="submit" class="nb-nut phu">{t.goKhoiTrang}</button>
        </form>
      )}
    </>
  )}
</NoiBo>

<style>
  .nb-soan fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .nb-soan h2, form.nb-the h2 { margin-top: 0; }
  .nb-hai {
    display: grid; gap: 0 1rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .nb-tieng-anh { margin-top: .25rem; }
  .nb-tieng-anh summary {
    cursor: pointer; font-weight: 600; font-size: .9rem; padding: .4rem 0 .6rem;
  }
  .nb-ngon-ngu { border: 1px solid var(--vach); border-radius: 8px; padding: .5rem .85rem .25rem; margin: 0 0 1rem; }
  .nb-ngon-ngu legend { font-weight: 700; font-size: .9rem; padding: 0 .35rem; }
  .nb-truong {
    display: grid; gap: .1rem 1rem;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
  }
  /* Vùng chạm đủ cho ngón tay cái, cùng cỡ ô tích ở màn Cài đặt. */
  .nb-truong label {
    display: flex; align-items: center; gap: .6rem;
    padding: .45rem 0; font-size: .92rem; cursor: pointer;
  }
  .nb-truong input { width: 22px; height: 22px; margin: 0; accent-color: var(--do); }
  fieldset[disabled] .nb-truong label { cursor: not-allowed; opacity: .6; }
</style>
