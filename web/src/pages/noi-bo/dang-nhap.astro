---
/**
 * ĐĂNG NHẬP NỘI BỘ
 *
 * Form HTML thuần, POST về chính trang này. Form không cần JavaScript — nên nó
 * chạy được trên mọi điện thoại, kể cả khi mạng chỉ tải xong phần HTML. (Khung
 * NoiBo in một đoạn mã nhỏ vào đầu trang cho nút Quay lại sau khi đăng xuất —
 * components/SauDangXuat.astro; tắt JavaScript thì trang này vẫn chạy đủ.)
 *
 * Khi chưa nối database thì trang này KHÔNG hiện form. Một ô đăng nhập không
 * thể đăng nhập là lời nói dối có thêm bước — cùng lý do đã rút quy tắc 4
 * trong README gốc.
 *
 * LƯỢT POST KHÔNG BAO GIỜ DỰNG TRANG (rà soát vòng bốn của PR #188): mọi kết
 * cục là một lệnh chuyển hướng 303 — vào trong, hoặc về chính trang này bằng
 * GET; câu lỗi và email đã gõ đi qua một cookie ngắn hạn (lib/phien.ts,
 * guiFormDangNhap). Trang dựng trong trả lời của lượt POST thì mục lịch sử của
 * nó giữ nguyên thân form, cả mật khẩu. Cùng lý do: ô mật khẩu không bao giờ
 * được điền lại, và đoạn mã cuối trang xóa nó lúc rời trang — trình duyệt giữ
 * trang vừa rời trong bộ nhớ quay lại (bfcache) cùng chữ đã gõ, bấm Quay lại là
 * hiện lại nguyên ô đó. Đoạn mã đứng ngoài nhánh "có database" để bản build
 * không database (kiem-tra/trinh-duyet.mjs) cũng có mà thử.
 */
import NoiBo from '../../layouts/NoiBo.astro';
import { layPhien, coDatabase, guiFormDangNhap, docLoiDangNhap, LOI_DANG_NHAP } from '../../lib/phien';
import { dichNB, nnCua } from '../../lib/ngon-ngu-noi-bo';
import { dichCau } from '../../lib/cau-noi-bo';

const nn = nnCua(Astro);
const t = dichNB(nn, {
  tieuDe:     { vi: 'Đăng nhập',                        en: 'Log in' },
  h1:         { vi: 'Đăng nhập nội bộ',                 en: 'Staff login' },
  chuaNoi:    { vi: 'Chưa nối database.',               en: 'No database connected.' },
  chuaNoi1:   { vi: 'Giao diện nội bộ cần một project Supabase đã chạy xong toàn bộ migration trong ',
                en: 'The internal app needs a Supabase project with every migration in ' },
  chuaNoi1b:  { vi: '.', en: ' already applied.' },
  chuaNoi2:   { vi: 'Đặt', en: 'Set' },
  va:         { vi: 'và', en: 'and' },
  trong:      { vi: 'trong', en: 'in' },
  chuaNoi3:   { vi: 'rồi tải lại trang này.', en: 'then reload this page.' },
  chuaNoi4:   { vi: 'Trang công khai vẫn chạy bình thường mà không cần bước này — nó được thiết kế để đúng và đủ ngay cả khi chưa có database nào.',
                en: 'The public site keeps working without this step — it is designed to be correct and complete even with no database.' },
  dan:        { vi: 'Tài khoản do chủ nhà hàng tạo trong Supabase và nối với một dòng trong bảng ',
                en: 'Accounts are created by the owner in Supabase and linked to a row in the ' },
  dan2:       { vi: '. Không có đường tự đăng ký.', en: ' table. There is no self sign-up.' },
  matKhau:    { vi: 'Mật khẩu',                         en: 'Password' },
  dangNhap:   { vi: 'Đăng nhập',                        en: 'Log in' },
  veCongKhai: { vi: '← Về trang công khai',             en: '← Back to the public site' },
});

if (Astro.request.method === 'POST') {
  // Kho là việc hằng ngày của quản lý và chủ (chủ nhà hàng chọn): vào thẳng
  // "Hôm nay" của kho. Vai chỉ kho đã được /noi-bo chuyển tiếp như cũ.
  if (await guiFormDangNhap(Astro.cookies, Astro.request)) return Astro.redirect('/noi-bo/kho', 303);
  return Astro.redirect('/noi-bo/dang-nhap', 303);
}

// Câu lỗi của lần gửi vừa rồi — đọc một lần (đọc là xóa), kể cả khi ngay dưới
// đây chuyển thẳng vào trong. Trang mang câu lỗi và email của MỘT lần gửi thì
// không để bộ đệm giữ: Quay lại / Tiến về đây là xin lại form trống.
const daGui = Astro.request.method === 'GET' ? docLoiDangNhap(Astro.cookies) : null;
if (daGui) Astro.response.headers.set('cache-control', 'no-store');

// Đã đăng nhập rồi thì đi thẳng vào trong, không hiện lại form. Supabase bận
// (layPhien trả QUA_TAI) cũng vào trong: phiên còn nguyên, và trang trong tự
// tải lại khi hết bận — hiện form ở đây là mời người ta đăng nhập thêm lượt nữa.
if (Astro.request.method === 'GET' && coDatabase()) {
  if (await layPhien(Astro.cookies)) return Astro.redirect('/noi-bo', 302);
}

const loi = daGui && dichCau(nn, LOI_DANG_NHAP[daGui.ma]);
const noiDuoc = coDatabase();
---
<NoiBo tieuDe={t.tieuDe}>
  <h1>{t.h1}</h1>

  {!noiDuoc ? (
    <div class="nb-bao luu-y">
      <p><strong>{t.chuaNoi}</strong></p>
      <p>
        {t.chuaNoi1}<code>crm/supabase/migrations/</code>{t.chuaNoi1b}
        {' '}{t.chuaNoi2}{' '}<code>PUBLIC_SUPABASE_URL</code>{' '}{t.va}{' '}
        <code>PUBLIC_SUPABASE_ANON_KEY</code>{' '}{t.trong}{' '}<code>web/.env</code>,
        {' '}{t.chuaNoi3}
      </p>
      <p>{t.chuaNoi4}</p>
    </div>
  ) : (
    <>
      <p class="nb-dan">
        {t.dan}<code>nhan_su</code>{t.dan2}
      </p>

      {loi && <div class="nb-bao loi"><p>{loi}</p></div>}

      <form method="POST" class="nb-the">
        <label class="nb-o">
          <span>Email</span>
          <input
            type="email" name="email" required autocomplete="username"
            autocapitalize="off" autocorrect="off" spellcheck="false"
            inputmode="email" value={daGui?.email || undefined}
          />
        </label>
        <label class="nb-o">
          <span>{t.matKhau}</span>
          <input type="password" name="mat_khau" required autocomplete="current-password" />
        </label>
        <button type="submit" class="nb-nut" style="width:100%">{t.dangNhap}</button>
      </form>
    </>
  )}

  <p class="nb-dan" style="margin-top:2rem">
    <a href="/">{t.veCongKhai}</a>
  </p>
  <script is:inline>
    window.addEventListener('pagehide', function () {
      var o = document.querySelectorAll('input[type="password"]');
      for (var i = 0; i < o.length; i++) o[i].value = '';
    });
  </script>
</NoiBo>
