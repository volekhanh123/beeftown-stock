---
/**
 * HỘP THƯ HỒ SƠ ỨNG TUYỂN
 *
 * Đây là dữ liệu cá nhân của NGƯỜI CHƯA PHẢI KHÁCH HÀNG, thuộc phạm vi Nghị
 * định 13/2023. Ba điều được giữ nguyên từ thiết kế database, không nới ra ở
 * tầng giao diện:
 *
 *   · Chỉ chủ nhà hàng và quản lý xem được. Marketing chỉ xem được SỐ, qua
 *     thong_ke_tuyen_dung(). RLS đã cưỡng chế; middleware chỉ tránh cho người
 *     không có quyền nhìn thấy một trang trống khó hiểu.
 *   · Không có nút xóa. Hết hạn lưu thì ẩn danh, giữ lại dòng để số liệu
 *     phễu và vết kiểm toán còn nguyên.
 *   · Mọi lần đổi trạng thái ghi vào nhat_ky_ho_so, và nhật ký đó bất biến.
 *
 * Số điện thoại hiện đầy đủ và bấm gọi được — đó chính là việc cần làm với
 * một hồ sơ, và che nó đi chỉ tạo thêm một bước sao chép thủ công.
 *
 * Bấm nút xong thì chuyển hướng 303 về chính trang này (lib/gui-noi-bo.ts) — F5
 * không gửi lại lệnh cũ. Lần hai của cú bấm đúp thấy hồ sơ đã ở trạng thái đích:
 * báo "đã ở …", không báo "người khác đã xử lý".
 */
import NoiBo from '../../layouts/NoiBo.astro';
import { dinhDangNgay } from '../../lib/noi-dung';
import { dichNB, nhanNB, nnCua, type HaiThuTieng } from '../../lib/ngon-ngu-noi-bo';
import { dichCau } from '../../lib/cau-noi-bo';
import { CAU_DOC_FORM_HONG, chuyenHuongNoiBo, chuyenTrangThai, docBaoNoiBo, docFormNoiBo, type BaoNoiBo } from '../../lib/gui-noi-bo';

const phien = Astro.locals.phien!;
const { client, nhanSu } = phien;
const nn = nnCua(Astro);

const TEN_TRANG_THAI: Record<string, HaiThuTieng> = {
  moi:           { vi: 'Chưa ai mở',               en: 'Not opened yet' },
  dang_xem:      { vi: 'Đang xem',                 en: 'Reviewing' },
  hen_phong_van: { vi: 'Đã hẹn phỏng vấn',         en: 'Interview scheduled' },
  da_phong_van:  { vi: 'Đã phỏng vấn',             en: 'Interviewed' },
  nhan_viec:     { vi: 'Nhận việc',                en: 'Hired' },
  tu_choi:       { vi: 'Từ chối',                  en: 'Rejected' },
  ung_vien_rut:  { vi: 'Ứng viên rút',             en: 'Candidate withdrew' },
  da_an_danh:    { vi: 'Đã ẩn danh (hết hạn lưu)', en: 'Anonymised (retention ended)' },
};

// Mã ca trong ho_so_ung_tuyen.ca_lam_duoc — cùng bốn mã với form công khai.
const TEN_CA: Record<string, HaiThuTieng> = {
  sang:      { vi: 'Ca sáng',   en: 'Morning' },
  chieu:     { vi: 'Ca chiều',  en: 'Afternoon' },
  toi:       { vi: 'Ca tối',    en: 'Evening' },
  cuoi_tuan: { vi: 'Cuối tuần', en: 'Weekends' },
};

const t = dichNB(nn, {
  tieuDe:     { vi: 'Tuyển dụng', en: 'Hiring' },
  h1:         { vi: 'Hồ sơ ứng tuyển', en: 'Job applications' },
  dan1:       { vi: 'Đây là thông tin cá nhân của người chưa phải khách hàng. Beeftown cam kết với họ là lưu ',
                en: 'This is personal data of people who are not customers. Beeftown promised them to keep it for ' },
  sauThang:   { vi: 'sáu tháng', en: 'six months' },
  dan2:       { vi: ' và chỉ dùng cho tuyển dụng.', en: ' and use it only for hiring.' },
  dan3:       { vi: 'Form của từng tin hỏi những gì — có hỏi CV hay không — chỉnh ở ',
                en: 'What each posting\'s form asks — including whether it asks for a CV — is set in ' },
  tinTD:      { vi: 'Tin tuyển dụng', en: 'Job postings' },
  sai:        { vi: 'Bước chuyển không hợp lệ.', en: 'That status change is not allowed.' },
  daXuLy:     { vi: 'Hồ sơ đã được người khác xử lý. Tải lại trang để xem trạng thái mới.',
                en: 'Someone else already handled this application. Reload the page to see its new status.' },
  daChuyen:   { vi: (ten: string) => `Đã chuyển sang "${ten}".`, en: (ten: string) => `Moved to "${ten}".` },
  daO:        { vi: (ten: string) => `Hồ sơ đã ở "${ten}".`, en: (ten: string) => `This application is already at "${ten}".` },
  khongDoc:   { vi: 'Không đọc được danh sách.', en: 'Could not read the list.' },
  locMoi:     { vi: 'Chưa ai mở', en: 'Not opened' },
  locDang:    { vi: 'Đang xử lý', en: 'In progress' },
  locTatCa:   { vi: 'Tất cả', en: 'All' },
  rong:       { vi: 'Không có hồ sơ nào trong mục này.', en: 'No applications in this view.' },
  rong1:      { vi: 'Trống cũng có thể nghĩa là cổng nộp hồ sơ chưa bật. Kiểm tra công tắc ',
                en: 'Empty can also mean the application form is not switched on. Check the switch ' },
  rong2:      { vi: ' và xem ở ', en: ' and check in ' },
  rong3:      { vi: ' đã có tin nào đang đăng chưa.', en: ' whether any posting is live.' },
  anDanh:     { vi: '(đã ẩn danh)', en: '(anonymised)' },
  viTri:      { vi: 'Vị trí', en: 'Position' },
  dienThoai:  { vi: 'Điện thoại', en: 'Phone' },
  namSinh:    { vi: 'Năm sinh', en: 'Year of birth' },
  caLam:      { vi: 'Ca làm được', en: 'Available shifts' },
  ngayNop:    { vi: 'Ngày nộp', en: 'Applied on' },
  luuDen:     { vi: 'Lưu đến', en: 'Kept until' },
  ma:         { vi: 'Mã', en: 'Code' },
  cv1:        { vi: 'Có đính kèm CV — mở trong Supabase Storage tại ', en: 'CV attached — open it in Supabase Storage at ' },
  cv2:        { vi: '. Màn hình xem CV chưa làm; tệp nằm trong bucket riêng tư, không có đường dẫn công khai.',
                en: '. There is no CV viewer yet; the file is in a private bucket with no public link.' },
  ghiChu:     { vi: 'Ghi chú (vào nhật ký, không sửa lại được)', en: 'Note (goes into the log, cannot be edited later)' },
});

// Bước đi tiếp từ mỗi trạng thái. da_an_danh không có bước nào — dòng đó đã
// không còn thông tin để làm gì nữa. Nút mang tên trạng thái đích.
const CHUYEN_DUOC: Record<string, { toi: string; phu?: boolean }[]> = {
  moi: [
    { toi: 'dang_xem' },
    { toi: 'tu_choi', phu: true },
  ],
  dang_xem: [
    { toi: 'hen_phong_van' },
    { toi: 'tu_choi', phu: true },
    { toi: 'ung_vien_rut', phu: true },
  ],
  hen_phong_van: [
    { toi: 'da_phong_van' },
    { toi: 'ung_vien_rut', phu: true },
  ],
  da_phong_van: [
    { toi: 'nhan_viec' },
    { toi: 'tu_choi', phu: true },
  ],
};

let bao: BaoNoiBo | null = docBaoNoiBo(Astro.cookies);

if (Astro.request.method === 'POST') {
  const form = await docFormNoiBo(Astro.request);
  const id = String(form?.get('id') ?? '');
  const tu = String(form?.get('tu') ?? '');
  const toi = String(form?.get('toi') ?? '');
  const ghiChu = String(form?.get('ghi_chu') ?? '').trim() || null;

  if (!form) {
    bao = { ok: false, cau: CAU_DOC_FORM_HONG[nn] };
  } else if (!id || !CHUYEN_DUOC[tu]?.some(b => b.toi === toi)) {
    bao = { ok: false, cau: t.sai };
  } else {
    // MỘT câu UPDATE, MỘT dòng nhật ký.
    //
    // Bản trước chạy UPDATE rồi chèn thêm một dòng nhat_ky_ho_so. Nhưng
    // trigger ho_so_kiem_tra_vong_doi() ĐÃ tự ghi một dòng khi trạng thái
    // đổi — nên mỗi bước chuyển sinh ra hai dòng, và nhật ký là bảng bất
    // biến nên dòng thừa không bao giờ dọn được.
    //
    // Từ 0016, ghi chú đi kèm trong chính câu UPDATE qua cột ghi_chu_buoc,
    // trigger đọc nó. Bảng nhat_ky_ho_so giờ có policy INSERT là false —
    // chèn tay từ đây sẽ lỗi, đúng như thiết kế.
    //
    // Chỉ đổi khi trạng thái vẫn như lúc tải trang — chống hai người cùng bấm,
    // như hộp thư đặt bàn (chuyenTrangThai).
    const kq = await chuyenTrangThai(client, 'ho_so_ung_tuyen', id, tu, toi,
      { nguoi_phu_trach: nhanSu.id, ghi_chu_buoc: ghiChu });
    const ten = nhanNB(TEN_TRANG_THAI, toi, nn);
    if (kq === 'da_chuyen') return chuyenHuongNoiBo(Astro, { ok: true, cau: t.daChuyen(ten) });
    if (kq === 'da_o_san') return chuyenHuongNoiBo(Astro, { ok: true, cau: t.daO(ten) });
    bao = kq === 'nguoi_khac' ? { ok: false, cau: t.daXuLy } : { ok: false, cau: dichCau(nn, kq.loi) };
  }
}

const loc = String(Astro.url.searchParams.get('loc') ?? 'moi');

let dsLoi: string | null = null;
let ds: any[] = [];
try {
  let q = client
    .from('ho_so_ung_tuyen')
    .select('id, ma_ho_so, ho_ten, sdt, email, nam_sinh, gioi_thieu, kinh_nghiem, ca_lam_duoc, duong_dan_cv, trang_thai, ngay_nop, luu_den, da_an_danh, vi_tri_tuyen_dung(ten_vi, ten_en, bo_phan)')
    .order('created_at', { ascending: false })
    .limit(100);

  if (loc === 'moi') q = q.eq('trang_thai', 'moi');
  else if (loc === 'dang_xu_ly') q = q.in('trang_thai', ['dang_xem', 'hen_phong_van', 'da_phong_van']);

  const { data, error } = await q;
  if (error) dsLoi = dichCau(nn, error.message);
  else ds = data ?? [];
} catch (e) {
  dsLoi = e instanceof Error ? dichCau(nn, e.message) : t.khongDoc;
}

const BO_LOC = [
  { ma: 'moi', ten: t.locMoi },
  { ma: 'dang_xu_ly', ten: t.locDang },
  { ma: 'tat_ca', ten: t.locTatCa },
];
---
<NoiBo tieuDe={t.tieuDe} nhanSu={nhanSu}>
  <h1>{t.h1}</h1>
  <p class="nb-dan">
    {t.dan1}<strong>{t.sauThang}</strong>{t.dan2}
  </p>
  <p class="nb-dan" style="font-size:.85rem">
    {t.dan3}<a href="/noi-bo/tin-tuyen-dung">{t.tinTD}</a>.
  </p>

  {bao && <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`}><p>{bao.cau}</p></div>}
  {dsLoi && <div class="nb-bao loi"><p>{dsLoi}</p></div>}

  <div class="nb-dong-nut" style="margin-bottom:1.25rem">
    {BO_LOC.map(b => (
      <a href={`/noi-bo/tuyen-dung?loc=${b.ma}`}
         class={`nb-nut ${loc === b.ma ? '' : 'phu'}`}
         style="font-size:.85rem;padding:.55rem .85rem;min-height:42px">{b.ten}</a>
    ))}
  </div>

  {ds.length === 0 && !dsLoi && (
    <div class="nb-rong">
      <p style="margin:0">{t.rong}</p>
      <p style="margin:.5rem 0 0;font-size:.85rem">
        {t.rong1}<a href="/noi-bo/noi-dung"><code>hien_tuyen_dung</code></a>{t.rong2}<a href="/noi-bo/tin-tuyen-dung">{t.tinTD}</a>{t.rong3}
      </p>
    </div>
  )}

  {ds.map(h => {
    const vt = Array.isArray(h.vi_tri_tuyen_dung) ? h.vi_tri_tuyen_dung[0] : h.vi_tri_tuyen_dung;
    const buoc = CHUYEN_DUOC[h.trang_thai] ?? [];
    return (
      <div class="nb-dong">
        <div class="nb-dong-dau">
          <strong>{h.da_an_danh ? t.anDanh : h.ho_ten}</strong>
          <span class={`nb-nhan ${h.trang_thai === 'moi' ? 'cho'
                        : h.trang_thai === 'nhan_viec' ? 'song' : 'tat'}`}>
            {nhanNB(TEN_TRANG_THAI, h.trang_thai, nn)}
          </span>
        </div>

        <dl>
          <dt>{t.viTri}</dt>
          <dd>{(nn === 'en' && vt?.ten_en) || vt?.ten_vi || '—'}</dd>
          {!h.da_an_danh && h.sdt && <><dt>{t.dienThoai}</dt><dd><a href={`tel:${h.sdt}`}>{h.sdt}</a></dd></>}
          {!h.da_an_danh && h.email && <><dt>Email</dt><dd><a href={`mailto:${h.email}`}>{h.email}</a></dd></>}
          {h.nam_sinh && <><dt>{t.namSinh}</dt><dd>{h.nam_sinh}</dd></>}
          {h.ca_lam_duoc?.length > 0 && <><dt>{t.caLam}</dt><dd>{h.ca_lam_duoc.map((c: string) => nhanNB(TEN_CA, c, nn)).join(', ')}</dd></>}
          <dt>{t.ngayNop}</dt>
          <dd>{dinhDangNgay(h.ngay_nop, nn)}</dd>
          <dt>{t.luuDen}</dt>
          <dd>{dinhDangNgay(h.luu_den, nn)}</dd>
          <dt>{t.ma}</dt>
          <dd><code>{h.ma_ho_so}</code></dd>
        </dl>

        {h.gioi_thieu && <p style="margin:.75rem 0 0;font-size:.9rem">{h.gioi_thieu}</p>}
        {h.kinh_nghiem && <p style="margin:.4rem 0 0;font-size:.9rem;color:var(--muc-nhat)">{h.kinh_nghiem}</p>}

        {h.duong_dan_cv && (
          <p style="margin:.6rem 0 0;font-size:.85rem">
            {t.cv1}<code>{h.duong_dan_cv}</code>{t.cv2}
          </p>
        )}

        {buoc.length > 0 && (
          <form method="POST" style="margin-top:.85rem">
            <input type="hidden" name="id" value={h.id} />
            <input type="hidden" name="tu" value={h.trang_thai} />
            <label class="nb-o" style="margin-bottom:.6rem">
              <span>{t.ghiChu}</span>
              <input type="text" name="ghi_chu" autocapitalize="sentences" />
            </label>
            <div class="nb-dong-nut" style="margin-top:0">
              {buoc.map(b => (
                <button type="submit" name="toi" value={b.toi}
                        class={`nb-nut ${b.phu ? 'phu' : ''}`}>{nhanNB(TEN_TRANG_THAI, b.toi, nn)}</button>
              ))}
            </div>
          </form>
        )}
      </div>
    );
  })}
</NoiBo>
