---
import Trang from '../layouts/Trang.astro';
import TrangDenBeeftown from '../components/TrangDenBeeftown.astro';
import { docNoiDung } from '../lib/noi-dung';

const noiDung = await docNoiDung('vi');
---
<Trang
  ngonNgu="vi"
  noiDung={noiDung}
  duongDan="/den-beeftown"
  tieuDe="Đến Beeftown — Tầng 3, 63 Hồ Tùng Mậu"
  moTa="Beeftown ở tầng 3, 63 Hồ Tùng Mậu, TP.HCM. Lối vào riêng ngay cạnh GS25, đi thang máy lên tầng 3."
>
  <TrangDenBeeftown ngonNgu="vi" noiDung={noiDung} />
</Trang>
