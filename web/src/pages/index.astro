---
import Trang from '../layouts/Trang.astro';
import TrangRaMat from '../components/TrangRaMat.astro';
import { docNoiDung } from '../lib/noi-dung';

const noiDung = await docNoiDung('vi');
---
<Trang ngonNgu="vi" noiDung={noiDung} duongDan="/">
  <TrangRaMat ngonNgu="vi" noiDung={noiDung} />
</Trang>
