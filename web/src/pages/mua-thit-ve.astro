---
/* Trang Mua thịt về — vỏ: nhận POST đặt hàng (lib/xu-ly-form.ts: ghi đơn rồi chuyển hướng 303 về đây), đọc nội dung
   và menu song song, tính trạng thái trang rồi giao cho TrangMuaThitVe. Trạng thái theo công tắc HIỆU LỰC của
   database (muaThitVeMo, lib/dich-dat-hang.ts) và menu đọc được; chưa nối database thì trang vẫn dựng được, ở trạng
   thái "chưa mở". duongDan là chuỗi cố định: canonical và hreflang không mang chuỗi truy vấn của giỏ. Sửa bản này
   thì sửa cả /en/buy-meat và /ko/buy-meat. */
import Trang from '../layouts/Trang.astro';
import TrangMuaThitVe from '../components/TrangMuaThitVe.astro';
import { docNoiDung } from '../lib/noi-dung';
import { docMuaThitVe, trangThaiMuaThit } from '../lib/mua-thit-ve';
import { muaThitVeMo } from '../lib/dich-dat-hang';
import { moTaTrangMuaThit } from '../lib/trang-cong-khai';
import { xuLyDatHang, ketQuaDatHang, vnpayChoTrang } from '../lib/xu-ly-form';

const chuyenHuong = await xuLyDatHang(Astro, '/mua-thit-ve', 'vi');
if (chuyenHuong) return chuyenHuong;

const [noiDung, menu, vnpay] = await Promise.all([docNoiDung('vi'), docMuaThitVe('vi'), vnpayChoTrang(Astro, 'vi')]);
const trangThai = trangThaiMuaThit(muaThitVeMo(noiDung), menu);
const ketQua = ketQuaDatHang(Astro, 'vi');
---
<Trang ngonNgu="vi" noiDung={noiDung} duongDan="/mua-thit-ve" tieuDe="Mua thịt về — Beeftown"
       moTa={moTaTrangMuaThit('vi', trangThai === 'mo' || trangThai === 'het_quay')}>
  <TrangMuaThitVe ngonNgu="vi" noiDung={noiDung} menu={menu} trangThai={trangThai} ketQua={ketQua}
                  thamSo={[...Astro.url.searchParams]} duongDan="/mua-thit-ve"
                  traVnpay={vnpay !== null} />
</Trang>
