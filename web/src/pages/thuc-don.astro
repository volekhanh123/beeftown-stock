---
import Trang from '../layouts/Trang.astro';
import TrangThucDon from '../components/TrangThucDon.astro';
import { docNoiDung } from '../lib/noi-dung';
import { docThucDon } from '../lib/thuc-don';
import { docBoTheoGu } from '../lib/chon-theo-gu';

const [noiDung, thucDon, theoGu] = await Promise.all([docNoiDung('vi'), docThucDon('vi'), docBoTheoGu('vi')]);
---
<Trang
  ngonNgu="vi"
  noiDung={noiDung}
  duongDan="/thuc-don"
  tieuDe="Thực đơn — Beeftown"
  moTa="Thực đơn Beeftown: bò chọn theo khay tại quầy, cùng món ăn và đồ uống cho cả bàn. Tầng 3, 63 Hồ Tùng Mậu, TP.HCM."
>
  <TrangThucDon ngonNgu="vi" noiDung={noiDung} thucDon={thucDon} theoGu={theoGu} />
</Trang>
