---
import Trang from '../layouts/Trang.astro';
import TrangTuyenDung from '../components/TrangTuyenDung.astro';
import { docNoiDung } from '../lib/noi-dung';
import { docViTri } from '../lib/tuyen-dung';

const noiDung = await docNoiDung('vi');
const viTri = await docViTri('vi');
---
<Trang
  ngonNgu="vi"
  noiDung={noiDung}
  duongDan="/tuyen-dung"
  tieuDe="Tuyển dụng — Beeftown"
  moTa="Beeftown đang tuyển nhân viên sảnh, bếp, bộ phận thịt và quầy tư vấn cho ngày mở cửa tại Quận 1, TP.HCM."
>
  <TrangTuyenDung ngonNgu="vi" noiDung={noiDung} viTri={viTri} />
</Trang>
