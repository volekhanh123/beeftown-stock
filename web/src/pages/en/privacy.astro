---
import Trang from '../../layouts/Trang.astro';
import { docNoiDung } from '../../lib/noi-dung';
const nd = await docNoiDung('en');
---
<Trang ngonNgu="en" noiDung={nd} duongDan="/en/privacy"
       tieuDe="Privacy — Beeftown"
       moTa="How Beeftown collects, uses and stores personal information.">
  <section class="muc" style="padding-top:20px">
    <div class="khung" style="max-width:68ch">
      <p class="hieu">Privacy</p>
      <h1 style="font-size:clamp(30px,5vw,48px)">How Beeftown handles your information</h1>

      <h2 style="font-size:24px; margin-top:40px">What we collect</h2>
      <p>When you send a table request or a job application, Beeftown stores your
        name, phone number and whatever else you choose to enter. The website
        records page views and button clicks, but <strong>does not store IP
        addresses</strong> and uses no third-party analytics.</p>

      <h2 style="font-size:24px; margin-top:34px">What we use it for</h2>
      <p>Booking details are used so the restaurant can call to confirm. Job
        applications are used to arrange a meeting. We only send news about dishes
        or events if you <strong>tick the box yourself</strong> — that box is never
        pre-ticked, and leaving it unticked does not affect your booking.</p>

      <h2 style="font-size:24px; margin-top:34px">How long we keep it</h2>
      <p>Job applications are kept for <strong>six months</strong> from the date you
        apply, after which name, phone, email and CV file are erased. Website
        measurement data is deleted after 90 days.</p>

      <h2 style="font-size:24px; margin-top:34px">Your rights</h2>
      <p>You can ask to see, correct or delete your information, and you can opt out
        of messages at any time.
        {nd.email_lien_he
          ? <>Write to <a href={`mailto:${nd.email_lien_he}`}>{nd.email_lien_he}</a>.</>
          : <>Contact details will be published here when the restaurant opens.</>}
      </p>

      <p class="nho" style="margin-top:34px">In line with Decree 13/2023/ND-CP on
        personal data protection (Vietnam).</p>
    </div>
  </section>
</Trang>
