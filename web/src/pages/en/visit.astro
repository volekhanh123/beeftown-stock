---
import Trang from '../../layouts/Trang.astro';
import TrangDenBeeftown from '../../components/TrangDenBeeftown.astro';
import { docNoiDung } from '../../lib/noi-dung';

const noiDung = await docNoiDung('en');
---
<Trang
  ngonNgu="en"
  noiDung={noiDung}
  duongDan="/en/visit"
  tieuDe="Visit Beeftown — 63 Hồ Tùng Mậu, Former District 1, HCMC"
  moTa="Beeftown is on Floor 3, 63 Hồ Tùng Mậu, former District 1, Ho Chi Minh City. Use our own entrance, right next to GS25, and take the lift to Floor 3."
>
  <TrangDenBeeftown ngonNgu="en" noiDung={noiDung} />
</Trang>
