---
import Trang from '../../layouts/Trang.astro';
import TrangDenBeeftown from '../../components/TrangDenBeeftown.astro';
import { docNoiDung } from '../../lib/noi-dung';

const noiDung = await docNoiDung('en');
---
<Trang
  ngonNgu="en"
  noiDung={noiDung}
  duongDan="/en/visit"
  tieuDe="Visit Beeftown — Floor 3, 63 Hồ Tùng Mậu"
  moTa="Beeftown is on Floor 3, 63 Hồ Tùng Mậu, Ho Chi Minh City. Use our own entrance, right next to GS25, and take the lift to Floor 3."
>
  <TrangDenBeeftown ngonNgu="en" noiDung={noiDung} />
</Trang>
