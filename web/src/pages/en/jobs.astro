---
import Trang from '../../layouts/Trang.astro';
import TrangTuyenDung from '../../components/TrangTuyenDung.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { docViTri } from '../../lib/tuyen-dung';
import { xuLyUngTuyen, ketQuaUngTuyen } from '../../lib/xu-ly-form';

const noiDung = await docNoiDung('en');
const viTri = await docViTri('en');

// POST tới chính đường dẫn này = một lượt nộp hồ sơ. Xử lý xong thì chuyển
// hướng, nên bấm F5 không gửi lại lần nữa.
const chuyenHuong = await xuLyUngTuyen(Astro, '/en/jobs', 'en');
if (chuyenHuong) return chuyenHuong;

const ketQuaNop = ketQuaUngTuyen(Astro, 'en');
---
<Trang
  ngonNgu="en"
  noiDung={noiDung}
  duongDan="/en/jobs"
  tieuDe="Careers — Beeftown"
  moTa="Beeftown is building its opening team in District 1, Ho Chi Minh City: Skilled Beef Trimmer, Butcher Packaging & Counter Assistant, Experienced Kitchen Crew and part-time Hall Crew."
>
  <TrangTuyenDung ngonNgu="en" noiDung={noiDung} viTri={viTri} ketQuaNop={ketQuaNop} />
</Trang>
