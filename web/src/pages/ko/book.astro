---
import Trang from '../../layouts/Trang.astro';
import TrangDatBan from '../../components/TrangDatBan.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { tinhTrangDatBan } from '../../lib/dat-ban';
import { xuLyDatBan, ketQuaDatBan } from '../../lib/xu-ly-form';

const chuyenHuong = await xuLyDatBan(Astro, '/ko/book', 'ko');
if (chuyenHuong) return chuyenHuong;

const noiDung = await docNoiDung('ko');
const ketQua = ketQuaDatBan(Astro, 'ko');
const tinhTrang = await tinhTrangDatBan(
  Astro.url.searchParams.get('ngay'),
  noiDung.form_dat_ban_dang_mo,
);
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/book"
  tieuDe="테이블 문의 — Beeftown"
  moTa="호치민시 Hồ Tùng Mậu 63, 3층에 있는 소고기 전문점 Beeftown에 테이블 문의를 보내 주세요. 매장에서 확인한 뒤 전화드려요."
>
  <TrangDatBan
    ngonNgu="ko"
    noiDung={noiDung}
    tinhTrang={tinhTrang}
    ketQua={ketQua}
    duongDan="/ko/book"
  />
</Trang>
