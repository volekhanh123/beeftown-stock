---
import Trang from '../../layouts/Trang.astro';
import TrangThucDon from '../../components/TrangThucDon.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { docThucDon } from '../../lib/thuc-don';
import { docBoTheoGu } from '../../lib/chon-theo-gu';

const [noiDung, thucDon, theoGu] = await Promise.all([docNoiDung('ko'), docThucDon('ko'), docBoTheoGu('ko')]);
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/menu"
  tieuDe="Beeftown 메뉴 — 호치민 소고기 구이, 정육 코너에서 고르기"
  moTa="정육 코너에서 트레이에 담긴 소고기를 골라 테이블에서 구워 먹어요. 곁들일 요리와 음료도 있어요. Beeftown은 호치민시 구 1군 Hồ Tùng Mậu 63, 3층에 있어요."
>
  <TrangThucDon ngonNgu="ko" noiDung={noiDung} thucDon={thucDon} theoGu={theoGu} />
</Trang>
