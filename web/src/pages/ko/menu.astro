---
import Trang from '../../layouts/Trang.astro';
import TrangThucDon from '../../components/TrangThucDon.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { docThucDon } from '../../lib/thuc-don';

const [noiDung, thucDon] = await Promise.all([docNoiDung('ko'), docThucDon('ko')]);
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/menu"
  tieuDe="메뉴 — Beeftown"
  moTa="Beeftown 메뉴: 정육 코너에서 트레이로 고르는 소고기와 테이블에서 함께 나누는 요리, 음료. 호치민시 Hàm Nghi 11-21, 3층."
>
  <TrangThucDon ngonNgu="ko" noiDung={noiDung} thucDon={thucDon} />
</Trang>
