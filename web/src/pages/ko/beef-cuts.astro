---
import Trang from '../../layouts/Trang.astro';
import TrangPhanBo from '../../components/TrangPhanBo.astro';
import { docNoiDung } from '../../lib/noi-dung';

const noiDung = await docNoiDung('ko');
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/beef-cuts"
  tieuDe="소고기 부위: 꽃등심, 갈비살, 안창살 — Beeftown"
  moTa="꽃등심, 갈비살, 안창살, 윗등심, 부채살. 각 부위가 소의 어디에 있는지, 어떤 맛과 식감인지, 테이블 가스 그릴에서 어떻게 구우면 좋은지 알려 드려요."
>
  <TrangPhanBo ngonNgu="ko" noiDung={noiDung} />
</Trang>
