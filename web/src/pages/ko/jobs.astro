---
import Trang from '../../layouts/Trang.astro';
import TrangTuyenDung from '../../components/TrangTuyenDung.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { docViTri } from '../../lib/tuyen-dung';
import { xuLyUngTuyen, ketQuaUngTuyen } from '../../lib/xu-ly-form';

const noiDung = await docNoiDung('ko');
const viTri = await docViTri('ko');

// POST tới chính đường dẫn này = một lượt nộp hồ sơ. Xử lý xong thì chuyển
// hướng, nên bấm F5 không gửi lại lần nữa.
const chuyenHuong = await xuLyUngTuyen(Astro, '/ko/jobs', 'ko');
if (chuyenHuong) return chuyenHuong;

const ketQuaNop = ketQuaUngTuyen(Astro, 'ko');
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/jobs"
  tieuDe="채용 — Beeftown"
  moTa="Beeftown이 호치민시 1군 오픈 팀을 모집해요: 소고기 정육사, 포장 및 정육 코너 보조 직원, 경력 주방 직원, 파트타임 홀 직원."
>
  <TrangTuyenDung ngonNgu="ko" noiDung={noiDung} viTri={viTri} ketQuaNop={ketQuaNop} />
</Trang>
