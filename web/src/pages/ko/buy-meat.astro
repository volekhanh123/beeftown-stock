---
import Trang from '../../layouts/Trang.astro';
import TrangMuaThitVe from '../../components/TrangMuaThitVe.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { docMuaThitVe, trangThaiMuaThit } from '../../lib/mua-thit-ve';
import { muaThitVeMo } from '../../lib/dich-dat-hang';
import { moTaTrangMuaThit } from '../../lib/trang-cong-khai';
import { xuLyDatHang, ketQuaDatHang, vnpayChoTrang } from '../../lib/xu-ly-form';

const chuyenHuong = await xuLyDatHang(Astro, '/ko/buy-meat', 'ko');
if (chuyenHuong) return chuyenHuong;

const [noiDung, menu, vnpay] = await Promise.all([docNoiDung('ko'), docMuaThitVe('ko'), vnpayChoTrang(Astro, 'ko')]);
const trangThai = trangThaiMuaThit(muaThitVeMo(noiDung), menu);
const ketQua = ketQuaDatHang(Astro, 'ko');
---
<Trang ngonNgu="ko" noiDung={noiDung} duongDan="/ko/buy-meat" tieuDe="소고기 포장 구매 — Beeftown"
       moTa={moTaTrangMuaThit('ko', trangThai === 'mo' || trangThai === 'het_quay')}>
  <TrangMuaThitVe ngonNgu="ko" noiDung={noiDung} menu={menu} trangThai={trangThai} ketQua={ketQua}
                  thamSo={[...Astro.url.searchParams]} duongDan="/ko/buy-meat"
                  traVnpay={vnpay !== null} />
</Trang>
