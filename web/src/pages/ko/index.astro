---
import Trang from '../../layouts/Trang.astro';
import TrangRaMat from '../../components/TrangRaMat.astro';
import { docNoiDung } from '../../lib/noi-dung';
import { moTaTrangChu } from '../../lib/trang-cong-khai';

const noiDung = await docNoiDung('ko');
---
<Trang ngonNgu="ko" noiDung={noiDung} duongDan="/ko" moTa={moTaTrangChu(noiDung, 'ko')}>
  <TrangRaMat ngonNgu="ko" noiDung={noiDung} />
</Trang>
