---
import Trang from '../../layouts/Trang.astro';
import TrangDenBeeftown from '../../components/TrangDenBeeftown.astro';
import { docNoiDung } from '../../lib/noi-dung';

const noiDung = await docNoiDung('ko');
---
<Trang
  ngonNgu="ko"
  noiDung={noiDung}
  duongDan="/ko/visit"
  tieuDe="오시는 길 — Beeftown"
  moTa="Beeftown은 호치민시 Hàm Nghi 11-21, 3층에 있어요. 3층까지는 계단으로 올라오셔야 하고, 손님용 엘리베이터는 없어요."
>
  <TrangDenBeeftown ngonNgu="ko" noiDung={noiDung} />
</Trang>
