---
/**
 * ĐI CÙNG GIA ĐÌNH, BẠN BÈ, ĐỒNG NGHIỆP — dải đỏ
 *
 * Mời khách cho biết ngày, giờ và số người. KHÔNG hứa có bàn trống, phòng riêng
 * hay sức chứa: nhà hàng kiểm tra rồi liên hệ xác nhận (brief 06/10/2026).
 *
 * Nút theo kênh có người trả lời thật: form hỏi bàn đang mở → "Hỏi bàn"; không
 * thì Facebook / hotline / email đã công bố. Không có kênh nào → không có nút
 * (chữ vẫn đúng: nó nói khách cần cho nhà hàng biết gì).
 */
import { chu, dich, duongDanTuongUng } from '../lib/chu';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import { formHoiBanMo, lienHe } from '../lib/trang-cong-khai';
import KhungAnh from './KhungAnh.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; }
const { ngonNgu, noiDung: nd } = Astro.props;
const tChung = chu(ngonNgu);
const lh = lienHe(nd);
const nut =
  formHoiBanMo(nd) ? { url: duongDanTuongUng('/dat-ban', ngonNgu), chu: tChung.datBan, ngoai: false } :
  lh.facebook ? { url: lh.facebook, chu: tChung.nhanTin, ngoai: true } :
  lh.goi ? { url: lh.goi, chu: tChung.goiNhaHang, ngoai: false } :
  lh.thu ? { url: lh.thu, chu: tChung.guiEmail, ngoai: false } :
  null;
const t = dich(ngonNgu, {
  hieu: { vi: 'Đi đông người', en: 'Coming as a group', ko: '여럿이 함께' },
  tieuDe: { vi: 'Rủ cả nhà, cả nhóm cùng đến', en: 'Bring the family, bring the team', ko: '가족, 친구, 동료와 함께 오세요' },
  dan: {
    vi: 'Cho Beeftown biết ngày, giờ và số người. Nhà hàng sẽ kiểm tra rồi liên hệ lại để xác nhận — gửi yêu cầu chưa phải là đã giữ bàn.',
    en: 'Tell us the date, the time and how many of you are coming. We will check and get back to you to confirm — sending a request does not hold a table yet.',
    ko: '날짜, 시간, 인원을 알려 주세요. 매장에서 확인한 뒤 연락드려 확정해 드려요. 문의를 보내는 것만으로 자리가 잡히지는 않아요.',
  },
  nhom9: {
    vi: 'Nhóm từ 9 người trở lên, bạn nhắn cho Beeftown để nhà hàng sắp xếp riêng.',
    en: 'For groups of 9 or more, message us and we will arrange it with you.',
    ko: '9명 이상 단체는 Beeftown에 메시지를 보내 주세요. 매장에서 따로 조율해 드려요.',
  },
});
---
<section class="muc be-do dcn co-trang-tri" aria-labelledby="dcn-tieu-de">
  <div class="trang-tri nen-van-mo dcn-van" aria-hidden="true"></div>
  <div class="khung dcn-luoi">
    <div class="dcn-chu">
      <p class="hieu">{t.hieu}</p>
      <h2 id="dcn-tieu-de">{t.tieuDe}</h2>
      <p class="dan">{t.dan}</p>
      <p class="dcn-nho">{t.nhom9}</p>
      {nut && (
        <div class="hang-nut">
          <a class="nut nut-chinh" href={nut.url} rel={nut.ngoai ? 'noopener' : undefined}>{nut.chu}</a>
        </div>
      )}
    </div>
    <div class="dcn-hinh">
      <KhungAnh loai="ban-nuong" tiLe="4 / 3" nen="do" />
      <span class="trang-tri net huong-thao-2 dcn-la" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .dcn-van { inset: 0 0 0 58%; opacity: 1; display: none; }
  .dcn-luoi { position: relative; display: grid; gap: var(--k-7); align-items: center; grid-template-columns: 1fr; }
  .dcn-chu .dan { color: var(--kem); margin-bottom: var(--k-4); }
  .dcn-nho { font-size: var(--co-nho); margin-bottom: var(--k-6); }
  .dcn-hinh { position: relative; max-width: 520px; width: 100%; }
  .dcn-la { width: 64px; left: -18px; bottom: -26px; transform: rotate(-30deg); }
  @media (min-width: 900px) {
    .dcn-van { display: block; }
    .dcn-luoi { grid-template-columns: 6fr 5fr; gap: var(--k-8); }
    .dcn-hinh :global(.khung-anh) { box-shadow: 0 30px 60px -32px rgba(30, 22, 14, .7); }
  }
</style>
