---
/**
 * MÀN HÌNH ĐẦU TRANG CHỦ
 *
 * Câu chính (h1): "Không cần rành bò. Chọn theo gu, thấy giá trước." — câu chính cho khách của
 * THUONG-HIEU.md, Khánh đưa lên màn đầu ngày 12/11/2026 (thay câu của brief 06/10/2026, câu đó chuyển
 * xuống đoạn dẫn). Hai câu, mỗi câu một dòng; câu sau màu nhấn của bề mặt. Descriptor đứng trên.
 *
 * Hình: hai ảnh minh họa kể đúng thứ tự Pick → Grill — quầy khay (quay-chon-bo, ảnh tạm Khánh cho dùng
 * ở đây từ 12/11/2026, tới khi có ảnh quầy chụp thật) rồi vỉ gas (hero-vi-gas, ảnh ưu tiên tải ngay).
 * Chú thích có số nằm TRÊN mỗi ảnh, không đè lên ảnh. Tagline (THUONG_HIEU.khauHieu) là một dải đỏ gọn
 * dính ngay dưới hai ảnh, chữ trắng in hoa như logo chính: không logo hay chữ nào đặt lên ảnh, khung
 * ảnh không bóng đổ. Dải có aria-hidden: khối ba bước ngay sau đã đọc tagline ở dòng hiệu. Dưới 600px
 * hai ảnh cạnh nhau chỉ còn 170px mỗi ảnh, nên điện thoại giữ MỘT ảnh vỉ gas 4:5 như trước (ảnh quầy
 * lazy và ẩn — không tải); câu chính đã nói phần "chọn tại quầy".
 *
 * Hỏi bàn nhanh (form hỏi bàn đang mở): hai ô chọn — ngày đến (14 ngày tới) và số người — rồi nút
 * "Hỏi bàn" gửi GET sang trang Hỏi bàn (lib/trang-cong-khai.ts → ngayHoiNhanh, soKhachTuUrl). Form chưa
 * mở thì vẫn là hai nút của nutMoDau().
 *
 * Thứ tự (một nguồn HTML, CSS xếp lại):
 *  · điện thoại, máy tính bảng (dưới 900px): câu chính → mô tả → hỏi bàn nhanh / 2 nút → ảnh → dòng
 *    địa điểm;
 *  · điện thoại rất nhỏ (dưới 360px, cũng là máy tính phóng to 400 %): phần chữ đã dài hơn một
 *    màn hình, nên ảnh lên ngay sau câu chính — ảnh tải ngay không được nằm hẳn dưới màn hình đầu;
 *  · máy tính (từ 900px): câu chính trải ngang; dưới nó mô tả bên trái, hỏi bàn nhanh bên phải; rồi
 *    dải hai ảnh trải hết bề ngang khung; dòng địa điểm thành một hàng ngang dưới cùng.
 *
 * Hàng thông tin có ba trạng thái theo khóa ngay_khai_truong — chưa có ngày, sắp mở ("Đón bạn từ
 * …"), đã mở ("Mở cửa từ …") — và dòng trạng thái dài ngắn tuỳ /noi-bo công bố. Ở trạng thái nào
 * câu chỉ đường cũng dính ngay dưới dòng địa chỉ, ngày không gãy giữa chừng: thu-day-du.mjs nhóm 9
 * dựng cả ba trạng thái (kịch bản sap-mo, da-mo của gia-supabase.mjs).
 *
 * Thứ bậc nút theo mức sẵn sàng mở cửa: lib/trang-cong-khai.ts → nutMoDau().
 * Dòng trạng thái và ngày mở giữ đúng logic cũ: dong_trang_thai, ngay_khai_truong.
 */
import { THUONG_HIEU, chu, duongDanTuongUng } from '../lib/chu';
import { dinhDangNgay, homNayVn } from '../lib/noi-dung';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import {
  SO_KHACH_HOI_NHANH, SO_KHACH_MAC_DINH, cumDiaChi, diaChiManDau, formHoiBanMo, lienHe, ngayHoiNhanh, nhanSoKhach, nutMoDau,
} from '../lib/trang-cong-khai';
import Anh from './Anh.astro';
import BieuTuong from './BieuTuong.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; }
const { ngonNgu, noiDung: nd } = Astro.props;
const t = chu(ngonNgu);
const nut = nutMoDau(nd, ngonNgu);
// Form hỏi bàn mở: nút chính là "Hỏi bàn" (nut[0]) — thành nút gửi của thanh hỏi bàn nhanh.
const hoiNhanh = formHoiBanMo(nd);
const ngayChon = hoiNhanh ? ngayHoiNhanh(ngonNgu) : [];
// Câu chính hai câu, mỗi câu một khối: tách sau dấu chấm (cả "요." tiếng Hàn). Chữ giữ nguyên — test đọc nguyên câu.
const cauChinh = t.cauChinh.split(/(?<=[.!?])\s+/u);
const lh = lienHe(nd);
const ngayMo = nd.ngay_khai_truong;
const daMo = !!(ngayMo && ngayMo <= homNayVn());
// Ba vế của tagline, mỗi vế một khối: dải hẹp thì xuống dòng giữa hai vế, không cắt đôi "grill / it,".
// Tách sau dấu phẩy, chấm hay chấm than: "Pick it," "grill it," "love it!" — dấu câu đổi lần nữa vẫn đúng.
const veKhauHieu = THUONG_HIEU.khauHieu.split(/(?<=[,.!])\s+/);
// Câu chỉ đường tách thành từng vế (sau dấu phẩy), mỗi vế một khối inline-block: xuống dòng
// giữa hai vế, không cắt đôi "ngay cạnh / GS25" hay "thang / máy".
// Chữ giữ nguyên (không \u00a0 trong loiLen — test đọc nguyên câu).
const veLoiLen = t.loiLen.split(/(?<=,)\s+/u);
// Địa chỉ bản ngắn (diaChiManDau): xuống dòng sau dấu phẩy, không giữa "Hồ Tùng / Mậu" (vế dài để nguyên, không tràn).
const cumDc = cumDiaChi(diaChiManDau(nd));
---
<section class="kmd be-kem" aria-labelledby="kmd-tieu-de">
  <div class="khung kmd-luoi">
    <div class="kmd-dau">
      <p class="hieu"><span lang="en">{THUONG_HIEU.descriptor}</span></p>
      <h1 id="kmd-tieu-de">{cauChinh.map((cau, i) => <>{i > 0 && ' '}<span class:list={['kmd-cau', { 'kmd-cau-nhan': i > 0 }]}>{cau}</span></>)}</h1>
    </div>
    <p class="dan kmd-dan">{t.gioiThieu}</p>

    {hoiNhanh ? (
      /* GET sang trang Hỏi bàn: ngày và số người lên địa chỉ trang, #hb-gio cuộn thẳng tới khung giờ. */
      <form class="kmd-nut kmd-hoi" method="get" action={`${nut[0].url}#hb-gio`} aria-label={t.hoiBanNhanh}>
        <div class="kmd-chon">
          <div class="o">
            <label for="kmd-ngay">{t.ngayDen}</label>
            <select id="kmd-ngay" name="ngay">
              {ngayChon.map((n, i) => <option value={n.iso} selected={i === 0}>{n.chu}</option>)}
            </select>
          </div>
          <div class="o">
            <label for="kmd-so-khach">{t.soNguoi}</label>
            <select id="kmd-so-khach" name="so_khach">
              {SO_KHACH_HOI_NHANH.map(n => <option value={n} selected={n === SO_KHACH_MAC_DINH}>{nhanSoKhach(n, ngonNgu)}</option>)}
            </select>
          </div>
        </div>
        <div class="hang-nut">
          <button type="submit" class="nut nut-chinh">{nut[0].chu}</button>
          <a class="nut nut-vien" href={nut[1].url}>{nut[1].chu}</a>
        </div>
      </form>
    ) : (
      <div class="hang-nut kmd-nut">
        {nut.map(n => (
          <a class:list={['nut', n.kieu === 'chinh' ? 'nut-chinh' : 'nut-vien']} href={n.url}>{n.chu}</a>
        ))}
      </div>
    )}

    <div class="kmd-hinh">
      <div class="kmd-hai-anh">
        <div class="kmd-buoc kmd-buoc-quay">
          <p class="kmd-chu-anh"><span class="kmd-so">1</span>{t.anhQuay}</p>
          <Anh id="quay-chon-bo" ngonNgu={ngonNgu} khung="4x3" thayBang="quay"
               sizes="(min-width: 1280px) 592px, (min-width: 600px) calc(50vw - 46px), 1px" />
        </div>
        <div class="kmd-buoc">
          <p class="kmd-chu-anh"><span class="kmd-so">2</span>{t.anhNuong}</p>
          <Anh id="hero-vi-gas" ngonNgu={ngonNgu} khung="4x3" khungNho="4x5" uuTien thayBang="ban-nuong"
               sizes="(min-width: 1280px) 592px, (min-width: 600px) calc(50vw - 46px), calc(100vw - 40px)" />
        </div>
      </div>
      {/* aria-hidden: dải này để NHÌN. Trình đọc màn hình đọc tagline một lần, ở dòng hiệu của khối ba bước
          ngay sau (BaBuoc.astro) — không đọc hai lần liền nhau. */}
      <p class="kmd-khau-hieu" lang="en" aria-hidden="true">{veKhauHieu.map((ve, i) => <>{i > 0 && ' '}<span>{ve}</span></>)}</p>
    </div>

    <ul class="kmd-thong-tin">
      <li>
        <a class="kmd-dia-chi" href={duongDanTuongUng('/den-beeftown', ngonNgu)}><BieuTuong ten="thang-may" /><span><strong>{t.tang3}</strong> · <span lang="vi">{cumDc.map(cum => <><span class:list={{ 'kmd-lien': cum.giu }}>{cum.chu}</span>{cum.cach}</>)}</span></span></a>
      </li>
      {/* Biểu tượng thang máy có aria-hidden: câu này mới là thứ người đọc màn hình nghe được
          (địa chỉ tầng 3 luôn đi kèm câu chỉ đường: lối vào riêng ngay cạnh GS25, đi thang máy). */}
      <li class="kmd-loi-len">{veLoiLen.map((ve, i) => <>{i > 0 && ' '}<span>{ve}</span></>)}</li>
      {ngayMo && (
        <li class="kmd-ngay">{daMo ? t.moCuaTu : t.donBanTu} <strong>{dinhDangNgay(ngayMo, ngonNgu)}</strong></li>
      )}
      <li class="trang-thai kmd-trang-thai"><p>{nd.dong_trang_thai ?? t.trangThaiMacDinh}</p></li>
      {lh.facebook && (
        <li class="kmd-theo-doi"><a class="lien-ket" href={lh.facebook} rel="noopener">{t.theoDoi}<BieuTuong ten="mui-ten" /></a></li>
      )}
    </ul>
  </div>
</section>

<style>
  /* --- Một cột (dưới 900px): thứ tự của HTML ---------------------------------- */
  .kmd-luoi {
    display: flex; flex-direction: column;
    padding-block: var(--k-5) var(--k-7);
  }
  .kmd h1 { margin: 0 0 var(--k-5); }
  /* Mỗi câu một khối; câu sau màu nhấn của bề mặt (đỏ trên trắng: 6,64 : 1, chữ ≥ 32px đậm). */
  .kmd-cau { display: block; }
  .kmd-cau-nhan { color: var(--nhan); }
  .kmd-dan { margin: 0 0 var(--k-5); }
  .kmd-nut { margin-bottom: var(--k-6); }
  .kmd-hinh { margin-bottom: var(--k-6); }

  /* Hỏi bàn nhanh. Ô chọn dùng ô nhập chung của trang (.o: nhãn trên ô, cao 48px, chữ 16px, viền --vien-o).
     Từ 600px: hai ô chọn cạnh nhau (ngày rộng hơn — "Wednesday, 18 November"), nhóm nút ngay dưới.
     Điện thoại: ô ngày một hàng riêng; hàng sau là ô số người cạnh nút "Hỏi bàn" (nút thẳng đáy ô); nút viền
     cuối cùng. .kmd-chon và .hang-nut "display: contents" để bốn phần tử xếp chung một lưới. */
  .kmd-hoi { display: grid; gap: var(--k-3); }
  .kmd-chon, .kmd-hoi .hang-nut { display: contents; }
  .kmd-hoi {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    grid-template-areas: "ngay ngay" "nguoi gui" "phu phu";
    align-items: end;
  }
  .kmd-chon .o { margin: 0; min-width: 0; }
  .kmd-chon .o:first-child { grid-area: ngay; }
  .kmd-chon .o:last-child { grid-area: nguoi; }
  .kmd-hoi .nut-chinh { grid-area: gui; }
  .kmd-hoi .nut-vien { grid-area: phu; }
  @media (min-width: 600px) {
    .kmd-hoi { display: grid; gap: var(--k-4); grid-template-columns: none; grid-template-areas: none; align-items: stretch; }
    .kmd-chon { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--k-3); }
    .kmd-hoi .hang-nut { display: flex; margin: 0; }
  }

  /* Hai ảnh và dải tagline là một khối: ảnh bo hai góc trên, dải đỏ bo hai góc dưới, dính ngay dưới ảnh.
     Chữ trắng trên đỏ 6,64 : 1. */
  .kmd-hinh :global(.anh) { border-radius: var(--bo-anh) var(--bo-anh) 0 0; }
  .kmd-hai-anh { display: grid; gap: var(--k-3); align-items: end; }
  /* Chú thích có số đứng trên ảnh — không đè lên ảnh. */
  .kmd-chu-anh {
    display: flex; align-items: center; gap: var(--k-2);
    margin: 0 0 var(--k-2); font-size: var(--co-nho); font-weight: 700; line-height: 1.4;
  }
  .kmd-so { color: var(--nhan); font-weight: 800; }
  /* Điện thoại: một ảnh vỉ gas 4:5, không chú thích (ảnh quầy ẩn, lazy nên không tải). */
  @media (max-width: 599.98px) {
    .kmd-buoc-quay, .kmd-chu-anh { display: none; }
  }
  @media (min-width: 600px) {
    .kmd-hai-anh { grid-template-columns: 1fr 1fr; }
  }
  .kmd-khau-hieu {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 2px .9em;
    margin: 0; padding: var(--k-3) var(--k-4);
    border-radius: 0 0 var(--bo-anh) var(--bo-anh);
    background: var(--do); color: var(--kem);
    font-size: clamp(14px, 0.57vw + 11.8px, 20px); font-weight: 800; line-height: 1.3;
    letter-spacing: .08em; text-transform: uppercase;
  }
  .kmd-khau-hieu span { white-space: nowrap; }

  .kmd-thong-tin {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--k-4);
  }
  /* Vùng chạm 48px = dòng chữ 24px + đệm 12px trên dưới. Dùng đệm chứ không chỉ min-height: địa chỉ xuống
     hai dòng thì dưới chữ vẫn còn đúng 12px, câu chỉ đường bên dưới không dính vào dòng thứ hai. */
  .kmd-dia-chi {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding-block: 12px;
    font-weight: 600; line-height: 24px; text-decoration: none; color: var(--than);
  }
  @media (hover: hover) { .kmd-dia-chi:hover > span { text-decoration: underline; } }
  .kmd-dia-chi :global(svg) { width: 24px; height: 24px; color: var(--do); flex: none; }
  .kmd-ngay { font-weight: 600; }
  /* Ngày không gãy giữa chừng ("ngày 13 tháng 11," / "2026"): chật thì xuống dòng TRƯỚC ngày. */
  .kmd-ngay strong { white-space: nowrap; }
  .kmd-lien { white-space: nowrap; }
  /* Thẳng hàng với chữ địa chỉ: biểu tượng 24px + khe 10px. */
  .kmd-loi-len {
    font-size: var(--co-nho); color: var(--chu-phu);
    margin-top: calc(-1 * var(--k-3)); padding-left: 34px;
  }
  .kmd-loi-len > span { display: inline-block; }

  /* --- Điện thoại rất nhỏ: ảnh ngay sau câu chính ------------------------------ */
  @media (max-width: 359.98px) {
    .kmd-dau { order: -2; }
    .kmd-hinh { order: -1; }
  }

  /* --- Từ 600px: ảnh ngang 4:3, không rộng quá cột chữ đọc được ------------------ */
  @media (min-width: 600px) {
    .kmd-luoi { padding-block: var(--k-6) var(--k-7); }
  }

  /* --- Máy tính: câu chính trải ngang; mô tả trái, hỏi bàn nhanh phải; dải hai ảnh; hàng địa điểm --- */
  @media (min-width: 900px) {
    .kmd-luoi {
      display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--k-7);
      grid-template-rows: auto auto auto auto;
      padding-block: var(--k-7) var(--k-6);
    }
    .kmd-dau { grid-area: 1 / 1 / 2 / 3; }
    .kmd-dan { grid-area: 2 / 1; margin-bottom: 0; align-self: end; }
    .kmd-nut { grid-area: 2 / 2; margin-bottom: 0; align-self: end; }
    .kmd-hinh { grid-area: 3 / 1 / 4 / 3; margin: var(--k-7) 0 0; }
    .kmd-thong-tin {
      grid-area: 4 / 1 / 5 / 3;
      margin-top: var(--k-7); padding-top: var(--k-5); border-top: 1px solid var(--vien);
      /* Cột địa chỉ co lại được (câu chỉ đường xuống dòng theo vế). Cột giữa rộng ít nhất bằng dòng ngày
         (không xuống dòng) và 14em của dòng trạng thái — không bị ép thành cột chữ hẹp. */
      grid-template-columns: minmax(0, max-content) 1fr max-content; gap: 0 var(--k-6);
      /* Hàng 1 cao theo dòng địa chỉ, hàng 2 (1fr) nhận hết phần cao thêm: dòng trạng thái dài mấy câu thì
         câu chỉ đường vẫn dính ngay dưới địa chỉ — ô bên cạnh không kéo nó tụt xuống. */
      grid-template-rows: auto 1fr; align-items: start;
    }
    .kmd-thong-tin > li:first-child { grid-area: 1 / 1; }
    .kmd-loi-len { grid-area: 2 / 1; margin-top: -6px; }
    /* Chưa có ngày mở: dòng trạng thái đứng giữa cặp địa chỉ + câu chỉ đường. Có ngày mở: ngày ngang dòng
       cuối của địa chỉ (đệm dưới 12px như địa chỉ), dòng trạng thái ngay dưới ngày, dòng chữ đầu ngang
       câu chỉ đường. */
    .kmd-ngay { grid-area: 1 / 2; align-self: end; margin-bottom: 12px; line-height: 24px; white-space: nowrap; }
    .kmd-trang-thai { grid-area: 1 / 2 / 3 / 3; align-self: center; min-width: 14em; }
    .kmd-ngay ~ .kmd-trang-thai { grid-area: 2 / 2; align-self: start; margin-top: -10px; }
    .kmd-theo-doi { grid-area: 1 / 3 / 3 / 4; align-self: center; }
  }
  @media (min-width: 1200px) {
    .kmd-luoi { column-gap: var(--k-8); }
    .kmd-thong-tin { column-gap: var(--k-7); }
  }
</style>
