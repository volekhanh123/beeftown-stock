---
/**
 * ẢNH CÓ NHIỀU CỠ — và dòng "Ảnh minh họa" khi ảnh là ảnh minh họa
 *
 * <picture> với avif rồi webp; khung riêng cho điện thoại (khungNho, vd. 4:5)
 * và cho màn rộng (khung, vd. 4:3). Khung <figure> tự giữ đúng tỷ lệ của ảnh
 * (--ti-le / --ti-le-nho, cong-khai.css → .anh) từ trước khi ảnh về — ảnh về chậm
 * thì trang cũng không xô lệch; <img> vẫn có width / height.
 *
 * Nền chờ của khung (lúc ảnh chưa về) là màu của bảng màu, theo dải đặt ảnh
 * (nenKhung: kem | toi | do) — không dùng màu trung bình của ảnh: mọi màu nền trên
 * trang công khai phải thuộc bảng màu (kiem-tra/do-giao-dien.mjs → khongTrang).
 *
 * Ảnh màn đầu: uuTien → tải ngay, fetchpriority="high". Mọi ảnh khác lazy.
 *
 * Ảnh minh họa (ảnh AI): <figcaption> "Ảnh minh họa" nằm ngay trong khung, góc
 * dưới trái — component tự gắn, nơi dùng không quên được. Không đặt logo hay chữ
 * nào khác lên ảnh.
 *
 * Ảnh tách nền (DANH_MUC_ANH[id].tachNen — ảnh món của trang Thực đơn): khung thêm lớp
 * .tach-nen — không nền chờ, không bo góc (món đặt thẳng lên nền của dải như trong cuốn
 * menu); nhãn sát góc dưới trái, nằm trong dải trống tao-co-anh.py chừa sẵn ở đáy khung,
 * tức là ngay dưới món chứ không đè lên món.
 *
 * Ảnh chưa dựng cỡ (anh-tao-san.ts chưa có) → KhungAnh `thayBang`, không bao giờ
 * là một thẻ <img> trỏ tới file không có.
 */
import { DANH_MUC_ANH, coAnh, srcsetAnh, duongDanAnh, altAnh, type IdAnh } from '../lib/anh';
import { chu } from '../lib/chu';
import type { NgonNgu } from '../lib/noi-dung';
import KhungAnh, { type LoaiKhung } from './KhungAnh.astro';

interface Props {
  id: IdAnh;
  ngonNgu: NgonNgu;
  /** Khung cho màn ≥ 600px, vd. '16x9'. */
  khung: string;
  /** Khung cho màn < 600px; mặc định như khung. */
  khungNho?: string;
  /** Thuộc tính sizes của <img>, vd. '(min-width: 900px) 50vw, 100vw'. */
  sizes?: string;
  uuTien?: boolean;
  thayBang?: LoaiKhung;
  /** Dải đặt ảnh: quyết định màu nền chờ của khung (và nền của KhungAnh khi ảnh chưa dựng cỡ). */
  nenKhung?: 'kem' | 'toi' | 'do';
  class?: string;
}
const {
  id, ngonNgu, khung, khungNho = khung, sizes = '100vw', uuTien = false,
  thayBang = 'ban-nuong', nenKhung = 'kem', class: lop,
} = Astro.props;

const lon = coAnh(id, khung);
const nho = coAnh(id, khungNho);
const tiLe = (k: string) => k.replace('x', ' / ');
const t = chu(ngonNgu);
const minhHoa = DANH_MUC_ANH[id].minhHoa;
const tachNen = DANH_MUC_ANH[id].tachNen === true;
const doiKhung = khungNho !== khung && !!nho;
const lopNen = tachNen ? 'tach-nen' : nenKhung === 'toi' ? 'tren-toi' : nenKhung === 'do' ? 'tren-do' : '';
// Ảnh mặc định của <img>: bề rộng giữa danh sách, webp — trình duyệt nào cũng đọc được.
const giua = lon ? lon.cac[Math.floor((lon.cac.length - 1) / 2)] : 0;
---
{lon ? (
  <figure class:list={['anh', lopNen, lop]} style={`--ti-le:${tiLe(khung)};--ti-le-nho:${tiLe(doiKhung ? khungNho : khung)}`}>
    <picture>
      {doiKhung && nho && (
        <>
          <source media="(max-width: 599px)" type="image/avif" srcset={srcsetAnh(id, khungNho, 'avif')} sizes={sizes} width={nho.rong} height={nho.cao} />
          <source media="(max-width: 599px)" type="image/webp" srcset={srcsetAnh(id, khungNho, 'webp')} sizes={sizes} width={nho.rong} height={nho.cao} />
        </>
      )}
      <source type="image/avif" srcset={srcsetAnh(id, khung, 'avif')} sizes={sizes} />
      <img
        src={duongDanAnh(id, khung, giua, 'webp')}
        srcset={srcsetAnh(id, khung, 'webp')}
        sizes={sizes}
        width={lon.rong}
        height={lon.cao}
        alt={altAnh(id, ngonNgu)}
        loading={uuTien ? 'eager' : 'lazy'}
        decoding={uuTien ? 'sync' : 'async'}
        fetchpriority={uuTien ? 'high' : 'auto'}
      />
    </picture>
    {minhHoa && <figcaption class="chu-thich-anh">{t.anhMinhHoa}</figcaption>}
  </figure>
) : (
  <KhungAnh loai={thayBang} tiLe={tiLe(khung)} tiLeNho={tiLe(khungNho)} nen={nenKhung} class={lop} />
)}
