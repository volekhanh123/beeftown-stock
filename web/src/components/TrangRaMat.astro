---
/**
 * TRANG CHỦ
 * =========
 * Trang này phải ĐÚNG và ĐỦ ngay cả khi mọi công tắc đều tắt. Đó là phép thử
 * của cả thiết kế, không phải một trường hợp biên.
 *
 * Với database trống, trang hiện: câu chính, tagline, descriptor, cách ăn ở
 * Beeftown, quầy chọn bò và cách đọc nhãn khay, các nhóm món, lời mời đi nhóm,
 * đường lên tầng 3 và câu hỏi thường gặp — toàn là dữ kiện đã xác nhận (brief
 * 06/10/2026). Không số điện thoại giả, không ảnh kho, không nút dẫn đi đâu cả.
 *
 * Mỗi dữ kiện được bật lên sẽ THÊM vào trang (Facebook, Maps, hotline, ngày mở,
 * form hỏi bàn), không bao giờ trừ đi phần nền. Các công tắc hien_ba_buoc,
 * hien_quay_thit, hien_tiec_nhom vẫn chưa dùng: ba khối tương ứng là phần nền.
 *
 * Nhịp trang: kem (màn đầu, mảng đỏ) → kem (ba bước) → TỐI (quầy, thịt sáng lên)
 * → kem đậm (cả bữa) → ĐỎ (đi nhóm) → kem (tầng 3) → kem (câu hỏi) → chân trang.
 *
 * Tuyển dụng chuyển xuống dải gọn ở chân trang — có mặt ở MỌI trang công khai.
 */
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import KhoiMoDau from './KhoiMoDau.astro';
import BaBuoc from './BaBuoc.astro';
import QuayChonBo from './QuayChonBo.astro';
import BuaAnCungNhau from './BuaAnCungNhau.astro';
import DiCungNhom from './DiCungNhom.astro';
import LenTang3 from './LenTang3.astro';
import CauHoi from './CauHoi.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; }
const { ngonNgu, noiDung } = Astro.props;
---
<KhoiMoDau ngonNgu={ngonNgu} noiDung={noiDung} />
<BaBuoc ngonNgu={ngonNgu} />
<QuayChonBo ngonNgu={ngonNgu} />
<BuaAnCungNhau ngonNgu={ngonNgu} noiDung={noiDung} />
<DiCungNhom ngonNgu={ngonNgu} noiDung={noiDung} />
<section class="muc be-kem" id="tang-3">
  <div class="khung"><LenTang3 ngonNgu={ngonNgu} noiDung={noiDung} /></div>
</section>
<CauHoi ngonNgu={ngonNgu} noiDung={noiDung} />
