---
/**
 * ĐẦU TRANG — logo gốc, bốn mục điều hướng (năm khi trang Mua thịt về mở), bộ chọn ngôn ngữ
 *
 * Đầu trang là một dải ĐEN (bề mặt .be-toi của cong-khai.css): chữ trắng, mục đang xem
 * gạch dưới trắng, nút "Hỏi bàn" đỏ chữ trắng, vòng focus trắng. Bảng thả xuống của màn
 * hẹp trở lại bề mặt sáng (.be-kem): nền trắng, chữ đen, nét đỏ ở đáy.
 *
 * Logo là path gốc của bộ 21/10/2026 (web/public/thuong-hieu, tách bằng
 * web/cong-cu/thuong-hieu/tach-logo.mjs) — không gõ lại chữ BEEFTOWN bằng phông nào.
 * Thanh chỉ cao 64px (80px từ 1080px) nên dùng LOGO PHỤ (chữ BEEFTOWN, không tagline:
 * tagline của logo chính chỉ cao khoảng 1/4 chữ, ở cỡ này không đọc được), bản TRẮNG cho
 * nền đen (đầu bò khoét lộ nền — guideline trang 4 vẽ bản này trên đỏ; bảng tài sản của PR
 * đổi nhận diện dùng cùng bản cho nền đen). Rộng 148px (176px từ 1080px): trên dưới còn
 * khoảng trống bằng cạnh ô đầu bò như guideline trang 3 vẽ.
 * Màn dưới 360px (điện thoại rất nhỏ, hoặc máy tính phóng to 400 %) không đủ chỗ cho
 * logo phụ cạnh nút danh mục — thanh đổi sang brandmark trắng 48px (mức tối thiểu 48px
 * giữ từ bộ 09/10/2026).
 *
 * Điều hướng theo brief: Trải nghiệm / Thực đơn / Đến Beeftown / Hỏi bàn. Hỏi bàn
 * là nút đỏ — hành động chính của cả trang. Tuyển dụng và giấy tờ ở chân trang.
 * Khi trang Mua thịt về mở (công tắc hiệu lực của database — muaThitVeMo, lib/dich-dat-hang.ts)
 * dieuHuong(ngonNgu, nd) thêm "Mua thịt về" ngay sau "Thực đơn"; chưa mở hay chưa nối database
 * thì bốn mục như cũ. Nút đỏ chọn theo đường dẫn Hỏi bàn, không theo vị trí.
 *
 * Ba bề rộng (thanh cao 64px; từ 1080px cao 80px — --cao-dau trong cong-khai.css):
 *   · dưới 768px   logo | nút "Danh mục". Đặt bàn (nút chính) và ngôn ngữ nằm trong bảng.
 *   · từ 768px     logo | nút ngôn ngữ | Đặt bàn | nút "Danh mục" (bảng chỉ còn ba trang — bốn
 *                  khi trang Mua thịt về mở).
 *   · từ 1080px    logo | ba trang (bốn khi trang Mua thịt về mở) | nút ngôn ngữ | Đặt bàn. Không
 *                  còn nút "Danh mục".
 *
 * Nút ngôn ngữ trên thanh (Khánh quyết 23/11/2026, thay ba chữ in liền nhau): MỘT nút quả địa cầu
 * kèm mã thứ tiếng đang xem (VI / EN / KO); bấm thì thả xuống danh sách ĐỦ ba thứ tiếng theo thứ tự
 * cố định, mỗi cái ghi bằng chính thứ tiếng đó. Trong danh sách (và ở hàng ngôn ngữ của bảng danh
 * mục điện thoại), thứ tiếng đang xem không phải link: in đậm và có nét gạch dưới (aria-current="true")
 * — nhận ra được mà không cần nhìn màu.
 *
 * Nút ngôn ngữ và nút danh mục đều là <details> — mở / đóng được KHÔNG cần JavaScript (bấm,
 * Enter, phím cách). Hai cái cùng name="dau-trang": trình duyệt chỉ cho mở một cái một lúc
 * (script cũng đóng cái kia, cho trình duyệt cũ chưa biết thuộc tính name). Danh mục đang mở
 * thì nút đổi thành nút đóng có chữ. Script bên dưới chỉ thêm: Esc để đóng, bấm ra ngoài hoặc
 * bấm một mục thì đóng, Tab ra khỏi mục cuối thì đóng, phóng to cửa sổ qua mốc màn rộng thì
 * đóng danh mục. Lớp phủ tối dưới bảng danh mục và việc khoá cuộn trang CHỈ có khi script đã
 * chạy (script gắn data-co-script lên <details>): không script thì không gì đóng được danh mục
 * sau khi khách bấm một link neo, nên trang phải cuộn được và không có lớp phủ nào che nó.
 * Danh sách ngôn ngữ nhỏ, không lớp phủ, không khoá cuộn.
 */
import { chu, duongDanTuongUng } from '../lib/chu';
import { diaChiSauTang, dieuHuong } from '../lib/trang-cong-khai';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import BieuTuong from './BieuTuong.astro';

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  duongDan: string;
  /** Đủ ba thứ tiếng, kể cả thứ tiếng đang xem, theo thứ tự cố định (layouts/Trang.astro). */
  doiNgonNgu: { nn: NgonNgu; url: string; ten: string }[];
}
const { ngonNgu, noiDung: nd, duongDan, doiNgonNgu } = Astro.props;
const t = chu(ngonNgu);
const muc = dieuHuong(ngonNgu, nd);
// Chọn theo đường dẫn, không theo vị trí: thêm hay đổi thứ tự mục trong dieuHuong()
// thì nút đỏ vẫn là Hỏi bàn.
const duongHoiBan = duongDanTuongUng('/dat-ban', ngonNgu);
const hoiBan = muc.find(m => m.duong === duongHoiBan)!;
const [traiNghiem, ...trang] = muc.filter(m => m !== hoiBan);
const hienTai = (duong: string) => duongDan.replace(/\/$/, '') === duong.replace(/\/$/, '');
---
<header class="dau-trang be-toi">
  <div class="khung dt-hang">
    <a class="dt-logo" href={duongDanTuongUng('/', ngonNgu)} aria-label={t.veTrangChu}>
      <img class="dt-logo-day-du" src="/thuong-hieu/chu-beeftown-trang.svg" width="430" height="61" alt="" />
      <img class="dt-logo-gon" src="/thuong-hieu/dau-bo-trang.svg" width="177" height="169" alt="" />
    </a>

    <nav class="dt-nav" aria-label={t.dieuHuongChinh}>
      <ul>
        <li><a href={traiNghiem.url}>{traiNghiem.chu}</a></li>
        {trang.map(m => (
          <li><a href={m.url} aria-current={hienTai(m.duong) ? 'page' : undefined}>{m.chu}</a></li>
        ))}
      </ul>
    </nav>

    <div class="dt-phai">
      {/* Tên đọc được của nút: mã nhìn thấy (VI) đứng đầu, rồi chữ "Ngôn ngữ" chỉ cho trình đọc màn hình. */}
      <details class="dt-ngon-ngu" name="dau-trang">
        <summary><BieuTuong ten="dia-cau" /><span class="dt-ma-nn">{ngonNgu.toUpperCase()}</span>{' '}<span class="an-chu">{t.chonNgonNgu}</span></summary>
        <ul class="dt-nn-bang be-kem" aria-label={t.chonNgonNgu}>
          {doiNgonNgu.map(n => (
            <li>{n.nn === ngonNgu
              ? <span class="doi-ngon-ngu" aria-current="true" lang={n.nn}>{n.ten}</span>
              : <a class="doi-ngon-ngu" href={n.url} lang={n.nn} hreflang={n.nn}>{n.ten}</a>}</li>
          ))}
        </ul>
      </details>
      <a class="nut nut-chinh nut-nho dt-hoi-ban" href={hoiBan.url}
         aria-current={hienTai(hoiBan.duong) ? 'page' : undefined}>{hoiBan.chu}</a>

      <details class="menu-gon" name="dau-trang">
        <summary>
          <BieuTuong ten="menu" class="mg-mo" />
          <BieuTuong ten="dong" class="mg-dong" />
          {/* Hai nhãn chồng trong cùng một ô lưới: nút rộng bằng nhãn dài hơn ở cả hai trạng thái. */}
          <span class="mg-chu"><span class="mg-mo">{t.moMenu}</span><span class="mg-dong">{t.dong}</span></span>
        </summary>
        <div class="mg-bang be-kem">
          <nav aria-label={t.dieuHuongChinh}>
            <ul class="mg-muc">
              <li><a href={traiNghiem.url}>{traiNghiem.chu}</a></li>
              {trang.map(m => (
                <li><a href={m.url} aria-current={hienTai(m.duong) ? 'page' : undefined}>{m.chu}</a></li>
              ))}
              <li class="mg-hoi-ban"><a class="nut nut-chinh" href={hoiBan.url}
                    aria-current={hienTai(hoiBan.duong) ? 'page' : undefined}>{hoiBan.chu}</a></li>
            </ul>
          </nav>
          <div class="mg-ngon-ngu-khoi">
            <p class="mg-nhan" id="mg-nhan-ngon-ngu">{t.chonNgonNgu}</p>
            <ul class="mg-ngon-ngu" aria-labelledby="mg-nhan-ngon-ngu">
              {doiNgonNgu.map(n => (
                <li>{n.nn === ngonNgu
                  ? <span class="doi-ngon-ngu" aria-current="true" lang={n.nn}>{n.ten}</span>
                  : <a class="doi-ngon-ngu" href={n.url} lang={n.nn} hreflang={n.nn}>{n.ten}</a>}</li>
              ))}
            </ul>
          </div>
          <p class="mg-dia-chi"><BieuTuong ten="ghim" /><span><strong>{t.tang3}</strong> · <span lang="vi">{diaChiSauTang(nd)}</span></span></p>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Thêm vào hai <details> của thanh (danh mục, nút ngôn ngữ): Esc đóng (trả tiêu điểm về nút), bấm ra
  // ngoài / bấm một mục thì đóng, Tab ra khỏi mục cuối thì đóng, mở cái này thì đóng cái kia (trình duyệt
  // đã biết name="dau-trang" thì tự làm việc này). Không có script: vẫn mở / đóng được.
  const hop = [...document.querySelectorAll<HTMLDetailsElement>('.dau-trang details')];
  const dongHop = (d: HTMLDetailsElement, traTieuDiem: boolean) => {
    if (!d.open) return;
    d.open = false;
    if (traTieuDiem) d.querySelector('summary')?.focus();
  };
  document.addEventListener('keydown', e => { if (e.key === 'Escape') hop.forEach(d => dongHop(d, true)); });
  // Bấm ra ngoài <details> (logo, khoảng trống của thanh, nút kia, phần trang phía dưới).
  document.addEventListener('click', e => {
    for (const d of hop) if (d.open && !d.contains(e.target as Node)) dongHop(d, false);
  });
  for (const d of hop) {
    d.addEventListener('toggle', () => { if (d.open) hop.forEach(khac => { if (khac !== d) khac.open = false; }); });
    d.querySelectorAll('a').forEach(a => a.addEventListener('click', () => dongHop(d, false)));
    // Tab ra khỏi mục cuối: bảng (position absolute) sẽ che chính phần tử vừa nhận tiêu điểm
    // (WCAG 2.4.11) — đóng lại. relatedTarget null (chạm vào chữ không focus được trong bảng)
    // thì giữ nguyên, kẻo bảng tự đóng khi khách chỉ chạm vào dòng địa chỉ.
    d.addEventListener('focusout', e => {
      const toi = e.relatedTarget as Node | null;
      if (d.open && toi && !d.contains(toi)) dongHop(d, false);
    });
  }

  // Riêng danh mục: lớp phủ, khoá cuộn, đóng khi cửa sổ rộng qua mốc màn rộng. Không có script: không
  // lớp phủ, trang không khoá cuộn.
  const menu = document.querySelector<HTMLDetailsElement>('.menu-gon');
  if (menu) {
    // Từ đây mới có thứ đóng được danh mục: CSS chỉ hiện lớp phủ và khoá cuộn khi thấy thuộc tính này.
    menu.dataset.coScript = '';
    const nut = menu.querySelector('summary');
    const dong = (traTieuDiem: boolean) => dongHop(menu, traTieuDiem);
    // Khoá cuộn làm thanh cuộn kiểu cổ điển (Windows, chuột cắm vào Mac: 15px) biến mất — cả trang xô sang
    // phải rồi xô lại lúc đóng. Đo bề rộng thanh cuộn NGAY TRƯỚC khi mở (click chạy trước khi <details> đổi
    // trạng thái; Enter và phím cách trên nút cũng phát click) rồi ghi vào biến CSS: quy tắc khoá cuộn bù
    // lại đúng chừng đó. Máy có thanh cuộn nổi (điện thoại, macOS mặc định) đo ra 0px.
    nut?.addEventListener('click', () => {
      if (!menu.open) document.documentElement.style.setProperty('--rong-thanh-cuon', `${innerWidth - document.documentElement.clientWidth}px`);
    });
    // Bấm lên lớp phủ mờ dưới bảng: lớp phủ là phần tử giả của chính <details>, nên cú bấm có đích là
    // <details>. Nghe NGAY trên <details>, không chờ sự kiện nổi lên document: Safari trên iPhone không
    // phát click cho phần tử không bấm được nếu chính nó (hay cha nó) không có trình nghe click hoặc
    // cursor: pointer — lớp phủ có cả hai.
    menu.addEventListener('click', e => { if (e.target === menu) dong(false); });
    const rong = matchMedia('(min-width: 1080px)');
    rong.addEventListener('change', e => { if (e.matches) dong(false); });
  }
</script>

<style>
  /* Thanh cao đúng --cao-dau (64px; từ 1080px là 80px), tính cả nét kẻ dưới: phần dính
     của trang (thanh tab thực đơn, cột dính) và scroll-padding-top đọc cùng biến đó.
     Nền và nét kẻ đọc biến của bề mặt đen (.be-toi): nền đen, nét trắng 22 %. */
  .dau-trang {
    position: sticky; top: 0; z-index: 40;
    height: var(--cao-dau);
    background: var(--nen);
    border-bottom: 1px solid var(--vien);
  }
  /* Màn thấp (điện thoại xoay ngang, phóng to 200%): đầu trang dính ăn gần nửa màn hình —
     cho nó cuộn đi cùng trang (scroll-padding-top đổi theo ở cong-khai.css). */
  @media (max-height: 500px) { .dau-trang { position: relative; } }
  .dt-hang {
    display: flex; align-items: center; gap: var(--k-3);
    height: 100%;
  }
  /* Vùng chạm 48px; logo phụ rộng 148px (cao khoảng 21px): thanh 64px còn khoảng 21px trên và dưới —
     bằng cạnh ô đầu bò của chính logo, khoảng trống guideline trang 3 vẽ. Ngưỡng 160px chỉ áp logo chính
     (lockup có tagline, luật giữ từ bộ 09/10/2026); logo phụ có ngưỡng riêng 148px. */
  .dt-logo { display: flex; align-items: center; min-height: var(--cham); flex: none; }
  .dt-logo-day-du { width: 148px; height: auto; }
  .dt-logo-gon { display: none; width: 48px; height: auto; }
  /* Dưới 360px: brandmark thay logo phụ (không đủ chỗ cạnh nút danh mục; brandmark tối thiểu 48px). */
  @media (max-width: 359.98px) {
    .dt-logo-day-du { display: none; }
    .dt-logo-gon { display: block; }
  }

  .dt-nav, .dt-ngon-ngu, .dt-hoi-ban { display: none; }
  .dt-phai { display: flex; align-items: center; gap: var(--k-3); margin-left: auto; }

  ul { list-style: none; margin: 0; padding: 0; }

  /* --- Danh sách ngôn ngữ ------------------------------------------------------ */
  /* Ba thứ tiếng cùng cỡ, cùng màu chữ chính của bề mặt (không xám, không nhỏ). Thứ tiếng
     đang xem: chữ đậm + gạch 2px màu --nhan (đỏ trên hai bảng trắng: danh sách thả xuống của nút
     ngôn ngữ, hàng ngôn ngữ của bảng danh mục) — hai dấu hiệu không phụ thuộc màu; thứ tiếng khác
     là link, di chuột mới hiện gạch mảnh. Chỉ đọc biến bề mặt. */
  .doi-ngon-ngu {
    display: inline-flex; align-items: center; min-height: var(--cham);
    padding-inline: var(--k-2);
    font-size: 15px; font-weight: 400; line-height: 1.2;
    color: var(--chu-chinh); text-decoration: none; white-space: nowrap;
  }
  @media (hover: hover) {
    a.doi-ngon-ngu:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .35em; }
  }
  .doi-ngon-ngu[aria-current='true'] {
    font-weight: 700; color: var(--nhan-nho);
    text-decoration: underline; text-decoration-color: var(--nhan);
    text-decoration-thickness: 2px; text-underline-offset: .35em;
  }
  @media (forced-colors: active) {
    .doi-ngon-ngu[aria-current='true'] { text-decoration-color: Highlight; text-decoration-thickness: 3px; }
  }

  /* --- Nút ngôn ngữ trên thanh (từ 768px) --------------------------------------- */
  /* Một nút: quả địa cầu + mã thứ tiếng đang xem (VI / EN / KO), chữ trắng trên thanh đen, không
     viền — để nút chính duy nhất trên thanh vẫn là Đặt bàn và nút có viền duy nhất là Danh mục. Di
     chuột: nền trắng 12 %. Đang mở: thêm viền trắng — khác lúc đóng bằng nét, không chỉ bằng màu. */
  .dt-ngon-ngu { position: relative; }
  .dt-ngon-ngu summary {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: var(--cham); padding: 0 var(--k-3);
    border: 1.5px solid transparent; border-radius: var(--bo);
    font-weight: 700; font-size: 15px; line-height: 1.2; letter-spacing: .04em;
    cursor: pointer; list-style: none; color: var(--chu-chinh);
    transition: background-color var(--nhanh), border-color var(--nhanh);
  }
  .dt-ngon-ngu summary::-webkit-details-marker { display: none; }
  .dt-ngon-ngu summary :global(svg) { width: 24px; height: 24px; flex: none; }
  .dt-ngon-ngu summary:active, .dt-ngon-ngu[open] summary { background: var(--nut-phu-nen-di); border-color: var(--nut-phu-chu); }
  @media (hover: hover) { .dt-ngon-ngu summary:hover { background: var(--nut-phu-nen-di); } }
  @media (forced-colors: active) { .dt-ngon-ngu[open] summary { border-color: Highlight; } }
  /* Danh sách thả xuống: bề mặt sáng (.be-kem), treo ngay dưới nét kẻ của thanh, canh mép phải của nút;
     viền xám --vien-o (4,54 : 1 trên trắng — nhìn ra mép bảng khi nằm đè lên phần trang trắng), kết
     thúc bằng nét đỏ như bảng danh mục. Không bóng đổ. */
  .dt-nn-bang {
    position: absolute; inset-inline-end: 0; z-index: 2;
    top: calc(100% + (var(--cao-dau) - var(--cham)) / 2);
    min-width: 12rem; margin: 0; padding: var(--k-2) 0;
    background: var(--kem);
    border: 1px solid var(--vien-o); border-top: 0; border-bottom: 2px solid var(--do);
  }
  .dt-nn-bang .doi-ngon-ngu { display: flex; padding-inline: var(--k-4); }

  /* --- Từ 768px: ngôn ngữ và Đặt bàn lên thanh --------------------------------- */
  @media (min-width: 768px) {
    .dt-ngon-ngu { display: block; }
    .dt-hoi-ban { display: inline-flex; }
  }
  /* 768–899px bản tiếng Anh ("Book a table" + "Pages") vừa khít thanh: giữ khe 12px, từ 900px mới nới. */
  @media (min-width: 900px) { .dt-phai { gap: var(--k-4); } }

  /* --- Màn rộng ------------------------------------------------------------ */
  @media (min-width: 1080px) {
    .dt-hang { gap: var(--k-5); }
    /* Thanh 80px: logo phụ 176px (cao khoảng 25px), trên dưới còn khoảng 27px. */
    .dt-logo-day-du { width: 176px; }
    .dt-nav { display: block; margin-inline: auto; }
    /* Năm mục (khi trang Mua thịt về mở) vẫn một hàng từ 1080px: mỗi mục không xuống dòng, khe hẹp lại tới 1280px. */
    .dt-nav ul { display: flex; gap: clamp(16px, 2.2vw - 8px, 36px); }
    .dt-nav a {
      white-space: nowrap;
      display: inline-flex; align-items: center; min-height: var(--cham);
      font-weight: 600; font-size: 16px; text-decoration: none; color: var(--chu-chinh);
      border-block: 2px solid transparent; transition: border-color var(--nhanh), color var(--nhanh);
    }
