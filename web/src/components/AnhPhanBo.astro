---
/**
 * ẢNH CỦA NĂM PHẦN THỊT BÒ (TrangPhanBo.astro)
 *
 * Mỗi id ảnh viết THẲNG thành một thẻ <Anh>: kiểm thử (crm/test/test-cong-khai-anh.mjs, nhóm 3) đọc id và khung từ chữ
 * để chắc không file ảnh nào đã dựng mà không ai gọi, và không ai gọi một khung chưa dựng. Chỗ gọi bằng biểu thức
 * chỉ dành cho ảnh món của trang Thực đơn. Ảnh là ảnh chụp thật của người khác (web/cong-cu/anh/NGUON-ANH-PHAN-BO.md),
 * không nhãn "Ảnh minh họa"; chưa dựng cỡ thì hiện khung `khay`.
 */
import type { NgonNgu } from '../lib/noi-dung';
import type { IdPhanBo } from '../lib/phan-bo';
import Anh from './Anh.astro';

interface Props { phan: IdPhanBo; ngonNgu: NgonNgu; sizes: string; }
const { phan, ngonNgu, sizes } = Astro.props;
---
{phan === 'dau-than-ngoai' && <Anh id="phan-bo-dau-than-ngoai" ngonNgu={ngonNgu} khung="4x3" sizes={sizes} thayBang="khay" />}
{phan === 'de-suon' && <Anh id="phan-bo-de-suon" ngonNgu={ngonNgu} khung="4x3" sizes={sizes} thayBang="khay" />}
{phan === 'diem-than' && <Anh id="phan-bo-diem-than" ngonNgu={ngonNgu} khung="4x3" sizes={sizes} thayBang="khay" />}
{phan === 'nac-vai' && <Anh id="phan-bo-nac-vai" ngonNgu={ngonNgu} khung="4x3" sizes={sizes} thayBang="khay" />}
{phan === 'loi-vai' && <Anh id="phan-bo-loi-vai" ngonNgu={ngonNgu} khung="4x3" sizes={sizes} thayBang="khay" />}
