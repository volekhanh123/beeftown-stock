---
/**
 * TRANG TUYỂN DỤNG
 * ================
 * FORM CHỈ HIỆN KHI CÓ VỊ TRÍ THẬT ĐỂ NỘP VÀO.
 *
 * Điều kiện đầy đủ là: đã nối database, công tắc hien_tuyen_dung đang bật, và
 * có ít nhất một dòng vi_tri_tuyen_dung ở trạng thái da_cong_bo. Cả ba cùng
 * được trả lời bằng MỘT câu hỏi — tin_tuyen_dung_cong_khai() trả về mảng rỗng
 * hay không — vì chính hàm đó đã kiểm tra cả ba.
 *
 * Thiếu bất kỳ điều kiện nào thì trang hiện danh sách vị trí dự phòng cộng
 * câu hướng dẫn nhắn Facebook, và KHÔNG hiện form. Lý do không phải là gọn
 * gàng: nop_ho_so_ung_tuyen() cần một mã vị trí thật, nên một cái form hiện
 * lúc chưa có vị trí nào là cái ô mời người ta điền rồi báo lỗi.
 *
 * MỨC LƯƠNG KHÔNG HIỆN Ở ĐÂY. Bảng lương nằm trong tài liệu vận hành mật, và
 * ràng buộc vi_tri_luong_chi_khi_duyet trong database đòi phải có người duyệt
 * trước khi con số đó ra tới trang công khai. Đăng lương sai là một chuyện
 * khác hẳn đăng mô tả món sai.
 */
import { chu } from '../lib/chu';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import type { KetQuaNop } from '../lib/nop-ho-so';
import FormUngTuyen from './FormUngTuyen.astro';

export interface ViTri {
  ma: string;
  ten: string;
  bo_phan: string;
  loai_hop_dong: string;
  so_luong: number | null;
  mo_ta: string | null;
  yeu_cau: string | null;
  ca_lam: string | null;
  luong_tu: number | null;
  luong_den: number | null;
}

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  viTri: ViTri[];
  ketQuaNop?: KetQuaNop | null;
}
const { ngonNgu, noiDung: nd, viTri, ketQuaNop = null } = Astro.props;
const t = chu(ngonNgu);

// Danh sách dự phòng khi chưa nối database. Đây chỉ là TÊN VỊ TRÍ, lấy từ
// bảng mục lục tài liệu vận hành — không phải nội dung mật.
const DU_PHONG = [
  { ten_vi: 'Nhân viên sảnh',             ten_en: 'Hall staff',              bo_phan_vi: 'Sảnh',        bo_phan_en: 'Floor',    ca: true },
  { ten_vi: 'Tổ trưởng sảnh',             ten_en: 'Floor leader',            bo_phan_vi: 'Sảnh',        bo_phan_en: 'Floor',    ca: false },
  { ten_vi: 'Quản lý sảnh',               ten_en: 'Floor manager',           bo_phan_vi: 'Quản lý',     bo_phan_en: 'Management', ca: false },
  { ten_vi: 'Quản lý cửa hàng',           ten_en: 'Store manager',           bo_phan_vi: 'Quản lý',     bo_phan_en: 'Management', ca: false },
  { ten_vi: 'Nhân viên bếp',              ten_en: 'Kitchen staff',           bo_phan_vi: 'Bếp',         bo_phan_en: 'Kitchen',  ca: false },
  { ten_vi: 'Nhân viên bộ phận thịt',     ten_en: 'Meat department',         bo_phan_vi: 'Quầy thịt',   bo_phan_en: 'Meat counter', ca: false },
  { ten_vi: 'Nhân viên tư vấn quầy thịt', ten_en: 'Meat counter assistant',  bo_phan_vi: 'Quầy thịt',   bo_phan_en: 'Meat counter', ca: true },
  { ten_vi: 'Đầu mối marketing',          ten_en: 'Marketing coordinator',   bo_phan_vi: 'Marketing',   bo_phan_en: 'Marketing', ca: true },
];

const dungDuPhong = viTri.length === 0;

const nutNhanTin =
  nd.facebook_url ? { url: nd.facebook_url, chu: t.nhanTin } :
  nd.email_lien_he ? { url: `mailto:${nd.email_lien_he}`, chu: t.nhanTin } :
  null;

const nhanTheoCa = ngonNgu === 'en' ? 'Shift work' : 'Làm theo ca';
const nhanToanTG  = ngonNgu === 'en' ? 'Full time' : 'Toàn thời gian';
---

<section class="muc" style="padding-top:20px">
  <div class="khung">
    <p class="hieu">{ngonNgu === 'en' ? 'Careers' : 'Tuyển dụng'}</p>
    <h1 style="font-size:clamp(32px,6vw,58px)">{t.tuyenDungTieuDe}</h1>
    <p class="dan" style="max-width:58ch; margin-top:22px">{t.tuyenDungDan}</p>
  </div>
</section>

<section class="muc muc-sang">
  <div class="khung">
    <h2>{ngonNgu === 'en' ? 'Open roles' : 'Vị trí đang tuyển'}</h2>

    <div class="luoi" style="margin-top:26px">
      {dungDuPhong
        ? DU_PHONG.map((v) => (
            <div class="the vi-tri">
              <span class="nhan">{ngonNgu === 'en' ? v.bo_phan_en : v.bo_phan_vi}</span>
              <h3>{ngonNgu === 'en' ? v.ten_en : v.ten_vi}</h3>
              <p class="nho" style="margin:0">{v.ca ? nhanTheoCa : nhanToanTG}</p>
            </div>
          ))
        : viTri.map((v) => (
            <div class="the vi-tri">
              <span class="nhan">{v.bo_phan}</span>
              <h3>{v.ten}</h3>
              {v.ca_lam && <p class="nho" style="margin:0">{v.ca_lam}</p>}
              {v.so_luong && (
                <p class="nho" style="margin:0">
                  {ngonNgu === 'en' ? `${v.so_luong} positions` : `Cần ${v.so_luong} người`}
                </p>
              )}
              {v.mo_ta && <p style="margin:8px 0 0">{v.mo_ta}</p>}
              {v.yeu_cau && (
                <p class="nho" style="margin:8px 0 0">
                  <strong>{ngonNgu === 'en' ? 'Requirements: ' : 'Yêu cầu: '}</strong>
                  {v.yeu_cau}
                </p>
              )}
              {v.luong_tu && (
                <p style="margin:8px 0 0; font-weight:700; color:var(--do)">
                  {v.luong_tu.toLocaleString('vi-VN')}
                  {v.luong_den ? `–${v.luong_den.toLocaleString('vi-VN')}` : ''} đ
                </p>
              )}
            </div>
          ))}
    </div>

    {/*
      KẾT QUẢ ĐỨNG NGOÀI CÙNG, KIỂM TRƯỚC MỌI THỨ KHÁC.

      Bản đầu tiên đặt thẻ xác nhận LỒNG BÊN TRONG nhánh có-vị-trí-tuyển-dụng.
      Hệ quả: nếu giữa lúc POST và lúc GET mà danh sách vị trí rỗng đi — công
      tắc hien_tuyen_dung bị tắt, tin hết hạn, Supabase chớp một nhịp — thì
      ứng viên thấy màn hình "cổng chưa mở, nhắn Facebook" dù hồ sơ ĐÃ GHI vào
      database, và mã hồ sơ biến mất vĩnh viễn. Không có hàm tra cứu ngược,
      nên mất là mất hẳn.

      Trang đặt bàn vốn làm đúng. Hai trang lệch nhau đúng ở chỗ nguy hiểm
      nhất, nên giờ cả hai cùng một khuôn: đã có kết quả thì kết quả thắng.
    */}
    <div id="nop-ho-so" style="margin-top:30px">
      {ketQuaNop?.ok ? (
        /* Đã nộp xong: thẻ xác nhận thắng mọi thứ khác. */
        <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} />

      ) : dungDuPhong ? (
        <div class="the" style="max-width:62ch">
          {/* Lỗi mà lại không còn vị trí nào: vẫn phải nói cho người ta biết
              là chưa gửi được, chứ không im lặng đổi sang màn hình khác. */}
          {ketQuaNop && (
            <div style="border-left:4px solid var(--do);padding:12px 14px;margin:0 0 18px;background:rgba(178,58,44,.08)">
              <p style="margin:0"><strong>{ketQuaNop.cau}</strong></p>
            </div>
          )}
          <h3 style="margin-top:0">{ngonNgu === 'en' ? 'How to apply' : 'Cách ứng tuyển'}</h3>
          <p style="margin-bottom:0">{t.tuyenDungCachNop}</p>
          {!nutNhanTin && (
            <p class="nho" style="margin:14px 0 0">{t.tuyenDungChuaMo}</p>
          )}
          {nutNhanTin && (
            <div class="hang-nut" style="margin-top:18px">
              <a class="nut nut-chinh" href={nutNhanTin.url} rel="noopener">{nutNhanTin.chu}</a>
              {nd.hotline && (
                <a class="nut nut-vien" href={`tel:${nd.hotline.replace(/\s/g, '')}`}>
                  {t.goiNhaHang}
                </a>
              )}
            </div>
          )}
        </div>

      ) : (
        <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} />
      )}
    </div>

    <p class="nho" style="margin-top:22px; max-width:62ch">
      {ngonNgu === 'en'
        ? 'Beeftown only uses the details you send for hiring, and keeps them for six months.'
        : 'Beeftown chỉ dùng thông tin bạn gửi cho việc tuyển dụng, và lưu trong sáu tháng.'}
      {' '}
      <a href={ngonNgu === 'en' ? '/en/privacy' : '/quyen-rieng-tu'}>{t.quyenRiengTu}</a>
    </p>
  </div>
</section>
