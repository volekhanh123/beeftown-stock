     nên các nút cũng thẳng hàng dù mô tả dài ngắn khác nhau. */
  .td-nut-the { margin: auto 0 0; padding-top: var(--k-4); }

  /* "Xem chi tiết công việc": màu nút chính để thấy là bấm được; cao 48px cho
     ngón tay cái. */
  .chi-tiet { margin-top: var(--k-3); border-top: 1px solid var(--vien); }
  .chi-tiet > summary {
    cursor: pointer; font-weight: 700; color: var(--do);
    padding: var(--k-3) 0; min-height: 48px;
  }
  .chi-tiet > summary:focus-visible { outline: 2px solid var(--do); outline-offset: 2px; }

  /* ---- Khối nộp hồ sơ: cùng khuôn với .hb-luoi của trang hỏi bàn ------------ */
  .td-nop {
    display: grid; gap: var(--k-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
