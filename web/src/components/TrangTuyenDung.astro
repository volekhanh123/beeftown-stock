  }
  @media (min-width: 900px) {
    .td-nop { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--k-8); }
    /* Đã nộp: thẻ xác nhận đứng trước, cột rộng. */
    .td-nop-da-nhan { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  /* Form dài gấp mấy lần cột trái: cột trái dính theo khi cuộn (như .hb-ben), chỉ khi
     màn đủ cao để không cắt mất dòng lưu trữ và link Quyền riêng tư. */
  @media (min-width: 900px) and (min-height: 720px) {
    .td-nop:not(.td-nop-da-nhan) .td-ben { position: sticky; top: calc(var(--cao-dau) + var(--k-5)); }
  }
  .td-ben-tieu-de { font-size: var(--co-h3); line-height: 1.3; margin: 0 0 var(--k-3); }
  .td-cach-nop { margin: 0 0 var(--k-4); max-width: 46ch; }
  .td-luu-tru { margin: 0; max-width: 46ch; }

  /* ---- Thẻ liên hệ khi chưa có form (cùng dáng thẻ "chưa mở" của hỏi bàn; đệm theo .the) --- */
  .td-kenh { border-top: 4px solid var(--do); }
  .td-kenh-hinh {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--kem-dam); color: var(--do); margin-bottom: var(--k-4);
  }
  .td-kenh-hinh :global(svg) { width: 24px; height: 24px; }
  .td-kenh-cau { margin: 0; max-width: 56ch; }
  .td-kenh .hang-nut { margin-top: var(--k-5); }

  /* Khung lỗi của máy chủ: chữ than trên nền nhuộm đỏ nhạt, vạch đỏ đậm bên trái. */
  .td-loi {
    border-left: 4px solid var(--do-dam);
    background: rgba(137, 6, 7, .08);
    padding: var(--k-3) var(--k-4);
    margin: 0 0 var(--k-5);
  }
  .td-loi p { margin: 0; }
  /* Nhận con trỏ bằng script để trình đọc màn hình đọc ngay; không phải thứ bấm được. */
  .td-loi:focus { outline: none; }
  .td-kenh .td-loi + .hang-nut { margin-top: 0; }
</style>
