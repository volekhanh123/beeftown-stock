---
/**
 * TRANG TUYỂN DỤNG
 * ================
 * FORM CHỈ HIỆN KHI CÓ VỊ TRÍ THẬT ĐỂ NỘP VÀO.
 *
 * Điều kiện đầy đủ là: đã nối database, công tắc hien_tuyen_dung đang bật, và
 * có ít nhất một dòng vi_tri_tuyen_dung ở trạng thái da_cong_bo. Cả ba cùng
 * được trả lời bằng MỘT câu hỏi — tin_tuyen_dung_cong_khai() trả về mảng rỗng
 * hay không — vì chính hàm đó đã kiểm tra cả ba.
 *
 * Thiếu bất kỳ điều kiện nào thì trang hiện danh sách vị trí dự phòng cộng
 * câu hướng dẫn nhắn Facebook, và KHÔNG hiện form. Lý do không phải là gọn
 * gàng: nop_ho_so_ung_tuyen() cần một mã vị trí thật, nên một cái form hiện
 * lúc chưa có vị trí nào là cái ô mời người ta điền rồi báo lỗi.
 *
 * LƯỢT GỬI KHÔNG CHẮC ĐÃ GHI (ketQuaNop.khongChac — database không trả lời, xem
 * lib/xu-ly-form.ts): khung lỗi bảo "đừng gửi lại, nhắn Facebook để kiểm tra". Mọi
 * thứ quanh nó mời nộp — form trống ngay bên dưới, "Cách ứng tuyển", nút "Nộp hồ sơ",
 * "Ứng tuyển vị trí này" — đều cãi câu đó, và ứng viên nộp hai bản. Nên thẻ chỉ còn
 * khung lỗi và nút liên hệ, như thẻ "không chắc" của trang hỏi bàn. Muốn nộp lại thì
 * tải lại trang; database trả đúng mã cũ nếu hồ sơ y hệt đã vào (0081).
 *
 * MỨC LƯƠNG CHỈ HIỆN KHI ĐÃ DUYỆT. Bảng lương nằm trong tài liệu vận hành
 * mật, và ràng buộc vi_tri_luong_chi_khi_duyet trong database đòi phải có
 * người duyệt trước khi con số đó ra tới trang công khai; đơn vị giờ/tháng
 * cũng chỉ ra cùng con số (0028). Đăng lương sai là một chuyện khác hẳn đăng
 * mô tả món sai.
 */
import { chu, dich, duongDanTuongUng, type BaThuTieng } from '../lib/chu';
import { dinhDangNgay, type NgonNgu, type NoiDung } from '../lib/noi-dung';
import type { KetQuaNop } from '../lib/nop-ho-so';
import type { TruongForm } from '../lib/truong-form';
import { BO_PHAN, LOAI_HOP_DONG, dinhDangLuong, nhanEnum } from '../lib/tuyen-dung';
import { lienHe } from '../lib/trang-cong-khai';
import BieuTuong from './BieuTuong.astro';
import FormUngTuyen from './FormUngTuyen.astro';

/** Một tin đã công bố, kèm công tắc từng trường của form (0026). */
export interface ViTri extends TruongForm {
  ma: string;
  ten: string;
  bo_phan: string;
  cap_bac: string | null;
  /** null = chưa chốt (0043): thẻ không hiện dòng loại hợp đồng. */
  loai_hop_dong: string | null;
  so_luong: number | null;
  mo_ta: string | null;
  yeu_cau: string | null;
  quyen_loi: string | null;
  ca_lam: string | null;
  luong_tu: number | null;
  luong_den: number | null;
  luong_don_vi: string | null;
  han_nop: string | null;
}

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  viTri: ViTri[];
  ketQuaNop?: KetQuaNop | null;
}
const { ngonNgu, noiDung: nd, viTri, ketQuaNop = null } = Astro.props;
const t = chu(ngonNgu);

// Danh sách dự phòng khi chưa nối database: bốn vị trí đội mở cửa theo JD
// (BEEF_TOWN_Recruitment_EN_FINAL, 26/09/2026), cùng thứ tự với tin thật
// (tin_tuyen_dung_cong_khai xếp theo bộ phận rồi tên). Chỉ là TÊN VỊ TRÍ.
// Bộ phận ghi bằng MÃ enum và lấy nhãn từ BO_PHAN, giống hệt tin thật từ
// database — không giữ một bản nhãn thứ hai phải dịch lại mỗi khi thêm tiếng.
// Loại hợp đồng chỉ ghi khi JD đã chốt (sảnh: bán thời gian); chưa chốt thì
// null và thẻ không hiện dòng đó — không đoán thay nhà hàng.
// Tên tiếng Hàn giữ đúng ten_ko của tin thật (và câu dẫn trong chu.ts, gợi ý
// ở form, mô tả trang /ko/jobs cũng vậy): một vị trí chỉ có một tên trên
// trang Hàn — trước 26/09 tin ghi "홀 직원" mà form lại gọi "홀 크루".
const DU_PHONG: { ten: BaThuTieng; bo_phan: keyof typeof BO_PHAN; loai: keyof typeof LOAI_HOP_DONG | null }[] = [
  { ten: { vi: 'Nhân viên sảnh',                         en: 'Hall Crew',                             ko: '홀 직원' },               bo_phan: 'sanh',      loai: 'ban_thoi_gian' },
  { ten: { vi: 'Nhân viên bếp có kinh nghiệm',           en: 'Experienced Kitchen Crew',              ko: '경력 주방 직원' },        bo_phan: 'bep',       loai: null },
  { ten: { vi: 'Nhân viên đóng gói và hỗ trợ quầy thịt', en: 'Butcher Packaging & Counter Assistant', ko: '포장 및 정육 코너 보조 직원' }, bo_phan: 'quay_thit', loai: null },
  { ten: { vi: 'Thợ pha lóc thịt bò',                    en: 'Skilled Beef Trimmer',                  ko: '소고기 정육사' },   bo_phan: 'quay_thit', loai: null },
];

const dungDuPhong = viTri.length === 0;
// Cùng một cách đọc kênh liên hệ với mọi trang công khai (lib/trang-cong-khai.ts):
// chỉ link http(s), email đúng dạng và số điện thoại đúng dạng mới thành nút.
const lh = lienHe(nd);
const soGoi = lh.goi;
const daNop = ketQuaNop?.ok === true;
const khongChac = ketQuaNop?.khongChac === true;

// Nút "Ứng tuyển vị trí này" trên từng thẻ dẫn tới ?vi_tri=<mã>#nop-ho-so, và
// form chọn sẵn vị trí đó — không cần JavaScript. Chỉ nhận mã đang tuyển; mã
// lạ thì như không có.
const maTrenLink = Astro.url.searchParams.get('vi_tri');
const chonSan: Record<string, string> = maTrenLink && viTri.some(v => v.ma === maTrenLink) ? { vi_tri: maTrenLink } : {};

// Thẻ chỉ hiện câu đầu của mô tả (câu tóm tắt vai trò); phần còn lại của mô
// tả, yêu cầu và quyền lợi nằm trong "Xem chi tiết công việc". Để nguyên cả JD
// trên thẻ thì trên điện thoại form bị đẩy xuống gần 6.000px, sau bốn bản JD —
// ứng viên không tìm thấy chỗ nộp (26/09/2026).
const tachMoTa = (s: string | null) => {
  const i = s ? s.indexOf('\n') : -1;
  if (!s || i < 0) return { tomTat: s, conLai: null };
  return { tomTat: s.slice(0, i).trim(), conLai: s.slice(i + 1).trim() || null };
};
const theViTri = viTri.map(v => ({ v, ...tachMoTa(v.mo_ta) }));

// Nút nhắn tin: Facebook trước, không có thì email — và chữ trên nút nói đúng
// kênh đó (một link mailto ghi "Nhắn Beeftown" là hứa một thứ, mở ra thứ khác).
const nutNhanTin =
  lh.facebook ? { url: lh.facebook, chu: t.nhanTin } :
  lh.thu ? { url: lh.thu, chu: t.guiEmail } :
  null;
// Câu trong thẻ liên hệ nhắc tới Facebook. Chỉ có email thì câu đó chỉ sai đường,
// nên chỉ nói cổng trực tuyến chưa mở, còn nút email tự nói cách gửi.
const cauKenh = nutNhanTin && !lh.facebook ? 'chiEmail' : 'facebook';

// Database chỉ trả lương và đơn vị khi mức lương đã được duyệt (0012, 0028).
const mucLuong = (v: ViTri) => dinhDangLuong(v.luong_tu, v.luong_den, v.luong_don_vi, ngonNgu);

// Câu riêng của trang này; câu dùng chung nằm ở t = chu(ngonNgu).
const tRieng = dich(ngonNgu, {
  viTriDangTuyen: { vi: 'Vị trí đang tuyển', en: 'Open roles', ko: '채용 중인 포지션' },
  canNguoi: {
    vi: (n: number) => `Cần ${n} người`,
    en: (n: number) => (n === 1 ? '1 position' : `${n} positions`),
    ko: (n: number) => `${n}명 모집`,
  },
  yeuCau:         { vi: 'Yêu cầu: ', en: 'Requirements: ', ko: '자격 요건: ' },
  quyenLoi:       { vi: 'Quyền lợi: ', en: 'Benefits: ', ko: '복리후생: ' },
  hanNop:         { vi: 'Hạn nộp: ', en: 'Apply by ', ko: '지원 마감: ' },
  cachUngTuyen:   { vi: 'Cách ứng tuyển', en: 'How to apply', ko: '지원 방법' },
  nopHoSo:        { vi: 'Nộp hồ sơ', en: 'Apply now', ko: '지원하기' },
  ungTuyenViTri:  { vi: 'Ứng tuyển vị trí này', en: 'Apply for this role', ko: '이 포지션 지원하기' },
  xemChiTiet:     { vi: 'Xem chi tiết công việc', en: 'View role details', ko: '자세히 보기' },
  luuTru: {
    vi: 'Beeftown chỉ dùng thông tin bạn gửi cho việc tuyển dụng, và lưu trong sáu tháng.',
    en: 'Beeftown only uses the details you send for hiring, and keeps them for six months.',
    ko: 'Beeftown은 보내 주신 정보를 채용에만 사용하며, 6개월 동안 보관해요.',
  },
  // Câu đầu của t.tuyenDungChuaMo, cho lúc chỉ có email (xem cauKenh).
  chuaMoNgan: {
    vi: 'Cổng nộp hồ sơ trực tuyến chưa mở.',
    en: 'Online applications are not open yet.',
    ko: '온라인 지원 창구는 아직 열리지 않았어요.',
  },
});
---

{/* Đầu trang con chung của trang công khai (.mo-dau-trang, cong-khai.css):
    nền kem, nhãn đỏ, nét rosemary bên phải. */}
<section class="mo-dau-trang be-kem td-dau">
  <div class="khung">
    <p class="hieu">{t.tuyenDung}</p>
    <h1>{t.tuyenDungTieuDe}</h1>
    <p class="dan">{t.tuyenDungDan}</p>
    {!dungDuPhong && !khongChac && (
      <div class="hang-nut td-nut">
        <a class="nut nut-chinh" href="#nop-ho-so">{tRieng.nopHoSo}</a>
      </div>
    )}
  </div>
  <span class="trang-tri net huong-thao-5 net-goc" aria-hidden="true"></span>
</section>

<section class="muc be-kem-sau">
  <div class="khung">
    <h2>{tRieng.viTriDangTuyen}</h2>

    <div class="luoi td-luoi">
      {dungDuPhong
        ? DU_PHONG.map((v) => (
            <div class="the vi-tri">
              <span class="nhan">{nhanEnum(BO_PHAN, v.bo_phan, ngonNgu)}</span>
              <h3>{v.ten[ngonNgu]}</h3>
              {/* Cùng nhãn loại hợp đồng với tin thật. */}
              {v.loai && <p class="nho td-dong">{nhanEnum(LOAI_HOP_DONG, v.loai, ngonNgu)}</p>}
            </div>
          ))
        : theViTri.map(({ v, tomTat, conLai }) => (
            <div class="the vi-tri">
              <span class="nhan">{nhanEnum(BO_PHAN, v.bo_phan, ngonNgu)}</span>
              <h3>{v.ten}</h3>
              {v.cap_bac && <p class="nho td-dong">{v.cap_bac}</p>}
              {/* Loại hợp đồng chưa chốt thì không hiện — không đoán thay nhà hàng. */}
              {(v.loai_hop_dong || v.ca_lam) && (
                <p class="nho td-dong">
                  {[v.loai_hop_dong && nhanEnum(LOAI_HOP_DONG, v.loai_hop_dong, ngonNgu), v.ca_lam]
                    .filter(Boolean).join(' · ')}
                </p>
              )}
              {v.so_luong && (
                <p class="nho td-dong">
                  {tRieng.canNguoi(v.so_luong)}
                </p>
              )}
              {tomTat && <p class="td-doan">{tomTat}</p>}
              {mucLuong(v) && (
                <p class="td-doan td-luong">{mucLuong(v)}</p>
              )}
              {v.han_nop && (
                <p class="nho td-doan">
                  {tRieng.hanNop}{dinhDangNgay(v.han_nop, ngonNgu)}
                </p>
              )}
              {(conLai || v.yeu_cau || v.quyen_loi) && (
                <details class="chi-tiet">
                  <summary>{tRieng.xemChiTiet}</summary>
                  {/* pre-line: xuống dòng người soạn gõ ở màn nội bộ phải còn nguyên. */}
                  {conLai && <p class="td-doan td-giu-dong">{conLai}</p>}
                  {v.yeu_cau && (
                    <p class="nho td-doan td-giu-dong">
                      <strong>{tRieng.yeuCau}</strong>
                      {v.yeu_cau}
                    </p>
                  )}
                  {v.quyen_loi && (
                    <p class="nho td-doan td-giu-dong">
                      <strong>{tRieng.quyenLoi}</strong>
                      {v.quyen_loi}
                    </p>
                  )}
                </details>
              )}
              {!khongChac && (
                <p class="hang-nut td-nut-the">
                  <a class="nut nut-chinh" href={`?vi_tri=${encodeURIComponent(v.ma)}#nop-ho-so`}>{tRieng.ungTuyenViTri}</a>
                </p>
              )}
            </div>
          ))}
    </div>

    {/*
      KẾT QUẢ ĐỨNG NGOÀI CÙNG, KIỂM TRƯỚC MỌI THỨ KHÁC.

      Bản đầu tiên đặt thẻ xác nhận LỒNG BÊN TRONG nhánh có-vị-trí-tuyển-dụng.
      Hệ quả: nếu giữa lúc POST và lúc GET mà danh sách vị trí rỗng đi — công
      tắc hien_tuyen_dung bị tắt, tin hết hạn, Supabase chớp một nhịp — thì
      ứng viên thấy màn hình "cổng chưa mở, nhắn Facebook" dù hồ sơ ĐÃ GHI vào
      database, và mã hồ sơ biến mất vĩnh viễn. Không có hàm tra cứu ngược,
      nên mất là mất hẳn.

      Trang đặt bàn vốn làm đúng. Hai trang lệch nhau đúng ở chỗ nguy hiểm
      nhất, nên giờ cả hai cùng một khuôn: đã có kết quả thì kết quả thắng.

      Bố cục cũng cùng khuôn với trang hỏi bàn (.hb-luoi): từ 900px là hai cột
      5fr / 7fr — trái "Cách ứng tuyển" và dòng lưu trữ, phải là thẻ. Đã nộp
      xong thì thẻ xác nhận đứng TRƯỚC (cả trong mã lẫn trên màn hình, cột rộng
      7fr bên trái): ứng viên quay về #nop-ho-so là thấy nó đầu tiên, kể cả trên
      điện thoại.
    */}
    <div id="nop-ho-so" class:list={['td-nop', { 'td-nop-da-nhan': daNop || khongChac }]}>
      {daNop ? (
        <>
          {/* Đã nộp xong: thẻ xác nhận thắng mọi thứ khác. */}
          <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} />
          <div class="td-ben">
            <p class="nho td-luu-tru">{tRieng.luuTru} <a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a></p>
          </div>
        </>

      ) : khongChac ? (
        <>
          {/* Không chắc đã ghi: thẻ chỉ còn khung lỗi và nút liên hệ — không form, không
              "Cách ứng tuyển" (xem đầu file). Đứng trước, cột rộng, như thẻ đã nhận. */}
          <div class="the td-the td-kenh">
            <div class="td-loi" role="alert" data-ket-qua="khong-chac" tabindex="-1">
              <p><strong>{ketQuaNop?.cau}</strong></p>
            </div>
            {(nutNhanTin || soGoi) && (
              <div class="hang-nut">
                {nutNhanTin && (
                  <a class="nut nut-chinh" href={nutNhanTin.url} rel="noopener"><BieuTuong ten="tin-nhan" />{nutNhanTin.chu}</a>
                )}
                {soGoi && (
                  <a class="nut nut-vien" href={soGoi}><BieuTuong ten="dien-thoai" />{t.goiNhaHang}</a>
                )}
              </div>
            )}
          </div>
          <div class="td-ben">
            <p class="nho td-luu-tru">{tRieng.luuTru} <a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a></p>
          </div>
        </>

      ) : (
        <>
          <div class="td-ben">
            <h2 class="td-ben-tieu-de">{tRieng.cachUngTuyen}</h2>
            <p class="td-cach-nop">{t.tuyenDungCachNop}</p>
            <p class="nho td-luu-tru">{tRieng.luuTru} <a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a></p>
          </div>

          {dungDuPhong ? (
            <div class="the td-the td-kenh">
              {/* Lỗi mà lại không còn vị trí nào: vẫn phải nói cho người ta biết
                  là chưa gửi được, chứ không im lặng đổi sang màn hình khác. */}
              {ketQuaNop && (
                <div class="td-loi" role="alert" data-ket-qua="loi" tabindex="-1">
                  <p><strong>{ketQuaNop.cau}</strong></p>
                </div>
              )}
              <span class="td-kenh-hinh" aria-hidden="true"><BieuTuong ten="tin-nhan" /></span>
              <p class="td-kenh-cau">{cauKenh === 'chiEmail' ? tRieng.chuaMoNgan : t.tuyenDungChuaMo}</p>
              {(nutNhanTin || soGoi) && (
                <div class="hang-nut">
                  {nutNhanTin && (
                    <a class="nut nut-chinh" href={nutNhanTin.url} rel="noopener"><BieuTuong ten="tin-nhan" />{nutNhanTin.chu}</a>
                  )}
                  {soGoi && (
                    <a class="nut nut-vien" href={soGoi}><BieuTuong ten="dien-thoai" />{t.goiNhaHang}</a>
                  )}
                </div>
              )}
            </div>
          ) : (
            <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} daNhap={chonSan} />
          )}
        </>
      )}
    </div>
  </div>
</section>

<script>
  /*
   * Bổ trợ cho form nộp hồ sơ (FormUngTuyen.astro) — không có JavaScript thì form vẫn gửi được.
   * Cùng khuôn với script của TrangDatBan.astro.
   *
   * · Chặn bấm đúp: lần gửi thứ hai bị bỏ, nút khóa và ghi "Đang gửi…". Database cũng trả lại
   *   đúng mã cũ cho hồ sơ y hệt (0081) — script này để lượt thứ hai không phải đi tới đó.
   * · File CV lớn hơn 5MB: báo sát ô, không gửi — máy chủ từ chối cả hồ sơ khi thân quá lớn
   *   (lib/xu-ly-form.ts). Tin không hỏi CV (ô bị ẩn) mà vẫn còn file đã chọn: bỏ file trước khi
   *   gửi, máy chủ cũng bỏ nó (nop-ho-so.ts) — không đẩy vài MB đi cho không.
   * · Giữ chữ đã gõ: máy chủ KHÔNG trả lại các ô đã điền khi báo lỗi (POST → chuyển hướng → GET,
   *   kết quả qua cookie), nên trước khi gửi, các ô chữ được giữ trong sessionStorage của thẻ trình
   *   duyệt này 15 phút. Ô đồng ý KHÔNG được giữ: sự đồng ý phải là một cú bấm mới. File CV thì
   *   trình duyệt không cho điền lại.
   * · Đã nhận, hoặc KHÔNG CHẮC đã ghi: xóa bản giữ — câu trên trang bảo đừng gửi lại; điền sẵn mọi
   *   ô thì gửi lại chỉ còn một cú bấm.
   */
  const KHOA = 'bt-ung-tuyen';
  const SONG_MS = 15 * 60 * 1000;
  const CV_TOI_DA = 5 * 1024 * 1024;   // khớp CV_TOI_DA của lib/nop-ho-so.ts
  const O_CHU = ['vi_tri', 'ho_ten', 'sdt', 'email', 'nam_sinh', 'gioi_thieu', 'kinh_nghiem'] as const;
  type TenO = (typeof O_CHU)[number];
  type DaLuu = { luc: number; ca: string[] } & Record<TenO, string>;

  function docDaLuu(): DaLuu | null {
    try {
      const s = sessionStorage.getItem(KHOA);
      if (!s) return null;
      const d = JSON.parse(s) as Partial<DaLuu> | null;
      const tuoi = d && typeof d.luc === 'number' ? Date.now() - d.luc : NaN;
      if (!d || !(tuoi >= 0 && tuoi <= SONG_MS)) {
        sessionStorage.removeItem(KHOA);
        return null;
      }
      return d as DaLuu;
    } catch {
      // Chế độ riêng tư / bị chặn bộ nhớ: như không có gì được giữ.
      return null;
    }
  }
  function ghiDaLuu(d: DaLuu) {
    try { sessionStorage.setItem(KHOA, JSON.stringify(d)); } catch { /* không giữ được thì thôi */ }
  }
  function xoaDaLuu() {
    try { sessionStorage.removeItem(KHOA); } catch { /* như trên */ }
  }

  // --- Khung kết quả: đưa con trỏ tới đó (trình đọc màn hình đọc ngay) ---------
  // Sau sự kiện load: trang về kèm #nop-ho-so, và lúc cuộn tới mảnh đó trình duyệt bỏ tiêu điểm
  // đang có (về body) — focus() gọi sớm hơn thì mất.
  const khungKetQua = document.querySelector<HTMLElement>('#nop-ho-so [data-ket-qua]');
  if (khungKetQua?.dataset.ketQua === 'da-nhan' || khungKetQua?.dataset.ketQua === 'khong-chac') xoaDaLuu();
  if (khungKetQua) {
    const dua = () => setTimeout(() => khungKetQua.focus({ preventScroll: true }), 0);
    if (document.readyState === 'complete') dua(); else window.addEventListener('load', dua, { once: true });
  }

  const form = document.querySelector<HTMLFormElement>('form.form-nop');

  function oCua(f: HTMLFormElement, ten: string) {
    const o = f.elements.namedItem(ten);
    return o instanceof HTMLInputElement || o instanceof HTMLSelectElement || o instanceof HTMLTextAreaElement ? o : null;
  }

  // --- Điền lại chữ đã gõ (chỉ ô đang trống: vị trí chọn sẵn từ ?vi_tri= của máy chủ thắng) ---
  const daLuu = form ? docDaLuu() : null;
  if (form && daLuu) {
    for (const ten of O_CHU) {
      const o = oCua(form, ten);
      const v = daLuu[ten];
      if (!o || typeof v !== 'string' || !v || o.value) continue;
      if (o instanceof HTMLSelectElement) {
        if ([...o.options].some(op => op.value === v)) o.value = v;
      } else {
        o.value = v;
      }
    }
    if (Array.isArray(daLuu.ca)) {
      for (const c of form.querySelectorAll<HTMLInputElement>('input[name="ca"]')) {
        if (daLuu.ca.includes(c.value)) c.checked = true;
      }
    }
  }

  if (form) {
    const nut = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const chuNut = nut?.textContent ?? '';
    const oCv = form.querySelector<HTMLInputElement>('input[type="file"][name="cv"]');
    const loiCv = form.querySelector<HTMLElement>('[data-loi="cv"]');
    // Ô CV đang hiện không: tin không hỏi CV thì CSS ẩn cả nhãn (display: none → không có hộp nào).
    const cvDangHien = () => !!oCv && oCv.getClientRects().length > 0;
    const cvQuaLon = () => cvDangHien() && [...(oCv?.files ?? [])].some(f => f.size > CV_TOI_DA);
    const datLoiCv = (co: boolean) => {
      if (!oCv || !loiCv) return;
      if (co) {
        oCv.setAttribute('aria-invalid', 'true');
        loiCv.textContent = form.dataset.loiCv ?? '';
        loiCv.hidden = false;
      } else {
        oCv.removeAttribute('aria-invalid');
        loiCv.hidden = true;
        loiCv.textContent = '';
      }
    };
    oCv?.addEventListener('change', () => datLoiCv(cvQuaLon()));

    form.addEventListener('submit', (e) => {
      // Bấm đúp, hoặc Enter lần hai trong lúc trang đang đi: bỏ.
      if (form.dataset.dangGui) { e.preventDefault(); return; }

      if (oCv && oCv.files?.length && !cvDangHien()) oCv.value = '';
      if (cvQuaLon()) {
        e.preventDefault();
        datLoiCv(true);
        oCv?.focus();
        return;
      }

      const ra = { luc: Date.now(), ca: [...form.querySelectorAll<HTMLInputElement>('input[name="ca"]:checked')].map(c => c.value) } as DaLuu;
      for (const ten of O_CHU) ra[ten] = oCua(form, ten)?.value ?? '';
      ghiDaLuu(ra);

      form.dataset.dangGui = '1';
      if (nut) {
        nut.disabled = true;
        nut.setAttribute('aria-busy', 'true');
        nut.textContent = form.dataset.dangGuiChu ?? chuNut;
      }
    });

    // Quay lại trang này bằng nút Back (bộ nhớ đệm bfcache): trang hiện lại đúng như lúc rời
    // đi — nút đang khóa. Mở lại để ứng viên gửi được.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      delete form.dataset.dangGui;
      if (nut) {
        nut.disabled = false;
        nut.removeAttribute('aria-busy');
        nut.textContent = chuNut;
      }
    });
  }
</script>

