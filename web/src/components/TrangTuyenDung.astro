---
/**
 * TRANG TUYỂN DỤNG
 * ================
 * FORM CHỈ HIỆN KHI CÓ VỊ TRÍ THẬT ĐỂ NỘP VÀO.
 *
 * Điều kiện đầy đủ là: đã nối database, công tắc hien_tuyen_dung đang bật, và
 * có ít nhất một dòng vi_tri_tuyen_dung ở trạng thái da_cong_bo. Cả ba cùng
 * được trả lời bằng MỘT câu hỏi — tin_tuyen_dung_cong_khai() trả về mảng rỗng
 * hay không — vì chính hàm đó đã kiểm tra cả ba.
 *
 * Thiếu bất kỳ điều kiện nào thì trang hiện danh sách vị trí dự phòng cộng
 * câu hướng dẫn nhắn Facebook, và KHÔNG hiện form. Lý do không phải là gọn
 * gàng: nop_ho_so_ung_tuyen() cần một mã vị trí thật, nên một cái form hiện
 * lúc chưa có vị trí nào là cái ô mời người ta điền rồi báo lỗi.
 *
 * MỨC LƯƠNG CHỈ HIỆN KHI ĐÃ DUYỆT. Bảng lương nằm trong tài liệu vận hành
 * mật, và ràng buộc vi_tri_luong_chi_khi_duyet trong database đòi phải có
 * người duyệt trước khi con số đó ra tới trang công khai; đơn vị giờ/tháng
 * cũng chỉ ra cùng con số (0028). Đăng lương sai là một chuyện khác hẳn đăng
 * mô tả món sai.
 */
import { chu, dich, duongDanTuongUng, type BaThuTieng } from '../lib/chu';
import { dinhDangNgay, type NgonNgu, type NoiDung } from '../lib/noi-dung';
import type { KetQuaNop } from '../lib/nop-ho-so';
import type { TruongForm } from '../lib/truong-form';
import { BO_PHAN, LOAI_HOP_DONG, dinhDangLuong, nhanEnum } from '../lib/tuyen-dung';
import FormUngTuyen from './FormUngTuyen.astro';

/** Một tin đã công bố, kèm công tắc từng trường của form (0026). */
export interface ViTri extends TruongForm {
  ma: string;
  ten: string;
  bo_phan: string;
  cap_bac: string | null;
  loai_hop_dong: string;
  so_luong: number | null;
  mo_ta: string | null;
  yeu_cau: string | null;
  quyen_loi: string | null;
  ca_lam: string | null;
  luong_tu: number | null;
  luong_den: number | null;
  luong_don_vi: string | null;
  han_nop: string | null;
}

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  viTri: ViTri[];
  ketQuaNop?: KetQuaNop | null;
}
const { ngonNgu, noiDung: nd, viTri, ketQuaNop = null } = Astro.props;
const t = chu(ngonNgu);

// Danh sách dự phòng khi chưa nối database: bốn vị trí đội mở cửa theo JD
// (BEEF_TOWN_Recruitment_EN_FINAL, 26/09/2026), cùng thứ tự với tin thật
// (tin_tuyen_dung_cong_khai xếp theo bộ phận rồi tên). Chỉ là TÊN VỊ TRÍ.
// Bộ phận ghi bằng MÃ enum và lấy nhãn từ BO_PHAN, giống hệt tin thật từ
// database — không giữ một bản nhãn thứ hai phải dịch lại mỗi khi thêm tiếng.
// Loại hợp đồng chỉ ghi khi JD đã chốt (sảnh: bán thời gian); chưa chốt thì
// null và thẻ không hiện dòng đó — không đoán thay nhà hàng.
const DU_PHONG: { ten: BaThuTieng; bo_phan: keyof typeof BO_PHAN; loai: keyof typeof LOAI_HOP_DONG | null }[] = [
  { ten: { vi: 'Nhân viên sảnh',                         en: 'Hall Crew',                             ko: '홀 크루' },               bo_phan: 'sanh',      loai: 'ban_thoi_gian' },
  { ten: { vi: 'Nhân viên bếp có kinh nghiệm',           en: 'Experienced Kitchen Crew',              ko: '경력 주방 크루' },        bo_phan: 'bep',       loai: null },
  { ten: { vi: 'Nhân viên đóng gói và hỗ trợ quầy thịt', en: 'Butcher Packaging & Counter Assistant', ko: '정육 포장·코너 보조 직원' }, bo_phan: 'quay_thit', loai: null },
  { ten: { vi: 'Thợ pha lóc thịt bò',                    en: 'Skilled Beef Trimmer',                  ko: '숙련 정육 손질 직원' },   bo_phan: 'quay_thit', loai: null },
];

const dungDuPhong = viTri.length === 0;

const nutNhanTin =
  nd.facebook_url ? { url: nd.facebook_url, chu: t.nhanTin } :
  nd.email_lien_he ? { url: `mailto:${nd.email_lien_he}`, chu: t.nhanTin } :
  null;

// Database chỉ trả lương và đơn vị khi mức lương đã được duyệt (0012, 0028).
const mucLuong = (v: ViTri) => dinhDangLuong(v.luong_tu, v.luong_den, v.luong_don_vi, ngonNgu);

// Câu riêng của trang này; câu dùng chung nằm ở t = chu(ngonNgu).
const tRieng = dich(ngonNgu, {
  viTriDangTuyen: { vi: 'Vị trí đang tuyển', en: 'Open roles', ko: '채용 중인 포지션' },
  canNguoi: {
    vi: (n: number) => `Cần ${n} người`,
    en: (n: number) => `${n} positions`,
    ko: (n: number) => `${n}명 모집`,
  },
  yeuCau:         { vi: 'Yêu cầu: ', en: 'Requirements: ', ko: '자격 요건: ' },
  quyenLoi:       { vi: 'Quyền lợi: ', en: 'Benefits: ', ko: '복리후생: ' },
  hanNop:         { vi: 'Hạn nộp: ', en: 'Apply by ', ko: '지원 마감: ' },
  cachUngTuyen:   { vi: 'Cách ứng tuyển', en: 'How to apply', ko: '지원 방법' },
  luuTru: {
    vi: 'Beeftown chỉ dùng thông tin bạn gửi cho việc tuyển dụng, và lưu trong sáu tháng.',
    en: 'Beeftown only uses the details you send for hiring, and keeps them for six months.',
    ko: 'Beeftown은 보내 주신 정보를 채용에만 사용하며, 6개월 동안 보관해요.',
  },
});
---

<section class="muc" style="padding-top:20px">
  <div class="khung">
    <p class="hieu">{t.tuyenDung}</p>
    <h1 style="font-size:clamp(32px,6vw,58px)">{t.tuyenDungTieuDe}</h1>
    <p class="dan" style="max-width:58ch; margin-top:22px">{t.tuyenDungDan}</p>
  </div>
</section>

<section class="muc muc-sang">
  <div class="khung">
    <h2>{tRieng.viTriDangTuyen}</h2>

    <div class="luoi" style="margin-top:26px">
      {dungDuPhong
        ? DU_PHONG.map((v) => (
            <div class="the vi-tri">
              <span class="nhan">{nhanEnum(BO_PHAN, v.bo_phan, ngonNgu)}</span>
              <h3>{v.ten[ngonNgu]}</h3>
              {/* Cùng nhãn loại hợp đồng với tin thật. */}
              {v.loai && <p class="nho" style="margin:0">{nhanEnum(LOAI_HOP_DONG, v.loai, ngonNgu)}</p>}
            </div>
          ))
        : viTri.map((v) => (
            <div class="the vi-tri">
              <span class="nhan">{nhanEnum(BO_PHAN, v.bo_phan, ngonNgu)}</span>
              <h3>{v.ten}</h3>
              {v.cap_bac && <p class="nho" style="margin:0">{v.cap_bac}</p>}
              <p class="nho" style="margin:0">
                {nhanEnum(LOAI_HOP_DONG, v.loai_hop_dong, ngonNgu)}
                {v.ca_lam && ` · ${v.ca_lam}`}
              </p>
              {v.so_luong && (
                <p class="nho" style="margin:0">
                  {tRieng.canNguoi(v.so_luong)}
                </p>
              )}
              {/* pre-line: xuống dòng người soạn gõ ở màn nội bộ phải còn nguyên. */}
              {v.mo_ta && <p style="margin:8px 0 0;white-space:pre-line">{v.mo_ta}</p>}
              {v.yeu_cau && (
                <p class="nho" style="margin:8px 0 0;white-space:pre-line">
                  <strong>{tRieng.yeuCau}</strong>
                  {v.yeu_cau}
                </p>
              )}
              {v.quyen_loi && (
                <p class="nho" style="margin:8px 0 0;white-space:pre-line">
                  <strong>{tRieng.quyenLoi}</strong>
                  {v.quyen_loi}
                </p>
              )}
              {mucLuong(v) && (
                <p style="margin:8px 0 0; font-weight:700; color:var(--do)">{mucLuong(v)}</p>
              )}
              {v.han_nop && (
                <p class="nho" style="margin:8px 0 0">
                  {tRieng.hanNop}{dinhDangNgay(v.han_nop, ngonNgu)}
                </p>
              )}
            </div>
          ))}
    </div>

    {/*
      KẾT QUẢ ĐỨNG NGOÀI CÙNG, KIỂM TRƯỚC MỌI THỨ KHÁC.

      Bản đầu tiên đặt thẻ xác nhận LỒNG BÊN TRONG nhánh có-vị-trí-tuyển-dụng.
      Hệ quả: nếu giữa lúc POST và lúc GET mà danh sách vị trí rỗng đi — công
      tắc hien_tuyen_dung bị tắt, tin hết hạn, Supabase chớp một nhịp — thì
      ứng viên thấy màn hình "cổng chưa mở, nhắn Facebook" dù hồ sơ ĐÃ GHI vào
      database, và mã hồ sơ biến mất vĩnh viễn. Không có hàm tra cứu ngược,
      nên mất là mất hẳn.

      Trang đặt bàn vốn làm đúng. Hai trang lệch nhau đúng ở chỗ nguy hiểm
      nhất, nên giờ cả hai cùng một khuôn: đã có kết quả thì kết quả thắng.
    */}
    <div id="nop-ho-so" style="margin-top:30px">
      {ketQuaNop?.ok ? (
        /* Đã nộp xong: thẻ xác nhận thắng mọi thứ khác. */
        <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} />

      ) : dungDuPhong ? (
        <div class="the" style="max-width:62ch">
          {/* Lỗi mà lại không còn vị trí nào: vẫn phải nói cho người ta biết
              là chưa gửi được, chứ không im lặng đổi sang màn hình khác. */}
          {ketQuaNop && (
            <div style="border-left:4px solid var(--do);padding:12px 14px;margin:0 0 18px;background:rgba(178,58,44,.08)">
              <p style="margin:0"><strong>{ketQuaNop.cau}</strong></p>
            </div>
          )}
          <h3 style="margin-top:0">{tRieng.cachUngTuyen}</h3>
          <p style="margin-bottom:0">{t.tuyenDungCachNop}</p>
          {!nutNhanTin && (
            <p class="nho" style="margin:14px 0 0">{t.tuyenDungChuaMo}</p>
          )}
          {nutNhanTin && (
            <div class="hang-nut" style="margin-top:18px">
              <a class="nut nut-chinh" href={nutNhanTin.url} rel="noopener">{nutNhanTin.chu}</a>
              {nd.hotline && (
                <a class="nut nut-vien" href={`tel:${nd.hotline.replace(/\s/g, '')}`}>
                  {t.goiNhaHang}
                </a>
              )}
            </div>
          )}
        </div>

      ) : (
        <FormUngTuyen ngonNgu={ngonNgu} viTri={viTri} ketQua={ketQuaNop} nhanTin={nutNhanTin} />
      )}
    </div>

    <p class="nho" style="margin-top:22px; max-width:62ch">
      {tRieng.luuTru}
      {' '}
      <a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a>
    </p>
  </div>
</section>
