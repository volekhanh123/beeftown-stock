---
/**
 * TRANG ĐẾN BEEFTOWN — tầng 3, lối vào riêng, thang máy, ba bước tới bàn
 *
 * Điều khách phải biết TRƯỚC khi rủ cả nhà đi: Beeftown ở tầng 3, 63 Hồ Tùng Mậu;
 * khách vào bằng lối vào riêng ngay cạnh GS25 (Khánh quyết 09/10/2026) rồi đi thang
 * máy lên (Khánh xác nhận 11/10/2026: địa điểm có thang máy).
 *
 * Ba bước chỉ nói những gì đã xác nhận: tới 63 Hồ Tùng Mậu → lối vào riêng cạnh
 * GS25, thang máy lên tầng 3 → quầy bò. KHÔNG bịa chi tiết lối đi (cửa nào, rẽ trái
 * hay phải, mấy bước, mấy phút): chưa ai đi lại để ghi. Ảnh lối vào và thang máy là
 * KhungAnh cho tới khi có ảnh chụp thật (web/THIET-KE.md, brief chụp) — không ảnh AI cho
 * hai chỗ này: ảnh AI vẽ một cánh cửa, một thang máy không giống thật thì khách đi tìm dễ
 * lạc. Bước 3 (quầy) là ảnh AI TẠM quay-chon-bo, có nhãn "Ảnh minh họa" — Khánh quyết
 * 10/11/2026, tới khi có ảnh quầy chụp thật (src/lib/anh.ts, ngoại lệ ở đầu file).
 *
 * Khối hỏi đáp (24/11/2026): giờ mở cửa (chỉ khi đã công bố — gio-mo-cua.ts), khoảng chi tiêu mỗi người và chỗ gửi xe (cả hai
 * Khánh nói 24/11/2026: "300.000–500.000 đ/người", "ngay trước nhà hàng" — chỉ đúng chừng đó, không thêm VAT, đồ uống,
 * loại xe, phí), đường lên, đặt bàn (chỉ khi có kênh thật), "Beeftown này ở đâu?" — chữ hiện sẵn cho người và máy tìm
 * kiếm; cộng link viết đánh giá Google.
 *
 * Không có: mốc đường, khoảng cách, lối cho xe lăn (chưa xác nhận), bản đồ nhúng.
 * "Chỉ đường" chỉ hiện khi link Google Maps đã công bố (LenTang3); liên hệ chỉ hiện
 * mục đã công bố.
 */
import { chu, dich, duongDanTuongUng } from '../lib/chu';
import { LINK_DANH_GIA_GOOGLE, coKenhHoiBan, cumDiaChi, diaChi, formHoiBanMo, lienHe } from '../lib/trang-cong-khai';
import { cauGioMoCua, docGioMoCuaTrongLuot } from '../lib/gio-mo-cua';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import Anh from './Anh.astro';
import BieuTuong from './BieuTuong.astro';
import KhungAnh from './KhungAnh.astro';
import LenTang3 from './LenTang3.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; }
const { ngonNgu, noiDung: nd } = Astro.props;
const t = chu(ngonNgu);
const lh = lienHe(nd);
const dc = diaChi(nd);
// Địa chỉ xuống dòng ở dấu phẩy, không gãy giữa "Hồ Tùng / Mậu" (cumDiaChi: chữ giữ
// nguyên văn, cụm dài thì để tự xuống dòng — không tràn ngang trên điện thoại).
const email = lh.thu ? lh.thu.replace(/^mailto:/, '') : null;
const coLienHe = !!(lh.facebook || lh.goi || email);
const coKenh = coKenhHoiBan(nd);
const formMo = formHoiBanMo(nd);
// Giờ mở cửa: chỉ khi đã công bố — cùng khung giờ, cùng hai công tắc, cùng lần đọc với JSON-LD, chân trang và khối địa chỉ (gio-mo-cua.ts).
const cauGio = cauGioMoCua(await docGioMoCuaTrongLuot(Astro.request, nd), ngonNgu);
const cumDc = cumDiaChi(dc);

const c = dich(ngonNgu, {
  // --- Hỏi đáp (khối chữ hiện sẵn, không gập): giờ, đường lên, đặt bàn, "Beeftown này ở đâu?" -----------------
  hdHieu: { vi: 'Hỏi nhanh', en: 'Good to know', ko: '미리 알아 두세요' },
  hdTieuDe: { vi: 'Hỏi đáp trước khi đến', en: 'Before you visit', ko: '방문 전 자주 묻는 질문' },
  hdGioH: { vi: 'Beeftown mở cửa mấy giờ?', en: 'What are Beeftown’s opening hours?', ko: 'Beeftown 영업시간은 어떻게 되나요?' },
  // Khoảng chi tiêu mỗi người: đúng lời Khánh (24/11/2026), không nói gì thêm về VAT, đồ uống hay phần gồm trong giá.
  hdGiaH: { vi: 'Ăn ở Beeftown khoảng bao nhiêu tiền?', en: 'Roughly how much does a meal at Beeftown cost?', ko: 'Beeftown에서 식사하면 얼마 정도 드나요?' },
  hdGiaD: {
    vi: 'Khoảng 300.000–500.000 đ/người.',
    en: 'About 300,000–500,000 VND per person.',
    ko: '1인당 약 300,000–500,000동이에요.',
  },
  // Chỗ gửi xe: đúng lời Khánh (24/11/2026) — không loại xe, phí, tên bãi.
  hdXeH: { vi: 'Gửi xe ở đâu?', en: 'Where can I park?', ko: '주차는 어디에 하나요?' },
  hdXeD: {
    vi: 'Có chỗ gửi xe ngay trước nhà hàng.',
    en: 'Parking is right in front of the restaurant.',
    ko: '식당 바로 앞에 주차할 수 있어요.',
  },
  hdLenH: { vi: 'Lên Beeftown bằng lối nào?', en: 'How do I get up to Beeftown?', ko: 'Beeftown에는 어떻게 올라가나요?' },
  hdLenD: {
    vi: 'Beeftown ở Tầng 3 và có thang máy.',
    en: 'Beeftown is on Floor 3, and there is a lift.',
    ko: 'Beeftown은 3층에 있고, 엘리베이터가 있어요.',
  },
  hdDatH: { vi: 'Đặt bàn thế nào?', en: 'How do I book a table?', ko: '테이블 예약은 어떻게 하나요?' },
  // Hai câu này giữ đúng nghĩa của d5Form / d5Nhan trong CauHoi.astro: yêu cầu chưa phải là có bàn.
  hdDatForm: {
    vi: 'Bạn gửi yêu cầu ở trang Đặt bàn. Nhà hàng kiểm tra tình trạng bàn rồi liên hệ để xác nhận — bàn chỉ được giữ sau khi nhà hàng xác nhận với bạn.',
    en: 'Send a request on the Book a table page. We check availability and get in touch to confirm — a table is only held once we have confirmed it with you.',
    ko: '테이블 예약 페이지에서 요청을 보내 주세요. 매장에서 자리를 확인한 뒤 연락드릴게요. 자리는 매장에서 확인해 드린 뒤에만 잡혀요.',
  },
  hdDatNhan: {
    vi: 'Bạn báo cho Beeftown ngày, giờ và số người. Nhà hàng kiểm tra rồi liên hệ để xác nhận — bàn chỉ được giữ sau khi nhà hàng xác nhận với bạn.',
    en: 'Tell Beeftown the date, time and number of people. We will check and get back to you to confirm — a table is only held once we have confirmed it with you.',
    ko: '날짜, 시간, 인원을 Beeftown에 알려 주세요. 매장에서 확인한 뒤 연락드릴게요. 자리는 매장에서 확인해 드린 뒤에만 잡혀요.',
  },
  hdGoi: { vi: 'Cần hỏi nhanh? Gọi hotline:', en: 'Need a quick answer? Call the hotline:', ko: '빠른 답변이 필요하면 전화해 주세요:' },
  // Giúp khách và máy tìm kiếm phân biệt Beeftown này với nơi khác: tên, loại hình, địa chỉ — không thêm gì ngoài điều đã biết.
  hdOdauH: { vi: 'Beeftown này ở đâu?', en: 'Where is this Beeftown?', ko: '이 Beeftown은 어디에 있나요?' },
  hdOdauD: {
    vi: 'Đây là Beeftown, nhà hàng bò nướng tại bàn. Khách vào bằng lối riêng ngay cạnh GS25.',
    en: 'This is Beeftown, a beef restaurant with tabletop grilling. Guests use our own entrance, right next to GS25.',
    ko: '이곳은 테이블에서 굽는 소고기 전문점 Beeftown이에요. GS25 바로 옆 전용 입구로 들어오세요.',
  },

  // Tiêu đề khối địa chỉ: h1 đã nói "tầng 3", nên khối bên dưới gọi đúng việc nó làm.
  tieuDeDiaChi: { vi: 'Địa chỉ và lối lên', en: 'Address and the way up', ko: '주소와 올라오는 길' },
  tieuDe: { vi: 'Hẹn gặp bạn ở tầng 3', en: 'See you on Floor 3', ko: '3층에서 만나요' },
  dan: {
    vi: 'Beeftown ở 63 Hồ Tùng Mậu, Quận 1 cũ. Dưới đây là đường đi, từ lối vào riêng ngay cạnh GS25 tới quầy bò ở tầng 3.',
    en: 'Beeftown is at 63 Hồ Tùng Mậu, former District 1. Here is the way from our own entrance, right next to GS25, to the beef counter on Floor 3.',
    ko: 'Beeftown은 구 1군 Hồ Tùng Mậu 63에 있어요. GS25 바로 옆 전용 입구에서 3층 정육 코너까지 오시는 길을 안내해 드릴게요.',
  },

  // --- Ba bước tới bàn -------------------------------------------------------
  buocHieu: { vi: 'Đường lên', en: 'The way up', ko: '올라오는 길' },
  buocTieuDe: { vi: 'Ba bước tới bàn', en: 'Three steps to your table', ko: '테이블까지 세 걸음' },
  // Số nhà và tên đường giữ chữ Việt (lang="vi") — chữ khách thấy trên biển số.
  duong: { vi: '63 Hồ Tùng Mậu', en: '63 Hồ Tùng Mậu', ko: 'Hồ Tùng Mậu 63' },
  b1Truoc: { vi: 'Tới ', en: 'Come to ', ko: '' },
  b1Sau: { vi: '', en: '', ko: '으로 오세요' },
  b1Chu: { vi: 'Địa chỉ đầy đủ:', en: 'Full address:', ko: '전체 주소:' },
  // Dấu cách không ngắt (\u00a0): "tầng 3" / "Floor 3" không bị tách, số 3 không rơi một mình xuống dòng.
  b2TieuDe: { vi: 'Đi thang máy lên tầng\u00a03', en: 'Take the lift to Floor\u00a03', ko: '엘리베이터로 3층까지 올라오세요' },
  b2Chu: {
    vi: 'Lối vào riêng của Beeftown ở ngay cạnh GS25.',
    en: 'Our own entrance is right next to GS25.',
    ko: 'Beeftown 전용 입구는 GS25 바로 옆에 있어요.',
  },
  b3TieuDe: { vi: 'Ghé quầy chọn bò', en: 'Stop by the beef counter', ko: '정육 코너에서 고기를 고르세요' },
  b3Chu: {
    vi: 'Xem khay, đọc nhãn, rồi nhờ nhân viên tư vấn phần bò hợp với cả bàn.',
    en: 'Look over the trays, read the labels, and ask our staff which cut suits your table.',
    ko: '트레이와 라벨을 살펴보고, 테이블에 맞는 부위를 직원에게 추천받으세요.',
  },

  // --- Liên hệ ---------------------------------------------------------------
  lhHieu: { vi: 'Liên hệ', en: 'Contact', ko: '연락처' },
  lhTieuDe: { vi: 'Cần hỏi gì trước khi tới?', en: 'Questions before you come?', ko: '오시기 전에 궁금한 점이 있으신가요?' },
  dienThoai: { vi: 'Điện thoại', en: 'Phone', ko: '전화' },
  email: { vi: 'Email', en: 'Email', ko: '이메일' },

  // --- Cuối trang ------------------------------------------------------------
  moiHieu: { vi: 'Đi cùng nhau', en: 'Coming together', ko: '함께 오실 때' },
  // Hai câu của tiêu đề xuống dòng ở giữa hai câu, không gãy giữa một câu.
  moiTieuDe1: { vi: 'Đã chọn được ngày?', en: 'Picked a day?', ko: '날짜를 정하셨나요?' },
  moiTieuDe2: { vi: 'Đặt bàn trước nhé.', en: 'Book a table first.', ko: '테이블을 먼저 예약해 주세요.' },
  moiDan: {
    vi: 'Cho Beeftown biết ngày và số người. Nhà hàng kiểm tra rồi liên hệ để xác nhận với bạn.',
    en: 'Tell us the day and how many of you are coming. We will check and contact you to confirm.',
    ko: '날짜와 인원을 알려 주세요. 매장에서 확인한 뒤 연락드릴게요.',
  },
  moiTieuDeMenu1: { vi: 'Trước khi tới,', en: 'Before you come,', ko: '오시기 전에' },
  moiTieuDeMenu2: { vi: 'xem qua thực đơn', en: 'have a look at the menu', ko: '메뉴를 먼저 살펴보세요' },
  moiDanMenu: {
    vi: 'Bò chọn tại quầy, cùng món ăn và đồ uống cho cả bàn.',
    en: 'Beef you pick at the counter, plus dishes and drinks for the whole table.',
    ko: '정육 코너에서 고르는 소고기와 테이블에서 함께 나누는 요리, 음료가 있어요.',
  },
});
---
<section class="mo-dau-trang be-kem" aria-labelledby="db-tieu-de">
  <div class="khung">
    <p class="hieu">{t.denBeeftown}</p>
    <h1 id="db-tieu-de">{c.tieuDe}</h1>
    <p class="dan">{c.dan}</p>
  </div>
</section>

<section class="muc be-kem-dam db-tang3">
  <div class="khung">
    <LenTang3 ngonNgu={ngonNgu} noiDung={nd} khongLinkDuongDen anHieu tieuDe={c.tieuDeDiaChi} />
  </div>
</section>

{/* Ba bước: lệch bậc trên màn rộng, đi lên dần — bước 1 thấp nhất. */}
<section class="muc be-toi db-buoc" aria-labelledby="db-h-buoc">
  <div class="khung">
    <p class="hieu">{c.buocHieu}</p>
    <h2 id="db-h-buoc">{c.buocTieuDe}</h2>
    <ol class="db-ds" role="list">
      <li class="db-muc">
        <KhungAnh loai="loi-vao" tiLe="4 / 3" nen="toi" />
        <div class="db-chu">
          <span class="db-so" aria-hidden="true">1</span>
          <div>
            <h3>{c.b1Truoc}<span lang="vi" class="lien">{c.duong}</span>{c.b1Sau}</h3>
            <p>{c.b1Chu} <span lang="vi">{cumDiaChi(dc).map(cum => <><span class:list={{ lien: cum.giu }}>{cum.chu}</span>{cum.cach}</>)}</span></p>
          </div>
        </div>
      </li>
      <li class="db-muc">
        <KhungAnh loai="thang-may" tiLe="4 / 3" nen="toi" />
        <div class="db-chu">
          <span class="db-so" aria-hidden="true">2</span>
          <div>
            <h3>{c.b2TieuDe}</h3>
            <p>{c.b2Chu}</p>
          </div>
        </div>
      </li>
      <li class="db-muc">
        <Anh id="quay-chon-bo" ngonNgu={ngonNgu} khung="4x3" thayBang="quay" nenKhung="toi"
             sizes="(min-width: 1280px) 380px, (min-width: 900px) 30vw, (min-width: 600px) 42vw, calc(100vw - 40px)" />
        <div class="db-chu">
          <span class="db-so" aria-hidden="true">3</span>
          <div>
            <h3>{c.b3TieuDe}</h3>
            <p>{c.b3Chu}</p>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

{/* Hỏi đáp: chữ hiện sẵn (không gập), ngắn, mỗi câu trả lời chỉ nói điều đã biết. Giờ mở cửa chỉ khi đã công bố (cauGio),
    câu đặt bàn chỉ khi có kênh thật để hỏi (như khối cuối trang) — không câu nào dẫn tới hư không. Không chỗ gửi xe, mốc đường,
    khoảng cách, loại xe, phí gửi xe: chưa ai xác nhận (đầu file). Mỗi thẻ viết liền trên một dòng: compressHTML bỏ dấu cách có xuống dòng cạnh thẻ. */}
<section class="muc be-kem db-hoi-dap" aria-labelledby="db-h-hd">
  <div class="khung db-hd-luoi">
    <div>
      <p class="hieu">{c.hdHieu}</p>
      <h2 id="db-h-hd">{c.hdTieuDe}</h2>
    </div>
    <div>
      <dl class="db-hd-ds">
        {cauGio && (
          <div class="db-hd-muc">
            <dt>{c.hdGioH}</dt>
            <dd><p>{cauGio}</p></dd>
          </div>
        )}
        <div class="db-hd-muc">
          <dt>{c.hdGiaH}</dt>
          <dd><p>{c.hdGiaD}</p></dd>
        </div>
        <div class="db-hd-muc">
          <dt>{c.hdLenH}</dt>
          <dd>
            <p>{c.hdLenD}</p>
            <p>{t.loiLen}</p>
          </dd>
        </div>
        <div class="db-hd-muc">
          <dt>{c.hdXeH}</dt>
          <dd><p>{c.hdXeD}</p></dd>
        </div>
        {coKenh && (
          <div class="db-hd-muc">
            <dt>{c.hdDatH}</dt>
            <dd>
              <p>{formMo ? c.hdDatForm : c.hdDatNhan}</p>
              <p><a class="lien-ket" href={duongDanTuongUng('/dat-ban', ngonNgu)}>{t.datBan}<BieuTuong ten="mui-ten" /></a></p>
              {lh.goi && <p>{c.hdGoi} <a class="lien-ket" href={lh.goi}>{lh.hotline}</a></p>}
            </dd>
          </div>
        )}
        <div class="db-hd-muc">
          <dt>{c.hdOdauH}</dt>
          <dd>
            <p>Beeftown · <span lang="vi">{cumDc.map(cum => <><span class:list={{ lien: cum.giu }}>{cum.chu}</span>{cum.cach}</>)}</span></p>
            <p>{c.hdOdauD}</p>
          </dd>
        </div>
      </dl>
      <p class="db-hd-danh-gia"><a class="lien-ket" href={LINK_DANH_GIA_GOOGLE} rel="noopener">{t.danhGiaGoogle}<BieuTuong ten="mui-ten" /></a></p>
    </div>
  </div>
</section>

{/* Liên hệ: chỉ mục đã công bố trong /noi-bo — chưa có mục nào thì bỏ cả khối. */}
{coLienHe && (
  <section class="muc be-kem db-lien-he" aria-labelledby="db-h-lh">
    <div class="khung db-lh-luoi">
      <div>
        <p class="hieu">{c.lhHieu}</p>
        <h2 id="db-h-lh">{c.lhTieuDe}</h2>
      </div>
      <dl class="db-lh-ds">
        {lh.facebook && (
          <div class="db-lh-dong">
            <dt>Facebook</dt>
            <dd><a class="lien-ket" href={lh.facebook} rel="noopener">{t.nhanTin}<BieuTuong ten="mui-ten" /></a></dd>
          </div>
        )}
        {lh.goi && (
          <div class="db-lh-dong">
            <dt>{c.dienThoai}</dt>
            <dd><a class="lien-ket" href={lh.goi}><BieuTuong ten="dien-thoai" />{lh.hotline}</a></dd>
          </div>
        )}
        {email && lh.thu && (
          <div class="db-lh-dong">
            <dt>{c.email}</dt>
            <dd><a class="lien-ket db-thu" href={lh.thu}>{email}</a></dd>
          </div>
        )}
      </dl>
    </div>
  </section>
)}

{/* Cuối trang: Hỏi bàn chỉ khi có kênh thật để hỏi; Xem thực đơn luôn có. Dải đỏ phẳng — không hoa
    văn, không nét vẽ. */}
<section class="muc be-do db-moi" aria-labelledby="db-h-moi">
  <div class="khung db-moi-chu">
    <p class="hieu">{c.moiHieu}</p>
