---
/**
 * CẢ BỮA, CHO CẢ BÀN — món đi cùng và đồ uống
 *
 * Giúp người rủ nhóm hình dung cả bữa. Chỉ nhắc các NHÓM món đã xác nhận bán từ
 * ngày đầu (brief 06/10/2026; nhom_mon trong migration 0011). Tên từng món, mô tả,
 * giá nằm ở trang Thực đơn và chỉ hiện khi Khánh công bố — không lặp ở đây.
 * Không dựng combo, khẩu phần hay giá từ một mức chi tiêu dự kiến.
 *
 * Đồ uống có cồn chỉ được nhắc khi công tắc hien_do_uong_co_con bật — cùng công
 * tắc database dùng để ẩn chúng khỏi thực đơn (luật quảng cáo rượu bia).
 */
import { chu, dich, duongDanTuongUng } from '../lib/chu';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import Anh from './Anh.astro';
import BieuTuong from './BieuTuong.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; }
const { ngonNgu, noiDung: nd } = Astro.props;
const tChung = chu(ngonNgu);
const coCon = nd.hien_do_uong_co_con === true;
const t = dich(ngonNgu, {
  hieu: { vi: 'Thực đơn', en: 'The menu', ko: '메뉴' },
  tieuDe: { vi: 'Cả bữa, cho cả bàn', en: 'A whole meal, for the whole table', ko: '테이블 모두를 위한 한 끼' },
  dan: {
    vi: 'Bên cạnh bò nướng, Beeftown có món ăn kiểu Hàn – Âu và đồ uống để cả bàn cùng gọi, cùng chia.',
    en: 'Alongside the grill, Beeftown has Korean and Western dishes and drinks for the whole table to order and share.',
    ko: '구이와 함께 곁들일 한식·양식 메뉴와 음료도 있어요. 테이블에서 함께 주문해 나눠 드세요.',
  },
  monAn: { vi: 'Món ăn', en: 'Dishes', ko: '식사 메뉴' },
  doUong: { vi: 'Đồ uống', en: 'Drinks', ko: '음료' },
  goiThem: { vi: 'Gọi thêm', en: 'Add-ons', ko: '추가 주문' },
  salad: { vi: 'Salad & khai vị', en: 'Salads & starters', ko: '샐러드 · 전채' },
  com: { vi: 'Cơm', en: 'Rice', ko: '밥' },
  miY: { vi: 'Mì Ý', en: 'Pasta', ko: '파스타' },
  mien: { vi: 'Miến & mì lạnh', en: 'Noodles', ko: '당면 · 냉면' },
  canh: { vi: 'Canh Hàn', en: 'Korean stews', ko: '찌개' },
  lau: { vi: 'Lẩu', en: 'Hot pot', ko: '전골' },
  trangMieng: { vi: 'Tráng miệng', en: 'Desserts', ko: '디저트' },
  nuocEp: { vi: 'Nước ép & ade', en: 'Juices & ades', ko: '주스 · 에이드' },
  highball: { vi: 'Highball', en: 'Highball', ko: '하이볼' },
  makgeolli: { vi: 'Makgeolli', en: 'Makgeolli', ko: '막걸리' },
  cocktail: { vi: 'Cocktail', en: 'Cocktails', ko: '칵테일' },
  setSot: {
    vi: 'Set sốt cho phần nướng — tùy chọn',
    en: 'Sauce set for the grill — optional',
    ko: '구이용 소스 세트 — 선택',
  },
});
const MON_AN = [t.salad, t.com, t.miY, t.mien, t.canh, t.lau, t.trangMieng];
const DO_UONG = [t.nuocEp, ...(coCon ? [t.highball, t.makgeolli, t.cocktail] : [])];
---
<section class="muc be-kem-dam bacn" aria-labelledby="bacn-tieu-de">
  <div class="khung bacn-luoi">
    <div class="bacn-anh">
      <Anh id="sot-cham" ngonNgu={ngonNgu} khung="4x3" thayBang="ban-nuong" sizes="(min-width: 900px) 45vw, 100vw" />
    </div>
    <div class="bacn-chu">
      <p class="hieu">{t.hieu}</p>
      <h2 id="bacn-tieu-de">{t.tieuDe}</h2>
      <p class="dan">{t.dan}</p>
      <div class="bacn-nhom">
        <div>
          <h3>{t.monAn}</h3>
          <ul>{MON_AN.map(m => <li>{m}</li>)}</ul>
        </div>
        <div>
          <h3>{t.doUong}</h3>
          <ul>{DO_UONG.map(m => <li>{m}</li>)}</ul>
          <h3 class="bacn-goi-them">{t.goiThem}</h3>
          <ul><li>{t.setSot}</li></ul>
        </div>
      </div>
      <a class="nut nut-chinh" href={duongDanTuongUng('/thuc-don', ngonNgu)}>{tChung.xemMenu}<BieuTuong ten="mui-ten" /></a>
    </div>
  </div>
</section>

<style>
  .bacn-luoi { display: grid; gap: var(--k-7); align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .bacn-luoi { grid-template-columns: 6fr 5fr; gap: var(--k-8); } }
  .bacn-chu .dan { margin-bottom: var(--k-6); }

  .bacn-nhom {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--k-5);
    margin-bottom: var(--k-6);
    padding-top: var(--k-5); border-top: 2px solid var(--do);
  }
  .bacn-nhom h3 {
    font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: var(--do-sau); margin: 0 0 var(--k-3);
  }
  .bacn-nhom ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .bacn-nhom li { font-weight: 600; line-height: 1.4; }
  .bacn-goi-them { margin-top: var(--k-5) !important; }
</style>
