---
/**
 * FORM ỨNG TUYỂN
 *
 * ĐIỀU KIỆN ĐỂ FORM NÀY TỒN TẠI: phải có ít nhất một vị trí ĐÃ CÔNG BỐ trong
 * database. Không có thì component này không được gọi — trang hiện khối
 * "nhắn Facebook" thay thế.
 *
 * Lý do không phải là gọn gàng mà là đúng: nop_ho_so_ung_tuyen() cần một mã
 * vị trí thật. Hiện form lên khi chưa có vị trí nào nghĩa là dựng một cái ô
 * để người ta điền rồi báo lỗi — tệ hơn hẳn việc nói thẳng "chưa mở, nhắn
 * Facebook nhé".
 *
 * KHÔNG CÓ JAVASCRIPT. Ứng viên phục vụ và phụ bếp dùng điện thoại rẻ, mạng
 * 4G chập chờn. Form HTML thuần gửi được ngay khi phần HTML tải xong.
 *
 * MỖI TIN HỎI MỘT BỘ TRƯỜNG RIÊNG (0026) — cũng không cần JavaScript. Mỗi
 * <option> mang danh sách trường mà tin đó KHÔNG hỏi; CSS :has() ẩn các ô
 * đó khi option được chọn. Trình duyệt quá cũ không hiểu :has() thì thấy đủ
 * mọi ô — vô hại: database bỏ giá trị của trường tin không hỏi, và
 * nop-ho-so.ts không tải CV lên cho tin không hỏi CV.
 */
import type { NgonNgu } from '../lib/noi-dung';
import { dich } from '../lib/chu';
import type { ViTri } from './TrangTuyenDung.astro';
import type { KetQuaNop } from '../lib/nop-ho-so';
import { TRUONG_FORM } from '../lib/truong-form';
import { BO_PHAN, nhanEnum } from '../lib/tuyen-dung';

interface Props {
  ngonNgu: NgonNgu;
  viTri: ViTri[];
  ketQua: KetQuaNop | null;
  /** Dùng khi form vừa lỗi, để không bắt người ta gõ lại từ đầu. */
  daNhap?: Record<string, string>;
  /** Nút nhắn tin, hiện kèm mọi câu lỗi để khách luôn có đường khác. */
  nhanTin?: { url: string; chu: string } | null;
}
const { ngonNgu, viTri, ketQua, daNhap = {}, nhanTin } = Astro.props;

// Mốc thời gian để server tính số giây điền form. Không cần JavaScript.
const moc = Date.now();

/** Các trường tin này KHÔNG hỏi, dạng "email cv" — CSS cuối file đọc nó. */
const truongAn = (v: ViTri) =>
  TRUONG_FORM.filter(f => v[f.cot] === false).map(f => f.lop).join(' ') || undefined;

// Mã ca (value) là thứ database lưu, nên giữ nguyên ở mọi ngôn ngữ; chỉ nhãn đổi.
const CA = dich(ngonNgu, {
  sang:      { vi: 'Ca sáng', en: 'Morning', ko: '오전' },
  chieu:     { vi: 'Ca chiều', en: 'Afternoon', ko: '오후' },
  toi:       { vi: 'Ca tối', en: 'Evening', ko: '저녁' },
  cuoi_tuan: { vi: 'Cuối tuần', en: 'Weekends', ko: '주말' },
});

const t = dich(ngonNgu, {
  tieuDe:  { vi: 'Nộp hồ sơ trực tuyến', en: 'Apply online', ko: '온라인 지원' },
  viTri:   { vi: 'Vị trí muốn ứng tuyển', en: 'Which role', ko: '지원 포지션' },
  chon:    { vi: '— chọn vị trí —', en: '— choose a role —', ko: '— 포지션 선택 —' },
  hoTen:   { vi: 'Họ và tên', en: 'Full name', ko: '이름' },
  sdt:     { vi: 'Số điện thoại', en: 'Phone number', ko: '전화번호' },
  sdtPhu: {
    vi: 'Beeftown sẽ gọi lại cho bạn ở số này.',
    en: 'Beeftown will call you back on this number.',
    ko: 'Beeftown에서 이 번호로 다시 전화드려요.',
  },
  email:   { vi: 'Email (không bắt buộc)', en: 'Email (optional)', ko: '이메일 (선택)' },
  namSinh: { vi: 'Năm sinh (không bắt buộc)', en: 'Year of birth (optional)', ko: '출생 연도 (선택)' },
  ca:      { vi: 'Ca bạn làm được', en: 'Shifts you can work', ko: '근무 가능한 시간대' },
  gioiThieu: {
    vi: 'Đôi dòng về bạn (không bắt buộc)',
    en: 'A few words about yourself (optional)',
    ko: '간단한 자기소개 (선택)',
  },
  kinhNghiem: {
    vi: 'Kinh nghiệm đã có (không bắt buộc)',
    en: 'Previous experience (optional)',
    ko: '경력 사항 (선택)',
  },
  kinhNghiemPhu: {
    vi: 'Vị trí sảnh nhận cả người chưa có kinh nghiệm — chưa có thì để trống.',
    en: 'No experience is needed for Hall Crew — leave this empty if you have none.',
    ko: '홀 크루는 경력이 없어도 지원할 수 있어요. 경력이 없으면 비워 두세요.',
  },
  cv:      { vi: 'Đính kèm CV (không bắt buộc)', en: 'Attach a CV (optional)', ko: '이력서 첨부 (선택)' },
  cvPhu: {
    vi: 'File PDF, Word hoặc ảnh chụp, tối đa 5MB. Không bắt buộc.',
    en: 'PDF, Word or a photo, up to 5MB. Not required.',
    ko: 'PDF, Word 파일 또는 사진, 최대 5MB까지 올릴 수 있어요. 필수는 아니에요.',
  },
  dongY: {
    vi: 'Tôi đồng ý để Beeftown lưu và sử dụng thông tin trong hồ sơ này cho mục đích tuyển dụng, trong vòng 6 tháng kể từ ngày nộp.',
    en: 'I agree to let Beeftown store and use the information in this application for hiring, for six months from the date of submission.',
    ko: 'Beeftown이 이 지원서의 정보를 채용 목적으로 제출일로부터 6개월 동안 보관하고 이용하는 데 동의해요.',
  },
  gui:     { vi: 'Gửi hồ sơ', en: 'Send application', ko: '지원서 보내기' },
  batBuoc: { vi: 'bắt buộc', en: 'required', ko: '필수' },

  // --- Màn hình sau khi gửi ---
  daNhan: {
    vi: 'Beeftown đã nhận hồ sơ của bạn',
    en: 'Beeftown has received your application',
    ko: 'Beeftown에 지원서가 접수되었어요',
  },
  maHoSo:  { vi: 'Mã hồ sơ của bạn: ', en: 'Your reference code: ', ko: '접수 번호: ' },
  giuMa: {
    vi: 'Bạn giữ mã này để nhắc tới khi nhà hàng gọi. Beeftown sẽ gọi lại cho bạn ở số bạn vừa điền.',
    en: 'Keep this code to mention when we call. Beeftown will call you back on the number you gave us.',
    ko: '매장에서 전화드릴 때 말씀해 주실 수 있게 이 번호를 기억해 두세요. Beeftown에서 입력하신 번호로 다시 전화드려요.',
  },
  nhanThang: {
    vi: 'Bạn cũng có thể nhắn thẳng cho Beeftown: ',
    en: 'You can also message us directly: ',
    ko: 'Beeftown에 직접 메시지를 보내셔도 돼요: ',
  },
});
---

{ketQua?.ok ? (
  <div class="the" style="max-width:62ch;border-left:4px solid var(--cuc-vang)">
    <h3 style="margin-top:0">{t.daNhan}</h3>
    {ketQua.ma && (
      <p>
        {t.maHoSo}
        <strong style="letter-spacing:.06em">{ketQua.ma}</strong>
      </p>
    )}
    <p>{t.giuMa}</p>
    {ketQua.luuY && <p class="nho" style="margin-bottom:0">{ketQua.luuY}</p>}
  </div>
) : (
  <div class="the" style="max-width:62ch">
    <h3 style="margin-top:0">{t.tieuDe}</h3>

    {ketQua && !ketQua.ok && (
      <div style="border-left:4px solid var(--do);padding:12px 14px;margin:0 0 18px;background:rgba(178,58,44,.08)">
        <p style="margin:0"><strong>{ketQua.cau}</strong></p>
        {nhanTin && (
          <p class="nho" style="margin:10px 0 0">
            {t.nhanThang}
            <a href={nhanTin.url} rel="noopener">{nhanTin.chu}</a>
          </p>
        )}
      </div>
    )}

    <form method="POST" enctype="multipart/form-data" class="form-nop">
      <input type="hidden" name="moc" value={String(moc)} />
      <input type="hidden" name="viec" value="ung_tuyen" />

      {/*
        Bẫy bot. Bot điền mọi ô nó thấy trong HTML; người không thấy ô này.
        Ẩn bằng CSS chứ không dùng type="hidden" — một input hidden thì bot
        biết là bẫy, một input nhìn giống thật thì nó điền.
        aria-hidden + tabindex để người dùng bàn phím và đọc màn hình bỏ qua.
      */}
      <div class="bay" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="o">
        <span>{t.viTri} <em>({t.batBuoc})</em></span>
        <select name="vi_tri" required>
          <option value="">{t.chon}</option>
          {viTri.map(v => (
            <option value={v.ma} selected={daNhap.vi_tri === v.ma} data-an={truongAn(v)}>
              {v.ten}{v.bo_phan ? ` — ${nhanEnum(BO_PHAN, v.bo_phan, ngonNgu)}` : ''}
            </option>
          ))}
        </select>
      </label>

      <label class="o">
        <span>{t.hoTen} <em>({t.batBuoc})</em></span>
        <input type="text" name="ho_ten" required value={daNhap.ho_ten ?? ''}
               autocomplete="name" autocapitalize="words" />
      </label>

      <label class="o">
        <span>{t.sdt} <em>({t.batBuoc})</em></span>
        <small>{t.sdtPhu}</small>
        <input type="tel" name="sdt" required value={daNhap.sdt ?? ''}
               inputmode="tel" autocomplete="tel" />
      </label>

      <label class="o o-email">
        <span>{t.email}</span>
        <input type="email" name="email" value={daNhap.email ?? ''}
               inputmode="email" autocomplete="email"
               autocapitalize="off" spellcheck="false" />
      </label>

      <label class="o o-nam-sinh">
        <span>{t.namSinh}</span>
        <input type="text" name="nam_sinh" value={daNhap.nam_sinh ?? ''}
               inputmode="numeric" maxlength="4" pattern="[0-9]{4}" />
      </label>

      <fieldset class="o o-nhom o-ca-lam">
        <legend>{t.ca}</legend>
        {Object.entries(CA).map(([ma, ten]) => (
          <label class="o-chon">
            <input type="checkbox" name="ca" value={ma} />
            <span>{ten}</span>
          </label>
        ))}
      </fieldset>

      <label class="o o-gioi-thieu">
        <span>{t.gioiThieu}</span>
        <textarea name="gioi_thieu" rows="3">{daNhap.gioi_thieu ?? ''}</textarea>
      </label>

      <label class="o o-kinh-nghiem">
        <span>{t.kinhNghiem}</span>
        <small>{t.kinhNghiemPhu}</small>
        <textarea name="kinh_nghiem" rows="3">{daNhap.kinh_nghiem ?? ''}</textarea>
      </label>

      <label class="o o-cv">
        <span>{t.cv}</span>
        <small>{t.cvPhu}</small>
        <input type="file" name="cv"
               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
      </label>

      <label class="o-chon o-dong-y">
        <input type="checkbox" name="dong_y" value="co" required />
        <span>{t.dongY}</span>
      </label>

      <button type="submit" class="nut nut-chinh" style="width:100%;margin-top:6px">
        {t.gui}
      </button>
    </form>
  </div>
)}

<style>
  /* Ô bẫy: ra khỏi màn hình chứ không display:none — một số bot bỏ qua ô
     display:none, nhưng vẫn điền ô bị đẩy ra ngoài khung nhìn. */
  .bay {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-nop .o { display: block; margin-bottom: 18px; }
  .form-nop .o > span,
  .form-nop legend {
    display: block; font-weight: 700; font-size: 15px; margin-bottom: 6px;
  }
  .form-nop .o > span em { font-style: normal; font-weight: 400; color: var(--muc-nhat); }
  .form-nop .o > small {
    display: block; color: var(--muc-nhat); font-size: 14px; margin-bottom: 6px; line-height: 1.45;
  }

  /* Form nằm trên nền SÁNG (muc-sang). Bản đầu viết màu cho nền tối: chữ kem,
     viền kem 22%, nền kem 6% — trên nền kem thì ô vô hình và chữ gõ vào cũng
     vô hình (26/09/2026, ứng viên không nộp được hồ sơ). Ô trắng, viền
     --vien-o, chữ than.
     font-size 16px là mức tối thiểu: dưới đó Safari trên iPhone tự phóng to
     trang khi chạm vào ô, và người đang điền mất chỗ. */
  .form-nop input[type='text'],
  .form-nop input[type='tel'],
  .form-nop input[type='email'],
  .form-nop select,
  .form-nop textarea {
    font: inherit; font-size: 16px; width: 100%;
    padding: 13px 14px; min-height: 50px;
    border: 1px solid var(--vien-o); border-radius: 8px;
    background: #fff; color: var(--than);
  }
  .form-nop :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--do); outline-offset: 1px; border-color: var(--do);
  }
  .form-nop :is(input, textarea)::placeholder { color: var(--muc-nhat); }
  .form-nop textarea { min-height: 84px; resize: vertical; line-height: 1.55; }
  .form-nop input[type='file'] {
    font: inherit; font-size: 15px; width: 100%; color: var(--than);
    padding: 12px 0;
  }

  .form-nop .o-nhom {
    border: 1px solid var(--vach); border-radius: 8px;
    padding: 14px; margin: 0 0 18px;
  }
  .form-nop .o-chon {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 9px 0; font-size: 15px; line-height: 1.5; cursor: pointer;
  }
  /* 24px + vùng chạm quanh nó: ngón tay cái, không phải con trỏ chuột. */
  .form-nop .o-chon input[type='checkbox'] {
    width: 24px; height: 24px; margin: 0; flex-shrink: 0; accent-color: var(--do);
  }
  .form-nop .o-dong-y {
    border-top: 1px solid var(--vach);
    margin-top: 6px; padding-top: 16px; align-items: flex-start;
  }

  /* Ẩn ô mà tin đang chọn không hỏi — xem đầu file. Tên sau data-an là cột
     `lop` trong lib/truong-form.ts; thêm trường ở đó thì thêm một dòng ở đây. */
  .form-nop:has(option[data-an~='email']:checked) .o-email,
  .form-nop:has(option[data-an~='nam-sinh']:checked) .o-nam-sinh,
  .form-nop:has(option[data-an~='ca-lam']:checked) .o-ca-lam,
  .form-nop:has(option[data-an~='gioi-thieu']:checked) .o-gioi-thieu,
  .form-nop:has(option[data-an~='kinh-nghiem']:checked) .o-kinh-nghiem,
  .form-nop:has(option[data-an~='cv']:checked) .o-cv {
    display: none;
  }
</style>
