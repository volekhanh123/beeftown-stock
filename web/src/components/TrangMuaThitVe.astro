});

const TEN_NHOM: Record<LoaiNhom, string> = { mat: c.nhomMat, dong_lanh: c.nhomDong, kim_chi: c.nhomKimChi };
const coKimChi = menu.nhom.some(n => n.loai === 'kim_chi');
const duongQuyenRiengTu = duongDanTuongUng('/quyen-rieng-tu', nn);
const dem = CHU_DON.dem[nn](don.soGoi, don.soHop);
