              <div class="o">
                <label for="mtv-ghi-chu">{c.ghiChu} <em>({c.khongBatBuoc})</em></label>
                <small id="mtv-ghi-chu-phu">{c.ghiChuPhu}</small>
                <textarea id="mtv-ghi-chu" name="ghi_chu" maxlength="500" rows="2" aria-describedby="mtv-ghi-chu-phu"></textarea>
              </div>
            </div>

            <aside class="the mtv-don" aria-labelledby="mtv-don-cua-ban">
              <h2 id="mtv-don-cua-ban">{c.donCuaBan}</h2>
              <ul class="mtv-dong-don" data-mtv-dong-don>
                {don.dong.map(d => <li>{CHU_DON.dongDau[nn](d.sanPham.ten, nhanGoi(d.sanPham.donVi, d.goi.soGam, nn), d.soLuong)}<span data-tien>{dinhDangTien(d.thanhTien)}</span></li>)}
              </ul>
              <p class="mtv-trong" data-mtv-trong hidden={!gioRong}>{CHU_DON.donTrong[nn]}. <a href="#chon-goi">{c.chonGoi}</a></p>
              {boTamHet > 0 && (<p class="mtv-ghi">{c.boTamHet}</p>)}
              <p class="mtv-dem" data-mtv-dem hidden={gioRong}>{dem}</p>
              <p class="mtv-tam-tinh" aria-live="polite" aria-atomic="true" data-mtv-tam-tinh><span class="an-chu" data-mtv-vua-doi></span>{CHU_DON.tamTinh[nn]}: <span data-tien>{dinhDangTien(don.tamTinh)}</span></p>
              <dl class="mtv-dieu-kien">
                {traVnpay ? (
                  <>
                    <dt>{c.dtPhiGiao}</dt><dd>{c.phiGiaoDaGom}</dd>
                    {giaoHang && (<><dt>{c.dtKhuVuc}</dt><dd>{giaoHang}</dd></>)}
                    <dt>{c.dtGioGiao}</dt><dd>{gioGiao ?? c.gioGiaoVnpay}</dd>
                    <dt>{c.dtTraTien}</dt><dd>{c.traTienVnpay}</dd>
                  </>
                ) : (
                  <>
                    <dt>{c.dtPhiGiao}</dt><dd>{giaoHang ?? c.phiGiaoMacDinh}</dd>
                    <dt>{c.dtGioGiao}</dt><dd>{gioGiao ?? c.gioGiaoMacDinh}</dd>
                    <dt>{c.dtTraTien}</dt><dd>{c.traTien}</dd>
                  </>
                )}
                {thue && (<><dt>{c.dtThue}</dt><dd>{thue}</dd></>)}
              </dl>
              <p class="mtv-ghi">{c.giaCongBo}</p>
              <p class="mtv-bao" role="status" data-mtv-bao></p>
              <div class="hang-nut">
                <button class="nut nut-chinh" type="submit" data-mtv-nut-dat>{c.datHang}</button>
              </div>
              {traVnpay && congThu && (<p class="mtv-ghi" data-cong-thu><strong>{c.congThu}</strong></p>)}
              <p class="mtv-ghi">{traVnpay ? c.dongYVnpay : c.dongY} <a href={duongQuyenRiengTu}>{c.quyenRiengTu}</a>.</p>
            </aside>
          </div>
        </section>
      )}

      {trangThai === 'mo' && (
        <div class="mtv-thanh be-toi" data-mtv-thanh hidden>
          <p class="mtv-thanh-chu" data-mtv-thanh-chu></p>
          <a class="nut nut-chinh" href="#dat-hang">{c.datHang}</a>
        </div>
      )}
    </form>

    {hoiDap.length > 0 && (
      <section class="muc be-kem" aria-labelledby="mtv-hoi-dap">
        <div class="khung khung-hep">
          <h2 id="mtv-hoi-dap">{c.hoiDap}</h2>
          <div class="cau-hoi">
            {hoiDap.map(h => (
              <details>
                <summary>{h.hoi}<BieuTuong ten="cong" class="bt-mo" /><BieuTuong ten="tru" class="bt-dong" /></summary>
                <div class="tra-loi"><p>{h.tra}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </>
)}

<script>
  // Script chỉ THÊM vào trang (không có nó trang vẫn đặt được: form POST, database tính đơn): nút −/+, "Đơn của bạn"
  // đổi ngay khi chọn, thanh giỏ dính đáy màn hình, chặn bấm đúp, giữ chữ đã gõ khi database từ chối. Tính đơn bằng
  // chính các hàm máy chủ dùng (don-mua-thit.ts).
  import { CHU_DON, SO_GOI_TOI_DA, dinhDangTien, docGio, nhanGoi, tinhDon, type Don, type SanPhamMua } from '../lib/don-mua-thit';
  import { guiSuKienMotLan } from '../lib/meta-pixel';

  type ThuTieng = keyof typeof CHU_DON.tamTinh;
  const THU_TIENG: readonly ThuTieng[] = ['vi', 'en', 'ko'];

  // --- Giữ chữ đã gõ: máy chủ KHÔNG trả lại ô liên hệ khi báo lỗi (POST → chuyển hướng → GET, kết quả qua cookie),
  // nên trước khi gửi, bốn ô được giữ trong sessionStorage của thẻ trình duyệt này 15 phút (khuôn TrangDatBan).
  const KHOA = 'bt-dat-hang';
  const SONG_MS = 15 * 60 * 1000;
  const O_GIU = ['ho_ten', 'sdt', 'dia_chi', 'ghi_chu'] as const;
  type DaLuu = { luc: number } & Record<(typeof O_GIU)[number], string>;
  function docDaLuu(): DaLuu | null {
    try {
      const s = sessionStorage.getItem(KHOA);
      if (!s) return null;
      const d = JSON.parse(s) as Partial<DaLuu> | null;
      const tuoi = d && typeof d.luc === 'number' ? Date.now() - d.luc : NaN;
      if (!d || !(tuoi >= 0 && tuoi <= SONG_MS)) { sessionStorage.removeItem(KHOA); return null; }
      return d as DaLuu;
    } catch { return null; }
  }
  const xoaDaLuu = () => { try { sessionStorage.removeItem(KHOA); } catch { /* chế độ riêng tư: thôi */ } };

  /** Số tiền in ra trang: luôn trong một span có data-tien (bộ quét chữ cấm miễn đúng chỗ đó). */
  function oTien(n: number): HTMLSpanElement {
    const o = document.createElement('span');
    o.dataset.tien = '';
    o.textContent = dinhDangTien(n);
    return o;
  }

  /** Các dòng đơn, dựng bằng nút DOM (tên sản phẩm đến từ database: không ghép thành mã HTML). */
  function dongCua(don: Don, nn: ThuTieng): HTMLLIElement[] {
    return don.dong.map(d => {
      const li = document.createElement('li');
      li.append(CHU_DON.dongDau[nn](d.sanPham.ten, nhanGoi(d.sanPham.donVi, d.goi.soGam, nn), d.soLuong), oTien(d.thanhTien));
      return li;
    });
  }

  // Kết quả lượt đặt: đã nhận hay không chắc → xong việc với chữ đã giữ (điền lại = đặt lại chỉ còn một cú bấm).
  const khungKetQua = document.querySelector<HTMLElement>('[data-ket-qua]');
  if (khungKetQua?.dataset.ketQua === 'da-nhan' || khungKetQua?.dataset.ketQua === 'khong-chac') xoaDaLuu();
  khungKetQua?.focus();

  const form = document.querySelector<HTMLFormElement>('[data-mtv-form]');
  if (form) khoiDong(form);

  function khoiDong(form: HTMLFormElement) {
    let menuVao: unknown;
    try { menuVao = JSON.parse(form.dataset.menu ?? '[]'); } catch { return; }
    if (!Array.isArray(menuVao)) return;
    const menu = menuVao as SanPhamMua[];
    const nn: ThuTieng = THU_TIENG.find(x => x === form.dataset.nn) ?? 'vi';

    const dongDon = form.querySelector<HTMLUListElement>('[data-mtv-dong-don]');
    const trong = form.querySelector<HTMLElement>('[data-mtv-trong]');
    const demGoi = form.querySelector<HTMLElement>('[data-mtv-dem]');
    const tamTinh = form.querySelector<HTMLElement>('[data-mtv-tam-tinh]');
    const vuaDoi = form.querySelector<HTMLElement>('[data-mtv-vua-doi]');
    const thanh = form.querySelector<HTMLElement>('[data-mtv-thanh]');
    const thanhChu = form.querySelector<HTMLElement>('[data-mtv-thanh-chu]');
    const khoiDat = form.querySelector<HTMLElement>('[data-mtv-dat-hang]');
    const bao = form.querySelector<HTMLElement>('[data-mtv-bao]');
    const nutDat = form.querySelector<HTMLButtonElement>('[data-mtv-nut-dat]');

    // Điền lại ô liên hệ đã giữ (database vừa từ chối đơn) — chỉ ô đang trống, không đè chữ trình duyệt tự điền.
    // Chỉ khi database vừa từ chối đơn (khung lỗi của lượt đặt) — không điền chữ của lượt trước vào một lần ghé mới.
    const daLuu = khungKetQua?.dataset.ketQua === 'loi' ? docDaLuu() : null;
    if (daLuu) {
      for (const ten of O_GIU) {
        const o = form.elements.namedItem(ten);
        if ((o instanceof HTMLInputElement || o instanceof HTMLTextAreaElement) && !o.value) o.value = daLuu[ten] ?? '';
      }
    }

    const theoKhoa = new Map<string, { ten: string; nhan: string }>();
    for (const sp of menu) for (const g of sp.goi) theoKhoa.set(g.khoa, { ten: sp.ten, nhan: nhanGoi(sp.donVi, g.soGam, nn) });

    // Hộp chọn gói (popover của MuaThitThe): trình duyệt chưa biết popover thì hộp đã đứng thẳng trong thẻ — ẩn nút
    // mở / đóng vô dụng. Biết popover: mở hộp thì con trỏ vào ô chọn đầu tiên của hộp.
    if (!Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover')) {
      form.querySelectorAll<HTMLElement>('[data-mtv-mo-hop], [data-mtv-dong-hop]').forEach(nut => { nut.hidden = true; });
    } else {
      form.querySelectorAll<HTMLElement>('[data-mtv-hop]').forEach(hop => {
        hop.addEventListener('toggle', e => {
          if ((e as ToggleEvent).newState === 'open') { hop.querySelector<HTMLSelectElement>('select.mtv-so')?.focus(); return; }
          // Đóng bằng bấm ra ngoài: trình duyệt không trả con trỏ — đưa về nút "Chọn gói" của hộp (không giật con trỏ
          // khi khách đã bấm sang chỗ khác).
          const conTro = document.activeElement;
          if (!conTro || conTro === document.body || hop.contains(conTro)) {
            form.querySelector<HTMLElement>(`[data-mtv-mo-hop][popovertarget="${CSS.escape(hop.id)}"]`)?.focus();
          }
        });
      });
    }

    let donHienTai: Don | null = null;
    let khoiDatDangHien = false;

    function capNhatThanh() {
      if (!thanh || !donHienTai) return;
      thanh.hidden = donHienTai.dong.length === 0 || khoiDatDangHien;
    }

    function capNhat() {
      const cap: [string, string][] = [];
      for (const [ten, giaTri] of new FormData(form)) if (typeof giaTri === 'string') cap.push([ten, giaTri]);
      const { gio, boTamHet } = docGio(cap, menu);
      const don = tinhDon(gio, menu, boTamHet);
      donHienTai = don;
      const rong = don.dong.length === 0;
      const dem = CHU_DON.dem[nn](don.soGoi, don.soHop);

      dongDon?.replaceChildren(...dongCua(don, nn));
      // "Đã chọn: 2 gói" trên thẻ và ở chân hộp của từng sản phẩm.
      for (const sp of menu) {
        const so = don.dong.filter(d => d.sanPham.ma === sp.ma).reduce((tong, d) => tong + d.soLuong, 0);
        const chu = CHU_DON.daChon[nn](sp.donVi === 'hop' ? 0 : so, sp.donVi === 'hop' ? so : 0);
        form.querySelectorAll<HTMLElement>(`[data-mtv-the="${CSS.escape(sp.ma)}"] [data-mtv-da-chon]`).forEach(o => {
          o.textContent = chu;
          o.hidden = so === 0;
        });
      }
      if (trong) trong.hidden = !rong;
      if (demGoi) { demGoi.textContent = dem; demGoi.hidden = rong; }
      tamTinh?.querySelector<HTMLElement>('[data-tien]')?.replaceWith(oTien(don.tamTinh));
      thanhChu?.replaceChildren(...(rong ? [] : [`${dem} · ${CHU_DON.tamTinh[nn]}: `, oTien(don.tamTinh)]));
      if (bao && !rong) bao.textContent = '';
      capNhatThanh();
    }

    // Thanh giỏ ẩn khi khối Đặt hàng đang trên màn hình — không che ô đang gõ, không lặp nút Đặt hàng.
    if (khoiDat && 'IntersectionObserver' in window) {
      new IntersectionObserver(muc => {
        khoiDatDangHien = muc.some(m => m.isIntersecting);
        capNhatThanh();
      }).observe(khoiDat);
    }

    // Nút −/+: đổi ô chọn trong 0…10 rồi phát change như khi khách tự chọn.
    form.querySelectorAll<HTMLButtonElement>('[data-mtv-buoc]').forEach(nut => { nut.hidden = false; });
    let tuNut = false;
    form.addEventListener('click', e => {
      const nut = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-mtv-buoc]') : null;
      const o = nut?.parentElement?.querySelector<HTMLSelectElement>('select.mtv-so');
      if (!nut || !o) return;
      const cu = Number(o.value) || 0;
      const moi = Math.min(SO_GOI_TOI_DA, Math.max(0, cu + (Number(nut.dataset.mtvBuoc) || 0)));
      if (moi === cu) return;
      o.value = String(moi);
      const goi = theoKhoa.get(o.name);
      if (vuaDoi && goi) vuaDoi.textContent = CHU_DON.vuaDoi[nn](goi.ten, goi.nhan, moi);
      tuNut = true;
      o.dispatchEvent(new Event('change', { bubbles: true }));
      tuNut = false;
    });
    form.addEventListener('change', () => {
      if (!tuNut && vuaDoi) vuaDoi.textContent = '';
      capNhat();
    });

    // Thân gửi gọn: bỏ ô số gói bằng "0" và giá của gói không chọn.
    form.addEventListener('formdata', e => {
      const chon = new Set<string>();
      for (const [ten, giaTri] of [...e.formData]) {
        if (theoKhoa.has(ten)) { if (giaTri === '0') e.formData.delete(ten); else chon.add(ten); }
      }
      for (const [ten] of [...e.formData]) if (ten.startsWith('gia_') && !chon.has(ten.slice(4))) e.formData.delete(ten);
    });

    // Gửi: giỏ rỗng → không gửi, báo và đưa con trỏ về ô chọn đầu. Có giỏ → giữ ô liên hệ, khóa nút (bấm đúp không
    // gửi lần hai — database cũng trả lại đơn cũ theo ma_gui), Meta Pixel InitiateCheckout một lần cho mỗi giỏ (chỉ
    // tên trang và thứ tiếng tới Meta — lib/meta-pixel.ts).
    let dangGui = false;
    const chuNut = nutDat?.textContent ?? '';
    let henMoKhoa: ReturnType<typeof setTimeout> | undefined;
    const moKhoa = () => {
      dangGui = false;
      clearTimeout(henMoKhoa);
      if (nutDat) { nutDat.removeAttribute('aria-busy'); nutDat.textContent = chuNut; }
    };
    form.addEventListener('submit', e => {
      capNhat();
      if (!donHienTai || donHienTai.dong.length === 0) {
        e.preventDefault();
        if (bao) bao.textContent = form.dataset.thieuGio ?? '';
        // Nút "Chọn gói" đầu tiên (ô chọn nằm trong hộp đang đóng); trình duyệt chưa biết popover: ô chọn đầu tiên.
        const dau = [...form.querySelectorAll<HTMLElement>('[data-mtv-mo-hop], select.mtv-so')].find(o => !o.hidden && o.offsetParent !== null);
        dau?.focus();
        return;
      }
      if (dangGui) { e.preventDefault(); return; }
      dangGui = true;
      try {
        const d = { luc: Date.now() } as DaLuu;
        for (const ten of O_GIU) {
          const o = form.elements.namedItem(ten);
          d[ten] = o instanceof HTMLInputElement || o instanceof HTMLTextAreaElement ? o.value : '';
        }
        sessionStorage.setItem(KHOA, JSON.stringify(d));
      } catch { /* không giữ được thì thôi */ }
      if (nutDat) { nutDat.setAttribute('aria-busy', 'true'); nutDat.textContent = form.dataset.dangGui ?? nutDat.textContent; }
      // Trang không chuyển đi (trình duyệt báo lỗi mạng tại chỗ): sau 15 giây mở khóa để khách đặt lại — cùng ma_gui,
      // database trả lại đơn cũ nếu lần trước thật ra đã tới.
      henMoKhoa = setTimeout(moKhoa, 15000);
      guiSuKienMotLan('InitiateCheckout', donHienTai.dong.map(d => `${d.goi.khoa}=${d.soLuong}`).join('&'));
    });

    // Bấm Back về trang (bộ nhớ đệm của trình duyệt): mở khóa nút, tính lại đơn từ ô chọn trình duyệt điền lại.
    window.addEventListener('pageshow', () => {
      moKhoa();
      capNhat();
    });
    capNhat();
  }
</script>

