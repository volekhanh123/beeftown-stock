          <div class="khung mtv-hai-cot">
            <div class="mtv-giao">
              <h2 id="mtv-giao-hang">{c.giaoHang}</h2>
              {loiGui && (
                <div class="mtv-loi-the" role="alert" data-ket-qua="loi" tabindex="-1"><p><strong>{loiGui}</strong></p></div>
              )}
              <div class="o">
                <label for="mtv-ho-ten">{c.hoTen} <em>({c.batBuoc})</em></label>
                <input type="text" id="mtv-ho-ten" name="ho_ten" required maxlength="120" autocomplete="name" autocapitalize="words" />
              </div>
              <div class="o">
                <label for="mtv-sdt">{c.sdt} <em>({c.batBuoc})</em></label>
                <small id="mtv-sdt-phu">{traVnpay ? c.sdtPhuVnpay : c.sdtPhu}</small>
                <input type="tel" id="mtv-sdt" name="sdt" required maxlength="20" inputmode="tel" autocomplete="tel"
                       aria-describedby="mtv-sdt-phu" />
