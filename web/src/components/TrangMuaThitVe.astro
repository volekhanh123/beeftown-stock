      <input type="hidden" name="ma_gui" value={maGui} />

      <section id="chon-goi" class="muc be-kem mtv-cua-hang" aria-label={c.chonGoi}>
        <div class="khung mtv-danh-sach">
          {menu.nhom.map(n => (
            <div class="mtv-nhom">
              <h2>{TEN_NHOM[n.loai]}</h2>
              <div class="mtv-luoi-the">
