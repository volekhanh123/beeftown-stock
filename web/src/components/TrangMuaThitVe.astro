<script>
  // Script chỉ THÊM vào trang (không có nó trang vẫn đủ: form GET, máy chủ dựng "Xem lại đơn"): nút −/+, "Đơn của
  // bạn" đổi ngay khi chọn, thanh dưới trên điện thoại, nút Chép đơn. Tính đơn bằng chính các hàm máy chủ dùng
  // (don-mua-thit.ts); link nút gửi bằng linkGuiDon (dich-dat-hang.ts) — đích đặt hàng đọc từ data-dich, không tự đặt.
  import { CHU_DON, SO_GOI_TOI_DA, dinhDangTien, docGio, nhanGoi, taoTinDon, tinhDon, type Don, type SanPhamMua } from '../lib/don-mua-thit';
  import { linkGuiDon, type DichDatHang } from '../lib/dich-dat-hang';
  import { guiSuKienMotLan } from '../lib/meta-pixel';

  type ThuTieng = keyof typeof CHU_DON.tamTinh;
  const THU_TIENG: readonly ThuTieng[] = ['vi', 'en', 'ko'];

  /** Số tiền in ra trang: luôn trong một span có data-tien (bộ quét chữ cấm miễn đúng chỗ đó). */
  function oTien(n: number): HTMLSpanElement {
    const o = document.createElement('span');
    o.dataset.tien = '';
    o.textContent = dinhDangTien(n);
    return o;
  }

  /** Các dòng đơn, dựng bằng nút DOM (tên sản phẩm đến từ database: không ghép thành mã HTML). */
  function dongCua(don: Don, nn: ThuTieng): HTMLLIElement[] {
    return don.dong.map(d => {
      const li = document.createElement('li');
      li.append(CHU_DON.dongDau[nn](d.sanPham.ten, nhanGoi(d.sanPham.donVi, d.goi.soGam, nn), d.soLuong), oTien(d.thanhTien));
      return li;
    });
  }

  // "Nhận hàng" mở sẵn trên màn rộng (cột phải còn chỗ); điện thoại để đóng — món đầu tiên lên sớm. Không script thì
  // đóng, khách bấm để mở.
  const nhanHang = document.querySelector<HTMLDetailsElement>('details.mtv-nhan');
  const manRong = window.matchMedia('(min-width: 1024px)');
  const moNhanHang = () => { if (nhanHang && manRong.matches) nhanHang.open = true; };
  moNhanHang();
  manRong.addEventListener('change', moNhanHang);

  const form = document.querySelector<HTMLFormElement>('[data-mtv-form]');
  if (form) khoiDong(form);

  function khoiDong(form: HTMLFormElement) {
    let menuVao: unknown;
    let dichVao: unknown;
    try {
      menuVao = JSON.parse(form.dataset.menu ?? '[]');
      dichVao = JSON.parse(form.dataset.dich ?? 'null');
    } catch {
      return;   // dữ liệu hỏng: trang vẫn là form GET thường
    }
    if (!Array.isArray(menuVao) || !dichVao || typeof dichVao !== 'object') return;
    const menu = menuVao as SanPhamMua[];
    const dich = dichVao as DichDatHang;
    const nn: ThuTieng = THU_TIENG.find(x => x === form.dataset.nn) ?? 'vi';
    const choGiao = form.dataset.giao === '1';
    const daChep = form.dataset.daChep ?? '';
    const chepLoi = form.dataset.chepLoi ?? '';

    const dongDon = form.querySelector<HTMLUListElement>('[data-mtv-dong-don]');
    const trong = form.querySelector<HTMLElement>('[data-mtv-trong]');
    const demGoi = form.querySelector<HTMLElement>('[data-mtv-dem]');
    const tamTinh = form.querySelector<HTMLElement>('[data-mtv-tam-tinh]');
    const vuaDoi = form.querySelector<HTMLElement>('[data-mtv-vua-doi]');
    const thanh = form.querySelector<HTMLElement>('[data-mtv-thanh]');
    const thanhChu = form.querySelector<HTMLElement>('[data-mtv-thanh-chu]');
    const thanhXem = form.querySelector<HTMLElement>('[data-mtv-thanh-xem]');
    const xemDon = document.querySelector<HTMLElement>('[data-mtv-xem-don]');
    const xemDong = document.querySelector<HTMLUListElement>('[data-mtv-xem-dong]');
    const xemPhan = document.querySelectorAll<HTMLElement>('[data-mtv-xem-phan]');
    const xemTamTinh = document.querySelector<HTMLElement>('[data-mtv-xem-tam-tinh]');
    const xemNhan = document.querySelector<HTMLElement>('[data-mtv-xem-nhan]');
    const tin = document.querySelector<HTMLTextAreaElement>('#mtv-tin');
    const gui = document.querySelector<HTMLAnchorElement>('a[data-mtv-gui]');
    const nutChep = document.querySelector<HTMLButtonElement>('[data-mtv-chep]');
    const chepTay = document.querySelector<HTMLElement>('[data-mtv-chep-tay]');
    const bao = document.querySelector<HTMLElement>('[data-mtv-bao]');

    // Tên và nhãn gói theo tên ô chọn — cho câu đọc sau mỗi lần bấm −/+.
    const theoKhoa = new Map<string, { ten: string; nhan: string }>();
    for (const sp of menu) for (const g of sp.goi) theoKhoa.set(g.khoa, { ten: sp.ten, nhan: nhanGoi(sp.donVi, g.soGam, nn) });

    let donHienTai: Don | null = null;

    /** Đọc giỏ từ form, tính đơn, cập nhật mọi chỗ in đơn và link nút gửi. */
    function capNhat() {
      const cap: [string, string][] = [];
      for (const [ten, giaTri] of new FormData(form)) if (typeof giaTri === 'string') cap.push([ten, giaTri]);
      const { gio, cachNhan, boTamHet } = docGio(cap, menu, choGiao);
      const don = tinhDon(gio, cachNhan, menu, boTamHet);
      donHienTai = don;
      const rong = don.dong.length === 0;
      const dem = CHU_DON.dem[nn](don.soGoi, don.soHop);

      dongDon?.replaceChildren(...dongCua(don, nn));
      if (trong) trong.hidden = !rong;
      if (demGoi) { demGoi.textContent = dem; demGoi.hidden = rong; }
      tamTinh?.querySelector<HTMLElement>('[data-tien]')?.replaceWith(oTien(don.tamTinh));

      if (thanh) thanh.hidden = false;
      thanhChu?.replaceChildren(...(rong ? [CHU_DON.donTrong[nn]] : [`${dem} · ${CHU_DON.tamTinh[nn]}: `, oTien(don.tamTinh)]));
      if (thanhXem) thanhXem.hidden = rong;

      if (xemDon) xemDon.hidden = rong && xemDon.dataset.boHet === undefined;
      xemPhan.forEach(e => { e.hidden = rong; });
      xemDong?.replaceChildren(...dongCua(don, nn));
      xemTamTinh?.querySelector<HTMLElement>('[data-tien]')?.replaceWith(oTien(don.tamTinh));
      if (xemNhan) xemNhan.textContent = (cachNhan === 'giao' ? xemNhan.dataset.giao : xemNhan.dataset.quay) ?? xemNhan.textContent;
      if (tin) tin.value = taoTinDon(don, nn, Date.now());
      if (gui) gui.href = linkGuiDon(dich, gio, cachNhan);
      if (bao) bao.textContent = '';
    }

    // Nút −/+: đổi ô chọn trong 0…10 rồi phát change như khi khách tự chọn. Bấm − ở 0 (hay + ở 10) không làm gì.
    form.querySelectorAll<HTMLButtonElement>('[data-mtv-buoc]').forEach(nut => { nut.hidden = false; });
    let tuNut = false;
    form.addEventListener('click', e => {
      const nut = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-mtv-buoc]') : null;
      const o = nut?.parentElement?.querySelector<HTMLSelectElement>('select.mtv-so');
      if (!nut || !o) return;
      const cu = Number(o.value) || 0;
      const moi = Math.min(SO_GOI_TOI_DA, Math.max(0, cu + (Number(nut.dataset.mtvBuoc) || 0)));
      if (moi === cu) return;
      o.value = String(moi);
      const goi = theoKhoa.get(o.name);
      if (vuaDoi && goi) vuaDoi.textContent = CHU_DON.vuaDoi[nn](goi.ten, goi.nhan, moi);
      tuNut = true;
      o.dispatchEvent(new Event('change', { bubbles: true }));
      tuNut = false;
    });
    form.addEventListener('change', () => {
      if (!tuNut && vuaDoi) vuaDoi.textContent = '';   // khách tự chọn: ô chọn đã tự đọc số
      capNhat();
    });

    // Địa chỉ ngắn: bỏ các ô bằng "0" khỏi lần gửi. Ô vẫn bấm được khi khách bấm Back (trang lấy lại từ bộ nhớ đệm).
    form.addEventListener('formdata', e => {
      for (const [ten, giaTri] of [...e.formData]) if (giaTri === '0') e.formData.delete(ten);
    });
    // Meta Pixel (lib/meta-pixel.ts): InitiateCheckout khi khách bấm "Xem đơn" có giỏ — nút gửi form hay nút của thanh
    // dưới (chỉ hiện khi giỏ có gói). Một giỏ một lần (guiSuKienMotLan, khóa là giỏ đang chọn): gửi form rồi bấm thanh
    // dưới ở trang xem đơn — ô chọn mang lại đúng giỏ đó — vẫn là một lần xem đơn; đổi giỏ rồi xem đơn là lần mới. Giỏ
    // chỉ làm khóa trong sessionStorage — chỉ tên trang và thứ tiếng tới Meta.
    const baoXemDon = () => {
      const gio: string[] = [];
      for (const [ten, giaTri] of new FormData(form)) if (typeof giaTri === 'string' && giaTri !== '0') gio.push(`${ten}=${giaTri}`);
      guiSuKienMotLan('InitiateCheckout', gio.sort().join('&'));
    };
    thanhXem?.addEventListener('click', baoXemDon);

    // Giỏ rỗng: không gửi, đưa con trỏ về ô chọn đầu. Có giỏ: để form GET chạy — máy chủ đọc lại menu, dựng "Xem lại đơn".
    form.addEventListener('submit', e => {
      capNhat();
      if (donHienTai && donHienTai.dong.length > 0) {
        baoXemDon();
        return;
      }
      e.preventDefault();
      form.querySelector<HTMLSelectElement>('select.mtv-so')?.focus();
    });

    // Chép đơn: chỉ khi trình duyệt có clipboard; câu "Đã chép đơn." chỉ ghi sau khi lệnh chép xong.
    if (nutChep && tin && typeof navigator.clipboard?.writeText === 'function') {
      nutChep.hidden = false;
      if (chepTay) chepTay.hidden = true;
      nutChep.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(tin.value);
          if (bao) bao.textContent = daChep;
        } catch {
          if (bao) bao.textContent = chepLoi;
          if (chepTay) chepTay.hidden = false;
          tin.focus();
          tin.setSelectionRange(0, tin.value.length);
        }
      });
    }

    // Đúng ngay khi trang hiện: lúc tải (kể cả tải lại có tham số), và khi bấm Back trở lại trang này. pageshow cả lần
    // tải đầu, không chỉ bfcache: Back không qua bfcache thì trình duyệt điền lại ô chọn SAU khi script này chạy.
    capNhat();
    window.addEventListener('pageshow', capNhat);
  }
</script>

<style>
  /* Thứ chỉ chạy nhờ JavaScript ra trang với hidden; display của .nut và của lớp riêng không được đè lên hidden.
     Viết trơn, không đặt lớp của body phía trước: Astro gắn phạm vi cho mọi bộ chọn, body không mang dấu đó. */
  [hidden] { display: none !important; }

  .mtv-hang-nut-dau { margin-top: var(--k-6); }

  /* --- Ba bước: dải đen, số trong ô trắng ------------------------------------------------- */
  .mtv-khoi-buoc h2 { margin-bottom: var(--k-6); }
  .mtv-ba-buoc {
    list-style: none; margin: 0; padding: 0; counter-reset: buoc;
    display: grid; gap: var(--k-5); grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) { .mtv-ba-buoc { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--k-7); } }
  .mtv-ba-buoc li {
    counter-increment: buoc;
    display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: var(--k-4); align-items: center;
    font-size: var(--co-dan); font-weight: 700; line-height: 1.35; color: var(--chu-chinh);
  }
  .mtv-ba-buoc li::before {
    content: counter(buoc);
    content: counter(buoc) / '';
    display: grid; place-items: center; width: 48px; height: 48px;
    background: var(--kem); color: var(--than); border-radius: var(--bo);
    font-size: 24px; font-weight: 800; line-height: 1;
  }

  /* --- Lưới: danh sách trái; Nhận hàng và Đơn của bạn ở cột phải từ 1024px ---------------- */
  .mtv-luoi { display: grid; gap: var(--k-7); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) {
    .mtv-luoi { grid-template-columns: minmax(0, 1fr) 300px; grid-template-rows: auto 1fr; column-gap: var(--k-7); row-gap: var(--k-5); align-items: start; }
    details.mtv-nhan { grid-column: 2; grid-row: 1; }
    .mtv-danh-sach { grid-column: 1; grid-row: 1 / span 2; }
    .mtv-don, .mtv-het { grid-column: 2; grid-row: 2; }
  }
  @media (min-width: 1280px) { .mtv-luoi { grid-template-columns: minmax(0, 1fr) 360px; } }
  @media (min-width: 1024px) and (min-height: 760px) {
    .mtv-don { position: sticky; top: calc(var(--cao-dau) + var(--k-5)); }
  }

  /* --- Nhận hàng và trả tiền: details đóng sẵn, cả hàng tóm tắt là vùng bấm (thẻ giữ đệm của .the) ------- */
  .mtv-nhan > summary {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--k-3); align-items: center;
    min-height: 48px; padding: 0;
    cursor: pointer; list-style: none;
  }
  .mtv-nhan > summary::-webkit-details-marker { display: none; }
  .mtv-nhan-ten { grid-column: 1; font-weight: 700; font-size: var(--co-h3); line-height: 1.3; }
  .mtv-nhan-tom { grid-column: 1; margin-top: var(--k-1); font-size: var(--co-nho); color: var(--chu-phu); }
  .mtv-nhan > summary :global(svg) { grid-column: 2; grid-row: 1 / span 2; width: 24px; height: 24px; color: var(--nhan); }
  .mtv-nhan > summary :global(.bt-dong), .mtv-nhan[open] > summary :global(.bt-mo) { display: none; }
  .mtv-nhan[open] > summary :global(.bt-dong) { display: block; }
  .mtv-nhan > summary:active .mtv-nhan-ten { color: var(--nhan); }
  @media (hover: hover) { .mtv-nhan > summary:hover .mtv-nhan-ten { color: var(--nhan); } }
  .mtv-nhan-chu { margin: var(--k-4) 0 0; padding-top: var(--k-4); border-top: 1px solid var(--vien); }
  .mtv-nhan-chu dt { font-weight: 700; margin-top: var(--k-4); }
  .mtv-nhan-chu dt:first-child { margin-top: 0; }
  .mtv-nhan-chu dd { margin: var(--k-1) 0 0; }

  /* --- Danh sách gói ------------------------------------------------------------------------ */
  .mtv-danh-sach { display: grid; gap: var(--k-7); min-width: 0; }
  .mtv-nhom h2 { margin-bottom: var(--k-4); }
  .mtv-luoi-the { display: grid; gap: var(--k-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 600px) {
    .mtv-luoi-the { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mtv-luoi-the.mtv-luoi-ngang { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Đơn của bạn ---------------------------------------------------------------------------- */
  .mtv-don h2, .mtv-xem-don h2 { font-size: var(--co-h3); line-height: 1.3; margin-bottom: var(--k-4); }
  .mtv-cach-nhan { margin-bottom: var(--k-4); }
  .mtv-cach-nhan label { display: block; margin-bottom: 6px; font-weight: 700; font-size: 15px; }
  .mtv-so-nhan {
    width: 100%; min-height: 48px; padding: 11px 14px;
    font: inherit; font-size: 16px; line-height: 1.5;
    color: var(--than); background: var(--kem);
    border: 1px solid var(--vien-o); border-radius: var(--bo);
  }
  .mtv-so-nhan:focus-visible { outline: 3px solid var(--do); outline-offset: 1px; border-color: var(--do); }
  .mtv-dong-don { list-style: none; margin: 0; padding: 0; }
  .mtv-dong-don li { padding: var(--k-2) 0; border-bottom: 1px solid var(--vien); }
  .mtv-dong-don [data-tien], .mtv-tam-tinh [data-tien], .mtv-thanh-chu [data-tien] { white-space: nowrap; font-weight: 700; }
  .mtv-trong { margin: 0; color: var(--chu-phu); }
  .mtv-dem { margin: var(--k-3) 0 0; font-weight: 600; }
  .mtv-tam-tinh { margin: var(--k-2) 0 0; font-size: var(--co-dan); font-weight: 700; }
  .mtv-ghi { margin: var(--k-3) 0 0; font-size: var(--co-nho); color: var(--chu-phu); max-width: 60ch; }
  .mtv-don .hang-nut { margin-top: var(--k-5); }
  .mtv-don .hang-nut .nut { width: 100%; }
  .mtv-het p { margin: 0 0 var(--k-5); }

  /* --- Thanh dưới (điện thoại): đen, dính đáy màn hình khi đang ở trong form; dừng trước "Xem lại đơn" ---- */
  .mtv-thanh {
    position: sticky; bottom: 0; z-index: 30; min-height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: var(--k-3);
    margin: var(--k-7) calc(-1 * var(--le)) 0; padding: var(--k-3) var(--le);
  }
  .mtv-thanh-chu { margin: 0; font-size: var(--co-nho); font-weight: 600; line-height: 1.4; }
  .mtv-thanh .nut { flex: none; }
  @media (min-width: 1024px) { .mtv-thanh { display: none; } }
  @media (max-height: 500px) { .mtv-thanh { display: none; } }

  /* --- Xem lại đơn ---------------------------------------------------------------------------- */
  .mtv-xem-don { max-width: 760px; margin-top: var(--k-8); padding-top: var(--k-7); border-top: 1px solid var(--vach); }
  .mtv-xem-don > p { margin: var(--k-3) 0 0; }
  .mtv-chep { margin-top: var(--k-5); }
  .mtv-nhan-tin { display: block; margin-bottom: 6px; font-weight: 700; font-size: 15px; }
  .mtv-tin {
    display: block; width: 100%; min-height: 48px; margin-top: var(--k-2); padding: 11px 14px;
    font: inherit; font-size: 16px; line-height: 1.5; white-space: pre-wrap; resize: vertical;
    color: var(--than); background: var(--kem);
    border: 1px solid var(--vien-o); border-radius: var(--bo);
  }
  .mtv-tin:focus-visible { outline: 3px solid var(--do); outline-offset: 1px; border-color: var(--do); }
  .mtv-xem-don .hang-nut { margin-top: var(--k-5); }
  .mtv-bao { font-weight: 700; }
  .mtv-bao:empty { margin: 0; }

  /* --- Hỏi đáp ---------------------------------------------------------------------------------- */
  .mtv-hoi-dap { display: grid; gap: var(--k-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .mtv-hoi-dap { grid-template-columns: 4fr 7fr; gap: var(--k-8); align-items: start; } }

  /* Tương phản cao (Windows): nền đen của thanh dưới bị ép mất — giữ đường viền trên để thanh tách khỏi trang. */
  @media (forced-colors: active) {
    .mtv-thanh { border-top: 1px solid CanvasText; }
  }
</style>
