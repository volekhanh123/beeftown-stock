---
/**
 * LÊN TẦNG 3 — địa chỉ, cầu thang bộ, không có thang máy cho khách
 *
 * Beeftown nằm trọn ở tầng 3, khách lên bằng cầu thang bộ, KHÔNG có thang máy
 * cho khách (brief 06/10/2026). Đó là điều khách phải biết TRƯỚC khi rủ cả nhà
 * đi — nhất là khi đi cùng ông bà. Nên khối này nổi bật, không chôn ở chân trang,
 * và có mặt ở trang chủ, trang Đến Beeftown và trang Hỏi bàn (bản gọn).
 *
 * Nút "Chỉ đường" chỉ hiện khi link Google Maps đã được công bố trong /noi-bo
 * (không tự chế link). "Sao chép địa chỉ" là nút bổ trợ: không có JavaScript thì
 * nút ẩn hẳn (thuộc tính hidden), địa chỉ vẫn là chữ chọn được.
 */
import { chu, dich, duongDanTuongUng } from '../lib/chu';
import { diaChi, lienHe } from '../lib/trang-cong-khai';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import BieuTuong from './BieuTuong.astro';

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  /** Bản gọn: một thẻ cho trang Hỏi bàn / thực đơn. */
  gon?: boolean;
  /** Ẩn link "Xem đường lên tầng 3" (khi đang ở chính trang Đến Beeftown). */
  khongLinkDuongDen?: boolean;
  /** Cấp tiêu đề: h2 ở trang chủ, h3 khi nằm trong một khối khác. */
  capTieuDe?: 2 | 3;
}
const { ngonNgu, noiDung: nd, gon = false, khongLinkDuongDen = false, capTieuDe = 2 } = Astro.props;
const t = chu(ngonNgu);
const lh = lienHe(nd);
const dc = diaChi(nd);
const TieuDe = capTieuDe === 2 ? 'h2' : 'h3';
const c = dich(ngonNgu, {
  hieu: { vi: 'Đến Beeftown', en: 'Getting here', ko: '오시는 길' },
  tieuDe: { vi: 'Beeftown ở tầng 3', en: 'Beeftown is on Floor 3', ko: 'Beeftown은 3층에 있어요' },
  luuY: {
    vi: 'Đi cùng ông bà hay người khó leo cầu thang? Bạn nên biết trước điều này khi lên kế hoạch.',
    en: 'Coming with grandparents, or anyone who finds stairs hard? It is worth knowing before you plan.',
    ko: '어르신이나 계단이 불편한 분과 함께 오신다면 미리 참고해 주세요.',
  },
});
---
{gon ? (
  <aside class="lt3-gon" aria-label={c.tieuDe}>
    <span class="lt3-so-nho" aria-hidden="true">3</span>
    <div>
      <p class="lt3-cau"><strong>{t.cauThangBo}</strong></p>
      <p class="lt3-dc" lang="vi">{dc}</p>
      <div class="lt3-hang">
        {lh.maps && <a class="lien-ket" href={lh.maps} rel="noopener">{t.chiDuong}<BieuTuong ten="mui-ten" /></a>}
        {!khongLinkDuongDen && <a class="lien-ket" href={duongDanTuongUng('/den-beeftown', ngonNgu)}>{t.xemDuongLen}<BieuTuong ten="mui-ten" /></a>}
      </div>
    </div>
  </aside>
) : (
  <div class="lt3">
    <div class="lt3-hinh" aria-hidden="true">
      <span class="lt3-so">3</span>
      <svg class="lt3-thang" viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 152h36v-28h36V96h36V68h36V40h40" />
        <path d="M14 124 174 18" />
        <path d="M22 124v-8M58 100v-8M94 76v-8M130 52v-8M166 28v-8" opacity=".6" />
      </svg>
    </div>
    <div class="lt3-chu">
      <p class="hieu">{c.hieu}</p>
      <TieuDe class="lt3-tieu-de">{c.tieuDe}</TieuDe>
      <p class="lt3-dc"><BieuTuong ten="ghim" /><span lang="vi">{dc}</span></p>
      <p class="lt3-cau"><BieuTuong ten="cau-thang" /><strong>{t.cauThangBo}</strong></p>
      <p class="lt3-luu-y">{c.luuY}</p>
      <div class="hang-nut">
        {lh.maps && <a class="nut nut-chinh" href={lh.maps} rel="noopener"><BieuTuong ten="ghim" />{t.chiDuong}</a>}
        <button type="button" class="nut nut-vien" data-sao-chep={dc} data-da-chep={t.daSaoChep} hidden><BieuTuong ten="sao-chep" /><span>{t.saoChepDiaChi}</span></button>
        {!khongLinkDuongDen && <a class="lien-ket" href={duongDanTuongUng('/den-beeftown', ngonNgu)}>{t.xemDuongLen}<BieuTuong ten="mui-ten" /></a>}
      </div>
      <p class="an-chu" role="status" data-bao-chep></p>
    </div>
  </div>
)}

<script>
  // Nút sao chép địa chỉ: chỉ hiện khi trình duyệt có clipboard. Sao chép xong báo
  // bằng vùng role="status" (trình đọc màn hình đọc lên) và đổi chữ trên nút 2 giây.
  for (const nut of document.querySelectorAll<HTMLButtonElement>('[data-sao-chep]')) {
    if (!navigator.clipboard) continue;
    nut.hidden = false;
    const chu = nut.querySelector('span');
    const cu = chu?.textContent ?? '';
    const bao = nut.closest('.lt3-chu')?.querySelector('[data-bao-chep]');
    nut.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(nut.dataset.saoChep ?? '');
        if (chu) chu.textContent = nut.dataset.daChep ?? cu;
        if (bao) bao.textContent = nut.dataset.daChep ?? '';
        setTimeout(() => { if (chu) chu.textContent = cu; if (bao) bao.textContent = ''; }, 2000);
      } catch { /* trình duyệt từ chối clipboard: địa chỉ vẫn là chữ chọn được */ }
    });
  }
</script>

<style>
  .lt3 {
    display: grid; gap: var(--k-6); align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) { .lt3 { grid-template-columns: 5fr 7fr; gap: var(--k-8); } }

  .lt3-hinh { position: relative; color: var(--do); display: flex; align-items: flex-end; gap: var(--k-4); }
  .lt3-so {
    font-size: clamp(150px, 20vw, 280px); font-weight: 800; line-height: .8; letter-spacing: -.06em;
    color: var(--do);
  }
  .lt3-thang { width: clamp(150px, 20vw, 260px); height: auto; color: var(--do-sau); margin-bottom: 6px; }

  .lt3-tieu-de { font-size: var(--co-h2); line-height: 1.14; margin: 0 0 var(--k-5); }
  .lt3-dc, .lt3-cau {
    display: flex; gap: var(--k-3); align-items: flex-start; margin: 0 0 var(--k-3);
    font-size: var(--co-dan); line-height: 1.45;
  }
  .lt3-dc :global(svg), .lt3-cau :global(svg) { width: 26px; height: 26px; flex: none; color: var(--do); margin-top: 1px; }
  .lt3-luu-y { color: var(--chu-phu); max-width: 52ch; margin: var(--k-4) 0 var(--k-5); }

  .lt3-gon {
    display: flex; gap: var(--k-4); align-items: flex-start;
    padding: var(--k-5); border-radius: var(--bo-anh);
    background: var(--kem-dam); color: var(--than);
    border-left: 4px solid var(--do);
  }
  .lt3-so-nho { font-size: 64px; font-weight: 800; line-height: .85; color: var(--do); letter-spacing: -.05em; }
  .lt3-gon .lt3-cau { font-size: 16px; margin-bottom: 6px; }
  .lt3-gon .lt3-dc { font-size: 15px; color: var(--muc-nhat); margin-bottom: 4px; }
  .lt3-hang { display: flex; flex-wrap: wrap; gap: 0 var(--k-5); }
</style>
