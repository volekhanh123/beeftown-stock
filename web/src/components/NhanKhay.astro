---
/**
 * ĐỌC NHÃN KHAY — thiết bị chữ ký của trang
 *
 * Bò tại quầy được cắt và đóng sẵn trong khay skin-pack. Nhãn khay ghi năm thứ:
 * tên phần cắt, giá mỗi 100g, trọng lượng, giá cuối (đã gồm VAT) và ngày đóng gói
 * (brief 06/10/2026). Thẻ này dạy cách đọc nhãn mà KHÔNG có con số nào: giá thật của
 * từng khay chỉ có ở quầy — không bịa giá, không dựng nhãn giả, không mã vạch giả.
 *
 * "Đã gồm VAT" chỉ nói về giá cuối trên nhãn khay — không mở rộng thành cam kết
 * thuế / phí cho cả hóa đơn.
 *
 * Một thẻ duy nhất, là nội dung đọc được (không aria-hidden): đầu thẻ có logo và tiêu
 * đề, dưới là năm dòng theo đúng thứ tự in trên nhãn — số thứ tự, tên trường, lời giải
 * thích. Thẻ đặt THẲNG, PHẲNG (không nghiêng, không bóng đổ), nền Cream trên dải tối
 * nhờ lớp .the của hệ giao diện — không còn nền trắng ngà (bảng màu không có trắng).
 * Dùng chung cho trang chủ (Quầy chọn bò) và trang Thực đơn (Bò tại quầy).
 */
import { dich } from '../lib/chu';
import type { NgonNgu } from '../lib/noi-dung';

interface Props { ngonNgu: NgonNgu; class?: string; }
const { ngonNgu, class: lop } = Astro.props;

const truong = dich(ngonNgu, {
  ten:     { vi: 'Tên phần cắt', en: 'Cut', ko: '부위' },
  gia100:  { vi: 'Giá / 100g', en: 'Price / 100g', ko: '100g당 가격' },
  can:     { vi: 'Trọng lượng', en: 'Weight', ko: '중량' },
  giaCuoi: { vi: 'Giá cuối', en: 'Final price', ko: '최종 가격' },
  ngay:    { vi: 'Ngày đóng gói', en: 'Packed on', ko: '포장일' },
});
const giai = dich(ngonNgu, {
  ten:     { vi: 'Phần thịt nằm trong khay.', en: 'Which cut is in the tray.', ko: '트레이에 담긴 부위예요.' },
  gia100:  { vi: 'Để so các phần với nhau cho dễ.', en: 'Makes it easy to compare cuts.', ko: '부위끼리 쉽게 비교할 수 있어요.' },
  can:     { vi: 'Cân riêng cho từng khay.', en: 'Weighed for each tray.', ko: '트레이마다 따로 잰 무게예요.' },
  giaCuoi: { vi: 'Số tiền của đúng khay này, đã gồm VAT.', en: 'The price of this exact tray, VAT included.', ko: '바로 이 트레이의 가격이에요. 부가세가 포함돼 있어요.' },
  ngay:    { vi: 'Ngày khay được cắt và đóng.', en: 'The day the tray was cut and packed.', ko: '손질해서 포장한 날짜예요.' },
  tieuDe:  { vi: 'Cách đọc nhãn khay', en: 'How to read the tray label', ko: '트레이 라벨 읽는 법' },
});
const KHOA = ['ten', 'gia100', 'can', 'giaCuoi', 'ngay'] as const;
---
<div class:list={['nhan-khay', lop]}>
  <div class="nk-the the">
    <div class="nk-dau">
      <img src="/thuong-hieu/logo-ngang-do.svg" width="446" height="124" alt="" loading="lazy" decoding="async" />
      <h3 class="nk-tieu-de">{giai.tieuDe}</h3>
    </div>
    <ol class="nk-dong" role="list">
      {KHOA.map((k, i) => (
        <li><span class="nk-so" aria-hidden="true">{i + 1}</span><strong class="nk-ten">{truong[k]}</strong>{' '}<span class="nk-giai">{giai[k]}</span></li>
      ))}
    </ol>
  </div>
</div>

<style>
  /* Thẻ rộng vừa đủ một dòng tên trường + lời giải thích; trên máy tính không kéo hết 1200px. */
  .nk-the { max-width: 880px; }

  /* Đầu thẻ: logo (lockup rộng 160px — mức tối thiểu của guideline) và tiêu đề; nét đỏ như mép nhãn. */
  .nk-dau {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-3) var(--k-5);
    padding-bottom: var(--k-4); border-bottom: 2px solid var(--do);
  }
  .nk-dau img { width: 160px; height: auto; flex: none; }
  .nk-tieu-de { margin: 0; }

  /* Năm trường, đọc từ trên xuống. Điện thoại: tên trường trên, lời giải thích dưới.
     Từ 600px: số | tên trường | lời giải thích trên một hàng. */
  .nk-dong { list-style: none; margin: 0; padding: 0; }
  .nk-dong li {
    display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: var(--k-3); align-items: start;
    padding: var(--k-3) 0; border-bottom: 1px dashed var(--vien);
  }
  .nk-dong li:last-child { border-bottom: 0; padding-bottom: 0; }
  .nk-so {
    grid-row: 1 / span 2;
    display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    background: var(--do); color: var(--kem); font-size: 14px; font-weight: 800; line-height: 1;
  }
  .nk-ten { grid-column: 2; font-size: 17px; font-weight: 700; line-height: 28px; }
  .nk-giai { grid-column: 2; color: var(--chu-chinh); }
  @media (min-width: 600px) {
    .nk-dong li { grid-template-columns: 28px minmax(150px, 13em) minmax(0, 1fr); column-gap: var(--k-4); align-items: center; padding: var(--k-4) 0; }
    .nk-so { grid-row: auto; }
    .nk-giai { grid-column: 3; }
  }
  /* Tương phản cao (Windows): nền của số thứ tự bị ép mất — giữ vòng viền để vẫn thấy là một dấu số. */
  @media (forced-colors: active) { .nk-so { border: 1px solid CanvasText; } }
</style>
