---
/**
 * Ô tìm + lọc ngày + "chỉ phiếu tôi lập" cho danh sách phiếu (GĐ4b).
 *
 * Một form GET duy nhất: bấm "Tìm" hay "Lọc" đều gửi cả chữ tìm lẫn ngày.
 * Các tham số khác của trang (trạng thái, loại phiếu) đi theo bằng ô ẩn.
 * Phần ngày gập lại; đang lọc ngày thì tự mở để người dùng thấy.
 */
import { homNayVn, congNgay, dinhDangNgay } from '../../lib/kho/chung.ts';
import { dangTim, linkDs, type TimDs } from '../../lib/kho/tim-ds.ts';

interface Props {
  duong: string;
  tim: TimDs;
  /** Tham số trang cần giữ khi tìm (ví dụ { loc: 'cho_duyet' }). */
  giu?: Record<string, string | null | undefined>;
  goiY: string;
  /** Hiện ô "Chỉ phiếu tôi lập" (vai lập phiếu). */
  coCuaToi?: boolean;
}
const { duong, tim, giu = {}, goiY, coCuaToi = false } = Astro.props;
const sp = Astro.url.searchParams;
const homNay = homNayVn();
const dauThang = homNay.slice(0, 8) + '01';
const MOC: [string, string, string][] = [
  ['Hôm nay', homNay, homNay],
  ['7 ngày', congNgay(homNay, -6), homNay],
  ['Tháng này', dauThang, homNay],
];
const tomTat = [
  tim.tu || tim.den
    ? (tim.tu === tim.den ? dinhDangNgay(tim.tu) : `${tim.tu ? dinhDangNgay(tim.tu) : '…'} – ${tim.den ? dinhDangNgay(tim.den) : '…'}`)
    : null,
  tim.cuaToi ? 'phiếu tôi lập' : null,
].filter(Boolean).join(' · ');
const boLoc = linkDs(duong, sp, { q: null, tu: null, den: null, cua_toi: null });
---
<form method="GET" action={duong} class="kho-tim" role="search">
  {Object.entries(giu).map(([k, v]) => v ? <input type="hidden" name={k} value={v} /> : null)}
  <div class="kho-tim-hang">
    <label class="nb-o">
      <input type="search" name="q" value={tim.q} placeholder={goiY} aria-label="Tìm phiếu" autocomplete="off" />
    </label>
    <button type="submit" class="nb-nut phu">Tìm</button>
  </div>
  <details class="nb-the kho-tim-them" open={tim.tu || tim.den ? true : undefined}>
    <summary>
      <span class="kho-tim-chu">Ngày{coCuaToi ? ', người lập' : ''}</span>
      <span class="kho-tim-tom">{tomTat || 'Mọi ngày'}</span>
    </summary>
    <div class="kho-tim-than">
      <div class="kho-dh" role="group" aria-label="Chọn nhanh khoảng ngày">
        {MOC.map(([ten, tu, den]) => (
          <a href={linkDs(duong, sp, { tu, den })} aria-current={tim.tu === tu && tim.den === den ? 'page' : undefined}>{ten}</a>
        ))}
      </div>
      <div class="nb-hai">
        <label class="nb-o"><span>Từ ngày</span><input type="date" name="tu" value={tim.tu ?? ''} /></label>
        <label class="nb-o"><span>Đến ngày</span><input type="date" name="den" value={tim.den ?? ''} /></label>
      </div>
      {coCuaToi && (
        <label class="kho-tim-toi">
          <input type="checkbox" name="cua_toi" value="1" checked={tim.cuaToi} />
          <span>Chỉ phiếu tôi lập</span>
        </label>
      )}
      <button type="submit" class="nb-nut">Lọc</button>
    </div>
  </details>
  {dangTim(tim) && (
    <p class="kho-tim-dang">
      Đang lọc{tim.q ? <>: “<strong>{tim.q}</strong>”</> : ''}{tomTat ? ` · ${tomTat}` : ''}.{' '}
      <a href={boLoc}>Bỏ lọc</a>
    </p>
  )}
</form>
