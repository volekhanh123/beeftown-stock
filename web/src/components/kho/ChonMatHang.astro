---
/**
 * Ô chọn mặt hàng, gom theo loại (tảng / phần cắt / phụ phẩm) và nhóm. Món đếm theo cái (0105: sốt, gia vị,
 * đồ uống) CHỈ hiện khi trang bật `demCai` — nhận hàng, phiếu nhập, xuất, kiểm kê; pha lóc, quầy, công thức,
 * đặt hàng không thấy chúng. Lựa chọn của món đếm theo cái mang data-cai (và data-thung khi có quy đổi thùng)
 * cho CSS :has() của form.
 * Chữ hiện chỉ "tên · nhóm" — thêm "(MÃ)" thì trên điện thoại tên bị cắt giữa
 * chừng. Mã vẫn nằm trong title (rê chuột trên máy tính thấy).
 * Mặt hàng đã ngừng dùng chỉ hiện khi đang là giá trị được chọn sẵn (dữ liệu
 * cũ), để form cũ không tự đổi mặt hàng. Món đang chọn luôn hiện, kể cả khi `loai` / `bo` không gồm nó (món đếm theo
 * cái thì vẫn chỉ khi bật `demCai`, như trước). Không gọi database.
 *
 * Nhóm "Gợi ý" (29/10/2026, như màn Ghép món iPOS): `goiY` là các món đúng ngữ cảnh của màn (món của nhà cung cấp
 * đang chọn, phần hay ra của loại tảng…), theo thứ tự truyền vào, kèm chữ phụ ("thực tế 75%", "Lần trước 12 kg ·
 * 25/10"). Nhóm đứng đầu; món vẫn còn ở nhóm loại của nó (chỉ một lựa chọn mang `selected`). `bo`: món không hiện
 * (vd. đã có trên phiếu).
 */
import { TEN_LOAI_MAT_HANG_NB } from '../../lib/kho/chung.ts';
import { dichNB, nnCua } from '../../lib/ngon-ngu-noi-bo.ts';

interface MatHangChon {
  id: string; ma: string; ten: string; nhom: string | null;
  loai: string; dang_dung: boolean;
  dem_theo_cai?: boolean; so_trong_thung?: number | null;
}
interface Props {
  name: string;
  matHang: MatHangChon[];
  chon?: string;
  loai?: string[];
  batBuoc?: boolean;
  trong?: string;
  /** Hiện cả món đếm theo cái (0105). */
  demCai?: boolean;
  /** Nhóm gợi ý trên cùng: id món + chữ phụ (không bắt buộc). */
  goiY?: { id: string; chu?: string | null }[];
  /** Tên nhóm gợi ý — mặc định "Gợi ý". */
  tenGoiY?: string;
  /** Món không hiện (trừ món đang chọn). */
  bo?: ReadonlySet<string>;
}
const nn = nnCua(Astro);
const t = dichNB(nn, {
  trong: { vi: '— chọn mặt hàng —', en: '— choose an item —' },
  ma: { vi: 'mã', en: 'code' },
  ngungDung: { vi: ' — ngừng dùng', en: ' — no longer used' },
  goiY: { vi: 'Gợi ý', en: 'Suggestions' },
});
const {
  name, matHang, chon = '', loai, batBuoc = false, trong = t.trong, demCai = false, goiY = [], tenGoiY = t.goiY, bo,
} = Astro.props;
const loaiHien = demCai ? ['tang', 'phan_cat', 'phu_pham', 'gia_vi', 'do_uong'] : ['tang', 'phan_cat', 'phu_pham'];
const ds = matHang.filter(m => m.id === chon
  || (m.dang_dung && (!loai || loai.includes(m.loai)) && !bo?.has(m.id)));
const nhom = loaiHien
  .map(l => ({ l, ten: TEN_LOAI_MAT_HANG_NB[l][nn], hang: ds.filter(m => m.loai === l) }))
  .filter(n => n.hang.length > 0);
const theoId = new Map(ds.filter(m => loaiHien.includes(m.loai)).map(m => [m.id, m]));
const daGoiY = new Set<string>();
const goiYHien = goiY.flatMap(g => {
  const m = theoId.get(g.id);
  if (!m || daGoiY.has(g.id)) return [];
  daGoiY.add(g.id);
  return [{ m, chu: g.chu ?? null }];
});
const chonOGoiY = goiYHien.some(g => g.m.id === chon);
/** Chữ của một lựa chọn: "tên · nhóm", thêm chữ phụ của gợi ý. Hai nhóm viết thuộc tính giống hệt nhau (kiểm thử đếm). */
const chuMon = (m: MatHangChon, phu: string | null = null) =>
  `${m.ten}${m.nhom ? ` · ${m.nhom}` : ''}${!m.dang_dung ? t.ngungDung : ''}${phu ? ` — ${phu}` : ''}`;
---
<select name={name} required={batBuoc}>
  <option value="">{trong}</option>
  {goiYHien.length > 0 && (
    <optgroup label={tenGoiY}>
      {goiYHien.map(({ m, chu }) => (
        <option value={m.id} selected={m.id === chon} title={`${m.ten} · ${t.ma} ${m.ma}`}
                data-cai={m.dem_theo_cai ? '' : undefined}
                data-thung={m.dem_theo_cai && m.so_trong_thung ? String(m.so_trong_thung) : undefined}>
          {chuMon(m, chu)}
        </option>
      ))}
    </optgroup>
  )}
  {nhom.map(n => (
    <optgroup label={n.ten}>
      {n.hang.map(m => (
        <option value={m.id} selected={m.id === chon && !chonOGoiY} title={`${m.ten} · ${t.ma} ${m.ma}`}
                data-cai={m.dem_theo_cai ? '' : undefined}
                data-thung={m.dem_theo_cai && m.so_trong_thung ? String(m.so_trong_thung) : undefined}>
          {chuMon(m)}
        </option>
      ))}
    </optgroup>
  ))}
</select>
