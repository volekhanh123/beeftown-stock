---
/**
 * Câu báo kết quả (xanh = xong, đỏ = lỗi) và lỗi đọc dữ liệu. Không gọi database.
 *
 * Màn tiếng Anh: câu thư viện viết sẵn bản tiếng Anh (KetQua.cauEn) thì dùng;
 * còn lại — câu database, câu lỗi đọc — tra dichCau(). Chưa có bản dịch thì hiện
 * nguyên tiếng Việt, vẫn hơn một thông báo trống.
 */
import type { KetQua } from '../../lib/kho/chung.ts';
import { nnCua } from '../../lib/ngon-ngu-noi-bo.ts';
import { dichCau } from '../../lib/cau-noi-bo.ts';

interface Props {
  bao?: KetQua | null;
  loiDoc?: string | null;
}
const { bao, loiDoc } = Astro.props;
const nn = nnCua(Astro);
const cauBao = bao ? (nn === 'en' && bao.cauEn ? bao.cauEn : dichCau(nn, bao.cau)) : '';
---
{bao && (
  <div class={`nb-bao ${bao.ok ? 'xong' : 'loi'}`} role={bao.ok ? 'status' : 'alert'}><p>{cauBao}</p></div>
)}
{loiDoc && <div class="nb-bao loi" role="alert"><p>{dichCau(nn, loiDoc)}</p></div>}
