---
/**
 * Nút "In phiếu". Chỉ hiện khi có JavaScript (public/kho/js/in-an.js bật nó
 * lên); không có JS thì in bằng menu trình duyệt — CSS in vẫn áp dụng.
 */
interface Props { chu?: string }
const { chu = 'In phiếu' } = Astro.props;
---
<div class="kho-nut-in kho-khong-in">
  <button type="button" class="nb-nut phu" data-in hidden>🖨 {chu}</button>
</div>
<script is:inline src="/kho/js/in-an.js" defer></script>
