---
/**
 * Chọn kỳ báo cáo (GĐ8c): nút nhanh Hôm nay · 7 ngày · Tháng này · Tháng trước ·
 * Quý này · Năm nay (link, giữ các tham số khác), hai ô ngày + "Xem", và nút
 * "Tải về Excel (CSV)" là nút gửi của CHÍNH form này (formaction) — file luôn
 * lấy đúng hai ngày đang thấy. Không JavaScript, không gọi database.
 */
import { kyNhanh } from '../../lib/kho/bao-cao.ts';

interface Props {
  /** Đường trang, vd /noi-bo/kho/bao-cao/mua-hang */
  duong: string;
  tu: string;
  den: string;
  homNay: string;
  /** Tham số giữ nguyên khi đổi kỳ (vd nhom=ncc). */
  giu?: Record<string, string>;
  /** Đường file CSV (vd /noi-bo/kho/bao-cao/mua-hang.csv); trống = không có nút. */
  csv?: string | null;
}
const { duong, tu, den, homNay, giu = {}, csv } = Astro.props;
const cacKy = kyNhanh(homNay);
// Hôm mùng 1, "Hôm nay" và "Tháng này" trùng ngày — chỉ tô nút đầu tiên.
const kyDangChon = cacKy.find(x => x.tu === tu && x.den === den)?.ten;
const link = (x: { tu: string; den: string }) => `${duong}?${new URLSearchParams({ ...giu, tu: x.tu, den: x.den }).toString()}`;
---
<form method="GET" action={duong} class="nb-the kho-khong-in">
  {Object.entries(giu).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <nav class="kho-dh" aria-label="Chọn nhanh kỳ" style="margin:0;padding:0 0 .75rem">
    {cacKy.map(x => (
      <a href={link(x)} aria-current={x.ten === kyDangChon ? 'page' : undefined} style="min-height:48px">{x.ten}</a>
    ))}
  </nav>
  <div class="kho-luoi">
    <label class="nb-o"><span>Từ ngày</span><input type="date" name="tu" value={tu} required /></label>
    <label class="nb-o"><span>Đến ngày</span><input type="date" name="den" value={den} required /></label>
  </div>
  <div class="kho-thanh-nut" style="margin:0">
    <button type="submit" class="nb-nut phu">Xem</button>
    {csv && <button type="submit" class="nb-nut phu" formaction={csv}>Tải về Excel (CSV)</button>}
  </div>
  {csv && <p class="kho-phu" style="margin:.6rem 0 0">File Excel lấy đúng hai ngày đang chọn ở trên. Dòng đầu ghi chi nhánh và kỳ, dòng cuối là tổng.</p>}
</form>
