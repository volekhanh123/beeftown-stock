---
/**
 * TRANG THỰC ĐƠN — Bò tại quầy / Món ăn / Đồ uống
 *
 * Ba phần, theo brief 06/10/2026:
 *  1. BÒ TẠI QUẦY — luôn đầy đủ, kể cả khi chưa có database: khay skin-pack, nhãn
 *     khay (NhanKhay), nhân viên tư vấn, nướng trên vỉ gas tại bàn. KHÔNG BAO GIỜ
 *     có giá: trọng lượng và giá của khay thật chỉ có trên nhãn, tại quầy.
 *  2. MÓN ĂN và 3. ĐỒ UỐNG — tên món đọc từ thuc_don_cong_khai() (lib/thuc-don.ts).
 *     Chưa công bố món nào thì không để trống: giới thiệu theo những nhóm món đã
 *     xác nhận bán. Đồ uống có cồn chỉ được nhắc khi hien_do_uong_co_con bật.
 *
 * Thanh chọn phần: KHÔNG có JavaScript thì là ba link neo và cả ba phần cùng hiện.
 * CÓ JavaScript thì thành tab ARIA (tablist / tab / tabpanel, roving tabindex, mũi
 * tên trái / phải, Home / End), chỉ phần đang chọn hiện; mở đúng tab theo #hash
 * và ghi lại hash bằng history.replaceState (không thêm một bước "quay lại").
 *
 * Không có: giá chưa duyệt, mô tả nguyên liệu tự viết, nhãn chay / cay / dị ứng tự
 * thêm, combo, lời hứa bày nhiều món kèm.
 */
import { chu, dich, duongDanTuongUng } from '../lib/chu';
import { coKenhHoiBan } from '../lib/trang-cong-khai';
import { NHAN_MON, type ThucDon } from '../lib/thuc-don';
import { dinhDangNgay, type NgonNgu, type NoiDung } from '../lib/noi-dung';
import Anh from './Anh.astro';
import BieuTuong from './BieuTuong.astro';
import LenTang3 from './LenTang3.astro';
import NhanKhay from './NhanKhay.astro';
import ThucDonNhom from './ThucDonNhom.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; thucDon: ThucDon; }
const { ngonNgu, noiDung: nd, thucDon: td } = Astro.props;
const t = chu(ngonNgu);

const c = dich(ngonNgu, {
  tieuDe: {
    vi: 'Bò chọn tại quầy, món ngon cho cả bàn',
    en: 'Beef from the counter, food for the table',
    ko: '정육 코너에서 고르는 소고기, 함께 나누는 요리',
  },
  dan: {
    vi: 'Thực đơn Beeftown có ba phần: bò bạn tự chọn tại quầy, rồi món ăn và đồ uống để cả bàn dùng chung.',
    en: 'The Beeftown menu comes in three parts: the beef you choose yourself at the counter, then dishes and drinks for the whole table to share.',
    ko: 'Beeftown 메뉴는 세 부분으로 나뉘어요. 정육 코너에서 직접 고르는 소고기, 그리고 테이블에서 함께 나누는 요리와 음료예요.',
  },
  cacPhan: { vi: 'Các phần của thực đơn', en: 'Menu sections', ko: '메뉴 구성' },
  tabQuay: { vi: 'Bò tại quầy', en: 'Beef counter', ko: '정육 코너' },
  tabMon: { vi: 'Món ăn', en: 'Dishes', ko: '요리' },
  tabUong: { vi: 'Đồ uống', en: 'Drinks', ko: '음료' },

  // --- 1. Bò tại quầy -------------------------------------------------------
  // Hai vế của tiêu đề xuống dòng ở dấu phẩy, không gãy giữa một vế.
  quayTieuDe1: { vi: 'Chọn theo khay,', en: 'Choose by the tray,', ko: '트레이로 고르고,' },
  quayTieuDe2: { vi: 'giá xem trên nhãn', en: 'check the label', ko: '라벨로 확인하세요' },
  quayDan: {
    vi: 'Bò được cắt và đóng sẵn trong khay skin-pack, bày trên quầy để bạn nhìn tận mắt. Nhân viên ở quầy tư vấn phần nào hợp với bàn của bạn.',
    en: 'Our beef is cut and sealed in skin-pack trays and laid out on the counter, so you can see exactly what you are choosing. The counter staff will help you find what suits your table.',
    ko: '소고기는 손질해서 스킨팩 트레이에 담아 정육 코너에 진열해 두었어요. 직접 눈으로 보고 고르시면 되고, 테이블에 맞는 부위는 직원이 추천해 드려요.',
  },
  quayGia: {
    vi: 'Mỗi khay có nhãn riêng: trọng lượng và giá của từng khay, bạn xem ngay tại quầy.',
    en: 'Every tray has its own label, so the weight and price of each one are right there at the counter.',
    ko: '트레이마다 라벨이 따로 붙어 있어요. 트레이별 중량과 가격은 정육 코너에서 바로 확인하실 수 있어요.',
  },
  quayNuong: {
    vi: 'Chọn xong, cả bàn cùng nướng trên vỉ gas đặt tại bàn.',
    en: 'Then the whole table grills it together on the gas grill at your table.',
    ko: '고른 고기는 테이블의 가스 그릴에서 다 함께 구워 드세요.',
  },
  quayThem: {
    vi: 'Đang ăn muốn thêm? Bạn cứ gọi nhân viên để chọn thêm phần bò.',
    en: 'Want more during the meal? Just call a staff member over to choose some more.',
    ko: '식사 중에 더 드시고 싶으면 언제든 직원을 불러 더 골라 주세요.',
  },
  ghiGoiThem: {
    vi: 'Không bắt buộc, gọi thêm khi bạn muốn.',
    en: 'Optional. Add them whenever you like.',
    ko: '필수는 아니에요. 원하실 때 추가로 주문하세요.',
  },
  ghiTaiQuay: {
    vi: 'Giá của từng khay in trên nhãn, xem tại quầy.',
    en: 'Each tray is priced on its own label at the counter.',
    ko: '트레이별 가격은 정육 코너의 라벨에서 확인하세요.',
  },

  // --- 2. Món ăn -------------------------------------------------------------
  monTieuDe: { vi: 'Gọi thêm cho cả bàn', en: 'More for the table', ko: '테이블에 함께 곁들일 요리' },
  monDan: {
    vi: 'Món để cả bàn dùng chung, ăn cùng phần bò vừa nướng.',
    en: 'Plates to share around the grill, alongside the beef you picked.',
    ko: '구운 고기와 함께 테이블에서 나눠 드시기 좋은 요리예요.',
  },
  monDanNhom: {
    vi: 'Bên cạnh phần bò, cả bàn có thể gọi thêm từ những nhóm món này.',
    en: 'Alongside the beef, the table can order from these parts of the menu.',
    ko: '소고기와 함께 아래 메뉴도 주문하실 수 있어요.',
  },

  // --- 3. Đồ uống ------------------------------------------------------------
  uongTieuDe: { vi: 'Uống gì cùng bữa nướng?', en: 'Something to drink with the grill', ko: '구이와 어울리는 음료' },
  uongDan: {
    vi: 'Đồ uống đi cùng bữa nướng của cả bàn.',
    en: 'Drinks to go with your grill.',
    ko: '구이와 함께 즐기기 좋은 음료예요.',
  },
  // Ngày cập nhật thực đơn, cho khách biết danh sách mới tới đâu. Số phiên bản
  // (v1.0) là ghi chú nội bộ của /noi-bo, không in lên trang.
  capNhat: {
    vi: (ngay: string) => `Thực đơn cập nhật ${ngay}.`,
    en: (ngay: string) => `Menu updated ${ngay}.`,
    ko: (ngay: string) => `메뉴 업데이트: ${ngay}`,
  },

  // --- Cuối trang ------------------------------------------------------------
  moiHieu: { vi: 'Đi đông người', en: 'Coming as a group', ko: '여럿이 오실 때' },
  // Hai câu của tiêu đề xuống dòng ở giữa hai câu, không gãy giữa một câu.
  moiTieuDe1: { vi: 'Đi cả nhà, cả nhóm?', en: 'Bringing family or friends?', ko: '가족이나 친구들과 오시나요?' },
  moiTieuDe2: { vi: 'Hỏi bàn trước nhé.', en: 'Ask for a table first.', ko: '테이블을 먼저 문의해 주세요.' },
  moiDan: {
    vi: 'Cho Beeftown biết ngày và số người. Nhà hàng kiểm tra rồi liên hệ để xác nhận với bạn.',
    en: 'Tell us the day and how many of you are coming. We will check and contact you to confirm.',
    ko: '날짜와 인원을 알려 주세요. 매장에서 확인한 뒤 연락드릴게요.',
  },
  moiTieuDeDen: {
    vi: 'Đi cùng cả nhà hay nhóm bạn?',
    en: 'Coming with family or friends?',
    ko: '가족이나 친구들과 오시나요?',
  },
  moiDanDen: {
    vi: 'Xem trước đường lên tầng 3 để cả nhóm tìm tới dễ dàng.',
    en: 'Check the way up to Floor 3 before you go, so everyone finds it easily.',
    ko: '모두 쉽게 찾아오실 수 있게 3층 오시는 길을 미리 확인해 보세요.',
  },
});

// Những nhóm món ĐÃ XÁC NHẬN bán (brief 06/10/2026) — chỉ dùng khi chưa công bố món
// nào. Tên nhóm lấy từ lib/chu.ts: một bộ tên cho cả trang chủ lẫn trang này.
const NHOM_MON_AN = [t.nhomSalad, t.nhomCom, t.nhomMiY, t.nhomMien, t.nhomCanh, t.nhomLau, t.nhomTrangMieng];
const DO_UONG_KHONG_CON = [t.nhomNuocEp];
// Đồ uống có cồn: luật quảng cáo rượu bia — chỉ nhắc khi công tắc hien_do_uong_co_con bật.
const DO_UONG_CO_CON = [t.nhomHighball, t.nhomMakgeolli, t.nhomCocktail];

const coMonAn = td.monAn.length > 0;
const coDoUong = td.doUong.length > 0;
const nhacCoCon = !coDoUong && nd.hien_do_uong_co_con === true;
const hienLuatRuou = td.coDoUongCoCon || nhacCoCon;
const doUongGioiThieu = [
  ...DO_UONG_KHONG_CON.map(ten => ({ ten, coCon: false })),
  ...(nhacCoCon ? DO_UONG_CO_CON.map(ten => ({ ten, coCon: true })) : []),
];
const ngayCapNhat = td.capNhatNgay ? dinhDangNgay(td.capNhatNgay, ngonNgu) : null;

// Bò tại quầy: nhóm chính (thit_bo) luôn đứng trước nhóm gọi thêm, bất kể thứ tự
// database trả (seed 0011 đặt goi-them trước bo-tai-quay). sort ổn định: các nhóm
// cùng loại giữ nguyên thứ tự của database.
const nhomQuay = [...td.boTaiQuay].sort((a, b) => Number(a.loai !== 'thit_bo') - Number(b.loai !== 'thit_bo'));

const PHAN = [
  { id: 'bo-tai-quay', ten: c.tabQuay },
  { id: 'mon-an', ten: c.tabMon },
  { id: 'do-uong', ten: c.tabUong },
];

const coKenh = coKenhHoiBan(nd);
---
<section class="mo-dau-trang be-kem" aria-labelledby="td-tieu-de">
  <div class="khung">
    <p class="hieu">{t.thucDon}</p>
    <h1 id="td-tieu-de">{c.tieuDe}</h1>
    <p class="dan">{c.dan}</p>
  </div>
  <span class="trang-tri net huong-thao-5 net-goc" aria-hidden="true"></span>
</section>

<div class="td" data-td>
  <div class="td-thanh" data-td-thanh>
    <div class="khung">
      <nav class="td-tab" aria-label={c.cacPhan} data-td-tab>
        {PHAN.map(p => <a id={`td-tab-${p.id}`} href={`#${p.id}`}>{p.ten}</a>)}
      </nav>
    </div>
  </div>

  {/* 1 · BÒ TẠI QUẦY — luôn đầy đủ, không bao giờ có giá ----------------------- */}
  <section id="bo-tai-quay" class="muc be-toi td-phan" aria-labelledby="td-h-quay">
    <div class="khung">
      <div class="td-quay-dau">
        <div class="td-quay-chu">
          <p class="hieu">{c.tabQuay}</p>
          <h2 id="td-h-quay"><span class="cau">{c.quayTieuDe1}</span> <span class="cau">{c.quayTieuDe2}</span></h2>
          <p class="dan">{c.quayDan}</p>
          <p>{c.quayGia}</p>
          <p>{c.quayNuong}</p>
        </div>
        <div class="td-quay-anh">
          <Anh id="bo-cat-lat" ngonNgu={ngonNgu} khung="3x2" thayBang="khay" nenKhung="toi"
               sizes="(min-width: 900px) 56vw, 100vw" />
        </div>
      </div>

      <div class="td-quay-nhan">
        <NhanKhay ngonNgu={ngonNgu} />
      </div>

      <p class="td-them"><BieuTuong ten="cong" /><span>{c.quayThem}</span></p>

      {nhomQuay.length > 0 && (
        <div class:list={['td-cac-nhom', 'td-quay-nhom', { 'mot-nhom': nhomQuay.length === 1 }]}>
          {nhomQuay.map(n => (
            <ThucDonNhom nhom={n} ngonNgu={ngonNgu}
                         ghiChu={n.loai === 'thit_bo' ? c.ghiTaiQuay : n.loai === 'goi_them' ? c.ghiGoiThem : undefined}
                         khongGia={n.loai === 'thit_bo'} />
          ))}
        </div>
      )}
    </div>
  </section>

  {/* 2 · MÓN ĂN ------------------------------------------------------------------ */}
  <section id="mon-an" class="muc be-kem td-phan" aria-labelledby="td-h-mon">
    <div class="khung td-bo-cuc">
      <div class="td-ben co-anh">
        <p class="hieu">{c.tabMon}</p>
        <h2 id="td-h-mon">{c.monTieuDe}</h2>
        <p class="dan">{coMonAn ? c.monDan : c.monDanNhom}</p>
        <div class="td-anh-mon">
          <Anh id="sot-cham" ngonNgu={ngonNgu} khung="4x3" thayBang="ban-nuong"
               sizes="(min-width: 1024px) 34vw, (min-width: 600px) 70vw, 100vw" />
        </div>
      </div>
      <div class="td-chinh">
        {coMonAn ? (
          <div class:list={['td-cac-nhom', { 'mot-nhom': td.monAn.length === 1 }]}>
            {td.monAn.map(n => <ThucDonNhom nhom={n} ngonNgu={ngonNgu} />)}
          </div>
        ) : (
          <ul class="td-danh-muc" role="list">
            {NHOM_MON_AN.map(ten => <li><span class="td-dm-ten">{ten}</span></li>)}
          </ul>
        )}
      </div>
    </div>
  </section>

  {/* 3 · ĐỒ UỐNG ---------------------------------------------------------------- */}
  <section id="do-uong" class="muc be-kem-dam td-phan" aria-labelledby="td-h-uong">
    <div class="khung td-bo-cuc">
      <div class="td-ben">
        <p class="hieu">{c.tabUong}</p>
        <h2 id="td-h-uong">{c.uongTieuDe}</h2>
        <p class="dan">{c.uongDan}</p>
      </div>
      <div class="td-chinh">
        {coDoUong ? (
          <div class:list={['td-cac-nhom', { 'mot-nhom': td.doUong.length === 1 }]}>
            {td.doUong.map(n => <ThucDonNhom nhom={n} ngonNgu={ngonNgu} />)}
          </div>
        ) : (
          <ul class:list={['td-danh-muc', { 'mot-cot': doUongGioiThieu.length < 4 }]} role="list">
            {doUongGioiThieu.map(d => (
              <li>
                <span class="td-dm-ten">{d.ten}</span>
                {d.coCon && <span class="nhan-mon"><BieuTuong ten="co-con" /><span>{NHAN_MON.coCon[ngonNgu]}</span></span>}
              </li>
            ))}
          </ul>
        )}
        {hienLuatRuou && <p class="td-luat"><BieuTuong ten="co-con" /><span>{t.luatRuou}</span></p>}
      </div>
    </div>
  </section>
</div>

{/* Cuối trang: mời hỏi bàn — chỉ khi có kênh thật để hỏi; không thì chỉ đường lên. */}
<section class="muc be-do nen-van-mo td-moi" aria-labelledby="td-h-moi">
  <div class="khung td-moi-luoi">
    <div class="td-moi-chu">
      <p class="hieu">{c.moiHieu}</p>
      <h2 id="td-h-moi">{coKenh ? <><span class="cau">{c.moiTieuDe1}</span> <span class="cau">{c.moiTieuDe2}</span></> : c.moiTieuDeDen}</h2>
      <p class="dan">{coKenh ? c.moiDan : c.moiDanDen}</p>
      <div class="hang-nut">
        {coKenh && <a class="nut nut-chinh" href={duongDanTuongUng('/dat-ban', ngonNgu)}>{t.datBan}</a>}
        <a class:list={['nut', coKenh ? 'nut-vien' : 'nut-chinh']} href={duongDanTuongUng('/den-beeftown', ngonNgu)}>{t.xemDuongLen}</a>
      </div>
      {ngayCapNhat && <p class="nho td-cap-nhat">{c.capNhat(ngayCapNhat)}</p>}
    </div>
    <div class="td-the-tang3">
      <LenTang3 ngonNgu={ngonNgu} noiDung={nd} gon khongLinkDuongDen />
    </div>
  </div>
</section>

<script>
  // THANH CHỌN PHẦN → TAB ARIA. Không có script này: ba link neo, ba phần cùng hiện
  // (trang vẫn đủ). Có script: chỉ phần đang chọn hiện; mũi tên trái / phải, Home,
  // End chuyển tab (roving tabindex — Tab đi thẳng vào nội dung của phần đang mở).
  const vo = document.querySelector<HTMLElement>('[data-td-thanh]');
  const thanh = document.querySelector<HTMLElement>('[data-td-tab]');
  const tabs = thanh ? Array.from(thanh.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) : [];
  const phan = tabs.map(a => document.getElementById(a.hash.slice(1)));

  if (vo && thanh && tabs.length > 1 && phan.every(p => p instanceof HTMLElement)) {
    const cacPhan = phan as HTMLElement[];
    thanh.setAttribute('role', 'tablist');
    tabs.forEach((a, i) => {
      a.setAttribute('role', 'tab');
      a.setAttribute('aria-controls', cacPhan[i].id);
      cacPhan[i].setAttribute('role', 'tabpanel');
      cacPhan[i].setAttribute('aria-labelledby', a.id);
    });
    // Phần (tabpanel) chỉ nhận tiêu điểm SAU KHI người dùng đã dùng bàn phím trên thanh tab
    // (mũi tên, Home / End, hay Tab để đi tiếp vào nội dung). Gán tabIndex ngay lúc tải thì
    // trình duyệt, khi cuộn tới #mon-an / #do-uong, đặt luôn tiêu điểm vào cả phần và vẽ
    // vòng focus quanh toàn bộ thực đơn — chỉ vì khách mở một link có #hash.
    let phanNhanTieuDiem = false;
    const choPhanNhanTieuDiem = () => {
      if (phanNhanTieuDiem) return;
      phanNhanTieuDiem = true;
      cacPhan.forEach(p => { p.tabIndex = 0; });
    };

    // Đổi tab giữa chừng một phần dài: đưa đầu phần mới về ngay dưới thanh, để
    // người đọc không rơi vào giữa (hay cuối) một phần khác. Không cuộn mượt.
    // Tính theo vị trí tuyệt đối và đợi hết khung hình kế tiếp: khi phần dài bị ẩn,
    // trình duyệt tự "neo cuộn" (scroll anchoring) ở bước dựng khung — cuộn trước
    // bước đó thì bị neo cuộn kéo lệch đi.
    const veDau = (p: HTMLElement) => requestAnimationFrame(() => requestAnimationFrame(() => {
      const day = (parseFloat(getComputedStyle(vo).top) || 0) + vo.offsetHeight;
      const dau = p.getBoundingClientRect().top;
      if (dau < day) window.scrollTo(0, window.scrollY + dau - day);
    }));
    const chon = (i: number, { tieuDiem = false, ghiHash = false, cuon = false } = {}) => {
      tabs.forEach((a, j) => {
        const dang = j === i;
        a.setAttribute('aria-selected', String(dang));
        a.tabIndex = dang ? 0 : -1;
        cacPhan[j].hidden = !dang;
      });
      if (tieuDiem) tabs[i].focus();
      if (ghiHash && location.hash !== tabs[i].hash) history.replaceState(history.state, '', tabs[i].hash);
      if (cuon) veDau(cacPhan[i]);
    };
    const theoHash = () => tabs.findIndex(a => a.hash === location.hash);

    const dauTien = theoHash();
    chon(dauTien >= 0 ? dauTien : 0, { cuon: dauTien >= 0 });
    vo.closest('[data-td]')?.setAttribute('data-tab', '');

    tabs.forEach((a, i) => a.addEventListener('click', e => {
      // Ctrl / ⌘ / Shift + bấm: để trình duyệt mở tab mới như một link thường.
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      chon(i, { ghiHash: true, cuon: true });
    }));
    thanh.addEventListener('keydown', e => {
      const i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0 || e.altKey || e.ctrlKey || e.metaKey) return;
      choPhanNhanTieuDiem();
      const n = tabs.length;
      const j = e.key === 'ArrowRight' ? (i + 1) % n
        : e.key === 'ArrowLeft' ? (i - 1 + n) % n
        : e.key === 'Home' ? 0
        : e.key === 'End' ? n - 1
        : e.key === ' ' ? i
        : -1;
      if (j < 0) return;
      e.preventDefault();
      chon(j, { tieuDiem: true, ghiHash: true, cuon: true });
    });
    // Link khác trên trang (hay nút lùi) đổi #hash → mở đúng tab.
    addEventListener('hashchange', () => {
      const j = theoHash();
      if (j >= 0) chon(j, { cuon: true });
    });
  }
</script>

<style>
  /* --- Thanh chọn phần ------------------------------------------------------ */
  .td { --cao-thanh: 57px; }
  .td-thanh {
    position: sticky; top: var(--cao-dau); z-index: 30;
    background: var(--kem);
    border-bottom: 1px solid var(--vach);
  }
  /* Màn thấp (điện thoại xoay ngang, phóng to 200 %): đầu trang và thanh tab cùng dính
     thì ăn gần nửa màn hình — thanh tab dính sát mép trên. */
  @media (max-height: 500px) { .td-thanh { top: 0; } }
  /* Đệm ngang 8px cho vòng focus không dính chữ; lề âm giữ chữ của tab đầu thẳng
     hàng với lề nội dung. */
  .td-tab {
    display: flex; align-items: stretch;
    gap: clamp(4px, 3vw, 32px);
    margin-left: -8px;
  }
  .td-tab a {
    position: relative;
    display: inline-flex; align-items: center; min-width: 0;
    min-height: 56px; padding: 6px 8px;
    font-weight: 700; font-size: 15px; line-height: 1.2; letter-spacing: .01em;
    color: var(--than); text-decoration: none;
    transition: color var(--nhanh);
  }
  /* Gạch chân của tab: thẳng hàng với CHỮ của tab (trừ đệm 8px hai bên), nằm đè lên
     vạch dưới của thanh — tab đầu không thò ra ngoài lề nội dung. */
  .td-tab a::after {
    content: ''; position: absolute; left: 8px; right: 8px; bottom: -1px; height: 3px;
    background: transparent;
    transition: background-color var(--nhanh);
  }
  .td-tab a:hover::after { background: var(--vien-o); }
  /* Vòng focus nằm trong vùng tab, phía trên gạch chân đỏ của tab đang chọn. */
  .td-tab a:focus-visible { outline-offset: -6px; }
  .td-tab a[aria-selected='true'] { color: var(--do-sau); }
  .td-tab a[aria-selected='true']::after { background: var(--do); }
  @media (min-width: 600px) { .td-tab a { font-size: 16px; } }
  @media (max-width: 380px) { .td-tab { gap: 2px; } .td-tab a { font-size: 14px; } }
  /* Chế độ tương phản cao (Windows): trình duyệt ép mọi nền về màu hệ thống, nên gạch
     đỏ biến mất và ba tab trông như nhau. Tab đang chọn dùng màu Highlight của hệ thống
     cho gạch chân và thêm gạch dưới chữ — phân biệt được cả khi không nhìn ra màu. */
  @media (forced-colors: active) {
    .td-tab a::after, .td-tab a:hover::after { background: transparent; }
    .td-tab a[aria-selected='true']::after { forced-color-adjust: none; background: Highlight; }
    .td-tab a[aria-selected='true'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
  }

  /* Link neo khi không có JS: đầu phần dừng ngay dưới thanh. scroll-padding-top
     của trang đã trừ chiều cao đầu trang + 12px (cong-khai.css), nên ở đây chỉ
     cộng thêm chiều cao thanh. */
  .td-phan { scroll-margin-top: calc(var(--cao-thanh) - 12px); }
  .td-phan[hidden] { display: none !important; }
  .td-phan:focus-visible { outline-offset: -6px; }
  @media print { .td-phan[hidden] { display: block !important; } .td-thanh { display: none; } }

  /* --- 1. Bò tại quầy ------------------------------------------------------- */
  .td-quay-dau {
    display: grid; gap: var(--k-7); align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) { .td-quay-dau { grid-template-columns: 5fr 6fr; gap: var(--k-8); } }
  .td-quay-chu h2 { max-width: 18ch; }
  .td-quay-chu h2 .cau { display: block; }
  .td-quay-chu .dan { margin-bottom: var(--k-4); }
  .td-quay-chu p:not(.hieu):not(.dan) { margin: 0 0 var(--k-3); max-width: 52ch; color: var(--chu-chinh); }
  .td-quay-nhan {
    margin-top: var(--k-8); padding-top: var(--k-7);
    border-top: 1px solid var(--vien);
  }
  .td-them {
    display: flex; gap: var(--k-3); align-items: flex-start;
    margin: var(--k-7) 0 0; padding: var(--k-2) 0 var(--k-2) var(--k-4);
    border-left: 3px solid var(--mu-tat);
    max-width: 60ch; font-size: var(--co-dan); line-height: 1.5; font-weight: 600;
  }
  .td-them :global(svg) { width: 24px; height: 24px; flex: none; color: var(--mu-tat); margin-top: 3px; }
  .td-quay-nhom { margin-top: var(--k-7); }

  /* --- 2 và 3. Món ăn, đồ uống: cột tiêu đề + cột thực đơn ------------------- */
  .td-bo-cuc { display: grid; gap: var(--k-7); grid-template-columns: 1fr; }
  @media (min-width: 1024px) {
    .td-bo-cuc { grid-template-columns: 4fr 7fr; gap: var(--k-9); align-items: start; }
  }
  /* Màn rộng và đủ cao: cột tiêu đề + ảnh đứng yên khi cuộn qua thực đơn dài. */
  @media (min-width: 1024px) and (min-height: 760px) {
    .td-ben { position: sticky; top: calc(var(--cao-dau) + var(--cao-thanh) + var(--k-6)); }
  }
  .td-ben h2 { max-width: 14ch; }
  .td-anh-mon { margin-top: var(--k-6); max-width: 560px; }
  /* Màn vừa: chữ và ảnh cạnh nhau thay vì ảnh nhỏ lạc một bên. */
  @media (min-width: 600px) and (max-width: 1023px) {
    .td-ben.co-anh { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--k-6); align-items: start; }
    .td-ben.co-anh > :not(.td-anh-mon) { grid-column: 1; }
    .td-ben.co-anh .td-anh-mon { grid-column: 2; grid-row: 1 / span 3; margin-top: 0; align-self: center; }
  }

  .td-cac-nhom { columns: 2 320px; column-gap: var(--k-8); }
  /* Mới công bố một nhóm: một cột vừa đọc, không để trống nửa phải. */
  .td-cac-nhom.mot-nhom { columns: auto; max-width: 640px; }
  /* Nhóm cuối không để khoảng trống thừa trước dòng luật rượu / cuối phần. */
  .td-chinh .td-cac-nhom { margin-bottom: calc(-1 * var(--k-7)); }

  /* Chưa công bố món: danh mục nhóm món bằng chữ — yên, rõ, đọc như một tờ menu. */
  .td-danh-muc {
    list-style: none; margin: 0; padding: 0; counter-reset: dm;
    display: grid; grid-template-columns: 1fr; column-gap: var(--k-7);
    border-bottom: 1px solid var(--vien);
  }
  @media (min-width: 640px) { .td-danh-muc:not(.mot-cot) { grid-template-columns: 1fr 1fr; } }
  .td-danh-muc.mot-cot { max-width: 560px; }
  /* Số thứ tự | tên nhóm | nhãn (nếu có): số không bao giờ tách khỏi tên. */
  .td-danh-muc li {
    counter-increment: dm;
    display: grid; grid-template-columns: 2.6em minmax(0, 1fr) auto; align-items: baseline; column-gap: var(--k-3);
    padding: var(--k-4) 0; border-top: 1px solid var(--vien);
  }
  .td-danh-muc li::before {
    content: counter(dm, decimal-leading-zero);
    content: counter(dm, decimal-leading-zero) / '';
    font-size: 13px; font-weight: 700; letter-spacing: .06em; color: var(--nhan-nho);
  }
  /* Danh mục chỉ có một nhóm (đồ uống không cồn khi đồ uống có cồn chưa được nhắc):
     không đánh số "01" cho một dòng duy nhất. */
  .td-danh-muc li:only-child { grid-template-columns: minmax(0, 1fr) auto; }
  .td-danh-muc li:only-child::before { content: none; }
  .td-dm-ten {
    font-size: clamp(21px, 1vw + 16px, 28px); font-weight: 700; line-height: 1.25; letter-spacing: -.01em;
  }
  .td-danh-muc .nhan-mon { justify-self: end; }

  .td-luat {
    display: flex; gap: var(--k-3); align-items: flex-start;
    margin: var(--k-6) 0 0; padding-top: var(--k-4);
    border-top: 1px solid var(--vien);
    font-size: var(--co-nho); font-weight: 600;
  }
  .td-luat :global(svg) { width: 20px; height: 20px; flex: none; color: var(--nhan); }

  /* --- Cuối trang ---------------------------------------------------------- */
  .td-moi-luoi { display: grid; gap: var(--k-7); align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .td-moi-luoi { grid-template-columns: 7fr 5fr; gap: var(--k-8); } }
  .td-moi-chu h2 { max-width: 22ch; }
  .td-moi-chu .cau { display: block; }
  .td-moi-chu .dan { margin-bottom: var(--k-6); }
  /* Ngày cập nhật thực đơn: dòng nhỏ chữ kem cuối khối đỏ. */
  .td-cap-nhat { margin: var(--k-6) 0 0; }
  /* LenTang3 bản gọn là một thẻ kem trên dải đỏ: .be-kem-dam (cong-khai.css) tự đặt lại
     biến màu chữ và vòng focus của nền kem, ở đây giới hạn bề rộng. Viền trái đỏ của
     thẻ trùng màu dải đỏ nên mép thẻ trông như lùi vào 4px: đổi sang đỏ sậm. */
  .td-the-tang3 { max-width: 480px; }
  .td-the-tang3 :global(.lt3-gon) { border-left-color: var(--do-sau); }
</style>
