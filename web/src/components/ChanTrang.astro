---
/**
 * CHÂN TRANG — tuyển dụng, điều hướng phụ, địa chỉ, pháp nhân
 *
 * Ba tầng:
 *  1. Dải tuyển dụng gọn. Tuyển đội mở cửa là "đường găng" của ngày mở (TrangRaMat
 *     cũ), nên nó có mặt ở MỌI trang công khai — chỉ gọn lại so với một khối riêng.
 *  2. Dải đen, nền phẳng: logo chính trắng của bộ 21/10/2026 (logo-ngang-trang.svg — đầu
 *     bò khoét lộ nền đen; guideline trang 4 vẽ bản trắng trên đỏ), các mục điều hướng,
 *     địa chỉ + câu chỉ đường. Một bề mặt một dấu thương hiệu: không tem, không hoa văn
 *     chữ BEEFTOWN chìm sau chữ. Điện thoại: hai nhóm link đứng cạnh nhau thành 2 cột.
 *  3. Pháp nhân, cùng nền đen, ngăn với dải trên bằng một vạch mảnh (--vien: trắng 22 %).
 *     web/kiem-tra/trinh-duyet.mjs đọc chữ của <footer> ĐẦU
 *     TIÊN trên trang: ngay dưới dòng "© … Beeftown · Beef Specialty Restaurant" phải
 *     là ba dòng pháp nhân (tên · mã số thuế, địa chỉ, điện thoại), đúng từng ký tự —
 *     khớp Thông tin doanh nghiệp trên Meta; mọi <p> trong chân trang phải hiện.
 *     Mỗi dòng viết liền trên một dòng mã: compressHTML bỏ dấu cách có xuống dòng
 *     giữa hai nút ("·Beef").
 *
 * Chữ trong chân trang không nhỏ hơn 14px (kể cả dải pháp nhân — dải đó cao theo nội
 * dung, không ép chữ nhỏ cho vừa); mọi link cao 48px. do-giao-dien.mjs đo cả hai.
 */
import { THUONG_HIEU, PHAP_NHAN, chu, dich, duongDanTuongUng } from '../lib/chu';
import { cumDiaChi, dieuHuong, diaChi, lienHe } from '../lib/trang-cong-khai';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import { namVn } from '../lib/gio-vn';
import BieuTuong from './BieuTuong.astro';

interface Props { ngonNgu: NgonNgu; noiDung: NoiDung; duongDan?: string; }
const { ngonNgu, noiDung: nd, duongDan = '' } = Astro.props;
// Trên chính trang tuyển dụng thì dải "đang tìm người" chỉ lặp lại tiêu đề và trỏ về trang đang mở.
const laTrangTuyenDung = duongDan.replace(/\/$/, '') === duongDanTuongUng('/tuyen-dung', ngonNgu);
const t = chu(ngonNgu);
const lh = lienHe(nd);
// Cùng danh sách với đầu trang: năm mục khi trang Mua thịt về mở, bốn mục khi chưa.
const muc = dieuHuong(ngonNgu, nd);
const mangXaHoi = [
  { url: lh.facebook, ten: 'Facebook' },
  { url: lh.instagram, ten: 'Instagram' },
  { url: lh.tiktok, ten: 'TikTok' },
  { url: lh.zalo, ten: 'Zalo' },
].filter((m): m is { url: string; ten: string } => !!m.url);

const c = dich(ngonNgu, {
  tuyenDungNgan: {
    vi: 'Nhà hàng đang tuyển đội mở cửa cho quầy thịt, bếp và sảnh.',
    en: 'We are building our opening team for the butcher counter, kitchen and hall.',
    ko: '정육, 주방, 홀에서 함께할 오픈 팀원을 모집하고 있어요.',
  },
  theoDoi: { vi: 'Theo dõi', en: 'Follow', ko: '팔로우' },
});
---
<footer class="chan-trang">
  {!laTrangTuyenDung && (
    <div class="ct-tuyen-dung be-kem-dam">
      <div class="khung ct-td-hang">
        <p class="ct-td-chu"><strong>{t.tuyenDungTieuDe}.</strong> {c.tuyenDungNgan}</p>
        <a class="lien-ket" href={duongDanTuongUng('/tuyen-dung', ngonNgu)}>{t.tuyenDungXem}<BieuTuong ten="mui-ten" /></a>
      </div>
    </div>
  )}

  <div class="ct-chinh be-toi">
    <div class="khung ct-luoi">
      <div class="ct-logo">
        <img src="/thuong-hieu/logo-ngang-trang.svg" width="579" height="131" alt={THUONG_HIEU.ten} loading="lazy" decoding="async" />
      </div>

      <nav class="ct-cot" aria-labelledby="ct-beeftown">
        <h2 class="ct-tieu-de" id="ct-beeftown">{THUONG_HIEU.ten}</h2>
        <ul>
          {muc.map(m => <li><a href={m.url}>{m.chu}</a></li>)}
        </ul>
      </nav>

      <nav class="ct-cot" aria-labelledby="ct-thong-tin">
        <h2 class="ct-tieu-de" id="ct-thong-tin">{t.thongTin}</h2>
        <ul>
          <li><a href={duongDanTuongUng('/tuyen-dung', ngonNgu)}>{t.tuyenDung}</a></li>
          <li><a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a></li>
          <li><a href={duongDanTuongUng('/xoa-du-lieu', ngonNgu)}>{t.xoaDuLieu}</a></li>
        </ul>
      </nav>

      <div class="ct-cot ct-dia-chi">
        <h2 class="ct-tieu-de">{t.denBeeftown}</h2>
        <address>
          <p lang="vi">{cumDiaChi(diaChi(nd)).map(cum => <><span class:list={{ lien: cum.giu }}>{cum.chu}</span>{cum.cach}</>)}</p>
          <p class="ct-loi-len"><BieuTuong ten="thang-may" /><span>{t.loiLen}</span></p>
        </address>
        {mangXaHoi.length > 0 && (
          <ul class="ct-mxh" aria-label={c.theoDoi}>
            {mangXaHoi.map(m => <li><a href={m.url} rel="noopener">{m.ten}</a></li>)}
          </ul>
        )}
      </div>
    </div>
  </div>

  <div class="ct-day be-toi">
    <div class="khung chan-hang">
      {/* Mỗi dòng viết liền trên một dòng mã: compressHTML bỏ dấu cách có xuống
          dòng giữa hai nút, "·⏎<span>" từng ra trang thành "·Beef". */}
      <div>
        <p class="chan-dong">© {namVn()} {t.banQuyen} · <span lang="en">{THUONG_HIEU.descriptor}</span></p>
        {/* Pháp nhân — tên và địa chỉ giữ tiếng Việt ở mọi bản (PHAP_NHAN trong lib/chu.ts),
            lang="vi" để trình đọc màn hình của trang Anh / Hàn đọc đúng giọng. Điện thoại:
            nhãn theo thứ tiếng của trang, số giữ nguyên và không gãy giữa chừng. */}
        <div class="phap-nhan">
          <p class="chan-dong"><span class="lien" lang="vi">{PHAP_NHAN.ten}</span> · <span class="lien">{t.maSoThue}: {PHAP_NHAN.maSoThue}</span></p>
          <p class="chan-dong" lang="vi">{PHAP_NHAN.diaChi}</p>
          <p class="chan-dong">{t.dienThoai}: <span class="lien">{PHAP_NHAN.dienThoai}</span></p>
        </div>
      </div>
      <a href={duongDanTuongUng('/quyen-rieng-tu', ngonNgu)}>{t.quyenRiengTu}</a>
    </div>
  </div>
</footer>

<style>
  ul { list-style: none; margin: 0; padding: 0; }

  /* --- 1. Tuyển dụng ------------------------------------------------------- */
  .ct-td-hang {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--k-2) var(--k-5); padding-block: var(--k-4);
  }
  .ct-td-chu { margin: 0; max-width: 62ch; font-size: 15px; }

  /* --- 2. Dải đen ---------------------------------------------------------- */
  .ct-chinh { padding-block: var(--k-7) var(--k-6); }
  @media (min-width: 900px) { .ct-chinh { padding-block: var(--k-8) var(--k-7); } }
  /* Điện thoại: hai nhóm link thành 2 cột; logo và địa chỉ rộng hết hàng. */
  .ct-luoi {
    display: grid; gap: var(--k-6) var(--k-5);
    grid-template-columns: 1fr 1fr;
  }
  .ct-logo { grid-column: 1 / -1; display: flex; align-items: center; }
  /* Logo chính rộng 180–280px — trên ngưỡng 160px của lockup (luật giữ từ bộ 09/10/2026); khe lưới
     24–32px và đệm của dải đủ khoảng trống bằng cạnh ô đầu bò quanh logo (guideline trang 3). */
  .ct-logo img:first-child { width: clamp(180px, 26vw, 280px); height: auto; }
  .ct-dia-chi { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .ct-luoi { grid-template-columns: 1.3fr 1fr 1fr 1.4fr; align-items: start; }
    .ct-logo, .ct-dia-chi { grid-column: auto; }
  }
  /* Tên cột: chữ hoa nhỏ 14px (sàn của chân trang), không còn 12px. */
  .ct-tieu-de {
    margin: 0 0 var(--k-2);
    font-size: 14px; line-height: 1.4; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  }
  .ct-tieu-de:lang(ko) { letter-spacing: .04em; }   /* chữ Hangul không giãn như chữ in hoa Latin */
  .ct-cot a {
    display: inline-flex; align-items: center; min-height: var(--cham);
    font-weight: 600; text-decoration: none;
  }
  @media (hover: hover) { .ct-cot a:hover { text-decoration: underline; text-underline-offset: .3em; } }
  address { font-style: normal; }
  address p { margin: 0 0 var(--k-3); max-width: 36ch; }
  .ct-loi-len { display: flex; gap: var(--k-2); align-items: flex-start; font-size: 15px; }
  .ct-loi-len span { text-wrap: balance; }
  address .lien { white-space: nowrap; }
  .ct-loi-len :global(svg) { width: 24px; height: 24px; flex: none; margin-top: -1px; }
  .ct-mxh { display: flex; flex-wrap: wrap; gap: 0 var(--k-5); }

  /* --- 3. Pháp nhân -------------------------------------------------------- */
  /* Nền đen, chữ 14px ở mọi dòng; dải cao theo nội dung; ngăn với dải trên bằng vạch --vien. */
  .ct-day { padding-block: var(--k-5); font-size: 14px; line-height: 1.6; color: var(--chu-phu); border-top: 1px solid var(--vien); }
  .ct-day a { color: var(--chu-chinh); display: inline-flex; align-items: center; min-height: var(--cham); }
  .chan-hang {
    display: flex; flex-wrap: wrap; gap: 10px 24px;
    /* baseline: link Quyền riêng tư đứng ngang dòng ©, không trôi xuống giữa khối pháp nhân. */
    align-items: baseline; justify-content: space-between;
  }
  .chan-dong { margin: 0; color: var(--chu-chinh); }
  /* Dòng pháp nhân: cùng cỡ 14px với dòng ©, màu chữ phụ của nền đen (--da, 16,21 : 1), cách
     dòng © một khoảng. Mỗi cụm (tên công ty, mã số thuế, số điện thoại) không gãy giữa chừng —
     màn hẹp thì xuống dòng ở dấu "·". */
  .phap-nhan { margin-top: var(--k-2); }
  .phap-nhan .chan-dong { color: var(--chu-phu); }
  .phap-nhan .lien { white-space: nowrap; }
</style>
