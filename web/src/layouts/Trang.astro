---
/**
 * KHUNG TRANG — thẻ mô tả, dữ liệu có cấu trúc, đầu và chân trang
 *
 * THẺ CHIA SẺ LINK (og:image):
 * Ảnh THẬT đã công bố ở khóa `anh_chia_se` luôn được ưu tiên. Chưa có thì dùng
 * ảnh dự phòng /thuong-hieu/chia-se-1200x630.png: chỉ có vân mỡ và logo của PDF
 * nhận diện (trang 2), không ảnh chụp, không ngày, không giá — Khánh duyệt
 * 06/10/2026. Ảnh đó đi cùng bản build, nên không có chuyện thẻ og:image trỏ
 * tới ảnh hỏng (điều mà quy tắc cũ "không có ảnh thật thì không đặt thẻ" phòng).
 * v_cong_bo_con_thieu vẫn nhắc anh_chia_se cho tới khi có ảnh chụp thật.
 *
 * DỮ LIỆU CÓ CẤU TRÚC (JSON-LD):
 * Chỉ khai những gì đã công bố. Cụ thể là KHÔNG có:
 *   · priceRange — chưa có khoảng giá nào được duyệt;
 *   · aggregateRating / review — chưa có một đánh giá thật nào, và khai số
 *     liệu đánh giá bịa vừa vi phạm chính sách Google vừa là quảng cáo sai;
 *   · openingHoursSpecification khi giờ chưa chốt — Google đưa giờ này lên
 *     kết quả tìm kiếm, nên khai sai là dẫn khách tới một cánh cửa đóng.
 *
 * BA THỨ TIẾNG:
 * Mỗi trang khai hreflang cho đủ vi/en/ko và x-default về bản tiếng Việt —
 * cùng một bộ với sitemap.xml. Nút đổi ngôn ngữ hiện HAI thứ tiếng còn lại,
 * mỗi cái ghi bằng chính thứ tiếng đó.
 */
import '../styles/chung.css';
import '../styles/cong-khai.css';
import { THUONG_HIEU, NGON_NGU, TEN_NGON_NGU, chu, duongDanTuongUng } from '../lib/chu';
import { lienHe } from '../lib/trang-cong-khai';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import DauTrang from '../components/DauTrang.astro';
import ChanTrang from '../components/ChanTrang.astro';

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  tieuDe?: string;
  moTa?: string;
  duongDan: string;
}

const { ngonNgu, noiDung: nd, tieuDe, moTa, duongDan } = Astro.props;
const t = chu(ngonNgu);

const goc = Astro.site?.origin ?? '';
const duongDanDayDu = goc + duongDan;

// Tiêu đề: ưu tiên bản đã duyệt trong cổng nội dung, sau đó mới tới bản nền.
const tieuDeTrang = tieuDe
  ?? nd.tieu_de_og
  ?? `${THUONG_HIEU.ten} — ${t.nganhHang} · ${t.diaChiNgan}`;

// Mô tả ưu tiên bản đã duyệt trong cổng nội dung. Đây là lý do cụ thể vì sao
// trang phải dựng ở phía máy chủ: thẻ mô tả là một HÀM của trạng thái database,
// mà trình quét link của Facebook thì không chạy JavaScript. Câu nền đã có địa
// chỉ cố định (DIA_CHI_NHA_HANG — Khánh chốt 06/10/2026).
const moTaTrang = moTa ?? nd.mo_ta_og ?? t.moTaNgan;

const anh = nd.anh_chia_se;
const coAnhThat = !!(anh && anh.nguon === 'anh_that' && anh.url);
const anhChiaSe = coAnhThat
  ? { url: anh!.url, rong: anh!.rong ?? 1200, cao: anh!.cao ?? 630, alt: anh!.alt }
  : { url: `${goc}/thuong-hieu/chia-se-1200x630.png`, rong: 1200, cao: 630, alt: `${THUONG_HIEU.ten} — ${THUONG_HIEU.khauHieu}` };
const lh = lienHe(nd);

// Bản của trang này ở một ngôn ngữ. Chính nó thì giữ nguyên đường dẫn đang
// mở, kể cả khi trang chưa có trong bảng CAP_DUONG_DAN.
const banCua = (n: NgonNgu) => (n === ngonNgu ? duongDan : duongDanTuongUng(duongDan, n));
const ngonNguKhac = NGON_NGU.filter(n => n !== ngonNgu);

// Facebook cần mã vùng; mã ngôn ngữ trần thì nó bỏ qua.
const OG_LOCALE: Record<NgonNgu, string> = { vi: 'vi_VN', en: 'en_US', ko: 'ko_KR' };

// Chỉ khai những trường đã được xác nhận.
const duLieuCoCauTruc: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: THUONG_HIEU.ten,
  url: goc || undefined,
  description: moTaTrang,
  servesCuisine: ['Bò nướng', 'Barbecue'],
  // Form đặt bàn chưa mở thì đây đúng là false — thuộc tính này sinh ra để
  // nói điều đó.
  acceptsReservations: nd.form_dat_ban_dang_mo === true,
};
// Địa chỉ đã chốt và hiện cố định; bản công bố trong /noi-bo (nếu có) thay vào.
duLieuCoCauTruc.address = {
  '@type': 'PostalAddress',
  streetAddress: nd.dia_chi_hien_thi?.trim() || 'Tầng 3, 11-21 Hàm Nghi',
  addressLocality: 'Phường Sài Gòn',
  addressRegion: 'TP. Hồ Chí Minh',
  addressCountry: 'VN',
};
if (lh.hotline) duLieuCoCauTruc.telephone = lh.hotline;
if (coAnhThat) duLieuCoCauTruc.image = anhChiaSe.url;
if (lh.maps) duLieuCoCauTruc.hasMap = lh.maps;
// Trang thực đơn chỉ được khai khi thực đơn đang hiện.
if (nd.hien_thuc_don === true && goc) duLieuCoCauTruc.hasMenu = goc + duongDanTuongUng('/thuc-don', ngonNgu);
const sameAs = [lh.facebook, lh.instagram, lh.tiktok].filter(Boolean);
if (sameAs.length) duLieuCoCauTruc.sameAs = sameAs;
---
<!doctype html>
<html lang={ngonNgu}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDeTrang}</title>
    <meta name="description" content={moTaTrang} />
    <link rel="canonical" href={duongDanDayDu} />
    {NGON_NGU.map(n => <link rel="alternate" hreflang={n} href={goc + banCua(n)} />)}
    <link rel="alternate" hreflang="x-default" href={goc + banCua('vi')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={THUONG_HIEU.ten} />
    <meta property="og:title" content={tieuDeTrang} />
    <meta property="og:description" content={moTaTrang} />
    <meta property="og:url" content={duongDanDayDu} />
    <meta property="og:locale" content={OG_LOCALE[ngonNgu]} />
    {goc && (
      <>
        <meta property="og:image" content={anhChiaSe.url} />
        <meta property="og:image:width" content={String(anhChiaSe.rong)} />
        <meta property="og:image:height" content={String(anhChiaSe.cao)} />
        {anhChiaSe.alt && <meta property="og:image:alt" content={anhChiaSe.alt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {!goc && <meta name="twitter:card" content="summary" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/bieu-tuong.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/thuong-hieu/bieu-tuong-180.png" />
    <meta name="theme-color" content="#FBF4E1" />
    {/* Logo đầu trang: tải sớm cùng CSS để không nháy ô trống. Ảnh hero preload qua slot "dau". */}
    <link rel="preload" href="/thuong-hieu/logo-ngang-do.svg" as="image" type="image/svg+xml" />
    <slot name="dau" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap"
    />
    {/* Montserrat không có chữ Hangul. Chỉ trang tiếng Hàn tải thêm Noto Sans
        KR — Google cắt phông này thành nhiều mảnh theo dải ký tự nên trình
        duyệt chỉ tải mảnh có chữ đang hiện; trang tiếng Việt và tiếng Anh
        không tải gì thêm. Thứ tự phông nằm ở :root:lang(ko) trong chung.css. */}
    {ngonNgu === 'ko' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;800&display=swap"
      />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(duLieuCoCauTruc)} is:inline />
  </head>

  <body class="ck">
    <a class="bo-qua" href="#noi-dung">{t.boQuaToiNoiDung}</a>

    {/* lang trên từng nút đổi ngôn ngữ: trình đọc màn hình đọc "한국어" bằng giọng
        Hàn chứ không đánh vần nó bằng giọng của trang đang mở. */}
    <DauTrang ngonNgu={ngonNgu} duongDan={duongDan}
              doiNgonNgu={ngonNguKhac.map(n => ({ nn: n, url: banCua(n), ten: TEN_NGON_NGU[n] }))} />

    <main id="noi-dung">
      <slot />
    </main>

    <ChanTrang ngonNgu={ngonNgu} noiDung={nd} />
  </body>
</html>
