---
/**
 * KHUNG TRANG — thẻ mô tả, dữ liệu có cấu trúc, đầu và chân trang
 *
 * THẺ CHIA SẺ LINK (og:image):
 * Ảnh THẬT đã công bố ở khóa `anh_chia_se` luôn được ưu tiên. Chưa có thì dùng
 * ảnh dự phòng /thuong-hieu/chia-se-1200x630.png: logo chính trắng trên nền đỏ
 * phẳng (guideline 21/10/2026, trang 4: trắng trên đỏ), không ảnh chụp, không
 * ngày, không giá — dựng bằng web/cong-cu/thuong-hieu/tao-bieu-tuong.py. Ảnh đó
 * đi cùng bản build, nên không có chuyện thẻ og:image trỏ tới ảnh hỏng (điều mà
 * quy tắc cũ "không có ảnh thật thì không đặt thẻ" phòng). Alt của nó là tên và
 * tagline — đúng chữ in trên logo. v_cong_bo_con_thieu vẫn nhắc anh_chia_se cho
 * tới khi có ảnh chụp thật.
 *
 * DỮ LIỆU CÓ CẤU TRÚC (JSON-LD):
 * Chỉ khai những gì đã công bố. Cụ thể là KHÔNG có:
 *   · priceRange — chưa có khoảng giá nào được duyệt;
 *   · aggregateRating / review — chưa có một đánh giá thật nào, và khai số
 *     liệu đánh giá bịa vừa vi phạm chính sách Google vừa là quảng cáo sai;
 *   · openingHoursSpecification khi giờ chưa chốt — Google đưa giờ này lên
 *     kết quả tìm kiếm, nên khai sai là dẫn khách tới một cánh cửa đóng.
 * Logo (`logo`) là biểu tượng 180 × 180 của bộ 21/10/2026 (đầu bò trắng trên nền
 * đỏ phủ kín, web/public/thuong-hieu/bieu-tuong-180.png): Google cần ảnh tối thiểu
 * 112 × 112, nhìn đúng trên nền trắng — ô đỏ phủ kín đạt cả hai, cắt vuông không mất gì.
 *
 * BA THỨ TIẾNG:
 * Mỗi trang khai hreflang cho đủ vi/en/ko và x-default về bản tiếng Việt —
 * cùng một bộ với sitemap.xml. Bộ chọn ngôn ngữ in ĐỦ ba thứ tiếng theo một thứ
 * tự cố định, mỗi cái ghi bằng chính thứ tiếng đó; thứ tiếng đang xem được đánh
 * dấu bằng chữ đậm và nét gạch (components/DauTrang.astro), không phải link.
 *
 * META PIXEL (lib/meta-pixel.ts — đọc chú thích đầu file đó):
 * Mã gốc của Meta in nguyên khối ở cuối <head>, mọi trang trừ 404. <body> mang tên trang
 * (data-pixel-trang), script cuối trang gửi ViewContent khi mở trang Thực đơn và Contact khi
 * bấm link gọi điện, Zalo, Messenger. Sự kiện chỉ kèm tên trang và thứ tiếng.
 *
 * TRANG KHÔNG LẬP CHỈ MỤC (khongLapChiMuc — trang 404, pages/404.astro):
 * noindex, không canonical, không hreflang, không og:url, không JSON-LD, không Meta Pixel. Trang đó
 * dựng cho MỌI đường dẫn lạ: không có bản chính nào để trỏ về, và /en không phải
 * "bản tiếng Anh" của một đường dẫn không có. Nó cũng dựng với bộ nội dung rỗng
 * (không đọc database), nên JSON-LD của nó sẽ khai sai về nhà hàng thật —
 * acceptsReservations false khi form đang mở, thiếu điện thoại, mạng xã hội.
 */
import '../styles/chung.css';
import '../styles/cong-khai.css';
import { THUONG_HIEU, NGON_NGU, TEN_NGON_NGU, chu, duongDanTuongUng } from '../lib/chu';
import { diaChiCoCauTruc, jsonTrongScript, lienHe } from '../lib/trang-cong-khai';
import { khoiMaPixel, tenTrangPixel } from '../lib/meta-pixel';
import type { NgonNgu, NoiDung } from '../lib/noi-dung';
import DauTrang from '../components/DauTrang.astro';
import ChanTrang from '../components/ChanTrang.astro';

interface Props {
  ngonNgu: NgonNgu;
  noiDung: NoiDung;
  tieuDe?: string;
  moTa?: string;
  duongDan: string;
  /** Trang 404: noindex, bỏ canonical / hreflang / og:url / JSON-LD. */
  khongLapChiMuc?: boolean;
}

const { ngonNgu, noiDung: nd, tieuDe, moTa, duongDan, khongLapChiMuc = false } = Astro.props;
const t = chu(ngonNgu);

const goc = Astro.site?.origin ?? '';
const duongDanDayDu = goc + duongDan;

// Tiêu đề: ưu tiên bản đã duyệt trong cổng nội dung, sau đó mới tới bản nền.
const tieuDeTrang = tieuDe
  ?? nd.tieu_de_og
  ?? `${THUONG_HIEU.ten} — ${t.nganhHang} · ${t.diaChiNgan}`;

// Mô tả ưu tiên bản đã duyệt trong cổng nội dung. Đây là lý do cụ thể vì sao
// trang phải dựng ở phía máy chủ: thẻ mô tả là một HÀM của trạng thái database,
// mà trình quét link của Facebook thì không chạy JavaScript. Câu nền (moTaNgan
// trong lib/chu.ts) đã ghi địa điểm: tầng 3, 63 Hồ Tùng Mậu.
const moTaTrang = moTa ?? nd.mo_ta_og ?? t.moTaNgan;

const anh = nd.anh_chia_se;
const coAnhThat = !!(anh && anh.nguon === 'anh_that' && anh.url);
const anhChiaSe = coAnhThat
  ? { url: anh!.url, rong: anh!.rong ?? 1200, cao: anh!.cao ?? 630, alt: anh!.alt }
  : { url: `${goc}/thuong-hieu/chia-se-1200x630.png`, rong: 1200, cao: 630, alt: `${THUONG_HIEU.ten} — ${THUONG_HIEU.khauHieu}` };
const lh = lienHe(nd);

// Bản của trang này ở một ngôn ngữ. Chính nó thì giữ nguyên đường dẫn đang
// mở, kể cả khi trang chưa có trong bảng CAP_DUONG_DAN.
const banCua = (n: NgonNgu) => (n === ngonNgu ? duongDan : duongDanTuongUng(duongDan, n));

// Meta Pixel: tên trang theo bản tiếng Việt, một tên cho cả ba thứ tiếng. Trang 404 không gắn pixel.
const tenTrang = khongLapChiMuc ? null : tenTrangPixel(banCua('vi'));

// Facebook cần mã vùng; mã ngôn ngữ trần thì nó bỏ qua.
const OG_LOCALE: Record<NgonNgu, string> = { vi: 'vi_VN', en: 'en_US', ko: 'ko_KR' };

// Chỉ khai những trường đã được xác nhận.
const duLieuCoCauTruc: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: THUONG_HIEU.ten,
  url: goc || undefined,
  // Mô tả NHÀ HÀNG, không phải của trang đang mở (trang quyền riêng tư không được
  // thành "nhà hàng thu thập thông tin cá nhân như thế nào").
  description: nd.mo_ta_og ?? t.moTaNgan,
  servesCuisine: { vi: ['Bò nướng', 'Barbecue'], en: ['Grilled beef', 'Barbecue'], ko: ['소고기 구이', '바비큐'] }[ngonNgu],
  // Form đặt bàn chưa mở thì đây đúng là false — thuộc tính này sinh ra để
  // nói điều đó.
  acceptsReservations: nd.form_dat_ban_dang_mo === true,
};
// Địa chỉ cố định trong mã (lib/chu.ts); bản công bố trong /noi-bo (nếu có) thay vào.
duLieuCoCauTruc.address = diaChiCoCauTruc(nd);
// Chỉ phần số (hotline đã công bố có thể kèm chú thích "(Zalo)").
if (lh.goi) duLieuCoCauTruc.telephone = lh.goi.slice('tel:'.length);
if (coAnhThat) duLieuCoCauTruc.image = anhChiaSe.url;
// Đường dẫn tuyệt đối: chỉ khai khi biết tên miền (bản dựng không có site thì bỏ, như og:image).
if (goc) duLieuCoCauTruc.logo = { '@type': 'ImageObject', url: `${goc}/thuong-hieu/bieu-tuong-180.png`, width: 180, height: 180 };
if (lh.maps) duLieuCoCauTruc.hasMap = lh.maps;
// Trang thực đơn chỉ được khai khi thực đơn đang hiện.
if (nd.hien_thuc_don === true && goc) duLieuCoCauTruc.hasMenu = goc + duongDanTuongUng('/thuc-don', ngonNgu);
const sameAs = [lh.facebook, lh.instagram, lh.tiktok].filter(Boolean);
if (sameAs.length) duLieuCoCauTruc.sameAs = sameAs;
---
<!doctype html>
<html lang={ngonNgu}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDeTrang}</title>
    <meta name="description" content={moTaTrang} />
    {khongLapChiMuc ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={duongDanDayDu} />
        {NGON_NGU.map(n => <link rel="alternate" hreflang={n} href={goc + banCua(n)} />)}
        <link rel="alternate" hreflang="x-default" href={goc + banCua('vi')} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={THUONG_HIEU.ten} />
    <meta property="og:title" content={tieuDeTrang} />
    <meta property="og:description" content={moTaTrang} />
    {!khongLapChiMuc && <meta property="og:url" content={duongDanDayDu} />}
    <meta property="og:locale" content={OG_LOCALE[ngonNgu]} />
    {goc && (
      <>
        <meta property="og:image" content={anhChiaSe.url} />
        <meta property="og:image:width" content={String(anhChiaSe.rong)} />
        <meta property="og:image:height" content={String(anhChiaSe.cao)} />
        {anhChiaSe.alt && <meta property="og:image:alt" content={anhChiaSe.alt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {!goc && <meta name="twitter:card" content="summary" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/bieu-tuong.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/thuong-hieu/bieu-tuong-180.png" />
    {/* Màu thanh trình duyệt: đen như đầu trang (DauTrang.astro, bề mặt .be-toi). */}
    <meta name="theme-color" content="#000000" />
    {/* Logo đầu trang (logo phụ trắng của DauTrang.astro): tải sớm cùng CSS để không nháy ô trống.
        Ảnh hero preload qua slot "dau". */}
    <link rel="preload" href="/thuong-hieu/chu-beeftown-trang.svg" as="image" type="image/svg+xml" />
    <slot name="dau" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap"
    />
    {/* Montserrat không có chữ Hangul. Chỉ trang tiếng Hàn tải thêm Noto Sans
        KR — Google cắt phông này thành nhiều mảnh theo dải ký tự nên trình
        duyệt chỉ tải mảnh có chữ đang hiện; trang tiếng Việt và tiếng Anh
        không tải gì thêm. Thứ tự phông nằm ở :root:lang(ko) trong chung.css. */}
    {ngonNgu === 'ko' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;800&display=swap"
      />
    )}

    {!khongLapChiMuc && <script type="application/ld+json" set:html={jsonTrongScript(duLieuCoCauTruc)} is:inline />}

    {/* Mã gốc Meta Pixel, đúng từng chữ của Meta, cuối <head> như Meta hướng dẫn (Astro còn chèn CSS của trang sau nó). */}
    {tenTrang && <Fragment set:html={khoiMaPixel()} />}
  </head>

  <body class="ck" data-pixel-trang={tenTrang ?? undefined}>
    <a class="bo-qua" href="#noi-dung">{t.boQuaToiNoiDung}</a>

    {/* lang trên từng mục của bộ chọn ngôn ngữ: trình đọc màn hình đọc "한국어" bằng giọng
        Hàn chứ không đánh vần nó bằng giọng của trang đang mở. */}
    <DauTrang ngonNgu={ngonNgu} noiDung={nd} duongDan={duongDan}
              doiNgonNgu={NGON_NGU.map(n => ({ nn: n, url: banCua(n), ten: TEN_NGON_NGU[n] }))} />

    <main id="noi-dung">
      <slot />
    </main>

    <ChanTrang ngonNgu={ngonNgu} noiDung={nd} duongDan={duongDan} />

    <script>
      // Meta Pixel (lib/meta-pixel.ts): ViewContent khi mở trang Thực đơn; Contact khi bấm link gọi điện, Zalo,
      // Messenger — bắt ở pha capture trên document nên link nào trên trang cũng được, kể cả link script dựng sau; bấm
      // chuột giữa (mở thẻ mới) chỉ phát auxclick nên nghe cả nó. Trang không gắn pixel (404) hay script của Meta bị
      // chặn: guiSuKien không làm gì.
      import { guiSuKien, suKienCuaLink, suKienMoTrang } from '../lib/meta-pixel';

      const moTrang = suKienMoTrang(document.body.dataset.pixelTrang);
      if (moTrang) guiSuKien(moTrang);

      const baoLink = (e: MouseEvent) => {
        if (e.type === 'auxclick' && e.button !== 1) return;
        const lien = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href]') : null;
        const suKien = lien ? suKienCuaLink(lien.href) : null;
        if (suKien) guiSuKien(suKien);
      };
      document.addEventListener('click', baoLink, true);
      document.addEventListener('auxclick', baoLink, true);
    </script>
  </body>
</html>
