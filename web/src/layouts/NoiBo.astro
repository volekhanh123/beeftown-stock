---
/**
 * KHUNG GIAO DIỆN NỘI BỘ
 *
 * Thiết kế cho NGÓN TAY CÁI trước, màn hình lớn sau. Chủ quán xác nhận bàn
 * khi đang đứng ở quầy, một tay cầm điện thoại — không phải ngồi trước máy
 * tính. Nên nút cao 48px, chữ 16px trở lên (dưới 16px thì Safari tự phóng to
 * trang khi chạm vào ô nhập), và thanh điều hướng nằm DƯỚI đáy màn hình trên
 * điện thoại.
 *
 * noindex: trang nội bộ không được vào kết quả tìm kiếm. Đây chỉ là phép
 * lịch sự với Google — thứ thật sự chặn là middleware và RLS.
 *
 * MENU (lib/dieu-huong-noi-bo.ts — một danh sách, dùng chung với menu bên kho):
 *   · máy tính / tablet: thanh trên có mọi mục, xuống dòng khi hẹp — không mục nào
 *     bị đẩy ra ngoài mép;
 *   · điện thoại (≤ 640px): thanh đáy tối đa 5 nút có biểu tượng. Vai nhiều mục
 *     thấy 4 mục hay dùng + "Thêm" (trang Tất cả chức năng, có ô tìm).
 */
import '../styles/chung.css';
import '../styles/noi-bo.css';
import BieuTuong from '../components/kho/BieuTuong.astro';
import type { NhanSu } from '../lib/phien';
import { dichNB, nhanNB, nnCua, linkDoiNgonNgu, type HaiThuTieng } from '../lib/ngon-ngu-noi-bo';
import { thanhTrenNoiBo, thanhDayNoiBo, dangONoiBo } from '../lib/dieu-huong-noi-bo';

interface Props {
  tieuDe: string;
  nhanSu?: NhanSu;
}
const { tieuDe, nhanSu } = Astro.props;
const duong = Astro.url.pathname.replace(/\/$/, '') || '/noi-bo';
const nn = nnCua(Astro);
const doiTieng = linkDoiNgonNgu(Astro.url, nn);
const t = dichNB(nn, {
  noiBo:     { vi: 'nội bộ',            en: 'internal' },
  dangXuat:  { vi: 'Đăng xuất',         en: 'Log out' },
  khuVuc:    { vi: 'Khu vực nội bộ',    en: 'Internal sections' },
  menuChinh: { vi: 'Menu chính',        en: 'Main menu' },
  tenTrang:  { vi: 'Beeftown nội bộ',   en: 'Beeftown internal' },
});

// Đúng bảy vai của enum vai_tro (bốn vai CRM ở 0001, ba vai kho ở 0017).
// Thêm nhãn cho một vai không có trong enum chỉ làm người đọc mã tưởng nó
// tồn tại.
const TEN_VAI_TRO: Record<string, HaiThuTieng> = {
  chu_so_huu:     { vi: 'Chủ nhà hàng', en: 'Owner' },
  quan_ly:        { vi: 'Quản lý',      en: 'Manager' },
  thu_ngan:       { vi: 'Thu ngân',     en: 'Cashier' },
  marketing:      { vi: 'Marketing',    en: 'Marketing' },
  thu_kho:        { vi: 'Thủ kho',      en: 'Storekeeper' },
  nhan_vien_quay: { vi: 'NV quầy/bếp',  en: 'Counter/kitchen staff' },
  ke_toan:        { vi: 'Kế toán',      en: 'Accountant' },
};

// Ô nào hiện ra do VAI TRÒ quyết định, và danh sách vai ở lib/dieu-huong-noi-bo.ts
// khớp với chính sách RLS tương ứng trong database. Giấu một ô mà RLS vẫn cho
// phép thì chỉ gây khó chịu; hiện một ô mà RLS chặn thì người dùng bấm vào
// và nhận lỗi khó hiểu. Cả hai đều tệ, nên hai danh sách phải khớp nhau.
const tren = thanhTrenNoiBo(nhanSu?.vai_tro);
const day = thanhDayNoiBo(nhanSu?.vai_tro);
---
<!doctype html>
<html lang={nn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe} — {t.tenTrang}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/bieu-tuong.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap"
    />
  </head>

  <body class="nb-than">
    <header class="nb-dau">
      <div class="nb-khung nb-dau-hang">
        <a href="/noi-bo" class="nb-hieu"><img src="/thuong-hieu/chu-beeftown-trang.svg" width="430" height="61" alt="Beeftown" />{' '}<span>{t.noiBo}</span></a>
        <div class="nb-dau-phai">
          <a href={doiTieng.link} class="nb-nut-nho nb-doi-tieng" lang={doiTieng.nnKia} hreflang={doiTieng.nnKia}>{doiTieng.chu}</a>
          {nhanSu && (
            <form method="POST" action="/noi-bo/dang-xuat" class="nb-ai">
              <span class="nb-ten">
                {nhanSu.ho_ten}
                <em>{nhanNB(TEN_VAI_TRO, nhanSu.vai_tro, nn)}</em>
              </span>
              <button type="submit" class="nb-nut-nho">{t.dangXuat}</button>
            </form>
          )}
        </div>
      </div>
    </header>

    {nhanSu && tren.length > 1 && (
      <nav class="nb-dieu-huong" aria-label={t.khuVuc}>
        <div class="nb-dieu-huong-hang">
          {tren.map(m => (
            <a href={m.link} aria-current={dangONoiBo(m, duong) ? 'page' : undefined}><BieuTuong ten={m.bieuTuong} co={18} />{m.ngan[nn]}</a>
          ))}
        </div>
      </nav>
    )}

    {nhanSu && day.length > 1 && (
      <nav class="nb-day" aria-label={t.menuChinh}>
        {day.map(m => (
          <a href={m.link} aria-current={dangONoiBo(m, duong) ? 'page' : undefined}>
            <BieuTuong ten={m.bieuTuong} co={22} />
            <span>{m.ngan[nn]}</span>
          </a>
        ))}
      </nav>
    )}

    <main class="nb-khung nb-chinh">
      <slot />
    </main>
  </body>
</html>
