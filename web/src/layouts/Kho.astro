---
/**
 * KHUNG GIAO DIỆN KHO — giống iPOS Inventory Pro
 *
 *   · Thanh trên: logo · chi nhánh · "?" hướng dẫn · chuông có số chưa đọc ·
 *     menu người dùng (chứa "Đăng xuất" — không để nút đăng xuất trần ngay dưới
 *     ngón tay ướt của thủ kho nữa).
 *   · Máy tính (≥1024px): cột trái — ô "Tìm chức năng", rồi các mục theo nhóm
 *     (NHOM_KHO: Hằng ngày, Tồn kho, Mua và nhận hàng…) có số đỏ, dưới là
 *     "Thao tác nhanh". Nội dung bên phải. Bản cũ là 23 ô liền một dải: laptop
 *     1366×768 chỉ thấy 14 ô, Công nợ / Báo cáo / Thiết lập nằm dưới mép màn hình.
 *   · Điện thoại / tablet (<1024px): thanh 5 nút dính đáy, theo từng vai.
 *   · Điện thoại (≤640px): "Đổi chi nhánh" của chủ nằm trong menu người dùng — đặt
 *     trên thanh trên thì đè lên chữ "Kho" và tên chi nhánh đang xem.
 *
 * Tách riêng khỏi layouts/NoiBo.astro có chủ đích: file đó dùng chung với
 * phần website/CRM (một phiên làm việc khác đang sửa song song). Kho có khung
 * riêng thì không ai phải sửa file của nhau.
 *
 * Không gọi database: mọi con số đã có sẵn trong `k` (moTrangKho → kho_dem_viec).
 * Không JavaScript — trừ ở máy tính bảng dùng chung (GĐ5d, `k.may`): có người
 * đang dùng thì nạp public/kho/js/may-chung.js đếm giờ tự khóa. Chế độ máy
 * đổi "Đăng xuất" thành "Khóa máy" và "Gỡ tôi khỏi máy này"; tài khoản máy
 * (vai may_*) chỉ thấy khung trống, không chuông, không menu.
 *
 * Hai thứ tiếng (lib/ngon-ngu-noi-bo.ts): nút "English" / "Tiếng Việt" trên thanh
 * trên, cùng cookie với phần CRM. Menu, thanh đáy đọc tên { vi, en } của
 * dieu-huong.ts.
 */
import '../styles/chung.css';
import '../styles/noi-bo.css';
import '../styles/kho.css';
import '../styles/kho-khung.css';
import BieuTuong from '../components/kho/BieuTuong.astro';
import type { TrangKho } from '../lib/kho/trang.ts';
import {
  nhomCuaVai, thanhDayCuaVai, thaoTacCuaVai, soDo, dangO, nhanSo, MUC_CRM,
} from '../lib/kho/dieu-huong.ts';
import OTimChucNang from '../components/OTimChucNang.astro';
import { TEN_VAI_KHO_NB } from '../lib/kho/chung.ts';
import { laVaiMay, laCheDoMay, DUONG_MAY } from '../lib/kho/may-chung.ts';
import { dichNB, nhanNB, nnCua, linkDoiNgonNgu, type HaiThuTieng } from '../lib/ngon-ngu-noi-bo.ts';

interface Props {
  k: Pick<TrangKho, 'nhanSu' | 'chiNhanh' | 'cacChiNhanh' | 'viec'> & Partial<Pick<TrangKho, 'may'>>;
  tieuDe: string;
  /** Mục trong trang Hướng dẫn cho nút "?" (vd "thu-kho-nhan-hang"). */
  huongDan?: string;
  /** Trang nhiều cột (báo cáo, công nợ): nội dung rộng 1200px trên máy tính. */
  rong?: boolean;
}
const { k, tieuDe, huongDan, rong = false } = Astro.props;
const vai = k.nhanSu.vai_tro;
const duong = Astro.url.pathname;
const timKiem = Astro.url.search;

const nn = nnCua(Astro);
const doiTieng = linkDoiNgonNgu(Astro.url, nn);
const t = dichNB(nn, {
  tenApp: { vi: 'Kho Beeftown', en: 'Beeftown Inventory' },
  kho: { vi: 'Kho', en: 'Inventory' },
  boQuaMenu: { vi: 'Bỏ qua menu', en: 'Skip menu' },
  veTrangChu: { vi: 'Kho Beeftown — trang chủ', en: 'Beeftown Inventory — home' },
  doiChiNhanh: { vi: 'Đổi chi nhánh', en: 'Switch branch' },
  tienIch: { vi: 'Tiện ích', en: 'Tools' },
  huongDanManNay: { vi: 'Hướng dẫn cho màn này', en: 'Help for this screen' },
  huongDan: { vi: 'Hướng dẫn', en: 'Help' },
  thongBao: { vi: 'Thông báo', en: 'Notifications' },
  chuaDoc: { vi: (n: number) => `${n} thông báo chưa đọc`, en: (n: number) => `${n} unread notification${n === 1 ? '' : 's'}` },
  thongBaoChuaDoc: { vi: (n: number) => `Thông báo, ${n} chưa đọc`, en: (n: number) => `Notifications, ${n} unread` },
  phanKhac: { vi: 'Phần khác của nhà hàng', en: 'Other restaurant areas' },
  ganToi: { vi: 'Gắn tôi vào máy này', en: 'Add me to this tablet' },
  dangKyLai: { vi: 'Đăng ký lại máy (quản lý)', en: 'Register this tablet again (manager)' },
  huongDanSuDung: { vi: 'Hướng dẫn sử dụng', en: 'User guide' },
  doiPin: { vi: 'Đổi PIN của tôi', en: 'Change my PIN' },
  khoaMay: { vi: 'Khóa máy', en: 'Lock tablet' },
  goToi: { vi: 'Gỡ tôi khỏi máy này', en: 'Remove me from this tablet' },
  dangXuat: { vi: 'Đăng xuất', en: 'Log out' },
  cacMuc: { vi: 'Các mục kho', en: 'Inventory sections' },
  thaoTacNhanh: { vi: 'Thao tác nhanh', en: 'Quick actions' },
  menuChinh: { vi: 'Menu chính', en: 'Main menu' },
  soViec: { vi: (n: number) => `${n} việc`, en: (n: number) => `${n} to do` },
});

const TEN_VAI: Record<string, HaiThuTieng> = {
  chu_so_huu: { vi: 'Chủ nhà hàng', en: 'Owner' }, quan_ly: { vi: 'Quản lý', en: 'Manager' },
  thu_ngan: { vi: 'Thu ngân', en: 'Cashier' }, marketing: { vi: 'Marketing', en: 'Marketing' },
  may_chung: { vi: 'Máy dùng chung', en: 'Shared tablet' }, may_ipos: { vi: 'Máy iPOS', en: 'iPOS device' },
  ...TEN_VAI_KHO_NB,
};
const tenVai = nhanNB(TEN_VAI, vai, nn);

// Máy tính bảng dùng chung: laMay = đang mở bằng tài khoản máy (màn khóa);
// coNguoiDung = một người đã mở khóa bằng PIN.
const laMay = laVaiMay(vai);
const coNguoiDung = !!k.may?.nhanSuId;
const cheDoMay = laCheDoMay(vai, k.may);

const cot = nhomCuaVai(vai);
const day = thanhDayCuaVai(vai);
const nhanh = thaoTacCuaVai(vai);
const crm = cheDoMay ? [] : MUC_CRM.filter(m => m.vai.includes(vai));
const chuaDoc = typeof k.viec?.chua_doc === 'number' ? (k.viec.chua_doc as number) : 0;
const linkHuongDan = `/noi-bo/kho/huong-dan${huongDan ? `#${huongDan}` : ''}`;
// Link đổi chi nhánh: in ở thanh trên (≥ 641px) và trong menu người dùng (điện thoại).
const doiChiNhanh = (vai === 'chu_so_huu' ? k.cacChiNhanh.filter(c => c.id !== k.chiNhanh?.id) : [])
  .map(c => ({ ten: c.ten, link: `${duong}?cn=${encodeURIComponent(c.ma)}` }));
---
<!doctype html>
<html lang={nn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tieuDe} — {t.tenApp}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/bieu-tuong.svg" type="image/svg+xml" />
    <link rel="manifest" href="/kho/manifest.json" />
    <link rel="apple-touch-icon" href="/kho/bieu-tuong-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={t.tenApp} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="theme-color" content="#151008" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" />
  </head>

  <body class="nb-than kho-than">
    <a class="kho-bo-qua" href="#noi-dung">{t.boQuaMenu}</a>

    <header class="kho-dau">
      <div class="kho-dau-hang">
        <a href={laMay ? DUONG_MAY : '/noi-bo/kho'} class="kho-hieu" aria-label={t.veTrangChu}>
          <img src="/bieu-tuong.svg" alt="" width="30" height="30" />
          <span>{t.kho}<small>{k.chiNhanh?.ten ?? 'Beeftown'}</small></span>
        </a>

        {doiChiNhanh.length > 0 && (
          <details class="kho-cn-chon">
            <summary>{t.doiChiNhanh}</summary>
            <div>
              {doiChiNhanh.map(c => <a href={c.link}>{c.ten}</a>)}
            </div>
          </details>
        )}

        <nav class="kho-dau-nut" aria-label={t.tienIch}>
          <a href={doiTieng.link} class="kho-doi-tieng" lang={doiTieng.nnKia} hreflang={doiTieng.nnKia}>{doiTieng.chu}</a>
          {!laMay && (<>
          <a href={linkHuongDan} class="kho-nut-tron" title={t.huongDanManNay}>
            <BieuTuong ten="huong_dan" /><span class="kho-an">{t.huongDan}</span>
          </a>
          <a href="/noi-bo/kho/thong-bao" class="kho-nut-tron"
             aria-current={dangO({ link: '/noi-bo/kho/thong-bao' }, duong) ? 'page' : undefined}
             title={chuaDoc > 0 ? t.chuaDoc(chuaDoc) : t.thongBao}>
            <BieuTuong ten="chuong" />
            <span class="kho-an">{chuaDoc > 0 ? t.thongBaoChuaDoc(chuaDoc) : t.thongBao}</span>
            {chuaDoc > 0 && <b class="kho-so-do" aria-hidden="true">{nhanSo(chuaDoc)}</b>}
          </a>
          </>)}
          <details class="kho-nguoi">
            <summary>
              <BieuTuong ten="nguoi" />
              <span class="kho-nguoi-ten">{k.nhanSu.ho_ten}<em>{tenVai}</em></span>
            </summary>
            <div class="kho-nguoi-menu">
              <p><strong>{k.nhanSu.ho_ten}</strong><br />{tenVai}{k.chiNhanh ? ` · ${k.chiNhanh.ten}` : ''}</p>
              {doiChiNhanh.length > 0 && (
                <div class="kho-chi-hep">
                  <p class="kho-nguoi-nhom">{t.doiChiNhanh}</p>
                  {doiChiNhanh.map(c => <a href={c.link}><BieuTuong ten="chuyen" co={18} />{c.ten}</a>)}
                </div>
              )}
              {crm.length > 0 && (
                <>
                  <p class="kho-nguoi-nhom">{t.phanKhac}</p>
                  {crm.map(m => <a href={m.link}><BieuTuong ten={m.bieuTuong} co={18} />{m.ten[nn]}</a>)}
                </>
              )}
              {laMay ? (
                <>
                  <a href={`${DUONG_MAY}/gan`}><BieuTuong ten="them" co={18} />{t.ganToi}</a>
                  <a href={`${DUONG_MAY}/dang-ky`}><BieuTuong ten="cai_dat" co={18} />{t.dangKyLai}</a>
                </>
              ) : coNguoiDung ? (
                <>
                  <a href="/noi-bo/kho/huong-dan"><BieuTuong ten="huong_dan" co={18} />{t.huongDanSuDung}</a>
                  <a href={`${DUONG_MAY}/gan`}><BieuTuong ten="cai_dat" co={18} />{t.doiPin}</a>
                  <form method="POST" action={DUONG_MAY}>
                    <input type="hidden" name="viec" value="khoa" />
                    <button type="submit"><BieuTuong ten="dang_xuat" co={18} />{t.khoaMay}</button>
                  </form>
                  <form method="POST" action={DUONG_MAY}>
                    <input type="hidden" name="viec" value="go" />
                    <button type="submit"><BieuTuong ten="huy" co={18} />{t.goToi}</button>
                  </form>
                </>
              ) : (
                <>
                  <a href="/noi-bo/kho/huong-dan"><BieuTuong ten="huong_dan" co={18} />{t.huongDanSuDung}</a>
                  <form method="POST" action="/noi-bo/dang-xuat">
                    <button type="submit"><BieuTuong ten="dang_xuat" co={18} />{t.dangXuat}</button>
                  </form>
                </>
              )}
            </div>
          </details>
        </nav>
      </div>
    </header>

    <div class="kho-khung">
      <nav class="kho-ben" aria-label={t.cacMuc}>
        {cot.length > 0 && (
          <OTimChucNang nn={nn} hanhDong="/noi-bo/kho/khac" kieu="ben" id="kho-ben-tim" />
        )}
        {cot.map(n => (
          <>
            <p class="kho-ben-nhom" id={`kho-ben-${n.ma}`}>{n.ten[nn]}</p>
            <ul class="kho-ben-ds" aria-labelledby={`kho-ben-${n.ma}`}>
              {n.muc.map(m => {
                const so = soDo(m, k.viec);
                const dang = dangO(m, duong, timKiem);
                return (
                  <li>
                    <a href={m.link} class="kho-ben-muc" aria-current={dang ? 'page' : undefined}>
                      <BieuTuong ten={m.bieuTuong} co={20} />
                      <span>{m.ten[nn]}</span>
                      {so > 0 && <b class="kho-so-do" aria-label={t.soViec(so)}>{nhanSo(so)}</b>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        ))}
        {nhanh.length > 0 && (
          <div class="kho-nhanh-ben">
            <p>{t.thaoTacNhanh}</p>
            {nhanh.map(x => <a href={x.link}><BieuTuong ten={x.bieuTuong} co={18} />{x.ten[nn]}</a>)}
          </div>
        )}
      </nav>

      <main id="noi-dung" class:list={['nb-chinh', 'kho-chinh', { rong }]}>
        <slot />
      </main>
    </div>

    <nav class="kho-day" aria-label={t.menuChinh}>
      {day.map(m => {
        const so = soDo(m, k.viec);
        const dang = dangO(m, duong, timKiem);
        return (
          <a href={m.link} class:list={['kho-day-nut', { giua: m.ma === 'quet' }]}
             aria-current={dang ? 'page' : undefined}>
            <span class="kho-day-bt">
              <BieuTuong ten={m.bieuTuong} co={m.ma === 'quet' ? 26 : 22} />
              {so > 0 && <b class="kho-so-do" aria-label={t.soViec(so)}>{nhanSo(so)}</b>}
            </span>
            <span class="kho-day-chu">{(m.ngan ?? m.ten)[nn]}</span>
          </a>
        );
      })}
    </nav>

    {coNguoiDung && k.may && (
      <script is:inline src="/kho/js/may-chung.js" data-may-chung
        data-phut={String(k.may.phutKhoa)} data-giay={String(k.may.giayConLai)} defer></script>
    )}
  </body>
</html>
