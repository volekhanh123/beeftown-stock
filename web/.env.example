# Beeftown — biến môi trường
# CHỈ chứa TÊN biến. Khóa thật KHÔNG BAO GIỜ nằm trong repo.
# Chép file này thành .env (file .env đã bị .gitignore chặn).

# Địa chỉ project Supabase. Lấy ở Project Settings → API.
PUBLIC_SUPABASE_URL=

# Khóa anon. Khóa này CÔNG KHAI theo thiết kế — nó nằm sẵn trong mã trang web.
# An toàn nằm ở RLS và ở danh sách 12 hàm mà anon được gọi (migration 0013),
# không nằm ở việc giấu khóa này.
PUBLIC_SUPABASE_ANON_KEY=

# Tên miền thật. Nó thành canonical, og:url, url trong JSON-LD và mọi <loc>
# trong sitemap — và Astro NƯỚNG nó vào bản build, nên phải đúng TRƯỚC khi
# chạy npm run build.
#
# Web chạy ở beeftown.vn; địa chỉ workers.dev đã tắt trong wrangler.toml.
SITE_URL=https://beeftown.vn

# Mã chi nhánh, khớp cột chi_nhanh.ma trong database.
PUBLIC_CHI_NHANH=q1
