    "deploy:thu": "zmp deploy --testing --passive --desc \"Ban thu 1.0, gia thu\""
  },
  "dependencies": {
    "@fontsource/montserrat": "5.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "zmp-sdk": "2.53.1",
    "zmp-ui": "1.11.14"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "zmp-cli": "4.0.3",
    "zmp-vite-plugin": "1.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
