{
  "name": "beeftown-mini-app",
  "private": true,
  "version": "1.0.0",
  "description": "Zalo Mini App bán thịt mang về của Beeftown: chọn 6 phần thịt, gửi đơn vào chat Zalo OA",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
